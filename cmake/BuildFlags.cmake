file(READ "${IN}" _flags)
string(REPLACE "\\" "\\\\" _flags "${_flags}")
string(REPLACE "\"" "\\\"" _flags "${_flags}")
string(REGEX REPLACE "[ \t]+" " " _flags "${_flags}")
string(REGEX REPLACE " *\n *" "\n" _flags "${_flags}")
string(REGEX MATCH "^[^\n]*" _cflags "${_flags}")
string(REGEX REPLACE "^[^\n]*\n" "" _ldflags "${_flags}")
string(STRIP "${_ldflags}" _ldflags)
set(_out "#define TY_BUILD_CFLAGS  \"${_cflags}\"\n#define TY_BUILD_LDFLAGS \"${_ldflags}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _out)
  file(WRITE "${OUT}" "${_out}")
endif()
