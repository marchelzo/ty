import ffi as c
import os
import ty

class Capstone {
    __version: Int;
    __open: (Int, Int, Ptr[Any]) -> Int;
    __close: Ptr[Any] -> Int;
    __decode: (Int, Ptr[Any], Int, Int, Int, Ptr[Any]) -> Int;
    __free: (Ptr[Any], Int) -> Any;

    init(lib: Ptr[Any], version: Int) {
        __version = version
        __open = c.wrap(lib, 'cs_open', c.i32, c.i32, c.i32, c.ptr)
        __close = c.wrap(lib, 'cs_close', c.i32, c.ptr)
        __decode = c.wrap(lib, 'cs_disasm', c.u64, c.u64, c.ptr,
                          c.u64, c.u64, c.u64, c.ptr)
        __free = c.wrap(lib, 'cs_free', c.void, c.ptr, c.u64)
    }

    instruction(p: Ptr[Any], version: Int) -> (Int, String) {
        let size-off = version == 6 ? 24 : 16
        let text-off = match version {
            4 => 34,
            5 => 42,
            6 => 50,
        }
        let size = c.load(c.u16, p + size-off)
        let name = c.str(p + text-off)
        let args = c.str(p + text-off + 32)
        (size, args == '' ? name : "{name} {args}")
    }

    dis(p: Ptr[Any], size: Int, base: Int = 0) -> Array[(Int, String)] | nil {
        let handle = c.box(c.u64, 0)
        defer c.free(handle)
        let x64-arch = __version == 6 ? 4 : 3
        let arch = arm64?() ? 1 : x64-arch
        let mode = arm64?() ? 0 : 8
        if __open(arch, mode, handle) != 0 {
            return nil
        }
        defer __close(handle)
        let out = c.box(c.ptr, nil)
        defer c.free(out)
        let lines = []
        let offset = 0
        let unit = arm64?() ? 4 : 1
        while offset < size {
            if __decode(handle[0], p + offset, size - offset,
                        base + offset, 1, out) == 0 {
                let n = min(unit, size - offset)
                let word = [c.load(c.u8, p + offset + it) << (8 * it) for ..n].sum()
                lines.push((offset, (n == 4) ? ".word {word:#010x}" : ".byte {word:#04x}"))
                offset += n
                continue
            }
            let insn = out[0]
            let (n, text) = instruction(insn, __version)
            __free(insn, 1)
            if n <= 0 || n > size - offset {
                return nil
            }
            lines.push((offset, text))
            offset += n
        }
        lines
    }
}

fn arm64?() -> Bool {
    ty.arch == 'aarch64'
}

fn open-capstone() -> Capstone | nil {
    let $lib = c.open('capstone', [nil, 5, 4, 6]) or return nil
    let version = c.wrap(lib, 'cs_version', c.u32, c.ptr, c.ptr)
    let major = version(nil, nil) >> 8
    if major in [4, 5, 6] {
        return Capstone(lib, major)
    }
}

let __tls::capstone: Capstone | Bool | nil = nil

fn objdump(bytes: Blob, base: Int) -> Array[(Int, String)] | nil {
    let machine = arm64?() ? ['-maarch64'] : ['-mi386:x86-64', '-M', 'intel']
    let file = "{getenv('TMPDIR') ?? '/tmp'}/ty-dis-{os.getpid()}.bin"
    let fd = os.open(file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    if fd < 0 {
        return nil
    }
    os.write(fd, bytes)
    os.close(fd)
    defer os.unlink(file)
    let child = try {
        os.spawn(['objdump', '-D', '-b', 'binary', *machine, "--adjust-vma={base}", file],
                 stdout: os.SPAWN_PIPE, stderr: os.SPAWN_NULL)
    } catch _ {
        return nil
    }
    let out = Blob()
    while let $chunk = os.read(child.stdout, 65536) {
        out.push(chunk)
    }
    os.close(child.stdout)
    os.wait(child.pid)
    let lines = []
    for out.str!().lines() {
        if let [_, off, text] = /^\s*([0-9a-f]+):\t(?:[0-9a-f]{2} )+\s*\t(.*)$/(it) {
            lines.push((int("0x{off}") - base, text.replace(/\s+/, ' ')))
        }
    }
    #lines > 0 ? lines : nil
}

pub fn available?() -> Bool {
    let decoder = capstone ?? (capstone = open-capstone() ?? false)
    decoder :: Capstone
}

pub fn disassemble(bytes: Blob, base: Int = 0, p: Ptr[Any] | nil = nil) -> Array[(Int, String)] {
    let decoder = capstone ?? (capstone = open-capstone() ?? false)
    if let cs: Capstone = decoder and let $lines = cs.dis(p ?? bytes.ptr(), #bytes, base) {
        return lines
    }
    if let $lines = objdump(bytes, base) {
        return lines
    }
    let xs = bytes.list()
    [(i, xs[i;i+16].map(it -> "{it:02x}").join(' ')) for i in (0..#xs)[;;16]]
}
