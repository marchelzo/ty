    pub const FATAL   = 4
}

pub class ParseError < RuntimeError {
    code: Int
    filename: ?String

    init(code: Int, filename: ?String = nil, message: ?String = nil) {
        self.code = code
        self.filename = filename
        let detail = message ?? parse-message(code)
        super(filename == nil ? detail : "{filename}: {detail}")
    }
}

pub class ClosedError < RuntimeError {}
pub class SourceError < RuntimeError {}

fn take-string(s) {
    defer clang_disposeString(s)
    let $p = clang_getCString(s) or return ''
    c.str(p)
}

fn parse-message(code: Int) {
    match code {
        1 => 'parse failed',
        2 => 'clang crashed',
        3 => 'invalid arguments',
        4 => 'AST read error',
        _ => 'unknown parse error'
    }
}

fn optional-cursor(unit, raw) {
    if clang_Cursor_isNull(raw) == 0 {
        Cursor(unit, raw)
    }
}

fn optional-type(unit, raw) {
    if raw[0] != 0 {
        Type(unit, raw)
    }
}

fn optional-file(unit, raw) {
    if raw {
        File(unit, raw)
    }
}

pub fn version() -> String {
    take-string(clang_getClangVersion())
}

pub fn parse(
    filename: String,
    args: [String] = [],
    source: ?String = nil,
    unsaved: Dict[String, String] = %{},
    options: Int = parse-options.DEFAULT
) {
    let index = Index()
    defer index.close()
    index.parse(
        filename,
        args=args,
        source=source,
        unsaved=unsaved,
        options=options
    )
}

pub class Index {
    __p: _
    __units: Int = 0
    __closed?: Bool = false

    init(exclude-pch?: Bool = false) {
        __p = clang_createIndex(int(exclude-pch?), 0)
        if !__p {
            throw ParseError(1, message='could not create clang index')
        }
    }

    parse(
        filename: String,
        args: [String] = [],
        source: ?String = nil,
        unsaved: Dict[String, String] = %{},
        options: Int = parse-options.DEFAULT
    ) {
        if __closed? {
            throw ClosedError('index is closed')
        }

        let path = filename.cstr()
        let buffers = unsaved.clone()
        if let $source = source {
            buffers[filename] = source
        }

        let arguments = args.map(&cstr)
        let entries   = buffers.items()
        let names     = entries.map(|(name, _)| -> name.cstr())
        let av        = c.new-auto(c.ptr, #arguments)
        let files     = c.new-auto(CXUnsavedFile, #names)
        let out       = c.box-auto(c.ptr, nil)

        for argument; i in arguments {
            av[i] = argument
        }

        for (_, contents); i in entries {
            files[i] = (names[i], contents, contents.size())
        }

        let rc = clang_parseTranslationUnit2(
            __p,
            path,
            av,
            #arguments,
            files,
            #names,
            options,
            out
        )
        if rc != 0 {
            throw ParseError(rc, filename)
        }

        __units += 1
        TranslationUnit(self, out[0])
    }

    release() {
        __units -= 1
        __dispose()
    }

    __dispose() {
        if __closed? && __units == 0 && __p {
            clang_disposeIndex(__p)
            __p = nil
        }
    }

    close() {
        __closed? = true
        __dispose()
    }

    __drop__() {
        close()
    }
}

pub class TranslationUnit {
    __index: Index
    __p: _

    init(index, raw) {
        __index = index
        __p = raw
    }

    get() {
        __p ?? throw ClosedError('translation unit is closed')
    }

    check-owner(owner) {
        get()
        if owner != self {
            throw SourceError('objects belong to different translation units')
        }
    }

    closed? -> Bool { __p == nil }
    spelling -> String { take-string(clang_getTranslationUnitSpelling(get())) }
    cursor -> Cursor { Cursor(self, clang_getTranslationUnitCursor(get())) }
    main-file -> File {
        file(spelling) ?? throw SourceError('main file unavailable')
    }
    diagnostics -> [Diagnostic] {
        [Diagnostic(self, clang_getDiagnostic(get(), i)) for i in ..clang_getNumDiagnostics(get())]
    }

    file(name: String) {
        optional-file(self, clang_getFile(get(), name.cstr()))
    }

    cursor-at(location: SourceLocation) {
        check-owner(location.unit)
        optional-cursor(self, clang_getCursor(get(), location.get()))
    }

    tokens(range: ?SourceRange = nil, annotate?: Bool = true) -> [Token] {
        let extent = range ?? main-file.extent
        check-owner(extent.unit)
        let out   = c.box-auto(c.ptr, nil)
        let count = c.box-auto(c.uint, 0)
        clang_tokenize(get(), extent.get(), out, count)
        let n = count[0]
        let p = out[0]
        defer clang_disposeTokens(get(), p, n)
        let cursors = c.new-auto(CXCursor, annotate? ? n : 0)

        if annotate? && n > 0 {
            clang_annotateTokens(get(), p, n, cursors)
        }

        [
            Token(
                self,
                p.as(CXToken)[i],
                annotate? ? optional-cursor(self, cursors[i]) : nil
            )
            for i in ..n
        ]
    }

    close() {
        if let $p = __p {
            __p = nil
            clang_disposeTranslationUnit(p)
            __index.release()
        }
    }

    __drop__() {
        close()
    }
}

pub class File {
    unit: TranslationUnit
    __p: _

    init(owner, raw) {
        unit = owner
        __p = raw
    }

    get() {
        unit.get()
        __p
    }

    name -> String { take-string(clang_getFileName(get())) }

    __buffer() {
        let size = c.box-auto(c.u64, 0)
        let p = clang_getFileContents(unit.get(), get(), size)
        if !p {
            throw SourceError("contents unavailable: {name}")
        }
        return {ptr: p, size: size[0]}
    }

    size -> Int { __buffer().size }
    contents -> String {
        let buffer = __buffer()
        c.str(buffer.ptr, buffer.size)
    }

    slice(start: Int, end: Int) -> String {
        let buffer = __buffer()
        if start < 0 || end < start || end > buffer.size {
            throw SourceError("byte range outside {name}: {start}..{end}")
        }
        c.str(buffer.ptr.as(c.u8) + start, end - start)
    }
    extent -> SourceRange { range(0, size) }

    location(offset: Int) -> SourceLocation {
        if offset < 0 || offset > size {
            throw SourceError("offset outside {name}: {offset}")
        }
        SourceLocation(unit, clang_getLocationForOffset(unit.get(), get(), offset))
    }

    position(line: Int, column: Int = 1) -> SourceLocation {
        if line < 1 || column < 1 {
            throw SourceError('lines and columns start at one')
        }
        SourceLocation(unit, clang_getLocation(unit.get(), get(), line, column))
    }

    range(start: Int, end: Int) -> SourceRange {
        if start > end {
            throw SourceError('range ends before it starts')
        }
        SourceRange.between(location(start), location(end))
    }

    tokens(annotate?: Bool = true) -> [Token] {
        unit.tokens(extent, annotate?=annotate?)
    }

    skipped-ranges() -> [SourceRange] {
        let $p = clang_getSkippedRanges(unit.get(), get()) or return []
        defer clang_disposeSourceRangeList(p)
        let (n, ranges) = c.load(CXSourceRangeList, p)
        [SourceRange(unit, ranges.as(CXSourceRange)[i]) for i in ..n]
    }

    ==(other) {
        return (other :: File)
            && (unit == other.unit)
            && (clang_File_isEqual(get(), other.get()) != 0)
    }

    __str__() { name }
}

pub class SourceLocation {
    unit: TranslationUnit
    __raw: _

    init(owner, raw) {
        unit = owner
        __raw = raw
    }

    get() {
        unit.get()
        __raw
    }

    __resolve(get-location) {
        let file   = c.box-auto(c.ptr, nil)
        let coords = c.new-auto(c.uint, 3)
        get-location(get(), file, coords, coords + 1, coords + 2)
        return {
            file: optional-file(unit, file[0]),
            line: coords[0],
            column: coords[1],
            offset: coords[2]
        }
    }

    expansion -> _ { __resolve(clang_getExpansionLocation) }
    spelling -> _ { __resolve(clang_getSpellingLocation) }
    physical -> _ { __resolve(clang_getFileLocation) }
    file -> _ { expansion.file }
    line -> Int { expansion.line }
    column -> Int { expansion.column }
    offset -> Int {
        let offset = c.new-auto(c.uint)
        clang_getExpansionLocation(get(), nil, nil, nil, offset)
        offset[0]
    }
    valid? -> Bool { clang_equalLocations(get(), clang_getNullLocation()) == 0 }
    main-file? -> Bool { clang_Location_isFromMainFile(get()) != 0 }
    system-header? -> Bool { clang_Location_isInSystemHeader(get()) != 0 }
    presumed -> _ {
        let filename = c.new-auto(CXString)
        let coords   = c.new-auto(c.uint, 2)
        clang_getPresumedLocation(get(), filename, coords, coords + 1)
        return {filename: take-string(filename[0]), line: coords[0], column: coords[1]}
    }

    ==(other) {
        return (other :: SourceLocation)
            && (unit == other.unit)
            && (clang_equalLocations(get(), other.get()) != 0)
    }

    __str__() {
        let pos = expansion
        "{pos.file ?? '<unknown>'}:{pos.line}:{pos.column}"
    }
}

pub class SourceRange {
    unit: TranslationUnit
    __raw: _

    init(owner, raw) {
        unit = owner
        __raw = raw
    }

    static between(start: SourceLocation, end: SourceLocation) {
        start.unit.check-owner(end.unit)
        let a = start.physical
        let b = end.physical
        if !a.file || a.file != b.file || a.offset > b.offset {
            throw SourceError('range requires ordered locations in the same file')
        }
        SourceRange(start.unit, clang_getRange(start.get(), end.get()))
    }

    get() {
        unit.get()
        __raw
    }

    valid? -> Bool { clang_Range_isNull(get()) == 0 }
    start -> SourceLocation { SourceLocation(unit, clang_getRangeStart(get())) }
    end -> SourceLocation { SourceLocation(unit, clang_getRangeEnd(get())) }
    text -> String {
        let a = start.physical
        let b = end.physical
        if !valid? || !a.file || a.file != b.file || a.offset > b.offset {
            throw SourceError('range does not describe contiguous file text')
        }
        a.file.slice(a.offset, b.offset)
    }

    tokens(annotate?: Bool = true) -> [Token] {
        unit.tokens(self, annotate?=annotate?)
    }

    ==(other) {
        return (other :: SourceRange)
            && (unit == other.unit)
            && (clang_equalRanges(get(), other.get()) != 0)
    }

    __str__() { "{start}..{end}" }
}

pub class Cursor {
    unit: TranslationUnit
    __raw: _

    init(owner, raw) {
        unit = owner
        __raw = raw
    }

    get() {
        unit.get()
        __raw
    }

    kind -> Int { get()[0] }
    kind-name -> String { take-string(clang_getCursorKindSpelling(kind)) }
    spelling -> String { take-string(clang_getCursorSpelling(get())) }
    display-name -> String { take-string(clang_getCursorDisplayName(get())) }
    usr -> String { take-string(clang_getCursorUSR(get())) }
    location -> SourceLocation { SourceLocation(unit, clang_getCursorLocation(get())) }
    extent -> SourceRange { SourceRange(unit, clang_getCursorExtent(get())) }
    type -> _ { optional-type(unit, clang_getCursorType(get())) }
    result-type -> _ { optional-type(unit, clang_getCursorResultType(get())) }
    underlying-type -> _ { optional-type(unit, clang_getTypedefDeclUnderlyingType(get())) }
    enum-type -> _ { optional-type(unit, clang_getEnumDeclIntegerType(get())) }
    enum-value -> Int { clang_getEnumConstantDeclValue(get()) }
    bit-width -> Int { clang_getFieldDeclBitWidth(get()) }
    semantic-parent -> _ { optional-cursor(unit, clang_getCursorSemanticParent(get())) }
    lexical-parent -> _ { optional-cursor(unit, clang_getCursorLexicalParent(get())) }
    referenced -> _ { optional-cursor(unit, clang_getCursorReferenced(get())) }
    definition -> _ { optional-cursor(unit, clang_getCursorDefinition(get())) }
    canonical -> Cursor { Cursor(unit, clang_getCanonicalCursor(get())) }
    included-file -> _ { optional-file(unit, clang_getIncludedFile(get())) }
    raw-comment -> String { take-string(clang_Cursor_getRawCommentText(get())) }
    brief-comment -> String { take-string(clang_Cursor_getBriefCommentText(get())) }
    definition? -> Bool { clang_isCursorDefinition(get()) != 0 }
    function-macro? -> Bool { clang_Cursor_isMacroFunctionLike(get()) != 0 }
    builtin-macro? -> Bool { clang_Cursor_isMacroBuiltin(get()) != 0 }
    declaration? -> Bool { clang_isDeclaration(kind) != 0 }
    reference? -> Bool { clang_isReference(kind) != 0 }
    expression? -> Bool { clang_isExpression(kind) != 0 }
    statement? -> Bool { clang_isStatement(kind) != 0 }
    attribute? -> Bool { clang_isAttribute(kind) != 0 }
    preprocessing? -> Bool { clang_isPreprocessing(kind) != 0 }
    invalid? -> Bool { clang_isInvalid(kind) != 0 }

    children() -> [Cursor] {
        let result = []
        C! closure visit(raw: CXCursor, parent: CXCursor, data: c.ptr) -> c.uint {
            result.push(Cursor(unit, raw))
            1
        }
        defer c.free-closure(visit)
        clang_visitChildren(get(), visit, nil)
        result
    }

    descendants(main-file?: Bool = false) {
        let result = []
        C! closure visit(raw: CXCursor, parent: CXCursor, data: c.ptr) -> c.uint {
            let node = Cursor(unit, raw)
            if main-file? && !node.location.main-file? {
                return 1
            }
            result.push({cursor: node, parent: Cursor(unit, parent)})
            2
        }
        defer c.free-closure(visit)
        clang_visitChildren(get(), visit, nil)
        result
    }

    visit(visitor, main-file?: Bool = false) {
        C! closure visit(raw: CXCursor, parent: CXCursor, data: c.ptr) -> c.uint {
            let node = Cursor(unit, raw)
            if main-file? && !node.location.main-file? {
                return 1
            }
            visitor(node, Cursor(unit, parent)) ? 2 : 1
        }
        defer c.free-closure(visit)
        clang_visitChildren(get(), visit, nil)
    }

    walk*(include-self?: Bool = true, main-file?: Bool = false) {
        let pending = [self]

        while let Some(node) = pending.try-pop() {
            let local? = node.location.main-file?
            let root? = node == self

            continue if main-file? && !root? && !local?

            if (include-self? || !root?) && (!main-file? || local?) {
                yield node
            }

            pending += node.children().reverse()
        }
    }

    arguments() -> [Cursor] {
        let n = max(0, clang_Cursor_getNumArguments(get()))
        [Cursor(unit, clang_Cursor_getArgument(get(), i)) for i in ..n]
    }

    tokens(annotate?: Bool = true) -> [Token] {
        unit.tokens(extent, annotate?=annotate?)
    }

    ==(other) {
        return (other :: Cursor)
            && (unit == other.unit)
            && (clang_equalCursors(get(), other.get()) != 0)
    }

    __hash__() { clang_hashCursor(get()) }
    __str__() { "{kind-name}({spelling})" }
}

pub class Type {
    unit: TranslationUnit
    __raw: _

    init(owner, raw) {
        unit = owner
        __raw = raw
    }

    get() {
        unit.get()
        __raw
    }

    kind -> Int { get()[0] }
    kind-name -> String { take-string(clang_getTypeKindSpelling(kind)) }
    spelling -> String { take-string(clang_getTypeSpelling(get())) }
    canonical -> Type { Type(unit, clang_getCanonicalType(get())) }
    pointee -> _ { optional-type(unit, clang_getPointeeType(get())) }
    result -> _ { optional-type(unit, clang_getResultType(get())) }
    element -> _ { optional-type(unit, clang_getArrayElementType(get())) }
    array-size -> Int { clang_getArraySize(get()) }
    declaration -> _ { optional-cursor(unit, clang_getTypeDeclaration(get())) }
    const? -> Bool { clang_isConstQualifiedType(get()) != 0 }
    volatile? -> Bool { clang_isVolatileQualifiedType(get()) != 0 }
    restrict? -> Bool { clang_isRestrictQualifiedType(get()) != 0 }
    variadic? -> Bool { clang_isFunctionTypeVariadic(get()) != 0 }
    size -> Int { clang_Type_getSizeOf(get()) }
    alignment -> Int { clang_Type_getAlignOf(get()) }

    offset-of(field: String) -> Int {
        clang_Type_getOffsetOf(get(), field.cstr())
    }

    arguments() -> [Type] {
        let n = max(0, clang_getNumArgTypes(get()))
        [Type(unit, clang_getArgType(get(), i)) for i in ..n]
    }

    ==(other) {
        return (other :: Type)
            && (unit == other.unit)
            && (clang_equalTypes(get(), other.get()) != 0)
    }

    __str__() { spelling }
}

pub class Token {
    kind: Int
    spelling: String
    location: SourceLocation
    extent: SourceRange
    cursor: ?Cursor

    init(unit, raw, annotation) {
        kind     = clang_getTokenKind(raw)
        spelling = take-string(clang_getTokenSpelling(unit.get(), raw))
        location = SourceLocation(unit, clang_getTokenLocation(unit.get(), raw))
        extent   = SourceRange(unit, clang_getTokenExtent(unit.get(), raw))
        cursor   = annotation
    }

    kind-name -> String { ['punctuation', 'keyword', 'identifier', 'literal', 'comment'][kind] }
    text -> String { extent.text }
    __str__() { spelling }
}

pub class Diagnostic {
    severity: Int
    spelling: String
    location: SourceLocation
    formatted: String
    ranges: [SourceRange]
    fix-its: Array[_]

    init(unit, raw) {
        defer clang_disposeDiagnostic(raw)
        let options = clang_defaultDiagnosticDisplayOptions()
        let n = clang_getDiagnosticNumRanges(raw)
        severity  = clang_getDiagnosticSeverity(raw)
        spelling  = take-string(clang_getDiagnosticSpelling(raw))
        location  = SourceLocation(unit, clang_getDiagnosticLocation(raw))
        formatted = take-string(clang_formatDiagnostic(raw, options))
        ranges    = [SourceRange(unit, clang_getDiagnosticRange(raw, i)) for i in ..n]
        fix-its   = [__fix-it(unit, raw, i) for i in ..clang_getDiagnosticNumFixIts(raw)]
    }

    __fix-it(unit, raw, i) {
        let range = c.new-auto(CXSourceRange)
        let text = take-string(clang_getDiagnosticFixIt(raw, i, range))
        return {range: SourceRange(unit, range[0]), text}
    }

    error? -> Bool { severity >= diagnostic-severity.ERROR }
    __str__() { formatted }
}
