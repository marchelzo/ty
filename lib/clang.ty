import ffi as c (C!)
import path (Path)

pub use LexToken = {
    start: Int,
    end: Int,
    kind: Int,
    line: Int,
    start-of-line?: Bool,
    spelling: String,
    text: String
}

if not let $libclang = c.open('clang', [nil, 18, 19, 20, 21, 17, 16]) {
    throw RuntimeError('failed to load libclang')
}

const CXIndex           = c.ptr
const CXTranslationUnit = c.ptr
const CXFile            = c.ptr
const CXDiagnostic      = c.ptr
const CXString          = c.struct(c.ptr, c.uint)
const CXCursor          = c.struct(c.uint, c.int, c.struct(c.ptr, c.ptr, c.ptr))
const CXType            = c.struct(c.uint, c.struct(c.ptr, c.ptr))
const CXSourceLocation  = c.struct(c.struct(c.ptr, c.ptr), c.uint)
const CXSourceRange     = c.struct(c.struct(c.ptr, c.ptr), c.uint, c.uint)
const CXToken           = c.struct(c.struct(c.uint, c.uint, c.uint, c.uint), c.ptr)
const CXUnsavedFile     = c.struct(c.ptr, c.ptr, c.ulong)
const CXSourceRangeList = c.struct(c.uint, c.ptr)

const RawToken = c.struct(c.uint, c.uint, c.uint, c.uint, c.uint, c.ptr)
let raw-lexer = nil

fn lexer-library() {
    if let $lib = raw-lexer {
        return lib
    }
    let directory = Path(__file__).parent / 'clang-lexer'
    raw-lexer = c.open(str(directory / 'lexer'))
    raw-lexer ?? throw RuntimeError("raw Clang lexer is not built; run make -C {directory}")
}

pub fn lex(source: String, trigraphs?: Bool = false) -> [LexToken] {
    let lib = lexer-library()
    C! lib fn {
        void *ty_clang_lex(char *, size_t, int, unsigned *);
        void ty_clang_lex_free(void *, unsigned);
    }
    let count = c.new-auto(c.uint)
    let tokens = ty_clang_lex(source, source.size(), int(trigraphs?), count)
    defer ty_clang_lex_free(tokens, count[0])
    let result: [LexToken] = []
    for i in ..count[0] {
        let (start, end, kind, line, sol, spelling) = tokens.as(RawToken)[i]
        result.push({start, end, kind, line, start-of-line?: bool(sol),
                     spelling: c.str(spelling), text: source.bsplice(start, end)})
    }
    result
}

C! libclang fn {
    CXString clang_getClangVersion();
    char *clang_getCString(CXString);
    void clang_disposeString(CXString);
    CXIndex clang_createIndex(int, int);
    void clang_disposeIndex(CXIndex);
    int clang_parseTranslationUnit2(
        CXIndex,
        char *,
        char **,
        int,
        CXUnsavedFile *,
        unsigned,
        unsigned,
        CXTranslationUnit *
    );
    void clang_disposeTranslationUnit(CXTranslationUnit);
    CXString clang_getTranslationUnitSpelling(CXTranslationUnit);
    CXCursor clang_getTranslationUnitCursor(CXTranslationUnit);
    CXFile clang_getFile(CXTranslationUnit, char *);
    CXString clang_getFileName(CXFile);
    unsigned clang_File_isEqual(CXFile, CXFile);
    char *clang_getFileContents(CXTranslationUnit, CXFile, size_t *);
    CXSourceLocation clang_getLocation(CXTranslationUnit, CXFile, unsigned, unsigned);
    CXSourceLocation clang_getLocationForOffset(CXTranslationUnit, CXFile, unsigned);
    CXSourceLocation clang_getNullLocation();
    unsigned clang_equalLocations(CXSourceLocation, CXSourceLocation);
    void clang_getExpansionLocation(
        CXSourceLocation,
        CXFile *,
        unsigned *,
        unsigned *,
        unsigned *
    );
    void clang_getSpellingLocation(
        CXSourceLocation,
        CXFile *,
        unsigned *,
        unsigned *,
        unsigned *
    );
    void clang_getFileLocation(
        CXSourceLocation,
        CXFile *,
        unsigned *,
        unsigned *,
        unsigned *
    );
    void clang_getPresumedLocation(CXSourceLocation, CXString *, unsigned *, unsigned *);
    int clang_Location_isInSystemHeader(CXSourceLocation);
    int clang_Location_isFromMainFile(CXSourceLocation);
    CXSourceRange clang_getRange(CXSourceLocation, CXSourceLocation);
    unsigned clang_equalRanges(CXSourceRange, CXSourceRange);
    int clang_Range_isNull(CXSourceRange);
    CXSourceLocation clang_getRangeStart(CXSourceRange);
    CXSourceLocation clang_getRangeEnd(CXSourceRange);
    CXSourceRangeList *clang_getSkippedRanges(CXTranslationUnit, CXFile);
    void clang_disposeSourceRangeList(CXSourceRangeList *);
    CXCursor clang_getCursor(CXTranslationUnit, CXSourceLocation);
    int clang_Cursor_isNull(CXCursor);
    unsigned clang_equalCursors(CXCursor, CXCursor);
    unsigned clang_hashCursor(CXCursor);
    CXString clang_getCursorKindSpelling(unsigned);
    CXString clang_getCursorSpelling(CXCursor);
    CXString clang_getCursorDisplayName(CXCursor);
    CXString clang_getCursorUSR(CXCursor);
    CXSourceLocation clang_getCursorLocation(CXCursor);
    CXSourceRange clang_getCursorExtent(CXCursor);
    CXCursor clang_getCursorSemanticParent(CXCursor);
    CXCursor clang_getCursorLexicalParent(CXCursor);
    CXCursor clang_getCursorReferenced(CXCursor);
    CXCursor clang_getCursorDefinition(CXCursor);
    CXCursor clang_getCanonicalCursor(CXCursor);
    unsigned clang_isCursorDefinition(CXCursor);
    unsigned clang_Cursor_isMacroFunctionLike(CXCursor);
    unsigned clang_Cursor_isMacroBuiltin(CXCursor);
    unsigned clang_isDeclaration(unsigned);
    unsigned clang_isReference(unsigned);
    unsigned clang_isExpression(unsigned);
    unsigned clang_isStatement(unsigned);
    unsigned clang_isAttribute(unsigned);
    unsigned clang_isPreprocessing(unsigned);
    unsigned clang_isInvalid(unsigned);
    unsigned clang_visitChildren(CXCursor, void *, void *);
    int clang_Cursor_getNumArguments(CXCursor);
    CXCursor clang_Cursor_getArgument(CXCursor, unsigned);
    CXFile clang_getIncludedFile(CXCursor);
    CXString clang_Cursor_getRawCommentText(CXCursor);
    CXString clang_Cursor_getBriefCommentText(CXCursor);
    CXType clang_getCursorType(CXCursor);
    CXType clang_getTypedefDeclUnderlyingType(CXCursor);
    CXType clang_getCursorResultType(CXCursor);
    CXType clang_getEnumDeclIntegerType(CXCursor);
    long long clang_getEnumConstantDeclValue(CXCursor);
    int clang_getFieldDeclBitWidth(CXCursor);
    CXString clang_getTypeSpelling(CXType);
    CXString clang_getTypeKindSpelling(unsigned);
    unsigned clang_equalTypes(CXType, CXType);
    CXType clang_getCanonicalType(CXType);
    CXType clang_getPointeeType(CXType);
    CXType clang_getResultType(CXType);
    int clang_getNumArgTypes(CXType);
    CXType clang_getArgType(CXType, unsigned);
    CXType clang_getArrayElementType(CXType);
    long long clang_getArraySize(CXType);
