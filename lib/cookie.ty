/**
 * Chrome cookie extraction and Netscape cookie-file support.
 *
 * The API provides general-purpose cookie handling plus Chrome extraction.
 */
import base64
import date (Duration, Instant)
import ffi as c (C!)
import json
import path (Path)
import sh
import sqlite (SQLite)
import time
#|if __apple__
import apple
#|]

pub const SUPPORTED_BROWSERS = ['chrome'].set()
pub const CHROMIUM_BASED_BROWSERS = SUPPORTED_BROWSERS

/* Chrome timestamps count microseconds from the Windows epoch. */
let CHROME_EPOCH = Instant.from('1601-01-01T00:00:00Z')

pub class CookieLoadError < RuntimeError {}

pub class Cookie {
    version: Int
    name: String
    value: String
    domain: String
    path: String
    secure: Bool
    expires: Int | Float | nil
    discard: Bool
    rest: Dict[String, Any]

    init(
        name: String,
        value: String,
        domain: String = '',
        path: String = '/',
        secure: Bool = false,
        expires: Int | Float | nil = nil,
        discard: Bool = false,
        version: Int = 0,
        rest: Dict[String, Any] = %{}
    ) {
        self.version = version
        self.name = name
        self.value = value
        self.domain = domain
        self.path = path || '/'
        self.secure = secure
        self.expires = expires
        self.discard = discard
        self.rest = rest
    }

    domain-specified -> Bool { domain != '' }
    domain-initial-dot -> Bool { domain.starts?('.') }
    path-specified -> Bool { path != '' }

    is-expired(now: Int | Float = time.utc()) -> Bool {
        expires != nil && expires != 0 && expires != 0.0 && expires <= now
    }
}

pub class CookieJar : Iterable[Cookie] {
    filename: String | nil
    __cookies: Array[Cookie]

    init(filename: String | Path | nil = nil) {
        self.filename = filename == nil ? nil : "{filename}"
        __cookies = []
    }

    __iter__() -> Iter[Cookie] { __cookies.__iter__() }
    #() -> Int { #__cookies }

    set-cookie(cookie: Cookie) -> Cookie {
        for old, i in __cookies {
            if old.domain.lower() == cookie.domain.lower()
            && old.path == cookie.path
            && old.name == cookie.name {
                __cookies[i] = cookie
                return cookie
            }
        }
        __cookies.push(cookie)
        cookie
    }

    clear(domain: String | nil = nil, path: String | nil = nil, name: String | nil = nil) {
        __cookies = __cookies.filter(c -> !(
            (domain == nil || c.domain == domain)
         && (path == nil || c.path == path)
         && (name == nil || c.name == name)
        ))
    }

    save(
        filename: String | Path | nil = nil,
        ignore-discard: Bool = true,
        ignore-expires: Bool = true
    ) {
        let output = filename == nil ? self.filename : "{filename}"
        if output == nil { throw ValueError('a cookie filename is required') }

        let lines = [
            '# Netscape HTTP Cookie File',
            '# This file is generated by Ty.  Do not edit.',
            ''
        ]
        let now = time.utc()
        for cookie in __cookies {
            continue if !ignore-discard && cookie.discard
            continue if !ignore-expires && cookie.is-expired(now)
            let domain = ('HttpOnly' in cookie.rest && cookie.rest['HttpOnly'])
                ? '#HttpOnly_' + cookie.domain
                : cookie.domain
            lines.push([
                domain,
                cookie.domain-initial-dot ? 'TRUE' : 'FALSE',
                cookie.path,
                cookie.secure ? 'TRUE' : 'FALSE',
                "{cookie.expires ?? 0}",
                cookie.name,
                cookie.value
            ].join('\t'))
        }
        Path(output).write(lines.join('\n') + '\n')
        self.filename = output
    }

    load(
        filename: String | Path | nil = nil,
        ignore-discard: Bool = true,
        ignore-expires: Bool = true
    ) -> CookieJar {
        let input = filename == nil ? self.filename : "{filename}"
        if input == nil { throw ValueError('a cookie filename is required') }

        let now = time.utc()
        for record in Path(input).read-text().split('\n') {
            let raw = record.ends?('\r') ? record.slice(0, #record - 1) : record
            let http-only = raw.starts?('#HttpOnly_')
            let line = http-only ? raw.slice(10) : raw
            continue if !line || line.starts?('#')

            let fields = line.split('\t')
            if #fields != 7 { continue }
            let expiry = fields[4] ? try { float(fields[4]) } : nil
            if fields[4] && expiry == nil { continue }
            let domain = fields[0]
            let include-subdomains = fields[1].upper() == 'TRUE'
            if include-subdomains && !domain.starts?('.') { domain = '.' + domain }
            if !include-subdomains && domain.starts?('.') { domain = domain.slice(1) }
            let cookie = Cookie(
                name=fields[5], value=fields[6], domain=domain, path=fields[2],
                secure=fields[3].upper() == 'TRUE', expires=(expiry == 0.0 ? nil : expiry),
                discard=expiry == nil || expiry == 0.0,
                rest=http-only ? %{'HttpOnly': true} : %{}
            )
            continue if !ignore-discard && cookie.discard
            continue if !ignore-expires && cookie.is-expired(now)
            set-cookie(cookie)
        }
        self.filename = input
        self
    }

    get-cookies-for-url(url: String) -> Array[Cookie] {
        let parts = url.match(/^(?:([A-Za-z][A-Za-z0-9+.-]*):\/\/)?([^\/:?#]+)(?::\d+)?([^?#]*)/)
        if parts == nil { return [] }
        let scheme = (parts[1] ?? 'http').lower()
        let host = parts[2].lower()
        let request-path = parts[3] || '/'
        let now = time.utc()

        __cookies.filter(fn (cookie) {
            let domain = cookie.domain.lower()
            if domain.starts?('.') { domain = domain.slice(1) }
            let domain-ok = host == domain || (cookie.domain.starts?('.') && host.ends?(".{domain}"))
            let path-ok = request-path == cookie.path || (
                request-path.starts?(cookie.path)
             && (cookie.path.ends?('/') || request-path.slice(#cookie.path, 1) == '/')
            )
            domain-ok && path-ok && (!cookie.secure || scheme == 'https') && !cookie.is-expired(now)
        }).sort(by=fn (c: Cookie) -> Int { #c.path }, desc=true)
    }

    get-cookie-header(url: String) -> String | nil {
        let cookies = get-cookies-for-url(url)
        cookies ? cookies.map(c -> "{c.name}={c.value}").join('; ') : nil
    }
}

fn merge-cookie-jars(jars: Array[CookieJar]) -> CookieJar {
    let output = CookieJar()
    for jar in jars {
        for cookie in jar { output.set-cookie(cookie) }
        if jar.filename != nil { output.filename = jar.filename }
    }
    output
}

fn wsl?() -> Bool {
#|if __linux__
    getenv('WSL_INTEROP') != nil || getenv('WSL_DISTRO_NAME') != nil
#|else
    false
#|]
}

pub fn windows-path-to-wsl(path: String) -> Path | nil {
    if #path < 3 || path.slice(1, 1) != ':' { return nil }
    let drive = path.slice(0, 1).lower()
    let rest = path.slice(2).replace('\\', '/')
    Path("/mnt/{drive}/{rest.trim('/')}")
}

fn windows-local-app-data() -> Path | nil {
    if !wsl?() { return nil }
    if not let $answer = sh.sh(
        "[Environment]::GetFolderPath('LocalApplicationData')",
        shell=['powershell.exe', '-NoProfile', '-NonInteractive', '-Command']
    ) { return nil }
    let out, result = answer
    if result.status != 0 { return nil }
    windows-path-to-wsl(out.trim())
}

fn profile-path(profile: String | Path | nil) -> Path {
#|if __windows__
    let root = Path(getenv('LOCALAPPDATA') ?? '.') / 'Google/Chrome/User Data'
#|else if __apple__
    let root = Path.home() / 'Library/Application Support/Google/Chrome'
#|else
    let linux-root = Path(getenv('XDG_CONFIG_HOME') ?? "{Path.home()}/.config") / 'google-chrome'
    let windows-root = windows-local-app-data()
    let root = windows-root == nil
        ? linux-root
        : windows-root / 'Google/Chrome/User Data'
#|]
    if profile == nil { return root }
    let p = Path(profile)
    p.absolute? ? p : root / p
}

fn newest-cookie-db(root: Path) -> Path | nil {
    let newest: Path | nil = nil
    let newest-time: Float = -1.0
    if !root.exists? { return nil }
    for path in root.rglob('Cookies') {
        let mtime = path.lstat.mtime
        if mtime > newest-time {
            newest = path
            newest-time = mtime
        }
    }
    newest
}

/* OpenSSL is used through Ty's FFI so extracting cookies needs no helper
 * process and works with arbitrary binary cookie values. */
let __crypto = c.open('crypto', [3, '1.1', nil])

C! __crypto fn {
    c.ptr EVP_aes_128_cbc()
    c.ptr EVP_aes_256_gcm()
    c.ptr EVP_CIPHER_CTX_new()
    c.void EVP_CIPHER_CTX_free(c.ptr)
    c.int EVP_DecryptInit_ex(c.ptr, c.ptr, c.ptr, c.ptr, c.ptr)
    c.int EVP_DecryptUpdate(c.ptr, c.ptr, c.ptr, c.ptr, c.int)
    c.int EVP_DecryptFinal_ex(c.ptr, c.ptr, c.ptr)
    c.int EVP_CIPHER_CTX_ctrl(c.ptr, c.int, c.int, c.ptr)
    c.int PKCS5_PBKDF2_HMAC_SHA1(c.ptr, c.int, c.ptr, c.int, c.int, c.int, c.ptr)
}

pub fn pbkdf2-sha1(
    password: String | Blob,
    salt: String | Blob,
    iterations: Int,
    key-length: Int
) -> Blob {
    if __crypto == nil { throw RuntimeError('libcrypto is required to decrypt Chrome cookies') }
    let out = Blob(*[0 for _ in ..key-length])
    if !PKCS5_PBKDF2_HMAC_SHA1(password, password.size(), salt, salt.size(), iterations, key-length, out) {
        throw RuntimeError('PBKDF2 failed')
    }
    out
}

fn aes-cbc-decrypt(ciphertext: Blob, key: Blob) -> Blob | nil {
    if __crypto == nil { return nil }
    let ctx = EVP_CIPHER_CTX_new()
    if !ctx { return nil }
    defer EVP_CIPHER_CTX_free(ctx)

    let iv = Blob(*[32 for _ in ..16])
    let out = Blob(*[0 for _ in ..(#ciphertext + 16)])
    let n1 = c.box(c.int, 0)
    let n2 = c.box(c.int, 0)
    defer c.free(n1)
    defer c.free(n2)

    if !EVP_DecryptInit_ex(ctx, EVP_aes_128_cbc(), nil, key, iv) { return nil }
    if !EVP_DecryptUpdate(ctx, out, n1, ciphertext, #ciphertext) { return nil }
    if !EVP_DecryptFinal_ex(ctx, out.ptr() + n1[0], n2) { return nil }
    out.slice(0, n1[0] + n2[0])
}

fn aes-gcm-decrypt(ciphertext: Blob, key: Blob) -> Blob | nil {
    /* Windows Chrome stores v10 payloads as nonce || ciphertext || tag. */
    if __crypto == nil || #key != 32 || #ciphertext < 28 { return nil }
    let ctx = EVP_CIPHER_CTX_new()
    if !ctx { return nil }
    defer EVP_CIPHER_CTX_free(ctx)

    let nonce = ciphertext.slice(0, 12)
    let encrypted = ciphertext.slice(12, #ciphertext - 28)
    let auth-tag = ciphertext.slice(#ciphertext - 16)
    let out = Blob(*[0 for _ in ..(#encrypted + 16)])
    let n1 = c.box(c.int, 0)
    let n2 = c.box(c.int, 0)
    defer c.free(n1)
    defer c.free(n2)

    if !EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), nil, nil, nil) { return nil }
    if !EVP_CIPHER_CTX_ctrl(ctx, 0x9, #nonce, nil) { return nil }
    if !EVP_DecryptInit_ex(ctx, nil, nil, key, nonce) { return nil }
    if !EVP_DecryptUpdate(ctx, out, n1, encrypted, #encrypted) { return nil }
    if !EVP_CIPHER_CTX_ctrl(ctx, 0x11, #auth-tag, auth-tag) { return nil }
    if !EVP_DecryptFinal_ex(ctx, out.ptr() + n1[0], n2) { return nil }
    out.slice(0, n1[0] + n2[0])
}

fn find-local-state(database: Path) -> Path | nil {
    let dir = database.parent
    while dir != dir.parent {
        let state = dir / 'Local State'
        if state.exists? { return state }
        dir = dir.parent
    }
    nil
}

fn windows-chrome-key(local-state: Path) -> Blob | nil {
    let state: _ = try { json.parse!(local-state.read-text()) } ?? return nil
    let encoded = try { state['os_crypt']['encrypted_key'] } ?? return nil
    let wrapped = try { base64.decode("{encoded}") } ?? return nil
    if #wrapped < 6 || wrapped.slice(0, 5).str() != 'DPAPI' { return nil }

    let script = [
        '$s=[Console]::In.ReadToEnd().Trim()',
        '$d=[Convert]::FromBase64String($s)',
        '$p=[Security.Cryptography.ProtectedData]::Unprotect($d,$null,[Security.Cryptography.DataProtectionScope]::CurrentUser)',
        '[Convert]::ToBase64String($p)'
    ].join(';')
    if not let $answer = sh.sh(
        script,
        input=base64.encode(wrapped.slice(5)),
        shell=['powershell.exe', '-NoProfile', '-NonInteractive', '-Command']
    ) { return nil }
    let out, result = answer
    if result.status != 0 { return nil }
    try { base64.decode(out.trim()) }
}

#|if __apple__
let __mac-key-lock = Mutex()
let __mac-safe-storage-checked = false
let __mac-safe-storage-key: Blob | nil = nil

fn mac-safe-storage-key() -> Blob | nil {
    with __mac-key-lock {
        if __mac-safe-storage-checked {
            return __mac-safe-storage-key
        }
        __mac-safe-storage-checked = true
        let password = apple.keychain-credential(
            'Chrome Safe Storage', account='Chrome'
        ) ?? return nil
        __mac-safe-storage-key = pbkdf2-sha1(password, 'saltysalt', 1003, 16)
        __mac-safe-storage-key
    }
}
#|]

pub class ChromeCookieDecryptor {
    meta-version: Int
    __key: Blob | nil
    __windows-key: Blob | nil
    cookie-counts: Dict[String, Int]
    decryption-failures: Int

    init(
        password: String | Blob | nil = nil,
        meta-version: Int = 0,
        windows-key: Blob | nil = nil
    ) {
        self.meta-version = meta-version
        __windows-key = windows-key
        cookie-counts = %{'v10': 0, 'v11': 0, 'v20': 0, 'other': 0}
        decryption-failures = 0
        if windows-key != nil {
            __key = nil
            return
        }
#|if __apple__
        /* Avoid touching Keychain unless decrypt() encounters an encrypted
         * value. Chrome can leave usable plaintext values in the same table. */
        __key = password == nil
            ? nil
            : pbkdf2-sha1(password, 'saltysalt', 1003, 16)
#|else
        __key = pbkdf2-sha1(password ?? 'peanuts', 'saltysalt', 1, 16)
#|]
    }

    key-available -> Bool { __key != nil || __windows-key != nil }

    decrypt(encrypted-value: Blob) -> String | nil {
        if #encrypted-value < 3 { return nil }
        let version = encrypted-value.slice(0, 3).str!()
        if version == 'v20' {
            cookie-counts['v20'] += 1
            decryption-failures += 1
            return nil
        }
#|if __apple__
        if version != 'v10' {
            cookie-counts['other'] += 1
            return encrypted-value.str()
        }
#|]
        if version != 'v10' && version != 'v11' {
            cookie-counts['other'] += 1
            return nil
        }
        cookie-counts[version] += 1
#|if __apple__
        if __key == nil && __windows-key == nil {
            __key = mac-safe-storage-key()
        }
#|]
        if __key == nil && __windows-key == nil {
            decryption-failures += 1
            return nil
        }
        let plain = (__windows-key != nil)
            ? aes-gcm-decrypt(encrypted-value.slice(3), __windows-key)
            : aes-cbc-decrypt(encrypted-value.slice(3), __key)
        if plain == nil {
            decryption-failures += 1
            return nil
        }
        if meta-version >= 24 {
            if #plain < 32 {
                decryption-failures += 1
                return nil
            }
            plain = plain.slice(32)
        }
        let value = plain.str()
        if value == nil { decryption-failures += 1 }
        value
    }
}

pub fn get-cookie-decryptor(
    password: String | Blob | nil = nil,
    meta-version: Int = 0,
    windows-key: Blob | nil = nil
) -> ChromeCookieDecryptor {
    ChromeCookieDecryptor(
        password=password, meta-version=meta-version, windows-key=windows-key
    )
}

fn chrome-row-value(row: Dict[String, Any]) -> String {
    match row['value'] {
        b: Blob => b.str() ?? '',
        s       => "{s ?? ''}"
    }
}

fn process-chrome-cookie(
    decryptor: ChromeCookieDecryptor,
    row: Dict[String, Any]
) -> Cookie | nil {
    let value = chrome-row-value(row)
    let encrypted = row['encrypted_value']
    if !value && encrypted != nil && #encrypted {
        value = decryptor.decrypt(encrypted) ?? return nil
    }
    let host = (row['host_key'] :: Blob) ? row['host_key'].str!() : "{row['host_key']}"
    let name = (row['name'] :: Blob) ? row['name'].str!() : "{row['name']}"
    let path = (row['path'] :: Blob) ? row['path'].str!() : "{row['path']}"
    let expiry = chrome-expiry(row['expires_utc'])
    Cookie(
        name=name, value=value !, domain=host, path=path,
        secure=bool(row['is_secure']), expires=expiry ? expiry : nil,
        discard=!expiry
    )
}

pub fn chrome-expiry(value: Int | Float | nil) -> Float | nil {
    if value == nil || value == 0 || value == 0.0 { return nil }
    let expires = CHROME_EPOCH.add(Duration(microseconds=Int(value)))
    expires.epoch-nanoseconds / 1000000000.0
}

fn cookie-domain-query(domains: Array[String]) -> (String, Array[String]) {
    if #domains == 0 { return ('', []) }
    let clauses = []
    let values: Array[String] = []
    for raw in domains {
        let domain = raw.lower().trim()
        if domain.starts?('.') { domain = domain.slice(1) }
        if domain == '' { continue }
        clauses.push('(lower(host_key) = ? OR lower(host_key) = ? OR lower(host_key) LIKE ?)')
        values.push(domain)
        values.push('.' + domain)
        values.push('%.' + domain)
    }
    (#clauses > 0) ? (' WHERE ' + clauses.join(' OR '), values) : ('', [])
}

pub fn extract-cookies-from-browser(
    browser-name: String = 'chrome',
    profile: String | Path | nil = nil,
    password: String | Blob | nil = nil,
    domains: Array[String] = []
) -> CookieJar {
    if browser-name.lower() != 'chrome' {
        throw ValueError("unsupported browser: {browser-name}")
    }

    let search-root = profile-path(profile)
    let db-path = newest-cookie-db(search-root)
        ?? throw RuntimeError("could not find chrome cookies database in {search-root}")

    with tmpdir = Path.tempdir('ty-chrome-cookies') {
        let copy = db-path.copy(tmpdir / 'Cookies.sqlite')
        let wal = Path("{db-path}-wal")
        if wal.exists? { wal.copy(Path("{copy}-wal")) }
        with db = SQLite("{copy}") {
            let meta-row: _ = db.fetchOne("SELECT value FROM meta WHERE key = 'version'", assoc=false)
            let meta-version = meta-row == nil ? 0 : int(meta-row[0])
            let columns: _ = db.fetchAll('PRAGMA table_info(cookies)', assoc=false)
            let names = columns.map(row -> "{row[1]}")
            let secure = ('is_secure' in names) ? 'is_secure' : 'secure'
            let (filter-sql, parameters) = cookie-domain-query(domains)
            let rows: _ = db.fetchAll(
                "SELECT host_key, name, value, encrypted_value, path, expires_utc, {secure} AS is_secure FROM cookies{filter-sql}",
                *parameters
            )
            let encrypted-count = rows.count(fn (row) {
                let value = chrome-row-value(row)
                let encrypted = row['encrypted_value']
                !value && encrypted != nil && #encrypted > 0
            })
            let windows-key: Blob | nil = nil
            if wsl?() && encrypted-count > 0 {
                if let $state = find-local-state(db-path) {
                    windows-key = windows-chrome-key(state)
                }
            }
            let decryptor = get-cookie-decryptor(
                password=password, meta-version=meta-version, windows-key=windows-key
            )
            if wsl?() && encrypted-count > 0 && windows-key == nil {
                throw CookieLoadError(
                    'could not unlock the Windows Chrome encryption key through powershell.exe'
                )
            }
            let jar = CookieJar()
            for row in rows {
                if let $cookie = process-chrome-cookie(decryptor, row) {
                    jar.set-cookie(cookie)
                }
            }
            if decryptor.cookie-counts['v20'] > 0 {
                throw CookieLoadError(
                    'Windows Chrome app-bound (v20) cookies cannot be decrypted outside Chrome'
                )
            }
            if encrypted-count > 0 && decryptor.decryption-failures == encrypted-count {
#|if __apple__
                if !decryptor.key-available {
                    throw CookieLoadError(
                        'Chrome Safe Storage password is unavailable; allow Keychain access and try again'
                    )
                }
#|]
                throw CookieLoadError('could not decrypt Chrome cookies with the Safe Storage key')
            }
            return jar
        }
    }
}

pub fn extract-chrome-cookies(
    profile: String | Path | nil = nil,
    password: String | Blob | nil = nil,
    domains: Array[String] = []
) -> CookieJar {
    extract-cookies-from-browser('chrome', profile, password=password, domains=domains)
}

pub fn load-cookies(
    cookie-file: String | Path | nil = nil,
    browser-specification: Any = nil
) -> CookieJar {
    try {
        let jars: Array[CookieJar] = []
        if browser-specification != nil {
            match browser-specification {
                name: String => jars.push(extract-cookies-from-browser(name)),
                [name] => jars.push(extract-cookies-from-browser(name)),
                [name, profile, *rest] => jars.push(extract-cookies-from-browser(name, profile))
            }
        }
        if cookie-file != nil {
            jars.push(CookieJar(cookie-file).load())
        }
        merge-cookie-jars(jars)
    } catch e {
        throw CookieLoadError("failed to load cookies: {e}")
    }
}
