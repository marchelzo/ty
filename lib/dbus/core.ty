import ffi as c (C!)

if not let $lib = c.open('systemd', [0]) {
    throw RuntimeError('failed to load libsystemd')
}

C! lib fn {
    int sd_bus_open_system(void **bus);
    int sd_bus_open_user(void **bus);
    int sd_bus_default_system(void **bus);
    int sd_bus_default_user(void **bus);
    void *sd_bus_flush_close_unref(void *bus);

    int sd_bus_message_new_method_call(
        void *bus, void **msg, const char *dest,
        const char *path, const char *iface, const char *member
    );
    int sd_bus_message_append(void *msg, const char *types, ...);
    int sd_bus_message_open_container(void *msg, char type, const char *contents);
    int sd_bus_message_close_container(void *msg);
    int sd_bus_call(void *bus, void *msg, uint64_t usec, void *error, void **reply);
    int sd_bus_message_read_array(void *msg, char type, const void **ptr, size_t *size);

    int sd_bus_call_method(
        void *bus,
        const char *destination,
        const char *path,
        const char *interface,
        const char *member,
        void *error,
        void **reply,
        const char *types,
        ...
    );

    int sd_bus_message_read_basic(
        void *msg, int type, void *p
    );
    int sd_bus_message_enter_container(
        void *msg, char type, const char *contents
    );
    int sd_bus_message_exit_container(void *msg);
    int sd_bus_message_at_end(void *msg, int complete);
    int sd_bus_message_skip(void *msg, const char *types);
    void *sd_bus_message_unref(void *msg);

    int sd_bus_get_property_string(
        void *bus, const char *destination,
        const char *path, const char *interface,
        const char *member, void *error,
        char **value
    );

    int sd_bus_get_property(
        void *bus, const char *destination,
        const char *path, const char *interface,
        const char *member, void *error,
        void **reply, const char *type
    );

    int sd_bus_set_property(
        void *bus, const char *destination,
        const char *path, const char *interface,
        const char *member, void *error,
        const char *type, ...
    );

    int sd_bus_match_signal(
        void *bus, void **slot,
        const char *sender, const char *path,
        const char *interface, const char *member,
        void *callback, void *userdata
    );

    void *sd_bus_slot_unref(void *slot);

    int sd_bus_process(void *bus, void **ret);
    int sd_bus_wait(void *bus, uint64_t timeout_usec);
    int sd_bus_get_fd(void *bus);

    int sd_bus_message_peek_type(
        void *msg, void *type, void **contents
    );
    char *sd_bus_message_get_signature(
        void *msg, int complete
    );

    char *strerror(int errnum);
}

pub class DBusError < RuntimeError {
    __code: Int

    init(code: Int, ctx: String = '') {
        __code = code
        super(
            (ctx == '')
                ? c.str(strerror(-code))
                : "{ctx}: {c.str(strerror(-code))}"
        )
    }

    code -> Int { __code }
}

fn check!(r: Int, ctx: String = '') {
    if r < 0 {
        throw DBusError(r, ctx)
    }
    r
}

pub __tls::_system-bus  = nil
pub __tls::_session-bus = nil

pub fn default-bus(kind: String = 'system') -> Bus {
    match kind {
        'system' => _system-bus  ?= connect(kind),
        'user'   => _session-bus ?= connect(kind),
        _        => throw DBusError(-22, "bad bus type: {kind}")
    }
}

pub fn connect(kind: String = 'system') {
    let bus = c.box-auto(c.ptr)
    match kind {
        'system' => check!(sd_bus_open_system(bus), 'sd_bus_open_system'),
        'user'   => check!(sd_bus_open_user(bus), 'sd_bus_open_user'),
        _        => throw DBusError(-22, "bad bus type: {kind}")
    }
    Bus(bus[0])
}

fn _type-arg(ch: String, v: _) -> _ {
    match ch {
        's', 'o', 'g'      => (c.ptr, v.cstr()),
        'b'                => (c.int, v ? 1 : 0),
        'i'                => (c.i32, v),
        'u'                => (c.u32, v),
        'x'                => (c.i64, v),
        't'                => (c.u64, v),
        'n', 'q', 'y', 'h' => (c.int, v),
        'd'                => (c.double, v),
        _                  => (c.ptr, v)
    }
}

fn _require(ok: Bool, context: String) {
    if !ok {
        throw DBusError(-22, context)
    }
}

fn _sig-end(sig: String, i: Int = 0) -> Int {
    match sig.char(i) {
        'a' => _sig-end(sig, i + 1),
        '(' => _sig-close(sig, i + 1, ')'),
        '{' => _sig-close(sig, i + 1, '}'),
        nil => throw DBusError(-22, "incomplete signature: {sig}"),
        _   => i + 1
    }
}

fn _sig-close(sig: String, i: Int, end: String) -> Int {
    match (sig.char(i), end) {
        (e, e)   => i + 1,
        (nil, _) => throw DBusError(-22, "unterminated signature: {sig}"),
        _        => _sig-close(sig, _sig-end(sig, i), end)
    }
}

fn _sig-split(sig: String) -> Array[String] {
    let types = []
    let i = 0
    while i < #sig {
        let j = _sig-end(sig, i)
        types.push(sig[i;j])
        i = j
    }
    types
}

pub tag Variant {}

pub class Bus {
    __bus: _

    init(bus: _) { __bus = bus }

    __drop__() {
        if __bus != nil {
            sd_bus_flush_close_unref(__bus)
        }
    }

    call(
        dest: String, path: String,
        iface: String, method: String,
        sig: String = '', *args
    ) -> Message {
        let pm = c.box-auto(c.ptr)
        let pr = c.box-auto(c.ptr)

        check!(
            sd_bus_message_new_method_call(
                __bus, pm, dest, path, iface, method
            ),
            "{iface}.{method}"
        )

        let msg = Message(pm[0]).append(sig, *args)

        check!(
            sd_bus_call(__bus, msg.ptr, 0, nil, pr),
            "{iface}.{method}"
        )

        Message(pr[0])
    }

    get-property-string(
        dest: String, path: String,
        iface: String, prop: String
    ) -> String {
        let pv = c.box-auto(c.ptr)

        check!(
            sd_bus_get_property_string(
                __bus, dest, path, iface, prop,
                nil, pv
            ),
            "{iface}.{prop}"
        )

        c.str(pv[0])
    }

    get-property(
        dest: String, path: String,
        iface: String, prop: String,
        sig: String
    ) -> Message {
        let msg = c.box-auto(c.ptr)

        check!(
            sd_bus_get_property(
                __bus, dest, path, iface, prop,
                nil, msg, sig
            ),
            "{iface}.{prop}"
        )

        Message(msg[0])
    }

    set-property(
        dest: String, path: String,
        iface: String, prop: String,
        sig: String, *args
    ) {
        check!(
            sd_bus_set_property(
                __bus, dest, path, iface, prop,
                nil, sig, *args
            ),
            "{iface}.{prop}"
        )
    }

    match-signal(
        sender: String | nil,
        path: String | nil,
        iface: String | nil,
        member: String | nil,
        cb
    ) {
        let slot = c.box-auto(c.ptr)

        let handler = C! closure
            on-signal(
                msg: c.ptr, ud: c.ptr, err: c.ptr
            ) -> c.int {
                cb(Message(msg, owned: false))
                0
            }

        check!(
            sd_bus_match_signal(
                __bus, slot,
                sender, path, iface, member,
                handler, nil
            ),
            'match_signal'
        )

        Slot(slot[0])
    }

    process() -> Bool {
        let r = sd_bus_process(__bus, nil)
        check!(r, 'process')
        r > 0
    }

    wait(timeout-usec: Int = -1) {
        check!(
            sd_bus_wait(__bus, timeout-usec),
            'wait'
        )
    }

    run(timeout-usec: Int = -1) {
        while true {
            if !process() {
                wait(timeout-usec)
            }
        }
    }

    fd -> Int { sd_bus_get_fd(__bus) }

    ptr -> _ { __bus }
}

pub class Slot {
    __slot: _

    init(slot: _) { __slot = slot }

    __drop__() {
        if __slot != nil {
            sd_bus_slot_unref(__slot)
        }
    }

    ptr -> _ { __slot }
}

pub class Message {
    __msg: _
    __owned: _

    init(msg: _, owned: Bool = true) {
        __msg = msg
        __owned = owned
    }

    __drop__() {
        if __owned && __msg != nil {
            sd_bus_message_unref(__msg)
        }
    }

    append(sig: String, *args) -> Message {
        let types = _sig-split(sig)
        _require(#types == #args, "expected {#types} arguments for '{sig}'")
        for t, arg in types.zip(args) {
            __append-value(t, arg)
        }
        self
    }

    __open(kind: String, sig: String) {
        check!(
            sd_bus_message_open_container(__msg, ord(kind), sig.cstr()),
            "open '{kind}' container"
        )
    }

    __close(kind: String) {
        check!(
            sd_bus_message_close_container(__msg),
            "close '{kind}' container"
        )
    }

    __append-value(sig: String, value) {
        match sig {
            /^[sogbiuxtnqydh]$/ => __append-basic(sig, value),
            'v'                 => __append-variant(value),
            /^a\{(.*)\}$/       => __append-dict($1, value),
            /^a(.+)$/           => __append-array($1, value),
            /^\((.*)\)$/        => __append-struct($1, value),
            _                   => throw DBusError(-22, "unsupported signature: {sig}")
        }
    }

    __append-basic(sig: String, value) {
        check!(
            sd_bus_message_append(__msg, sig.cstr(), _type-arg(sig, value)),
            "append '{sig}'"
        )
    }

    __append-variant(variant) {
        let Variant((sig, value)) = variant or throw DBusError(-22, "not a Variant: {variant}")
        _require(_sig-end(sig) == #sig, "invalid variant signature: {sig}")
        __open('v', sig)
        __append-value(sig, value)
        __close('v')
    }

    __append-array(sig: String, values) {
        __open('a', sig)
        for value in values {
            __append-value(sig, value)
        }
        __close('a')
    }

    __append-dict(sig: String, entries) {
        __open('a', "\{{sig}\}")
        for key, value in entries {
            __open('e', sig)
            append(sig, key, value)
            __close('e')
        }
        __close('a')
    }

    __append-struct(sig: String, fields) {
        __open('r', sig)
        append(sig, *fields)
        __close('r')
    }

    read-blob() -> Blob {
        let p = c.box-auto(c.ptr)
        let n = c.box-auto(c.u64)
        check!(
            sd_bus_message_read_array(__msg, 0x79, p, n),
            'read byte array'
        )
        n[0] == 0 ? Blob() : c.blob(p[0], n[0])
    }

    signature() -> String {
        c.str(sd_bus_message_get_signature(__msg, 1))
    }

    read-variant() {
        let tp = c.box-auto(c.u8)
        let contents = c.box-auto(c.ptr)
        sd_bus_message_peek_type(__msg, tp, contents)
        let sig = c.str(contents[0])
        enter-variant(sig)
        let v = read-value(sig)
        exit-container()
        v
    }

    read-string() -> String {
        let p = c.box-auto(c.ptr)
        check!(
            sd_bus_message_read_basic(__msg, 0x73, p),
            'read string'
        )
        c.str(p[0])
    }

    read-object-path() -> String {
        let p = c.box-auto(c.ptr)
        check!(
            sd_bus_message_read_basic(__msg, 0x6f, p),
            'read object path'
        )
        c.str(p[0])
    }

    read-bool() -> Bool {
        let p = c.box-auto(c.int)
        check!(
            sd_bus_message_read_basic(__msg, 0x62, p),
            'read bool'
        )
        p[0] != 0
    }

    read-i32() -> Int {
        let p = c.box-auto(c.i32)
        check!(
            sd_bus_message_read_basic(__msg, 0x69, p),
            'read i32'
        )
        p[0]
    }

    read-u32() -> Int {
        let p = c.box-auto(c.u32)
        check!(
            sd_bus_message_read_basic(__msg, 0x75, p),
            'read u32'
        )
        p[0]
    }

    read-i64() -> Int {
        let p = c.box-auto(c.i64)
        check!(
            sd_bus_message_read_basic(__msg, 0x78, p),
            'read i64'
        )
        p[0]
    }

    read-u64() -> Int {
        let p = c.box-auto(c.u64)
        check!(
            sd_bus_message_read_basic(__msg, 0x74, p),
            'read u64'
        )
        p[0]
    }

    read-double() -> Float {
        let p = c.box-auto(c.double)
        check!(
            sd_bus_message_read_basic(__msg, 0x64, p),
            'read double'
        )
        p[0]
    }

    read-byte() -> Int {
        let p = c.box-auto(c.u8)
        check!(
            sd_bus_message_read_basic(__msg, 0x79, p),
            'read byte'
        )
        p[0]
    }

    read-u16() -> Int {
        let p = c.box-auto(c.u16)
        check!(
            sd_bus_message_read_basic(__msg, 0x71, p),
            'read u16'
        )
        p[0]
    }

    read-i16() -> Int {
        let p = c.box-auto(c.i16)
        check!(
            sd_bus_message_read_basic(__msg, 0x6e, p),
            'read i16'
        )
        p[0]
    }

    enter-array(sig: String = '') -> Message {
        check!(
            sd_bus_message_enter_container(
                __msg, 0x61, sig.cstr()
            ),
            'enter array'
        )
        self
    }

    enter-struct(sig: String = '') -> Message {
        check!(
            sd_bus_message_enter_container(
                __msg, 0x72, sig.cstr()
            ),
            'enter struct'
        )
        self
    }

    enter-variant(sig: String = '') -> Message {
        check!(
            sd_bus_message_enter_container(
                __msg, 0x76, sig.cstr()
            ),
            'enter variant'
        )
        self
    }

    enter-dict-entry(sig: String = '') -> Message {
        check!(
            sd_bus_message_enter_container(
                __msg, 0x65, sig.cstr()
            ),
            'enter dict-entry'
        )
        self
    }

    exit-container() -> Message {
        check!(
            sd_bus_message_exit_container(__msg),
            'exit container'
        )
        self
    }

    at-end?() -> Bool {
        sd_bus_message_at_end(__msg, 0) > 0
    }

    skip(types: String = '') {
        check!(
            sd_bus_message_skip(__msg, types), 'skip'
        )
    }

    read-value(sig: String) {
        match sig {
            's'           => read-string(),
            'o'           => read-object-path(),
            'b'           => read-bool(),
            'i'           => read-i32(),
            'u'           => read-u32(),
            'x'           => read-i64(),
            't'           => read-u64(),
            'n'           => read-i16(),
            'q'           => read-u16(),
            'y'           => read-byte(),
            'd'           => read-double(),
            'v'           => read-variant(),
            'ay'          => read-blob(),
            /^a\{(.*)\}$/ => read-dict(*_sig-split($1)),
            /^a(.+)$/     => read-array($1),
            /^\((.*)\)$/  => __read-struct($1),
            _             => throw DBusError(-22, "unsupported signature: {sig}")
        }
    }

    read-values(sig: String) -> Tuple {
        tuple(*[read-value(t) for t in _sig-split(sig)])
    }

    __read-struct(sig: String) -> Tuple {
        enter-struct(sig)
        let fields = read-values(sig)
        exit-container()
        fields
    }

    read-array(element-sig: String) -> Array {
        enter-array(element-sig)
        let xs = []
        while !at-end?() {
            xs.push(read-value(element-sig))
        }
        exit-container()
        xs
    }

    read-string-array() -> Array[String] {
        read-array('s')
    }

    read-dict(
        key-sig: String, val-sig: String
    ) -> Dict {
        let d = %{}
        let sig = "{key-sig}{val-sig}"
        enter-array("\{{sig}\}")
        while !at-end?() {
            enter-dict-entry(sig)
            let (k, v) = read-values(sig)
            d[k] = v
            exit-container()
        }
        exit-container()
        d
    }

    read-string-dict() -> Dict[String, String] {
        read-dict('s', 's')
    }

    ptr -> _ { __msg }
}

pub fn introspect(
    dest: String, path: String,
    kind: String = 'system'
) -> String {
    let pp = c.box-auto(c.ptr)
    match kind {
        'system' => check!(sd_bus_open_system(pp), 'sd_bus_open_system'),
        'user'   => check!(sd_bus_open_user(pp), 'sd_bus_open_user'),
        _        => throw DBusError(-22, "bad bus: {kind}")
    }
    let bus = pp[0]

    let pr = c.box-auto(c.ptr)

    check!(
        sd_bus_call_method(
            bus,
            dest.cstr(), path.cstr(),
            'org.freedesktop.DBus.Introspectable',
            'Introspect',
            nil, pr, nil
        ),
        'Introspect'
    )

    let msg = pr[0]

    let sp = c.box-auto(c.ptr)
    sd_bus_message_read_basic(msg, 0x73, sp)
    let xml = c.str(sp[0])
    sd_bus_message_unref(msg)
    sd_bus_flush_close_unref(bus)

    xml
}
