import pretty (Printer)

pub use Edit = (String, String)

fn snake(
    a: Array[String],
    b: Array[String],
    x: Int,
    y: Int
) -> (Int, Int) {
    while x < #a && y < #b && a[x] == b[y] {
        x += 1
        y += 1
    }
    (x, y)
}

fn down?(v: Array[Int], off: Int, k: Int, d: Int) -> Bool {
    k == -d || (k != d && v[off + k - 1] < v[off + k + 1])
}

fn forward(a: Array[String], b: Array[String]) -> Array[Array[Int]] {
    let max = #a + #b
    let off = max + 1
    let v = [0 for _ in ..(2 * max + 3)]
    let trace: Array[Array[Int]] = []
    for d in ..(max + 1) {
        trace.push([*v])
        let k = -d
        while k <= d {
            let x0 = down?(v, off, k, d) ? v[off + k + 1] : v[off + k - 1] + 1
            let (x, y) = snake(a, b, x0, x0 - k)
            v[off + k] = x
            if x >= #a && y >= #b {
                return trace
            }
            k += 2
        }
    }
    trace
}

pub fn edits(a: Array[String], b: Array[String]) -> Array[Edit] {
    let trace = forward(a, b)
    let off = #a + #b + 1
    let out: Array[Edit] = []
    let x = #a
    let y = #b
    let d = #trace - 1
    while d >= 0 {
        let v = trace[d]
        let k = x - y
        let pk = down?(v, off, k, d) ? k + 1 : k - 1
        let px = v[off + pk]
        let py = px - pk
        while x > px && y > py {
            out.push(('=', a[x - 1]))
            x -= 1
            y -= 1
        }
        if d > 0 && x == px {
            out.push(('+', b[y - 1]))
        } else if d > 0 {
            out.push(('-', a[x - 1]))
        }
        x = px
        y = py
        d -= 1
    }
    out.reverse()
}

fn elided(n: Int) -> String {
    "  … {n} unchanged line{(n == 1) ? '' : 's'}"
}

fn prefixed(e: Edit) -> String {
    match e {
        ('=', s) => "  {s}",
        ('-', s) => "- {s}",
        (_, s)   => "+ {s}",
    }
}

pub fn unified(es: Array[Edit], context: Int = 3) -> Array[String] {
    let changed = [i for (op, _); i in es if op != '=']
    if #changed == 0 {
        return []
    }
    let keep = %{}
    for i in changed {
        for j in max(0, i - context)..min(#es, i + context + 1) {
            keep[j] = true
        }
    }
    let out: Array[String] = []
    let skipped = 0
    for e; i in es {
        if keep[i] {
            if skipped > 0 {
                out.push(elided(skipped))
                skipped = 0
            }
            out.push(prefixed(e))
        } else {
            skipped += 1
        }
    }
    if skipped > 0 {
        out.push(elided(skipped))
    }
    out
}

pub fn line-diff(a: String, b: String, context: Int = 3) -> Array[String] {
    unified(edits(a.lines(), b.lines()), context: context)
}

fn common-prefix(a: String, b: String) -> Int {
    let i = 0
    let n = min(#a, #b)
    while i < n && a[i] == b[i] {
        i += 1
    }
    i
}

fn window(s: String, at: Int, width: Int) -> (String, Int) {
    if #s <= width {
        return (s, at)
    }
    let start = max(0, at - width / 2)
    let end = min(#s, start + width)
    let head = (start > 0) ? '…' : ''
    let tail = (end < #s) ? '…' : ''
    ("{head}{s[start;end]}{tail}", at - start + #head)
}

pub fn caret(a: String, b: String, width: Int = 72) -> Array[String] {
    let sa = show(a)
    let sb = show(b)
    let at = common-prefix(sa, sb)
    let (wa, ca) = window(sa, at, width)
    let (wb, _) = window(sb, at, width)
    ["- {wa}", "+ {wb}", "  {' ' * ca}^"]
}

fn key-path(path: String, k: Any, field?: Bool) -> String {
    match k {
        s: String and field? => "{path}.{s}",
        _                    => "{path}[{show(k)}]",
    }
}

fn index-path(path: String, i: Int) -> String {
    "{path}[{i}]"
}

fn fields(x: Any) -> ?Dict[Any, Any] {
    match members(x) {
        d: Dict => d,
        _       => nil,
    }
}

pub class Walk {
    out:   Array[String] = []
    limit: Int

    init(limit: Int = 8) {
        self.limit = limit
    }

    full? -> Bool {
        #out >= limit
    }

    note(path: String, msg: String) {
        if !full? {
            out.push("{(path == '') ? '(value)' : path}: {msg}")
        }
    }

    differ(path: String, a: Any, b: Any) {
        note(path, "{show(a)} != {show(b)}")
    }

    arrays(path: String, a: Array[Any], b: Array[Any], depth: Int) {
        for i in ..min(#a, #b) {
            visit(index-path(path, i), a[i], b[i], depth + 1)
        }
        for i in #b..#a {
            note(index-path(path, i), "only on the left: {show(a[i])}")
        }
        for i in #a..#b {
            note(index-path(path, i), "only on the right: {show(b[i])}")
        }
    }

    keyed(
        path:    String,
        a:       Dict[Any, Any],
        b:       Dict[Any, Any],
        depth:   Int,
        fields?: Bool = false
    ) {
        for k, v in a {
            let at = key-path(path, k, fields?)
            if k in b {
                visit(at, v, b[k], depth + 1)
            } else {
                note(at, "only on the left: {show(v)}")
            }
        }
        for k, v in b {
            if !(k in a) {
                note(key-path(path, k, fields?), "only on the right: {show(v)}")
            }
        }
    }

    visit(path: String, a: Any, b: Any, depth: Int = 0) {
        if full? || a == b {
            return
        }
        if depth > 32 {
            differ(path, a, b)
            return
        }
        match (a, b) {
            (xs: Array, ys: Array) => arrays(path, xs, ys, depth),
            (x: Dict, y: Dict)     => keyed(path, x, y, depth),
            (x: Tuple, y: Tuple)   => do {
                keyed(path, members(x), members(y), depth, fields?: true)
            },
            _                      => objects(path, a, b, depth),
        }
    }

    objects(path: String, a: Any, b: Any, depth: Int) {
        if type(a) == type(b) and let $fa = fields(a) and let $fb = fields(b) {
            keyed(path, fa, fb, depth, fields?: true)
        } else {
            differ(path, a, b)
        }
    }
}

pub fn paths(a: Any, b: Any, limit: Int = 8) -> Array[String] {
    let w = Walk(limit: limit)
    w.visit('', a, b)
    w.out
}

fn structured?(v: Any) -> Bool {
    match v {
        _: Array or _: Dict or _: Tuple => true,
        _                               => fields(v) != nil,
    }
}

fn render(v: Any, width: Int) -> String {
    Printer(width: width, color: false).print(v)
}

pub fn explain(
    a:       Any,
    b:       Any,
    width:   Int = 72,
    context: Int = 3
) -> Array[String] {
    match (a, b) {
        (x: String, y: String) and ("\n" in x || "\n" in y) => do {
            line-diff(x, y, context)
        },
        (x: String, y: String) => caret(x, y, width: width),
        (_: String, _) or (_, _: String) => [],
        _ :: !structured?(a) || !structured?(b) => [],
        _ => do {
            let found = paths(a, b)
            let ra = render(a, width)
            let rb = render(b, width)
            if !("\n" in ra) && !("\n" in rb) {
                return found
            }
            [*found, '', *line-diff(ra, rb, context)]
        },
    }
}
