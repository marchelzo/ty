import ffi as c (C!)
import ptr (typed, untyped)
import date (PlainDate, PlainTime, PlainDateTime, Instant, Duration)

let libduckdb = c.open('duckdb') ?? throw RuntimeError(
    'failed to load libduckdb'
)

const duckdb_result      = c.struct(c.u64, c.u64, c.u64, c.ptr, c.ptr, c.ptr)
const duckdb_date_struct = c.struct(c.i32, c.i8, c.i8)
const duckdb_interval    = c.struct(c.i32, c.i32, c.i64)
const duckdb_hugeint     = c.struct(c.u64, c.i64)
const duckdb_list_entry  = c.struct(c.u64, c.u64)
const duckdb_time_tz     = c.struct(c.struct(c.i8, c.i8, c.i8, c.i32), c.i32)

C! libduckdb fn {
    typedef int duckdb_state;
    typedef int duckdb_type;
    typedef uint64_t idx_t;
    typedef void *duckdb_database;
    typedef void *duckdb_connection;
    typedef void *duckdb_config;
    typedef void *duckdb_prepared_statement;
    typedef void *duckdb_extracted_statements;
    typedef void *duckdb_data_chunk;
    typedef void *duckdb_vector;
    typedef void *duckdb_logical_type;
    typedef void *duckdb_value;
    typedef void *duckdb_appender;

    const char *duckdb_library_version(void);
    void duckdb_free(void *ptr);

    duckdb_state duckdb_create_config(duckdb_config *out_config);
    duckdb_state duckdb_set_config(duckdb_config config, const char *name, const char *option);
    void duckdb_destroy_config(duckdb_config *config);

    duckdb_state duckdb_open_ext(const char *path, duckdb_database *out_database, duckdb_config config, char **out_error);
    void duckdb_close(duckdb_database *database);
    duckdb_state duckdb_connect(duckdb_database database, duckdb_connection *out_connection);
    void duckdb_disconnect(duckdb_connection *connection);
    void duckdb_interrupt(duckdb_connection connection);

    idx_t duckdb_extract_statements(duckdb_connection connection, const char *query, duckdb_extracted_statements *out);
    const char *duckdb_extract_statements_error(duckdb_extracted_statements extracted);
    duckdb_state duckdb_prepare_extracted_statement(duckdb_connection connection, duckdb_extracted_statements extracted, idx_t index, duckdb_prepared_statement *out);
    void duckdb_destroy_extracted(duckdb_extracted_statements *extracted);

    duckdb_state duckdb_prepare(duckdb_connection connection, const char *query, duckdb_prepared_statement *out);
    const char *duckdb_prepare_error(duckdb_prepared_statement statement);
    void duckdb_destroy_prepare(duckdb_prepared_statement *statement);
    int duckdb_prepared_statement_type(duckdb_prepared_statement statement);
    idx_t duckdb_prepared_statement_column_count(duckdb_prepared_statement statement);
    const char *duckdb_prepared_statement_column_name(duckdb_prepared_statement statement, idx_t index);
    duckdb_logical_type duckdb_prepared_statement_column_logical_type(duckdb_prepared_statement statement, idx_t index);
    duckdb_state duckdb_bind_parameter_index(duckdb_prepared_statement statement, idx_t *out, const char *name);
    duckdb_state duckdb_bind_value(duckdb_prepared_statement statement, idx_t index, duckdb_value value);
    duckdb_state duckdb_clear_bindings(duckdb_prepared_statement statement);
    duckdb_state duckdb_execute_prepared(duckdb_prepared_statement statement, duckdb_result *out);

    void duckdb_destroy_result(duckdb_result *result);
    const char *duckdb_result_error(duckdb_result *result);
    idx_t duckdb_column_count(duckdb_result *result);
    const char *duckdb_column_name(duckdb_result *result, idx_t col);
    duckdb_logical_type duckdb_column_logical_type(duckdb_result *result, idx_t col);
    idx_t duckdb_rows_changed(duckdb_result *result);
    int duckdb_result_return_type(duckdb_result result);
    duckdb_data_chunk duckdb_fetch_chunk(duckdb_result result);

    idx_t duckdb_data_chunk_get_size(duckdb_data_chunk chunk);
    duckdb_vector duckdb_data_chunk_get_vector(duckdb_data_chunk chunk, idx_t col);
    void duckdb_destroy_data_chunk(duckdb_data_chunk *chunk);

    void *duckdb_vector_get_data(duckdb_vector vector);
    uint64_t *duckdb_vector_get_validity(duckdb_vector vector);
    duckdb_vector duckdb_list_vector_get_child(duckdb_vector vector);
    duckdb_vector duckdb_struct_vector_get_child(duckdb_vector vector, idx_t index);
    duckdb_vector duckdb_array_vector_get_child(duckdb_vector vector);

    duckdb_type duckdb_get_type_id(duckdb_logical_type type);
    char *duckdb_logical_type_get_alias(duckdb_logical_type type);
    duckdb_logical_type duckdb_create_logical_type(duckdb_type type);
    duckdb_logical_type duckdb_create_map_type(duckdb_logical_type key, duckdb_logical_type value);
    duckdb_logical_type duckdb_create_struct_type(duckdb_logical_type *types, const char **names, idx_t count);
    void duckdb_destroy_logical_type(duckdb_logical_type *type);
    uint8_t duckdb_decimal_width(duckdb_logical_type type);
    uint8_t duckdb_decimal_scale(duckdb_logical_type type);
    duckdb_type duckdb_decimal_internal_type(duckdb_logical_type type);
    duckdb_type duckdb_enum_internal_type(duckdb_logical_type type);
    uint32_t duckdb_enum_dictionary_size(duckdb_logical_type type);
    char *duckdb_enum_dictionary_value(duckdb_logical_type type, idx_t index);
    duckdb_logical_type duckdb_list_type_child_type(duckdb_logical_type type);
    duckdb_logical_type duckdb_array_type_child_type(duckdb_logical_type type);
    idx_t duckdb_array_type_array_size(duckdb_logical_type type);
    duckdb_logical_type duckdb_map_type_key_type(duckdb_logical_type type);
    duckdb_logical_type duckdb_map_type_value_type(duckdb_logical_type type);
    idx_t duckdb_struct_type_child_count(duckdb_logical_type type);
    char *duckdb_struct_type_child_name(duckdb_logical_type type, idx_t index);
    duckdb_logical_type duckdb_struct_type_child_type(duckdb_logical_type type, idx_t index);
    idx_t duckdb_union_type_member_count(duckdb_logical_type type);
    char *duckdb_union_type_member_name(duckdb_logical_type type, idx_t index);
    duckdb_logical_type duckdb_union_type_member_type(duckdb_logical_type type, idx_t index);

    duckdb_date_struct duckdb_from_date(int32_t date);
    int32_t duckdb_to_date(duckdb_date_struct date);
    duckdb_time_tz duckdb_from_time_tz(uint64_t micros);

    void duckdb_destroy_value(duckdb_value *value);
    duckdb_value duckdb_create_null_value(void);
    duckdb_value duckdb_create_bool(bool input);
    duckdb_value duckdb_create_int64(int64_t input);
    duckdb_value duckdb_create_double(double input);
    duckdb_value duckdb_create_varchar_length(const char *text, idx_t length);
    duckdb_value duckdb_create_blob(const uint8_t *data, idx_t length);
    duckdb_value duckdb_create_date(int32_t input);
    duckdb_value duckdb_create_time(int64_t input);
    duckdb_value duckdb_create_timestamp(int64_t input);
    duckdb_value duckdb_create_timestamp_tz(int64_t input);
    duckdb_value duckdb_create_interval(duckdb_interval input);
    duckdb_value duckdb_create_list_value(duckdb_logical_type type, duckdb_value *values, idx_t count);
    duckdb_value duckdb_create_struct_value(duckdb_logical_type type, duckdb_value *values);
    duckdb_value duckdb_create_map_value(duckdb_logical_type type, duckdb_value *keys, duckdb_value *values, idx_t count);
    duckdb_logical_type duckdb_get_value_type(duckdb_value value);
    bool duckdb_is_null_value(duckdb_value value);

    duckdb_state duckdb_appender_create(duckdb_connection connection, const char *schema, const char *table, duckdb_appender *out);
    const char *duckdb_appender_error(duckdb_appender appender);
    duckdb_state duckdb_append_value(duckdb_appender appender, duckdb_value value);
    duckdb_state duckdb_appender_end_row(duckdb_appender appender);
    duckdb_state duckdb_appender_close(duckdb_appender appender);
    duckdb_state duckdb_appender_destroy(duckdb_appender *appender);
}

const DuckDBSuccess = 0

const DUCKDB_STATEMENT_TYPE_SELECT     = 1
const DUCKDB_RESULT_TYPE_QUERY_RESULT  = 3

const USEC_PER_DAY = 86_400_000_000

ns T {
    pub const BOOLEAN         = 1
    pub const TINYINT         = 2
    pub const SMALLINT        = 3
    pub const INTEGER         = 4
    pub const BIGINT          = 5
    pub const UTINYINT        = 6
    pub const USMALLINT       = 7
    pub const UINTEGER        = 8
    pub const UBIGINT         = 9
    pub const FLOAT           = 10
    pub const DOUBLE          = 11
    pub const TIMESTAMP       = 12
    pub const DATE            = 13
    pub const TIME            = 14
    pub const INTERVAL        = 15
    pub const HUGEINT         = 16
    pub const VARCHAR         = 17
    pub const BLOB            = 18
    pub const DECIMAL         = 19
    pub const TIMESTAMP_S     = 20
    pub const TIMESTAMP_MS    = 21
    pub const TIMESTAMP_NS    = 22
    pub const ENUM            = 23
    pub const LIST            = 24
    pub const STRUCT          = 25
    pub const MAP             = 26
    pub const UUID            = 27
    pub const UNION           = 28
    pub const BIT             = 29
    pub const TIME_TZ         = 30
    pub const TIMESTAMP_TZ    = 31
    pub const UHUGEINT        = 32
    pub const ARRAY           = 33
    pub const SQLNULL         = 36
    pub const TIME_NS         = 39
    pub const TIMESTAMP_TZ_NS = 42
}

pub class DuckDBError < RuntimeError { }

pub class BinderException         < DuckDBError { }
pub class CatalogException        < DuckDBError { }
pub class ConstraintException     < DuckDBError { }
pub class ConversionException     < DuckDBError { }
pub class DependencyException     < DuckDBError { }
pub class InterruptException      < DuckDBError { }
pub class InternalException       < DuckDBError { }
pub class InvalidInputException   < DuckDBError { }
pub class IOException             < DuckDBError { }
pub class NotImplementedException < DuckDBError { }
pub class OutOfMemoryException    < DuckDBError { }
pub class OutOfRangeException     < DuckDBError { }
pub class ParserException         < DuckDBError { }
pub class PermissionException     < DuckDBError { }
pub class SequenceException       < DuckDBError { }
pub class SerializationException  < DuckDBError { }
pub class TransactionException    < DuckDBError { }
pub class TypeMismatchException   < DuckDBError { }
pub class ConnectionException     < DuckDBError { }

let ERRORS = %{
    'binder':             BinderException,
    'catalog':            CatalogException,
    'constraint':         ConstraintException,
    'connection':         ConnectionException,
    'conversion':         ConversionException,
    'dependency':         DependencyException,
    'interrupt':          InterruptException,
    'internal':           InternalException,
    'invalid input':      InvalidInputException,
    'io':                 IOException,
    'not implemented':    NotImplementedException,
    'out of memory':      OutOfMemoryException,
    'out of range':       OutOfRangeException,
    'parser':             ParserException,
    'permission':         PermissionException,
    'sequence':           SequenceException,
    'serialization':      SerializationException,
    'transactioncontext': TransactionException,
    'transaction':        TransactionException,
    'type mismatch':      TypeMismatchException,
}

fn fail(msg: String) {
    let error = match (/^([\w ]+?) Error:/)(msg) {
        [_, kind] => ERRORS[kind.lower()],
        _         => nil
    }
    throw (error ?? DuckDBError)(msg)
}

fn check(state: Int, msg: () -> String) {
    if state != DuckDBSuccess {
        fail(msg())
    }
}

fn text(p: _) -> String | nil {
    (p == nil) ? nil : c.str(p)
}

fn handle(p: _) -> _ {
    c.box-auto(c.ptr, p)
}

fn owned-str(p: _) -> _ {
    let s = (p == nil) ? nil : c.str(p)
    duckdb_free(p)
    s
}

fn borrowing(lt: _, f: _) -> _ {
    try {
        f(lt)
    } finally {
        duckdb_destroy_logical_type(handle(lt))
    }
}

fn quote(name: String) -> String {
    let escaped = name.replace('"', '""')
    "\"{escaped}\""
}

fn plain-time(us: Int, nanos: Int = 0) -> PlainTime {
    PlainTime(
        us / 3_600_000_000,
        us / 60_000_000 % 60,
        us / 1_000_000 % 60,
        us / 1_000 % 1_000,
        us % 1_000,
        nanos
    )
}

fn plain-date-time(us: Int) -> PlainDateTime {
    Instant.from-epoch-microseconds(us).to-plain-date-time-utc()
}

fn plain-date(days: Int) -> PlainDate {
    PlainDate(*duckdb_from_date(days))
}

fn epoch-days(d: _) -> Int {
    duckdb_to_date((d.year, d.month, d.day))
}

fn time-micros(t: _) -> Int {
    ((t.hour * 60 + t.minute) * 60 + t.second) * 1_000_000
  + t.millisecond * 1_000
  + t.microsecond
}

fn interval(d: Duration) -> (Int, Int, Int) {
    let micros = ((d.hours * 60 + d.minutes) * 60 + d.seconds) * 1_000_000
               + d.milliseconds * 1_000
               + d.microseconds
               + d.nanoseconds / 1_000
    (d.years * 12 + d.months, d.weeks * 7 + d.days, micros)
}

fn duration(parts: (Int, Int, Int)) -> Duration {
    let (months, days, us) = parts
    Duration(
        months:       months,
        days:         days,
        hours:        us / 3_600_000_000,
        minutes:      us / 60_000_000 % 60,
        seconds:      us / 1_000_000 % 60,
        milliseconds: us / 1_000 % 1_000,
        microseconds: us % 1_000
    )
}

fn huge(parts: (Int, Int)) -> Int | Float {
    let (lower, upper) = parts
    match upper {
        0  and lower >= 0 => lower,
        -1 and lower <  0 => lower,
        _                 => upper * 2.0 ** 64 + (lower < 0 ? lower + 2.0 ** 64 : lower)
    }
}

fn uhuge(parts: (Int, Int)) -> Int | Float {
    let (lower, upper) = parts
    let unsigned = x -> (x < 0) ? x + 2.0 ** 64 : x
    (upper == 0 && lower >= 0) ? lower : unsigned(upper) * 2.0 ** 64 + unsigned(lower)
}

fn hex32(x: Int) -> String {
    "{(x >> 32) & 0xFFFFFFFF:08x}{x & 0xFFFFFFFF:08x}"
}

fn uuid(parts: (Int, Int)) -> String {
    let (lower, upper) = parts
    let h = "{hex32(upper ^ (1 << 63))}{hex32(lower)}"
    "{h[;8]}-{h[8;12]}-{h[12;16]}-{h[16;20]}-{h[20;]}"
}

fn bits(b: Blob) -> String {
    let padding = b[0]
    let s = [*b[1;]].map(byte -> "{byte:08b}").join('')
    s[padding;]
}

fn string-at(p: _) -> (_, Int) {
    let n = c.load(c.u32, p)
    (n <= 12) ? (p + 4, n) : (c.load(c.ptr, p + 8), n)
}

fn valid?(mask: _, row: Int) -> Bool {
    ((mask[row >> 6] >> (row & 63)) & 1) != 0
}

fn masked(vec: _, get: _) -> _ {
    match duckdb_vector_get_validity(vec) {
        nil  => get,
        mask => row -> valid?(typed(mask, c.u64), row) ? get(row) : nil
    }
}

fn data(vec: _) -> _ {
    untyped(duckdb_vector_get_data(vec))
}

fn fixed(ct: _, f: _ = nil) -> _ {
    return fn (vec) {
        let xs = typed(data(vec), ct)
        masked(vec, (f == nil) ? (row -> xs[row]) : (row -> f(xs[row])))
    }
}

fn strings(f: _) -> _ {
    return fn (vec) {
        let base = data(vec)
        masked(vec, row -> f(*string-at(base + 16 * row)))
    }
}

fn range-of(get: _, off: Int, n: Int) -> Array {
    [get(i) for i in off..off + n]
}

fn entries(get: _, off: Int, n: Int) -> Dict {
    %{k: v for (k, v) in range-of(get, off, n)}
}

fn lists(child: _, collect: _ = range-of) -> _ {
    return fn (vec) {
        let es  = typed(data(vec), duckdb_list_entry)
        let get = child.read(duckdb_list_vector_get_child(vec))
        masked(vec, row -> collect(get, *es[row]))
    }
}

fn arrays(child: _, size: Int) -> _ {
    return fn (vec) {
        let get = child.read(duckdb_array_vector_get_child(vec))
        masked(vec, row -> range-of(get, row * size, size))
    }
}

fn record(names: Array, values: Array) -> _ {
    tuple(**%{n: v for (n, v) in names.zip(values)})
}

fn structs(fields: Array) -> _ {
    let names = fields.map(&0)
    return fn (vec) {
        let gets = [f.1.read(duckdb_struct_vector_get_child(vec, i)) for f; i in fields]
        masked(vec, row -> record(names, gets.map(\_(row))))
    }
}

fn unions(members: Array) -> _ {
    return fn (vec) {
        let tags = typed(data(duckdb_struct_vector_get_child(vec, 0)), c.u8)
        let gets = [m.1.read(duckdb_struct_vector_get_child(vec, i + 1)) for m; i in members]
        masked(vec, row -> gets[tags[row]](row))
    }
}

fn unsupported(name: String) -> _ {
    _ -> _ -> throw NotImplementedException("Not implemented Error: cannot read {name} values")
}

use Decoder = {name: String, read: _}

fn children(lt: _, count: _, name: _, kind: _) -> Array {
    [
        (owned-str(name(lt, i)), borrowing(kind(lt, i), decoder))
        for i in 0..count(lt)
    ]
}

fn scalar(id: Int) -> Decoder | nil {
    match id {
        T.BOOLEAN         => ({name: 'BOOLEAN',   read: fixed(c.u8, \_ != 0)}),
        T.TINYINT         => ({name: 'TINYINT',   read: fixed(c.i8)}),
        T.SMALLINT        => ({name: 'SMALLINT',  read: fixed(c.i16)}),
        T.INTEGER         => ({name: 'INTEGER',   read: fixed(c.i32)}),
        T.BIGINT          => ({name: 'BIGINT',    read: fixed(c.i64)}),
        T.UTINYINT        => ({name: 'UTINYINT',  read: fixed(c.u8)}),
        T.USMALLINT       => ({name: 'USMALLINT', read: fixed(c.u16)}),
        T.UINTEGER        => ({name: 'UINTEGER',  read: fixed(c.u32)}),
        T.UBIGINT         => ({name: 'UBIGINT',   read: fixed(c.u64, \uhuge((_, 0)))}),
        T.HUGEINT         => ({name: 'HUGEINT',   read: fixed(duckdb_hugeint, huge)}),
        T.UHUGEINT        => ({name: 'UHUGEINT',  read: fixed(duckdb_hugeint, uhuge)}),
        T.FLOAT           => ({name: 'FLOAT',     read: fixed(c.float)}),
        T.DOUBLE          => ({name: 'DOUBLE',    read: fixed(c.double)}),
        T.VARCHAR         => ({name: 'VARCHAR',   read: strings(c.str)}),
        T.BLOB            => ({name: 'BLOB',      read: strings(\Blob().push(_, _))}),
        T.BIT             => ({name: 'BIT',       read: strings(\bits(Blob().push(_, _)))}),
        T.UUID            => ({name: 'UUID',      read: fixed(duckdb_hugeint, uuid)}),
        T.DATE            => ({name: 'DATE',      read: fixed(c.i32, plain-date)}),
        T.TIME            => ({name: 'TIME',      read: fixed(c.i64, plain-time)}),
        T.TIME_NS         => ({name: 'TIME_NS',   read: fixed(c.i64, t -> plain-time(t / 1_000, t % 1_000))}),
        T.TIME_TZ         => ({name: 'TIME WITH TIME ZONE', read: fixed(c.u64, time-tz)}),
        T.INTERVAL        => ({name: 'INTERVAL',  read: fixed(duckdb_interval, duration)}),
        T.TIMESTAMP       => ({name: 'TIMESTAMP', read: fixed(c.i64, plain-date-time)}),
        T.TIMESTAMP_S     => ({name: 'TIMESTAMP_S',  read: fixed(c.i64, \plain-date-time(_ * 1_000_000))}),
        T.TIMESTAMP_MS    => ({name: 'TIMESTAMP_MS', read: fixed(c.i64, \plain-date-time(_ * 1_000))}),
        T.TIMESTAMP_NS    => ({name: 'TIMESTAMP_NS', read: fixed(c.i64, \Instant(_).to-plain-date-time-utc())}),
        T.TIMESTAMP_TZ    => ({name: 'TIMESTAMP WITH TIME ZONE', read: fixed(c.i64, Instant.from-epoch-microseconds)}),
        T.TIMESTAMP_TZ_NS => ({name: 'TIMESTAMP_NS WITH TIME ZONE', read: fixed(c.i64, Instant)}),
        T.SQLNULL         => ({name: 'NULL',      read: _ -> _ -> nil}),
        _                 => nil
    }
}

fn time-tz(bits: Int) -> (PlainTime, Int) {
    let ((h, m, s, us), offset) = duckdb_from_time_tz(bits)
    (PlainTime(h, m, s, us / 1_000, us % 1_000), offset)
}

fn decimal(lt: _) -> Decoder {
    let (width, scale) = (duckdb_decimal_width(lt), duckdb_decimal_scale(lt))
    let unit = 10.0 ** scale
    let ct = match duckdb_decimal_internal_type(lt) {
        T.SMALLINT => c.i16,
        T.INTEGER  => c.i32,
        T.BIGINT   => c.i64,
        _          => duckdb_hugeint
    }
    let num = (ct == duckdb_hugeint) ? huge : float
    ({name: "DECIMAL({width},{scale})", read: fixed(ct, \num(_) / unit)})
}

fn enumeration(lt: _) -> Decoder {
    let labels = [owned-str(duckdb_enum_dictionary_value(lt, i)) for i in 0..duckdb_enum_dictionary_size(lt)]
    let ct = match duckdb_enum_internal_type(lt) {
        T.UTINYINT  => c.u8,
        T.USMALLINT => c.u16,
        _           => c.u32
    }
    let shown = labels.map(quote-string).join(', ')
    return {name: "ENUM({shown})", read: fixed(ct, \labels[_])}
}

fn compound(lt: _, id: Int) -> Decoder {
    match id {
        T.DECIMAL => decimal(lt),
        T.ENUM    => enumeration(lt),

        T.LIST => do {
            let child = borrowing(duckdb_list_type_child_type(lt), decoder)
            ({name: "{child.name}[]", read: lists(child)})
        },

        T.ARRAY => do {
            let child = borrowing(duckdb_array_type_child_type(lt), decoder)
            let size = duckdb_array_type_array_size(lt)
            ({name: "{child.name}[{size}]", read: arrays(child, size)})
        },

        T.MAP => do {
            let k = borrowing(duckdb_map_type_key_type(lt), decoder)
            let v = borrowing(duckdb_map_type_value_type(lt), decoder)
            let kv = {name: '', read: structs([('k', k), ('v', v)])}
            ({name: "MAP({k.name}, {v.name})", read: lists(kv, entries)})
        },

        T.STRUCT => do {
            let fields = children(
                lt,
                duckdb_struct_type_child_count,
                duckdb_struct_type_child_name,
                duckdb_struct_type_child_type
            )
            let shown = fields.map(|(n, d)| -> "{quote(n)} {d.name}").join(', ')
            ({name: "STRUCT({shown})", read: structs(fields)})
        },

        T.UNION => do {
            let members = children(
                lt,
                duckdb_union_type_member_count,
                duckdb_union_type_member_name,
                duckdb_union_type_member_type
            )
            let shown = members.map(|(n, d)| -> "{quote(n)} {d.name}").join(', ')
            ({name: "UNION({shown})", read: unions(members)})
        },

        _ => ({name: "TYPE#{id}", read: unsupported("type #{id}")})
    }
}

fn decoder(lt: _) -> Decoder {
    let id = duckdb_get_type_id(lt)
    let d = scalar(id) ?? compound(lt, id)
    match owned-str(duckdb_logical_type_get_alias(lt)) {
        nil   => d,
        alias => ({name: alias, read: d.read})
    }
}

fn drop-value(v: _) {
    duckdb_destroy_value(handle(v))
}

fn values-array(vs: Array) -> _ {
    let xs = c.new-auto(c.ptr, max(#vs, 1))
    for v; i in vs {
        xs[i] = v
    }
    xs
}

fn made(v: _, what: String) -> _ {
    v ?? throw ConversionException("Conversion Error: cannot convert {what} to a DuckDB value")
}

fn holding(vs: Array, f: _) -> _ {
    try {
        f(vs)
    } finally {
        vs.each(drop-value)
    }
}

fn element-type(vs: Array, f: _) -> _ {
    match vs.find(\!duckdb_is_null_value(_)) {
        nil => borrowing(duckdb_create_logical_type(T.SQLNULL), f),
        v   => f(duckdb_get_value_type(v))
    }
}

fn widened(xs: Array) -> Array {
    xs.any?(\_ :: Float) ? xs.map(x -> (x :: Int) ? float(x) : x) : xs
}

fn list-value(xs: Array) -> _ {
    holding(widened(xs).map(value), vs -> element-type(vs, lt -> made(
        duckdb_create_list_value(lt, values-array(vs), #vs),
        'a mixed-type list'
    )))
}

fn map-value(d: Dict) -> _ {
    let n = #d
    holding([*widened(d.keys()), *widened(d.values())].map(value), fn (vs) {
        let (keys, vals) = (vs[;n], vs[n;])
        element-type(keys, kt -> element-type(vals, vt -> borrowing(
            duckdb_create_map_type(kt, vt),
            mt -> made(
                duckdb_create_map_value(mt, values-array(keys), values-array(vals), n),
                'a mixed-type dictionary'
            )
        )))
    })
}

fn struct-value(fields: Dict) -> _ {
    let names = fields.keys().map(&cstr)
    holding(fields.values().map(value), fn (vs) {
        let types = values-array(vs.map(duckdb_get_value_type))
        let cnames = c.new-auto(c.ptr, max(#names, 1))
        for n; i in names {
            cnames[i] = n
        }
        borrowing(
            duckdb_create_struct_type(types, cnames, #vs),
            st -> duckdb_create_struct_value(st, values-array(vs))
        )
    })
}

fn value(x: _) -> _ {
    match x {
        nil              => duckdb_create_null_value(),
        b: Bool          => duckdb_create_bool(b ? 1 : 0),
        i: Int           => duckdb_create_int64(i),
        f: Float         => duckdb_create_double(f),
        s: String        => duckdb_create_varchar_length(s, s.size()),
        b: Blob          => duckdb_create_blob(b, #b),
        d: PlainDate     => duckdb_create_date(epoch-days(d)),
        t: PlainTime     => duckdb_create_time(time-micros(t)),
        t: PlainDateTime => duckdb_create_timestamp(epoch-days(t) * USEC_PER_DAY + time-micros(t)),
        t: Instant       => duckdb_create_timestamp_tz(t.epoch-microseconds),
        d: Duration      => duckdb_create_interval(interval(d)),
        xs: Array        => list-value(xs),
        d: Dict          => map-value(d),
        t: Tuple         => Tuple.named?(t) ? struct-value(members(t)) : list-value([*t]),
        _                => made(nil, "{type(x)}")
    }
}

fn bindings(row: _) -> (Array, Dict) {
    match row {
        xs: Array => (xs, %{}),
        d: Dict   => ([], d),
        t: Tuple  => Tuple.named?(t) ? ([], members(t)) : ([*t], %{}),
        x         => ([x], %{})
    }
}

fn row-maker(names: Array) -> _ {
    (#names.nub() == #names) ? record@(names, _) : &tuple
}

class Result {
    __res:     _
    __readers: Array
    __row:     _
    __buffer:  Array
    __next:    Int
    __done?:   Bool

    columns:      Array[String]
    types:        Array[String]
    rows-changed: Int
    rows?:        Bool

    init(res: _) {
        __res = res
        let ds = [
            borrowing(duckdb_column_logical_type(res, i), decoder)
            for i in 0..duckdb_column_count(res)
        ]
        columns      = [c.str(duckdb_column_name(res, i)) for i in 0..#ds]
        types        = ds.map(&.name)
        __readers    = ds.map(&.read)
        __row        = row-maker(columns)
        __buffer     = []
        __next       = 0
        rows?        = duckdb_result_return_type(res) == DUCKDB_RESULT_TYPE_QUERY_RESULT
        __done?      = !rows?
        rows-changed = duckdb_rows_changed(res)
    }

    description -> Array {
        [{name: n, type: t} for (n, t) in columns.zip(types)]
    }

    __decode(chunk: _) -> Array {
        let gets = [read(duckdb_data_chunk_get_vector(chunk, j)) for read; j in __readers]
        [__row(gets.map(\_(i))) for i in 0..duckdb_data_chunk_get_size(chunk)]
    }

    __load(chunk: _) {
        try {
            __buffer = __decode(chunk)
            __next   = 0
        } finally {
            duckdb_destroy_data_chunk(handle(chunk))
        }
    }

    __fill() -> Bool {
        while !__done? && __next == #__buffer {
            match duckdb_fetch_chunk(__res) {
                nil   => close(),
                chunk => __load(chunk)
            }
        }
        __next < #__buffer
    }

    fetchone() -> _ {
        __fill() ? __buffer[(__next += 1) - 1] : nil
    }

    fetchmany(n: Int = 1) -> Array {
        let rows = []
        while #rows < n && __fill() {
            let k = min(n - #rows, #__buffer - __next)
            rows += __buffer[__next;__next + k]
            __next += k
        }
        rows
    }

    fetchall() -> Array {
        fetchmany(Int.MAX)
    }

    rows*() -> Generator[_] {
        while let $row = fetchone() {
            yield row
        }
    }

    __iter__() -> Generator[_] { rows() }

    close() {
        __done? = true
        if __res != nil {
            duckdb_destroy_result(__res)
            c.free(__res)
            __res = nil
        }
    }

    __free__ = use close
}

class Statement {
    __p: _

    init(p: _) {
        __p = p
    }

    kind -> Int {
        duckdb_prepared_statement_type(__p)
    }

    columns -> Array[String] {
        [
            c.str(duckdb_prepared_statement_column_name(__p, i))
            for i in 0..duckdb_prepared_statement_column_count(__p)
        ]
    }

    types -> Array[String] {
        [
            borrowing(duckdb_prepared_statement_column_logical_type(__p, i), decoder).name
            for i in 0..duckdb_prepared_statement_column_count(__p)
        ]
    }

    __bind(i: Int, x: _) {
        let v = value(x)
        try {
            check(
                duckdb_bind_value(__p, i, v),
                () -> text(duckdb_prepare_error(__p)) ?? "Binder Error: could not bind parameter {i}"
            )
        } finally {
            drop-value(v)
        }
    }

    __index(name: String) -> Int {
        let i = c.box-auto(c.u64)
        check(
            duckdb_bind_parameter_index(__p, i, name.cstr()),
            () -> "Binder Error: unknown parameter ${name}"
        )
        i[0]
    }

    bind(params: Array = [], named: Dict = %{}) -> Statement {
        duckdb_clear_bindings(__p)
        for x; i in params {
            __bind(i + 1, x)
        }
        for name, x in named {
            __bind(__index(name), x)
        }
        self
    }

    execute() -> Result {
        let res = c.new(duckdb_result)
        if duckdb_execute_prepared(__p, res) != DuckDBSuccess {
            let msg = text(duckdb_result_error(res)) ?? 'Invalid Error: query failed'
            duckdb_destroy_result(res)
            c.free(res)
            fail(msg)
        }
        Result(res)
    }

    close() {
        if __p != nil {
            duckdb_destroy_prepare(handle(__p))
            __p = nil
        }
    }

    __free__ = use close
}

class Database {
    __p:     _
    __users: Int

    init(path: String, config: Dict) {
        let cfg = c.box-auto(c.ptr)
        check(duckdb_create_config(cfg), () -> 'Internal Error: could not allocate a configuration')

        try {
            for k, v in config {
                check(
                    duckdb_set_config(cfg[0], "{k}".cstr(), "{v}".cstr()),
                    () -> "Invalid Input Error: bad configuration option {k} = {v}"
                )
            }

            let db  = c.box-auto(c.ptr)
            let err = c.box-auto(c.ptr)
            if duckdb_open_ext(path.cstr(), db, cfg[0], err) != DuckDBSuccess {
                fail(owned-str(err[0]) ?? "IO Error: could not open {path}")
            }
            __p     = db[0]
            __users = 0
        } finally {
            duckdb_destroy_config(cfg)
        }
    }

    connect() -> _ {
        let out = c.box-auto(c.ptr)
        check(duckdb_connect(__p, out), () -> 'Connection Error: could not connect')
        __users += 1
        out[0]
    }

    release() {
        if (__users -= 1) == 0 {
            close()
        }
    }

    close() {
        if __p != nil {
            duckdb_close(handle(__p))
            __p = nil
        }
    }

    __free__ = use close
}

pub class Connection {
    __db:     Database
    __con:    _
    __result: Result | nil
    __path:   String

    init(db: Database, path: String) {
        __db   = db
        __con  = db.connect()
        __path = path
    }

    __extracted(sql: String, f: _) -> _ {
        let ext = c.box-auto(c.ptr)
        let n = duckdb_extract_statements(__live(), sql.cstr(), ext)
        try {
            if n == 0 {
                fail(text(duckdb_extract_statements_error(ext[0])) ?? 'Parser Error: no statements')
            }
            f(ext[0], n)
        } finally {
            duckdb_destroy_extracted(ext)
        }
    }

    __prepared(ext: _, i: Int, f: _) -> _ {
        let out = c.box-auto(c.ptr)
        let state = duckdb_prepare_extracted_statement(__con, ext, i, out)
        let stmt = Statement(out[0])
        try {
            if state != DuckDBSuccess {
                fail(text(duckdb_prepare_error(out[0])) ?? 'Parser Error: cannot prepare')
            }
            f(stmt)
        } finally {
            stmt.close()
        }
    }

    __live() -> _ {
        __con ?? throw ConnectionException('Connection Error: Connection already closed!')
    }

    result(sql: String, params: Array = [], named: Dict = %{}) -> Result {
        __extracted(sql, fn (ext, n) {
            for i in 0..n - 1 {
                __prepared(ext, i, &execute).close()
            }
            __prepared(ext, n - 1, \_.bind(params, named).execute())
        })
    }

    prepare(sql: String) -> Statement {
        let out = c.box-auto(c.ptr)
        let state = duckdb_prepare(__live(), sql.cstr(), out)
        let stmt = Statement(out[0])
        if state != DuckDBSuccess {
            let msg = text(duckdb_prepare_error(out[0])) ?? 'Parser Error: cannot prepare'
            stmt.close()
            fail(msg)
        }
        stmt
    }

    execute(sql: String, *params, %named) -> Connection {
        __result.?close()
        __result = result(sql, params, named)
        self
    }

    executemany(sql: String, rows: Iterable) -> Connection {
        __result.?close()
        let stmt = prepare(sql)
        try {
            for row in rows {
                stmt.bind(*bindings(row)).execute().close()
            }
        } finally {
            stmt.close()
        }
        __result = nil
        self
    }

    __current() -> Result {
        __result ?? throw InvalidInputException('Invalid Input Error: No open result set')
    }

    fetchone() -> _ { __current().fetchone() }
    fetchmany(n: Int = 1) -> Array { __current().fetchmany(n) }
    fetchall() -> Array { __current().fetchall() }

    description -> Array | nil { __result.?description }
    rowcount -> Int { __result.?rows-changed ?? -1 }

    sql(sql: String, *params, %named) -> Relation {
        let select? = (ext, n) -> n == 1 && __prepared(ext, 0, &.kind) == DUCKDB_STATEMENT_TYPE_SELECT
        __extracted(sql, select?)
            ? Relation(self, sql.comb(/[\s;]+$/), params, named)
            : __materialize(result(sql, params, named))
    }

    __materialize(res: Result) -> Relation {
        let rows = res.fetchall()
        res.close()
        values(*rows, columns: res.columns, types: res.types)
    }

    query = use sql

    from-query = use sql

    table(name: String) -> Relation {
        Relation.over(self, name.split('.').map(quote).join('.'))
    }

    view = use table

    values(*rows, columns: Array[String] | nil = nil, types: Array[String] | nil = nil) -> Relation {
        let width = (columns == nil) ? #[*rows[0]] : #columns
        let names = (columns == nil) ? '' : "({columns.map(quote).join(', ')})"
        let nulls = (types ?? ['INTEGER'] * width).map(t -> "CAST(NULL AS {t})").join(', ')
        let (body, tail) = (#rows == 0)
                         ? ("({nulls})", ' LIMIT 0')
                         : ((["({(['?'] * width).join(', ')})"] * #rows).join(', '), '')
        Relation(self, "SELECT * FROM (VALUES {body}) AS v{names}{tail}", rows.map(\[*_]).flat(1))
    }

    __reader(fun: String, path: String | Array, opts: Dict) -> Relation {
        let named = [", {k} := ?" for k in opts.keys()].join('')
        Relation.over(self, "{fun}(?{named})", [path, *opts.values()])
    }

    read-csv(path: String | Array, %opts) -> Relation { __reader('read_csv', path, opts) }
    read-json(path: String | Array, %opts) -> Relation { __reader('read_json', path, opts) }
    read-parquet(path: String | Array, %opts) -> Relation { __reader('read_parquet', path, opts) }

    from-csv-auto = use read-csv
    from-parquet = use read-parquet

    append(table: String, rows: Iterable, schema: String | nil = nil) -> Connection {
        let out = c.box-auto(c.ptr)
        let schema = (schema == nil) ? nil : schema.cstr()
        let state = duckdb_appender_create(__live(), schema, table.cstr(), out)
        let app = out[0]

        let ok = fn (state) {
            check(state, () -> text(duckdb_appender_error(app)) ?? "Invalid Input Error: cannot append to {table}")
        }

        try {
            ok(state)
            for row in rows {
                for x in [*row] {
                    let v = value(x)
                    try {
                        ok(duckdb_append_value(app, v))
                    } finally {
                        drop-value(v)
                    }
                }
                ok(duckdb_appender_end_row(app))
            }
            ok(duckdb_appender_close(app))
        } finally {
            duckdb_appender_destroy(out)
        }

        self
    }

    begin() -> Connection { execute('BEGIN TRANSACTION') }
    commit() -> Connection { execute('COMMIT') }
    rollback() -> Connection { execute('ROLLBACK') }
    checkpoint() -> Connection { execute('CHECKPOINT') }

    transaction(f: () -> _) -> _ {
        begin()
        try {
            let result = f()
            commit()
            result
        } catch e {
            rollback()
            throw e
        }
    }

    install-extension(name: String) -> Connection { execute("INSTALL {quote(name)}") }
    load-extension(name: String) -> Connection { execute("LOAD {quote(name)}") }

    tables() -> Array[String] {
        self.sql('SHOW TABLES').fetchall().map(&0)
    }

    table?(name: String) -> Bool {
        name in tables()
    }

    cursor() -> Connection {
        Connection(__db, __path)
    }

    duplicate = use cursor

    interrupt() {
        duckdb_interrupt(__live())
    }

    close() {
        __result.?close()
        __result = nil
        if __con != nil {
            duckdb_disconnect(handle(__con))
            __con = nil
            __db.release()
        }
    }

    closed? -> Bool { __con == nil }

    __drop__ = use close
    __free__ = use close

    __str__() -> String {
        "<duckdb.Connection {__path}>"
    }
}

let __alias-counter = 0

fn fresh-alias() -> String {
    "unnamed_relation_{__alias-counter += 1}"
}

pub class Relation {
    __con:    Connection
    __sql:    String
    __params: Array
    __named:  Dict
    __alias:  String
    __source: String | nil

    init(
        con: Connection,
        sql: String | nil,
        params: Array = [],
        named: Dict = %{},
        alias: String | nil = nil,
        source: String | nil = nil
    ) {
        __con    = con
        __sql    = sql ?? "SELECT * FROM {source}"
        __params = params
        __named  = named
        __alias  = alias ?? fresh-alias()
        __source = source
    }

    static over(con: Connection, source: String, params: Array = []) -> Relation {
        Relation(con, nil, params, source: source)
    }

    alias -> String { __alias }

    sql-query() -> String { __sql }

    params -> Array { __params }

    named -> Dict { __named }

    subquery() -> String {
        "({__sql}) AS {quote(__alias)}"
    }

    from-clause() -> String {
        __source ?? subquery()
    }

    __derive(sql: String, after: Array = []) -> Relation {
        Relation(__con, sql, __params + after, __named)
    }

    __combine(other: Relation, sql: String | nil, source: String | nil = nil) -> Relation {
        Relation(__con, sql, __params + other.params, __named + other.named, source: source)
    }

    set-alias(name: String) -> Relation {
        Relation(__con, __sql, __params, __named, name)
    }

    filter(cond: String, *ps) -> Relation {
        __derive("SELECT * FROM {from-clause()} WHERE {cond}", after: ps)
    }

    project(*exprs, groups: String | nil = nil) -> Relation {
        let group = (groups == nil) ? '' : " GROUP BY {groups}"
        __derive("SELECT {exprs.join(', ')} FROM {from-clause()}{group}")
    }

    select = use project

    aggregate(exprs: String | Array, groups: String | nil = nil) -> Relation {
        let exprs = (exprs :: String) ? exprs : exprs.join(', ')
        __derive("SELECT {exprs} FROM {from-clause()} GROUP BY {groups ?? 'ALL'}")
    }

    order(spec: String) -> Relation {
        __derive("SELECT * FROM {from-clause()} ORDER BY {spec}")
    }

    sort(*cols) -> Relation { order(cols.join(', ')) }

    limit(n: Int, offset: Int = 0) -> Relation {
        __derive("SELECT * FROM {subquery()} LIMIT {n} OFFSET {offset}")
    }

    distinct() -> Relation {
        __derive("SELECT DISTINCT * FROM {subquery()}")
    }

    unique(cols: String) -> Relation {
        __derive("SELECT DISTINCT {cols} FROM {from-clause()}")
    }

    join(other: Relation, cond: String, how: String = 'inner') -> Relation {
        let on = (/^\s*\w+(\s*,\s*\w+)*\s*$/)(cond) ? "USING ({cond})" : "ON {cond}"
        __combine(other, nil, source: "{subquery()} {how.upper()} JOIN {other.subquery()} {on}")
    }

    cross(other: Relation) -> Relation {
        __combine(other, nil, source: "{subquery()} CROSS JOIN {other.subquery()}")
    }

    __setop(other: Relation, op: String) -> Relation {
        __combine(other, "SELECT * FROM {subquery()} {op} SELECT * FROM {other.subquery()}")
    }

    union(other: Relation) -> Relation { __setop(other, 'UNION ALL') }
    except(other: Relation) -> Relation { __setop(other, 'EXCEPT') }
    intersect(other: Relation) -> Relation { __setop(other, 'INTERSECT') }

    __agg(fun: String, col: String, groups: String | nil) -> Relation {
        let by = (groups == nil) ? '' : "{groups}, "
        aggregate("{by}{fun}({col})", groups ?? '()')
    }

    count(col: String = '*', groups: String | nil = nil) -> Relation { __agg('count', col, groups) }
    sum(col: String, groups: String | nil = nil) -> Relation { __agg('sum', col, groups) }
    min(col: String, groups: String | nil = nil) -> Relation { __agg('min', col, groups) }
    max(col: String, groups: String | nil = nil) -> Relation { __agg('max', col, groups) }
    avg(col: String, groups: String | nil = nil) -> Relation { __agg('avg', col, groups) }
    median(col: String, groups: String | nil = nil) -> Relation { __agg('median', col, groups) }

    mean = use avg

    query(name: String, sql: String) -> Relation {
        __derive("WITH {quote(name)} AS ({__sql}) {sql}")
    }

    __described(f: _) -> _ {
        let stmt = __con.prepare(__sql)
        try {
            f(stmt)
        } finally {
            stmt.close()
        }
    }

    __fetched(f: _) -> _ {
        let res = execute()
        try {
            f(res)
        } finally {
            res.close()
        }
    }

    columns -> Array[String] { __described(&.columns) }
    types -> Array[String] { __described(&.types) }

    dtypes -> Array[String] { types }

    description -> Array {
        [{name: n, type: t} for (n, t) in columns.zip(types)]
    }

    execute() -> Result {
        __con.result(__sql, __params, __named)
    }

    fetchone() -> _ { __fetched(&fetchone) }
    fetchmany(n: Int = 1) -> Array { __fetched(\_.fetchmany(n)) }
    fetchall() -> Array { __fetched(&fetchall) }

    __iter__() -> Generator[_] { execute().rows() }

    #() -> Int {
        __derive("SELECT count(*) FROM {subquery()}").fetchone().0
    }

    shape -> (Int, Int) { (#self, #columns) }

    __into(sql: String) -> Connection {
        __con.execute(sql, *__params, **__named)
    }

    create(table: String) -> Connection {
        __into("CREATE TABLE {quote(table)} AS {__sql}")
    }

    to-table = use create

    create-view(name: String, replace: Bool = true) -> Relation {
        let verb = replace ? 'CREATE OR REPLACE VIEW' : 'CREATE VIEW'
        __into("{verb} {quote(name)} AS {__sql}")
        __con.table(name)
    }

    to-view = use create-view

    insert-into(table: String) -> Connection {
        __into("INSERT INTO {quote(table)} {__sql}")
    }

    __copy(path: String, format: String, opts: Dict) -> Connection {
        let rest = ["{k} {sql-literal(v)}" for k, v in opts]
        let options = ["FORMAT {format}", *rest].join(', ')
        __into("COPY ({__sql}) TO {sql-literal(path)} ({options})")
    }

    write-csv(path: String, %opts) -> Connection { __copy(path, 'csv', opts) }
    write-parquet(path: String, %opts) -> Connection { __copy(path, 'parquet', opts) }

    to-csv = use write-csv
    to-parquet = use write-parquet

    explain() -> String {
        __con.sql("EXPLAIN {__sql}", *__params, **__named).fetchall().map(&1).join("\n")
    }

    show(max-rows: Int = 20) {
        print(render(max-rows))
    }

    render(max-rows: Int = 20) -> String {
        let (names, kinds) = (columns, types)
        let total = #self
        let half = max-rows / 2
        let rows = (total <= max-rows)
                 ? [fetchall()]
                 : [limit(half).fetchall(), limit(half, offset: total - half).fetchall()]
        table-box(names, kinds, rows, total)
    }

    __str__() -> String { render() }

    __repr__() -> String { "<duckdb.Relation {__alias}: {__sql}>" }
}

fn quote-string(s: String) -> String {
    let escaped = s.replace("'", "''")
    "'{escaped}'"
}

fn struct-literal(fields: Dict) -> String {
    let entries = ["{quote(k)} := {sql-literal(v)}" for k, v in fields]
    "struct_pack({entries.join(', ')})"
}

pub fn sql-literal(x: _) -> String {
    match x {
        nil       => 'NULL',
        b: Bool   => b ? 'true' : 'false',
        n: Int    => "{n}",
        f: Float  => "{f}",
        s: String => quote-string(s),
        xs: Array => "[{xs.map(sql-literal).join(', ')}]",
        d: Dict   => "MAP({sql-literal(d.keys())}, {sql-literal(d.values())})",
        t: Tuple  => Tuple.named?(t) ? struct-literal(members(t)) : sql-literal([*t]),
        _         => quote-string("{x}")
    }
}

const NUMERIC = /^(?:U?(?:TINY|SMALL|BIG|HUGE)?INT(?:EGER)?|FLOAT|DOUBLE|DECIMAL.*)$/

fn cell(x: _) -> String {
    match x {
        nil       => 'NULL',
        s: String => s,
        _         => "{x}"
    }
}

fn pad(s: String, w: Int, align: String) -> String {
    let gap = w - s.width()
    match align {
        'right'  => "{' ' * gap}{s}",
        'center' => "{' ' * (gap / 2)}{s}{' ' * (gap - gap / 2)}",
        _        => "{s}{' ' * gap}"
    }
}

fn table-box(names: Array, types: Array, chunks: Array, total: Int) -> String {
    let lower = types.map(&lower)
    let body = chunks.map(rows -> rows.map(row -> [*row].map(cell)))
    let all-rows = [names, lower, *body.flat(1)]
    let widths = [all-rows.map(row -> row[j].width()).max() for j in 0..#names]
    let aligns = types.map(t -> NUMERIC(t) ? 'right' : 'left')
    let middle = ['center'] * #names

    let rule = (l, m, r) -> "{l}{widths.map(w -> '─' * (w + 2)).join(m)}{r}"
    let line = (cells, how) -> "│ {[pad(s, widths[j], how[j]) for s; j in cells].join(' │ ')} │"
    let dots = line(['·'] * #names, aligns)

    let lines = [
        rule('┌', '┬', '┐'),
        line(names, middle),
        line(lower, middle),
        rule('├', '┼', '┤')
    ]

    for rows; k in body {
        if k > 0 {
            lines += [dots] * 3
        }
        lines += rows.map(line@(_, aligns))
    }

    lines.push(rule('└', '┴', '┘'))

    let shown = #body.flat(1)
    if shown < total {
        lines.push("  {total} rows ({shown} shown)  {#names} columns")
    }

    lines.join("\n")
}

pub fn connect(database: String = ':memory:', read-only: Bool = false, config: Dict = %{}) -> Connection {
    let config = read-only ? (config + %{'access_mode': 'READ_ONLY'}) : config
    Connection(Database(database, config), database)
}

let __default = nil

pub fn default-connection() -> Connection {
    __default = __default ?? connect()
}

pub fn set-default-connection(con: Connection) {
    __default = con
}

pub fn version() -> String {
    c.str(duckdb_library_version())
}

pub fn sql(*args, %kwargs) -> Relation { default-connection().sql(*args, **kwargs) }
pub fn query(*args, %kwargs) -> Relation { default-connection().sql(*args, **kwargs) }
pub fn execute(*args, %kwargs) -> Connection { default-connection().execute(*args, **kwargs) }
pub fn table(name: String) -> Relation { default-connection().table(name) }
pub fn values(*rows) -> Relation { default-connection().values(*rows) }
pub fn read-csv(path, %opts) -> Relation { default-connection().read-csv(path, **opts) }
pub fn read-json(path, %opts) -> Relation { default-connection().read-json(path, **opts) }
pub fn read-parquet(path, %opts) -> Relation { default-connection().read-parquet(path, **opts) }
