pub class GitError < RuntimeError {
    code:      Int
    category:  Int
    operation: String

    init(message: String, code: Int = -1, category: Int = 0, operation: String = '') {
        self.code      = code
        self.category  = category
        self.operation = operation
        super(operation ? "{operation}: {message}" : message)
    }
}

pub class NotFoundError < GitError {}
pub class ExistsError < GitError {}
pub class AmbiguousError < GitError {}
pub class ConflictError < GitError {}
pub class AuthenticationError < GitError {}
pub class PushRejectedError < GitError {}
pub class ClosedError < GitError {}

pub class ObjectTypeError < GitError {
    actual:   ObjectKind
    expected: [ObjectKind]

    init(operation: String, actual: ObjectKind, expected: [ObjectKind]) {
        self.actual   = actual
        self.expected = expected
        let kinds = expected.map(kind-name).join(' or ')
        super("requires {kinds}, got {kind-name(actual)}", operation: operation)
    }
}

