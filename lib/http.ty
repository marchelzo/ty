import ty.mod
import http.deflate as deflate
import time

const NO_PARAMS: Dict[String, String] = %{}

const OVERLOADED = 'HTTP/1.1 503 Service Unavailable\r\nContent-Type: text/plain\r\nContent-Length: 19\r\nConnection: close\r\nRetry-After: 1\r\n\r\nService Unavailable'

const REQUEST_ID = /^[A-Za-z0-9._:\-]{1,128}$/

let ACCESS = log.Logger('http.access')

fn compressible-type?(ctype: String) -> Bool {
    let t = ctype.split(';')[0].strip().lower()
    t.starts?('text/')
 || t.ends?('+json')
 || t.ends?('+xml')
 || t == 'application/json'
 || t == 'application/javascript'
 || t == 'application/xml'
 || t == 'application/wasm'
 || t == 'application/x-ndjson'
 || t == 'image/svg+xml'
}

let probe-lock = Mutex()
let uring-probe: Ok[nil] | Err[String] | nil = nil

fn probe-uring() -> Ok[nil] | Err[String] {
    let ^_ = probe-lock.lock()
    uring-probe ?? (uring-probe = try {
        let b = make-backend('io_uring', 8, nil)
        b.close()
        Ok(nil)
    } catch e {
        Err(str(e))
    })
}

fn make-pattern(route: String) -> (Array[String], RegexV) {
    let route   = route.sub(/<(\w+)>/, [_, name] -> "<{name}:[^/]+>")
    let params  = route.scan(/<(\w+):/).map(&1)
    let pattern = route.sub(/<\w+:(.*?)>/, [_, pattern] -> "({pattern})")
    (params, regex("^{pattern}/?$", 'v'))
}

use RequestHandler = {req: Request, rsp: Response, params: *_, kwargs: **_} -> _;
use SocketHandler  = {ws: WebSocket, req: Request, params: *_, kwargs: **_} -> _;

use Route = {
    route:   String,
    params:  Array[String],
    pattern: RegexV,
    fun:     _
};

class Routes {
    exact:      Dict[String, Dict[String, _]]
    dynamic:    Dict[String, Array[Route]]
    middleware: Array[_]

    init() {
        exact      = %{}
        dynamic    = %{}
        middleware = []
    }

    copy() -> Routes {
        let r = Routes()
        r.exact      = %{m: %{k: v for k, v in t} for m, t in exact}
        r.dynamic    = %{m: [*rs] for m, rs in dynamic}
        r.middleware = [*middleware]
        r
    }

    add(method: String, route: String, fun: _) {
        if '<' not in route {
            let t = exact[method] ?? (exact[method] = %{})
            t[route] = fun
            t[(route.size() > 1 && route.ends?('/')) ? route[;-1] : "{route}/"] = fun
            return
        }

        let (params, pattern) = make-pattern(route)
        let rs = dynamic[method] ?? (dynamic[method] = [])
        rs.push({route, params, pattern, fun})
        rs.sort!(by: \-(_.route.search('<') ?? 99999))
    }

    find(method: String, url: String) -> (_, Dict[String, String], String) | nil {
        if let $t = exact[method] {
            if let $f = t[url] {
                return (f, NO_PARAMS, url)
            }
        }

        let $rs = dynamic[method] or return nil

        for r in rs {
            if let $m = url.match(r.pattern) {
                return (r.fun, %{r.params[i]: percent-decode(m[i + 1]!) for i in ..#r.params}, r.route)
            }
        }

        nil
    }

    methods-for(url: String) -> Array[String] {
        let ms = []
        for m, t in exact {
            if t[url] != nil {
                ms.push(m)
            }
        }
        for m, rs in dynamic {
            if !ms.contains?(m) && rs.any?(r -> url.match?(r.pattern)) {
                ms.push(m)
            }
        }
        ms
    }
}

class Streamed {
    f: _

    init(f: _) {
        self.f = f
    }
}

fn route-args(a: _, b: _) -> (String, _) {
    match (a, b) {
        (route: String, f) => (route, f),
        (f, route: String) => (route, f),
        _                  => throw ValueError('http: expected a route string and a handler')
    }
}

/// An HTTP server. Positional arguments are `(host, port)`, `(port)`, or an
/// already-bound listening socket (also `sock: fd`, e.g. a Unix socket);
/// keywords are `Config` options plus `tls`, which takes an `ssl.Context`
/// or `{cert, key}` (PEM text or paths).
pub class Server {
    config: Config
    tls:    ssl.Context | nil

    __sock:       Int
    __owns-sock:  Bool
    __routes:     Routes
    __sockets:    Routes
    __version:    Atomic
    __lock:       Mutex
    __loops:      Array[Loop]
    __active:     Atomic
    __served:     Atomic
    __running:    Atomic
    __stopping:   Atomic
    __streams:    Atomic
    __h2:         _
    __backend:    _
    __not-found:  _
    __on-error:   _
    __metrics:    Metrics
    __rid:        String
    __log-mtx:    Mutex

    init(
        *args,
        tls: ssl.Context | {cert: String | Blob, key: String | Blob} | nil = nil,
        config: Config | nil = nil,
        sock: Int | nil = nil,
        %kwargs: Any
    ) {
        self.config  = config ?? Config(**kwargs)
        __routes     = Routes()
        __sockets    = Routes()
        __version    = Atomic(0)
        __lock       = Mutex()
        __loops      = []
        __active     = Atomic(0)
        __served     = Atomic(0)
        __running    = Atomic(0)
        __stopping   = Atomic(0)
        __streams    = Atomic(0)
        __not-found  = nil
        __on-error   = nil
        __h2         = nil
        __backend    = nil
        __metrics    = Metrics()
        __rid        = ssl.random-bytes(4).hex()
        __log-mtx    = Mutex()

        if self.config.access-log == 'log' {
            log.default-level('http.access', log.INFO)
        }

        if self.config.h2 {
            match core.optional-module('http/h2', 'session') {
                Ok(f)  => __h2 = f,
                Err(e) => log::warn!("HTTP/2 disabled", reason: e)
            }
        }

        if self.config.backend == 'auto' && default-backend() == 'io_uring' {
            if let Err(why) = probe-uring() {
                match core.optional-module('http/kqueue', 'Backend') {
                    Ok(f) => {
                        log::warn!("io_uring unavailable; using kqueue via libkqueue", reason: why)
                        self.config.backend = 'kqueue'
                    },
                    Err(_) => throw RuntimeError("http: io_uring is unavailable ({why}) and libkqueue is not installed")
                }
            }
        }

        if backend == 'kqueue' {
            match core.optional-module('http/kqueue', 'Backend') {
                Ok(f)  => __backend = f,
                Err(e) => throw RuntimeError("http: kqueue backend unavailable: {e}")
            }
        }

        self.tls = match tls {
            nil              => nil,
            ctx: ssl.Context => ctx,
            {cert, key}      => ssl.Context.server(cert, key, alpn: (__h2 != nil) ? ['h2', 'http/1.1'] : ['http/1.1'])
        }

        if sock != nil {
            args = [sock, nil]
        }

        match args {
            [] => {
                __sock = __listen('0.0.0.0', 8080)
                __owns-sock = true
            },

            [port: Int] => {
                __sock = __listen('0.0.0.0', port)
                __owns-sock = true
            },

            [addr: String, port: Int] => {
                __sock = __listen(addr, port)
                __owns-sock = true
            },

            [sock: Int, *] => {
                __sock = sock
                __owns-sock = false
                os.listen(__sock, self.config.backlog)
            }
        }
    }

    __listen(addr: String, port: Int) -> Int {
        let v6? = addr.contains?(':')
        let host = (v6? && addr.starts?('[')) ? addr[1;-1] : addr

        let $info = match getaddrinfo(host, str(port), v6? ? AF_INET6 : AF_INET, SOCK_STREAM, 0) {
            Ok([info, *]) => info,
            _             => nil
        } or throw OSError("http: cannot resolve listen address {addr}")

        let fd = socket(v6? ? AF_INET6 : AF_INET, SOCK_STREAM, 0)
        if fd < 0 {
            throw OSError('socket')
        }

        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, 1)

        if config.reuse-port {
#|if __linux__
            setsockopt(fd, SOL_SOCKET, 15, 1)
#|else
            setsockopt(fd, SOL_SOCKET, 0x200, 1)
#|]
        }

        if bind(fd, info) != 0 {
            let e = OSError("http: bind({addr}:{port})")
            os.close(fd)
            throw e
        }

        if os.listen(fd, config.backlog) != 0 {
            let e = OSError('http: listen()')
            os.close(fd)
            throw e
        }

        fd
    }

    fileno -> Int {
        __sock
    }

    address -> (String, String) {
        getnameinfo(getsockname(__sock), NI_NUMERICHOST | NI_NUMERICSERV)
    }

    port -> Int {
        int(address.1)
    }

    url -> String {
        let (host, port) = address
        let h = (host == '0.0.0.0' || host == '::') ? '127.0.0.1' : host
        "{(tls != nil) ? 'https' : 'http'}://{h.contains?(':') ? "[{h}]" : h}:{port}"
    }

    backend-factory -> _ {
        __backend
    }

    h2? -> Bool {
        __h2 != nil
    }

    backend -> String {
        (config.backend == 'auto') ? default-backend() : config.backend
    }

    active-connections -> Int {
        __active.load()
    }

    requests-served -> Int {
        __served.load()
    }

    running? -> Bool {
        __running.load() != 0
    }

    connection-opened(loop: Loop) -> Bool {
        if __active.fetch-add(1) >= config.max-connections {
            __active.fetch-sub(1)
            loop.metrics.rejected.fetch-add(1)
            return false
        }
        loop.metrics.connections-total.fetch-add(1)
        true
    }

    overload-response -> String | nil {
        (tls == nil) ? OVERLOADED : nil
    }

    metrics -> Metrics {
        let ^_ = __lock.lock()
        metrics-mod.combine([__metrics, *__loops.map(&.metrics)])
    }

    /// Point-in-time counters (requests, responses by class, latency, bytes,
    /// connections, websockets). Safe to call from any thread.
    stats() -> Dict[String, _] {
        metrics.snapshot(__active.load())
    }

    /// Adds middleware `f(req, rsp, next)`; call `next()` to continue to the
    /// next middleware and finally the route. Runs in registration order.
    use(f: (Request, Response, () -> _) -> _) -> _ {
        __mutate((rs, _) -> rs.middleware.push(f))
        f
    }

    /// Enables sessions (see `Sessions`); returns the Sessions object.
    sessions(secret: String | Array[String], %kwargs) -> Sessions {
        let s = Sessions(secret, **kwargs)
        self.use(s.middleware)
        s
    }

    /// Serves files from `dir` under `prefix` (see `StaticFiles` and
    /// `send-file` for options such as `max-age`, `precompressed`, `index`,
    /// `fallback`, `dotfiles`).
    static-files(prefix: String, dir: String, %kwargs) -> StaticFiles {
        let sf = StaticFiles(dir, **kwargs)
        let p = prefix.sub(/\/+$/, '')
        route('GET', (p == '') ? '/' : p, (req, rsp) -> sf.serve(req, rsp, ''))
        route('GET', "{p}/<path:.*>", (req, rsp, path) -> sf.serve(req, rsp, path))
        sf
    }

    /// Compresses responses with the best coding the client accepts
    /// (`Accept-Encoding`) out of `codings`, when the Content-Type is textual
    /// (or matches `types`): buffered bodies of at least `min-size` bytes,
    /// and streamed bodies without a declared length (each write is flushed,
    /// so streaming stays incremental). Event streams, ranges, and bodies
    /// that already carry a Content-Encoding are sent as they are.
    compression(
        codings: Array[String] = ['zstd', 'br', 'gzip'],
        min-size: Int = 1024,
        level: Int | nil = nil,
        types: (String) -> Bool | nil = nil
    ) -> _ {
        let usable = codings.filter(codec.encodable?)
        let compressible? = types ?? compressible-type?
        self.use(fn (req, rsp, next) {
            let accept = req.header('accept-encoding')
            if accept != nil && req.method != 'HEAD' {
                rsp.on-headers(fn (r) {
                    if r.header('content-encoding') != nil {
                        return
                    }
                    if r.streaming? {
                        let ctype = r.content-type ?? ''
                        if r.stream-length != nil || ctype.starts?('text/event-stream') || !compressible?(ctype) {
                            return
                        }
                        r.add-header('Vary', 'Accept-Encoding')
                        let $coding = codec.negotiate(accept, usable) or return
                        r.header('Content-Encoding', coding)
                        r.compress-with(codec.encoder(coding, level))
                        return
                    }
                    let code = r.status-code
                    if code < 200 || code == 204 || code == 304 || code == 206 || #r.body < min-size {
                        return
                    }
                    if !compressible?(r.content-type ?? '') {
                        return
                    }
                    r.add-header('Vary', 'Accept-Encoding')
                    let $coding = codec.negotiate(accept, usable) or return
                    r.body = codec.encode(coding, r.body, level)
                    r.header('Content-Encoding', coding)
                    if let $etag = r.header('etag') {
                        r.header('ETag', etag.sub(/"$/, "-{coding}\""))
                    }
                })
            }
            next()
        })
    }

    /// Adds a health endpoint: 200 "ok", or 503 while draining or when
    /// `check()` returns false.
    health(path: String = '/healthz', check: (() -> Bool) | nil = nil) {
        route('GET', path, fn (req, rsp) {
            rsp.header('Cache-Control', 'no-store')
            if stopping? || (check != nil && !check()) {
                rsp.error(503, 'unavailable')
            } else {
                rsp.plain('ok')
            }
        })
    }

    /// Adds a Prometheus text-format endpoint for `metrics`.
    metrics-endpoint(path: String = '/metrics') {
        route('GET', path, fn (req, rsp) {
            rsp.header('Cache-Control', 'no-store')
            rsp.content-type = 'text/plain; version=0.0.4; charset=utf-8'
            rsp.write(metrics.prometheus(__active.load()))
        })
    }

    __request-id(req: Request, loop: Loop) -> String {
        if config.trust-request-id {
            if let $given = req.header('x-request-id') {
                if given.match?(REQUEST_ID) {
                    return given
                }
            }
        }
        loop.request-seq += 1
        "{__rid}-{loop.index}-{loop.request-seq}"
    }

    __access(req: Request, rsp: Response, status: Int, seconds: Float, bytes: Int) {
        let entry = {
            id:       req.id,
            time:     time.utc(),
            remote:   req.remote,
            method:   req.method,
            target:   req.target,
            route:    req.route,
            protocol: (req.version.major == 2) ? 'HTTP/2' : "HTTP/1.{req.version.minor}",
            status:   status,
            bytes:    bytes,
            seconds:  seconds,
            referer:  req.header('referer'),
            agent:    req.header('user-agent')
        }

        let line = match config.access-log {
            nil, false => return,
            'log' => do {
                ACCESS.info(
                    "{entry.method} {entry.target} {status}",
                    method:   entry.method,
                    target:   entry.target,
                    route:    entry.route,
                    status:   status,
                    bytes:    bytes,
                    ms:       seconds * 1000.0,
                    remote:   entry.remote,
                    protocol: entry.protocol,
                    referer:  entry.referer,
                    agent:    entry.agent,
                    req:      entry.id
                )
                return
            },
            'json'     => json.encode(entry),
            true, 'combined' => do {
                let when = time.strftime('%d/%b/%Y:%H:%M:%S +0000', time.gmtime(int(entry.time)))
                let clean = (s: String | nil) -> (s ?? '-').sub(/["\\\x00-\x1F]/, '?')
                "{entry.remote ?? '-'} - - [{when}] \"{clean(entry.method)} {clean(entry.target)} {entry.protocol}\" {status} {bytes} \"{clean(entry.referer)}\" \"{clean(entry.agent)}\" {int(seconds * 1000000.0)}us {entry.id}"
            },
            f => do {
                try {
                    f(entry)
                } catch e {
                    log::error!("access-log callback failed", err: e)
                }
                return
            }
        }

        let ^_ = __log-mtx.lock()
        os.write(config.access-log-fd, line + '\n')
    }

    connection-closed() {
        __active.fetch-sub(1)
    }

    __mutate(f: (Routes, Routes) -> _) {
        let ^_ = __lock.lock()
        let routes  = __routes.copy()
        let sockets = __sockets.copy()
        f(routes, sockets)
        __routes  = routes
        __sockets = sockets
        __version.fetch-add(1)
    }

    __snapshot() -> (Routes, Routes) {
        let ^_ = __lock.lock()
        (__routes, __sockets)
    }

    /// Registers `f(req, rsp, **params)` for `method` and `route`.
    /// With `stream: true` the handler starts once the headers arrive and
    /// reads the body incrementally with `req.read(max)` / `req.read-all()`.
    /// `<name>` matches one path segment and `<name:regex>` a custom pattern;
    /// captures are URL-decoded and passed as keywords. A handler may return
    /// an Int status. Routes may be added while the server is running.
    route(method: String, a: _, b: _ = nil, stream: Bool = false) -> _ {
        let (route, f) = route-args(a, b)
        let m = method.upper()
        let h = stream ? Streamed(f) : f
        __mutate((rs, _) -> rs.add(m, route, h))
        if stream {
            __streams.store(1)
        }
        f
    }

    get(a: _, b: _ = nil, stream: Bool = false) -> _     { route('GET', a, b, stream) }
    post(a: _, b: _ = nil, stream: Bool = false) -> _    { route('POST', a, b, stream) }
    put(a: _, b: _ = nil, stream: Bool = false) -> _     { route('PUT', a, b, stream) }
    delete(a: _, b: _ = nil, stream: Bool = false) -> _  { route('DELETE', a, b, stream) }
    patch(a: _, b: _ = nil, stream: Bool = false) -> _   { route('PATCH', a, b, stream) }
    head(a: _, b: _ = nil) -> _                          { route('HEAD', a, b) }
    options(a: _, b: _ = nil) -> _                       { route('OPTIONS', a, b) }

    streams? -> Bool {
        __streams.load() != 0
    }

    streaming-route?(method: String, url: String, loop: Loop) -> Bool {
        let (routes, _) = __routes-for(loop)
        match routes.find(method, url) {
            (f: Streamed, *) => true,
            _                => false
        }
    }

    ws(a: _, b: _ = nil, protocols: Array[String] = []) -> _ {
        let (route, f) = route-args(a, b)
        __mutate(fn (_, ss) {
            ss.add('GET', route, (f, protocols))
        })
        f
    }

    not-found(f: RequestHandler) -> _ {
        __not-found = f
        f
    }

    on-error(f: (Request, Response, _) -> _) -> _ {
        __on-error = f
        f
    }

    __routes-for(loop: Loop) -> (Routes, Routes) {
        let v = __version.load()
        if loop.server-version != v {
            loop.server-version = v
            loop.server-routes = __snapshot()
        }
        loop.server-routes
    }

    __handle(req: Request, rsp: Response, loop: Loop) {
        let (routes, _) = __routes-for(loop)
        let chain = routes.middleware

        if !chain {
            return __route(routes, req, rsp)
        }

        __chain(chain, 0, routes, req, rsp)
    }

    __chain(chain: Array[_], i: Int, routes: Routes, req: Request, rsp: Response) {
        if i == #chain {
            return __route(routes, req, rsp)
        }
        let called = [false]
        chain[i](req, rsp, fn () {
            if !called[0] {
                called[0] = true
                __chain(chain, i + 1, routes, req, rsp)
            }
        })
    }

    __route(routes: Routes, req: Request, rsp: Response) {
        let method = req.method

        let found = routes.find(method, req.url)
                 ?? ((method == 'HEAD') ? routes.find('GET', req.url) : nil)

        if let (h, params, route) = found {
            req.route = route
            let f = match h {
                s: Streamed => s.f,
                f           => f
            }
            let status = f(req, rsp, **params)
            if status :: Int {
                rsp.status(status)
            }
            return
        }

        if let $nf = __not-found {
            rsp.status(404)
            let status = nf(req, rsp)
            if status :: Int {
                rsp.status(status)
            }
            return
        }

        let allowed = routes.methods-for(req.url)
        if allowed {
            rsp.header('Allow', allowed.join(', '))
            rsp.error(405)
        } else {
            rsp.error(404)
        }
    }

    serve(x: _, req: Request) {
        let loop = x.loop
        let rsp = Response(x)
        let status = 0

        req.start = time.now()
        req.id = __request-id(req, loop)

        match config.request-id-header {
            h: String => rsp.header(h, req.id),
            _         => {}
        }

        let m = loop.metrics
        m.in-flight.fetch-add(1)

        try {
            with log::span!("request", req: req.id) {
                status = __serve(x, req, rsp)
            }
        } finally {
            m.in-flight.fetch-sub(1)
            let dt = time.now() - req.start
            let sent = (status == 0) ? 0 : rsp.bytes
            if status == 0 {
                m.aborted.fetch-add(1)
            }
            m.observe((status == 0) ? 499 : status, dt, sent)
            if config.access-log != nil && config.access-log != false {
                __access(req, rsp, (status == 0) ? 499 : status, dt, sent)
            }
        }
    }

    __serve(x: _, req: Request, rsp: Response) -> Int {
        let loop = x.loop

        try {
            __handle(req, rsp, loop)
        } catch e: core.ConnectionClosed {
            x.abort()
            return 0
        } catch e: core.CanceledError {
            x.abort()
            return 0
        } catch e: HttpError {
            if rsp.started? {
                x.abort()
                return 0
            }
            rsp.reset()
            rsp.error(e.status, e.detail)
        } catch e {
            x.loop.metrics.errors.fetch-add(1)
            if rsp.started? {
                log::error!("exception while streaming response", method: req.method, url: req.url, err: e)
                x.abort()
                return 0
            }
            if let $handler = __on-error {
                rsp.reset()
                rsp.status(500)
                try {
                    handler(req, rsp, e)
                } catch e2 {
                    log::error!("error handler failed", err: e2)
                    rsp.error(500)
                }
            } else {
                log::error!("exception while handling request", method: req.method, url: req.url, err: e)
                rsp.reset()
                if config.debug {
                    rsp.error(500, "Exception: {e}\n\nBacktrace:\n{e.trace()}")
                } else {
                    rsp.error(500)
                }
            }
        }

        __served.fetch-add(1)

        if x.closed? {
            return 0
        }

        try {
            rsp.finish()
        } catch e {
            log::error!("failed to finish response", method: req.method, url: req.url, err: e)
            x.loop.metrics.errors.fetch-add(1)
            if rsp.started? || x.closed? {
                x.abort()
                return 0
            }
            rsp.reset()
            rsp.error(500)
            rsp.finish()
        }

        rsp.status-code
    }

    on-open(conn: Conn) -> _ {
        H1(conn, self)
    }

    on-tls(conn: Conn, alpn: String | nil) -> _ {
        if alpn == 'h2' && __h2 != nil {
            return (__h2)(conn, self)
        }
        H1(conn, self)
    }

    on-h2c(conn: Conn) -> _ {
        (__h2)(conn, self)
    }

    try-upgrade(conn: Conn, req: Request) -> Bool {
        if req.method != 'GET' || !req.upgrade? {
            return false
        }

        let $upgrade = req.header('upgrade') or return false
        if !upgrade.lower().contains?('websocket') {
            return false
        }

        let (_, sockets) = __routes-for(conn.loop)
        let found = sockets.find('GET', req.url)

        let reject = fn (status: Int, extra: String = '') {
            let body = status-name(status)
            conn.write("HTTP/1.1 {status} {body}\r\nContent-Type: text/plain\r\nContent-Length: {body.size()}\r\nConnection: close\r\n{extra}\r\n{body}")
            conn.close-after-flush()
            true
        }

        let (f, params, route) = found ?? return reject(404)

        let connection = (req.header('connection') ?? '').lower()
        let $key = req.header('sec-websocket-key') or return reject(400)

        if !connection.contains?('upgrade') || key.size() != 24 {
            return reject(400)
        }

        if req.header('sec-websocket-version') != '13' {
            return reject(426, 'Sec-WebSocket-Version: 13\r\n')
        }

        let (handler, protocols) = f
        let offered = (req.header('sec-websocket-protocol') ?? '').split(/\s*,\s*/).filter(\_.size() > 0)
        let protocol = protocols.find(\_ in offered)

        req.route = route

        let ext = config.ws-compression ? deflate.negotiate(req.header('sec-websocket-extensions')) : nil
        let extra = (ext == nil) ? %{} : %{'Sec-WebSocket-Extensions': ext}
        conn.write(wsock.handshake-response(key, protocol, extra))

        conn.untimeout(0)
        let proto = wsock.WSProto(conn, req, protocol, (ext == nil) ? nil : deflate.PerMessage())
        let wm = conn.loop.metrics
        wm.websockets.fetch-add(1)
        wm.websockets-total.fetch-add(1)
        proto.on-close-callback(-> wm.websockets.fetch-sub(1))
        conn.proto = proto

        conn.loop.spawn("WS {req.url}", __run-socket, proto, handler, req, params)

        if conn.available > 0 {
            proto.on-data()
        } else {
            conn.want-read()
        }

        true
    }

    __run-socket(proto: wsock.WSProto, handler: _, req: Request, params: Dict[String, String]) {
        let sock = proto.ws
        try {
            handler(sock, req, **params)
        } catch _: core.ConnectionClosed {
        } catch _: core.CanceledError {
        } catch e {
            log::error!("exception in websocket handler", url: req.url, err: e)
            proto.start-close(wsock.CLOSE_INTERNAL, '')
        } finally {
            if !proto.closed? {
                proto.start-close(wsock.CLOSE_NORMAL, '')
            }
        }
    }

    __run-loop(loop: Loop) {
        try {
            loop.run()
        } catch e {
            log::error!("event loop crashed", loop: loop.index, err: e)
            stop()
        }
    }

    stopping? -> Bool {
        __stopping.load() != 0
    }

    /// Serves until `stop()` is called (from any thread or handler), then
    /// drains in-flight requests for up to `shutdown-timeout` seconds.
    run() {
        if __running.swap(1) != 0 {
            throw RuntimeError('http: server is already running')
        }

        let threads = []

        try {
            let loops = [Loop(self, config, i, __sock) for i in ..config.threads]
            do {
                let ^_ = __lock.lock()
                __loops = loops
            }
            if stopping? {
                for l in loops {
                    l.stop()
                }
            }
            threads = [Thread(__run-loop, l) for l in loops.drop(1)]
            __run-loop(loops[0])
        } finally {
            stop()
            for t in threads {
                t.join()
            }
            do {
                let ^_ = __lock.lock()
                for l in __loops {
                    __metrics.add(l.metrics)
                }
                __loops = []
            }
            __stopping.store(0)
            __running.store(0)
        }
    }

    stop() {
        let loops = do {
            let ^_ = __lock.lock()
            __stopping.store(1)
            __loops
        }
        for l in loops {
            l.stop()
        }
    }

    close() {
        stop()
        if __owns-sock && __sock >= 0 {
            os.close(__sock)
            __sock = -1
        }
    }
}

core.set-file-sender(files.send-file)

pub HttpServer     = Server
pub HttpResponse   = Response
pub HttpRequest    = Request
pub HttpClient     = Client
pub ClientRequest  = client.Request
pub ClientResponse = client.Response

/// Suspends the current handler for `seconds` without blocking its loop.
pub fn sleep(seconds: Int | Float) {
    let $l = core.loop() or throw RuntimeError('http.sleep() must be called from a server task')
    l.sleep(seconds)
}

/// Runs `f(*args)` on a worker thread pool and suspends the current handler
/// until it returns; exceptions are rethrown in the handler.
pub fn blocking(f: _, *args: _) -> _ {
    let $l = core.loop() or throw RuntimeError('http.blocking() must be called from a server task')
    l.blocking(f, *args)
}

/// Starts `f(*args, **kwargs)` as a background task on the current loop.
pub fn spawn(f: _, *args: _, %kwargs: _) -> Task {
    let $l = core.loop() or throw RuntimeError('http.spawn() must be called on a server thread')
    l.spawn('task', f, *args, **kwargs)
}
