pub import http.client as client (
    Client,
    Client as HttpClient,
    Request as ClientRequest,
    Response as ClientResponse,
    WebSocket as ClientWebSocket,
    Timeout,
    Limits,
    Retry,
    BasicAuth,
    BearerAuth,
    DigestAuth,
    MockTransport,
    HttpStatusError,
    RequestError,
    TransportError,
    ConnectError,
    ReadTimeout,
    ConnectTimeout,
    get,
    head,
    options,
    post,
    put,
    patch,
    delete,
    stream,
    download,
    events,
