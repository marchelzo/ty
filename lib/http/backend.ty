pub trait Backend {
    name -> String;
    accept(fd: Int, user: Int);
    recv(fd: Int, p: Ptr, n: Int, user: Int);
    send(fd: Int, p: Ptr, n: Int, user: Int);
    read(fd: Int, p: Ptr, n: Int, offset: Int, user: Int);
    cancel(user: Int);
    arm-wake(user: Int);
    woke();
    wake();
    wait(timeout: Float | nil, f: (Int, Int, Int) -> _) -> Int;
    poll(f: (Int, Int, Int) -> _) -> Int;
    close();
}
