/**
 * HTTP client: HTTP/1.1 and HTTP/2 (ALPN, or prior knowledge over
 * cleartext), TLS, connection pooling, content decoding, cookies,
 * redirects, auth (basic, bearer, digest), retries, proxies (HTTP, CONNECT,
 * HTTPS, SOCKS5), streaming uploads and downloads, Server-Sent Events,
 * WebSockets, and pretty-printed output.
 *
 * ```
 * import http.client as client
 *
 * let r = client.get('https://httpbin.org/get', params: {q: 'ty'})
 * r.status-code              // 200
 * r.json()['args']           // %{'q': 'ty'}
 * r.show()
 *
 * let c = client.Client(base-url: 'https://api.example.com', headers: {authorization: 'Bearer ...'})
 * c.post('/items', json: {name: 'x'}).raise-for-status()
 *
 * with r = c.stream('GET', '/big.tar.zst') {
 *     for chunk in r.bytes() { ... }
 * }
 *
 * for ev in c.events('/feed') {
 *     print(ev.event, ev.json())
 * }
 *
 * with ws = c.websocket('wss://api.example.com/live') {
 *     ws.send('hello')
 *     print(ws.recv(timeout: 5))
 * }
 * ```
 *
 * A `Client` is safe to share between threads; HTTP/2 connections are
 * multiplexed across them by a native driver per connection. Sockets, TLS,
 * HTTP/1 framing, HTTP/2 and WebSocket frames are handled by the `_http`
 * core; called from an `http.Server` handler, every wait suspends only that
 * handler.
 */
import os
import errno
import time
import json
import ssl
import path (Path)
import base64 as b64
import _http as c
import http.loop as hl
import http.codec as codec
import http.display as display
import http.message (Headers, status-name)

pub import http.url (URL, InvalidURL)
pub import http.cookies (CookieJar, Cookie)
pub import http.form (FilePart, encode-multipart)

pub const VERSION    = '2.0'
pub const USER_AGENT = "ty-http/{VERSION}"

const WANT_READ  = -1
const WANT_WRITE = -2
const E_CLOSED   = -3
const E_TLS      = -4
const E_PROTO    = -5
const E_IO       = -6
const E_CERT     = -9

const W_HEAD   = 1
const W_BODY   = 2
const W_UPLOAD = 3

const SO_ERROR    = (__apple__ || __bsd__) ? 0x1007 : 4
const IPPROTO_TCP = 6
const TCP_NODELAY = 1
const CHUNK       = 256 * 1024
const UPLOAD_HIGH = 1024 * 1024

const IDEMPOTENT_METHODS = ['GET', 'HEAD', 'OPTIONS', 'PUT', 'DELETE', 'TRACE']
const IDEMPOTENT = %[*IDEMPOTENT_METHODS]
const REDIRECTS  = %[301, 302, 303, 307, 308]

/// Base class of every error raised while sending a request.
pub class RequestError < RuntimeError {
    request: Request | nil

    init(what: String, request: Request | nil = nil) {
        self.request = request
        super(what)
    }
}

/// The request could not be delivered or the response could not be read.
pub class TransportError < RequestError {}

pub class TimeoutError < TransportError {}
pub class ConnectTimeout < TimeoutError {}
pub class ReadTimeout < TimeoutError {}
pub class WriteTimeout < TimeoutError {}
pub class PoolTimeout < TimeoutError {}

pub class NetworkError < TransportError {}
pub class ConnectError < NetworkError {}
pub class ReadError < NetworkError {}
pub class WriteError < NetworkError {}

/// A reused connection that the server had already closed; the request
/// never reached it and is retried transparently.
pub class StaleConnection < ReadError {}

/// The peer violated HTTP (malformed response, reset stream, ...).
pub class ProtocolError < TransportError {}
pub class ProxyError < TransportError {}
pub class UnsupportedProtocol < TransportError {}

pub class TooManyRedirects < RequestError {}
pub class DecodingError < RequestError {}

/// Raised by `Response.raise-for-status()` for 4xx and 5xx responses.
pub class HttpStatusError < RequestError {
    response:    Response
    status-code: Int

    init(what: String, request: Request | nil, response: Response) {
        self.response    = response
        self.status-code = response.status-code
        super(what, request)
    }
}

/// The response body was already consumed by a streaming read.
pub class StreamConsumed < RuntimeError {
    init() {
        super('http: the response body was already read as a stream')
    }
}

pub use Seconds = Int | Float | Bool | nil

fn seconds(x: Seconds) -> Float | nil {
    match x {
        nil, false => nil,
        n: Int     => float(n),
        f: Float   => f,
        other      => throw ValueError("http: invalid timeout: {other}")
    }
}

fn deadline(t: Float | nil) -> Float | nil {
    (t == nil) ? nil : time.now() + t
}

fn left(d: Float | nil) -> Float | nil {
    (d == nil) ? nil : max(0.0, d - time.now())
}

/// Timeouts in seconds; `nil`/`false` disables one. `read` and `write`
/// bound each wait for the network, not the whole transfer; `pool` bounds
/// waiting for a free connection.
pub class Timeout {
    connect: Float | nil
    read:    Float | nil
    write:   Float | nil
    pool:    Float | nil

    init(
        all: Seconds = 5.0,
        connect: Seconds = nil,
        read: Seconds = nil,
        write: Seconds = nil,
        pool: Seconds = nil
    ) {
        let base = seconds(all)
        self.connect = (connect == nil) ? base : seconds(connect)
        self.read    = (read == nil) ? base : seconds(read)
        self.write   = (write == nil) ? base : seconds(write)
        self.pool    = (pool == nil) ? base : seconds(pool)
    }

    static of(x: _, fallback: Timeout | nil = nil) -> Timeout {
        match x {
            t: Timeout     => t,
            nil            => fallback ?? Timeout(),
            false          => Timeout(false),
            n: Int | Float => Timeout(n),
            r              => Timeout(
                r.?all ?? (fallback ?? Timeout()).read,
                connect: r.?connect,
                read: r.?read,
                write: r.?write,
                pool: r.?pool
            )
        }
    }

    __str__() -> String {
        "Timeout(connect: {connect}, read: {read}, write: {write}, pool: {pool})"
    }
}

/// Connection pool limits. `keepalive-expiry` closes idle connections after
/// that many seconds; `http2-connections` lets requests to one origin spread
/// over up to that many HTTP/2 connections (another is opened only while
/// every existing one is busy).
pub class Limits {
    max-connections:   Int = 100
    max-keepalive:     Int = 20
    keepalive-expiry:  Int | Float = 5.0
    http2-connections: Int = 1
}

/// Retry policy for failed connections and retryable statuses. Only
/// idempotent methods are retried after a response; `Retry-After` is
/// honored.
pub class Retry {
    total:       Int = 3
    backoff:     Int | Float = 0.5
    max-backoff: Int | Float = 30.0
    statuses:    Array[Int] = [429, 502, 503, 504]
    methods:     Array[String] = IDEMPOTENT_METHODS
    retry-after: Bool = true

    static of(x: Retry | Int | Bool | nil) -> Retry | nil {
        match x {
            nil, false, 0 => nil,
            r: Retry      => r,
            n: Int        => Retry(total: n),
            true          => Retry()
        }
    }

    delay(attempt: Int, rsp: Response | nil = nil) -> Float {
        let cap = float(max-backoff)
        if retry-after and let $r = rsp and let $ra = r.header('retry-after') {
            if ra.match?(/^\d+$/) {
                return min(float(int(ra, 10)), cap)
            }
            if let $t = (try { time.time(time.strptime(ra, '%a, %d %b %Y %H:%M:%S GMT'), utc: true) }) {
                return max(0.0, min(float(t) - time.utc(), cap))
            }
        }
        min(float(backoff) * float(1 << min(attempt, 20)) * (0.5 + rand()), cap)
    }
}

fn nap(secs: Float) {
    if secs <= 0.0 {
        return
    }
    if let $l = hl.loop() and hl.in-task?(l) {
        l.sleep(secs)
    } else {
        os.sleep(secs)
    }
}

pub use BodySource = Path | Iterable[String | Blob]

/// An outgoing request. `content` holds an in-memory body; `stream` holds
/// an iterable of String/Blob chunks or a `Path`.
pub class Request {
    method:     String
    url:        URL
    headers:    Headers
    content:    String | Blob | nil
    stream:     BodySource | nil
    extensions: Dict[String, String]

    init(
        method: String,
        url: String | URL,
        headers: _ = nil,
        content: String | Blob | nil = nil,
        stream: BodySource | nil = nil,
        extensions: Dict[String, String] = %{}
    ) {
        self.method     = method.upper()
        self.url        = (url :: URL) ? url : URL(url)
        self.headers    = (headers :: Headers) ? headers : Headers(headers)
        self.content    = content
        self.stream     = stream
        self.extensions = extensions
    }

    header(name: String) -> String | nil {
        headers[name]
    }

    content-type -> String | nil {
        headers['content-type']
    }

    /// Whether the body can be sent again (for redirects and retries).
    replayable? -> Bool {
        stream == nil || (stream :: Path)
    }

    copy() -> Request {
        Request(method, URL(url), headers.copy(), content, stream, extensions.clone())
    }

    pretty(body: Bool = true, color: Bool | nil = nil, limit: Int | nil = 8192) -> String {
        let col = color ?? display.color?()
        let version = extensions['http-version'] ?? 'HTTP/1.1'
        let hs = [('Host', url.authority), *headers.items().filter(p -> !p.0.ieq?('host'))]
        let data = (stream == nil) ? content : Blob('<streamed body>')
        display.message(display.request-line(method, url.target, version, col), hs, data, content-type, col, limit, body, version == 'HTTP/2')
    }

    show(%kwargs) {
        print(pretty(**kwargs))
    }

    __str__() -> String {
        "<Request [{method} {url}]>"
    }
}

fn chunks*(src: BodySource) {
    match src {
        p: Path => {
            let fd = os.open(str(p), os.O_RDONLY)
            if fd < 0 {
                throw OSError("http: cannot open {p}")
            }
            try {
                let off = 0
                while true {
                    let b = os.pread(fd, CHUNK, off)
                    if #b == 0 {
                        break
                    }
                    off += #b
                    yield b
                }
            } finally {
                os.close(fd)
            }
        },
        it => {
            for chunk in it {
                if chunk.size() > 0 {
                    yield chunk
                }
            }
        }
    }
}

fn stream-length(src: BodySource) -> Int | nil {
    match src {
        p: Path => os.stat(str(p)).?size,
        _       => nil
    }
}

pub trait Body {
    read(max: Int) -> Blob | nil;
    read-into(out: Blob, max: Int) -> Bool;
    close();
}

class MemoryBody : Body {
    data: Blob | nil

    read(max: Int) -> Blob | nil {
        let d = data
        data = nil
        d
    }

    read-into(out: Blob, max: Int) -> Bool {
        let $d = read(max) or return false
        out.push(d)
        true
    }

    close() {
        data = nil
    }
}

/// A lazy sequence produced by a `next()` function (nil ends it).
pub class Chunks[T] : Iter[T] {
    __f:     () -> T | nil
    __close: (() -> _) | nil
    __done?: Bool = false

    init(f: () -> T | nil, close: (() -> _) | nil = nil) {
        __f     = f
        __close = close
    }

    close() {
        __done? = true
        if let $f = __close {
            __close = nil
            f()
        }
    }

    __drop__() {
        close()
    }

    next() -> T | nil {
        if __done? {
            return nil
        }
        match (__f)() {
            nil => do { __done? = true; nil },
            x   => x
        }
    }

    __next__() -> Some[T] | None {
        match next() {
            nil => None,
            x   => Some(x)
        }
    }

    __iter__() -> Chunks[T] {
        self
    }
}

/// One received Server-Sent Event; `id` is the last event id seen on the
/// stream.
pub class Event {
    event: String = 'message'
    data:  String = ''
    id:    String | nil
    retry: Int | nil

    json() -> _ {
        json::parse(data)
    }

    __str__() -> String {
        c.sse(data, (event == 'message') ? nil : event, id, retry).strip-right()
    }

    __repr__() -> String {
        "Event(event: {event}, data: {data}, id: {id})"
    }
}

fn utf8-boundary(b: Blob) -> Int {
    let n = #b
    let k = 1
    while k <= min(3, n) {
        let x = b[n - k]
        if (x & 0xC0) == 0x80 {
            k += 1
            continue
        }
        if x >= 0xC0 && ((x >= 0xF0) ? 4 : ((x >= 0xE0) ? 3 : 2)) > k {
            return n - k
        }
        break
    }
    n
}

fn latin1(b: Blob) -> String {
    if !b.any?(\_ >= 0x80) {
        return b.str!()
    }
    let out = Blob()
    for x in b {
        if x < 0x80 {
            out.push(x)
        } else {
            out.push(0xC0 | (x >> 6))
            out.push(0x80 | (x & 0x3F))
        }
    }
    out.str!()
}

use Progress = Bool | ((Int, Int | nil) -> _) | nil

fn human(x: Float) -> String {
    match x {
        _ and x >= 1073741824.0 => "{x / 1073741824.0:.1f}G",
        _ and x >= 1048576.0    => "{x / 1048576.0:.1f}M",
        _ and x >= 1024.0       => "{x / 1024.0:.1f}K",
        _                       => "{int(x)}B"
    }
}

fn progress-bar(spec: Progress, total: Int | nil, label: String) -> (Int, Bool) -> _ {
    match spec {
        nil, false  => (_, _) -> nil,
        f: Function => (n, done) -> f(n, total),
        _ => do {
            let last = [0.0]
            let started = time.now()
            let tty? = os.isatty(2)
            return fn (n: Int, done: Bool) {
                let now = time.now()
                if !done && now - last[0] < 0.1 {
                    return
                }
                last[0] = now
                let rate = float(n) / max(now - started, 0.001)
                let line = match total {
                    nil => "{label}  {human(float(n))}  {human(rate)}/s",
                    t   => do {
                        let frac = (t == 0) ? 1.0 : min(1.0, float(n) / float(t))
                        let fill = int(frac * 30.0)
                        "{label}  [{'█' * fill}{'·' * (30 - fill)}] {int(frac * 100.0):3}%  {human(float(n))}/{human(float(t))}  {human(rate)}/s"
                    }
                }
                if tty? {
                    os.write(2, "\r\x1b[2K{line}{done ? '\n' : ''}")
                } else if done {
                    os.write(2, "{line}\n")
                }
            }
        }
    }
}

/// A received response. Unless the request was made with `stream: true`
/// (or through `Client.stream`), the body has already been read and the
/// connection returned to the pool. The native core constructs these with
/// `status-code`, `reason`, `http-version` and `headers` filled in.
pub class Response {
    status-code:  Int
    reason:       String
    http-version: String
    headers:      Headers
    url:          URL | nil
    request:      Request | nil
    history:      Array[Response] = []
    elapsed:      Float = 0.0

    __body:     Body | nil
    __content:  Blob | nil
    __decoder:  codec.Decoder | nil
    __started?: Bool = false
    __closed?:  Bool = false
    __pend:     Blob | nil
    __off:      Int = 0
    __limit:    Int | nil
    __on-close: Array[() -> _] | nil
    __cookies:  Dict[String, String] | nil

    init(
        status-code: Int = 200,
        headers: _ = nil,
        content: String | Blob | nil = nil,
        text: String | nil = nil,
        json: _ = nil,
        http-version: String = 'HTTP/1.1',
        reason: String | nil = nil,
        url: String | URL | nil = nil,
        request: Request | nil = nil
    ) {
        self.status-code  = status-code
        self.reason       = reason ?? status-name(status-code)
        self.headers      = (headers :: Headers) ? headers : Headers(headers)
        self.http-version = http-version
        self.request      = request
        self.url          = match url {
            nil       => request.?url,
            u: URL    => u,
            s: String => URL(s)
        }
        if json != nil {
            __content = Blob(json::encode(json))
            self.headers.setdefault('Content-Type', 'application/json')
        } else if text != nil {
            __content = Blob(text)
            self.headers.setdefault('Content-Type', 'text/plain; charset=utf-8')
        } else if content != nil {
            __content = (content :: Blob) ? content : Blob(content)
        }
        __closed? = __content != nil
    }

    /// Wires a transport body stream into the response.
    attach(body: Body) -> Response {
        __body = body
        __closed? = false
        self
    }

    on-close(f: () -> _) {
        match __on-close {
            nil => __on-close = [f],
            fs  => fs.push(f)
        }
    }

    body-stream -> Body | nil {
        __body
    }

    /// Decodes Content-Encoding from here on; `limit` caps the decoded size.
    enable-decoding(limit: Int | nil = nil) {
        __limit = limit
        let $ce = headers['content-encoding'] or return
        if __started? || __decoder != nil {
            return
        }
        if __content != nil {
            __content = try {
                codec.decode(ce, __content, limit)
            } catch e: codec.CodecError {
                throw DecodingError(str(e), request)
            }
            return
        }
        let names = ce.matches(/[^\s,]+/).filter(\!_.ieq?('identity'))
        if #names == 1 && codec.supported?(names[0]) {
            __decoder = codec.Decoder(names[0], limit)
        } else if #names > 1 {
            __decoder = nil
            __content = nil
            let raw = Blob()
            while let $chunk = __raw-chunk() {
                raw.push(chunk)
            }
            __content = try {
                codec.decode(ce, raw, limit)
            } catch e: codec.CodecError {
                throw DecodingError(str(e), request)
            }
        }
    }

    header(name: String) -> String | nil {
        headers[name]
    }

    content-type -> String | nil {
        headers['content-type']
    }

    /// The charset parameter of Content-Type, if any.
    encoding -> String | nil {
        match (content-type ?? '').match(/charset\s*=\s*"?([^";\s]+)/i) {
            [_, cs] => cs.lower(),
            _       => nil
        }
    }

    reason-phrase -> String {
        reason
    }

    ok? -> Bool {
        status-code >= 200 && status-code < 300
    }

    success? -> Bool {
        ok?
    }

    informational? -> Bool {
        status-code >= 100 && status-code < 200
    }

    redirect? -> Bool {
        REDIRECTS.contains?(status-code) && headers['location'] != nil
    }

    client-error? -> Bool {
        status-code >= 400 && status-code < 500
    }

    server-error? -> Bool {
        status-code >= 500 && status-code < 600
    }

    error? -> Bool {
        status-code >= 400
    }

    /// The redirect target, resolved against the request URL.
    next-url -> URL | nil {
        match (url, headers['location']) {
            ($u, $loc) => u.join(loc),
            _          => nil
        }
    }

    /// Throws `HttpStatusError` for 4xx/5xx responses; returns self.
    raise-for-status() -> Response {
        if status-code >= 400 {
            let kind = (status-code < 500) ? 'Client error' : 'Server error'
            throw HttpStatusError("{kind} '{status-code} {reason}' for url '{url}'", request, self)
        }
        self
    }

    closed? -> Bool {
        __closed?
    }

    /// Whether the body has been fully read into memory.
    read? -> Bool {
        __content != nil
    }

    __raw-chunk() -> Blob | nil {
        if __closed? {
            return nil
        }
        let $body = __body or return nil
        let chunk = try {
            body.read(CHUNK)
        } catch e {
            close()
            throw e
        }
        if chunk == nil {
            close()
        }
        chunk
    }

    __raw-into(out: Blob, max: Int) -> Bool {
        if __closed? {
            return false
        }
        let $body = __body or return false
        let more = try {
            body.read-into(out, max)
        } catch e {
            close()
            throw e
        }
        if !more {
            close()
        }
        more
    }

    __decoded-chunk() -> Blob | nil {
        while true {
            let $raw = __raw-chunk() or do {
                if let $d = __decoder {
                    __decoder = nil
                    try {
                        d.finish()
                    } catch e: codec.CodecError {
                        throw DecodingError(str(e), request)
                    } finally {
                        d.close()
                    }
                }
                return nil
            }
            let $d = __decoder or do {
                if __limit != nil {
                    __limit -= #raw
                    if __limit < 0 {
                        close()
                        throw DecodingError('http: response body exceeds the size limit', request)
                    }
                }
                return raw
            }
            let out = try {
                d.feed(raw)
            } catch e: codec.CodecError {
                d.close()
                __decoder = nil
                close()
                throw DecodingError(str(e), request)
            }
            if #out > 0 {
                return out
            }
        }
        nil
    }

    /// Reads the next chunk of the decoded body (at most `max` bytes); nil
    /// at the end.
    read(max: Int = 65536) -> Blob | nil {
        __started? = true
        if __content != nil {
            if __off >= #__content {
                return nil
            }
            let n = min(max, #__content - __off)
            let out = __content[__off;__off + n]
            __off += n
            return out
        }
        let pend = __pend ?? __decoded-chunk() ?? return nil
        if #pend <= max {
            __pend = nil
            return pend
        }
        __pend = pend
        pend.splice(0, max)
    }

    /// Reads the rest of the decoded body (the whole body before any
    /// `read()`, cached as `content`).
    read-all() -> Blob {
        if !__started? {
            return __content ?? __slurp()
        }
        if __content != nil {
            let rest = __content[__off;]
            __off = #__content
            return rest
        }
        let rest = __pend ?? Blob()
        __pend = nil
        while let $chunk = __decoded-chunk() {
            rest.push(chunk)
        }
        rest
    }

    __slurp() -> Blob {
        let out = Blob()
        if __decoder == nil {
            while __raw-into(out, (__limit == nil) ? (1 << 62) : __limit - #out + 1) {
                if __limit != nil && #out > __limit {
                    close()
                    throw DecodingError('http: response body exceeds the size limit', request)
                }
            }
        } else {
            while let $chunk = __decoded-chunk() {
                out.push(chunk)
            }
        }
        __content = out
        out
    }

    /// The whole decoded body (read into memory and cached).
    content -> Blob {
        if __content == nil && __started? {
            throw StreamConsumed()
        }
        __content ?? read-all()
    }

    body -> String {
        text
    }

    text -> String {
        let b = content
        match encoding {
            'iso-8859-1', 'latin-1', 'latin1', 'windows-1252', 'cp1252', 'us-ascii', 'ascii' => latin1(b),
            _ => b.str(lossy: true)
        }
    }

    json() -> _ {
        let t = text
        try {
            json::parse(t)
        } catch e {
            throw DecodingError("http: response body is not JSON: {e}", request)
        }
    }

    __stream-start() {
        if __started? {
            throw StreamConsumed()
        }
        __started? = true
    }

    /// Decoded body chunks as they arrive (exactly `size` bytes each, except
    /// the last, when `size` is given).
    bytes(size: Int | nil = nil) -> Chunks[Blob] {
        if let $b = __content {
            let i = [0]
            return Chunks(fn () {
                if i[0] >= #b {
                    return nil
                }
                let n = min(size ?? #b, #b - i[0])
                let out = b[i[0];i[0] + n]
                i[0] += n
                out
            })
        }
        __stream-start()
        let $n = size or return Chunks(-> __decoded-chunk())
        let pend = Blob()
        Chunks(fn () {
            while #pend < n {
                let $chunk = __decoded-chunk() or break
                pend.push(chunk)
            }
            if #pend == 0 {
                return nil
            }
            if #pend > n {
                return pend.splice(0, n)
            }
            let out = pend
            pend = Blob()
            out
        })
    }

    /// Undecoded body chunks (as sent on the wire, minus framing).
    raw() -> Chunks[Blob] {
        if let $b = __content {
            let done = [false]
            return Chunks(fn () {
                if done[0] {
                    return nil
                }
                done[0] = true
                b
            })
        }
        __stream-start()
        Chunks(-> __raw-chunk())
    }

    /// Text chunks; multi-byte UTF-8 sequences are never split.
    text-chunks() -> Chunks[String] {
        let src = bytes()
        let pend = Blob()
        Chunks(fn () {
            while true {
                let $chunk = src.next() or do {
                    if #pend == 0 {
                        return nil
                    }
                    let tail = pend.str(lossy: true)
                    pend.clear()
                    return tail
                }
                pend.push(chunk)
                let cut = utf8-boundary(pend)
                if cut > 0 {
                    let out = pend.str(0, cut, lossy: true)
                    pend.clear(0, cut)
                    return out
                }
            }
            nil
        })
    }

    /// Lines of text without their terminators (`\n` or `\r\n`).
    lines() -> Chunks[String] {
        let src = text-chunks()
        let queue: Queue[String] = Queue()
        let pend = ['']
        let done = [false]
        Chunks(fn () {
            while #queue == 0 {
                if done[0] {
                    return nil
                }
                match src.next() {
                    nil => {
                        done[0] = true
                        if pend[0] != '' {
                            queue.push(pend[0])
                            pend[0] = ''
                        }
                    },
                    chunk => {
                        let parts = (pend[0] + chunk).split(/\r?\n/)
                        for i in ..(#parts - 1) {
                            queue.push(parts[i])
                        }
                        pend[0] = parts[-1]
                    }
                }
            }
            queue.pop()
        })
    }

    /// Server-Sent Events from a text/event-stream body.
    events(last-id: String | nil = nil) -> Chunks[Event] {
        let src = bytes()
        let parser = c.sse-parser(last-id)
        let queue: Array[Event] = []
        let done = [false]
        Chunks(fn () {
            while #queue == 0 {
                if done[0] {
                    return nil
                }
                match src.next() {
                    nil => {
                        done[0] = true
                        c.sse-feed(parser, nil, queue, true)
                    },
                    chunk => c.sse-feed(parser, chunk, queue)
                }
            }
            queue.shift()
        })
    }

    /// Streams the body to `path`, returning the number of bytes written.
    save(path: String | Path, decode: Bool = true, progress: Progress = nil) -> Int {
        let fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        if fd < 0 {
            throw OSError("http: cannot open {path}")
        }
        let total = (try { int(headers['content-length'] ?? '', 10) })
        let n = 0
        let bar = progress-bar(progress, total, str(path))
        try {
            for chunk in (decode ? bytes() : raw()) {
                if os.write(fd, chunk, all: true) < 0 {
                    throw OSError("http: write to {path} failed")
                }
                n += #chunk
                bar(n, false)
            }
            bar(n, true)
        } finally {
            os.close(fd)
            close()
        }
        n
    }

    /// Parsed Link headers: rel → {url, *params}.
    links -> Dict[String, Dict[String, String]] {
        let out = %{}
        let base = url ?? URL()
        for value in headers.all('link') {
            for part in value.split(/,\s*(?=<)/) {
                let $m = part.match(/^\s*<([^>]*)>(.*)$/) or continue
                let entry = %{'url': str(base.join(m[1]))}
                for p in m[2].split(';') {
                    if let [_, k, v] = p.match(/^\s*([^=\s]+)\s*=\s*"?([^"]*)"?\s*$/) {
                        entry[k.lower()] = v
                    }
                }
                out[str(entry['rel'] ?? entry['url'])] = entry
            }
        }
        out
    }

    /// Cookies set by this response (name → value).
    cookies -> Dict[String, String] {
        __cookies ?? do {
            let jar = CookieJar()
            jar.extract(headers, url ?? URL())
            let d = jar.dict()
            __cookies = d
            d
        }
    }

    cookie(name: String) -> String | nil {
        cookies[name]
    }

    /// Releases the connection without reading the rest of the body.
    close() {
        if __closed? {
            return
        }
        __closed? = true
        if let $d = __decoder {
            __decoder = nil
            d.close()
        }
        if let $b = __body {
            __body = nil
            try {
                b.close()
            } catch _ {
            }
        }
        if let $fs = __on-close {
            __on-close = nil
            for f in fs {
                f()
            }
        }
    }

    __drop__() {
        close()
    }

    pretty(body: Bool = true, headers: Bool = true, color: Bool | nil = nil, limit: Int | nil = 8192) -> String {
        let col = color ?? display.color?()
        let start = display.status-line(http-version, status-code, reason, col)
        let hs = headers ? self.headers.items() : []
        let data = (body && (__content != nil || !__started?)) ? read-all() : nil
        display.message(start, hs, data, content-type, col, limit, body, http-version == 'HTTP/2')
    }

    show(history: Bool = false, request: Bool = false, %kwargs) {
        if history {
            for r in self.history {
                print(r.pretty(body: false, **kwargs))
                print('')
            }
        }
        if request and let $req = self.request {
            print(req.pretty(**kwargs))
            print('')
        }
        print(pretty(**kwargs))
    }

    __str__() -> String {
        "<Response [{status-code} {reason}]>"
    }
}

c.setup-client(Response, Event)

pub trait Auth {
    apply(req: Request) -> Request;
    retry(req: Request, rsp: Response) -> Request | nil;
}

/// Basic authentication (RFC 7617).
pub class BasicAuth : Auth {
    username: String
    password: String

    apply(req: Request) -> Request {
        req.headers['Authorization'] = "Basic {b64.encode("{username}:{password}")}"
        req
    }

    retry(req: Request, rsp: Response) -> Request | nil {
        nil
    }
}

/// `Authorization: Bearer <token>`.
pub class BearerAuth : Auth {
    token: String

    apply(req: Request) -> Request {
        req.headers['Authorization'] = "Bearer {token}"
        req
    }

    retry(req: Request, rsp: Response) -> Request | nil {
        nil
    }
}

fn digest-hash(algorithm: String, s: String) -> String {
    match algorithm {
        /^md5(?:-sess)?$/i      => md5(s),
        /^sha-?256(?:-sess)?$/i => sha256(s),
        other                   => throw RequestError("http: unsupported digest algorithm {other}")
    }
}

/// Digest authentication (RFC 7616): MD5, SHA-256 and their -sess
/// variants, qop=auth. The first request goes out without credentials and
/// is repeated once the server's challenge arrives.
pub class DigestAuth : Auth {
    username: String
    password: String

    __challenge: Dict[String, String] | nil
    __count:     Atomic = Atomic(0)

    __header(req: Request, ch: Dict[String, String]) -> String {
        let realm     = ch['realm'] ?? ''
        let nonce     = ch['nonce'] ?? ''
        let algorithm = ch['algorithm'] ?? 'MD5'
        let qop       = (ch['qop'] ?? '').split(',').map(\_.strip()).contains?('auth') ? 'auth' : nil
        let nc        = "{__count.fetch-add(1) + 1:08x}"
        let cnonce    = ssl.random-bytes(8).hex()
        let uri       = req.url.target

        let ha1 = digest-hash(algorithm, "{username}:{realm}:{password}")
        if algorithm :: /-sess$/i {
            ha1 = digest-hash(algorithm, "{ha1}:{nonce}:{cnonce}")
        }
        let ha2 = digest-hash(algorithm, "{req.method}:{uri}")
        let response = (qop == nil) ? digest-hash(algorithm, "{ha1}:{nonce}:{ha2}")
                     :                digest-hash(algorithm, "{ha1}:{nonce}:{nc}:{cnonce}:{qop}:{ha2}")

        let parts = [
            "username=\"{username}\"",
            "realm=\"{realm}\"",
            "nonce=\"{nonce}\"",
            "uri=\"{uri}\"",
            "response=\"{response}\"",
            "algorithm={algorithm}"
        ]
        if let $opaque = ch['opaque'] {
            parts.push("opaque=\"{opaque}\"")
        }
        if qop != nil {
            parts.push("qop={qop}")
            parts.push("nc={nc}")
            parts.push("cnonce=\"{cnonce}\"")
        }
        "Digest {parts.join(', ')}"
    }

    apply(req: Request) -> Request {
        if __challenge {
            req.headers['Authorization'] = __header(req, __challenge)
        }
        req
    }

    retry(req: Request, rsp: Response) -> Request | nil {
        if rsp.status-code != 401 {
            return nil
        }
        let $www = rsp.headers.all('www-authenticate').find(\_ :: /^digest/i) or return nil
        let ch = %{}
        for m in www.bslice(6).matches(/(\w+)\s*=\s*(?:"((?:[^"\\]|\\.)*)"|([^,\s]+))/v) {
            ch[str(m[1]).lower()] = m[2] ?? m[3] ?? ''
        }
        if req.headers['authorization'] != nil && !(ch['stale'] ?? '').ieq?('true') {
            return nil
        }
        __challenge = ch
        let again = req.copy()
        again.headers['Authorization'] = __header(again, ch)
        again
    }
}

class FunctionAuth : Auth {
    f: (Request) -> Request | nil

    apply(req: Request) -> Request {
        f(req) ?? req
    }

    retry(req: Request, rsp: Response) -> Request | nil {
        nil
    }
}

fn auth-of(x: _) -> Auth | nil {
    match x {
        nil, false           => nil,
        (user, pass)         => BasicAuth(str(user), str(pass)),
        {username, password} => BasicAuth(username, password),
        token: String        => BearerAuth(token),
        f: Function          => FunctionAuth(f),
        a                    => a
    }
}

/// A native connection: a socket, optionally wrapped in TLS (possibly TLS
/// inside a TLS tunnel). Every operation is non-blocking in the core and
/// waits here, through the server loop when called from a handler.
pub class Sock {
    ptr:  Ptr
    fd:   Int
    host: String

    static tcp(host: String, port: Int, until: Float | nil, local: String | nil = nil) -> Sock {
        let fd = connect-tcp(host, port, until, local)
        os.setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, 1)
        Sock(c.client(fd), fd, host)
    }

    static unix(path: String, until: Float | nil) -> Sock {
        let fd = os.socket(os.AF_UNIX, os.SOCK_STREAM, 0)
        if fd < 0 {
            throw ConnectError('http: socket() failed')
        }
        if os.connect(fd, {family: os.AF_UNIX, path: path}) != 0 {
            let e = errno.str(errno.get())
            os.close(fd)
            throw ConnectError("http: cannot connect to {path}: {e}")
        }
        os.fcntl(fd, os.F_SETFL, os.fcntl(fd, os.F_GETFL) | os.O_NONBLOCK)
        Sock(c.client(fd), fd, path)
    }

    /// A TLS session over this socket (which it takes over).
    tls(ctx: ssl.Context, name: String, until: Float | nil) -> Sock {
        let s = Sock(c.client(fd, ctx.ptr, name, ptr), fd, name)
        s.io(until, ConnectTimeout, -> c.handshake(s.ptr), "the TLS handshake with {name}")
        s
    }

    alpn -> String | nil {
        c.alpn(ptr)
    }

    io(until: Float | nil, timeout: (String) -> TimeoutError, f: () -> _, what: String = 'the network') -> _ {
        while true {
            let r = f()
            match r {
                WANT_READ => {
                    if !hl.wait-fd(fd, os.POLLIN, left(until)) {
                        throw timeout("http: timed out waiting for {what} from {host}")
                    }
                },
                WANT_WRITE => {
                    if !hl.wait-fd(fd, os.POLLOUT, left(until)) {
                        throw timeout("http: timed out writing to {host}")
                    }
                },
                n: Int and n < 0 => throw failure(n),
                _ => return r
            }
        }
        nil
    }

    failure(rc: Int) -> TransportError {
        let msg = c.error(ptr)
        match rc {
            E_CERT   => ConnectError("http: TLS certificate verification failed for {host}: {msg}"),
            E_TLS    => ConnectError("http: TLS error with {host}: {msg}"),
            E_PROTO  => ProtocolError("http: {host}: {msg}"),
            E_CLOSED => ReadError("http: {host}: {msg}"),
            _        => ReadError("http: {host}: {msg}")
        }
    }

    send(data: String | Blob, until: Float | nil) {
        io(until, WriteTimeout, -> c.send(ptr, data))
        io(until, WriteTimeout, -> c.flush(ptr))
    }

    /// The next raw chunk (after TLS); nil at end of stream.
    recv(until: Float | nil) -> Blob | nil {
        io(until, ReadTimeout, -> c.recv(ptr))
    }

    stale?() -> Bool {
        c.stale?(ptr)
    }

    close() {
        c.close(ptr)
    }
}

fn resolve(host: String, port: Int) -> Array[_] {
    let numeric? = host.match?(/^[\d.]+$/) || host.contains?(':')
    let lookup = -> os.getaddrinfo(host, port, 0, os.SOCK_STREAM, 0)
    let r = (numeric? || !(hl.loop() != nil && hl.in-task?(hl.loop()!))) ? lookup() : hl.blocking(lookup)
    match r {
        Ok(xs) => xs,
        Err(e) => throw ConnectError("http: cannot resolve {host}: {os.gai_strerror(e)}")
    }
}

fn connect-tcp(host: String, port: Int, until: Float | nil, local: String | nil) -> Int {
    let addrs = resolve(host, port)
    let first = (#addrs > 0) ? addrs[0].family : os.AF_INET
    let ordered = [*addrs.filter(\_.family == first).interleave(addrs.filter(\_.family != first))]
    let last = 'no addresses'

    for a in ordered {
        let fd = os.socket(a.family, os.SOCK_STREAM, 0)
        if fd < 0 {
            last = 'socket() failed'
            continue
        }
        os.fcntl(fd, os.F_SETFL, os.fcntl(fd, os.F_GETFL) | os.O_NONBLOCK)
#|if __apple__
        os.setsockopt(fd, 0xFFFF, 0x1022, 1)
#|]
        if local != nil and let Ok([la, *]) = os.getaddrinfo(local, 0, a.family, os.SOCK_STREAM, 0) {
            os.bind(fd, la)
        }
        if os.connect(fd, a) == 0 {
            return fd
        }
        let e = errno.get()
        if e != errno.EINPROGRESS && e != errno.EINTR {
            last = errno.str(e)
            os.close(fd)
            continue
        }
        let stagger = (a != ordered[-1]) ? min(left(until) ?? 0.25, 0.25) : left(until)
        if !hl.wait-fd(fd, os.POLLOUT, stagger) {
            os.close(fd)
            if until != nil && left(until) == 0.0 {
                throw ConnectTimeout("http: connection to {host}:{port} timed out")
            }
            last = 'timed out'
            continue
        }
        let err = os.getsockopt(fd, os.SOL_SOCKET, SO_ERROR) ?? 0
        if err == 0 {
            return fd
        }
        last = errno.str(err)
        os.close(fd)
    }

    throw ConnectError("http: cannot connect to {host}:{port}: {last}")
}

pub trait Connection {
    key -> String;
    requests -> Int;
    http2? -> Bool;
    reusable? -> Bool;
    exchange(req: Request, t: Timeout, extra: Array[(String, String)] = []) -> Response;
    close();
}

fn table-of(req: Request, extra: Array[(String, String)]) -> Dict[String, _] {
    if #extra == 0 {
        return req.headers.table
    }
    let h = req.headers.copy()
    for (k, v) in extra {
        h.add(k, v)
    }
    h.table
}

class H1Body : Body {
    conn:  H1Conn
    done?: Bool = false

    read(max: Int) -> Blob | nil {
        if done? {
            return nil
        }
        let s = conn.sock
        let chunk = try {
            s.io(deadline(conn.timeout.read), ReadTimeout, -> c.body(s.ptr, max), 'the response body')
        } catch e {
            __finish(false)
            throw e
        }
        if chunk == nil {
            __finish(c.reusable?(s.ptr))
        }
        chunk
    }

    read-into(out: Blob, max: Int) -> Bool {
        if done? {
            return false
        }
        let s = conn.sock
        let n = try {
            s.io(deadline(conn.timeout.read), ReadTimeout, -> c.body-into(s.ptr, out, max), 'the response body')
        } catch e {
            __finish(false)
            throw e
        }
        if n == 0 {
            __finish(c.reusable?(s.ptr))
        }
        n > 0
    }

    __finish(reuse?: Bool) {
        if !done? {
            done? = true
            conn.finished(reuse?)
        }
    }

    close() {
        __finish(false)
    }
}

/// One HTTP/1.1 connection, used by one request at a time.
pub class H1Conn : Connection {
    sock:       Sock
    origin:     String
    pool:       Pool | nil
    forward?:   Bool = false
    idle-since: Float = time.now()
    closed?:    Bool = false
    timeout:    Timeout = Timeout()

    __requests: Int = 0

    key -> String {
        origin
    }

    requests -> Int {
        __requests
    }

    http2? -> Bool {
        false
    }

    reusable? -> Bool {
        !closed? && !sock.stale?()
    }

    finished(reuse?: Bool) {
        match pool {
            nil => if !reuse? { close() },
            p   => p.release(self, reuse? && !closed?)
        }
    }

    close() {
        if !closed? {
            closed? = true
            sock.close()
        }
    }

    exchange(req: Request, t: Timeout, extra: Array[(String, String)] = []) -> Response {
        timeout = t
        __requests += 1
        try {
            __exchange(req, t, extra)
        } catch e: StaleConnection {
            close()
            throw e
        } catch e: TransportError {
            close()
            if __requests > 1 && !(e :: TimeoutError) {
                throw StaleConnection("http: kept-alive connection to {sock.host} failed: {e}")
            }
            throw e
        }
    }

    __exchange(req: Request, t: Timeout, extra: Array[(String, String)]) -> Response {
        let url    = req.url
        let target = forward? ? str(url.without-credentials()) : url.target
        let wd     = deadline(t.write)
        let s      = sock
        let body   = req.content
        let src    = req.stream

        let length = if src != nil {
            (req.headers['content-length'] != nil) ? -2 : (stream-length(src) ?? -1)
        } else if body != nil {
            body.size()
        } else if req.method == 'POST' || req.method == 'PUT' || req.method == 'PATCH' {
            0
        } else {
            -2
        }

        let inline = (body != nil && body.size() <= 65536) ? body : nil
        let table  = table-of(req, extra)

        s.io(wd, WriteTimeout, -> c.request(s.ptr, req.method, target, url.authority, table, length, inline))
        s.io(wd, WriteTimeout, -> c.flush(s.ptr))

        if body != nil && inline == nil {
            s.send(body, wd)
        }

        if src != nil {
            for chunk in chunks(src) {
                if length == -1 {
                    s.io(deadline(t.write), WriteTimeout, -> c.chunk(s.ptr, chunk))
                } else {
                    s.io(deadline(t.write), WriteTimeout, -> c.send(s.ptr, chunk))
                }
                s.io(deadline(t.write), WriteTimeout, -> c.flush(s.ptr))
            }
            if length == -1 {
                s.io(deadline(t.write), WriteTimeout, -> c.chunk(s.ptr, nil))
                s.io(deadline(t.write), WriteTimeout, -> c.flush(s.ptr))
            }
        }

        let rsp = try {
            s.io(deadline(t.read), ReadTimeout, -> c.head(s.ptr), 'the response')
        } catch e: ReadError {
            throw (__requests > 1) ? StaleConnection(str(e)) : e
        }

        rsp.url = url
        rsp.request = req
        rsp.attach(H1Body(self))
    }
}

class H2Body : Body {
    conn:  H2Conn
    sid:   Int
    t:     Timeout
    done?: Bool = false

    read(max: Int) -> Blob | nil {
        if done? {
            return nil
        }
        let out = try {
            conn.take(sid, max, t)
        } catch e {
            __finish()
            throw e
        }
        if out == nil {
            __finish()
        }
        out
    }

    read-into(out: Blob, max: Int) -> Bool {
        let $b = read(max) or return false
        out.push(b)
        true
    }

    __finish() {
        if !done? {
            done? = true
            conn.finished(sid)
        }
    }

    close() {
        __finish()
    }
}

/// An HTTP/2 connection multiplexing requests from any number of threads
/// and tasks; a native driver thread owns the socket and the session.
pub class H2Conn : Connection {
    h2:         Ptr
    sock:       Sock
    pool:       Pool | nil
    idle-since: Float = time.now()

    __key:      String
    __requests: Atomic = Atomic(0)
    __reserved: Atomic = Atomic(0)

    init(sock: Sock, key: String, pool: Pool | nil) {
        self.sock = sock
        self.pool = pool
        __key     = key
        h2        = c.h2-client(sock.ptr)
    }

    key -> String {
        __key
    }

    requests -> Int {
        __requests.load()
    }

    http2? -> Bool {
        true
    }

    active -> Int {
        __reserved.load()
    }

    usable? -> Bool {
        let (_, max-streams, ok?) = c.h2-state(h2)
        ok? && __reserved.load() < max-streams
    }

    idle? -> Bool {
        __reserved.load() == 0
    }

    reusable? -> Bool {
        usable?
    }

    reserve() {
        __reserved.fetch-add(1)
        __requests.fetch-add(1)
    }

    unreserve() {
        if __reserved.fetch-sub(1) == 1 {
            idle-since = time.now()
        }
    }

    close() {
        c.h2-close(h2)
    }

    __wait(sid: Int, what: Int, until: Float | nil) {
        if let $l = hl.loop() and hl.in-task?(l) {
            let tid = c.timer(l.core, left(until) ?? 3600.0, hl.task())
            try {
                if !c.h2-watch(h2, sid, what, l.core, tid) {
                    hl.suspend()
                }
            } finally {
                c.untimer(l.core, tid)
                c.h2-unwatch(h2, sid)
            }
        } else {
            c.h2-wait(h2, sid, what, left(until) ?? -1.0)
        }
    }

    __failure(sid: Int) -> TransportError {
        let (msg, refused?) = c.h2-error(h2, sid)
        refused? ? StaleConnection("http: {sock.host} {msg}") : ProtocolError("http: {sock.host} {msg}")
    }

    exchange(req: Request, t: Timeout, extra: Array[(String, String)] = []) -> Response {
        let url  = req.url
        let body = req.content
        let src  = req.stream

        let length = (src != nil) ? (stream-length(src) ?? -1) : ((body != nil) ? body.size() : -1)
        let sid    = c.h2-request(
            h2,
            req.method,
            url.scheme ?? 'https',
            req.headers['host'] ?? url.authority,
            url.target,
            table-of(req, extra),
            length,
            src != nil || (body != nil && body.size() > 0)
        )

        if sid < 0 {
            throw StaleConnection("http: HTTP/2 connection to {sock.host} is closed")
        }

        try {
            if body != nil && body.size() > 0 {
                c.h2-upload(h2, sid, body, true)
            }
            if src != nil {
                for chunk in chunks(src) {
                    let n = c.h2-upload(h2, sid, chunk)
                    if n < 0 {
                        break
                    }
                    let until = deadline(t.write)
                    while n > UPLOAD_HIGH {
                        __wait(sid, W_UPLOAD, until)
                        if c.h2-head(h2, sid) != WANT_READ {
                            break
                        }
                        n = c.h2-upload(h2, sid, nil)
                        if n > UPLOAD_HIGH && until != nil && left(until) == 0.0 {
                            throw WriteTimeout("http: timed out waiting for flow-control credit from {sock.host}")
                        }
                    }
                    if n < 0 || c.h2-head(h2, sid) != WANT_READ {
                        break
                    }
                }
                c.h2-upload(h2, sid, nil, true)
            }

            let rsp = __head(sid, deadline(t.read))
            rsp.url = url
            rsp.request = req
            rsp.attach(H2Body(self, sid, t))
        } catch e {
            c.h2-cancel(h2, sid)
            throw e
        }
    }

    __head(sid: Int, until: Float | nil) -> Response {
        while true {
            match c.h2-head(h2, sid) {
                r: Response => return r,
                WANT_READ   => do {
                    if until != nil && left(until) == 0.0 {
                        throw ReadTimeout("http: timed out waiting for response headers from {sock.host}")
                    }
                    __wait(sid, W_HEAD, until)
                },
                _ => throw __failure(sid)
            }
        }
        throw __failure(sid)
    }

    take(sid: Int, max: Int, t: Timeout) -> Blob | nil {
        let until = deadline(t.read)
        while true {
            match c.h2-take(h2, sid, max) {
                b: Blob   => return b,
                nil       => return nil,
                WANT_READ => do {
                    if until != nil && left(until) == 0.0 {
                        throw ReadTimeout("http: timed out waiting for the response body from {sock.host}")
                    }
                    __wait(sid, W_BODY, until)
                },
                _ => throw __failure(sid)
            }
        }
        nil
    }

    finished(sid: Int) {
        c.h2-cancel(h2, sid)
        match pool {
            nil => {},
            p   => p.release(self, true)
        }
    }
}

/// Keeps idle HTTP/1.1 connections and shared HTTP/2 connections per
/// origin, bounded by `Limits`.
pub class Pool {
    limits: Limits

    __lock:    Mutex = Mutex()
    __cv:      CondVar = CondVar()
    __idle:    Dict[String, Array[H1Conn]] = %{}
    __nidle:   Int = 0
    __h2:      Dict[String, Array[H2Conn]] = %{}
    __total:   Int = 0
    __probing: Set[String] = %[]
    __proto:   Dict[String, Bool] = %{}
    __closed?: Bool = false

    connections -> Int {
        let ^_ = __lock.lock()
        __total
    }

    idle-connections -> Int {
        let ^_ = __lock.lock()
        __nidle
    }

    __usable-h2(key: String) -> H2Conn | nil {
        let $conns = __h2[key] or return nil
        conns.filter!(fn (conn) {
            if conn.usable? || !conn.idle? {
                return true
            }
            __total -= 1
            conn.close()
            false
        })
        let best = nil
        for conn in conns {
            if conn.usable? && (best == nil || conn.active < best.active) {
                best = conn
            }
        }
        best
    }

    __evict-one() -> Bool {
        for _, conns in __idle {
            if #conns > 0 {
                let conn = conns.pop()
                __nidle -= 1
                __total -= 1
                conn.close()
                return true
            }
        }
        false
    }

    /// A connection for `key`: an idle or multiplexed one when possible,
    /// `open()` otherwise.
    acquire(key: String, open: () -> Connection, until: Float | nil, h2?: Bool) -> Connection {
        let ^_ = __lock.lock()
        while true {
            if __closed? {
                throw TransportError('http: the client has been closed')
            }

            if let $conn = __usable-h2(key) {
                let spread? = conn.active > 0
                           && #(__h2[key] ?? []) < limits.http2-connections
                           && !__probing.contains?(key)
                           && __total < limits.max-connections
                if !spread? {
                    conn.reserve()
                    return conn
                }
            }

            while let $idle = __idle[key] and #idle > 0 {
                let conn = idle.pop()
                __nidle -= 1
                if time.now() - conn.idle-since > float(limits.keepalive-expiry) || !conn.reusable? {
                    __total -= 1
                    conn.close()
                    continue
                }
                return conn
            }

            if h2? && __probing.contains?(key) {
                __cv.wait(__lock, left(until) ?? 3600.0)
                if until != nil && left(until) == 0.0 {
                    throw PoolTimeout("http: timed out waiting for a connection to {key}")
                }
                continue
            }

            if __total < limits.max-connections || __evict-one() {
                __total += 1
                let probe? = h2? && (__proto[key] ?? true)
                if probe? {
                    __probing.insert(key)
                }
                __lock.unlock()
                let conn = try {
                    open()
                } catch e {
                    __lock.lock()
                    __total -= 1
                    __probing.remove(key)
                    __cv.broadcast()
                    throw e
                }
                __lock.lock()
                __probing.remove(key)
                __proto[key] = conn.http2?
                if let h: H2Conn = conn {
                    (__h2[key] ?? (__h2[key] = [])).push(h)
                    h.reserve()
                }
                __cv.broadcast()
                return conn
            }

            __cv.wait(__lock, left(until) ?? 3600.0)
            if until != nil && left(until) == 0.0 {
                throw PoolTimeout("http: timed out waiting for a free connection (max-connections: {limits.max-connections})")
            }
        }
        nil
    }

    release(conn: Connection, reuse?: Bool) {
        let ^_ = __lock.lock()
        match conn {
            h: H2Conn => {
                h.unreserve()
                if __closed? {
                    if h.idle? {
                        h.close()
                    }
                    return
                }
                if !h.usable? && h.idle? {
                    if let $list = __h2[h.key] {
                        list.filter!(\_ != h)
                    }
                    __total -= 1
                    h.close()
                }
            },
            h: H1Conn => {
                if __closed? {
                    h.close()
                } else if reuse? && __nidle < limits.max-keepalive {
                    h.idle-since = time.now()
                    (__idle[h.key] ?= []).push(h)
                    __nidle += 1
                } else {
                    __total -= 1
                    h.close()
                }
            }
        }
        __cv.broadcast()
    }

    /// Drops a connection that failed.
    discard(conn: Connection) {
        let ^_ = __lock.lock()
        if __closed? {
            conn.close()
            return
        }
        match conn {
            h: H2Conn => {
                if let $list = __h2[h.key] and list.contains?(h) {
                    list.filter!(\_ != h)
                    __total -= 1
                }
            },
            _ => __total -= 1
        }
        conn.close()
        __cv.broadcast()
    }

    close() {
        let ^_ = __lock.lock()
        __closed? = true
        for _, conns in __idle {
            for conn in conns {
                conn.close()
            }
        }
        for _, conns in __h2 {
            for conn in conns {
                conn.close()
            }
        }
        __idle.clear()
        __h2.clear()
        __nidle = 0
        __total = 0
        __cv.broadcast()
    }
}

fn no-proxy?(host: String, port: Int | nil, rules: String | nil) -> Bool {
    let $text = rules or return false
    for rule in text.split(',').map(\_.strip().lower()) {
        if rule == '' {
            continue
        }
        if rule == '*' {
            return true
        }
        let r = rule.comb(/^\*?\./)
        let (rh, rp) = match r.match(/^(.*):(\d+)$/) {
            [_, h, p] => (h, int(p, 10)),
            _         => (r, nil)
        }
        if (rp == nil || rp == port) && (host == rh || host.ends?(".{rh}")) {
            return true
        }
    }
    false
}

fn env-proxy(names: Array[String]) -> URL | nil {
    for n in names {
        if let $v = getenv(n) and v != '' {
            return URL(v.contains?('://') ? v : "http://{v}")
        }
    }
    nil
}

use EnvProxies = (URL | nil, URL | nil, String | nil);

fn proxy-auth(proxy: URL) -> String | nil {
    let $u = proxy.username or return nil
    "Basic {b64.encode("{c.percent-decode(u)}:{c.percent-decode(proxy.password ?? '')}")}"
}

pub use Verify     = Bool | String | ssl.Context
pub use ClientCert = String | (String, String) | nil

pub trait Transport {
    handle(req: Request, t: Timeout) -> Response;
    close();
}

/// The default transport: pooled TCP/TLS connections speaking HTTP/1.1 or
/// HTTP/2, with proxy support.
pub class HTTPTransport : Transport {
    http1:         Bool = true
    http2:         Bool = true
    verify:        Verify = true
    cert:          ClientCert
    retries:       Int = 0
    proxy:         URL | nil
    trust-env:     Bool = true
    uds:           String | nil
    local-address: String | nil
    limits:        Limits = Limits()

    __pool:   Pool | nil
    __env:    EnvProxies | nil
    __ctx:    ssl.Context | nil
    __ctx-h1: ssl.Context | nil
    __lock:   Mutex = Mutex()

    pool -> Pool {
        let ^_ = __lock.lock()
        if __pool {
            return __pool
        }
        let p = Pool(limits)
        __pool = p
        p
    }

    __context(h2: Bool) -> ssl.Context {
        let ^_ = __lock.lock()
        if h2 {
            __ctx ?? (__ctx = __make-context(http1 ? ['h2', 'http/1.1'] : ['h2']))
        } else {
            __ctx-h1 ?? (__ctx-h1 = __make-context(['http/1.1']))
        }
    }

    __make-context(alpn: Array[String]) -> ssl.Context {
        let (certfile, keyfile) = match cert {
            nil         => (nil, nil),
            (c, k)      => (c, k),
            one: String => (one, nil)
        }
        match verify {
            ctx: ssl.Context => ctx,
            false            => ssl.Context(verify: false, alpn: alpn, cert: certfile, key: keyfile),
            true             => ssl.Context(alpn: alpn, cert: certfile, key: keyfile, ca: __env-ca()),
            ca: String       => ssl.Context(alpn: alpn, cert: certfile, key: keyfile, ca: ca)
        }
    }

    __env-ca() -> String | nil {
        if !trust-env {
            return nil
        }
        for n in static!(['SSL_CERT_FILE', 'REQUESTS_CA_BUNDLE', 'CURL_CA_BUNDLE']) {
            if let $v = getenv(n) and v != '' && os.stat(v) != nil {
                return v
            }
        }
        nil
    }

    proxy-for(url: URL) -> URL | nil {
        if uds != nil {
            return nil
        }
        if proxy {
            return proxy
        }
        if !trust-env {
            return nil
        }
        let (http, https, rules) = __env-proxies()
        let $p = (url.secure? ? https : http) or return nil
        no-proxy?(url.host ?? '', url.effective-port, rules) ? nil : p
    }

    __env-proxies() -> EnvProxies {
        if __env {
            return __env
        }
        let ^_ = __lock.lock()
        let e = __env ?? (
            env-proxy(static!(['HTTP_PROXY', 'http_proxy', 'ALL_PROXY', 'all_proxy'])),
            env-proxy(static!(['HTTPS_PROXY', 'https_proxy', 'ALL_PROXY', 'all_proxy'])),
            getenv('NO_PROXY') ?? getenv('no_proxy')
        )
        __env = e
        e
    }

    __key(url: URL, proxy: URL | nil) -> String {
        let base = "{url.scheme}://{url.host-literal}:{url.effective-port}"
        match (proxy, uds) {
            (nil, nil) => base,
            (nil, u)   => "{base}@unix:{u}",
            (p, _)     => "{base}@{p}"
        }
    }

    __open(url: URL, proxy: URL | nil, key: String, t: Timeout) -> Connection {
        let until = deadline(t.connect)
        let host  = url.host ?? throw UnsupportedProtocol("http: URL has no host: {url}")
        let port  = url.effective-port ?? throw UnsupportedProtocol("http: URL has no port: {url}")
        let https? = url.scheme == 'https'
        let forward? = proxy != nil && !https? && (proxy.scheme == 'http' || proxy.scheme == 'https')

        let sock = __dial(url, proxy, host, port, until)

        try {
            if https? {
                sock = sock.tls(__context(http2), host, until)
                if sock.alpn == 'h2' && http2 {
                    return H2Conn(sock, key, pool)
                }
                if !http1 {
                    throw UnsupportedProtocol("http: {host} does not support HTTP/2 and http1 is disabled")
                }
            } else if !http1 && http2 && !forward? {
                return H2Conn(sock, key, pool)
            }
            H1Conn(sock, key, pool, forward?)
        } catch e {
            sock.close()
            throw e
        }
    }

    __dial(url: URL, proxy: URL | nil, host: String, port: Int, until: Float | nil) -> Sock {
        if uds {
            return Sock.unix(uds, until)
        }
        let $p = proxy or return Sock.tcp(host, port, until, local-address)
        match p.scheme {
            'http', 'https' => {
                let s = Sock.tcp(p.host ?? '', p.effective-port ?? 8080, until, local-address)
                try {
                    if p.scheme == 'https' {
                        s = s.tls(__context(false), p.host ?? '', until)
                    }
                    if url.scheme == 'https' {
                        __tunnel(s, p, host, port, until)
                    }
                } catch e {
                    s.close()
                    throw e
                }
                s
            },
            'socks5', 'socks5h' => {
                let s = Sock.tcp(p.host ?? '', p.effective-port ?? 1080, until, local-address)
                try {
                    __socks5(s, p, host, port, until)
                } catch e {
                    s.close()
                    throw e
                }
                s
            },
            other => throw ProxyError("http: unsupported proxy scheme: {other}")
        }
    }

    __tunnel(s: Sock, p: URL, host: String, port: Int, until: Float | nil) {
        let target = host.contains?(':') ? "[{host}]:{port}" : "{host}:{port}"
        let extra = [('User-Agent', USER_AGENT)]
        if let $auth = proxy-auth(p) {
            extra.push(('Proxy-Authorization', auth))
        }
        let req = Request('CONNECT', URL("http://{target}/"), extra)
        s.io(until, ConnectTimeout, -> c.request(s.ptr, 'CONNECT', target, target, req.headers.table, -2, nil))
        s.io(until, ConnectTimeout, -> c.flush(s.ptr))
        let rsp = try {
            s.io(until, ConnectTimeout, -> c.head(s.ptr), 'the proxy')
        } catch e: TransportError {
            throw ProxyError("http: proxy CONNECT failed: {e}")
        }
        if rsp.status-code < 200 || rsp.status-code >= 300 {
            throw ProxyError("http: proxy refused CONNECT to {target}: {rsp.status-code} {rsp.reason}")
        }
    }

    __read-exact(s: Sock, n: Int, until: Float | nil) -> Blob {
        let out = Blob()
        while #out < n {
            let $chunk = s.io(until, ConnectTimeout, -> c.recv(s.ptr, n - #out)) or throw ProxyError('http: proxy closed the connection')
            out.push(chunk)
        }
        out
    }

    __socks5(s: Sock, p: URL, host: String, port: Int, until: Float | nil) {
        let user = p.username
        s.send((user == nil) ? Blob(5, 1, 0) : Blob(5, 2, 0, 2), until)
        let reply = __read-exact(s, 2, until)
        if reply[0] != 5 || reply[1] == 0xFF {
            throw ProxyError('http: SOCKS5 proxy rejected every authentication method')
        }
        if reply[1] == 2 {
            let u = c.percent-decode(user ?? '')
            let pw = c.percent-decode(p.password ?? '')
            s.send(Blob(1, u.size()).push(u).push(pw.size()).push(pw), until)
            if __read-exact(s, 2, until)[1] != 0 {
                throw ProxyError('http: SOCKS5 authentication failed')
            }
        }
        let req = Blob(5, 1, 0)
        if let $ip4 = host.match(/^(\d+)\.(\d+)\.(\d+)\.(\d+)$/) {
            req.push(1)
            for i in 1..5 {
                req.push(int(ip4[i], 10))
            }
        } else if p.scheme == 'socks5' {
            match resolve(host, port).filter(\_.family == os.AF_INET) {
                [a, *] => req.push(1).push(a.address.ptr() + 4, 4),
                _      => throw ConnectError("http: cannot resolve {host}")
            }
        } else {
            req.push(3).push(host.size()).push(host)
        }
        req.push(port >> 8).push(port & 0xFF)
        s.send(req, until)
        let head = __read-exact(s, 5, until)
        if head[0] != 5 {
            throw ProxyError('http: SOCKS5 proxy sent an invalid reply')
        }
        if head[1] != 0 {
            let why = static!([
                'succeeded',
                'general failure',
                'not allowed by ruleset',
                'network unreachable',
                'host unreachable',
                'connection refused',
                'TTL expired',
                'command not supported',
                'address type not supported'
            ])
            throw ProxyError("http: SOCKS5 proxy: {(head[1] < #why) ? why[head[1]] : "error {head[1]}"}")
        }
        let total = match head[3] {
            1 => 10,
            4 => 22,
            3 => 7 + head[4],
            _ => throw ProxyError('http: SOCKS5 proxy sent an invalid reply')
        }
        __read-exact(s, total - 5, until)
    }

    /// Sends `req` and returns a streaming `Response`.
    handle(req: Request, t: Timeout) -> Response {
        let url = req.url
        match url.scheme {
            'http', 'https' => {},
            nil             => throw UnsupportedProtocol("http: URL has no scheme: {url}"),
            other           => throw UnsupportedProtocol("http: unsupported URL scheme '{other}'")
        }
        if url.host == nil || url.host == '' {
            throw UnsupportedProtocol("http: URL has no host: {url}")
        }

        let proxy = proxy-for(url)
        let key   = __key(url, proxy)
        let extra = []

        if proxy != nil && url.scheme == 'http' && proxy.scheme != 'socks5' && proxy.scheme != 'socks5h' {
            if let $auth = proxy-auth(proxy) {
                extra.push(('Proxy-Authorization', auth))
            }
        }

        let h2? = (http2 && url.scheme == 'https') || (!http1 && http2)
        let attempt = 0

        while true {
            let conn: Connection | nil = nil
            let reused? = false
            try {
                let cn = pool.acquire(key, -> __open(url, proxy, key, t), deadline(t.pool), h2?)
                conn = cn
                reused? = cn.requests > (cn.http2? ? 1 : 0)
                return cn.exchange(req, t, extra)
            } catch e {
                if conn {
                    if conn.http2? {
                        pool.release(conn, false)
                    } else {
                        pool.discard(conn)
                    }
                }
                match e {
                    _: StaleConnection and req.replayable? && attempt < 3 => {
                        attempt += 1
                        continue
                    },
                    _: ConnectError and attempt < retries => {
                        attempt += 1
                        nap(min(0.5 * float(1 << attempt), 8.0))
                        continue
                    },
                    _: ReadError and reused? && req.replayable? && IDEMPOTENT.contains?(req.method) && attempt < max(retries, 1) => {
                        attempt += 1
                        continue
                    },
                    _ => {}
                }
                if (e :: RequestError) && e.request == nil {
                    e.request = req
                }
                throw e
            }
        }
        nil
    }

    /// Sends `req` on a connection of its own for protocols that take the
    /// connection over (WebSockets). Returns the response and, after a 101,
    /// the socket.
    upgrade(req: Request, t: Timeout) -> (Response, Sock | nil) {
        let url      = req.url
        let host     = url.host ?? throw UnsupportedProtocol("http: URL has no host: {url}")
        let port     = url.effective-port ?? throw UnsupportedProtocol("http: URL has no port: {url}")
        let proxy    = proxy-for(url)
        let until    = deadline(t.connect)
        let forward? = proxy != nil && url.scheme != 'https' && (proxy.scheme == 'http' || proxy.scheme == 'https')
        let extra    = []

        if forward? and let $p = proxy and let $auth = proxy-auth(p) {
            extra.push(('Proxy-Authorization', auth))
        }

        let sock = __dial(url, proxy, host, port, until)

        try {
            if url.scheme == 'https' {
                sock = sock.tls(__context(false), host, until)
            }
            let conn = H1Conn(sock, '', nil, forward?)
            let rsp = conn.exchange(req, t, extra)
            if rsp.status-code == 101 {
                return (rsp, sock)
            }
            (rsp, nil)
        } catch e {
            sock.close()
            throw e
        }
    }

    close() {
        pool.close()
    }
}

/// A transport that answers requests by calling `handler(req)`, for tests.
/// The handler returns a `Response`, an Int status, a String/Blob body, a
/// `(status, body)` / `(status, headers, body)` tuple, or a JSON-able value.
pub class MockTransport : Transport {
    handler: (Request) -> _

    handle(req: Request, t: Timeout) -> Response {
        let rsp = match handler(req) {
            r: Response           => r,
            n: Int                => Response(n),
            s: String             => Response(200, text: s),
            b: Blob               => Response(200, content: b),
            (code: Int, hs, body) => Response(code, hs, content: (body :: String | Blob) ? body : json::encode(body)),
            (code: Int, body)     => (body :: String | Blob) ? Response(code, content: body) : Response(code, json: body),
            other                 => Response(200, json: other)
        }
        rsp.request = req
        rsp.url = req.url
        if rsp.headers['content-encoding'] != nil && rsp.read? {
            let fresh = Response(rsp.status-code, rsp.headers, http-version: rsp.http-version, reason: rsp.reason, url: req.url, request: req)
            fresh.attach(MemoryBody(rsp.read-all()))
            return fresh
        }
        rsp
    }

    close() {
    }
}

/// Whether credentials may follow a redirect from `a` to `b`: same origin,
/// or an http → https upgrade of the same host on default ports.
fn safe-redirect?(a: URL, b: URL) -> Bool {
    a.same-origin?(b) || (
        a.scheme == 'http'
     && b.scheme == 'https'
     && a.host == b.host
     && (a.port == nil || a.port == 80)
     && (b.port == nil || b.port == 443)
    )
}

fn merge-params(url: URL, params: _) -> URL {
    (params == nil) ? url : url.with(params: params)
}

pub use EventHooks = {
    request:  Array[(Request) -> _],
    response: Array[(Response) -> _]
}

pub use Tracer = (String, Request | Response) -> _

fn hook-list(v: _) -> Array[_] {
    match v {
        nil       => [],
        vs: Array => [*vs],
        f         => [f]
    }
}

fn hooks-of(x: _) -> EventHooks {
    let d = match x {
        nil     => %{},
        d: Dict => d,
        r       => members(r)
    }
    {request: hook-list(d['request']), response: hook-list(d['response'])}
}

fn trace-default(kind: String, x: Request | Response) {
    let col = display.color?(2)
    match x {
        req: Request => {
            let text = req.pretty(body: req.content != nil, color: col, limit: 2048)
            os.write(2, text.split('\n').map(l -> "> {l}").join('\n') + '\n')
        },
        rsp: Response => {
            let lines = [
                display.status-line(
                    rsp.http-version,
                    rsp.status-code,
                    rsp.reason,
                    col
                ),
                *display.header-lines(
                    rsp.headers.items(),
                    col,
                    rsp.http-version == 'HTTP/2'
                )
            ]
            os.write(2, lines.map(l -> "< {l}").join('\n') + '\n\n')
        }
    }
}

fn trace-printer(spec: Bool | Tracer | nil) -> Tracer | nil {
    match spec {
        nil, false  => nil,
        f: Function => f,
        _           => trace-default
    }
}

fn compress-stream*(src: BodySource, coding: String) {
    let e = codec.Encoder(coding)
    for chunk in chunks(src) {
        yield e.write(chunk)
    }
    yield e.finish()
}

class EventState {
    delay:     Float
    rsp:       Response | nil
    src:       Chunks[Event] | nil
    last-id:   String | nil
    failures:  Int = 0
    finished?: Bool = false

    close() {
        if let $r = rsp {
            rsp = nil
            src = nil
            r.close()
        }
    }
}

/// An HTTP client with shared configuration and a connection pool.
///
/// Keywords: `base-url`; `headers`, `params`, `cookies`, `auth` (defaults
/// merged into every request); `timeout` (seconds or `Timeout`);
/// `follow-redirects`, `max-redirects`; `http1`, `http2`; `verify` (true,
/// false, a CA bundle, or an `ssl.Context`); `cert` (path or `(cert, key)`);
/// `proxy` (`http://`, `https://`, `socks5://`, `socks5h://`) and
/// `trust-env` (HTTP(S)_PROXY, ALL_PROXY, NO_PROXY, SSL_CERT_FILE);
/// `limits`; `retries` (connection retries); `retry` (a `Retry` policy);
/// `uds`; `local-address`; `transport` and `mounts` (URL prefix →
/// transport); `event-hooks`; `compress` (request bodies); `decode`;
/// `max-response-size`; `raise-for-status`; `trace`.
pub class Client {
    base-url:          URL | nil
    headers:           Headers
    params:            _
    cookies:           CookieJar
    auth:              Auth | nil
    timeout:           Timeout
    follow-redirects:  Bool
    max-redirects:     Int
    event-hooks:       EventHooks
    transport:         _
    mounts:            Dict[String, Transport]
    retry:             Retry | nil
    compress:          String | nil
    decode:            Bool
    max-response-size: Int | nil
    raise-for-status:  Bool
    trace:             Tracer | nil

    __closed?: Bool = false

    init(
        base-url: String | URL | nil = nil,
        headers: _ = nil,
        params: _ = nil,
        cookies: _ = nil,
        auth: _ = nil,
        timeout: _ = 5.0,
        follow-redirects: Bool = true,
        max-redirects: Int = 20,
        http1: Bool = true,
        http2: Bool = true,
        verify: Verify = true,
        cert: ClientCert = nil,
        proxy: String | URL | nil = nil,
        trust-env: Bool = true,
        limits: Limits = Limits(),
        retries: Int = 0,
        retry: Retry | Int | Bool | nil = nil,
        uds: String | nil = nil,
        local-address: String | nil = nil,
        transport: Transport | nil = nil,
        mounts: Dict[String, Transport] | nil = nil,
        event-hooks: _ = nil,
        user-agent: String = USER_AGENT,
        compress: String | nil = nil,
        decode: Bool = true,
        max-response-size: Int | nil = nil,
        raise-for-status: Bool = false,
        trace: Bool | Tracer | nil = false
    ) {
        if !http1 && !http2 {
            throw ValueError('http: at least one of http1 and http2 must be enabled')
        }
        if compress != nil && !codec.encodable?(compress) {
            throw ValueError("http: cannot compress request bodies with {compress}")
        }

        self.base-url = match base-url {
            nil, ''   => nil,
            u: URL    => u,
            s: String => URL(s.ends?('/') ? s : "{s}/")
        }
        self.headers = Headers([
            ('User-Agent', user-agent),
            ('Accept', '*/*'),
            ('Accept-Encoding', decode ? codec.accept-encoding() : 'identity')
        ])
        self.headers.update(headers)
        self.params            = params
        self.cookies           = match cookies { jar: CookieJar => jar, other => CookieJar(other) }
        self.auth              = auth-of(auth)
        self.timeout           = Timeout.of(timeout)
        self.follow-redirects  = follow-redirects
        self.max-redirects     = max-redirects
        self.event-hooks       = hooks-of(event-hooks)
        self.retry             = Retry.of(retry)
        self.compress          = compress
        self.decode            = decode
        self.max-response-size = max-response-size
        self.raise-for-status  = raise-for-status
        self.trace             = trace-printer(trace)
        self.mounts            = mounts ?? %{}
        self.transport         = transport ?? HTTPTransport(
            http1: http1,
            http2: http2,
            verify: verify,
            cert: cert,
            retries: retries,
            proxy: match proxy { nil => nil, u: URL => u, s => URL(s) },
            trust-env: trust-env,
            uds: uds,
            local-address: local-address,
            limits: limits
        )
    }

    closed? -> Bool {
        __closed?
    }

    __url(url: String | URL) -> URL {
        let u = (url :: URL) ? url : URL(url)
        match base-url {
            nil => u,
            b   => u.absolute? ? u : b.join(str(u).comb(/^\//))
        }
    }

    /// Builds a `Request` with the client's defaults merged in.
    build-request(
        method: String,
        url: String | URL,
        content: String | Blob | BodySource | nil = nil,
        data: _ = nil,
        files: _ = nil,
        json: _ = nil,
        params: _ = nil,
        headers: _ = nil,
        cookies: _ = nil,
        compress: String | nil = nil,
        extensions: Dict[String, String] | nil = nil
    ) -> Request {
        let u = merge-params(merge-params(__url(url), self.params), params)
        let hs = self.headers.copy()
        hs.update(headers)

        let body: String | Blob | nil = nil
        let stream: BodySource | nil = nil

        if json != nil {
            body = json::encode(json)
            hs.setdefault('Content-Type', 'application/json')
        } else if files != nil {
            let (b, ctype) = encode-multipart(data, files)
            body = b
            hs.set('Content-Type', ctype)
        } else if data != nil {
            match data {
                s: String => body = s,
                b: Blob   => body = b,
                d         => {
                    body = c.encode-query(d, true)
                    hs.setdefault('Content-Type', 'application/x-www-form-urlencoded')
                }
            }
        }

        match content {
            nil       => {},
            s: String => body = s,
            b: Blob   => body = b,
            other     => stream = other
        }

        let enc = compress ?? self.compress
        if enc != nil && enc != 'identity' && hs['content-encoding'] == nil {
            if body != nil {
                body = codec.encode(enc, body)
                hs.set('Content-Encoding', enc)
            } else if stream != nil {
                stream = compress-stream(stream, enc)
                hs.set('Content-Encoding', enc)
            }
        }

        let req = Request(method, u, hs, body, stream, extensions ?? %{})

        if cookies != nil {
            let jar = CookieJar(cookies)
            let line = jar.header-for(u) ?? match cookies {
                d: Dict => d.list().map(p -> "{p.0}={p.1}").join('; '),
                _       => nil
            }
            if line != nil {
                req.extensions['cookies'] = line
            }
        }

        req
    }

    __transport-for(url: URL) -> Transport {
        let s = str(url)
        let best = nil
        let best-len = -1
        for prefix, t in mounts {
            if s.starts?(prefix) && prefix.size() > best-len {
                best = t
                best-len = prefix.size()
            }
        }
        best ?? transport
    }

    __add-cookies(req: Request) {
        if req.headers['cookie'] == nil {
            let parts = [cookies.header-for(req.url), req.extensions['cookies']].filter(\_ != nil)
            if #parts > 0 {
                req.headers['Cookie'] = parts.join('; ')
            }
        }
    }

    __send-once(req: Request, t: Timeout) -> Response {
        __add-cookies(req)

        for f in event-hooks.request {
            f(req)
        }
        if trace {
            trace('request', req)
        }

        let started = time.now()
        let rsp = __transport-for(req.url).handle(req, t)

        if decode {
            rsp.enable-decoding(max-response-size)
        }

        rsp.request = req
        req.extensions['http-version'] = rsp.http-version
        rsp.elapsed = time.now() - started
        rsp.on-close(fn () { rsp.elapsed = time.now() - started })

        cookies.extract(rsp.headers, req.url)

        if trace {
            trace('response', rsp)
        }
        for f in event-hooks.response {
            f(rsp)
        }
        rsp
    }

    __redirect(req: Request, rsp: Response) -> Request | nil {
        let $next = rsp.next-url or return nil
        let method = match rsp.status-code {
            303      => (req.method == 'HEAD') ? 'HEAD' : 'GET',
            301, 302 => (req.method == 'POST') ? 'GET' : req.method,
            _        => req.method
        }

        if next.scheme != 'http' && next.scheme != 'https' {
            return nil
        }

        if next.fragment == nil && req.url.fragment != nil {
            next.fragment = req.url.fragment
        }

        let hs = req.headers.copy()
        let keep-body? = method == req.method && (rsp.status-code == 307 || rsp.status-code == 308)

        if !keep-body? {
            for h in static!(['content-length', 'content-type', 'content-encoding', 'transfer-encoding']) {
                hs.remove(h)
            }
        } else if !req.replayable? {
            return nil
        }

        if !safe-redirect?(req.url, next) {
            hs.remove('authorization')
            hs.remove('proxy-authorization')
        }
        hs.remove('cookie')
        hs.remove('host')

        let ext = req.extensions.clone()
        if !next.same-origin?(req.url) {
            ext.remove('cookies')
        }

        Request(method, next, hs, keep-body? ? req.content : nil, keep-body? ? req.stream : nil, ext)
    }

    /// Sends a prepared `Request`. With `stream: true` the body is left
    /// unread: iterate it and `close()` the response (or use `with`).
    send(
        req: Request,
        stream: Bool = false,
        auth: _ = nil,
        follow-redirects: Bool | nil = nil,
        timeout: _ = nil
    ) -> Response {
        if __closed? {
            throw TransportError('http: the client has been closed', req)
        }

        let t = Timeout.of(timeout, self.timeout)
        let follow = follow-redirects ?? self.follow-redirects
        let a = match auth { nil => self.auth, false => nil, x => auth-of(x) }
        let history = []
        let current = req

        if current.url.username != nil && a == nil {
            a = BasicAuth(c.percent-decode(current.url.username ?? ''), c.percent-decode(current.url.password ?? ''))
            current.url = current.url.without-credentials()
        }

        while true {
            if a {
                current = a.apply(current)
            }

            let rsp = __send-with-retry(current, t)

            if a and let $again = a.retry(current, rsp) {
                rsp.close()
                current = again
                rsp = __send-with-retry(current, t)
            }

            if follow && rsp.redirect? and let $next = __redirect(current, rsp) {
                if #history >= max-redirects {
                    rsp.close()
                    throw TooManyRedirects("http: exceeded {max-redirects} redirects", current)
                }
                __drain(rsp)
                history.push(rsp)
                if !safe-redirect?(current.url, next.url) {
                    a = nil
                }
                current = next
                continue
            }

            rsp.history = history
            if !stream {
                try {
                    rsp.read-all()
                } finally {
                    rsp.close()
                }
            }
            if raise-for-status {
                rsp.raise-for-status()
            }
            return rsp
        }
        nil
    }

    __drain(rsp: Response) {
        try {
            let n = 0
            while let $chunk = rsp.read() {
                n += #chunk
                if n > (1 << 20) {
                    break
                }
            }
        } catch _ {
        }
        rsp.close()
    }

    __send-with-retry(req: Request, t: Timeout) -> Response {
        let $policy = retry or return __send-once(req, t)
        let attempt = 0
        while true {
            let rsp = try {
                __send-once(req, t)
            } catch e: TransportError {
                let retryable? = (e :: ConnectError) || (e :: ConnectTimeout) || (policy.methods.contains?(req.method) && req.replayable?)
                if attempt >= policy.total || !retryable? {
                    throw e
                }
                nap(policy.delay(attempt))
                attempt += 1
                continue
            }
            if (
                attempt < policy.total
             && policy.statuses.contains?(rsp.status-code)
             && policy.methods.contains?(req.method)
             && req.replayable?
            ) {
                let wait = policy.delay(attempt, rsp)
                __drain(rsp)
                nap(wait)
                attempt += 1
                continue
            }
            return rsp
        }
        nil
    }

    /// Sends a request; see `build-request` for the body keywords
    /// (`content`, `data`, `files`, `json`) and `send` for the rest.
    request(
        method: String,
        url: String | URL,
        content: String | Blob | BodySource | nil = nil,
        data: _ = nil,
        files: _ = nil,
        json: _ = nil,
        params: _ = nil,
        headers: _ = nil,
        cookies: _ = nil,
        auth: _ = nil,
        timeout: _ = nil,
        follow-redirects: Bool | nil = nil,
        stream: Bool = false,
        compress: String | nil = nil,
        extensions: Dict[String, String] | nil = nil
    ) -> Response {
        let req = build-request(
            method,
            url,
            content: content,
            data: data,
            files: files,
            json: json,
            params: params,
            headers: headers,
            cookies: cookies,
            compress: compress,
            extensions: extensions
        )
        send(req, stream: stream, auth: auth, follow-redirects: follow-redirects, timeout: timeout)
    }

    get(url: String | URL, %kwargs) -> Response     { request('GET', url, **kwargs) }
    head(url: String | URL, %kwargs) -> Response    { request('HEAD', url, **kwargs) }
    options(url: String | URL, %kwargs) -> Response { request('OPTIONS', url, **kwargs) }
    post(url: String | URL, %kwargs) -> Response    { request('POST', url, **kwargs) }
    put(url: String | URL, %kwargs) -> Response     { request('PUT', url, **kwargs) }
    patch(url: String | URL, %kwargs) -> Response   { request('PATCH', url, **kwargs) }
    delete(url: String | URL, %kwargs) -> Response  { request('DELETE', url, **kwargs) }

    /// Like `request` with `stream: true`.
    stream(method: String, url: String | URL, %kwargs) -> Response {
        request(method, url, stream: true, **kwargs)
    }

    /// Downloads `url` to `path` (default: the URL's last path segment) with
    /// an optional progress bar or callback `f(bytes, total)`.
    download(url: String | URL, path: String | Path | nil = nil, progress: Progress = nil, %kwargs) -> Path {
        let rsp = request('GET', url, stream: true, **kwargs)
        try {
            rsp.raise-for-status()
            let name = path ?? do {
                let seg = (rsp.url ?? URL()).path.split('/')[-1]
                (seg == '') ? 'index.html' : c.percent-decode(seg)
            }
            rsp.save(name, progress: progress)
            Path(str(name))
        } finally {
            rsp.close()
        }
    }

    /// Server-Sent Events from `url`, reconnecting with Last-Event-ID when
    /// the stream ends or fails, until `reconnect: false` or `max-retries`
    /// consecutive failures.
    events(url: String | URL, reconnect: Bool = true, max-retries: Int | nil = nil, retry-delay: Int | Float = 3.0, %kwargs) -> Chunks[Event] {
        let hs = Headers(kwargs['headers'])
        hs.set('Accept', 'text/event-stream')
        hs.set('Cache-Control', 'no-cache')
        let opts = kwargs - static!(%['headers', 'timeout'])
        let timeout = kwargs['timeout'] ?? Timeout(self.timeout.connect ?? 5.0, read: false)

        let st = EventState(float(retry-delay))

        let fail = fn (e: TransportError) {
            st.close()
            st.failures += 1
            if !reconnect || (max-retries != nil && st.failures > max-retries) {
                st.finished? = true
                throw e
            }
            nap(st.delay)
        }

        let next = fn () {
            while !st.finished? {
                if st.rsp == nil {
                    if let $id = st.last-id {
                        hs.set('Last-Event-ID', id)
                    }
                    let rsp = try {
                        request('GET', url, stream: true, headers: hs, timeout: timeout, **opts)
                    } catch e: TransportError {
                        fail(e)
                        continue
                    }
                    st.rsp = rsp
                    if rsp.status-code == 204 {
                        st.close()
                        st.finished? = true
                        return nil
                    }
                    try {
                        rsp.raise-for-status()
                        if !((rsp.content-type ?? '') :: /^text\/event-stream/i) {
                            throw ProtocolError("http: expected text/event-stream, got {rsp.content-type}", rsp.request)
                        }
                    } catch e {
                        st.close()
                        st.finished? = true
                        throw e
                    }
                    st.src = rsp.events(st.last-id)
                }
                let ev = try {
                    st.src.?next()
                } catch e: TransportError {
                    fail(e)
                    continue
                }
                if ev {
                    st.failures = 0
                    st.last-id = ev.id
                    if ev.retry != nil {
                        st.delay = float(ev.retry) / 1000.0
                    }
                    return ev
                }
                st.close()
                if !reconnect {
                    st.finished? = true
                    return nil
                }
                nap(st.delay)
            }
            nil
        }

        Chunks(next, -> st.close())
    }

    /// Opens a WebSocket (RFC 6455) on a connection of its own. `url` may be
    /// `ws://`, `wss://`, `http://` or `https://`; the handshake carries the
    /// client's headers, params, cookies and auth, and goes through its proxy
    /// and TLS settings. A 4xx/5xx answer throws `HttpStatusError`, any
    /// other refusal `ProtocolError`. Redirects are not followed.
    websocket(
        url: String | URL,
        headers: _ = nil,
        params: _ = nil,
        cookies: _ = nil,
        auth: _ = nil,
        protocols: Array[String] = [],
        timeout: _ = nil,
        max-message: Int = 64 << 20
    ) -> WebSocket {
        if __closed? {
            throw TransportError('http: the client has been closed')
        }

        let target = __url(url)
        let key    = b64.encode(random(16))
        let req    = build-request(
            'GET',
            URL(target, scheme: target.secure? ? 'https' : 'http'),
            params: params,
            headers: headers,
            cookies: cookies
        )

        req.headers.set('Connection', 'Upgrade')
        req.headers.set('Upgrade', 'websocket')
        req.headers.set('Sec-WebSocket-Version', '13')
        req.headers.set('Sec-WebSocket-Key', key)

        if #protocols > 0 {
            req.headers.set('Sec-WebSocket-Protocol', protocols.join(', '))
        }

        __add-cookies(req)

        if let $au = match auth { nil => self.auth, false => nil, x => auth-of(x) } {
            req = au.apply(req)
        }

        for f in event-hooks.request {
            f(req)
        }
        if trace {
            trace('request', req)
        }

        let tp = match __transport-for(req.url) {
            h: HTTPTransport => h,
            _                => throw UnsupportedProtocol('http: WebSockets need the network transport', req)
        }

        let (rsp, sock) = tp.upgrade(req, Timeout.of(timeout, self.timeout))

        self.cookies.extract(rsp.headers, req.url)

        if trace {
            trace('response', rsp)
        }
        for f in event-hooks.response {
            f(rsp)
        }

        let $s = sock or do {
            rsp.enable-decoding(max-response-size)
            try {
                rsp.read-all()
            } finally {
                rsp.close()
            }
            rsp.raise-for-status()
            throw ProtocolError("http: {target.host} answered {rsp.status-code} {rsp.reason} instead of opening a WebSocket", req)
        }

        let chosen = rsp.header('sec-websocket-protocol')

        if (
            !(rsp.header('upgrade') ?? '').ieq?('websocket')
         || rsp.header('sec-websocket-accept') != c.ws-accept-key(key)
         || (chosen != nil && !(chosen in protocols))
        ) {
            s.close()
            throw ProtocolError("http: {target.host} sent an invalid WebSocket handshake", req)
        }

        WebSocket(s, rsp, chosen, max-message)
    }

    /// Runs requests concurrently on `workers` threads (HTTP/2 connections
    /// are shared, so this multiplexes). Each item is a URL, a `Request`, or a
    /// record/Dict of `request` arguments. Returns responses in order; failed
    /// items hold their exception unless `raise: true`.
    parallel(items: Array[_], workers: Int = 8, raise: Bool = false) -> Array[_] {
        let results = [nil] * #items
        let next = Atomic(0)
        let work = fn () {
            while true {
                let i = next.fetch-add(1)
                if i >= #items {
                    break
                }
                results[i] = try {
                    match items[i] {
                        u: String | URL => get(u),
                        r: Request      => send(r),
                        d: Dict         => request(d['method'] ?? 'GET', d['url'], **(d - static!(%['method', 'url']))),
                        r               => do {
                            let d = members(r)
                            request(d['method'] ?? 'GET', d['url'], **(d - static!(%['method', 'url'])))
                        }
                    }
                } catch e {
                    e
                }
            }
        }
        let ts = [Thread(work) for _ in ..min(workers, max(#items, 1))]
        for t in ts {
            t.join()
        }
        if raise {
            for r in results {
                if !(r :: Response) {
                    throw r
                }
            }
        }
        results
    }

    /// Closes pooled connections; the client cannot be used afterwards.
    close() {
        if !__closed? {
            __closed? = true
            transport.close()
            for _, t in mounts {
                t.close()
            }
        }
    }

    __drop__() {
        close()
    }

    __str__() -> String {
        "<Client{(base-url == nil) ? '' : " {base-url}"}>"
    }
}

const OP_TEXT   = 0x1
const OP_BINARY = 0x2
const OP_CLOSE  = 0x8
const OP_PING   = 0x9

/// A client WebSocket from `Client.websocket`. One thread reads with `recv`
/// while others may `send` and `ping`; `recv` answers the server's pings and
/// returns nil once the connection has closed (`close-code` and
/// `close-reason` say why).
pub class WebSocket {
    response:     Response
    protocol:     String | nil
    max-message:  Int
    close-code:   Int | nil
    close-reason: String | nil

    __sock:    Sock
    __lock:    Mutex = Mutex()
    __closed?: Bool = false

    init(sock: Sock, response: Response, protocol: String | nil, max-message: Int) {
        __sock           = sock
        self.response    = response
        self.protocol    = protocol
        self.max-message = max-message
    }

    fd -> Int {
        __sock.fd
    }

    closed? -> Bool {
        __closed?
    }

    __io(timeout: Int | Float | nil, kind: (String) -> TimeoutError, f: () -> _) -> _ {
        let s = __sock
        let until = deadline(seconds(timeout))
        while true {
            let r = do {
                let ^_ = __lock.lock()
                f()
            }
            match r {
                WANT_READ => {
                    if !hl.wait-fd(s.fd, os.POLLIN, left(until)) {
                        throw kind("http: timed out on the WebSocket to {s.host}")
                    }
                },
                WANT_WRITE => {
                    if !hl.wait-fd(s.fd, os.POLLOUT, left(until)) {
                        throw kind("http: timed out writing to the WebSocket to {s.host}")
                    }
                },
                n: Int and n < 0 => throw s.failure(n),
                _ => return r
            }
        }
        nil
    }

    __send(op: Int, data: String | Blob, timeout: Int | Float | nil) {
        if __closed? {
            throw WriteError("http: the WebSocket to {__sock.host} is closed")
        }
        __io(timeout, WriteTimeout, -> c.ws-write(__sock.ptr, data, op))
        __io(timeout, WriteTimeout, -> c.flush(__sock.ptr))
    }

    /// Sends a text (String) or binary (Blob) message.
    send(msg: String | Blob, timeout: Int | Float | nil = 5.0) {
        __send((msg :: String) ? OP_TEXT : OP_BINARY, msg, timeout)
    }

    ping(data: String | Blob = '', timeout: Int | Float | nil = 5.0) {
        __send(OP_PING, data, timeout)
    }

    __finish() {
        if let (code, reason) = c.ws-status(__sock.ptr) {
            close-code ?= code
            close-reason ?= reason
        }
        if !__closed? {
            __closed? = true
            __sock.close()
        }
    }

    /// The next message: a String for text, a Blob for binary data, or nil
    /// once the connection has closed. Throws `ReadTimeout` when nothing
    /// arrives within `timeout` seconds; a partial message is kept.
    recv(timeout: Int | Float | nil = nil) -> String | Blob | nil {
        if __closed? {
            return nil
        }
        let msg = try {
            __io(timeout, ReadTimeout, -> c.ws-read(__sock.ptr, max-message))
        } catch e: ProtocolError {
            __finish()
            throw ProtocolError("http: {c.error(__sock.ptr)} on the WebSocket to {__sock.host}")
        }
        if msg == nil {
            try {
                __io(1.0, WriteTimeout, -> c.flush(__sock.ptr))
            } catch _ {
            }
            __finish()
        }
        msg
    }

    /// Sends a close frame, waits up to `timeout` seconds for the server's,
    /// and closes the connection.
    close(code: Int = 1000, reason: String = '', timeout: Int | Float | nil = 1.0) {
        if __closed? {
            return
        }
        try {
            __send(OP_CLOSE, Blob(code >> 8, code & 0xFF).push(reason), timeout)
            let until = deadline(seconds(timeout))
            while recv(timeout: left(until)) != nil {
            }
        } catch _ {
        }
        close-code ?= code
        __finish()
    }

    __drop__() {
        close()
    }

    __str__() -> String {
        "<WebSocket {response.url}{__closed? ? ' closed' : ''}>"
    }
}

let default-lock = Mutex()
let default-client: Client | nil = nil

const CLIENT_OPTIONS = %[
    'baseUrl', 'verify', 'cert', 'http1', 'http2', 'proxy', 'trustEnv', 'limits',
    'retries', 'uds', 'localAddress', 'transport', 'mounts', 'eventHooks',
    'userAgent', 'decode', 'maxResponseSize', 'raiseForStatus', 'trace', 'retry'
]

fn shared() -> Client {
    let ^_ = default-lock.lock()
    default-client ?? (default-client = Client())
}

/// Sends one request. Request keywords are those of `Client.request`;
/// client keywords (`verify`, `http2`, `proxy`, ...) create a one-off client,
/// otherwise a shared pooled client is used.
pub fn request(method: String, url: String | URL, %kwargs) -> Response {
    let client-opts = kwargs & CLIENT_OPTIONS
    let req-opts    = kwargs - CLIENT_OPTIONS
    if #client-opts == 0 {
        return shared().request(method, url, **req-opts)
    }
    let cl = Client(**client-opts)
    let rsp = try {
        cl.request(method, url, **req-opts)
    } catch e {
        cl.close()
        throw e
    }
    if rsp.closed? || rsp.read? {
        cl.close()
    } else {
        rsp.on-close(-> cl.close())
    }
    rsp
}

pub fn get(url: String | URL, %kwargs) -> Response     { request('GET', url, **kwargs) }
pub fn head(url: String | URL, %kwargs) -> Response    { request('HEAD', url, **kwargs) }
pub fn options(url: String | URL, %kwargs) -> Response { request('OPTIONS', url, **kwargs) }
pub fn post(url: String | URL, %kwargs) -> Response    { request('POST', url, **kwargs) }
pub fn put(url: String | URL, %kwargs) -> Response     { request('PUT', url, **kwargs) }
pub fn patch(url: String | URL, %kwargs) -> Response   { request('PATCH', url, **kwargs) }
pub fn delete(url: String | URL, %kwargs) -> Response  { request('DELETE', url, **kwargs) }

pub fn stream(method: String, url: String | URL, %kwargs) -> Response {
    request(method, url, stream: true, **kwargs)
}

pub fn download(url: String | URL, path: String | Path | nil = nil, %kwargs) -> Path {
    shared().download(url, path, **kwargs)
}

pub fn events(url: String | URL, %kwargs) -> Chunks[Event] {
    shared().events(url, **kwargs)
}

/// Opens a WebSocket; see `Client.websocket`. Client keywords (`verify`,
/// `proxy`, ...) apply to this connection alone.
pub fn websocket(url: String | URL, %kwargs) -> WebSocket {
    let client-opts = kwargs & CLIENT_OPTIONS
    let ws-opts     = kwargs - CLIENT_OPTIONS
    if #client-opts == 0 {
        return shared().websocket(url, **ws-opts)
    }
    let cl = Client(**client-opts)
    try {
        cl.websocket(url, **ws-opts)
    } finally {
        cl.close()
    }
}
