/**
 * HTTP content codings: gzip, deflate, br and zstd. zlib and zstd are built
 * in; brotli is used when its libraries load (`available()` lists what is
 * usable). The server and client compress and decode in the native core;
 * these are the same codecs for direct use.
 */
import _codec as z

pub ZLIB_VERSION = z.zlib-version()

const RUN_TOO_BIG = -2

const DEFAULT_LEVELS = %{'gzip': 6, 'x-gzip': 6, 'deflate': 6, 'raw-deflate': 6, 'br': 4, 'zstd': 3}

pub class CodecError < RuntimeError {
    coding:   String
    too-big?: Bool

    init(coding: String, what: String, too-big?: Bool = false) {
        self.coding   = coding
        self.too-big? = too-big?
        super("{coding}: {what}")
    }
}

/// Content codings usable in this process, most preferred first.
pub fn available() -> Array[String] {
    z.has?('brotlidec') ? ['zstd', 'br', 'gzip', 'deflate'] : ['zstd', 'gzip', 'deflate']
}

pub fn supported?(coding: String) -> Bool {
    match coding {
        /^(?:x-gzip|gzip|deflate|identity|zstd)$/i => true,
        /^br$/i                                    => z.has?('brotlidec'),
        _                                          => false
    }
}

pub fn encodable?(coding: String) -> Bool {
    match coding {
        /^(?:x-gzip|gzip|deflate|identity|zstd)$/i => true,
        /^br$/i                                    => z.has?('brotlienc'),
        _                                          => false
    }
}

/// An `Accept-Encoding` value covering every available coding.
pub fn accept-encoding() -> String {
    z.has?('brotlidec') ? 'gzip, deflate, br, zstd' : 'gzip, deflate, zstd'
}

fn open(coding: String, encode: Bool, level: Int = 0) -> Ptr {
    match z.open(coding.lower(), encode, level) {
        p: Ptr => p,
        why    => throw CodecError(coding, why)
    }
}

/// Incremental decoder: `feed` returns the output its input produced and
/// `finish` checks that the stream ended cleanly. Output beyond `limit`
/// bytes throws `CodecError` with `too-big?` set.
pub class Decoder {
    coding: String
    limit:  Int | nil

    __z: Ptr

    init(coding: String, limit: Int | nil = nil) {
        self.coding = coding
        self.limit  = limit
        __z         = open(coding, false)
    }

    feed(data: String | Blob) -> Blob {
        let out = Blob()
        match z.run(__z, data, out, 0, limit ?? -1) {
            0           => out,
            RUN_TOO_BIG => throw CodecError(coding, "decoded body exceeds {limit} bytes", true),
            _           => throw CodecError(coding, z.message(__z))
        }
    }

    finish() -> Blob {
        if !z.finish(__z) {
            throw CodecError(coding, 'truncated stream')
        }
        Blob()
    }

    reset() {
        z.reset(__z)
    }

    close() {
        z.close(__z)
    }
}

/// Incremental encoder: `write` returns compressed output produced so far
/// (`flush: true` forces everything out), `finish` ends the stream.
pub class Encoder {
    coding: String
    level:  Int

    __z: Ptr

    init(coding: String, level: Int | nil = nil) {
        self.coding = coding
        self.level  = level ?? DEFAULT_LEVELS[coding.lower()] ?? 0
        __z         = open(coding, true, self.level)
    }

    __run(data: String | Blob | nil, op: Int) -> Blob {
        let out = Blob()
        if z.run(__z, data, out, op) != 0 {
            throw CodecError(coding, z.message(__z))
        }
        out
    }

    write(data: String | Blob, flush: Bool = false) -> Blob {
        __run(data, flush ? 1 : 0)
    }

    finish() -> Blob {
        let out = __run(nil, 2)
        z.close(__z)
        out
    }

    reset() {
        z.reset(__z)
    }

    close() {
        z.close(__z)
    }
}

/// Decodes `data` encoded with `coding`, a `Content-Encoding` list applied
/// in reverse order.
pub fn decode(coding: String, data: String | Blob, limit: Int | nil = nil) -> Blob {
    let out = (data :: Blob) ? data : Blob(data)
    for name in coding.matches(/[^\s,]+/).reverse() {
        if name.ieq?('identity') {
            continue
        }
        let d = Decoder(name, limit)
        try {
            out = d.feed(out)
            d.finish()
        } finally {
            d.close()
        }
    }
    out
}

pub fn encode(coding: String, data: String | Blob, level: Int | nil = nil) -> Blob {
    if coding.ieq?('identity') {
        return (data :: Blob) ? data : Blob(data)
    }
    let e = Encoder(coding, level)
    let out = e.write(data)
    out.push(e.finish())
    out
}

/// Picks the best coding the peer accepts (an `Accept-Encoding` value) out
/// of `offered`, honoring q-values; nil when only identity is acceptable.
pub fn negotiate(accept: String | nil, offered: Array[String] = ['zstd', 'br', 'gzip']) -> String | nil {
    let $text = accept or return nil
    let q = %{}
    for part in text.split(',') {
        let bits = part.split(';').map(\_.strip())
        let name = bits[0].lower()
        if name == '' {
            continue
        }
        let weight = 1.0
        for b in bits.drop(1) {
            if let [_, v] = b.match(/^q\s*=\s*([0-9.]+)$/i) {
                weight = (try { float(v) }) ?? 0.0
            }
        }
        q[name] = weight
    }
    let best = nil
    let best-q = 0.0
    for name in offered {
        let w = q[name] ?? q['*'] ?? 0.0
        if encodable?(name) && w > best-q {
            best = name
            best-q = w
        }
    }
    best
}
