import http.codec as codec (CodecError)

const TAIL = Blob(0x00, 0x00, 0xFF, 0xFF)

pub class DeflateError < RuntimeError {
    too-big?: Bool

    init(what: String, too-big?: Bool = false) {
        self.too-big? = too-big?
        super("permessage-deflate: {what}")
    }
}

/// Per-connection permessage-deflate state (RFC 7692) negotiated with
/// no_context_takeover in both directions, so each message is independent.
pub class PerMessage {
    level: Int = 6

    __def: codec.Encoder | nil
    __inf: codec.Decoder | nil

    compress(data: String | Blob) -> Blob {
        let e = match __def {
            nil => (__def = codec.encoder('raw-deflate', level)),
            e   => do { e.reset(); e }
        }
        let out = try {
            e.write(data, flush: true)
        } catch err: CodecError {
            throw DeflateError(str(err))
        }
        let n = #out
        if n >= 4 && out[n - 4] == 0 && out[n - 3] == 0 && out[n - 2] == 0xFF && out[n - 1] == 0xFF {
            out.clear(n - 4)
        }
        out
    }

    decompress(data: String | Blob, limit: Int) -> Blob {
        let d = match __inf {
            nil => (__inf = codec.decoder('raw-deflate', limit)!),
            d   => do { d.reset(); d }
        }
        d.limit = limit
        try {
            let out = d.feed(data)
            out.push(d.feed(TAIL))
        } catch err: CodecError {
            throw DeflateError(str(err), err.too-big?)
        }
    }

    close() {
        if let $e = __def {
            __def = nil
            e.close()
        }
        if let $d = __inf {
            __inf = nil
            d.close()
        }
    }
}

/// Picks a response for the client's Sec-WebSocket-Extensions offer, or nil.
pub fn negotiate(offer: String | nil) -> String | nil {
    let $text = offer or return nil
    for ext in text.split(',') {
        let parts = ext.split(';').map(\_.strip())
        if parts[0] != 'permessage-deflate' {
            continue
        }
        let ok = true
        for p in parts.drop(1) {
            let name = p.split('=')[0].strip()
            match name {
                'server_no_context_takeover', 'client_no_context_takeover', 'client_max_window_bits' => {},
                'server_max_window_bits' => {
                    let v = (p.split('=') + [''])[1].strip().comb('"')
                    if v != '15' {
                        ok = false
                    }
                },
                _ => {
                    ok = false
                }
            }
        }
        if ok {
            return 'permessage-deflate; server_no_context_takeover; client_no_context_takeover'
        }
    }
    nil
}
