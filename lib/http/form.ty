import path (Path)
import ssl

pub const MIME: Dict[String, String] = %{
    'html':  'text/html; charset=utf-8',
    'htm':   'text/html; charset=utf-8',
    'css':   'text/css; charset=utf-8',
    'js':    'text/javascript; charset=utf-8',
    'mjs':   'text/javascript; charset=utf-8',
    'json':  'application/json',
    'map':   'application/json',
    'xml':   'application/xml',
    'txt':   'text/plain; charset=utf-8',
    'md':    'text/markdown; charset=utf-8',
    'csv':   'text/csv; charset=utf-8',
    'svg':   'image/svg+xml',
    'png':   'image/png',
    'jpg':   'image/jpeg',
    'jpeg':  'image/jpeg',
    'gif':   'image/gif',
    'webp':  'image/webp',
    'avif':  'image/avif',
    'ico':   'image/x-icon',
    'bmp':   'image/bmp',
    'woff':  'font/woff',
    'woff2': 'font/woff2',
    'ttf':   'font/ttf',
    'otf':   'font/otf',
    'wasm':  'application/wasm',
    'pdf':   'application/pdf',
    'zip':   'application/zip',
    'gz':    'application/gzip',
    'tar':   'application/x-tar',
    'mp3':   'audio/mpeg',
    'ogg':   'audio/ogg',
    'wav':   'audio/wav',
    'mp4':   'video/mp4',
    'webm':  'video/webm',
    'webmanifest': 'application/manifest+json'
}

pub fn mime-of(path: String) -> String {
    let base = path.split('/')[-1]
    match base.searchr('.') {
        nil => 'application/octet-stream',
        i   => MIME[base.slice(i + 1).lower()] ?? 'application/octet-stream'
    }
}


pub use HttpHeaders = Dict[String, String | [String]]
pub use HttpStatus  = {code: Int, text: String}
pub use HttpVersion = {major: Int, minor: Int}

pub tag MultipartData;
pub tag MultipartMore;
pub tag MultipartError;

pub fn multipart*(boundary: String) {
    let files = %{}
    let form  = %{}
    let buf   = Blob()

    let separator = "\r\n--{boundary}"
    let initial   = separator + 2

    let name     = nil
    let data     = nil
    let ^file    = nil
    let path     = nil
    let filename = nil
    let mime     = nil

    fn commit(chunk: Blob) {
        if file != nil {
            file.write(chunk)
        } else if data != nil {
            data.push(chunk)
        } else if #chunk != 0 {
            yield MultipartError
        }
    }

    fn next-line() -> _ {
        for (;;) {
            while #buf < 2 {
                buf.push(yield MultipartMore)
            }
            if let $i = buf.search('\r\n') {
                let line = buf.splice(0, i + 2).str!().trim()
                return line ?: line
            } else {
                commit(buf.splice(0, max(0, #buf - 2)))
            }
        }
    }

    fn seek(token) -> _ {
        let size = token.size()
        for (;;) {
            while #buf < size + 2 {
                buf.push(yield MultipartMore)
            }
            if let $i = buf.search(token) {
                commit(buf.splice(0, i))
                let end = buf.str!(size, 2)
                buf.clear(0, size + 2)
                return end
            } else {
                commit(buf.splice(0, #buf - size))
            }
        }
    }

    fn part() {
        while let $line = next-line() {
            if not let [k, v] = line.split(': ', 1) {
                yield MultipartError
            }
            match k.lower() {
                'content-disposition' => {
                    let disposition: Dict[String, String] = %{k: v for [_, k, v] in v.scan(/(\w+)="([^"]+)"/)}

                    name     = disposition['name']
                    filename = disposition['filename']

                    if name == nil {
                        yield MultipartError
                    }

                    if filename != nil {
                        path = Path.tmp().mktemp('upload')
                        file = path.open('w+')
                    } else {
                        data = Blob()
                    }
                },

                'content-type' => {
                    mime = v
                },

                _ => {
                    yield MultipartError
                }
            }
        }

        let end = seek(separator)

        if file != nil {
            file.close()
            files[name] = {
                name:     filename,
                type:     mime,
                path:     path
            }
            file     = nil
            filename = nil
            path     = nil
            mime     = nil
            name     = nil
        } else if data != nil {
            form[name] = data.str!()
            data       = nil
            name       = nil
        } else {
            yield MultipartError
        }

        end != '--'
    }

    if seek(initial) != '--' {
        while part() {
            ;
        }
    }

    yield MultipartData(form, files)
}

pub fn urldecode(s: String) -> String {
    s.sub('+', ' ')
     .sub(/%[[:xdigit:]]{2}/, \chr(int(_[1;], 16)))
     .sub('\r\n', '\n')
     .sub('\r', '\n')
}

pub fn decode-query(query: String) -> Dict[String, String | Array[String | nil] | nil] {
    let params = %{}

    for [k, ?v] in query.split('&').map(p -> p.split('=', 1).map!(urldecode)) {
        match params[k] {
            nil         => { params[k] = v        },
            one: String => { params[k] = [one, v] },
            many        => { many.push(v)         }
        }
    }

    params
}

pub fn urlencode(s: String) -> String {
    s.sub(/[^A-Za-z0-9\-._~]/, (c: String) -> [*Blob(c)].map(b -> "%{b:02X}").join(''))
}

pub fn encode-query(params: Dict[String, _]) -> String {
    [ "{urlencode(str(k))}={urlencode(str(v))}" for k, v in params ].join('&')
}

/// Decodes %XX escapes only (no `+` → space), for URL paths.
pub fn percent-decode(s: String) -> String {
    if !s.contains?('%') {
        return s
    }
    let out = Blob()
    let b = Blob(s)
    let i = 0
    while i < #b {
        let c = b[i]
        if c == 37 && i + 2 < #b {
            let h = s.bslice(i + 1, 2)
            if h.match?(/^[0-9A-Fa-f]{2}$/) {
                out.push(int(h, 16))
                i += 3
                continue
            }
        }
        out.push(c)
        i += 1
    }
    out.str!()
}

fn quote-param(s: String) -> String {
    s.sub(/["\\\r\n]/, c -> (c == '"') ? '%22' : ((c == '\\') ? '\\\\' : ' '))
}

pub fn multipart-boundary() -> String {
    "ty-{ssl.random-bytes(16).hex()}"
}

/// One file part of a multipart/form-data body. `content` is a String,
/// Blob or `Path` (read when the body is encoded).
pub class FilePart {
    filename:     String
    content:      String | Blob | Path
    content-type: String
    headers:      Dict[String, String]

    init(content: String | Blob | Path, filename: String | nil = nil, content-type: String | nil = nil, headers: Dict[String, String] = %{}) {
        self.content      = content
        self.filename     = filename ?? match content {
            p: Path => p.name,
            _       => 'file'
        }
        self.content-type = content-type ?? mime-of(self.filename)
        self.headers      = headers
    }

    /// Accepts the shapes `files:` takes: a FilePart, a Path, a
    /// `(filename, content)` / `(filename, content, type)` tuple, or a
    /// record `{filename, content, content-type}`.
    static of(x: _) -> FilePart {
        match x {
            f: FilePart          => f,
            p: Path              => FilePart(p),
            (name, data)         => FilePart(data, name),
            (name, data, type)   => FilePart(data, name, type),
            {content, *rest}     => FilePart(content, rest.?filename, rest.?content-type),
            data: String | Blob  => FilePart(data),
            other                => throw ValueError("http: cannot use {other} as a file part")
        }
    }

    bytes() -> Blob {
        match content {
            p: Path   => p.read-bytes(),
            b: Blob   => b,
            s: String => Blob(s)
        }
    }
}

/// Encodes `fields` (name → value or array of values) and `files`
/// (name → anything `FilePart.of` accepts, or an array of them) as
/// multipart/form-data. Returns the body and its Content-Type.
pub fn encode-multipart(fields: _ = nil, files: _ = nil, boundary: String = multipart-boundary()) -> (Blob, String) {
    let out = Blob()
    let pairs = fn (x: _) -> Array {
        match x {
            nil      => [],
            d: Dict  => d.list(),
            a: Array => a,
            r        => members(r).list()
        }
    }

    for (k, v) in pairs(fields) {
        for one in ((v :: Array) ? v : [v]) {
            out.push("--{boundary}\r\nContent-Disposition: form-data; name=\"{quote-param(str(k))}\"\r\n\r\n")
            out.push((one :: Blob) ? one : str(one))
            out.push('\r\n')
        }
    }

    for (k, v) in pairs(files) {
        for one in ((v :: Array) ? v : [v]) {
            let f = FilePart.of(one)
            out.push("--{boundary}\r\nContent-Disposition: form-data; name=\"{quote-param(str(k))}\"; filename=\"{quote-param(f.filename)}\"\r\n")
            out.push("Content-Type: {f.content-type}\r\n")
            for hk, hv in f.headers {
                out.push("{hk}: {hv}\r\n")
            }
            out.push('\r\n')
            out.push(f.bytes())
            out.push('\r\n')
        }
    }

    out.push("--{boundary}--\r\n")
    (out, "multipart/form-data; boundary={boundary}")
}
