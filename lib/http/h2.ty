import log
import http.core (
    BodyWriter,
    BodyQueue,
    HttpError,
    EventStream,
    Response,
    ConnectionClosed,
    Task,
    task,
    suspend
)
import http.wire (Request)
import http.loop (Conn, Loop, LoopExchange, Host, Proto, READ)
import http.nghttp2 (..)

class Stream {
    id:          Int
    method:      String | nil
    path:        String | nil
    scheme:      String | nil
    authority:   String | nil
    headers:     Dict[String, String | Array[String]] = %{}
    head-size:   Int = 0
    body:        Blob | nil
    dispatched?: Bool = false
    rejected?:   Bool = false
    closed?:     Bool = false
    out:         Blob = Blob()
    pos:         Int = 0
    eof?:        Bool = false
    deferred?:   Bool = false
    submitted?:  Bool = false
    x:           H2Exchange | nil
    queue:       BodyQueue | nil

    pending -> Int {
        #out - pos
    }

    /// Hands nghttp2 up to `max` bytes (see `_http`'s `cb-read`). The bytes
    /// are copied after this returns, so consumed data is dropped on the
    /// next call instead of now.
    take(max: Int) -> (Blob, Int, Int, Bool) | Int {
        if pos == #out {
            out.clear()
            pos = 0
        } else if pos > 65536 && pos * 2 > #out {
            out.clear(0, pos)
            pos = 0
        }
        let n = min(max, pending)
        if n == 0 && !eof? {
            deferred? = true
            return NGHTTP2_ERR_DEFERRED
        }
        let at = pos
        pos += n
        (out, at, n, eof? && pos == #out)
    }
}

fn header-list(rsp: Response | nil, status: Int, length: Int | nil, date: String, server-name: String | nil) -> Array[(String, String)] {
    let pairs = [(':status', str(status)), ('date', date)]

    if server-name != nil {
        pairs.push(('server', server-name))
    }

    if let $r = rsp {
        if r.content-type != nil && !BODILESS.contains?(status) {
            pairs.push(('content-type', r.content-type))
        }
        for k, v in r.headers {
            let name = k.lower()
            if HOP_BY_HOP.contains?(name) || name == 'content-length' || name == 'date' {
                continue
            }
            match v {
                s: String => pairs.push((name, s)),
                vs        => for s in vs { pairs.push((name, s)) }
            }
        }
    }

    if length != nil && !BODILESS.contains?(status) {
        pairs.push(('content-length', str(length)))
    }

    pairs
}

pub class H2Exchange : LoopExchange {
    proto:   H2
    stream:  Stream

    __request: Request
    __closed?: Bool = false
    __writer:  BodyWriter | nil
    __closers: Array[() -> _] | nil
    __waiting: Array[Task] | nil
    __drain:   Array[Task] | nil

    init(proto: H2, stream: Stream, request: Request) {
        self.proto  = proto
        self.stream = stream
        __request   = request
    }

    loop -> Loop {
        proto.conn.loop
    }

    request -> Request {
        __request
    }

    closed? -> Bool {
        __closed?
    }

    protocol -> String {
        'HTTP/2'
    }

    buffered -> Int {
        stream.pending + proto.conn.buffered
    }

    start(rsp: Response) {
        if closed? {
            throw ConnectionClosed('stream closed')
        }
        let head? = request.method == 'HEAD'
        if head? {
            stream.eof? = true
        }
        proto.submit(stream, rsp, rsp.status-code, rsp.stream-length, !head?)
    }

    has-writer? -> Bool {
        __writer != nil
    }

    complete(rsp: Response) {
        if closed? {
            return
        }
        let code = rsp.status-code
        let head? = request.method == 'HEAD'
        let body? = !head? && !BODILESS.contains?(code) && code >= 200 && #rsp.body > 0
        if body? {
            stream.out.push(rsp.body)
        }
        stream.eof? = true
        proto.submit(stream, rsp, code, BODILESS.contains?(code) ? nil : #rsp.body, body?)
    }

    writer() -> BodyWriter {
        __writer ?? (__writer = BodyWriter(self))
    }

    events() -> EventStream {
        match __writer {
            es: EventStream => es,
            _               => (__writer = EventStream(self))
        }
    }

    send(data: String | Blob) {
        if closed? || stream.eof? || request.method == 'HEAD' {
            return
        }
        stream.out.push(data)
        proto.resume(stream)
    }

    end() {
        if closed? || stream.eof? {
            return
        }
        stream.eof? = true
        proto.resume(stream)
    }

    abort() {
        proto.reset(stream, NGHTTP2_INTERNAL_ERROR)
    }

    wait-drain(below: Int = -1) {
        let limit = (below < 0) ? proto.conn.config.write-high-water / 2 : below
        while !closed? && buffered > limit {
            match __drain {
                nil => __drain = [task()!],
                xs  => xs.push(task()!)
            }
            suspend()
        }
        if closed? {
            throw ConnectionClosed('stream closed')
        }
    }

    drained() {
        if let $ws = __drain {
            __drain = nil
            for t in ws {
                proto.conn.loop.resume(t)
            }
        }
    }

    wait-closed() {
        while !closed? {
            match __waiting {
                nil => __waiting = [task()!],
                xs  => xs.push(task()!)
            }
            suspend()
        }
    }

    on-close(f: () -> _) {
        if closed? {
            f()
        } else {
            match __closers {
                nil => __closers = [f],
                xs  => xs.push(f)
            }
        }
    }

    closed() {
        if __closed? {
            return
        }
        __closed? = true

        if let $cs = __closers {
            __closers = nil
            for f in cs {
                try {
                    f()
                } catch e {
                    log::error!("error in on-close callback", err: e)
                }
            }
        }

        if let $ws = __waiting {
            __waiting = nil
            for t in ws {
                proto.conn.loop.resume(t)
            }
        }

        if let $ws = __drain {
            __drain = nil
            for t in ws {
                proto.conn.loop.resume(t)
            }
        }
    }
}

pub class H2 : Proto {
    conn:   Conn
    server: Host

    __session:  Ptr | nil
    __streams:  Dict[Int, Stream] = %{}
    __pumping?: Bool = false
    __out:      Blob = Blob()
    __goaway?:  Bool = false
    __dead?:    Bool = false

    init(conn: Conn, server: Host) {
        self.conn   = conn
        self.server = server
        let s       = h2-new(true)
        __session   = s

        let cfg = conn.config
        h2-settings(s, [
            SETTINGS_MAX_CONCURRENT_STREAMS, cfg.h2-max-concurrent-streams,
            SETTINGS_INITIAL_WINDOW_SIZE,    cfg.h2-initial-window,
            SETTINGS_MAX_HEADER_LIST_SIZE,   cfg.max-header-size,
            SETTINGS_MAX_FRAME_SIZE,         max(16384, min(cfg.h2-max-frame, 16777215))
        ])

        let window = max(cfg.h2-initial-window * 4, 65535)
        h2-local-window(s, min(window, 0x7FFFFFFF))

        conn.timeout(READ, cfg.idle-timeout)
        __schedule()
    }

    __schedule() {
        if !__pumping? && !__dead? {
            __pumping? = true
            conn.loop.later(-> __pump())
        }
    }

    __pump() {
        __pumping? = false

        if __dead? || conn.closing? {
            return
        }

        let s = __session ?? return
        let high = conn.config.write-high-water

        while conn.buffered < high {
            let n = h2-send(s, self, __out, high - conn.buffered)
            if n < 0 {
                log::debug!("nghttp2_session_mem_send failed", error: strerror(n))
                return conn.close()
            }
            if n == 0 {
                break
            }
            conn.write(__out)
            __out.clear()
        }

        for _, st in __streams {
            if let $x = st.x {
                if x.buffered <= high / 2 {
                    x.drained()
                }
            }
        }

        if !h2-want-read(s) && !h2-want-write(s) {
            __dead? = true
            return conn.close-after-flush()
        }

        if !conn.reading? && !conn.eof? {
            conn.want-read()
        }
    }

    __idle() {
        if #__streams == 0 {
            conn.timeout(READ, conn.config.idle-timeout)
        } else {
            conn.untimeout(READ)
        }
    }

    cb-begin(id: Int, cat: Int) -> Int {
        if cat != NGHTTP2_HCAT_REQUEST {
            return 0
        }
        __streams[id] = Stream(id)
        __idle()
        0
    }

    cb-header(id: Int, k: String, v: String) -> Int {
        let $st = __streams[id] or return 0

        st.head-size += k.size() + v.size() + 32
        if st.head-size > conn.config.max-header-size {
            return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE
        }

        match k {
            ':method'    => st.method = v,
            ':path'      => st.path = v,
            ':scheme'    => st.scheme = v,
            ':authority' => st.authority = v,
            _ => {
                if #st.headers >= conn.config.max-headers && st.headers[k] == nil {
                    return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE
                }
                match st.headers[k] {
                    nil               => st.headers[k] = v,
                    vs: Array[String] => vs.push(v),
                    one               => st.headers[k] = [one, v]
                }
            }
        }

        0
    }

    cb-chunk(id: Int, data: Ptr, len: Int) -> Int {
        let $st = __streams[id] or return 0
        if st.rejected? {
            return 0
        }
        if let $q = st.queue {
            if q.total + len > conn.config.max-body-size {
                q.fail(HttpError(413))
                st.rejected? = true
                reset(st, NGHTTP2_CANCEL)
                return 0
            }
            q.push-raw(data, len)
            return 0
        }
        let body = st.body ?? (st.body = Blob())
        if #body + len > conn.config.max-body-size {
            st.rejected? = true
            st.body = nil
            __reject(st, 413)
            return 0
        }
        body.push(data, len)
        0
    }

    cb-frame(id: Int, type: Int, flags: Int, aux: Int) -> Int {
        if type != NGHTTP2_HEADERS && type != NGHTTP2_DATA {
            return 0
        }
        let end? = (flags & NGHTTP2_FLAG_END_STREAM) != 0
        let $st = __streams[id] or return 0

        if let $q = st.queue {
            if end? {
                q.finish()
            }
            return 0
        }

        if !end? {
            if (
                type == NGHTTP2_HEADERS
             && !st.dispatched?
             && server.streams?
             && st.method != nil
             && server.streaming-route?(st.method ?? '', __path-of(st))
            ) {
                st.dispatched? = true
                st.queue = BodyQueue(conn.loop, -> nil)
                __dispatch(st)
            }
            return 0
        }

        if !st.dispatched? && !st.rejected? {
            st.dispatched? = true
            __dispatch(st)
        }
        0
    }

    cb-close(id: Int, code: Int) -> Int {
        if let $st = __streams[id] {
            __streams.remove(id)
            st.closed? = true
            if let $q = st.queue {
                if !q.complete? {
                    q.fail(ConnectionClosed('stream reset'))
                }
            }
            if let $x = st.x {
                x.closed()
            }
            __idle()
        }
        if __goaway? && #__streams == 0 {
            __schedule()
        }
        0
    }

    cb-read(id: Int, max: Int) -> (Blob, Int, Int, Bool) | Int {
        let $st = __streams[id] or return NGHTTP2_ERR_CALLBACK_FAILURE
        st.take(max)
    }

    __reject(st: Stream, status: Int) {
        st.eof? = true
        submit(st, nil, status, 0, false)
    }

    __path-of(st: Stream) -> String {
        let p = st.path ?? '/'
        match p.bsearch('?') {
            nil => p,
            i   => p.bslice(0, i)
        }
    }

    __dispatch(st: Stream) {
        if st.method == nil || (st.path == nil && st.method != 'CONNECT') {
            return reset(st, NGHTTP2_PROTOCOL_ERROR)
        }

        if let $authority = st.authority {
            if st.headers['host'] == nil {
                st.headers['host'] = authority
            }
        }

        let body = match st.body {
            nil => nil,
            b   => b.str!()
        }

        let req = Request.h2(
            st.method ?? 'GET',
            st.path ?? '/',
            st.headers,
            body,
            st.scheme ?? ((conn.tls != nil) ? 'https' : 'http')
        )

        if !req.valid? {
            return __reject(st, 400)
        }

        if let $q = st.queue {
            req.attach-body(q)
        }

        req.remote = conn.peer
        conn.requests += 1

        let x = H2Exchange(self, st, req)
        st.x = x
        conn.loop.spawn("{req.method} {req.url}", server.serve, x, req)
    }

    submit(st: Stream, rsp: Response | nil, status: Int, length: Int | nil, body?: Bool) {
        let $s = __session or return
        if st.closed? || st.submitted? {
            return
        }
        st.submitted? = true

        let pairs = header-list(rsp, status, length, conn.loop.date, conn.config.server-name)

        let rc = h2-response(s, st.id, pairs, body?)
        if rc != 0 {
            log::debug!("nghttp2_submit_response failed", error: strerror(rc))
            return reset(st, NGHTTP2_INTERNAL_ERROR)
        }

        __schedule()
    }

    resume(st: Stream) {
        let $s = __session or return
        if st.closed? {
            return
        }
        if st.deferred? {
            st.deferred? = false
            h2-resume(s, st.id)
        }
        __schedule()
    }

    reset(st: Stream, code: Int) {
        let $s = __session or return
        if st.closed? {
            return
        }
        h2-rst(s, st.id, code)
        __schedule()
    }

    on-data() {
        let s = __session ?? return

        if conn.available > 0 {
            let n = h2-recv(s, self, conn.buf, conn.head, conn.available)
            if n < 0 {
                log::debug!("nghttp2_session_mem_recv failed", error: strerror(n))
                __pump()
                return conn.close-after-flush()
            }
            conn.consume(n)
        }

        __schedule()
    }

    on-eof() {
        conn.close()
    }

    on-drain() {
        __schedule()
    }

    on-timeout(which: Int) {
        if #__streams == 0 {
            on-shutdown()
            conn.loop.later(-> conn.close-after-flush())
        } else {
            conn.close()
        }
    }

    on-shutdown() {
        let $s = __session or return
        if __goaway? {
            return
        }
        __goaway? = true
        h2-goaway(s, NGHTTP2_NO_ERROR)
        __schedule()
        if #__streams == 0 {
            conn.loop.later(-> conn.close-after-flush())
        }
    }

    on-close() {
        __dead? = true
        for _, st in __streams {
            st.closed? = true
            if let $x = st.x {
                x.closed()
            }
        }
        __streams = %{}
        if let $s = __session {
            __session = nil
            h2-del(s)
        }
    }
}

pub fn session(conn: Conn, server: Host) -> H2 {
    H2(conn, server)
}
