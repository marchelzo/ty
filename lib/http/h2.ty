import ffi as c (C!)
import log
import http.core (
    BodyWriter,
    BodyQueue,
    HttpError,
    EventStream,
    Response,
    Raise,
    ConnectionClosed,
    task,
    suspend,
    this-loop
)
import http.wire (Request)
import http.loop (Conn, Loop, READ, WRITE)

#|if __apple__
const LIBRARIES = [
    '/opt/homebrew/opt/libnghttp2/lib/libnghttp2.14.dylib',
    '/usr/local/opt/libnghttp2/lib/libnghttp2.14.dylib',
    '/opt/homebrew/lib/libnghttp2.14.dylib',
    'nghttp2'
]
#|else
const LIBRARIES = ['nghttp2']
#|]

if not let $libnghttp2 = c.open(LIBRARIES, versions: [14, nil], env: 'TY_LIBNGHTTP2') {
    throw RuntimeError('http.h2: failed to load libnghttp2')
}

C! libnghttp2 fn {
    int nghttp2_session_callbacks_new(void *out);
    void nghttp2_session_callbacks_del(void *cbs);
    void nghttp2_session_callbacks_set_on_begin_headers_callback(void *cbs, void *cb);
    void nghttp2_session_callbacks_set_on_header_callback(void *cbs, void *cb);
    void nghttp2_session_callbacks_set_on_frame_recv_callback(void *cbs, void *cb);
    void nghttp2_session_callbacks_set_on_data_chunk_recv_callback(void *cbs, void *cb);
    void nghttp2_session_callbacks_set_on_stream_close_callback(void *cbs, void *cb);
    int nghttp2_option_new(void *out);
    void nghttp2_option_del(void *opt);
    void nghttp2_option_set_max_settings(void *opt, uint64_t n);
    int nghttp2_session_server_new2(void *out, void *cbs, void *user, void *opt);
    void nghttp2_session_del(void *session);
    long nghttp2_session_mem_recv(void *session, void const *data, uint64_t len);
    long nghttp2_session_mem_send(void *session, void *out);
    int nghttp2_submit_settings(void *session, uint8_t flags, void const *iv, uint64_t niv);
    int nghttp2_submit_response(void *session, int32_t id, void const *nva, uint64_t nvlen, void const *prd);
    int nghttp2_submit_rst_stream(void *session, uint8_t flags, int32_t id, uint32_t code);
    int nghttp2_submit_goaway(void *session, uint8_t flags, int32_t last, uint32_t code, void const *data, uint64_t len);
    int nghttp2_session_resume_data(void *session, int32_t id);
    int nghttp2_session_want_read(void *session);
    int nghttp2_session_want_write(void *session);
    int32_t nghttp2_session_get_last_proc_stream_id(void *session);
    int nghttp2_session_set_local_window_size(void *session, uint8_t flags, int32_t id, int32_t size);
    char const *nghttp2_strerror(int code);
}

C! fn {
    void *memcpy(void *dst, void const *src, uint64_t n);
}

const NGHTTP2_DATA    = 0x0
const NGHTTP2_HEADERS = 0x1

const NGHTTP2_FLAG_END_STREAM = 0x1
const NGHTTP2_DATA_FLAG_EOF   = 0x1
const NGHTTP2_HCAT_REQUEST    = 0

const NGHTTP2_NO_ERROR       = 0x0
const NGHTTP2_PROTOCOL_ERROR = 0x1
const NGHTTP2_INTERNAL_ERROR = 0x2
const NGHTTP2_CANCEL         = 0x8

const NGHTTP2_ERR_DEFERRED                  = -508
const NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE = -521
const NGHTTP2_ERR_CALLBACK_FAILURE          = -902

const SETTINGS_MAX_CONCURRENT_STREAMS = 3
const SETTINGS_INITIAL_WINDOW_SIZE    = 4
const SETTINGS_MAX_FRAME_SIZE         = 5
const SETTINGS_MAX_HEADER_LIST_SIZE   = 6

const NV_SIZE = 40

const BODILESS = %{204, 304}

fn frame-id(f: Ptr) -> Int    { c.load(c.i32, f + 8) }
fn frame-type(f: Ptr) -> Int  { c.load(c.u8, f + 12) }
fn frame-flags(f: Ptr) -> Int { c.load(c.u8, f + 13) }
fn frame-cat(f: Ptr) -> Int   { c.load(c.i32, f + 56) }

fn session-of(user: Ptr | nil) -> H2 | nil {
    let $l = this-loop() or return nil
    match l.slot-proto(int(user ?? 0)) {
        h: H2 => h,
        _     => nil
    }
}

class Callbacks {
    cbs:  Ptr
    read: Ptr
    keep: Array[Ptr]

    init() {
        C! closure on-begin(session: c.ptr, frame: c.ptr, user: c.ptr) -> c.int {
            match session-of(user) {
                nil => 0,
                h   => h.cb-begin(frame)
            }
        }

        C! closure on-header(
            session: c.ptr,
            frame: c.ptr,
            name: c.ptr,
            namelen: c.u64,
            value: c.ptr,
            valuelen: c.u64,
            flags: c.u8,
            user: c.ptr
        ) -> c.int {
            match session-of(user) {
                nil => 0,
                h   => h.cb-header(frame, name, namelen, value, valuelen)
            }
        }

        C! closure on-frame(session: c.ptr, frame: c.ptr, user: c.ptr) -> c.int {
            match session-of(user) {
                nil => 0,
                h   => h.cb-frame(frame)
            }
        }

        C! closure on-chunk(
            session: c.ptr,
            flags: c.u8,
            id: c.i32,
            data: c.ptr,
            len: c.u64,
            user: c.ptr
        ) -> c.int {
            match session-of(user) {
                nil => 0,
                h   => h.cb-chunk(id, data, len)
            }
        }

        C! closure on-close(session: c.ptr, id: c.i32, code: c.u32, user: c.ptr) -> c.int {
            match session-of(user) {
                nil => 0,
                h   => h.cb-close(id, code)
            }
        }

        C! closure on-read(
            session: c.ptr,
            id: c.i32,
            buf: c.ptr,
            length: c.u64,
            flags: c.ptr,
            source: c.ptr,
            user: c.ptr
        ) -> c.long {
            match session-of(user) {
                nil => NGHTTP2_ERR_CALLBACK_FAILURE,
                h   => h.cb-read(id, buf, length, flags)
            }
        }

        let out = c.new-auto(c.ptr)
        nghttp2_session_callbacks_new(out)
        cbs = c.load(c.ptr, out)

        nghttp2_session_callbacks_set_on_begin_headers_callback(cbs, on-begin)
        nghttp2_session_callbacks_set_on_header_callback(cbs, on-header)
        nghttp2_session_callbacks_set_on_frame_recv_callback(cbs, on-frame)
        nghttp2_session_callbacks_set_on_data_chunk_recv_callback(cbs, on-chunk)
        nghttp2_session_callbacks_set_on_stream_close_callback(cbs, on-close)

        read = on-read
        keep = [on-begin, on-header, on-frame, on-chunk, on-close, on-read]
    }
}

let __tls::cb-cache: Callbacks | nil = nil

fn callbacks() -> Callbacks {
    cb-cache ?? (cb-cache = Callbacks())
}

class Stream {
    id:          Int
    method:      String | nil
    path:        String | nil
    scheme:      String | nil
    authority:   String | nil
    headers:     Dict[String, String | Array[String]]
    head-size:   Int
    body:        Blob | nil
    dispatched?: Bool
    rejected?:   Bool
    closed?:     Bool
    out:         Blob
    pos:         Int
    eof?:        Bool
    deferred?:   Bool
    submitted?:  Bool
    x:           H2Exchange | nil
    prd:         Blob | nil
    queue:       BodyQueue | nil

    init(id: Int) {
        self.id     = id
        method      = nil
        path        = nil
        scheme      = nil
        authority   = nil
        headers     = %{}
        head-size   = 0
        body        = nil
        dispatched? = false
        rejected?   = false
        closed?     = false
        out         = Blob()
        pos         = 0
        eof?        = false
        deferred?   = false
        submitted?  = false
        x           = nil
        prd         = nil
        queue       = nil
    }

    pending -> Int {
        #out - pos
    }
}

fn header-list(rsp: Response | nil, status: Int, length: Int | nil, date: String, server-name: String | nil) -> (Blob, Int, Blob) {
    let pairs = [(':status', str(status)), ('date', date)]

    if server-name != nil {
        pairs.push(('server', server-name))
    }

    if let $r = rsp {
        if r.content-type != nil && !BODILESS.contains?(status) {
            pairs.push(('content-type', r.content-type))
        }
        for k, v in r.headers {
            let name = k.lower()
            match name {
                'connection', 'transfer-encoding', 'keep-alive', 'upgrade', 'content-length', 'date', 'proxy-connection' => {
                    continue
                },
                _ => {}
            }
            match v {
                s: String => pairs.push((name, s)),
                vs        => for s in vs { pairs.push((name, s)) }
            }
        }
    }

    if length != nil && !BODILESS.contains?(status) {
        pairs.push(('content-length', str(length)))
    }

    let strs = Blob()
    let offs = []
    for (k, v) in pairs {
        offs.push((#strs, k.size(), 0, 0))
        strs.push(k)
        let o = #strs
        strs.push(v)
        offs[-1] = (offs[-1].0, k.size(), o, v.size())
    }
    strs.push(0)

    let nva = Blob.zeros(NV_SIZE * #pairs)
    let base = int(strs.ptr())
    for (ko, kn, vo, vn); i in offs {
        c.pack(nva.ptr() + i * NV_SIZE, '=QQQQB7x', base + ko, base + vo, kn, vn, 0)
    }

    (nva, #pairs, strs)
}

pub class H2Exchange {
    proto:   H2
    stream:  Stream
    request: Request
    closed?: Bool

    __writer:  BodyWriter | nil
    __closers: Array[_]
    __waiting: Array[_]
    __drain:   Array[_]

    init(proto: H2, stream: Stream, request: Request) {
        self.proto   = proto
        self.stream  = stream
        self.request = request
        closed?      = false
        __writer     = nil
        __closers    = []
        __waiting    = []
        __drain      = []
    }

    loop -> _ {
        proto.conn.loop
    }

    protocol -> String {
        'HTTP/2'
    }

    buffered -> Int {
        stream.pending + proto.conn.buffered
    }

    start(rsp: Response) {
        if closed? {
            throw ConnectionClosed('stream closed')
        }
        proto.submit(stream, rsp, rsp.status-code, nil, true)
    }

    complete(rsp: Response) {
        if closed? {
            return
        }
        let code = rsp.status-code
        let head? = request.method == 'HEAD'
        let body? = !head? && !BODILESS.contains?(code) && code >= 200 && #rsp.body > 0
        if body? {
            stream.out.push(rsp.body)
        }
        stream.eof? = true
        proto.submit(stream, rsp, code, BODILESS.contains?(code) ? nil : #rsp.body, body?)
    }

    writer() -> BodyWriter {
        __writer ?? (__writer = BodyWriter(self))
    }

    events() -> EventStream {
        match __writer {
            es: EventStream => es,
            _               => (__writer = EventStream(self))
        }
    }

    send(data: String | Blob) {
        if closed? || stream.eof? || request.method == 'HEAD' {
            return
        }
        stream.out.push(data)
        proto.resume(stream)
    }

    end() {
        if closed? || stream.eof? {
            return
        }
        stream.eof? = true
        proto.resume(stream)
    }

    abort() {
        proto.reset(stream, NGHTTP2_INTERNAL_ERROR)
    }

    wait-drain(below: Int = -1) {
        let limit = (below < 0) ? proto.conn.config.write-high-water / 2 : below
        while !closed? && buffered > limit {
            __drain.push(task()!)
            suspend()
        }
        if closed? {
            throw ConnectionClosed('stream closed')
        }
    }

    drained() {
        if __drain {
            let ws = __drain
            __drain = []
            for t in ws {
                proto.conn.loop.resume(t)
            }
        }
    }

    wait-closed() {
        while !closed? {
            __waiting.push(task()!)
            suspend()
        }
    }

    on-close(f: () -> _) {
        if closed? {
            f()
        } else {
            __closers.push(f)
        }
    }

    closed() {
        if closed? {
            return
        }
        closed? = true

        let cs = __closers
        __closers = []
        for f in cs {
            try {
                f()
            } catch e {
                log::error!("error in on-close callback: {e}")
            }
        }

        let ws = __waiting + __drain
        __waiting = []
        __drain = []
        for t in ws {
            proto.conn.loop.resume(t)
        }
    }
}

pub class H2 {
    conn:   Conn
    server: _

    __session:  Ptr | nil
    __streams:  Dict[Int, Stream]
    __pumping?: Bool
    __out:      Ptr
    __goaway?:  Bool
    __dead?:    Bool

    init(conn: Conn, server: _) {
        self.conn   = conn
        self.server = server
        __streams   = %{}
        __pumping?  = false
        __goaway?   = false
        __dead?     = false
        __out       = c.new-auto(c.ptr)

        let cb  = callbacks()
        let opt = c.new-auto(c.ptr)
        nghttp2_option_new(opt)
        let option = c.load(c.ptr, opt)
        nghttp2_option_set_max_settings(option, 64)

        let out = c.new-auto(c.ptr)
        let ud = c.new-auto(c.u64)
        c.store(c.u64, ud, conn.slot)
        let rc = nghttp2_session_server_new2(out, cb.cbs, c.load(c.ptr, ud), option)
        nghttp2_option_del(option)

        if rc != 0 {
            throw RuntimeError("http.h2: nghttp2_session_server_new2: {c.str(nghttp2_strerror(rc))}")
        }

        __session = c.load(c.ptr, out)

        let cfg = conn.config
        let iv = c.pack(
            Blob(),
            '=8I',
            SETTINGS_MAX_CONCURRENT_STREAMS, cfg.h2-max-concurrent-streams,
            SETTINGS_INITIAL_WINDOW_SIZE,    cfg.h2-initial-window,
            SETTINGS_MAX_HEADER_LIST_SIZE,   cfg.max-header-size,
            SETTINGS_MAX_FRAME_SIZE,         max(16384, min(cfg.h2-max-frame, 16777215))
        )
        nghttp2_submit_settings(__session, 0, iv, 4)

        let window = max(cfg.h2-initial-window * 4, 65535)
        nghttp2_session_set_local_window_size(__session, 0, 0, min(window, 0x7FFFFFFF))

        conn.timeout(READ, cfg.idle-timeout)
        __schedule()
    }

    __schedule() {
        if !__pumping? && !__dead? {
            __pumping? = true
            conn.loop.later(-> __pump())
        }
    }

    __pump() {
        __pumping? = false

        if __dead? || conn.closing? {
            return
        }

        let s = __session ?? return
        let high = conn.config.write-high-water

        while conn.buffered < high {
            let n = nghttp2_session_mem_send(s, __out)
            if n < 0 {
                log::debug!("h2: mem_send failed: {c.str(nghttp2_strerror(n))}")
                return conn.close()
            }
            if n == 0 {
                break
            }
            conn.write(Blob().push(c.load(c.ptr, __out), n))
        }

        for _, st in __streams {
            if let $x = st.x {
                if x.buffered <= high / 2 {
                    x.drained()
                }
            }
        }

        if nghttp2_session_want_read(s) == 0 && nghttp2_session_want_write(s) == 0 {
            __dead? = true
            return conn.close-after-flush()
        }

        if !conn.reading? && !conn.eof? {
            conn.want-read()
        }
    }

    __idle() {
        if #__streams == 0 {
            conn.timeout(READ, conn.config.idle-timeout)
        } else {
            conn.untimeout(READ)
        }
    }

    cb-begin(frame: Ptr) -> Int {
        if frame-type(frame) != NGHTTP2_HEADERS || frame-cat(frame) != NGHTTP2_HCAT_REQUEST {
            return 0
        }
        let id = frame-id(frame)
        __streams[id] = Stream(id)
        __idle()
        0
    }

    cb-header(frame: Ptr, name: Ptr, namelen: Int, value: Ptr, valuelen: Int) -> Int {
        let $st = __streams[frame-id(frame)] or return 0

        st.head-size += namelen + valuelen + 32
        if st.head-size > conn.config.max-header-size {
            return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE
        }

        let k = c.str(name, namelen)
        let v = c.str(value, valuelen)

        match k {
            ':method'    => st.method = v,
            ':path'      => st.path = v,
            ':scheme'    => st.scheme = v,
            ':authority' => st.authority = v,
            _ => {
                if #st.headers >= conn.config.max-headers && st.headers[k] == nil {
                    return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE
                }
                match st.headers[k] {
                    nil               => st.headers[k] = v,
                    vs: Array[String] => vs.push(v),
                    one               => st.headers[k] = [one, v]
                }
            }
        }

        0
    }

    cb-chunk(id: Int, data: Ptr, len: Int) -> Int {
        let $st = __streams[id] or return 0
        if st.rejected? {
            return 0
        }
        if let $q = st.queue {
            if q.total + len > conn.config.max-body-size {
                q.fail(HttpError(413))
                st.rejected? = true
                reset(st, NGHTTP2_CANCEL)
                return 0
            }
            q.push(Blob().push(data, len))
            return 0
        }
        let body = st.body ?? (st.body = Blob())
        if #body + len > conn.config.max-body-size {
            st.rejected? = true
            st.body = nil
            __reject(st, 413)
            return 0
        }
        body.push(data, len)
        0
    }

    cb-frame(frame: Ptr) -> Int {
        let type = frame-type(frame)
        if type != NGHTTP2_HEADERS && type != NGHTTP2_DATA {
            return 0
        }
        let end? = (frame-flags(frame) & NGHTTP2_FLAG_END_STREAM) != 0
        let $st = __streams[frame-id(frame)] or return 0

        if let $q = st.queue {
            if end? {
                q.finish()
            }
            return 0
        }

        if !end? {
            if (
                type == NGHTTP2_HEADERS
             && !st.dispatched?
             && server.streams?
             && st.method != nil
             && server.streaming-route?(st.method ?? '', __path-of(st), conn.loop)
            ) {
                st.dispatched? = true
                st.queue = BodyQueue(conn.loop, -> nil)
                __dispatch(st)
            }
            return 0
        }

        if !st.dispatched? && !st.rejected? {
            st.dispatched? = true
            __dispatch(st)
        }
        0
    }

    cb-close(id: Int, code: Int) -> Int {
        if let $st = __streams[id] {
            __streams.remove(id)
            st.closed? = true
            if let $q = st.queue {
                if !q.complete? {
                    q.fail(ConnectionClosed('stream reset'))
                }
            }
            if let $x = st.x {
                x.closed()
            }
            __idle()
        }
        if __goaway? && #__streams == 0 {
            __schedule()
        }
        0
    }

    cb-read(id: Int, buf: Ptr, length: Int, flags: Ptr) -> Int {
        let $st = __streams[id] or return NGHTTP2_ERR_CALLBACK_FAILURE

        let n = min(length, st.pending)
        if n > 0 {
            memcpy(buf, st.out.ptr() + st.pos, n)
            st.pos += n
            if st.pos == #st.out {
                st.out.clear()
                st.pos = 0
            } else if st.pos > 65536 && st.pos * 2 > #st.out {
                st.out.clear(0, st.pos)
                st.pos = 0
            }
        }

        if st.pending == 0 {
            if st.eof? {
                c.store(c.u32, flags, c.load(c.u32, flags) | NGHTTP2_DATA_FLAG_EOF)
            } else if n == 0 {
                st.deferred? = true
                return NGHTTP2_ERR_DEFERRED
            }
        }

        n
    }

    __reject(st: Stream, status: Int) {
        st.eof? = true
        submit(st, nil, status, 0, false)
    }

    __path-of(st: Stream) -> String {
        let p = st.path ?? '/'
        match p.bsearch('?') {
            nil => p,
            i   => p.bslice(0, i)
        }
    }

    __dispatch(st: Stream) {
        if st.method == nil || (st.path == nil && st.method != 'CONNECT') {
            return reset(st, NGHTTP2_PROTOCOL_ERROR)
        }

        if let $authority = st.authority {
            if st.headers['host'] == nil {
                st.headers['host'] = authority
            }
        }

        let body = match st.body {
            nil => nil,
            b   => b.str!()
        }

        let req = Request.h2(
            st.method ?? 'GET',
            st.path ?? '/',
            st.headers,
            body,
            st.scheme ?? ((conn.tls != nil) ? 'https' : 'http')
        )

        if !req.valid? {
            return __reject(st, 400)
        }

        if let $q = st.queue {
            req.attach-body(q)
        }

        req.remote = conn.peer
        conn.requests += 1

        let x = H2Exchange(self, st, req)
        st.x = x
        conn.loop.spawn("{req.method} {req.url}", server.serve, x, req)
    }

    submit(st: Stream, rsp: Response | nil, status: Int, length: Int | nil, body?: Bool) {
        if st.closed? || st.submitted? || __session == nil {
            return
        }
        st.submitted? = true

        let (nva, n, strs) = header-list(rsp, status, length, conn.loop.date, conn.config.server-name)

        let prd = if body? {
            let p = c.pack(Blob(), '=qQ', st.id, int(callbacks().read))
            st.prd = p
            p
        }

        let rc = nghttp2_submit_response(__session, st.id, nva, n, prd)
        if rc != 0 {
            log::debug!("h2: submit_response failed: {c.str(nghttp2_strerror(rc))}")
            return reset(st, NGHTTP2_INTERNAL_ERROR)
        }

        __schedule()
    }

    resume(st: Stream) {
        if st.closed? || __session == nil {
            return
        }
        if st.deferred? {
            st.deferred? = false
            nghttp2_session_resume_data(__session, st.id)
        }
        __schedule()
    }

    reset(st: Stream, code: Int) {
        if st.closed? || __session == nil {
            return
        }
        nghttp2_submit_rst_stream(__session, 0, st.id, code)
        __schedule()
    }

    on-data() {
        let s = __session ?? return

        if conn.available > 0 {
            let n = nghttp2_session_mem_recv(s, conn.buf.ptr() + conn.head, conn.available)
            if n < 0 {
                log::debug!("h2: mem_recv failed: {c.str(nghttp2_strerror(n))}")
                __pump()
                return conn.close-after-flush()
            }
            conn.consume(n)
        }

        __schedule()
    }

    on-eof() {
        conn.close()
    }

    on-drain() {
        __schedule()
    }

    on-timeout(which: Int) {
        if #__streams == 0 {
            on-shutdown()
            conn.loop.later(-> conn.close-after-flush())
        } else {
            conn.close()
        }
    }

    on-shutdown() {
        if __goaway? || __session == nil {
            return
        }
        __goaway? = true
        nghttp2_submit_goaway(
            __session,
            0,
            nghttp2_session_get_last_proc_stream_id(__session),
            NGHTTP2_NO_ERROR,
            nil,
            0
        )
        __schedule()
        if #__streams == 0 {
            conn.loop.later(-> conn.close-after-flush())
        }
    }

    on-close() {
        __dead? = true
        for _, st in __streams {
            st.closed? = true
            if let $x = st.x {
                x.closed()
            }
        }
        __streams = %{}
        if let $s = __session {
            __session = nil
            nghttp2_session_del(s)
        }
    }
}

pub fn session(conn: Conn, server: _) -> H2 {
    H2(conn, server)
}
