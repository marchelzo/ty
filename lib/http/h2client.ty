/**
 * HTTP/2 client connections for `http.client`, multiplexing concurrent
 * requests (from any number of threads) over one socket. Imported only
 * when libnghttp2 is installed.
 *
 * One thread at a time reads from the socket while holding the right to
 * drive the nghttp2 session; others wait on a condition variable and take
 * over when it is done. Response bodies use manual flow control: window
 * credit is returned only as the application reads, so a slow reader
 * applies backpressure instead of buffering without bound.
 */
import ffi as c
import time
import log
import http.nghttp2 (..)
import http.headers (Headers)
import http.status (status-name)
import http.transport (
    Body,
    ConnPool,
    Exchange,
    Multiplexed,
    Request,
    Socket,
    Timeout,
    ReadError,
    ReadTimeout,
    WriteTimeout,
    ProtocolError,
    StaleConnection,
    stream-chunks
)

const STREAM_WINDOW     = 4 * 1024 * 1024
const CONNECTION_WINDOW = 32 * 1024 * 1024
const UPLOAD_HIGH       = 1024 * 1024

let __tls::current: H2Conn | nil = nil
let __tls::sleeper: CondVar = CondVar()

let callbacks = Callbacks(_ -> current)

fn deadline(t: Float | nil) -> Float | nil {
    (t == nil) ? nil : time.now() + t
}

fn left(d: Float | nil) -> Float | nil {
    (d == nil) ? nil : max(0.0, d - time.now())
}

class H2Stream {
    id:        Int
    status:    Int | nil
    headers:   Array[(String, String)]
    trailers:  Array[(String, String)]
    head?:     Bool
    body:      Blob
    end?:      Bool
    closed?:   Bool
    error:     BaseException | nil
    out:       Blob
    pos:       Int
    eof?:      Bool
    deferred?: Bool
    touched?:  Bool
    keep:      (Blob, Blob, Blob | nil) | nil

    init() {
        id        = -1
        status    = nil
        headers   = []
        trailers  = []
        head?     = false
        body      = Blob()
        end?      = false
        closed?   = false
        error     = nil
        out       = Blob()
        pos       = 0
        eof?      = false
        deferred? = false
        touched?  = false
        keep      = nil
    }

    pending -> Int {
        #out - pos
    }
}

class H2Body : Body {
    conn:   H2Conn
    st:     H2Stream
    done?:  Bool
    t:      Timeout

    init(conn: H2Conn, st: H2Stream, t: Timeout) {
        self.conn = conn
        self.st   = st
        self.t    = t
        done?     = false
    }

    read() -> Blob | nil {
        if done? {
            return nil
        }
        let out = conn.read-body(st, t)
        if out == nil {
            __finish()
        }
        out
    }

    __finish() {
        if !done? {
            done? = true
            conn.finished(st)
        }
    }

    close() {
        if !done? {
            conn.cancel(st)
            __finish()
        }
    }
}

pub class H2Conn : Multiplexed {
    sock:        Socket
    pool:        ConnPool
    idle-since:  Float
    max-streams: Int

    __key:      String
    __requests: Int
    __active:   Int

    __session:  Ptr | nil
    __lock:     Mutex
    __sleepers: Array[(CondVar, H2Stream)]
    __streams:  Dict[Int, H2Stream]
    __reading?: Bool
    __dead?:    Bool
    __goaway?:  Bool
    __error:    BaseException | nil
    __out:      Ptr
    __pend:     Blob

    init(sock: Socket, key: String, pool: ConnPool, t: Timeout) {
        self.sock      = sock
        self.pool      = pool
        __key          = key
        __requests     = 0
        __active       = 0
        idle-since     = time.now()
        max-streams    = 100
        __lock         = Mutex()
        __sleepers     = []
        __streams      = %{}
        __reading?     = false
        __dead?        = false
        __goaway?      = false
        __error        = nil
        __out          = c.new-auto(c.ptr)
        __pend         = Blob()

        let opt = c.new-auto(c.ptr)
        nghttp2_option_new(opt)
        let option = c.load(c.ptr, opt)
        nghttp2_option_set_no_auto_window_update(option, 1)
        nghttp2_option_set_peer_max_concurrent_streams(option, 100)
        nghttp2_option_set_max_settings(option, 64)

        let out = c.new-auto(c.ptr)
        let rc = nghttp2_session_client_new2(out, callbacks.cbs, nil, option)
        nghttp2_option_del(option)
        if rc != 0 {
            throw ProtocolError("http: nghttp2_session_client_new2: {strerror(rc)}")
        }
        __session = c.load(c.ptr, out)

        let (iv, n) = settings([
            (SETTINGS_ENABLE_PUSH, 0),
            (SETTINGS_MAX_CONCURRENT_STREAMS, 100),
            (SETTINGS_INITIAL_WINDOW_SIZE, STREAM_WINDOW)
        ])
        nghttp2_submit_settings(__session, 0, iv, n)
        nghttp2_session_set_local_window_size(__session, 0, 0, CONNECTION_WINDOW)

        let ^_ = __lock.lock()
        __flush(deadline(t.connect))
    }

    key -> String {
        __key
    }

    requests -> Int {
        __requests
    }

    active -> Int {
        __active
    }

    http2? -> Bool {
        true
    }

    protocol -> String {
        'HTTP/2'
    }

    usable? -> Bool {
        !__dead? && !__goaway? && active < max-streams
    }

    idle? -> Bool {
        active == 0
    }

    reusable? -> Bool {
        usable?
    }

    reserve() {
        __active += 1
        __requests += 1
    }

    unreserve() {
        __active = max(0, __active - 1)
        if __active == 0 {
            idle-since = time.now()
        }
    }

    close() {
        let ^_ = __lock.lock()
        __die(ReadError('http: connection closed'))
        if let $s = __session {
            __session = nil
            nghttp2_session_del(s)
        }
        sock.close()
    }

    __die(e: BaseException) {
        if __dead? {
            return
        }
        __dead? = true
        __error = e
        for _, st in __streams {
            st.closed? = true
            if st.error == nil && !st.end? {
                st.error = e
            }
        }
        __wake-all()
    }

    __wake-all() {
        for (cv, _) in __sleepers {
            cv.signal()
        }
    }

    /// Wakes the threads whose streams made progress, and (when `handoff?`)
    /// one more so that somebody keeps reading the socket.
    __wake(handoff?: Bool) {
        let woke = false
        for (cv, st) in __sleepers {
            if st.touched? || st.closed? || __dead? {
                st.touched? = false
                cv.signal()
                woke = true
            }
        }
        if handoff? && !woke && #__sleepers > 0 {
            __sleepers[0].0.signal()
        }
    }

    __flush(until: Float | nil) {
        let $s = __session or return
        if __dead? || nghttp2_session_want_write(s) == 0 {
            return
        }
        let pend = __pend
        pend.clear()
        while true {
            current = self
            let n = nghttp2_session_mem_send(s, __out)
            current = nil
            if n < 0 {
                __die(ProtocolError("http: HTTP/2 send failed: {strerror(n)}"))
                return
            }
            if n == 0 {
                break
            }
            pend.push(c.load(c.ptr, __out), n)
            if #pend >= 65536 {
                __send(pend, until)
                pend.clear()
            }
        }
        if #pend > 0 {
            __send(pend, until)
            pend.clear()
        }
        if #pend > (1 << 20) {
            __pend = Blob()
        }
    }

    __send(data: Blob, until: Float | nil) {
        try {
            sock.send(data, until)
        } catch e {
            __die(e)
            throw e
        }
    }

    /// Drives the connection until `ready()` holds. Called with the lock held.
    __wait(st: H2Stream, ready: () -> Bool, until: Float | nil, what: String) {
        while !ready() {
            if __dead? {
                throw __error ?? ReadError('http: connection closed')
            }
            if __reading? {
                let cv = sleeper
                __sleepers.push((cv, st))
                cv.wait(__lock, left(until) ?? 3600.0)
                __sleepers = [p for p in __sleepers if p.0 != cv]
                if until != nil && left(until) == 0.0 && !ready() {
                    throw ReadTimeout("http: timed out waiting for {what} from {sock.host}")
                }
                continue
            }

            __reading? = true
            __flush(until)
            __lock.unlock()
            let raw: Blob | nil = nil
            let failure: BaseException | nil = nil
            try {
                raw = sock.recv-raw(until)
            } catch e {
                failure = e
            }
            __lock.lock()
            __reading? = false

            if let $e = failure {
                __wake(true)
                if e :: ReadTimeout {
                    throw ReadTimeout("http: timed out waiting for {what} from {sock.host}")
                }
                __die(e)
                throw e
            }

            let plain = try {
                sock.decrypt(raw, until)
            } catch e {
                __die(e)
                throw e
            }

            if plain == nil {
                __die(ReadError("http: {sock.host} closed the HTTP/2 connection"))
                continue
            }

            if #plain > 0 {
                let $s = __session or throw ReadError('http: connection closed')
                current = self
                let rc = nghttp2_session_mem_recv(s, plain, #plain)
                current = nil
                if rc < 0 {
                    __die(ProtocolError("http: HTTP/2 protocol error from {sock.host}: {strerror(rc)}"))
                }
                __flush(until)
            }
            __wake(ready())
        }
        if !__reading? && #__sleepers > 0 {
            __sleepers[0].0.signal()
        }
    }

    exchange(req: Request, t: Timeout, extra: Array[(String, String)] = []) -> Exchange {
        let ^_ = __lock.lock()
        if __dead? {
            throw StaleConnection("http: HTTP/2 connection to {sock.host} is closed")
        }

        let pairs = [
            (':method', req.method),
            (':scheme', req.url.scheme ?? 'https'),
            (':authority', req.headers['host'] ?? req.url.authority),
            (':path', req.url.target)
        ]
        for (k, v) in req.headers.items() {
            let name = k.lower()
            if HOP_BY_HOP.contains?(name) {
                if name == 'te' && v.lower() == 'trailers' {
                    pairs.push(('te', 'trailers'))
                }
                continue
            }
            pairs.push((name, v))
        }
        for (k, v) in extra {
            pairs.push((k.lower(), v))
        }

        let st = H2Stream()
        let streamed = req.stream
        let body = req.content
        let has-body? = streamed != nil || (body != nil && #body > 0)

        if body != nil && req.headers['content-length'] == nil && streamed == nil {
            pairs.push(('content-length', str(#body)))
        }

        if let $b = body {
            st.out.push(b)
        }
        st.eof? = streamed == nil

        let (nva, n, strs) = nv-list(pairs)
        let prd = has-body? ? callbacks.provider(0) : nil
        let id = nghttp2_submit_request(__session, nil, nva, n, prd, nil)
        if id < 0 {
            throw ProtocolError("http: cannot submit HTTP/2 request: {strerror(id)}")
        }
        st.id = id
        st.keep = (nva, strs, prd)
        __streams[id] = st

        try {
            __flush(deadline(t.write))

            if streamed != nil {
                for chunk in stream-chunks(streamed) {
                    st.out.push(chunk)
                    __resume(st)
                    __flush(deadline(t.write))
                    if st.pending > UPLOAD_HIGH {
                        __wait(st, -> st.pending <= UPLOAD_HIGH / 2 || st.closed? || st.head?, deadline(t.write), 'flow-control credit')
                    }
                    if st.closed? || st.head? {
                        break
                    }
                }
                if !st.closed? && !st.head? {
                    st.eof? = true
                    __resume(st)
                    __flush(deadline(t.write))
                }
            }

            __wait(st, -> st.head? || st.closed?, deadline(t.read), 'response headers')

            if !st.head? {
                if st.error :: StaleConnection {
                    throw st.error
                }
                throw st.error ?? ProtocolError("http: HTTP/2 stream closed before response headers")
            }
        } catch e {
            __abandon(st)
            throw e
        }

        let status = st.status ?? 0
        (status, status-name(status), Headers.raw(st.headers), 'HTTP/2', H2Body(self, st, t))
    }

    __resume(st: H2Stream) {
        if st.deferred? && !st.closed? {
            st.deferred? = false
            nghttp2_session_resume_data(__session, st.id)
        }
    }

    read-body(st: H2Stream, t: Timeout) -> Blob | nil {
        let ^_ = __lock.lock()
        while true {
            if #st.body > 0 {
                let out = st.body
                st.body = Blob()
                if let $s = __session {
                    nghttp2_session_consume(s, st.id, #out)
                    __flush(deadline(t.write))
                }
                return out
            }
            if st.end? {
                return nil
            }
            if st.closed? {
                throw st.error ?? ReadError('http: HTTP/2 stream closed before the body was complete')
            }
            __wait(st, -> #st.body > 0 || st.end? || st.closed?, deadline(t.read), 'response body')
        }
        nil
    }

    /// Stops a stream the application no longer wants: resets it if it is
    /// still open (or its upload is unfinished), returns the flow-control
    /// credit of anything buffered, and forgets it. Called with the lock held.
    __abandon(st: H2Stream) {
        let $s = __session or return
        if !st.closed? && (!st.end? || !st.eof? || st.pending > 0) {
            nghttp2_submit_rst_stream(s, 0, st.id, st.end? ? NGHTTP2_NO_ERROR : NGHTTP2_CANCEL)
        }
        if #st.body > 0 {
            nghttp2_session_consume(s, st.id, #st.body)
            st.body = Blob()
        }
        __streams.remove(st.id)
        try {
            __flush(deadline(1.0))
        } catch _ {
        }
    }

    cancel(st: H2Stream) {
        let ^_ = __lock.lock()
        __abandon(st)
    }

    finished(st: H2Stream) {
        do {
            let ^_ = __lock.lock()
            __abandon(st)
        }
        pool.release(self, true)
    }

    cb-begin(frame: Ptr) -> Int {
        0
    }

    cb-header(frame: Ptr, name: Ptr, namelen: Int, value: Ptr, valuelen: Int) -> Int {
        let $st = __streams[frame-id(frame)] or return 0
        st.touched? = true
        let k = c.str(name, namelen)
        let v = c.str(value, valuelen)
        if k == ':status' {
            st.status = (try { int(v, 10) }) ?? 0
            return 0
        }
        if k.starts?(':') {
            return 0
        }
        if st.head? {
            st.trailers.push((k, v))
        } else {
            st.headers.push((k, v))
        }
        0
    }

    cb-frame(frame: Ptr) -> Int {
        let type = frame-type(frame)
        let id = frame-id(frame)

        if type == NGHTTP2_GOAWAY {
            __goaway? = true
            let last = goaway-last(frame)
            for sid, st in __streams {
                if sid > last && !st.head? {
                    st.error = StaleConnection("http: {sock.host} refused the stream (GOAWAY)")
                }
            }
            return 0
        }

        if type == NGHTTP2_SETTINGS && (frame-flags(frame) & NGHTTP2_FLAG_ACK) == 0 {
            if let $s = __session {
                let m = nghttp2_session_get_remote_settings(s, SETTINGS_MAX_CONCURRENT_STREAMS)
                max-streams = max(1, min(m, 1000))
            }
            return 0
        }

        let $st = __streams[id] or return 0
        st.touched? = true

        if type == NGHTTP2_HEADERS {
            let code = st.status ?? 0
            if !st.head? {
                if code >= 100 && code < 200 && code != 101 {
                    st.status = nil
                    st.headers = []
                } else {
                    st.head? = true
                }
            }
        }

        if (type == NGHTTP2_HEADERS || type == NGHTTP2_DATA) && (frame-flags(frame) & NGHTTP2_FLAG_END_STREAM) != 0 {
            st.end? = true
        }
        0
    }

    cb-chunk(id: Int, data: Ptr, len: Int) -> Int {
        match __streams[id] {
            nil => {
                if let $s = __session {
                    nghttp2_session_consume_connection(s, len)
                }
            },
            st => {
                st.body.push(data, len)
                st.touched? = true
            }
        }
        0
    }

    cb-close(id: Int, code: Int) -> Int {
        let $st = __streams[id] or return 0
        st.closed? = true
        st.touched? = true
        if code != NGHTTP2_NO_ERROR && !st.end? && st.error == nil {
            st.error = (code == NGHTTP2_REFUSED_STREAM)
                ? StaleConnection("http: {sock.host} refused the stream")
                : ProtocolError("http: {sock.host} reset the stream ({error-name(code)})")
        }
        if code != NGHTTP2_NO_ERROR && !st.end? && st.head? && st.error == nil {
            st.error = ReadError("http: stream reset by {sock.host}")
        }
        0
    }

    cb-read(id: Int, buf: Ptr, length: Int, flags: Ptr) -> Int {
        let $st = __streams[id] or return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE
        let n = min(length, st.pending)
        if n > 0 {
            st.touched? = true
            memcpy(buf, st.out.ptr() + st.pos, n)
            st.pos += n
            if st.pos == #st.out {
                st.out.clear()
                st.pos = 0
            } else if st.pos > 65536 && st.pos * 2 > #st.out {
                st.out.clear(0, st.pos)
                st.pos = 0
            }
        }
        if st.pending == 0 {
            if st.eof? {
                c.store(c.u32, flags, c.load(c.u32, flags) | NGHTTP2_DATA_FLAG_EOF)
            } else if n == 0 {
                st.deferred? = true
                return NGHTTP2_ERR_DEFERRED
            }
        }
        n
    }
}

pub fn connect(sock: Socket, key: String, pool: ConnPool, t: Timeout) -> H2Conn {
    H2Conn(sock, key, pool, t)
}
