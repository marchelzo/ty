import ffi as c (C!)
import os
import errno
import http.backend as backend

#|if __linux__
if not let $libkqueue = c.open('kqueue', versions: [0, nil], env: 'TY_LIBKQUEUE') {
    throw RuntimeError('http.kqueue: libkqueue not found (set TY_LIBKQUEUE)')
}

C! libkqueue fn {
    int kqueue(void);
    int kevent(int kq, void const *changes, int nchanges, void *events, int nevents, void const *timeout);
}
#|else
C! fn {
    int kqueue(void);
    int kevent(int kq, void const *changes, int nchanges, void *events, int nevents, void const *timeout);
}
#|]

C! fn {
    long recv(int fd, void *buf, uint64_t n, int flags);
    long send(int fd, void const *buf, uint64_t n, int flags);
    int accept(int fd, void *addr, void *addrlen);
}

C! fn {
    long pread(int fd, void *buf, uint64_t n, long offset);
}

let sys-pread  = pread
let sys-recv   = recv
let sys-send   = send
let sys-accept = accept

pub const NAME = 'kqueue'

const EVFILT_READ  = -1
const EVFILT_WRITE = -2

const EV_ADD     = 0x0001
const EV_DELETE  = 0x0002
const EV_ONESHOT = 0x0010
const EV_CLEAR   = 0x0020
const EV_ERROR   = 0x4000

const WAKE_TAG = -1

#|if __bsd__
const KEVENT     = 64
const KEVENT_FMT = '=qhHIqq32x'
#|else
const KEVENT     = 32
const KEVENT_FMT = '=qhHIqq'
#|]

const SEND_FLAGS   = __apple__ ? 0 : (__bsd__ ? 0x20000 : 0x4000)
const SOL_SOCKET   = 0xFFFF
const SO_NOSIGPIPE = 0x1022

const OP_ACCEPT = 1
const OP_RECV   = 2
const OP_SEND   = 3
const OP_WAKE   = 4

const BATCH = 256


fn set-event(b: Blob, i: Int, ident: Int, filter: Int, flags: Int, fflags: Int, user: Int) {
    c.pack(b.ptr() + i * KEVENT, KEVENT_FMT, ident, filter, flags, fflags, 0, user)
}

fn nonblocking(fd: Int) {
    os.fcntl(fd, os.F_SETFL, os.fcntl(fd, os.F_GETFL) | os.O_NONBLOCK)
#|if __apple__
    os.setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, 1)
#|]
}

pub class Backend : backend.Backend {
    __kq:    Int
    __ch:    Blob
    __nch:   Int
    __ev:    Blob
    __ts:    Blob
    __wake-r: Int
    __wake-w: Int
    __byte:   Blob
    __drain:  Blob
    __ready: Array[(Int, Int)]
    __ops:   Dict[Int, (Int, Int, Ptr | nil, Int)]
    __wake:  Int | nil

    init(entries: Int = 1024) {
        __kq = kqueue()
        if __kq < 0 {
            throw OSError('kqueue')
        }
        __ch    = Blob.zeros(KEVENT * BATCH)
        __nch   = 0
        __ev    = Blob.zeros(KEVENT * BATCH)
        __ts    = Blob.zeros(16)
        (__wake-r, __wake-w) = os.socketpair(os.AF_UNIX, os.SOCK_STREAM, 0)
        nonblocking(__wake-r)
        nonblocking(__wake-w)
        __byte  = Blob(1)
        __drain = Blob.zeros(64)
        __ready = []
        __ops   = %{}
        __wake  = nil
    }

    name -> String {
        NAME
    }

    __change(ident: Int, filter: Int, flags: Int, fflags: Int, user: Int) {
        if __nch == BATCH {
            __flush()
        }
        set-event(__ch, __nch, ident, filter, flags, fflags, user)
        __nch += 1
    }

    __flush() {
        if __nch > 0 {
            let n = __nch
            __nch = 0
            kevent(__kq, __ch, n, nil, 0, nil)
        }
    }

    accept(fd: Int, user: Int) {
        nonblocking(fd)
        __ops[user] = (OP_ACCEPT, fd, nil, 0)
        __change(fd, EVFILT_READ, EV_ADD | EV_ONESHOT, 0, user)
    }

    recv(fd: Int, p: Ptr, n: Int, user: Int) {
        __ops[user] = (OP_RECV, fd, p, n)
        __change(fd, EVFILT_READ, EV_ADD | EV_ONESHOT, 0, user)
    }

    send(fd: Int, p: Ptr, n: Int, user: Int) {
        let r = sys-send(fd, p, n, SEND_FLAGS)
        if r >= 0 {
            __ready.push((user, r))
            return
        }
        let e = errno.get()
        if e != errno.EAGAIN && e != errno.EINTR {
            __ready.push((user, -e))
            return
        }
        __ops[user] = (OP_SEND, fd, p, n)
        __change(fd, EVFILT_WRITE, EV_ADD | EV_ONESHOT, 0, user)
    }

    read(fd: Int, p: Ptr, n: Int, offset: Int, user: Int) {
        let r = sys-pread(fd, p, n, offset)
        __ready.push((user, (r >= 0) ? r : -errno.get()))
    }

    cancel(user: Int) {
        if let (op, fd, *) = __ops[user] {
            __ops.remove(user)
            __change(fd, (op == OP_SEND) ? EVFILT_WRITE : EVFILT_READ, EV_DELETE, 0, 0)
            __flush()
            __ready.push((user, -errno.ECANCELED))
        }
    }

    arm-wake(user: Int) {
        if __wake == nil {
            __wake = user
            __change(__wake-r, EVFILT_READ, EV_ADD | EV_CLEAR, 0, WAKE_TAG)
            __flush()
        }
    }

    woke() {
    }

    wake() {
        sys-send(__wake-w, __byte, 1, SEND_FLAGS)
    }

    __perform(user: Int, op: Int, fd: Int, p: Ptr | nil, n: Int) -> Int | nil {
        let r = match op {
            OP_ACCEPT => sys-accept(fd, nil, nil),
            OP_RECV   => sys-recv(fd, p, n, 0),
            OP_SEND   => sys-send(fd, p, n, SEND_FLAGS)
        }

        if r >= 0 {
            if op == OP_ACCEPT {
                nonblocking(r)
            }
            return r
        }

        match errno.get() {
            errno.EAGAIN, errno.EINTR => {
                __change(fd, (op == OP_SEND) ? EVFILT_WRITE : EVFILT_READ, EV_ADD | EV_ONESHOT, 0, user)
                nil
            },
            e => -e
        }
    }

    __event(i: Int, f: (Int, Int, Int) -> _) {
        let (_, filter, flags, _, data, user) = c.unpack('=qhHIqq', __ev.ptr() + i * KEVENT)

        if user == WAKE_TAG {
            while sys-recv(__wake-r, __drain, 64, 0) > 0 {
            }
            f(__wake ?? 0, 8, 0)
            return
        }

        let (op, fd, p, n) = __ops[user] ?? return

        if (flags & EV_ERROR) != 0 && data != 0 {
            __ops.remove(user)
            f(user, -data, 0)
            return
        }

        if let $r = __perform(user, op, fd, p, n) {
            __ops.remove(user)
            f(user, r, 0)
        }
    }

    __drain-ready(f: (Int, Int, Int) -> _) -> Int {
        let n = 0
        while #__ready > 0 {
            let ready = __ready
            __ready = []
            for (user, res) in ready {
                f(user, res, 0)
                n += 1
            }
        }
        n
    }

    __kevent(timeout: Float | nil) -> Int {
        let ts = if timeout != nil {
            let t = max(timeout, 0.0)
            let sec = int(t)
            c.pack(__ts.ptr(), '=qq', sec, int((t - sec) * 1000000000))
            __ts
        }
        let nch = __nch
        __nch = 0
        let n = kevent(__kq, __ch, nch, __ev, BATCH, ts)
        if n < 0 {
            let e = errno.get()
            if e != errno.EINTR {
                throw OSError('kevent')
            }
            return 0
        }
        n
    }

    wait(timeout: Float | nil, f: (Int, Int, Int) -> _) -> Int {
        let done = __drain-ready(f)
        let n = __kevent((done > 0 || #__ready > 0) ? 0.0 : timeout)
        for i in ..n {
            __event(i, f)
        }
        done + n + __drain-ready(f)
    }

    poll(f: (Int, Int, Int) -> _) -> Int {
        wait(0.0, f)
    }

    close() {
        if __kq >= 0 {
            os.close(__kq)
            os.close(__wake-r)
            os.close(__wake-w)
            __kq = -1
        }
    }
}
