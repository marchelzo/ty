/**
 * Per-thread event loops: the native `_http` core does the I/O, protocols,
 * timers and buffering; this module runs request handlers as coroutines on
 * top of it.
 *
 * Inside a task, `suspend()` parks the coroutine until something resumes it
 * (a timer, a descriptor becoming ready, an event from the core, or a result
 * posted from another thread).
 */
import _http as c
import log
import os

pub const EV_REQUEST  = 1
pub const EV_BODY     = 2
pub const EV_READABLE = 3
pub const EV_DRAIN    = 4
pub const EV_CLOSE    = 5
pub const EV_MESSAGE  = 6
pub const EV_TIMER    = 7
pub const EV_FD       = 8
pub const EV_WAKE     = 9

pub class CanceledError < RuntimeError {
    init() {
        super('task canceled')
    }
}

pub class ConnectionClosed < RuntimeError {
    init(what: String = 'connection closed') {
        super(what)
    }
}

pub tag Raise;

pub trait Handler {
    request(loop: Loop, id: Int, req: _, pending: Int);
}

pub trait Exchange {
    event(kind: Int, a: _, b: _);
}

pub class Task {
    loop:      Loop
    name:      String
    gen:       Generator[_, _] | nil
    done?:     Bool = false
    parked?:   Bool = false
    canceled?: Bool = false
}

class Waiter {
    task:   Task
    fired?: Bool = false
}

let __tls::current: Task | nil = nil
let __tls::running: Loop | nil = nil

pub fn task() -> Task | nil {
    current
}

pub fn loop() -> Loop | nil {
    running
}

pub fn in-task?(l: Loop) -> Bool {
    current != nil && current.loop == l
}

pub fn on-loop?(l: Loop) -> Bool {
    running == l
}

pub fn suspend() -> _ {
    let $t = current or throw RuntimeError('http: suspension outside of a server task')
    t.parked? = true
    let v = yield nil
    t.parked? = false
    match v {
        Raise(e) => throw e,
        _        => v
    }
}

fn body*(t: Task, f: (*_) -> _, args: Array[_], kwargs: Dict[String, _]) {
    try {
        f(*args, **kwargs)
    } catch _: CanceledError {
    } catch _: ConnectionClosed {
    } catch e {
        log::error!("unhandled exception in task", task: t.name, err: e)
    } finally {
        t.done? = true
        t.loop.finished(t)
    }
}

pub class Loop {
    core:    Ptr
    index:   Int
    handler: Handler
    evs:     Array[_] = []
    pins:    Array[_] = []
    tokens:  Array[_] = []
    xs:      Array[Exchange | nil] = []
    tasks:   Set[Task] = Set()

    __mbox:    Array[() -> _] = []
    __mtx:     Mutex = Mutex()
    __closed?: Bool = false

    init(group: Ptr, index: Int, handler: Handler) {
        self.index   = index
        self.handler = handler
        core         = c.loop(group, index, evs, pins, tokens)
    }

    backend -> String {
        c.backend(core)
    }

    stopping? -> Bool {
        c.stopping?(core)
    }

    attach(id: Int, x: Exchange) {
        let slot: Int = id & 0xFFFFFFFF
        while #xs <= slot {
            xs.push(nil)
        }
        xs[slot] = x
    }

    detach(id: Int) {
        let slot: Int = id & 0xFFFFFFFF
        if slot < #xs {
            xs[slot] = nil
        }
        c.release(core, id)
    }

    spawn(name: String, f: (*_) -> _, *args: _, %kwargs: _) -> Task {
        let t = Task(self, name)
        t.gen = body(t, f, args, kwargs)
        tasks.insert(t)
        step(t, nil)
        t
    }

    step(t: Task, v: _) {
        if t.done? {
            return
        }
        let $g = t.gen or return
        let prev = current
        current = t
        t.parked? = false
        try {
            g(v)
        } finally {
            current = prev
        }
    }

    finished(t: Task) {
        tasks.remove(t)
    }

    resume(t: Task, v: _ = nil) {
        if t.done? || !t.parked? {
            return
        }
        if on-loop?(self) {
            step(t, v)
        } else {
            post(-> resume(t, v))
        }
    }

    cancel(t: Task) {
        if !t.done? && t.parked? {
            t.canceled? = true
            step(t, Raise(CanceledError()))
        }
    }

    /// Runs `f` on this loop's thread; false once the loop has stopped.
    post(f: () -> _) -> Bool {
        let first = do {
            let ^_ = __mtx.lock()
            if __closed? {
                return false
            }
            __mbox.push(f)
            #__mbox == 1
        }
        if first {
            c.wake(core)
        }
        true
    }

    call(f: () -> _) {
        if on-loop?(self) {
            f()
        } else {
            post(f)
        }
    }

    timer(seconds: Int | Float, f: () -> _) -> Int {
        c.timer(core, float(seconds), f)
    }

    untimer(id: Int) {
        c.untimer(core, id)
    }

    sleep(seconds: Int | Float) {
        let $t = task() or throw RuntimeError('http.sleep() must be called from a server task')
        let id = c.timer(core, float(seconds), t)
        try {
            suspend()
        } finally {
            c.untimer(core, id)
        }
    }

    /// Waits for `fd` to become ready for `events` (os.POLLIN / os.POLLOUT);
    /// false when `seconds` pass first.
    wait-fd(fd: Int, events: Int, seconds: Float | nil) -> Bool {
        let $t = task() or throw RuntimeError('http: wait-fd() must be called from a server task')
        let w = Waiter(t)
        let watch = c.watch(core, fd, events, w)
        if watch < 0 {
            throw OSError("http: cannot watch descriptor {fd}", -watch)
        }
        let timer = (seconds == nil) ? nil : c.timer(core, seconds, w)
        try {
            suspend() != nil
        } finally {
            c.unwatch(core, watch)
            if timer != nil {
                c.untimer(core, timer)
            }
        }
    }

    blocking[a](f: (*_) -> a, *args: _) -> a {
        let $t = task() or throw RuntimeError('http.blocking() must be called from a server task')
        pool().submit((f, args, self, t))
        match suspend() {
            Some(x) => x,
            other   => other
        }
    }

    __fire(token: _, value: _ = nil) {
        match token {
            t: Task   => resume(t, value),
            w: Waiter => do {
                if !w.fired? {
                    w.fired? = true
                    resume(w.task, value)
                }
            },
            f: Function => f(),
            _           => {}
        }
    }

    __drain() {
        while true {
            let jobs = do {
                let ^_ = __mtx.lock()
                let jobs = __mbox
                __mbox = []
                jobs
            }
            if !jobs {
                return
            }
            for f in jobs {
                try {
                    f()
                } catch e {
                    log::error!("error in posted callback", err: e)
                }
            }
        }
    }

    __dispatch() {
        let i = 0
        while i < #evs {
            let kind = evs[i]
            let id   = evs[i + 1]
            let a    = evs[i + 2]
            let b    = evs[i + 3]
            i += 4
            try {
                match kind {
                    EV_REQUEST => handler.request(self, id, a, b),
                    EV_TIMER   => __fire(a),
                    EV_FD      => __fire(a, id),
                    EV_WAKE    => __drain(),
                    _          => do {
                        let slot: Int = id & 0xFFFFFFFF
                        if slot < #xs and let $x = xs[slot] {
                            x.event(kind, a, b)
                        }
                    }
                }
            } catch e {
                log::error!("error while dispatching event", kind: kind, err: e)
            }
        }
        evs.clear()
    }

    run() {
        running = self
        c.listen(core)
        try {
            while c.poll(core, 1.0) >= 0 {
                __dispatch()
            }
            __dispatch()
            for t in tasks.to-array() {
                cancel(t)
            }
            __dispatch()
        } finally {
            do {
                let ^_ = __mtx.lock()
                __closed? = true
                __mbox = []
            }
            running = nil
        }
    }

    stop() {
        c.stop(core)
    }

    stats(out: Array[Int]) -> Array[Int] {
        c.stats(core, out)
    }

    free() {
        c.free(core)
    }
}

use Job = ((*_) -> _, Array[_], Loop, Task);

class Pool {
    __queue: SharedQueue[Job] = SharedQueue()

    init(n: Int) {
        for ..n {
            Thread(__work).detach()
        }
    }

    __work() {
        while true {
            let (f, args, l, t) = __queue.take()
            let result = try {
                Some(f(*args))
            } catch e {
                Raise(e)
            }
            l.post(-> l.resume(t, result))
        }
    }

    submit(job: Job) {
        __queue.put(job)
    }
}

let pool-lock = Mutex()
let pool-size = 16
let blocking-pool: Pool | nil = nil

pub fn set-blocking-threads(n: Int) {
    let ^_ = pool-lock.lock()
    pool-size = max(n, 1)
}

fn pool() -> Pool {
    let ^_ = pool-lock.lock()
    blocking-pool ?? (blocking-pool = Pool(pool-size))
}

/// Suspends the current task for `seconds` without blocking its loop.
pub fn sleep(seconds: Int | Float) {
    let $l = running or throw RuntimeError('http.sleep() must be called from a server task')
    l.sleep(seconds)
}

/// Runs `f(*args)` on a worker thread and suspends the current task until it
/// returns; exceptions are rethrown in the task.
pub fn blocking[a](f: (*_) -> a, *args: _) -> a {
    let $l = running or throw RuntimeError('http.blocking() must be called from a server task')
    l.blocking(f, *args)
}

/// Starts `f(*args, **kwargs)` as a background task on the current loop.
pub fn spawn(f: (*_) -> _, *args: _, %kwargs: _) -> Task {
    let $l = running or throw RuntimeError('http.spawn() must be called on a server thread')
    l.spawn('task', f, *args, **kwargs)
}

/// Waits until `fd` is ready for `events`: through the loop inside a task,
/// with poll(2) elsewhere. False when `seconds` pass first.
pub fn wait-fd(fd: Int, events: Int, seconds: Float | nil) -> Bool {
    if running && in-task?(running) {
        return running.wait-fd(fd, events, seconds)
    }
    c.wait-fd(fd, events, seconds ?? -1.0)
}
