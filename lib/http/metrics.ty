pub const BUCKETS = [0.001, 0.0025, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]

fn counters(n: Int) -> Array[Atomic] {
    [Atomic(0) for ..n]
}

fn label(k: String, v: String) -> String {
    '{' + k + '="' + v + '"}'
}

fn fmt-float(x: Float) -> String {
    let s = str(x)
    s.contains?('.') || s.contains?('e') ? s : "{s}.0"
}

/// Server-wide counters, updated with atomics so every event loop can record
/// without locking; read them with `snapshot()` or `prometheus()`.
pub class Metrics {
    requests:          Atomic
    by-class:          Array[Atomic]
    bytes-out:         Atomic
    errors:            Atomic
    aborted:           Atomic
    in-flight:         Atomic
    websockets:        Atomic
    websockets-total:  Atomic
    connections-total: Atomic
    rejected:          Atomic
    latency:           Array[Atomic]
    latency-sum-us:    Atomic

    init() {
        requests          = Atomic(0)
        by-class          = counters(6)
        bytes-out         = Atomic(0)
        errors            = Atomic(0)
        aborted           = Atomic(0)
        in-flight         = Atomic(0)
        websockets        = Atomic(0)
        websockets-total  = Atomic(0)
        connections-total = Atomic(0)
        rejected          = Atomic(0)
        latency           = counters(#BUCKETS + 1)
        latency-sum-us    = Atomic(0)
    }

    observe(status: Int, seconds: Float, bytes: Int) {
        requests.fetch-add(1)
        by-class[min(max(status / 100, 0), 5)].fetch-add(1)
        bytes-out.fetch-add(bytes)
        latency-sum-us.fetch-add(int(seconds * 1000000.0))
        let i = 0
        while i < #BUCKETS && seconds > BUCKETS[i] {
            i += 1
        }
        latency[i].fetch-add(1)
    }

    add(other: Metrics) -> Metrics {
        let pairs = [
            (requests, other.requests),
            (bytes-out, other.bytes-out),
            (errors, other.errors),
            (aborted, other.aborted),
            (in-flight, other.in-flight),
            (websockets, other.websockets),
            (websockets-total, other.websockets-total),
            (connections-total, other.connections-total),
            (rejected, other.rejected),
            (latency-sum-us, other.latency-sum-us)
        ]
        for (a, b) in pairs {
            a.fetch-add(b.load())
        }
        for i in ..#by-class {
            by-class[i].fetch-add(other.by-class[i].load())
        }
        for i in ..#latency {
            latency[i].fetch-add(other.latency[i].load())
        }
        self
    }

    snapshot(active-connections: Int = 0) -> Dict[String, _] {
        let n = requests.load()
        %{
            'requests':           n,
            'responses':          %{"{k}xx": by-class[k].load() for k in 1..6},
            'bytes_out':          bytes-out.load(),
            'errors':             errors.load(),
            'aborted':            aborted.load(),
            'in_flight':          in-flight.load(),
            'websockets':         websockets.load(),
            'websockets_total':   websockets-total.load(),
            'connections':        active-connections,
            'connections_total':  connections-total.load(),
            'rejected':           rejected.load(),
            'latency_avg_ms':     (n == 0) ? 0.0 : float(latency-sum-us.load()) / float(n) / 1000.0
        }
    }

    prometheus(active-connections: Int = 0, prefix: String = 'http') -> String {
        let out = []
        let p = prefix

        out.push("# HELP {p}_requests_total Completed HTTP requests by status class.")
        out.push("# TYPE {p}_requests_total counter")
        for k in 1..6 {
            out.push("{p}_requests_total{label('code', "{k}xx")} {by-class[k].load()}")
        }

        out.push("# HELP {p}_request_duration_seconds Time from request dispatch to response completion.")
        out.push("# TYPE {p}_request_duration_seconds histogram")
        let acc = 0
        for b; i in BUCKETS {
            acc += latency[i].load()
            out.push("{p}_request_duration_seconds_bucket{label('le', fmt-float(b))} {acc}")
        }
        acc += latency[#BUCKETS].load()
        out.push("{p}_request_duration_seconds_bucket{label('le', '+Inf')} {acc}")
        out.push("{p}_request_duration_seconds_sum {fmt-float(float(latency-sum-us.load()) / 1000000.0)}")
        out.push("{p}_request_duration_seconds_count {acc}")

        for (name, kind, help, v) in [
            ('response_bytes_total', 'counter', 'Response body bytes sent.', bytes-out.load()),
            ('handler_errors_total', 'counter', 'Requests whose handler raised an unexpected exception.', errors.load()),
            ('aborted_total', 'counter', 'Requests whose connection closed before completion.', aborted.load()),
            ('requests_in_flight', 'gauge', 'Requests currently being handled.', in-flight.load()),
            ('connections', 'gauge', 'Open connections.', active-connections),
            ('connections_total', 'counter', 'Accepted connections.', connections-total.load()),
            ('connections_rejected_total', 'counter', 'Connections refused at max-connections.', rejected.load()),
            ('websockets', 'gauge', 'Open WebSocket connections.', websockets.load()),
            ('websockets_total', 'counter', 'Accepted WebSocket connections.', websockets-total.load())
        ] {
            out.push("# HELP {p}_{name} {help}")
            out.push("# TYPE {p}_{name} {kind}")
            out.push("{p}_{name} {v}")
        }

        out.join('\n') + '\n'
    }
}

pub fn combine(ms: Array[Metrics]) -> Metrics {
    let total = Metrics()
    for m in ms {
        total.add(m)
    }
    total
}
