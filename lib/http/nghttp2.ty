/**
 * HTTP/2 constants and helpers shared by the server (`http.h2`) and client
 * (`http.h2client`). The sessions themselves live in the built-in `_http`
 * module (libnghttp2, linked into ty), which calls back into a handler
 * object implementing `cb-begin(id, cat)`, `cb-header(id, name, value)`,
 * `cb-frame(id, type, flags, aux)`, `cb-chunk(id, data, len)`,
 * `cb-close(id, code)` and `cb-read(id, max)`.
 */
pub import _http (
    h2-new,
    h2-del,
    h2-recv,
    h2-send,
    h2-settings,
    h2-response,
    h2-request,
    h2-rst,
    h2-goaway,
    h2-resume,
    h2-consume,
    h2-want-read,
    h2-want-write,
    h2-remote-setting,
    h2-local-window,
    h2-strerror as strerror,
    h2-error-name as error-name
)

pub const NGHTTP2_DATA          = 0x0
pub const NGHTTP2_HEADERS       = 0x1
pub const NGHTTP2_RST_STREAM    = 0x3
pub const NGHTTP2_SETTINGS      = 0x4
pub const NGHTTP2_PUSH_PROMISE  = 0x5
pub const NGHTTP2_PING          = 0x6
pub const NGHTTP2_GOAWAY        = 0x7

pub const NGHTTP2_FLAG_END_STREAM = 0x1
pub const NGHTTP2_FLAG_ACK        = 0x1

pub const NGHTTP2_HCAT_REQUEST       = 0
pub const NGHTTP2_HCAT_RESPONSE      = 1
pub const NGHTTP2_HCAT_PUSH_RESPONSE = 2
pub const NGHTTP2_HCAT_HEADERS       = 3

pub const NGHTTP2_NO_ERROR        = 0x0
pub const NGHTTP2_PROTOCOL_ERROR  = 0x1
pub const NGHTTP2_INTERNAL_ERROR  = 0x2
pub const NGHTTP2_REFUSED_STREAM  = 0x7
pub const NGHTTP2_CANCEL          = 0x8

pub const NGHTTP2_ERR_DEFERRED                  = -508
pub const NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE = -521
pub const NGHTTP2_ERR_CALLBACK_FAILURE          = -902

pub const SETTINGS_HEADER_TABLE_SIZE      = 1
pub const SETTINGS_ENABLE_PUSH            = 2
pub const SETTINGS_MAX_CONCURRENT_STREAMS = 3
pub const SETTINGS_INITIAL_WINDOW_SIZE    = 4
pub const SETTINGS_MAX_FRAME_SIZE         = 5
pub const SETTINGS_MAX_HEADER_LIST_SIZE   = 6

pub const BODILESS = %[204, 304]

/// Connection-specific fields that HTTP/2 forbids (RFC 9113 section 8.2.2).
pub const HOP_BY_HOP = %['connection', 'transfer-encoding', 'keep-alive', 'upgrade', 'proxy-connection', 'te', 'host']

