import json
import time
import ssl
import http.core (Response)
import http.wire (Request)

const MAX_COOKIE = 4000

/// Signs `value` with the first secret: `value.signature`.
pub fn sign(value: String, secrets: Array[String]) -> String {
    "{value}.{ssl.b64url(ssl.hmac-sha256(secrets[0], value))}"
}

/// Returns the value of a string produced by `sign` if any secret verifies it.
pub fn unsign(signed: String, secrets: Array[String]) -> String | nil {
    let $i = signed.searchr('.') or return nil
    let value = signed.slice(0, i)
    let mac = signed.slice(i + 1)
    for s in secrets {
        if ssl.equal?(ssl.b64url(ssl.hmac-sha256(s, value)), mac) {
            return value
        }
    }
    nil
}

pub fn new-id() -> String {
    ssl.b64url(ssl.random-bytes(24))
}

/// Server-side session storage kept in process memory. Thread-safe; data is
/// stored as JSON so sessions never share mutable objects between threads.
pub class MemoryStore {
    max-sessions: Int

    __mtx:  Mutex
    __data: Dict[String, (Float, String)]
    __ops:  Int

    init(max-sessions: Int = 100000) {
        self.max-sessions = max-sessions
        __mtx  = Mutex()
        __data = %{}
        __ops  = 0
    }

    size -> Int {
        let ^_ = __mtx.lock()
        #__data
    }

    load(id: String) -> Dict[String, _] | nil {
        let ^_ = __mtx.lock()
        let (expires, text) = __data[id] ?? return nil
        if expires < time.utc() {
            __data.remove(id)
            return nil
        }
        json.parse(text)
    }

    save(id: String, data: Dict[String, _], ttl: Float) {
        let text = json.encode(data)
        let ^_ = __mtx.lock()
        __ops += 1
        if __ops % 1024 == 0 || #__data >= max-sessions {
            __purge()
        }
        if #__data >= max-sessions && __data[id] == nil {
            throw RuntimeError('http: session store is full')
        }
        __data[id] = (time.utc() + ttl, text)
    }

    destroy(id: String) {
        let ^_ = __mtx.lock()
        __data.remove(id)
    }

    __purge() {
        let now = time.utc()
        let stale = [id for id, (exp, _) in __data if exp < now]
        for id in stale {
            __data.remove(id)
        }
    }
}

pub class Session {
    id:         String | nil
    new?:       Bool
    dirty?:     Bool
    destroyed?: Bool

    __data:     Dict[String, _] | nil
    __loader:   _
    __rotate?:  Bool

    init(loader: _) {
        __loader   = loader
        __data     = nil
        __rotate?  = false
        id         = nil
        new?       = true
        dirty?     = false
        destroyed? = false
    }

    __load() -> Dict[String, _] {
        if let $d = __data {
            return d
        }
        let (id, data) = __loader()
        self.id = id
        new? = data == nil
        let d = data ?? %{}
        __data = d
        d
    }

    loaded? -> Bool {
        __data != nil
    }

    data -> Dict[String, _] {
        __load()
    }

    get(key: String, default: _ = nil) -> _ {
        __load()[key] ?? default
    }

    set(key: String, value: _) -> _ {
        __load()[key] = value
        dirty? = true
        value
    }

    [](key: String) -> _ {
        __load()[key]
    }

    []=(key: String, value: _) -> _ {
        set(key, value)
    }

    contains?(key: String) -> Bool {
        __load().contains?(key)
    }

    remove(key: String) {
        __load().remove(key)
        dirty? = true
    }

    clear() {
        __data = %{}
        dirty? = true
    }

    /// Issues a new session id keeping the data (use after login).
    regenerate() {
        __load()
        __rotate? = true
        dirty? = true
    }

    /// Deletes the session and expires its cookie.
    destroy() {
        __load()
        destroyed? = true
    }

    rotate? -> Bool {
        __rotate?
    }
}

/// Session middleware. With the default cookie store all data lives in a
/// signed (not encrypted) cookie, so clients can read but not alter it;
/// pass `store: MemoryStore()` or your own store (`load`, `save`, `destroy`)
/// to keep data server-side.
pub class Sessions {
    secrets:   Array[String]
    store:     _
    name:      String
    max-age:   Int
    path:      String
    domain:    String | nil
    secure:    Bool | nil
    same-site: String
    rolling:   Bool

    init(
        secret: String | Array[String],
        store: _ = nil,
        name: String = 'session',
        max-age: Int = 14 * 24 * 3600,
        path: String = '/',
        domain: String | nil = nil,
        secure: Bool | nil = nil,
        same-site: String = 'Lax',
        rolling: Bool = false
    ) {
        secrets = (secret :: String) ? [secret] : secret
        if !secrets || secrets.any?(\_.size() < 16) {
            throw ValueError('http: session secrets must be at least 16 characters')
        }
        self.store     = store
        self.name      = name
        self.max-age   = max-age
        self.path      = path
        self.domain    = domain
        self.secure    = secure
        self.same-site = same-site
        self.rolling   = rolling
    }

    __load(req: Request) -> (String | nil, Dict[String, _] | nil) {
        let $raw = req.cookie(name) or return (nil, nil)
        let $value = unsign(raw, secrets) or return (nil, nil)

        if store == nil {
            let $blob = ssl.b64url-decode(value) or return (nil, nil)
            let payload = try { json.parse(blob.str!()) } catch _ { nil }
            if payload :: Dict && (payload['exp'] ?? 0) > time.utc() {
                return (nil, payload['data'])
            }
            (nil, nil)
        } else {
            match store.load(value) {
                nil  => (nil, nil),
                data => (value, data)
            }
        }
    }

    __cookie(rsp: Response, value: String) {
        rsp.set-cookie(
            name,
            value,
            max-age: max-age,
            path: path,
            domain: domain,
            secure: secure,
            http-only: true,
            same-site: same-site
        )
    }

    commit(req: Request, rsp: Response, s: Session) {
        if !s.loaded? {
            return
        }

        if s.destroyed? {
            if let $sid = s.id {
                if store != nil {
                    store.destroy(sid)
                }
            }
            if !s.new? {
                rsp.clear-cookie(name, path: path, domain: domain)
            }
            return
        }

        if !s.dirty? && !(rolling && !s.new?) {
            return
        }

        if s.new? && #s.data == 0 {
            return
        }

        if store == nil {
            let payload = json.encode(%{'exp': time.utc() + max-age, 'data': s.data})
            let value = sign(ssl.b64url(payload), secrets)
            if value.size() + name.size() > MAX_COOKIE {
                throw RuntimeError("http: session cookie too large ({value.size()} bytes); use a server-side store")
            }
            __cookie(rsp, value)
            return
        }

        if s.rotate? {
            if let $sid = s.id {
                store.destroy(sid)
                s.id = nil
            }
        }

        let id = s.id ?? new-id()
        s.id = id
        store.save(id, s.data, float(max-age))
        __cookie(rsp, sign(id, secrets))
    }

    middleware(req: Request, rsp: Response, next: () -> _) {
        let s = Session(-> __load(req))
        req.session = s
        rsp.on-headers(_ -> commit(req, rsp, s))
        next()
    }
}
