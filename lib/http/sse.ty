/**
 * Server-Sent Events (text/event-stream): `event-chunk` encodes events for
 * the server's `EventStream`; `Parser` decodes a stream on the client side
 * following the WHATWG event-stream interpretation rules.
 */
import json

/// One received event. `data` is the joined `data:` lines; `id` is the last
/// event id seen on the stream (it persists across events, as in browsers).
pub class Event {
    event: String
    data:  String
    id:    String | nil
    retry: Int | nil

    init(event: String = 'message', data: String = '', id: String | nil = nil, retry: Int | nil = nil) {
        self.event = event
        self.data  = data
        self.id    = id
        self.retry = retry
    }

    /// `data` decoded as JSON.
    json() -> _ {
        json::parse(data)
    }

    __str__() -> String {
        event-chunk(data, (event == 'message') ? nil : event, id, retry).strip-right()
    }

    __repr__() -> String {
        "Event(event: {event}, data: {data}, id: {id})"
    }
}

pub fn event-chunk(data: _, event: ?String = nil, id: String | Int | nil = nil, retry: ?Int = nil) -> String {
    let out = []

    if event != nil {
        out.push("event: {event.sub(/[\r\n]/, ' ')}\n")
    }

    if id != nil {
        out.push("id: {str(id).sub(/[\r\n]/, ' ')}\n")
    }

    if retry != nil {
        out.push("retry: {retry}\n")
    }

    let text = match data {
        nil       => nil,
        s: String => s,
        b: Blob   => b.str!(),
        x         => json::encode(x)
    }

    if text != nil {
        for line in text.split(/\r\n|\r|\n/) {
            out.push("data: {line}\n")
        }
    }

    out.push('\n')
    out.join('')
}

/// Incremental event-stream decoder: `feed(bytes)` returns the events that
/// the bytes completed.
pub class Parser {
    last-id: String | nil
    retry:   Int | nil

    __buf:   Blob
    __event: String
    __data:  Array[String]
    __any?:  Bool
    __bom?:  Bool
    __cr?:   Bool

    init(last-id: String | nil = nil) {
        self.last-id = last-id
        retry   = nil
        __buf   = Blob()
        __event = ''
        __data  = []
        __any?  = false
        __bom?  = true
        __cr?   = false
    }

    feed(chunk: String | Blob) -> Array[Event] {
        __buf.push(chunk)
        let out = []
        if __bom? && #__buf >= 3 {
            if __buf[0] == 0xEF && __buf[1] == 0xBB && __buf[2] == 0xBF {
                __buf.clear(0, 3)
            }
            __bom? = false
        }
        let start = 0
        let i = 0
        let n = #__buf
        while i < n {
            let c = __buf[i]
            if c == 10 && __cr? {
                __cr? = false
                start = i + 1
                i += 1
                continue
            }
            __cr? = false
            if c == 10 || c == 13 {
                __line(__buf.str(start, i - start, lossy: true), out)
                __cr? = c == 13
                start = i + 1
            }
            i += 1
        }
        __buf.clear(0, start)
        out
    }

    /// Dispatches a final event left without a trailing blank line.
    finish() -> Array[Event] {
        let out = []
        if #__buf > 0 {
            __line(__buf.str(lossy: true), out)
            __buf.clear()
        }
        out
    }

    __line(line: String, out: Array[Event]) {
        if line == '' {
            if __any? {
                out.push(Event((__event == '') ? 'message' : __event, __data.join('\n'), last-id, retry))
            }
            __event = ''
            __data  = []
            __any?  = false
            return
        }
        if line.starts?(':') {
            return
        }
        let [_, field, value] = line.match(/^([^:]*):?\x20?(.*)$/) ?? return
        match field {
            'event' => __event = value,
            'data'  => {
                __data.push(value)
                __any? = true
            },
            'id' => {
                if !value.contains?('\x00') {
                    last-id = value
                }
            },
            'retry' => {
                if value.match?(/^\d+$/) {
                    retry = int(value, 10)
                }
            },
            _ => {}
        }
    }
}
