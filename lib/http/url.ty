import _http as hc

const DEFAULT_PORTS = %{'http': 80, 'https': 443, 'ws': 80, 'wss': 443}

pub const PATH_UNSAFE     = 1
pub const QUERY_UNSAFE    = 2
pub const USERINFO_UNSAFE = 3

pub class InvalidURL < ValueError {
    init(what: String) {
        super("http: invalid URL: {what}")
    }
}

fn remove-dots(path: String) -> String {
    if !path.contains?('.') {
        return path
    }
    let input = path.split('/')
    let out = []
    for seg; i in input {
        let last? = i == #input - 1
        match seg {
            '.' => {
                if last? {
                    out.push('')
                }
            },
            '..' => {
                if #out > 1 || (#out == 1 && out[0] != '') {
                    out.pop()
                }
                if last? {
                    out.push('')
                }
            },
            _ => out.push(seg)
        }
    }
    let s = out.join('/')
    (path.starts?('/') && !s.starts?('/')) ? "/{s}" : s
}

fn merge(base: URL, path: String) -> String {
    if base.host != nil && base.path == '' {
        return "/{path}"
    }
    "{base.path.comb(/[^\/]*$/)}{path}"
}

pub use QueryParams = String | Dict[String, _] | Array[(String, _)] | Tuple

/// A parsed absolute or relative URL (RFC 3986). Hosts are lower-cased and
/// IDNA-encoded, and characters that are not valid in a component are
/// percent-encoded; existing `%XX` escapes are kept as they are.
///
/// ```
/// let u = URL('https://example.com/a/b?x=1')
/// u.join('../c').str()            // https://example.com/c
/// u.with(params: {y: 2}).query    // x=1&y=2
/// ```
pub class URL {
    scheme:   String | nil
    username: String | nil
    password: String | nil
    host:     String | nil
    port:     Int | nil
    path:     String
    query:    String | nil
    fragment: String | nil

    init(
        url: String | URL = '',
        scheme: String | nil = nil,
        host: String | nil = nil,
        port: Int | nil = nil,
        path: String | nil = nil,
        query: String | nil = nil,
        params: QueryParams | nil = nil,
        fragment: String | nil = nil,
        username: String | nil = nil,
        password: String | nil = nil
    ) {
        match url {
            u: URL => {
                self.scheme   = u.scheme
                self.username = u.username
                self.password = u.password
                self.host     = u.host
                self.port     = u.port
                self.path     = u.path
                self.query    = u.query
                self.fragment = u.fragment
            },
            s: String => __parse(s)
        }

        if scheme != nil {
            self.scheme = scheme.lower()
        }
        if host != nil {
            self.host = hc.idna(host.comb(/^\[|\]$/))
        }
        if port != nil {
            self.port = port
        }
        if path != nil {
            self.path = hc.percent-encode(path, PATH_UNSAFE)
        }
        if query != nil {
            self.query = hc.percent-encode(query, QUERY_UNSAFE)
        }
        if fragment != nil {
            self.fragment = hc.percent-encode(fragment, QUERY_UNSAFE)
        }
        if username != nil {
            self.username = hc.percent-encode(username, USERINFO_UNSAFE)
        }
        if password != nil {
            self.password = hc.percent-encode(password, USERINFO_UNSAFE)
        }
        if params != nil {
            let extra = (params :: String) ? params : hc.encode-query(params)
            if extra != '' {
                self.query = (self.query == nil || self.query == '') ? extra : "{self.query}&{extra}"
            }
        }
        if self.host != nil && self.path == '' && self.scheme != nil && DEFAULT_PORTS[self.scheme] != nil {
            self.path = '/'
        }
    }

    __parse(s: String) {
        if !hc.parse-url(self, s) {
            throw InvalidURL(s)
        }
    }

    absolute? -> Bool {
        scheme != nil && host != nil
    }

    relative? -> Bool {
        !absolute?
    }

    secure? -> Bool {
        scheme == 'https' || scheme == 'wss'
    }

    default-port -> Int | nil {
        DEFAULT_PORTS[scheme ?? '']
    }

    /// The explicit port, or the scheme's default.
    effective-port -> Int | nil {
        port ?? default-port
    }

    /// Host with brackets around IPv6 literals.
    host-literal -> String {
        let h = host ?? ''
        h.contains?(':') ? "[{h}]" : h
    }

    /// Host plus the port when it is not the scheme's default (the Host header).
    authority -> String {
        (port == nil || port == default-port) ? host-literal : "{host-literal}:{port}"
    }

    origin -> String {
        "{scheme}://{authority}"
    }

    /// Path and query, as sent in a request line.
    target -> String {
        let p = (path == '') ? '/' : path
        (query == nil) ? p : "{p}?{query}"
    }

    userinfo -> String | nil {
        match (username, password) {
            (nil, _)  => nil,
            (u, nil)  => u,
            (u, p)    => "{u}:{p}"
        }
    }

    /// Decoded query parameters.
    params -> Dict[String, String | Array[String | nil] | nil] {
        (query == nil || query == '') ? %{} : hc.decode-query(query)
    }

    /// Resolves `ref` against this URL (RFC 3986 section 5.2).
    join(ref: String | URL) -> URL {
        let r = (ref :: URL) ? ref : URL(ref)

        let t = URL()


        if r.scheme != nil {
            t.scheme   = r.scheme
            t.__authority-from(r)
            t.path     = remove-dots(r.path)
            t.query    = r.query
        } else {
            if r.host != nil {
                t.__authority-from(r)
                t.path  = remove-dots(r.path)
                t.query = r.query
            } else {
                if r.path == '' {
                    t.path  = path
                    t.query = r.query ?? query
                } else {
                    t.path  = r.path.starts?('/') ? remove-dots(r.path) : remove-dots(merge(self, r.path))
                    t.query = r.query
                }
                t.__authority-from(self)
            }
            t.scheme = scheme
        }

        t.fragment = r.fragment

        if t.host != nil && t.path == '' {
            t.path = '/'
        }

        t
    }

    __authority-from(u: URL) {
        username = u.username
        password = u.password
        host     = u.host
        port     = u.port
    }

    /// A copy with the given components replaced; `params` are appended to
    /// the query.
    with(%kwargs) -> URL {
        URL(self, **kwargs)
    }

    /// A copy without user info or fragment.
    without-credentials() -> URL {
        let u = URL(self)
        u.username = nil
        u.password = nil
        u.fragment = nil
        u
    }

    same-origin?(other: URL) -> Bool {
        scheme == other.scheme && host == other.host && effective-port == other.effective-port
    }

    __str__() -> String {
        let out = []
        if scheme != nil {
            out.push("{scheme}:")
        }
        if host != nil {
            out.push('//')
            if let $ui = userinfo {
                out.push("{ui}@")
            }
            out.push(authority)
        }
        out.push(path)
        if query != nil {
            out.push("?{query}")
        }
        if fragment != nil {
            out.push("#{fragment}")
        }
        out.join('')
    }

    __repr__() -> String {
        "URL('{self}')"
    }

    ==(other: Any) -> Bool {
        match other {
            u: URL    => str(self) == str(u),
            s: String => str(self) == s,
            _         => false
        }
    }
}

hc.setup-url(URL)
