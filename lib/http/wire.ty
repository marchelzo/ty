import jit (kernel!)
import json
import http.core (parse-cookies)
import http.headers (Headers)
import http.display as display
import http.form (
    HttpHeaders,
    HttpVersion,
    decode-query,
    multipart,
    MultipartData
)

const TCHAR = 1
const VCHAR = 2
const FIELD = 4
const DIGIT = 8
const HEX   = 16
const UPPER = 32

const CONTENT_LENGTH    = 'content-length'
const TRANSFER_ENCODING = 'transfer-encoding'
const CONNECTION        = 'connection'
const EXPECT            = 'expect'
const CONTENT_TYPE      = 'content-type'
const CHUNKED           = 'chunked'
const CLOSE             = 'close'
const KEEP_ALIVE        = 'keep-alive'
const CONTINUE          = '100-continue'
const HOST              = 'host'
const UPGRADE           = 'upgrade'

const F_CHUNKED    = 1
const F_CLOSE      = 2
const F_KEEP_ALIVE = 4
const F_CONTINUE   = 8
const F_HOST       = 16
const F_UPGRADE    = 32
const F_CODED      = 64

const PREFIX = 'HTTP/'

const M_OFF = 0
const M_LEN = 1
const T_OFF = 2
const T_LEN = 3
const MINOR = 4
const NHEAD = 5
const CLEN  = 6
const FLAGS = 7
const CTYPE = 8
const HEAD  = 9

const E_REQUEST_LINE = -1
const E_VERSION      = -2
const E_HEADER       = -3
const E_TOO_MANY     = -4
const E_LENGTH       = -5
const E_FRAMING      = -6

pub const MAX_HEADERS = 100
pub const MAX_HEAD    = 1 << 16
pub const MAX_BODY    = 1 << 26

let CLASSES = Blob.zeros(256)

for c in 0..256 {
    let ch = chr(c)
    let visible? = c > 32 && c < 127
    let tchar? = ch.match?(/^[!#$%&'*+\-.^_`|~0-9A-Za-z]$/) && c < 128
    CLASSES[c] = (tchar? ? TCHAR : 0)
               | (visible? ? VCHAR : 0)
               | ((visible? || c >= 128 || c == 32 || c == 9) ? FIELD : 0)
               | ((c >= 48 && c <= 57) ? DIGIT : 0)
               | (ch.match?(/^[0-9A-Fa-f]$/) && c < 128 ? HEX : 0)
               | ((c >= 65 && c <= 90) ? UPPER : 0)
}

kernel! fn lower-eq?(b: Blob, off: Int, len: Int, w: String, cls: Blob) -> Bool {
    if len != w.size() {
        return false
    }
    for k in ..len {
        let c = b[off + k]
        if (c | (cls[c] & UPPER)) != w.byte(k) {
            return false
        }
    }
    true
}

kernel! fn decimal(b: Blob, off: Int, len: Int, cls: Blob) -> Int {
    if len == 0 || len > 15 {
        return -1
    }
    let n = 0
    for k in ..len {
        let c = b[off + k]
        if (cls[c] & DIGIT) == 0 {
            return -1
        }
        n = n * 10 + c - 48
    }
    n
}

kernel! fn scan-fields(b: Blob, start: Int, at: Int, end: Int, cls: Blob, out: Array[Int], resp?: Bool) -> Int {
    let i = at
    let n = 0
    let length = -1
    let fl = 0
    let ctype = -1

    while true {
        if end - i < 2 {
            return 0
        }

        if b[i] == 13 {
            if b[i + 1] != 10 {
                return E_HEADER
            }
            if (fl & F_CHUNKED) != 0 && length >= 0 {
                if !resp? {
                    return E_LENGTH
                }
                length = -1
                fl = fl | F_CLOSE
            }
            out[NHEAD] = n
            out[CLEN] = length
            out[FLAGS] = fl
            out[CTYPE] = ctype
            return i + 2 - start
        }

        let k = i
        while i < end && (cls[b[i]] & TCHAR) != 0 {
            i += 1
        }
        if i == end {
            return 0
        }
        if i == k || b[i] != 58 {
            return E_HEADER
        }
        let klen = i - k
        i += 1

        while i < end && (b[i] == 32 || b[i] == 9) {
            i += 1
        }
        let v = i
        let e = i
        while i < end && (cls[b[i]] & FIELD) != 0 {
            if b[i] != 32 && b[i] != 9 {
                e = i + 1
            }
            i += 1
        }
        if end - i < 2 {
            return 0
        }
        if b[i] != 13 || b[i + 1] != 10 {
            return E_HEADER
        }
        i += 2

        let o = HEAD + n * 4
        if o + 4 > #out {
            return E_TOO_MANY
        }
        out[o] = k
        out[o + 1] = klen
        out[o + 2] = v
        out[o + 3] = e - v

        let vlen = e - v
        if klen == 14 && lower-eq?(b, k, klen, CONTENT_LENGTH, cls) {
            let x = decimal(b, v, vlen, cls)
            if x < 0 || (length >= 0 && x != length) {
                return E_LENGTH
            }
            length = x
        } else if klen == 17 && lower-eq?(b, k, klen, TRANSFER_ENCODING, cls) {
            if lower-eq?(b, v, vlen, CHUNKED, cls) && (fl & F_CHUNKED) == 0 {
                fl = fl | F_CHUNKED
            } else if !resp? {
                return E_FRAMING
            } else if vlen > 7 && lower-eq?(b, e - 7, 7, CHUNKED, cls) && (b[e - 8] == 44 || b[e - 8] == 32) {
                fl = fl | F_CHUNKED | F_CODED
            } else {
                fl = (fl & ~F_CHUNKED) | F_CODED | F_CLOSE
            }
        } else if klen == 10 && lower-eq?(b, k, klen, CONNECTION, cls) {
            if lower-eq?(b, v, vlen, CLOSE, cls) {
                fl = fl | F_CLOSE
            } else if lower-eq?(b, v, vlen, KEEP_ALIVE, cls) {
                fl = fl | F_KEEP_ALIVE
            }
        } else if klen == 4 && lower-eq?(b, k, klen, HOST, cls) {
            fl = fl | F_HOST
        } else if klen == 7 && lower-eq?(b, k, klen, UPGRADE, cls) {
            fl = fl | F_UPGRADE
        } else if klen == 6 && lower-eq?(b, k, klen, EXPECT, cls) {
            if lower-eq?(b, v, vlen, CONTINUE, cls) {
                fl = fl | F_CONTINUE
            }
        } else if klen == 12 && lower-eq?(b, k, klen, CONTENT_TYPE, cls) {
            ctype = n
        }

        n += 1
    }

    0
}

kernel! fn scan-head(b: Blob, start: Int, end: Int, cls: Blob, out: Array[Int]) -> Int {
    let i = start
    while i < end && (b[i] == 13 || b[i] == 10) {
        i += 1
    }

    let m = i
    while i < end && (cls[b[i]] & TCHAR) != 0 {
        i += 1
    }
    if i == end {
        return 0
    }
    if i == m || b[i] != 32 {
        return E_REQUEST_LINE
    }
    out[M_OFF] = m
    out[M_LEN] = i - m
    i += 1

    let t = i
    while i < end && (cls[b[i]] & VCHAR) != 0 {
        i += 1
    }
    if i == end {
        return 0
    }
    if i == t || b[i] != 32 {
        return E_REQUEST_LINE
    }
    out[T_OFF] = t
    out[T_LEN] = i - t
    i += 1

    if end - i < 10 {
        return 0
    }
    if b[i] != 72 || b[i + 1] != 84 || b[i + 2] != 84 || b[i + 3] != 80 || b[i + 4] != 47 {
        return E_REQUEST_LINE
    }
    if (cls[b[i + 5]] & DIGIT) == 0 || b[i + 6] != 46 || (cls[b[i + 7]] & DIGIT) == 0 {
        return E_REQUEST_LINE
    }
    if b[i + 8] != 13 || b[i + 9] != 10 {
        return E_REQUEST_LINE
    }
    if b[i + 5] != 49 {
        return E_VERSION
    }
    out[MINOR] = b[i + 7] - 48
    i += 10

    scan-fields(b, start, i, end, cls, out, false)
}

kernel! fn scan-status(b: Blob, start: Int, end: Int, cls: Blob, out: Array[Int]) -> Int {
    let i = start

    if end - i < 12 {
        for k in ..min(5, end - i) {
            if b[i + k] != PREFIX.byte(k) {
                return E_REQUEST_LINE
            }
        }
        return 0
    }
    if b[i] != 72 || b[i + 1] != 84 || b[i + 2] != 84 || b[i + 3] != 80 || b[i + 4] != 47 {
        return E_REQUEST_LINE
    }
    if (cls[b[i + 5]] & DIGIT) == 0 || b[i + 6] != 46 || (cls[b[i + 7]] & DIGIT) == 0 || b[i + 8] != 32 {
        return E_REQUEST_LINE
    }
    if b[i + 5] != 49 {
        return E_VERSION
    }
    out[MINOR] = b[i + 7] - 48
    i += 9

    let code = 0
    for k in ..3 {
        let c = b[i + k]
        if (cls[c] & DIGIT) == 0 {
            return E_REQUEST_LINE
        }
        code = code * 10 + c - 48
    }
    i += 3
    out[M_OFF] = code
    out[M_LEN] = 0

    if i < end && b[i] == 32 {
        i += 1
    }
    let r = i
    while i < end && b[i] != 13 {
        if (cls[b[i]] & FIELD) == 0 {
            return E_REQUEST_LINE
        }
        i += 1
    }
    if end - i < 2 {
        return 0
    }
    if b[i + 1] != 10 {
        return E_REQUEST_LINE
    }
    out[T_OFF] = r
    out[T_LEN] = i - r
    i += 2

    scan-fields(b, start, i, end, cls, out, true)
}

kernel! fn dechunk(b: Blob, start: Int, end: Int, cls: Blob, dst: Blob, out: Array[Int]) -> Int {
    let i = start
    let o = 0

    while true {
        let size = 0
        let digits = 0
        while i < end && (cls[b[i]] & HEX) != 0 {
            let c = b[i]
            size = size * 16 + (((cls[c] & DIGIT) != 0) ? c - 48 : (c | 32) - 87)
            digits += 1
            if digits > 15 {
                return -1
            }
            i += 1
        }
        if i == end {
            return 0
        }
        if digits == 0 {
            return -1
        }
        while i < end && b[i] != 13 {
            if (cls[b[i]] & FIELD) == 0 {
                return -1
            }
            i += 1
        }
        if end - i < 2 {
            return 0
        }
        if b[i + 1] != 10 {
            return -1
        }
        i += 2

        if size == 0 {
            while true {
                if end - i < 2 {
                    return 0
                }
                if b[i] == 13 && b[i + 1] == 10 {
                    out[0] = o
                    return i + 2 - start
                }
                while i < end && b[i] != 13 {
                    i += 1
                }
                if end - i < 2 {
                    return 0
                }
                if b[i + 1] != 10 {
                    return -1
                }
                i += 2
            }
        }

        if end - i < size + 2 {
            return 0
        }
        for k in ..size {
            dst[o + k] = b[i + k]
        }
        o += size
        i += size
        if b[i] != 13 || b[i + 1] != 10 {
            return -1
        }
        i += 2
    }

    0
}

kernel! fn pack-head(buf: Blob, start: Int, hlen: Int, marks: Array[Int], k: Int, base: Int, head: Blob) {
    for i in ..hlen {
        head[i] = buf[start + i]
    }
    for i in ..k {
        let offset? = (i < HEAD) ? (i == M_OFF || i == T_OFF) : ((i - HEAD) & 1) == 0
        head.i32[base + i] = offset? ? marks[i] - start : marks[i]
    }
}

kernel! fn mark(head: Blob, i: Int) -> Int {
    head.i32[i]
}

pub tag NeedMore;
pub tag Ready;
pub tag Invalid;

pub use ParseResult = NeedMore[(Int | nil, Bool)] | Ready[(Request, Int)] | Invalid[Int];

const V10 = {major: 1, minor: 0}
const V11 = {major: 1, minor: 1}
const V20 = {major: 2, minor: 0}

const MULTIPART = /^multipart\/form-data;\s*boundary="?([^";]+)"?/

pub class Request {
    method:   String
    target:   String
    url:      String
    version:  HttpVersion
    body:     String | nil
    files:    Dict[String, _]
    scheme:   String
    remote:   String | nil
    route:    String | nil
    id:       String | nil
    start:    Float
    session:  _

    __head:    Blob | nil
    __base:    Int
    __flags:   Int
    __ctype:   String | nil
    __query:   String | nil
    __headers: HttpHeaders | nil
    __hview:   Headers | nil
    __params:  Dict[String, String | [String | nil] | nil] | nil
    __valid?:  Bool
    __queue:   _
    __served?: Bool
    __cookies: Dict[String, String] | nil

    init(
        method: String,
        target: String,
        version: HttpVersion,
        body: String | nil,
        flags: Int = 0,
        head: Blob | nil = nil,
        base: Int = 0,
        headers: HttpHeaders | nil = nil,
        content-type: String | nil = nil
    ) {
        self.method  = method
        self.target  = target
        self.version = version
        self.body    = body
        files        = %{}
        scheme       = 'http'
        id           = nil
        start        = 0.0
        session      = nil
        __cookies    = nil
        __flags      = flags
        __head       = head
        __base       = base
        __headers    = headers
        __hview      = nil
        __ctype      = content-type
        __queue      = nil
        __served?    = false

        match target.bsearch('?') {
            nil => (url, __query) = (target, nil),
            i   => (url, __query) = (target.bslice(0, i), target.bslice(i + 1))
        }

        __valid? = (body == nil) || __decode-multipart()
    }

    static parsed(head: Blob, base: Int, body: String | nil) -> Request {
        let m = (i: Int) -> mark(head, base + i)
        let ctype = match m(CTYPE) {
            -1 => nil,
            i  => head.str!(m(HEAD + i * 4 + 2), m(HEAD + i * 4 + 3))
        }
        Request(
            head.str!(m(M_OFF), m(M_LEN)),
            head.str!(m(T_OFF), m(T_LEN)),
            (m(MINOR) == 0) ? V10 : V11,
            body,
            m(FLAGS),
            head,
            base,
            nil,
            ctype
        )
    }

    static h2(
        method: String,
        target: String,
        headers: HttpHeaders,
        body: String | nil,
        scheme: String
    ) -> Request {
        let ctype = match headers['content-type'] {
            s: String => s,
            [s, *]    => s,
            _         => nil
        }
        let req = Request(method, target, V20, body, headers: headers, content-type: ctype)
        req.scheme = scheme
        req
    }

    __mark(i: Int) -> Int {
        match __head {
            nil  => -1,
            head => mark(head, __base + i)
        }
    }

    valid? -> Bool {
        __valid?
    }

    keep-alive? -> Bool {
        match version.major {
            2 => true,
            _ => (version.minor == 0) ? (__flags & F_KEEP_ALIVE) != 0 : (__flags & F_CLOSE) == 0
        }
    }

    expects-continue? -> Bool {
        (__flags & F_CONTINUE) != 0
    }

    host? -> Bool {
        (__head == nil) ? (__header-dict()['host'] != nil) : (__flags & F_HOST) != 0
    }

    upgrade? -> Bool {
        (__head == nil) ? (__header-dict()['upgrade'] != nil) : (__flags & F_UPGRADE) != 0
    }

    /// The request headers (case-insensitive lookups, repeated fields kept),
    /// the same `Headers` type the client uses.
    headers -> Headers {
        __hview ?? (__hview = Headers(__header-dict()))
    }

    __header-dict() -> HttpHeaders {
        __headers ?? (__headers = __decode-headers())
    }

    /// 'HTTP/1.0', 'HTTP/1.1' or 'HTTP/2', like the client's
    /// `Response.http-version`.
    http-version -> String {
        (version.major == 2) ? 'HTTP/2' : "HTTP/1.{version.minor}"
    }

    header(name: String) -> String | nil {
        let want = name.lower()

        if __head == nil || __headers != nil {
            let found = nil
            for k, v in __header-dict() {
                if k.lower() == want {
                    let s = (v :: String) ? v : v.join(', ')
                    found = (found == nil) ? s : "{found}, {s}"
                }
            }
            return found
        }

        let $head = __head or return nil
        let found = nil
        for i in ..__mark(NHEAD) {
            let o = HEAD + i * 4
            if __mark(o + 1) == want.size() && head.str!(__mark(o), __mark(o + 1)).lower() == want {
                let v = head.str!(__mark(o + 2), __mark(o + 3))
                found = (found == nil) ? v : "{found}, {v}"
            }
        }
        found
    }

    params -> Dict[String, String | [String | nil] | nil] {
        __params ?? (__params = __decode-params())
    }

    query -> String | nil {
        __query
    }

    content-type -> String | nil {
        __ctype
    }

    json() -> _ {
        match body {
            nil     => nil,
            s       => json::parse(s)
        }
    }

    __decode-headers() -> HttpHeaders {
        let headers = %{}
        let head = __head ?? return headers
        for i in ..__mark(NHEAD) {
            let o     = HEAD + i * 4
            let name  = head.str!(__mark(o), __mark(o + 1))
            let value = head.str!(__mark(o + 2), __mark(o + 3))
            match headers[name] {
                nil               => headers[name] = value,
                vs: Array[String] => vs.push(value),
                v                 => headers[name] = [v, value]
            }
        }
        headers
    }

    __decode-params() -> Dict[String, String | [String | nil] | nil] {
        let params = (__query == nil) ? %{} : decode-query(__query)
        if content-type == 'application/x-www-form-urlencoded' && body != nil {
            params.update(decode-query(body))
        }
        params
    }

    __decode-multipart() -> Bool {
        let $type = __ctype or return true
        let [_, boundary] = type.match(MULTIPART) or return true
        let parts = multipart(boundary)
        parts()
        match parts(body ?? '') {
            Some(MultipartData(form, files)) => do {
                self.files.update(files)
                params.update(form)
                body = nil
                true
            },
            _ => false
        }
    }

    cookies -> Dict[String, String] {
        __cookies ?? (__cookies = parse-cookies(header('cookie')))
    }

    cookie(name: String) -> String | nil {
        cookies[name]
    }

    /// Renders the request (start line, headers, formatted body) like the
    /// client's `Response.pretty`.
    pretty(body: Bool = true, color: Bool | nil = nil, limit: Int | nil = 8192) -> String {
        let col = color ?? display.color?()
        display.message(display.request-line(method, target, http-version, col), headers.items(), self.body, content-type, col, limit, body)
    }

    show(%kwargs) {
        print(pretty(**kwargs))
    }

    attach-body(queue: _) {
        __queue = queue
    }

    read(max: Int = 65536) -> Blob | nil {
        if let $q = __queue {
            return q.read(max)
        }
        if __served? || body == nil {
            return nil
        }
        __served? = true
        Blob(body)
    }

    read-all() -> Blob {
        let out = Blob()
        while let $chunk = read() {
            out.push(chunk)
        }
        out
    }

    end() {
    }
}

fn status-of(err: Int) -> Int {
    match err {
        E_VERSION  => 505,
        E_TOO_MANY => 431,
        E_FRAMING  => 501,
        _          => 400
    }
}

pub fn marks(max-headers: Int = MAX_HEADERS) -> Array[Int] {
    [0] * (HEAD + 4 * max-headers)
}

fn body-of(buf: Blob, at: Int, end: Int, marks: Array[Int]) -> (Int, String | nil) | Int {
    if (marks[FLAGS] & F_CHUNKED) == 0 {
        let n = max(marks[CLEN], 0)
        return (end - at >= n) ? (n, (n == 0) ? nil : buf.str!(at, n)) : n
    }

    let dst = Blob.zeros(end - at)
    let out = [0]
    match dechunk(buf, at, end, CLASSES, dst, out) {
        0  => -1,
        -1 => -2,
        n  => (n, dst.str!(0, out[0]))
    }
}

pub fn parse(
    buf: Blob,
    start: Int,
    end: Int,
    marks: Array[Int],
    max-head: Int = MAX_HEAD,
    max-body: Int = MAX_BODY
) -> ParseResult {
    let hlen = scan-head(buf, start, end, CLASSES, marks)

    if hlen < 0 {
        return Invalid(status-of(hlen))
    }

    if hlen == 0 {
        return (end - start >= max-head) ? Invalid(431) : NeedMore(nil, false)
    }

    if hlen > max-head {
        return Invalid(431)
    }

    if marks[CLEN] > max-body {
        return Invalid(413)
    }

    let continue? = (marks[FLAGS] & F_CONTINUE) != 0

    match body-of(buf, start + hlen, end, marks) {
        -2 => Invalid(400),
        -1 => do {
            (end - start - hlen >= max-body + max-head) ? Invalid(413) : NeedMore(nil, continue?)
        },
        n: Int => NeedMore(hlen + n, continue?),
        (n, body) and body != nil && body.size() > max-body => Invalid(413),
        (n, body) => do {
            let k    = HEAD + 4 * marks[NHEAD]
            let base = (hlen + 3) / 4
            let head = Blob.zeros(4 * (base + k))
            pack-head(buf, start, hlen, marks, k, base, head)
            let req = Request.parsed(head, base, body)
            req.valid? ? Ready(req, hlen + n) : Invalid(400)
        }
    }
}

pub tag Head;

/// Parses only the request head. Returns `Head((req, hlen, length, chunked?))`,
/// `NeedMore((nil, false))` or `Invalid(status)`. `length` is -1 when absent.
pub fn parse-head(buf: Blob, start: Int, end: Int, marks: Array[Int], max-head: Int = MAX_HEAD) -> _ {
    let hlen = scan-head(buf, start, end, CLASSES, marks)

    if hlen < 0 {
        return Invalid(status-of(hlen))
    }

    if hlen == 0 {
        return (end - start >= max-head) ? Invalid(431) : NeedMore(nil, false)
    }

    if hlen > max-head {
        return Invalid(431)
    }

    let k    = HEAD + 4 * marks[NHEAD]
    let base = (hlen + 3) / 4
    let head = Blob.zeros(4 * (base + k))
    pack-head(buf, start, hlen, marks, k, base, head)

    Head((Request.parsed(head, base, nil), hlen, marks[CLEN], (marks[FLAGS] & F_CHUNKED) != 0))
}

pub fn expects-continue?(marks: Array[Int]) -> Bool {
    (marks[FLAGS] & F_CONTINUE) != 0
}

/// Incremental chunked-body decoder. `feed` consumes bytes from `buf`,
/// appending payload to `out`; returns the number of bytes consumed, or -1
/// on malformed input. `done?` becomes true after the last-chunk trailers.
pub class Dechunker {
    done?: Bool

    __state: Int
    __left:  Int
    __size:  Int
    __digits: Int
    __line:  Int

    init() {
        done?    = false
        __state  = 0
        __left   = 0
        __size   = 0
        __digits = 0
        __line   = 0
    }

    feed(buf: Blob, start: Int, end: Int, out: Blob) -> Int {
        let i = start
        while i < end && !done? {
            let c = buf[i]
            match __state {
                0 => {
                    if (CLASSES[c] & HEX) != 0 && __line == 0 {
                        __size = __size * 16 + (((CLASSES[c] & DIGIT) != 0) ? c - 48 : (c | 32) - 87)
                        __digits += 1
                        if __digits > 15 {
                            return -1
                        }
                    } else if c == 13 {
                        __state = 1
                    } else if __digits == 0 || (CLASSES[c] & FIELD) == 0 {
                        return -1
                    } else {
                        __line = 1
                    }
                    i += 1
                },
                1 => {
                    if c != 10 {
                        return -1
                    }
                    i += 1
                    __line = 0
                    __digits = 0
                    if __size == 0 {
                        __state = 4
                    } else {
                        __left = __size
                        __size = 0
                        __state = 2
                    }
                },
                2 => {
                    let n = min(__left, end - i)
                    out.push(buf.slice(i, n))
                    __left -= n
                    i += n
                    if __left == 0 {
                        __state = 3
                    }
                },
                3 => {
                    if __line == 0 {
                        if c != 13 {
                            return -1
                        }
                        __line = 1
                    } else {
                        if c != 10 {
                            return -1
                        }
                        __line = 0
                        __state = 0
                    }
                    i += 1
                },
                4 => {
                    if c == 13 {
                        __state = 5
                    } else {
                        __line = 1
                        __state = 6
                    }
                    i += 1
                },
                5 => {
                    if c != 10 {
                        return -1
                    }
                    i += 1
                    done? = true
                },
                6 => {
                    if c == 10 {
                        __state = 4
                    }
                    i += 1
                }
            }
        }
        i - start
    }
}

/// A parsed HTTP/1.x response head. `length` is -1 when the body is
/// delimited by chunking or by the connection closing.
pub class ResponseHead {
    status:      Int
    reason:      String
    minor:       Int
    headers:     Headers
    size:        Int
    length:      Int
    chunked?:    Bool
    close?:      Bool
    keep-alive?: Bool
    coded?:      Bool

    init(
        status: Int,
        reason: String,
        minor: Int,
        headers: Headers,
        size: Int,
        length: Int,
        flags: Int
    ) {
        self.status  = status
        self.reason  = reason
        self.minor   = minor
        self.headers = headers
        self.size    = size
        self.length  = length
        chunked?     = (flags & F_CHUNKED) != 0
        close?       = (flags & F_CLOSE) != 0
        keep-alive?  = (flags & F_KEEP_ALIVE) != 0
        coded?       = (flags & F_CODED) != 0
    }

    /// Whether the connection may carry another request afterwards.
    reusable? -> Bool {
        if close? || coded? {
            return false
        }
        (minor == 0) ? keep-alive? : true
    }
}

/// Parses a response head from `buf[start..end]`: a `ResponseHead`,
/// `NeedMore((nil, false))`, or `Invalid(code)` (code is an HTTP status
/// describing the defect).
pub fn parse-response(buf: Blob, start: Int, end: Int, marks: Array[Int], max-head: Int = MAX_HEAD) -> ResponseHead | ParseResult {
    let hlen = scan-status(buf, start, end, CLASSES, marks)

    if hlen < 0 {
        return Invalid(status-of(hlen))
    }

    if hlen == 0 {
        return (end - start >= max-head) ? Invalid(431) : NeedMore(nil, false)
    }

    if hlen > max-head {
        return Invalid(431)
    }

    let pairs = []
    for i in ..marks[NHEAD] {
        let o = HEAD + i * 4
        pairs.push((buf.str!(marks[o], marks[o + 1]), buf.str!(marks[o + 2], marks[o + 3])))
    }

    ResponseHead(
        marks[M_OFF],
        buf.str(marks[T_OFF], marks[T_LEN], lossy: true),
        marks[MINOR],
        Headers.raw(pairs),
        hlen,
        marks[CLEN],
        marks[FLAGS]
    )
}
