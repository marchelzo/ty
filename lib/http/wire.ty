import _http as hc (mark)
import json
import http.cookies (parse-cookies)
import http.headers (Headers)
import http.display as display
import http.form (
    HttpHeaders,
    HttpVersion,
    Upload,
    decode-query,
    multipart,
    MultipartData
)
import http.store (Session)

pub trait BodySource {
    read(max: Int) -> Blob | nil;
}

const F_CHUNKED    = 1
const F_CLOSE      = 2
const F_KEEP_ALIVE = 4
const F_CONTINUE   = 8
const F_HOST       = 16
const F_UPGRADE    = 32
const F_CODED      = 64

const M_OFF = 0
const M_LEN = 1
const T_OFF = 2
const T_LEN = 3
const MINOR = 4
const NHEAD = 5
const CLEN  = 6
const FLAGS = 7
const CTYPE = 8
const HEAD  = 9

const E_VERSION  = -2
const E_TOO_MANY = -4
const E_FRAMING  = -6

pub const MAX_HEADERS = 100
pub const MAX_HEAD    = 1 << 16
pub const MAX_BODY    = 1 << 26

pub tag NeedMore;
pub tag Ready;
pub tag Invalid;

pub use ParseResult = NeedMore[(Int | nil, Bool)] | Ready[(Request, Int)] | Invalid[Int];

const V10 = {major: 1, minor: 0}
const V11 = {major: 1, minor: 1}
const V20 = {major: 2, minor: 0}

const MULTIPART = /^multipart\/form-data;\s*boundary="?([^";]+)"?/

pub class Request {
    method:   String
    target:   String
    url:      String
    version:  HttpVersion
    body:     String | nil
    scheme:   String = 'http'
    remote:   String | nil
    route:    String | nil
    id:       String | nil
    start:    Float = 0.0
    session:  Session | nil

    __head:    String | nil
    __base:    Int
    __flags:   Int
    __ctype:   String | nil
    __query:   String | nil
    __headers: HttpHeaders | nil
    __hview:   Headers | nil
    __params:  Dict[String, String | [String | nil] | nil] | nil
    __valid?:  Bool
    __queue:   BodySource | nil
    __served?: Bool = false
    __cookies: Dict[String, String] | nil
    __files:   Dict[String, Upload] | nil

    init(
        method: String,
        target: String,
        version: HttpVersion,
        body: String | nil,
        flags: Int = 0,
        head: String | nil = nil,
        base: Int = 0,
        headers: HttpHeaders | nil = nil,
        content-type: String | nil = nil
    ) {
        self.method  = method
        self.target  = target
        self.version = version
        self.body    = body
        __flags      = flags
        __head       = head
        __base       = base
        __headers    = headers
        __ctype      = content-type

        match target.bsearch('?') {
            nil => url = target,
            i   => {
                url     = target.bslice(0, i)
                __query = target.bslice(i + 1)
            }
        }

        __valid? = (body == nil) || __decode-multipart()
    }

    static parsed(head: String, base: Int, body: String | nil) -> Request {
        let ctype = match mark(head, base + CTYPE) {
            -1 => nil,
            i  => head.bslice(mark(head, base + HEAD + i * 4 + 2), mark(head, base + HEAD + i * 4 + 3))
        }
        Request(
            head.bslice(mark(head, base + M_OFF), mark(head, base + M_LEN)),
            head.bslice(mark(head, base + T_OFF), mark(head, base + T_LEN)),
            (mark(head, base + MINOR) == 0) ? V10 : V11,
            body,
            mark(head, base + FLAGS),
            head,
            base,
            nil,
            ctype
        )
    }

    static h2(
        method: String,
        target: String,
        headers: HttpHeaders,
        body: String | nil,
        scheme: String
    ) -> Request {
        let ctype = match headers['content-type'] {
            s: String => s,
            [s, *]    => s,
            _         => nil
        }
        let req = Request(method, target, V20, body, headers: headers, content-type: ctype)
        req.scheme = scheme
        req
    }

    __mark(i: Int) -> Int {
        match __head {
            nil  => -1,
            head => mark(head, __base + i)
        }
    }

    /// Uploaded files of a multipart form, by field name.
    files -> Dict[String, Upload] {
        if let $f = __files {
            return f
        }
        let f: Dict[String, Upload] = %{}
        __files = f
        f
    }

    valid? -> Bool {
        __valid?
    }

    keep-alive? -> Bool {
        match version.major {
            2 => true,
            _ => (version.minor == 0) ? (__flags & F_KEEP_ALIVE) != 0 : (__flags & F_CLOSE) == 0
        }
    }

    expects-continue? -> Bool {
        (__flags & F_CONTINUE) != 0
    }

    host? -> Bool {
        (__head == nil) ? (__header-dict()['host'] != nil) : (__flags & F_HOST) != 0
    }

    upgrade? -> Bool {
        (__head == nil) ? (__header-dict()['upgrade'] != nil) : (__flags & F_UPGRADE) != 0
    }

    /// The request headers (case-insensitive lookups, repeated fields kept),
    /// the same `Headers` type the client uses.
    headers -> Headers {
        __hview ?? (__hview = Headers(__header-dict()))
    }

    __header-dict() -> HttpHeaders {
        __headers ?? (__headers = __decode-headers())
    }

    /// 'HTTP/1.0', 'HTTP/1.1' or 'HTTP/2', like the client's
    /// `Response.http-version`.
    http-version -> String {
        (version.major == 2) ? 'HTTP/2' : "HTTP/1.{version.minor}"
    }

    header(name: String) -> String | nil {
        if let $head = __head and __headers == nil {
            return hc.header(head, __base, name)
        }

        let found = nil
        for k, v in __header-dict() {
            if k.ieq?(name) {
                let s = (v :: String) ? v : v.join(', ')
                found = (found == nil) ? s : "{found}, {s}"
            }
        }
        found
    }

    params -> Dict[String, String | [String | nil] | nil] {
        __params ?? (__params = __decode-params())
    }

    query -> String | nil {
        __query
    }

    content-type -> String | nil {
        __ctype
    }

    json() -> _ {
        match body {
            nil     => nil,
            s       => json::parse(s)
        }
    }

    __decode-headers() -> HttpHeaders {
        let headers = %{}
        let head = __head ?? return headers
        for i in ..__mark(NHEAD) {
            let o     = HEAD + i * 4
            let name  = head.bslice(__mark(o), __mark(o + 1))
            let value = head.bslice(__mark(o + 2), __mark(o + 3))
            match headers[name] {
                nil               => headers[name] = value,
                vs: Array[String] => vs.push(value),
                v                 => headers[name] = [v, value]
            }
        }
        headers
    }

    __decode-params() -> Dict[String, String | [String | nil] | nil] {
        let params = (__query == nil) ? %{} : decode-query(__query)
        if content-type == 'application/x-www-form-urlencoded' && body != nil {
            params.update(decode-query(body))
        }
        params
    }

    __decode-multipart() -> Bool {
        let $type = __ctype or return true
        let [_, boundary] = type.match(MULTIPART) or return true
        let parts = multipart(boundary)
        parts()
        match parts(body ?? '') {
            Some(MultipartData(form, files)) => do {
                __files = files
                params.update(form)
                body = nil
                true
            },
            _ => false
        }
    }

    cookies -> Dict[String, String] {
        __cookies ?? (__cookies = parse-cookies(header('cookie')))
    }

    cookie(name: String) -> String | nil {
        cookies[name]
    }

    /// Renders the request (start line, headers, formatted body) like the
    /// client's `Response.pretty`.
    pretty(body: Bool = true, color: Bool | nil = nil, limit: Int | nil = 8192) -> String {
        let col = color ?? display.color?()
        display.message(display.request-line(method, target, http-version, col), headers.items(), self.body, content-type, col, limit, body)
    }

    show(%kwargs) {
        print(pretty(**kwargs))
    }

    attach-body(queue: BodySource) {
        __queue = queue
    }

    read(max: Int = 65536) -> Blob | nil {
        if let $q = __queue {
            return q.read(max)
        }
        if __served? || body == nil {
            return nil
        }
        __served? = true
        Blob(body)
    }

    read-all() -> Blob {
        let out = Blob()
        while let $chunk = read() {
            out.push(chunk)
        }
        out
    }

    end() {
    }
}

fn status-of(err: Int) -> Int {
    match err {
        E_VERSION  => 505,
        E_TOO_MANY => 431,
        E_FRAMING  => 501,
        _          => 400
    }
}

pub fn marks(max-headers: Int = MAX_HEADERS) -> Array[Int] {
    [0] * (HEAD + 4 * max-headers)
}

fn body-of(buf: Blob, at: Int, end: Int, marks: Array[Int]) -> (Int, String | nil) | Int {
    if (marks[FLAGS] & F_CHUNKED) == 0 {
        let n = max(marks[CLEN], 0)
        return (end - at >= n) ? (n, (n == 0) ? nil : buf.str!(at, n)) : n
    }

    match hc.dechunk(buf, at, end) {
        0         => -1,
        -1        => -2,
        (n, body) => (n, body),
        _         => -2
    }
}

pub fn parse(
    buf: Blob,
    start: Int,
    end: Int,
    marks: Array[Int],
    max-head: Int = MAX_HEAD,
    max-body: Int = MAX_BODY
) -> ParseResult {
    let hlen = hc.scan-head(buf, start, end, marks)

    if hlen < 0 {
        return Invalid(status-of(hlen))
    }

    if hlen == 0 {
        return (end - start >= max-head) ? Invalid(431) : NeedMore(nil, false)
    }

    if hlen > max-head {
        return Invalid(431)
    }

    if marks[CLEN] > max-body {
        return Invalid(413)
    }

    let continue? = (marks[FLAGS] & F_CONTINUE) != 0

    match body-of(buf, start + hlen, end, marks) {
        -2 => Invalid(400),
        -1 => do {
            (end - start - hlen >= max-body + max-head) ? Invalid(413) : NeedMore(nil, continue?)
        },
        n: Int => NeedMore(hlen + n, continue?),
        (n, body) and body != nil && body.size() > max-body => Invalid(413),
        (n, body) => do {
            let k    = HEAD + 4 * marks[NHEAD]
            let base = (hlen + 3) / 4
            let head = hc.pack-head(buf, start, hlen, marks, k, base)
            let req = Request.parsed(head, base, body)
            req.valid? ? Ready(req, hlen + n) : Invalid(400)
        }
    }
}

pub tag Head;

/// Parses only the request head. Returns `Head((req, hlen, length, chunked?))`,
/// `NeedMore((nil, false))` or `Invalid(status)`. `length` is -1 when absent.
pub fn parse-head(buf: Blob, start: Int, end: Int, marks: Array[Int], max-head: Int = MAX_HEAD) -> Head[(Request, Int, Int, Bool)] | NeedMore[(Int | nil, Bool)] | Invalid[Int] {
    let hlen = hc.scan-head(buf, start, end, marks)

    if hlen < 0 {
        return Invalid(status-of(hlen))
    }

    if hlen == 0 {
        return (end - start >= max-head) ? Invalid(431) : NeedMore(nil, false)
    }

    if hlen > max-head {
        return Invalid(431)
    }

    let k    = HEAD + 4 * marks[NHEAD]
    let base = (hlen + 3) / 4
    let head = hc.pack-head(buf, start, hlen, marks, k, base)

    Head((Request.parsed(head, base, nil), hlen, marks[CLEN], (marks[FLAGS] & F_CHUNKED) != 0))
}

pub fn expects-continue?(marks: Array[Int]) -> Bool {
    (marks[FLAGS] & F_CONTINUE) != 0
}

/// Incremental chunked-body decoder. `feed` consumes bytes from `buf`,
/// appending payload to `out`; returns the number of bytes consumed, or -1
/// on malformed input. `done?` becomes true after the last-chunk trailers.
pub class Dechunker {
    __st: Array[Int] = [0, 0, 0, 0, 0, 0]

    done? -> Bool {
        __st[5] != 0
    }

    feed(buf: Blob, start: Int, end: Int, out: Blob) -> Int {
        hc.dechunk-feed(__st, buf, start, end, out)
    }
}

/// A parsed HTTP/1.x response head. `length` is -1 when the body is
/// delimited by chunking or by the connection closing.
pub class ResponseHead {
    status:      Int
    reason:      String
    minor:       Int
    headers:     Headers
    size:        Int
    length:      Int
    chunked?:    Bool
    close?:      Bool
    keep-alive?: Bool
    coded?:      Bool

    init(
        status: Int,
        reason: String,
        minor: Int,
        headers: Headers,
        size: Int,
        length: Int,
        flags: Int
    ) {
        self.status  = status
        self.reason  = reason
        self.minor   = minor
        self.headers = headers
        self.size    = size
        self.length  = length
        chunked?     = (flags & F_CHUNKED) != 0
        close?       = (flags & F_CLOSE) != 0
        keep-alive?  = (flags & F_KEEP_ALIVE) != 0
        coded?       = (flags & F_CODED) != 0
    }

    /// Whether the connection may carry another request afterwards.
    reusable? -> Bool {
        if close? || coded? {
            return false
        }
        (minor == 0) ? keep-alive? : true
    }
}

/// Parses a response head from `buf[start..end]`: a `ResponseHead`,
/// `NeedMore((nil, false))`, or `Invalid(code)` (code is an HTTP status
/// describing the defect).
pub fn parse-response(buf: Blob, start: Int, end: Int, marks: Array[Int], max-head: Int = MAX_HEAD) -> ResponseHead | ParseResult {
    let hlen = hc.scan-status(buf, start, end, marks)

    if hlen < 0 {
        return Invalid(status-of(hlen))
    }

    if hlen == 0 {
        return (end - start >= max-head) ? Invalid(431) : NeedMore(nil, false)
    }

    if hlen > max-head {
        return Invalid(431)
    }

    let pairs = []
    for i in ..marks[NHEAD] {
        let o = HEAD + i * 4
        pairs.push((buf.str!(marks[o], marks[o + 1]), buf.str!(marks[o + 2], marks[o + 3])))
    }

    ResponseHead(
        marks[M_OFF],
        buf.str(marks[T_OFF], marks[T_LEN], lossy: true),
        marks[MINOR],
        Headers.raw(pairs),
        hlen,
        marks[CLEN],
        marks[FLAGS]
    )
}
