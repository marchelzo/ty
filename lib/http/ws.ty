import log
import ffi as c
import hash
import base64
import http.core (
    ConnectionClosed,
    Task,
    task,
    suspend,
    in-task?,
    on-loop?
)
import http.loop (Conn, Timer, Proto, READ)
import http.wire (Request)
import http.deflate (PerMessage, DeflateError)

pub const GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'

pub const OP_CONT   = 0x0
pub const OP_TEXT   = 0x1
pub const OP_BINARY = 0x2
pub const OP_CLOSE  = 0x8
pub const OP_PING   = 0x9
pub const OP_PONG   = 0xA

pub const CLOSE_NORMAL         = 1000
pub const CLOSE_GOING_AWAY     = 1001
pub const CLOSE_PROTOCOL_ERROR = 1002
pub const CLOSE_UNSUPPORTED    = 1003
pub const CLOSE_NO_STATUS      = 1005
pub const CLOSE_ABNORMAL       = 1006
pub const CLOSE_INVALID_DATA   = 1007
pub const CLOSE_POLICY         = 1008
pub const CLOSE_TOO_BIG        = 1009
pub const CLOSE_INTERNAL       = 1011

const CLOSE_GRACE = 5.0

pub fn accept-key(key: String) -> String {
    base64.encode(hash.sha1(key + GUID).digest())
}

fn valid-close-code?(code: Int) -> Bool {
    (code >= 1000 && code <= 1003)
 || (code >= 1007 && code <= 1011)
 || (code >= 3000 && code <= 4999)
}

pub fn frame(op: Int, payload: String | Blob, fin: Bool = true, mask: Blob | nil = nil, rsv1: Bool = false) -> Blob {
    let n = payload.size()
    let out = Blob()
    out.push((fin ? 0x80 : 0) | (rsv1 ? 0x40 : 0) | op)

    let m = (mask != nil) ? 0x80 : 0

    if n < 126 {
        out.push(m | n)
    } else if n < 65536 {
        out.push(m | 126)
        out.push((n >> 8) & 0xFF)
        out.push(n & 0xFF)
    } else {
        out.push(m | 127)
        for i in ..8 {
            out.push((n >> (56 - 8 * i)) & 0xFF)
        }
    }

    if let $key = mask {
        out.push(key)
        let body = Blob(payload)
        body.xor(key)
        out.push(body)
    } else {
        out.push(payload)
    }

    out
}

/// A server-side WebSocket connection. `send`, `ping` and `close` may be
/// called from any thread; `recv` must be called from the handler's task.
pub class WebSocket {
    request:      Request
    protocol:     String | nil
    close-code:   Int | nil
    close-reason: String | nil

    __proto: WSProto

    init(proto: WSProto, request: Request, protocol: String | nil) {
        __proto       = proto
        self.request  = request
        self.protocol = protocol
        close-code    = nil
        close-reason  = nil
    }

    closed? -> Bool {
        __proto.closed?
    }

    buffered -> Int {
        __proto.conn.buffered
    }

    recv() -> String | Blob | nil {
        __proto.recv()
    }

    send(msg: String | Blob) -> Bool {
        __proto.send-message(msg)
    }

    ping(data: String | Blob = '') -> Bool {
        let loop = __proto.conn.loop
        if !on-loop?(loop) {
            loop.post(-> __proto.control(OP_PING, data))
            return !closed?
        }
        __proto.control(OP_PING, data)
    }

    close(code: Int = CLOSE_NORMAL, reason: String = '') {
        let loop = __proto.conn.loop
        if !on-loop?(loop) {
            loop.post(-> __proto.start-close(code, reason))
            return
        }
        __proto.start-close(code, reason)
    }

    on-close(f: () -> _) {
        let loop = __proto.conn.loop
        if !on-loop?(loop) {
            loop.post(-> __proto.on-close-callback(f))
            return
        }
        __proto.on-close-callback(f)
    }
}

pub class WSProto : Proto {
    conn:    Conn
    ws:      WebSocket
    closed?: Bool

    __inbox:      Array[String | Blob]
    __inbox-size: Int
    __waiting:    Array[Task]
    __closers:    Array[() -> _]
    __frag:       Blob | nil
    __frag-op:    Int
    __close-sent: Bool
    __ping:       Timer
    __stopped?:   Bool
    __pmd:        PerMessage | nil
    __frag-z?:    Bool

    init(conn: Conn, request: Request, protocol: String | nil, pmd: PerMessage | nil = nil) {
        self.conn     = conn
        ws            = WebSocket(self, request, protocol)
        closed?       = false
        __inbox       = []
        __inbox-size  = 0
        __waiting     = []
        __closers     = []
        __frag        = nil
        __frag-op     = 0
        __close-sent  = false
        __stopped?    = false
        __pmd         = pmd
        __frag-z?     = false
        __ping        = Timer(-> __keepalive())

        let cfg = conn.config
        if cfg.ws-ping-interval > 0.0 {
            conn.loop.arm(__ping, cfg.ws-ping-interval)
        }
        conn.timeout(READ, cfg.ws-idle-timeout)
    }

    __keepalive() {
        if closed? || __close-sent {
            return
        }
        control(OP_PING, '')
        conn.loop.arm(__ping, conn.config.ws-ping-interval)
    }

    recv() -> String | Blob | nil {
        if !in-task?(conn.loop) {
            throw RuntimeError('http: WebSocket.recv() must be called from the handler task')
        }

        while #__inbox == 0 {
            if closed? || __close-sent {
                return nil
            }
            __waiting.push(task()!)
            suspend()
        }

        let msg = __inbox.pop(0)
        __inbox-size -= msg.size()
        if !closed? && !conn.reading? && __inbox-size < conn.config.ws-max-message {
            conn.want-read()
        }
        msg
    }

    send-message(msg: String | Blob) -> Bool {
        let loop = conn.loop

        if !on-loop?(loop) {
            if closed? || __close-sent {
                return false
            }
            loop.post(-> send-message(msg))
            return true
        }

        if closed? || __close-sent {
            if in-task?(loop) {
                throw ConnectionClosed('websocket closed')
            }
            return false
        }

        let op = (msg :: String) ? OP_TEXT : OP_BINARY
        let cfg = conn.config

        match __pmd {
            z: PerMessage and msg.size() >= cfg.ws-compress-min => {
                conn.write(frame(op, z.compress(msg), rsv1: true))
            },
            _ => conn.write(frame(op, msg))
        }

        if in-task?(loop) {
            if conn.buffered > cfg.write-high-water {
                conn.wait-drain(cfg.write-high-water / 2)
            }
        } else if conn.buffered > cfg.max-write-buffer {
            log::warn!('closing slow websocket: write buffer limit exceeded')
            conn.close()
            return false
        }

        true
    }

    control(op: Int, data: String | Blob) -> Bool {
        if closed? || __close-sent {
            return false
        }
        conn.write(frame(op, (data.size() > 125) ? Blob(data).clear(125) : data))
        true
    }

    start-close(code: Int, reason: String) {
        if closed? || __close-sent {
            return
        }

        __close-sent = true
        let payload = Blob((code >> 8) & 0xFF, code & 0xFF).push(reason)
        if #payload > 125 {
            payload.clear(125)
        }
        conn.write(frame(OP_CLOSE, payload))
        conn.timeout(READ, CLOSE_GRACE)
        __wake-all()
    }

    on-close-callback(f: () -> _) {
        if closed? {
            f()
        } else {
            __closers.push(f)
        }
    }

    __fail(code: Int, reason: String = '') {
        if !__close-sent {
            start-close(code, reason)
        }
        if ws.close-code == nil {
            ws.close-code = code
        }
        conn.close-after-flush()
    }

    __deliver(msg: String | Blob) {
        __inbox.push(msg)
        __inbox-size += msg.size()
        if #__waiting > 0 {
            conn.loop.resume(__waiting.pop(0))
        }
    }

    __wake-all() {
        let ws = __waiting
        __waiting = []
        for t in ws {
            conn.loop.resume(t)
        }
    }

    __message(op: Int, payload: Blob, compressed?: Bool = false) -> Bool {
        if compressed? {
            let $z = __pmd or do {
                __fail(CLOSE_PROTOCOL_ERROR, 'unexpected compressed frame')
                return false
            }
            payload = try {
                z.decompress(payload, conn.config.ws-max-message)
            } catch e: DeflateError {
                __fail(e.too-big? ? CLOSE_TOO_BIG : CLOSE_INVALID_DATA, 'bad compressed data')
                return false
            }
        }
        if op == OP_TEXT {
            let text = payload.str!()
            if !text.utf8? {
                __fail(CLOSE_INVALID_DATA, 'invalid UTF-8')
                return false
            }
            __deliver(text)
        } else {
            __deliver(payload)
        }
        true
    }

    __frame(op: Int, fin: Bool, payload: Blob, rsv1: Bool = false) -> Bool {
        let max = conn.config.ws-max-message

        match op {
            OP_CONT => {
                let $frag = __frag or do {
                    __fail(CLOSE_PROTOCOL_ERROR, 'unexpected continuation')
                    return false
                }
                if #frag + #payload > max {
                    __fail(CLOSE_TOO_BIG)
                    return false
                }
                frag.push(payload)
                if fin {
                    __frag = nil
                    return __message(__frag-op, frag, __frag-z?)
                }
            },

            OP_TEXT, OP_BINARY => {
                if __frag != nil {
                    __fail(CLOSE_PROTOCOL_ERROR, 'expected continuation')
                    return false
                }
                if fin {
                    return __message(op, payload, rsv1)
                }
                __frag = payload
                __frag-op = op
                __frag-z? = rsv1
            },

            OP_PING => {
                if !__close-sent {
                    conn.write(frame(OP_PONG, payload))
                }
            },

            OP_PONG => {},

            OP_CLOSE => {
                let code = CLOSE_NO_STATUS
                let reason = ''
                if #payload == 1 {
                    __fail(CLOSE_PROTOCOL_ERROR)
                    return false
                }
                if #payload >= 2 {
                    code = (payload[0] << 8) | payload[1]
                    if !valid-close-code?(code) {
                        __fail(CLOSE_PROTOCOL_ERROR, 'invalid close code')
                        return false
                    }
                    reason = payload.str!(2, #payload - 2)
                    if !reason.utf8? {
                        __fail(CLOSE_INVALID_DATA, 'invalid UTF-8')
                        return false
                    }
                }
                ws.close-code = code
                ws.close-reason = reason
                if !__close-sent {
                    __close-sent = true
                    let echo = (code == CLOSE_NO_STATUS) ? Blob() : Blob((code >> 8) & 0xFF, code & 0xFF)
                    conn.write(frame(OP_CLOSE, echo))
                }
                __wake-all()
                conn.close-after-flush()
                return false
            },

            _ => {
                __fail(CLOSE_PROTOCOL_ERROR, 'unknown opcode')
                return false
            }
        }

        true
    }

    on-data() {
        let b = conn.buf
        let max = conn.config.ws-max-message

        while !closed? && conn.available >= 2 {
            let h   = conn.head
            let b0  = b[h]
            let b1  = b[h + 1]
            let fin = (b0 & 0x80) != 0
            let op  = b0 & 0x0F

            let rsv1 = (b0 & 0x40) != 0

            if (b0 & 0x30) != 0 || (rsv1 && (__pmd == nil || (op != OP_TEXT && op != OP_BINARY))) {
                return __fail(CLOSE_PROTOCOL_ERROR, 'reserved bits set')
            }

            if (b1 & 0x80) == 0 {
                return __fail(CLOSE_PROTOCOL_ERROR, 'unmasked client frame')
            }

            let len = b1 & 0x7F
            let hdr = 2

            if len == 126 {
                if conn.available < 4 {
                    break
                }
                len = (b[h + 2] << 8) | b[h + 3]
                hdr = 4
            } else if len == 127 {
                if conn.available < 10 {
                    break
                }
                if (b[h + 2] & 0x80) != 0 {
                    return __fail(CLOSE_PROTOCOL_ERROR, 'invalid length')
                }
                len = 0
                for i in ..8 {
                    len = (len << 8) | b[h + 2 + i]
                }
                hdr = 10
            }

            if op >= 0x8 && (len > 125 || !fin) {
                return __fail(CLOSE_PROTOCOL_ERROR, 'invalid control frame')
            }

            if len > max {
                return __fail(CLOSE_TOO_BIG)
            }

            let total = hdr + 4 + len
            if conn.available < total {
                conn.timeout(READ, conn.config.ws-idle-timeout)
                return conn.want-read(total)
            }

            let at = h + hdr + 4
            let payload = b[at;at + len]
            payload.xor(c.load(c.u32, b.ptr() + at - 4), 4)
            conn.consume(total)

            if __close-sent && op != OP_CLOSE {
                continue
            }

            if !__frame(op, fin, payload, rsv1) {
                return
            }
        }

        if closed? || conn.closing? || conn.draining? {
            return
        }

        conn.timeout(READ, __close-sent ? CLOSE_GRACE : conn.config.ws-idle-timeout)

        if __inbox-size < max {
            conn.want-read()
        }
    }

    on-eof() {
        if ws.close-code == nil {
            ws.close-code = CLOSE_ABNORMAL
        }
        conn.close()
    }

    on-drain() {
    }

    on-timeout(which: Int) {
        if ws.close-code == nil {
            ws.close-code = CLOSE_ABNORMAL
        }
        conn.close()
    }

    on-shutdown() {
        start-close(CLOSE_GOING_AWAY, 'server shutting down')
    }

    on-close() {
        if closed? {
            return
        }
        closed? = true
        __ping.cancel()
        if let $z = __pmd {
            __pmd = nil
            z.close()
        }
        if ws.close-code == nil {
            ws.close-code = CLOSE_ABNORMAL
        }

        let cs = __closers
        __closers = []
        for f in cs {
            try {
                f()
            } catch e {
                log::error!("error in websocket on-close callback", err: e)
            }
        }

        __wake-all()
    }
}

pub fn handshake-response(key: String, protocol: String | nil, extra: Dict[String, String] = %{}) -> Blob {
    let out = Blob('HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n')
    out.push("Sec-WebSocket-Accept: {accept-key(key)}\r\n")
    if protocol != nil {
        out.push("Sec-WebSocket-Protocol: {protocol}\r\n")
    }
    for k, v in extra {
        out.push("{k}: {v}\r\n")
    }
    out.push('\r\n')
    out
}
