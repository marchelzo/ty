/**
 * WebSocket (RFC 6455) constants and frame helpers. The server and client
 * protocols themselves run in the native core; these are for tools and
 * tests that speak the wire format directly.
 */
pub import _http (
    ws-frame as frame,
    ws-accept-key as accept-key,
    ws-deflate as deflate,
    ws-inflate as inflate
)

pub const GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'

pub const OP_CONT   = 0x0
pub const OP_TEXT   = 0x1
pub const OP_BINARY = 0x2
pub const OP_CLOSE  = 0x8
pub const OP_PING   = 0x9
pub const OP_PONG   = 0xA

pub const CLOSE_NORMAL         = 1000
pub const CLOSE_GOING_AWAY     = 1001
pub const CLOSE_PROTOCOL_ERROR = 1002
pub const CLOSE_UNSUPPORTED    = 1003
pub const CLOSE_NO_STATUS      = 1005
pub const CLOSE_ABNORMAL       = 1006
pub const CLOSE_INVALID_DATA   = 1007
pub const CLOSE_POLICY         = 1008
pub const CLOSE_TOO_BIG        = 1009
pub const CLOSE_INTERNAL       = 1011

/// A 101 response accepting the handshake for `key`.
pub fn handshake-response(key: String, protocol: String | nil = nil) -> String {
    let p = (protocol == nil) ? '' : "Sec-WebSocket-Protocol: {protocol}\r\n"
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept-key(key)}\r\n{p}\r\n"
}

pub fn close-payload(code: Int, reason: String = '') -> Blob {
    Blob(code >> 8, code & 0xFF).push(reason.bslice(0, min(reason.size(), 123)))
}

pub fn valid-close-code?(code: Int) -> Bool {
    (code >= 1000 && code <= 1003)
 || (code >= 1007 && code <= 1011)
 || (code >= 3000 && code <= 4999)
}
