import log
import _http as hc
import http.core (
    ConnectionClosed,
    Task,
    task,
    suspend,
    in-task?,
    on-loop?
)
import http.loop (Conn, Timer, Proto, READ)
import http.wire (Request)
import http.deflate (PerMessage, DeflateError)

pub import http.wsframe (
    GUID,
    OP_CONT,
    OP_TEXT,
    OP_BINARY,
    OP_CLOSE,
    OP_PING,
    OP_PONG,
    CLOSE_NORMAL,
    CLOSE_GOING_AWAY,
    CLOSE_PROTOCOL_ERROR,
    CLOSE_UNSUPPORTED,
    CLOSE_NO_STATUS,
    CLOSE_ABNORMAL,
    CLOSE_INVALID_DATA,
    CLOSE_POLICY,
    CLOSE_TOO_BIG,
    CLOSE_INTERNAL,
    accept-key,
    valid-close-code?,
    frame,
    frame-into,
    close-payload
)

const CLOSE_GRACE = 5.0

/// A server-side WebSocket connection. `send`, `ping` and `close` may be
/// called from any thread; `recv` must be called from the handler's task.
pub class WebSocket {
    request:      Request
    protocol:     String | nil
    close-code:   Int | nil
    close-reason: String | nil

    __proto: WSProto

    init(proto: WSProto, request: Request, protocol: String | nil) {
        __proto       = proto
        self.request  = request
        self.protocol = protocol
    }

    closed? -> Bool {
        __proto.closed?
    }

    buffered -> Int {
        __proto.conn.buffered
    }

    recv() -> String | Blob | nil {
        __proto.recv()
    }

    send(msg: String | Blob) -> Bool {
        __proto.send-message(msg)
    }

    ping(data: String | Blob = '') -> Bool {
        let loop = __proto.conn.loop
        if !on-loop?(loop) {
            loop.post(-> __proto.control(OP_PING, data))
            return !closed?
        }
        __proto.control(OP_PING, data)
    }

    close(code: Int = CLOSE_NORMAL, reason: String = '') {
        let loop = __proto.conn.loop
        if !on-loop?(loop) {
            loop.post(-> __proto.start-close(code, reason))
            return
        }
        __proto.start-close(code, reason)
    }

    on-close(f: () -> _) {
        let loop = __proto.conn.loop
        if !on-loop?(loop) {
            loop.post(-> __proto.on-close-callback(f))
            return
        }
        __proto.on-close-callback(f)
    }
}

pub class WSProto : Proto {
    conn:    Conn
    ws:      WebSocket
    closed?: Bool = false

    __inbox:      Queue[String | Blob] = Queue()
    __inbox-size: Int = 0
    __waiting:    Queue[Task] = Queue()
    __closers:    Array[() -> _] = []
    __frag:       Blob | nil
    __frag-op:    Int = 0
    __close-sent: Bool = false
    __ping:       Timer
    __stopped?:   Bool = false
    __pmd:        PerMessage | nil
    __frag-z?:    Bool = false
    __hdr:        Array[Int] = [0, 0, 0, 0, 0]

    init(conn: Conn, request: Request, protocol: String | nil, pmd: PerMessage | nil = nil) {
        self.conn = conn
        ws        = WebSocket(self, request, protocol)
        __pmd     = pmd
        __ping    = Timer(-> __keepalive())

        let cfg = conn.config
        if cfg.ws-ping-interval > 0.0 {
            conn.loop.arm(__ping, cfg.ws-ping-interval)
        }
        conn.timeout(READ, cfg.ws-idle-timeout)
    }

    __keepalive() {
        if closed? || __close-sent {
            return
        }
        control(OP_PING, '')
        conn.loop.arm(__ping, conn.config.ws-ping-interval)
    }

    recv() -> String | Blob | nil {
        if !in-task?(conn.loop) {
            throw RuntimeError('http: WebSocket.recv() must be called from the handler task')
        }

        while #__inbox == 0 {
            if closed? || __close-sent {
                return nil
            }
            __waiting.push(task()!)
            suspend()
        }

        let msg = __inbox.pop()
        __inbox-size -= msg.size()
        if !closed? && !conn.reading? && __inbox-size < conn.config.ws-max-message {
            conn.want-read()
        }
        msg
    }

    send-message(msg: String | Blob) -> Bool {
        let loop = conn.loop

        if !on-loop?(loop) {
            if closed? || __close-sent {
                return false
            }
            loop.post(-> send-message(msg))
            return true
        }

        if closed? || __close-sent {
            if in-task?(loop) {
                throw ConnectionClosed('websocket closed')
            }
            return false
        }

        let op = (msg :: String) ? OP_TEXT : OP_BINARY
        let cfg = conn.config

        match __pmd {
            z: PerMessage and msg.size() >= cfg.ws-compress-min => {
                conn.write(frame(op, z.compress(msg), rsv1: true))
            },
            _ => conn.write(frame(op, msg))
        }

        if in-task?(loop) {
            if conn.buffered > cfg.write-high-water {
                conn.wait-drain(cfg.write-high-water / 2)
            }
        } else if conn.buffered > cfg.max-write-buffer {
            log::warn!('closing slow websocket: write buffer limit exceeded')
            conn.close()
            return false
        }

        true
    }

    control(op: Int, data: String | Blob) -> Bool {
        if closed? || __close-sent {
            return false
        }
        conn.write(frame(op, (data.size() > 125) ? Blob(data).clear(125) : data))
        true
    }

    start-close(code: Int, reason: String) {
        if closed? || __close-sent {
            return
        }

        __close-sent = true
        conn.write(frame(OP_CLOSE, close-payload(code, reason)))
        conn.timeout(READ, CLOSE_GRACE)
        __wake-all()
    }

    on-close-callback(f: () -> _) {
        if closed? {
            f()
        } else {
            __closers.push(f)
        }
    }

    __fail(code: Int, reason: String = '') {
        if !__close-sent {
            start-close(code, reason)
        }
        if ws.close-code == nil {
            ws.close-code = code
        }
        conn.close-after-flush()
    }

    __deliver(msg: String | Blob) {
        __inbox.push(msg)
        __inbox-size += msg.size()
        if let Some(t) = __waiting.tryPop() {
            conn.loop.resume(t)
        }
    }

    __wake-all() {
        while let Some(t) = __waiting.tryPop() {
            conn.loop.resume(t)
        }
    }

    __message(op: Int, payload: String | Blob, compressed?: Bool = false) -> Bool {
        if compressed? {
            let $z = __pmd or do {
                __fail(CLOSE_PROTOCOL_ERROR, 'unexpected compressed frame')
                return false
            }
            payload = try {
                z.decompress(payload, conn.config.ws-max-message)
            } catch e: DeflateError {
                __fail(e.too-big? ? CLOSE_TOO_BIG : CLOSE_INVALID_DATA, 'bad compressed data')
                return false
            }
        }
        if op == OP_TEXT {
            let text = match payload {
                s: String => s,
                b: Blob   => b.str!()
            }
            if !text.utf8? {
                __fail(CLOSE_INVALID_DATA, 'invalid UTF-8')
                return false
            }
            __deliver(text)
        } else {
            __deliver(payload)
        }
        true
    }

    __frame(op: Int, fin: Bool, payload: String | Blob, rsv1: Bool = false) -> Bool {
        let max = conn.config.ws-max-message

        match op {
            OP_CONT => {
                let $frag = __frag or do {
                    __fail(CLOSE_PROTOCOL_ERROR, 'unexpected continuation')
                    return false
                }
                if #frag + payload.size() > max {
                    __fail(CLOSE_TOO_BIG)
                    return false
                }
                frag.push(payload)
                if fin {
                    __frag = nil
                    return __message(__frag-op, frag, __frag-z?)
                }
            },

            OP_TEXT, OP_BINARY => {
                if __frag != nil {
                    __fail(CLOSE_PROTOCOL_ERROR, 'expected continuation')
                    return false
                }
                if fin {
                    return __message(op, payload, rsv1)
                }
                __frag = match payload {
                    b: Blob   => b,
                    s: String => Blob(s)
                }
                __frag-op = op
                __frag-z? = rsv1
            },

            OP_PING => {
                if !__close-sent {
                    conn.write(frame(OP_PONG, payload))
                }
            },

            OP_PONG => {},

            OP_CLOSE => {
                let code = CLOSE_NO_STATUS
                let reason = ''
                let body = match payload {
                    s: String => s,
                    b: Blob   => b.str!()
                }
                let n = body.size()
                if n == 1 {
                    __fail(CLOSE_PROTOCOL_ERROR)
                    return false
                }
                if n >= 2 {
                    code = ((body.byte(0)!) << 8) | (body.byte(1)!)
                    if !valid-close-code?(code) {
                        __fail(CLOSE_PROTOCOL_ERROR, 'invalid close code')
                        return false
                    }
                    reason = body.bslice(2)
                    if !reason.utf8? {
                        __fail(CLOSE_INVALID_DATA, 'invalid UTF-8')
                        return false
                    }
                }
                ws.close-code = code
                ws.close-reason = reason
                if !__close-sent {
                    __close-sent = true
                    conn.write(frame(OP_CLOSE, (code == CLOSE_NO_STATUS) ? '' : close-payload(code)))
                }
                __wake-all()
                conn.close-after-flush()
                return false
            },

            _ => {
                __fail(CLOSE_PROTOCOL_ERROR, 'unknown opcode')
                return false
            }
        }

        true
    }

    on-data() {
        let max = conn.config.ws-max-message

        while !closed? && conn.available >= 2 {
            let hdr = __hdr
            let next = hc.ws-next(conn.buf, conn.head, conn.filled, true, __pmd != nil, max, hdr)

            if next == 0 {
                if hdr[3] == 0 {
                    break
                }
                conn.timeout(READ, conn.config.ws-idle-timeout)
                return conn.want-read(hdr[3])
            }

            let payload = match next {
                s: String => s,
                b: Blob   => b,
                -1 => return __fail(CLOSE_PROTOCOL_ERROR, 'reserved bits set'),
                -2 => return __fail(CLOSE_PROTOCOL_ERROR, 'unmasked client frame'),
                -3 => return __fail(CLOSE_PROTOCOL_ERROR, 'invalid length'),
                -4 => return __fail(CLOSE_PROTOCOL_ERROR, 'invalid control frame'),
                _  => return __fail(CLOSE_TOO_BIG)
            }

            let op   = hdr[0]
            let fin  = hdr[1] != 0
            let rsv1 = hdr[2] != 0
            conn.consume(hdr[3])

            if __close-sent && op != OP_CLOSE {
                continue
            }

            if !__frame(op, fin, payload, rsv1) {
                return
            }
        }

        if closed? || conn.closing? || conn.draining? {
            return
        }

        conn.timeout(READ, __close-sent ? CLOSE_GRACE : conn.config.ws-idle-timeout)

        if __inbox-size < max {
            conn.want-read()
        }
    }

    on-eof() {
        if ws.close-code == nil {
            ws.close-code = CLOSE_ABNORMAL
        }
        conn.close()
    }

    on-drain() {
    }

    on-timeout(which: Int) {
        if ws.close-code == nil {
            ws.close-code = CLOSE_ABNORMAL
        }
        conn.close()
    }

    on-shutdown() {
        start-close(CLOSE_GOING_AWAY, 'server shutting down')
    }

    on-close() {
        if closed? {
            return
        }
        closed? = true
        __ping.cancel()
        if let $z = __pmd {
            __pmd = nil
            z.close()
        }
        if ws.close-code == nil {
            ws.close-code = CLOSE_ABNORMAL
        }

        let cs = __closers
        __closers = []
        for f in cs {
            try {
                f()
            } catch e {
                log::error!("error in websocket on-close callback", err: e)
            }
        }

        __wake-all()
    }
}

pub fn handshake-response(key: String, protocol: String | nil, extra: Dict[String, String] = %{}) -> String {
    let more = (protocol == nil) ? '' : "Sec-WebSocket-Protocol: {protocol}\r\n"
    for k, v in extra {
        more = "{more}{k}: {v}\r\n"
    }
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept-key(key)}\r\n{more}\r\n"
}
