import hash
import base64

pub import _http (ws-frame as frame, ws-frame-into as frame-into, ws-close-payload as close-payload)

pub const GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'

pub const OP_CONT   = 0x0
pub const OP_TEXT   = 0x1
pub const OP_BINARY = 0x2
pub const OP_CLOSE  = 0x8
pub const OP_PING   = 0x9
pub const OP_PONG   = 0xA

pub const CLOSE_NORMAL         = 1000
pub const CLOSE_GOING_AWAY     = 1001
pub const CLOSE_PROTOCOL_ERROR = 1002
pub const CLOSE_UNSUPPORTED    = 1003
pub const CLOSE_NO_STATUS      = 1005
pub const CLOSE_ABNORMAL       = 1006
pub const CLOSE_INVALID_DATA   = 1007
pub const CLOSE_POLICY         = 1008
pub const CLOSE_TOO_BIG        = 1009
pub const CLOSE_INTERNAL       = 1011

pub fn accept-key(key: String) -> String {
    base64.encode(hash.sha1(key + GUID).digest())
}

pub fn valid-close-code?(code: Int) -> Bool {
    (code >= 1000 && code <= 1003)
 || (code >= 1007 && code <= 1011)
 || (code >= 3000 && code <= 4999)
}
