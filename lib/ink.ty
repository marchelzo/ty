let __tls::_bg-global-sgr: String = ''
let __tls::__theme-colors: Dict[String, String] = %{}

let __tls::_base-theme: Dict[String, String] = %{}
let __tls::_look-tokens: Dict[String, String] = %{}

pub fn set-theme(name: String) {
    set-theme(themes.get(name))
}

pub fn set-theme(overrides: Dict[String, String] = %{}) {
    let base = (#overrides > 0) ? default-theme : native-theme
    _base-theme = %{**base, **overrides}
    install-theme()
}

fn install-theme() {
    let theme = %{**_base-theme, **_look-tokens}
    __theme-colors = theme
    _fg-cache = %{}
    _bg-cache = %{}
    for name, val in theme if #val > 0 {
        chalk.{name} = val
    }
    _bg-global-sgr = match theme['bg-global'] {
        $style and style => resolve-bg-sgr(style),
        _                => ''
    }
    invalidate-all()
}

pub fn invalidate-all() {
    for _, c in _fibers {
        c.invalidate!()
    }
    _event-queue.put(Wake)
}

set-theme()

let __tls::_looks: look.Looks = look.Looks(look.DEFAULTS)
let __tls::_look-file: look.LookFile | nil = nil
let __tls::_inh-spec: String | nil = nil

fn install-looks(d: Dict[String, Dict[String, _]]) {
    let tokens = d['@tokens'] ?? %{}
    _looks.use(%{**d, '@tokens': %{}})
    if tokens != _look-tokens {
        _look-tokens = tokens
        install-theme()
    }
    invalidate-all()
}

pub fn use-looks(src: String) {
    install-looks(look.parse(src))
}

pub fn watch-looks(path: String, interval: Float = 0.2) {
    _look-file = look.LookFile(path)
    refresh-looks()
    Thread(fn () {
        let last = os.stat(path).?mtime
        for (;;) {
            sleep(interval)
            let m = os.stat(path).?mtime
            if m != last {
                last = m
                _event-queue.put(Wake)
            }
        }
    }).detach()
}

pub fn look-error() -> String | nil {
    _look-file.?error
}

fn refresh-looks() {
    let $f = _look-file or return
    if let $d = f.poll() {
        install-looks(d)
    }
}

pub fn part(w: String, p: String, states: Array[String], variant: String | nil = nil) -> Dict[String, _] {
    _looks.part(w, p, states, variant)
}

pub fn look-of(cls: String) -> Dict[String, _] {
    _looks.classes(cls)
}

fn spec-of-part(d: Dict[String, _]) -> String {
    d['spec'] ?? ''
}

fn apply-look(n: Node, cls: String) {
    apply-look-dict(n, _looks.classes(cls))
}

fn apply-look-dict(n: Node, d: Dict[String, _]) {
    let props = n.props
    if props['borderStyle'] == nil and let $b = d['border'] {
        n.bstyle = (b == 'none') ? nil : resolve-border(b)
    }
    if props['borderColor'] == nil and let $bc = d['border-color'] {
        n.bcolor = bc
    }
    if props['bg'] == nil and let $bg = d['bg'] {
        n.bg = bg
    }
    if props['padding'] == nil {
        if props['padX'] == nil {
            n.px = d['pad-x'] ?? d['padding'] ?? n.px
        }
        if props['padY'] == nil {
            n.py = d['pad-y'] ?? d['padding'] ?? n.py
        }
    }
    if props['gap'] == nil and let $g = d['gap'] {
        n.gap = g
    }
    if props['margin'] == nil {
        if props['marginX'] == nil {
            n.mx = d['margin-x'] ?? d['margin'] ?? n.mx
        }
        if props['marginY'] == nil {
            n.my = d['margin-y'] ?? d['margin'] ?? n.my
        }
    }
    if props['width'] == nil and let $w = d['width'] {
        n.width = w
    }
    if props['height'] == nil and let $h = d['height'] {
        n.height = h
    }
    if props['direction'] == nil and let $dir = d['direction'] {
        n.direction = dir
    }
    if props['align'] == nil and let $a = d['align'] {
        n.align = a
    }
    if props['justify'] == nil and let $j = d['justify'] {
        n.justify = j
    }
    if props['wrap'] == nil and let $wr = d['wrap'] {
        props['wrap'] = wr
    }
    if let $sp = d['spec'] {
        if n.tag == NodeText {
            n.style = (n.style == nil) ? sp : "{sp} {n.style}"
        } else {
            n.inh = sp
        }
    }
}

pub fn provide(key, value) {
    _ctx-stack[-1][key] = value
}

pub fn context(key, default = nil) {
    for frame in _ctx-stack[;;-1] {
        if let $v = frame[key] { return v }
    }
    default
}

pub fn focus(comp: Component) {
    set-focus(comp)
}

let __tls::_pending-focus-type: Any = nil

pub fn focus-by-type(cls) {
    for comp in _focusables {
        if comp :: cls {
            set-focus(comp)
            _pending-focus-type = nil
            return
        }
    }
    _pending-focus-type = cls
}

pub fn unfocus() {
    set-focus(nil)
}

pub fn cycle-focus(reverse?: Bool = false) {
    let n = #_focusables
    if n == 0 {
        return
    }
    let idx = _focusables.search(_focused)
    let next = match (idx, reverse?) {
        (nil, false) => 0,
        (nil, true)  => n - 1,
        (i: Int, false) => (i + 1) % n,
        (i: Int, true)  => (i - 1 + n) % n
    }
    set-focus(_focusables[next])
}

tag NodeBox, NodeText, NodeOverlay, NodeRaw;

let __tls::_fg-cache: Dict[String, String] = %{}
let __tls::_bg-cache: Dict[String, String] = %{}

fn sgr-prefix(spec: String) -> String {
    let s = chalk.render("[{spec}]@[/]")
    s[;s.search('@') ?? 0]
}

pub fn fg-sgr(color: String) -> String {
    if let $c = _fg-cache[color] {
        return c
    }
    let result = sgr-prefix(color)
    _fg-cache[color] = result
    result
}

fn bg-from-sgr(sgr: String) -> String {
    match sgr {
        /[34]8;2;(\d+;\d+;\d+)/  => "\x1b[48;2;{$1}m",
        /[34]8;5;(\d+)/           => "\x1b[48;5;{$1}m",
        /\[(?:[0-9;]*;)?[34]([0-7])m/ => "\x1b[4{$1}m",
        /\[(?:[0-9;]*;)?(?:9|10)([0-7])m/ => "\x1b[10{$1}m",
        _                         => ''
    }
}

let RST = "\x1b[0m"
let BG_RST = "\x1b[49m"

fn resolve-bg-sgr(color: String) -> String {
    if let $c = _bg-cache[color] {
        return c
    }
    let token = __theme-colors[color]
    let result = match token {
        ''        => '',
        t: String => bg-from-sgr(sgr-prefix(t)),
        _         => bg-from-sgr(sgr-prefix(color))
    }
    _bg-cache[color] = result
    result
}

let kitty-graphics? = match getenv('INK_KITTY') {
    '0' or 'no' or 'false' => false,
    '1' or 'yes' or 'true' => true,
    _ => do {
        let tp = getenv('TERM_PROGRAM') ?? ''
        let tm = getenv('TERM') ?? ''
        tp == 'ghostty'
        || tp == 'WezTerm'
        || tm == 'xterm-kitty'
        || (getenv('KITTY_WINDOW_ID') ?? '') != ''
    }
}

pub fn set-kitty-graphics(on: Bool) {
    kitty-graphics? = on
}

const ANSI_RGB = [
    (0, 0, 0),       (205, 0, 0),     (0, 205, 0),     (205, 205, 0),
    (0, 0, 238),     (205, 0, 205),   (0, 205, 205),   (229, 229, 229),
    (127, 127, 127), (255, 0, 0),     (0, 255, 0),     (255, 255, 0),
    (92, 92, 255),   (255, 0, 255),   (0, 255, 255),   (255, 255, 255)
]

fn resolve-color-rgb(name: String) -> (Int, Int, Int) {
    let color = __theme-colors[name] || name
    let s = chalk.render("[{color}]@[/]", plain=false)
    let sgr = s[;s.search('@') ?? 0]
    match sgr {
        /[34]8;2;(\d+);(\d+);(\d+)/ => (int($1), int($2), int($3)),
        /\[(?:[0-9;]*;)?([34])([0-7])m/  => ANSI_RGB[int($2)],
        /\[(?:[0-9;]*;)?(9|10)([0-7])m/  => ANSI_RGB[8 + int($2)],
        _                                => (200, 200, 200)
    }
}

let __kitty-next-id = 1

fn kitty-next-id() -> Int {
    let id = __kitty-next-id
    __kitty-next-id += 1
    id
}

fn kitty-delete(id: Int) -> String {
    "\x1b_Ga=d,q=2,d=i,i={id}\x1b\\"
}

fn kitty-transmit(buf: Blob, pw: Int, ph: Int, cols: Int, rows: Int, id: Int = 0) -> String {
    debug!("kitty-transmit: {pw}x{ph} id={id} buf={#buf}")
    let payload = base64.encode(buf)
    let plen = #payload
    let out = Blob()
    let chunk-size = 4096
    let id-part = (id > 0) ? ",i={id}" : ""
    let hdr = "\x1b_Ga=T,q=2,f=32,s={pw},v={ph},c={cols},r={rows}{id-part}"
    let i = 0

    while i < plen {
        let end = min(i + chunk-size, plen)
        let more = (end < plen) ? 1 : 0
        let chunk = payload[i;end]

        if i == 0 {
            out.push("{hdr},m={more};{chunk}\x1b\\")
        } else {
            out.push("\x1b_Gm={more};{chunk}\x1b\\")
        }

        i = end
    }

    out.str!()
}

ns border-style {
    pub single = ['┌', '┐', '└', '┘', '─', '│']
    pub double = ['╔', '╗', '╚', '╝', '═', '║']
    pub round  = ['╭', '╮', '╰', '╯', '─', '│']
    pub bold   = ['┏', '┓', '┗', '┛', '━', '┃']
}

fn resolve-border(style) {
    match style {
        (s: String) => match s {
            'single' => border-style.single,
            'double' => border-style.double,
            'round'  => border-style.round,
            'bold'   => border-style.bold,
            _        => border-style.round
        },
        (a: Array) => a,
        _          => nil
    }
}

fn strip-ws-children(xs: Array[Any]) -> Array[Any] {
    xs.flat().reject(String & /^\s*$/)
}

pub class Node {
    `tag`:    NodeBox | NodeText | NodeOverlay | NodeRaw
    props:    Dict[String, _]
    children: Array[Any]

    direction: String
    gap:    Int
    px:     Int
    py:     Int
    mx:     Int
    my:     Int
    width:  Int | nil
    height: Int | nil
    flex:   Int | nil
    bg:     String | nil
    bstyle: Array[String] | nil
    bcolor: String | nil
    focusable?: Bool
    align:   String
    justify: String

    style: String | nil
    inh:   String | nil

    init(tg, prps, chldrn) {
        `tag`    = tg
        props    = prps
        children = chldrn

        let p = props['padding'] ?? 0
        let m = props['margin'] ?? 0

        direction  = props['direction'] ?? 'column'
        gap        = int(props['gap'] ?? 0)
        px         = int(props['padX'] ?? props['paddingX'] ?? p)
        py         = int(props['padY'] ?? props['paddingY'] ?? p)
        mx         = int(props['marginX'] ?? m)
        my         = int(props['marginY'] ?? m)
        width      = props['width']
        height     = props['height']
        flex       = props['flex']
        bg         = props['bg']
        bstyle     = resolve-border(props['borderStyle'])
        bcolor     = props['borderColor']
        focusable? = props['focusable'] ?? false
        align      = match props['align'] {
            'right' or 'bottom' or 'end' => 'end',
            'center'                     => 'center',
            _                            => 'start'
        }
        justify    = props['justify'] ?? 'start'
        style      = props['style']
        inh        = nil

        if let $d = props['look'] {
            apply-look-dict(self, d)
        }
        if let $c = props['cls'] {
            apply-look(self, c)
        }
    }
}

class PendingTimer {
    __deadline: Float
    __repeat: Float | nil
    __callback: Function
    __owner: Any
    __canceled: Bool

    init(deadline: Float, repeat: Float | nil, callback: Function, owner: Any) {
        __deadline = deadline
        __repeat = repeat
        __callback = callback
        __owner = owner
        __canceled = false
    }

    deadline   { __deadline  }
    repeat     { __repeat    }
    callback   { __callback  }
    owner      { __owner     }
    canceled? { __canceled }

    cancel() { __canceled = true }
    nudge(dt: Float) { __deadline -= dt }

    fire() {
        if !__canceled {
            __callback()
            __owner.?invalidate!()
        }
    }

    reschedule() {
        if __repeat && !__canceled {
            let t = now()
            while __deadline <= t {
                __deadline += __repeat
            }
            return true
        }
        false
    }
}

pub class Component {
    children:     Array[Any]
    focused?:     Bool
    mounted?:     Bool
    alive?:       Bool
    dirty?:       Bool
    cached-node:  _
    width:        _
    height:       _
    scroll-total: _
    layout-x:     Int
    layout-y:     Int
    layout-max-w: Int
    layout-max-h: Int

    __prop-names: Array[String]

    ink-ctx-frame:        Dict[Any, Any]       = %{}
    ink-parent:           Any                  = nil
    ink-memo:             Any                  = nil
    ink-interval-timer:   PendingTimer | nil   = nil
    ink-interval-period:  Float | nil          = nil

    init(*chldrn, %prps) {
        children     = chldrn.flat()
        focused?     = false
        mounted?     = false
        alive?       = false
        dirty?       = true
        cached-node  = nil
        layout-x     = 0
        layout-y     = 0
        layout-max-w = 0
        layout-max-h = 0
        __prop-names = prps.keys()
        for prop, val in prps {
            self.{prop} = val
        }
    }

    focusable? -> Bool        { false }
    wants-hover? -> Bool      { false }
    stale? -> Bool            { false }
    interval   -> Float | nil { nil   }
    // Optional render-loop frame cap. Dirty events and timers continue to be
    // processed and coalesced; only terminal painting is deferred.
    max-fps    -> Float | nil { nil   }

    mount()        {}
    unmount()      {}
    tick()         {}
    handles-tab? -> Bool { false }
    handles-interrupt? -> Bool { false }

    invalidate!() {
        dirty? = true
        let p: Any = self
        while p != nil {
            p.ink-memo = nil
            p = p.ink-parent
        }
    }

    after(delay: Float, callback: Function) -> PendingTimer {
        let t = PendingTimer(now() + delay, nil, callback, self)
        _timers.push(t)
        debug!("timer after({delay}) registered for {type(self)}")
        t
    }

    every(iv: Float, callback: Function) -> PendingTimer {
        if !(iv > 0.0) {
            throw ValueError("every(): interval must be positive, got {iv}")
        }
        let t = PendingTimer(now() + iv, iv, callback, self)
        _timers.push(t)
        debug!("timer every({iv}) registered for {type(self)}")
        t
    }

    notify() {
        invalidate!()
        _event-queue.put(Wake)
    }

    adopt(other: Component) {
        let was-dirty = dirty?
        let new-children = other.children
        if children != new-children { dirty? = true }
        children = new-children
        let changed-props = []
        for name in __prop-names {
            if !(name in other.__prop-names) {
                self.{name} = other.{name}
                dirty? = true
            }
        }
        __prop-names = other.__prop-names
        for name in other.__prop-names {
            let new-val = other.{name}
            if !dirty? && !(new-val :: Function) && self.{name} != new-val {
                dirty? = true
                changed-props.push(name)
            }
            self.{name} = new-val
        }
        if dirty? && !was-dirty {
            debug!("adopt {type(self)}: dirtied by {#changed-props > 0 ? changed-props.join(', ') : 'children'}")
        }
    }

    render() -> Node | Component;

    resolve(val: _, default: _ = nil) {
        (val :: Function) ? val(self) : (val ?? default)
    }

    focus!(v: Bool) {
        if focused? != v {
            invalidate!()
        }
        focused? = v
    }
    mount!() {
        mounted? = true
        alive? = true
        debug!("mount {type(self)}")
        mount()
    }
    unmount!() {
        if !mounted? {
            return
        }
        debug!("unmount {type(self)}")
        mounted? = false
        alive? = false
        ink-interval-timer = nil
        ink-interval-period = nil
        release-status(self)
        let n = 0
        for t in _timers if t.owner == self {
            t.cancel()
            n += 1
        }
        if n > 0 { debug!("  canceled {n} timer(s)") }
        unmount()
    }
}

pub fn Box(*children, %props) -> Node {
    let box-props = props
    if props['selected'] ?? false {
        box-props = %{**props,
            'bg': props['selectionBg'] ?? 'selection',
            '_forceFg': props['selectionColor'] ?? 'selection-text'
        }
    }
    Node(NodeBox, box-props, strip-ws-children(children))
}

pub fn Text(*children, %props) -> Node {
    Node(NodeText, props, children.flat())
}

pub fn Overlay(*children, %props) -> Node {
    Node(NodeOverlay, props, strip-ws-children(children))
}

pub fn Raw(lines: Array[String], raw-width: Int) -> Node {
    Node(NodeRaw, %{'lines': lines, 'width': raw-width}, [])
}

pub class Divider < Component {
    variant: String | nil
    char:   String | nil
    color:  String | nil
    title:  String | nil
    width:  Int | nil

    render() -> Node {
        let ln = part('Divider', 'line', [], variant)
        let tl = part('Divider', 'title', [], variant)
        let ch = char ?? ln['content'] ?? '─'
        let lk = color ? nil : ln
        let w = width ?? layout-max-w

        if let $t = title {
            let side = max(w - t.width() - 2, 4)
            let left = side / 2
            <Box direction="row">
                <Text look=lk style=color>{ch * left} </Text>
                <Text look=(color ? nil : tl) style=(color ? "{color} bold" : nil)>{t}</Text>
                <Text look=lk style=color> {ch * (side - left)}</Text>
            </Box>
        } else {
            <Text look=lk style=color>{ch * w}</Text>
        }
    }
}

pub class Badge < Component {
    variant: String | nil
    color: String | nil

    render() -> Node {
        let lb = part('Badge', 'label', [], variant)
        <Text look=(color ? nil : lb) style=(color ? "{color} reverse" : nil)> {children} </Text>
    }
}

pub class SectionHeader < Component {
    variant: String | nil
    color: String | nil

    render() -> Node {
        let tl = part('SectionHeader', 'title', [], variant)
        <Text look=(color ? nil : tl) style=(color ? "{color} u" : nil)>{children}</Text>
    }
}

pub class Card < Component {
    variant: String | nil
    cls:          String | nil
    focus-color:  String | nil
    border-color: String | nil
    border-style: String | Array[String] | nil
    width:        Int | nil
    focusable:    Bool | nil
    on-click:     Function | nil

    focusable? -> Bool { focusable ?? false }

    render() -> Node {
        let fr = part('Card', 'frame', focused? ? ['focused'] : [], variant)
        let bc = focused? ? focus-color : border-color
        <Box direction="column" look=fr cls=cls border-style=border-style border-color=bc
             width=width on-click=on-click
        >
            {children}
        </Box>
    }
}

pub class StatusBar < Component {
    variant: String | nil
    cls:   String | nil
    color: String | nil
    bg:    String | nil

    render() -> Node {
        let bar = part('StatusBar', 'bar', [], variant)
        let tx = part('StatusBar', 'text', [], variant)
        <Box direction="row" look=bar cls=cls bg=bg>
            <Text look=(color ? nil : tx) style=color>{children}</Text>
        </Box>
    }
}

pub class ProgressBar < Component {
    variant: String | nil
    value:     Float | nil
    width:     Int | nil
    color:     String | nil
    bg:        String | nil
    status-id: String | nil

    render() -> Node {
        let value  = float(value ?? 0)

        if let $id = status-id {
            claim-status(self, id, __status(value))
        }

        let sts    = (value >= 1.0) ? ['done'] : []
        let fl     = part('ProgressBar', 'fill', sts, variant)
        let tr     = part('ProgressBar', 'track', sts, variant)
        let pc     = part('ProgressBar', 'pct', sts, variant)
        let total  = int(width ?? 20)
        let pct    = " {int(value * 100)}%"
        let w      = max(total - pct.width(), 2)
        let filled = int(value.clamp(0.0, 1.0) * w)
        let empty  = w - filled

        <Box direction="row">
            <Text look=(color ? nil : fl) style=color>{(fl['content'] ?? '━') * filled}</Text>
            <Text look=(bg ? nil : tr) style=bg>{(tr['content'] ?? '━') * empty}</Text>
            <Text look=pc>{pct}</Text>
        </Box>
    }

    __status(value: Float) -> _ {
        (value >= 1.0)
            ? {state: term.status.DONE}
            : {state: term.status.WORKING, progress: int(value.clamp(0.0, 1.0) * 100)}
    }
}

ns spin {
    pub const dots  = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    pub const dots2 = ['⣾', '⣷', '⣯', '⣟', '⣻', '⣽', '⣾', '⣷', '⣯', '⣟']
    pub const bars  = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█', '▇', '▆', '▅', '▄', '▃', '▂']
    pub const star  = ['✶', '✸', '✹', '✺', '✹', '✷']
}

pub class Spinner < Component {
    variant: String | nil
    speed:     Float | nil
    style:     String | nil
    color:     String | nil
    label:     String | nil
    status-id: String | nil

    __frame: Int = 0

    interval -> Float { float(speed ?? 0.08) }
    tick() { __frame += 1 }

    render() -> Node {
        if let $id = status-id {
            claim-status(self, id, {state: term.status.WORKING, msg: label})
        }

        let fr = part('Spinner', 'frame', [], variant)
        let lb = part('Spinner', 'label', [], variant)
        let fk = color ? nil : fr
        let chars = match style {
            'dots'   => spin.dots,
            'dots2'  => spin.dots2,
            'line'   => ['|', '/', '-', '\\'],
            'arc'    => ['◜', '◠', '◝', '◞', '◡', '◟'],
            'star'   => spin.star,
            'bounce' => ['⠁', '⠂', '⠄', '⡀', '⢀', '⠠', '⠐', '⠈'],
            'bar'    => spin.bars,
            _        => spin.star
        }

        label ? (
            <Box direction="row" gap=1>
                <Text look=fk style=color>{chars[__frame % #chars]}</Text>
                <Text look=lb>{label}</Text>
            </Box>
        ) : <Text look=fk style=color>{chars[__frame % #chars]}</Text>
    }
}

pub const CURSOR_SHAPES: Dict[String, Int] = %{
    'terminal':           0,
    'blinking-block':     1,
    'block':              2,
    'blinking-underline': 3,
    'underline':          4,
    'blinking-bar':       5,
    'bar':                6
}

const CURSOR_MARK = /\x1b\]7777;([\w-]*)\x07/

pub fn cursor-mark(shape: String = 'terminal') -> String {
    "\x1b]7777;{shape}\x07"
}

fn markup-run(spec: String, s: String) -> String {
    (#spec.trim() == 0) ? chalk-escape(s) : "[{spec}]{chalk-escape(s)}[/]"
}

fn legacy-trigger(complete: CompletionFunction) -> Trigger {
    fn source(c: Completion) -> Array[_] {
        let ed = c.editor
        match complete({before: ed.before, after: ed.after}) {
            CycleCompletions($items) => do {
                c.cycle? = true
                items
            },
            ListCompletions($items) => items,
            Insert($s) => do {
                ed.insert(s)
                []
            },
            ReplaceLine($s) => do {
                ed.set-text(s)
                []
            },
            _ => []
        }
    }
    Trigger(_ -> true, source, auto?=false)
}

pub class EditView {
    editor:   Editor
    scroll-x: Int
    scroll-y: Int

    init(editor: Editor) {
        self.editor = editor
        scroll-x    = 0
        scroll-y    = 0
    }

    rows(width: Int, wrap?: Bool) -> Int {
        #editor.visual-rows(wrap? ? max(width, 1) : nil)
    }

    lines(
        width: Int,
        height: Int | nil = nil,
        wrap?: Bool = false,
        focused?: Bool = true,
        text: String = '',
        cursor: String = 'reverse',
        shape: String = 'reverse',
        placeholder: String | nil = nil,
        hint: String = '',
        highlight: Function | nil = nil
    ) -> Array[String] {
        let ed = editor
        let w  = max(width, 1)
        ed.wrap-width = wrap? ? w : nil

        if ed.empty? && placeholder != nil {
            let first = __placeholder(placeholder, w, focused?, hint, cursor, shape)
            return [first] + [' ' * w for _ in 1..(height ?? 1)]
        }

        let rows   = ed.visual-rows(ed.wrap-width)
        let (r, _) = ed.visual-pos(rows)
        let h      = height ?? #rows

        scroll-y = scroll-y.clamp(max(r - h + 1, 0), r).clamp(0, max(#rows - h, 0))

        let chars = ed.chars
        let off = if wrap? {
            0
        } else {
            let (s, e) = rows[r]
            let (sx, _) = text-window(chars[s;e], ed.cursor - s, scroll-x, w)
            scroll-x = sx
            chars[s;s + sx].map(&width).sum(0)
        }

        let styles = __styles(text, highlight)
        [
            (i < #rows) ? __row(rows[i], off, w, styles, (focused? && i == r) ? shape : nil, cursor) : ' ' * w
            for i in scroll-y..scroll-y + h
        ]
    }

    __styles(base: String, highlight: Function | nil) -> Array[String] {
        let n = #editor.chars
        let styles = [base] * n
        let extra = (highlight != nil) ? highlight(editor.text) : []
        for (from, to, spec) in editor.spans() + extra {
            for i in max(from, 0)..min(to, n) {
                styles[i] = "{styles[i]} {spec}"
            }
        }
        styles
    }

    __row(
        span: (Int, Int),
        off: Int,
        w: Int,
        styles: Array[String],
        shape: String | nil,
        cursor: String
    ) -> String {
        let (s, e) = span
        let chars  = editor.chars
        let at     = editor.cursor
        let here?  = shape != nil && at >= s && at <= e
        let start = s + skip-cols(chars[s;e], off)
        let room  = (here? && at == e) ? w - 1 : w
        let end   = start
        let used  = 0
        while end < e && used + chars[end].width() <= room {
            used += chars[end].width()
            end += 1
        }

        let pre  = Blob()
        let post = Blob()
        let mark = ''
        let i = start
        while i < end {
            let j = i + 1
            while j < end && styles[j] == styles[i] && !(here? && j == at) {
                j += 1
            }
            let buf = (here? && i >= at) ? post : pre
            if here? && i == at && shape == 'reverse' {
                buf.push(markup-run("{styles[i]} {cursor}", chars[i]))
                buf.push(markup-run(styles[i], chars[i + 1;j].join()))
            } else {
                buf.push(markup-run(styles[i], chars[i;j].join()))
            }
            i = j
        }

        if here? && at == end {
            if shape == 'reverse' {
                post.push(markup-run(cursor, ' '))
                used += 1
            }
        }
        if here? && shape != 'reverse' {
            mark = cursor-mark(shape ?? 'terminal')
        }

        let fill = ' ' * max(w - used, 0)
        "{chalk.render(pre.str!())}{mark}{chalk.render(post.str!())}{fill}"
    }

    __placeholder(ph: String, w: Int, focused?: Bool, hint: String, cursor: String, shape: String) -> String {
        let cs       = ph.chars()
        let (_, end) = text-window(cs, 0, 0, w)
        let shown    = cs[;end]
        let fake?    = focused? && shape == 'reverse'
        let used     = max(shown.map(&width).sum(0), fake? ? 1 : 0)
        let body     = fake?
            ? "{markup-run("{hint} {cursor}", shown.?[0] ?? ' ')}{markup-run(hint, shown[1;].join())}"
            : markup-run(hint, shown.join())
        let mark     = (focused? && !fake?) ? cursor-mark(shape) : ''
        "{mark}{chalk.render(body)}{' ' * max(w - used, 0)}"
    }
}

pub class SuggestionList < Component {
    variant:    String | nil
    completion: Picker | nil
    rows:       Int | nil
    width:      Int | nil
    gap:        Int | nil
    arrows?:    Bool | nil
    layout:     String | nil

    __seen: Int = -1

    stale? -> Bool {
        (completion.?rev ?? -1) != __seen
    }

    static __chrome(fr: Dict[String, _]) -> (Int, Int) {
        let border = ((fr['border'] ?? 'none') != 'none') ? 2 : 0
        (
            border + 2 * int(fr['pad-x'] ?? fr['padding'] ?? 0),
            border + 2 * int(fr['pad-y'] ?? fr['padding'] ?? 0)
        )
    }

    static height(c: Picker | nil, rows: Int = 8, variant: String | nil = nil, arrows?: Bool = false) -> Int {
        let $c = c or return 0
        if !c.visible? {
            return 0
        }
        let (_, chrome) = __chrome(part('SuggestionList', 'frame', [], variant))
        max(min(#c.items, rows), 1) + chrome + (arrows? ? 2 : 0)
    }

    __p(name: String, sel?: Bool = false) -> Dict[String, _] {
        part('SuggestionList', name, sel? ? ['selected'] : [], variant)
    }

    __inner-w() -> Int {
        let (chrome, _) = __chrome(__p('frame'))
        let w = width ?? ((layout-max-w < INF) ? layout-max-w : 40)
        max(w - chrome, 1)
    }

    static __ellipsize(s: String, w: Int) -> String {
        if w <= 0 {
            return ''
        }
        let out = Blob()
        let used = 0
        for c in s.chars() {
            break if used + c.width() > w - 1
            out.push(c)
            used += c.width()
        }
        "{out.str!()}…"
    }

    __label(item: Suggestion, sel?: Bool, w: Int) -> String {
        let spec     = __p('label', sel?)['spec'] ?? ''
        let hit-spec = __p('match', sel?)['spec'] ?? ''
        if !(item.label :: String) {
            return "{item.label}"
        }
        let text = (item.plain.width() > w) ? __ellipsize(item.plain, w) : item.label
        let cs = text.chars()
        let hits = %[*item.hits]
        let buf = Blob()
        let i = 0
        while i < #cs {
            let hit? = i in hits
            let j = i + 1
            while j < #cs && (j in hits) == hit? {
                j += 1
            }
            buf.push(markup-run(hit? ? "{spec} {hit-spec}" : spec, cs[i;j].join()))
            i = j
        }
        buf.str!()
    }

    __row(item: Suggestion, sel?: Bool, cols: (Int, Int, Int, Int), inner-w: Int) -> String {
        let (mark-w, label-w, detail-w, kind-w) = cols
        let gap        = gap ?? 2
        let item-spec  = sel? ? (__p('item', true)['spec'] ?? '') : "{__p('item')['spec'] ?? ''} {item.style ?? ''}"
        let label-spec = __p('label', sel?)['spec'] ?? ''
        let marker     = __p('marker', sel?)
        let mark-text  = (marker['content'] ?? '').fit(mark-w)
        let label      = __label(item, sel?, label-w - gap)
        let label-pad  = ' ' * max(label-w - min(item.plain.width(), label-w - gap), 0)
        let detail-raw = "{item.detail ?? ''}"
        let detail-txt = (detail-raw.width() > detail-w) ? __ellipsize(detail-raw, detail-w) : detail-raw
        let detail     = markup-run(__p('detail', sel?)['spec'] ?? '', detail-txt)
        let kind-txt   = "{item.kind ?? ''}"
        let kind       = (kind-w > 0) ? markup-run(__p('kind', sel?)['spec'] ?? '', kind-txt.fit(kind-w)) : ''
        let used       = mark-w + label-w + detail-txt.width() + kind-w
        let fill       = ' ' * max(inner-w - used, 0)
        str(chalk.render(
            "[{item-spec}]"
            "{markup-run(marker['spec'] ?? '', mark-text)}{label}{markup-run(label-spec, label-pad)}"
            "{detail}{markup-run(label-spec, fill)}{kind}[/]"
        ))
    }

    __columns(c: Picker, inner-w: Int) -> (Int, Int, Int, Int) {
        let gap    = gap ?? 2
        let mark-w = [__p('marker', false), __p('marker', true)].map(m -> (m['content'] ?? '').width()).max() ?? 0
        let kind-w = c.items.map(it -> "{it.kind ?? ''}".width()).max() ?? 0
        let avail  = inner-w - mark-w - ((kind-w > 0) ? kind-w + gap : 0)
        let widest = (c.items.map(it -> it.plain.width()).max() ?? 0) + gap
        let label-w = min(widest, (avail + 1) / 2)
        let detail-w = avail - label-w
        (mark-w, label-w, detail-w, kind-w)
    }

    __grid(c: Picker, inner-w: Int) -> Array[String] {
        let rows  = fit-items(c.items.map(&.label), max(inner-w, 20))
        let ncols = max(#(rows.?[0] ?? []), 1)
        let per   = (#c.items + ncols - 1) / ncols
        let hi    = c.index
        let spec  = __p('item', true)['spec'] ?? 'reverse'
        let out: Array[String] = []
        for row; ri in rows {
            let parts = [*row]
            let ci = (hi >= 0) ? hi / per : -1
            if hi >= 0 && hi % per == ri && ci < #parts {
                parts[ci] = str(chalk"[{spec}]{parts[ci]}[/]")
            }
            out.push(parts.join('    '))
        }
        out
    }

    __arrow(name: String, show?: Bool, fallback: String) -> String {
        let p = __p(name)
        show? ? str(chalk.render(markup-run(p['spec'] ?? '', p['content'] ?? fallback))) : ' '
    }

    __list(c: Picker, inner-w: Int) -> Array[String] {
        let (s, e) = c.open? ? c.window(rows ?? 8) : (0, 0)
        let lines = if c.open? {
            let cols = __columns(c, inner-w)
            [__row(item, s + k == c.index, cols, inner-w) for item; k in c.items[s;e]]
        } else {
            let empty = __p('empty')
            [str(chalk.render(markup-run(empty['spec'] ?? '', empty['content'] ?? 'no matches')))]
        }
        if !(arrows? ?? false) {
            return lines
        }
        [__arrow('scroll-up', s > 0, '↑'), *lines, __arrow('scroll-down', e < #c.items, '↓')]
    }

    render() -> Node | nil {
        __seen = completion.?rev ?? -1
        let $c = completion or return nil
        if !c.visible? {
            return nil
        }
        let inner-w = __inner-w()
        let lines = ((layout ?? (c.cycle? ? 'grid' : 'list')) == 'grid')
            ? __grid(c, inner-w)
            : __list(c, inner-w)
        <Box look=__p('frame') direction="column">
            {lines.map(l -> <Text wrap="truncate">{l}</Text>)}
        </Box>
    }
}

pub class TextInput < Component {
    variant:       String | nil
    cls:           String | nil
    placeholder:   String | nil
    on-change:     Function | nil
    on-submit:     Function | nil
    on-edit:       Function | nil
    complete:      CompletionFunction | nil
    triggers:      Array[Trigger] | nil
    highlight:     Function | nil
    keymap:        Dict[String, Function] | nil
    editor:        Editor | nil
    history:       Array[String] | nil
    history-file:  String | nil
    multiline?:    Bool | nil
    wrap?:         Bool | nil
    rows:          Int | nil
    popup:         Function | nil
    popup-at:      String | nil
    popup-rows:    Int | nil
    width:         Int | nil
    color:         String | Function | nil
    border-style:  String | Array[String] | Function | false | nil
    border-color:  String | Function | nil
    value:         String | nil

    __own:      Editor | nil
    __view:     EditView | nil
    __last-val: String | nil
    __seen:     _ = nil

    init(*children, %props) {
        super(*children, **props)
        __own      = nil
        __view     = nil
        __last-val = value
    }

    focusable? -> Bool { true }

    __state() -> _ {
        let e = ed
        (e.version, e.cursor, e.completion, e.completion.?rev)
    }

    stale? -> Bool {
        __state() != __seen
    }

    handles-tab? -> Bool {
        let e = ed
        #e.triggers > 0 || e.suggesting?
    }

    ed -> Editor {
        editor ?? __own ?? (__own = __make-editor())
    }

    text -> String { ed.text }

    __triggers() -> Array[Trigger] {
        [*(triggers ?? []), *((complete != nil) ? [legacy-trigger(complete)] : [])]
    }

    __keys() -> Dict[String, Function] {
        let keys = %{**(multiline? ? MULTILINE_KEYS : %{}), **(keymap ?? %{})}
        if #__triggers() > 0 && keys['Tab'] == nil {
            keys['Tab'] = &complete
        }
        %{**EDITOR_KEYS, **keys}
    }

    __make-editor() -> Editor {
        let hist = (history != nil || history-file != nil) ? History(history ?? [], file=history-file) : nil
        let e = Editor(
            text=value ?? '',
            multiline?=multiline? ?? false,
            triggers=__triggers(),
            history=hist
        )
        e.keymap = __keys()
        e
    }

    __sync() {
        if editor != nil || __own == nil {
            return
        }
        __own.triggers = __triggers()
        __own.keymap   = __keys()
    }

    on-event(ev) {
        __sync()
        let e = ed
        let v0 = e.version
        let r = e.handle(ev)
        if r == Ignored {
            r = __fallback(ev)
        }
        if e.version != v0 and let $f = on-change {
            f(e.text)
        }
        r
    }

    __fallback(ev) -> _ {
        let $name = (ev :: event.Key) ? key-name(ev) : nil or return Ignored
        match name {
            /Enter$/                    => __submit(),
            'Esc'                       => unfocus(),
            'Tab'                       => true,
            'C-x' and on-edit != nil    => __external(),
            _                           => Ignored
        }
    }

    __submit() {
        let e = ed
        let t = e.text
        e.completion = nil
        e.history.?push(t)
        if let $f = on-submit {
            f(t)
        }
    }

    __external() {
        if not let (fd, tmp) = mktemp(Path.tmp() / 'ink-edit') {
            return
        }
        let seed = ed.text
        if #seed > 0 {
            write(fd, seed)
        }
        os.close(fd)

        if let $tio = _tio {
            tio.stop()
            write(1, "\x1b[?25h\x1b[?1049l")
            try {
                let cmd = (getenv('EDITOR') ?? 'vi').split(/\s+/).filter(\_ != '')
                let ed = spawn([*cmd, tmp])
                wait(ed.pid)
            } finally {
                write(1, _inline? ? "\x1b[?25l" : "\x1b[?1049h\x1b[?25l")
                tio.start()
                invalidate-screen()
            }
        }

        let out = (slurp(tmp) ?? '').comb(/\r/).trim()
        unlink(tmp)
        if #out > 0 and let $f = on-edit {
            f(out)
        }
    }

    static __border?(fr: Dict[String, _], bstyle: _) -> Bool {
        match bstyle {
            nil   => (fr['border'] ?? 'none') != 'none',
            false => false,
            _     => true
        }
    }

    static __chrome(fr: Dict[String, _], bstyle: _) -> Int {
        let border = __border?(fr, bstyle) ? 2 : 0
        border + 2 * int(fr['pad-x'] ?? fr['padding'] ?? 0) + 2 * int(fr['margin-x'] ?? fr['margin'] ?? 0)
    }

    __popup(at: String, w: Int, frame-h: Int) -> Node | nil {
        let e = ed
        let $c = e.completion or return nil
        if !c.visible? || !focused? {
            return nil
        }
        let rows = popup-rows ?? 8
        let node = match popup {
            f: Function => f(c, self),
            _           => <SuggestionList completion=c rows=rows width=w variant=variant />
        }
        if at != 'overlay' {
            return node
        }
        let h = SuggestionList.height(c, rows, variant)
        let y = (layout-y >= h) ? layout-y - h : layout-y + frame-h
        <Overlay x=layout-x y=y>{node}</Overlay>
    }

    render() -> Node {
        __sync()
        let e = ed
        __seen = __state()
        if value != __last-val {
            __last-val = value
            if let $v = value and v != e.text {
                e.set-text(v)
            }
        }
        let view = match __view {
            v: EditView and v.editor == e => v,
            _                             => (__view = EditView(e))
        }

        let fs       = focused? ? ['focused'] : []
        let fr       = part('TextInput', 'frame', fs, variant)
        let clr      = color ? resolve(color) : (part('TextInput', 'text', fs, variant)['spec'] ?? '')
        let ph-spec  = part('TextInput', 'placeholder', fs, variant)['spec'] ?? ''
        let cur      = part('TextInput', 'cursor', fs, variant)
        let prompt   = part('TextInput', 'prompt', fs, variant)
        let bstyle   = (border-style != nil) ? resolve(border-style) : nil
        let bcolor   = border-color ? resolve(border-color) : nil
        let w        = int(width ?? 20)
        let p-text   = prompt['content'] ?? ''
        let p-w      = p-text.width()
        let inner-w  = max(w - __chrome(fr, bstyle) - p-w, 1)
        let multi?   = multiline? ?? false
        let wrap     = wrap? ?? multi?
        let height   = multi? ? view.rows(inner-w, wrap).clamp(1, rows ?? 6) : 1

        let lines = view.lines(
            inner-w,
            height=height,
            wrap?=wrap,
            focused?=focused?,
            text=clr,
            cursor=cur['spec'] ?? 'reverse',
            shape=cur['shape'] ?? 'reverse',
            placeholder=placeholder ?? '',
            hint=ph-spec,
            highlight=highlight
        )

        let lead    = str(chalk.render(markup-run(prompt['spec'] ?? '', p-text)))
        let indent  = ' ' * p-w
        let at      = popup-at ?? (_inline? ? 'above' : 'overlay')
        let pad-y   = int(fr['pad-y'] ?? fr['padding'] ?? 0)
        let frame-h = height + 2 * pad-y + (__border?(fr, bstyle) ? 2 : 0)
        let rows    = [<Text>{"{(i == 0) ? lead : indent}{l}"}</Text> for l; i in lines]

        <Box direction="column">
            {at == 'above' && __popup(at, w, frame-h)}
            <Box look=fr cls=cls border-style=bstyle border-color=bcolor direction="column">
                {rows}
            </Box>
            {(at == 'below' || at == 'overlay') && __popup(at, w, frame-h)}
        </Box>
    }
}

pub class TextArea < Component {
    variant:      String | nil
    cls:          String | nil
    width:        Int | nil
    height:       Int | nil
    on-change:    Function | nil
    color:        String | Function | nil
    border-color: String | Function | nil
    placeholder:  String | nil
    value:        String | nil
    editor:       Editor | nil
    highlight:    Function | nil
    triggers:     Array[Trigger] | nil
    keymap:       Dict[String, Function] | nil
    wrap?:        Bool | nil

    __own:  Editor | nil
    __view: EditView | nil
    __seen: _ = nil

    init(*children, %props) {
        super(*children, **props)
        __own  = nil
        __view = nil
    }

    focusable? -> Bool { true }

    stale? -> Bool {
        (ed.version, ed.cursor) != __seen
    }

    handles-tab? -> Bool {
        ed.suggesting?
    }

    ed -> Editor {
        editor ?? __own ?? (__own = Editor(
            text=value ?? '',
            multiline?=true,
            keymap=%{'Enter': &newline, **(keymap ?? %{})},
            triggers=triggers ?? []
        ))
    }

    text -> String { ed.text }

    on-event(ev) {
        let e = ed
        let v0 = e.version
        let r = e.handle(ev)
        if e.version != v0 and let $f = on-change {
            f(e.text)
        }
        r
    }

    render() -> Node {
        let e = ed
        __seen = (e.version, e.cursor)
        let view = match __view {
            v: EditView and v.editor == e => v,
            _                             => (__view = EditView(e))
        }
        let w       = int(width ?? 40)
        let h       = int(height ?? 10)
        let fs      = focused? ? ['focused'] : []
        let fr      = part('TextArea', 'frame', fs, variant)
        let clr     = color ? resolve(color) : (part('TextArea', 'text', fs, variant)['spec'] ?? '')
        let ph-spec = part('TextArea', 'placeholder', fs, variant)['spec'] ?? ''
        let cur     = part('TextArea', 'cursor', fs, variant)
        let bc      = border-color ? resolve(border-color) : nil

        let lines = view.lines(
            max(w - 2, 1),
            height=max(h - 2, 1),
            wrap?=wrap? ?? false,
            focused?=focused?,
            text=clr,
            cursor=cur['spec'] ?? 'reverse',
            shape=cur['shape'] ?? 'reverse',
            placeholder=(focused? ? nil : placeholder),
            hint=ph-spec,
            highlight=highlight
        )

        <Box look=fr cls=cls border-color=bc direction="column">
            {lines.map(line -> <Text>{line}</Text>)}
        </Box>
    }
}

pub class Select < Component {
    items:          Array[String] | nil
    selected:       Int | nil
    on-change:      Function | nil
    color:          String | Function | nil
    selected-color: String | Function | nil
    border-color:   String | Function | nil
    on-submit:      Function | nil
    height:         Int | nil
    variant:        String | nil

    __sel: Int
    __top: Int = 0

    init(*children, %props) {
        super(*children, **props)
        __sel = int(selected ?? 0)
    }

    focusable? -> Bool { true }

    selected-index -> Int { __sel }
    selected-item { (items ?? [])[__sel] }

    __clamp(n: Int) {
        __sel = (n == 0) ? 0 : __sel.clamp(0, n - 1)
    }

    __emit() {
        if on-change { on-change(__sel) }
    }

    __move(to: Int, n: Int) {
        let next = to.clamp(0, n - 1)
        if next != __sel {
            __sel = next
            __emit()
        }
    }

    __item-style(sel?: Bool, d: Dict[String, _]) -> String | nil {
        match (sel?, selected-color, color) {
            (true, $c, _)  => "{resolve(c)} bold",
            (false, _, $c) => resolve(c),
            _              => d['spec']
        }
    }

    __rows(n: Int) -> Int {
        (height != nil) ? max(int(height) - 2, 1) : n
    }

    on-event(ev) {
        let itms = items ?? []
        let n = #itms
        if n == 0 {
            return Ignored
        }
        __clamp(n)
        let page = __rows(n)

        match ev {
            event.Key({key: 'UP', event: (1 or 2), *}) or event.Text('k') => do {
                __sel = (__sel - 1 + n) % n
                __emit()
            },
            event.Key({key: 'DOWN', event: (1 or 2), *}) or event.Text('j') => do {
                __sel = (__sel + 1) % n
                __emit()
            },
            event.Key({key: 'HOME', event: (1 or 2), *})      => __move(0, n),
            event.Key({key: 'END', event: (1 or 2), *})       => __move(n - 1, n),
            event.Key({key: 'PAGE_UP', event: (1 or 2), *})   => __move(__sel - page, n),
            event.Key({key: 'PAGE_DOWN', event: (1 or 2), *}) => __move(__sel + page, n),
            event.Key({key: 'ENTER', event: 1, *}) or event.Text(' ') => do {
                if on-submit {
                    on-submit(__sel)
                } else {
                    __emit()
                }
            },
            event.MouseDown({y, button: 0, *}) => __move(__top + int(y) - 2 - layout-y, n),
            event.ScrollUp(_)   => __move(__sel - 1, n),
            event.ScrollDown(_) => __move(__sel + 1, n),
            _ => return Ignored
        }
        true
    }

    render() -> Node {
        let itms = items ?? []
        __clamp(#itms)
        let fs = focused? ? ['focused'] : []
        let fr = part('Select', 'frame', fs, variant)
        let bc = border-color ? resolve(border-color) : fr['border-color']
        let bs = (fr['border'] == 'none') ? nil : fr['border']

        let rows = __rows(#itms)
        if __sel < __top {
            __top = __sel
        } else if __sel >= __top + rows {
            __top = __sel - rows + 1
        }
        __top = __top.clamp(0, max(#itms - rows, 0))

        <Box direction="column" border-style=bs border-color=bc pad-x=fr['pad-x'] pad-y=fr['pad-y']>
            {[
                do {
                    let sel? = (__top + i == __sel)
                    let sts = sel? ? [*fs, 'selected'] : fs
                    let it = part('Select', 'item', sts, variant)
                    let ic = part('Select', 'indicator', sts, variant)
                    <Text style=__item-style(sel?, it)>{ic['content']} {item}</Text>
                }
                for item; i in itms[__top;__top + rows]
            ]}
        </Box>
    }
}

pub class Checkbox < Component {
    checked:   Bool | nil
    on-change: Function | nil
    label:     String | nil
    color:     String | Function | nil
    variant:   String | nil

    __on: Bool

    init(*children, %props) {
        super(*children, **props)
        __on = checked ?? false
    }

    focusable? -> Bool { true }

    checked? -> Bool { __on }

    on-event(ev) {
        match ev {
            event.Key({key: 'ENTER', event: 1, *})
            or event.Text(' ')
            or event.Text('x')
            or event.MouseDown({button: 0, *}) => {
                __on = !__on
                if on-change { on-change(__on) }
            },
            _ => Ignored
        }
    }

    render() -> Node {
        let sts = [*(focused? ? ['focused'] : []), *(__on ? ['checked'] : [])]
        let ic = part('Checkbox', 'icon', sts, variant)
        let lb = part('Checkbox', 'label', sts, variant)
        let ls = color ? (focused? ? "{resolve(color)} bold" : resolve(color)) : lb['spec']

        <Box direction="row" gap=1>
            <Text style=ic['spec']>{ic['content']}</Text>
            <Text style=ls>{label ?? children}</Text>
        </Box>
    }
}

pub class Slider < Component {
    variant: String | nil
    min-val:   Float | nil
    max-val:   Float | nil
    value:     Float | nil
    step:      Float | nil
    width:     Int | nil
    color:     String | Function | nil
    label:     String | nil
    format:    Function | nil
    on-change: Function | nil

    __val: Float
    __track-x: Int
    __track-w: Int

    init(*children, %props) {
        super(*children, **props)
        __val = float(value ?? 0.5)
        __track-x = 0
        __track-w = 0
    }

    focusable? -> Bool { true }

    current -> Float { __val }

    __mn -> Float { float(min-val ?? 0.0) }
    __mx -> Float { float(max-val ?? 1.0) }

    __emit() {
        if on-change { on-change(__val) }
    }

    __jump(click-x: Int) {
        if __track-w > 0 {
            let rel = (float(click-x - layout-x - __track-x) - 0.5) / float(__track-w)
            __val = (__mn + rel.clamp(0.0, 1.0) * (__mx - __mn))
            __emit()
        }
    }

    on-event(ev) {
        let stp: Float = float(step ?? ((__mx - __mn) / 20.0))

        match ev {
            event.Key({key: 'LEFT', event: (1 or 2), *})
            or event.Text('h') =>
                { __val = max(__val - stp, __mn); __emit() },

            event.Key({key: 'RIGHT', event: (1 or 2), *})
            or event.Text('l') =>
                { __val = min(__val + stp, __mx); __emit() },

            event.Key({key: 'HOME', event: (1 or 2), *}) =>
                { __val = __mn; __emit() },

            event.Key({key: 'END', event: (1 or 2), *}) =>
                { __val = __mx; __emit() },

            event.MouseMove({x: $mx, *}) =>
                __jump(int(mx) - 1),

            _ => Ignored
        }
    }

    render() -> Node {
        let total-w: Int = int(width ?? 20)
        let fs = focused? ? ['focused'] : []
        let lp = part('Slider', 'label', fs, variant)
        let fp = part('Slider', 'fill', fs, variant)
        let hp = part('Slider', 'thumb', fs, variant)
        let tp = part('Slider', 'track', fs, variant)
        let vp = part('Slider', 'value', fs, variant)
        let clr = color ? resolve(color) : nil
        let lbl = label
        let display = format ? format(__val) : "{__val:.1f}"

        let label-w = lbl ? lbl.width() : 0
        let gaps = (lbl ? 2 : 1)
        let tw = max(total-w - label-w - display.width() - gaps, 4)

        __track-w = tw
        __track-x = lbl ? label-w + 1 : 0

        let pct = ((__mx - __mn) > 0.0)
            ? (__val - __mn) / (__mx - __mn) : 0.0
        let filled = int(pct.clamp(0.0, 1.0) * tw)
        let empty = tw - filled

        let thumb = hp['content'] ?? '●'
        let track-l = (fp['content'] ?? '━') * max(filled - 1, 0)
        let track-r = (tp['content'] ?? '━') * max(empty - 1, 0)

        let on-track-click = ev -> do {
            if let event.MouseDown({x, *}) = ev.raw {
                __jump(int(x) - 1)
            }
        }

        let fill-spec = clr ?? spec-of-part(fp)
        let thumb-spec = clr ? "{clr} bold" : spec-of-part(hp)
        let track-spec = spec-of-part(tp)
        let track = str(
            chalk"[{fill-spec}]{track-l}[/]"
                 "[{thumb-spec}]{thumb}[/]"
                 "[{track-spec}]{track-r}[/]"
        )
        let label-look = clr ? nil : lp
        let label-style = clr ? (focused? ? "{clr} bold" : clr) : nil

        if lbl {
            <Box direction="row" gap=1 on-click=on-track-click>
                <Text look=label-look style=label-style>{lbl}</Text>
                <Text>{track}</Text>
                <Text look=vp>{display}</Text>
            </Box>
        } else {
            <Box direction="row" gap=1 on-click=on-track-click>
                <Text>{track}</Text>
                <Text look=vp>{display}</Text>
            </Box>
        }
    }
}

pub class RangeSelector < Component {
    variant: String | nil
    min-val:   Float | nil
    max-val:   Float | nil
    low:       Float | nil
    high:      Float | nil
    step:      Float | nil
    width:     Int | nil
    color:     String | Function | nil
    label:     String | nil
    format:    Function | nil
    on-change: Function | nil
    on-set:    Function | nil

    __lo: Float
    __hi: Float
    __active: Int
    __track-x: Int
    __track-w: Int
    __dragging?: Bool

    init(*children, %props) {
        super(*children, **props)
        __lo = float(low ?? 0.25)
        __hi = float(high ?? 0.75)
        __active = 0
        __dragging? = false
        __track-x = 0
        __track-w = 0
    }

    focusable? -> Bool { true }

    range -> (Float, Float) { (__lo, __hi) }

    __mn -> Float { float(min-val ?? 0.0) }
    __mx -> Float { float(max-val ?? 1.0) }

    __emit() {
        if on-change { on-change(__lo, __hi) }
    }

    __emit-set() {
        __emit()
        if on-set { on-set(__lo, __hi) }
    }

    __jump(click-x: Int) {
        if __track-w > 0 {
            let rel = (float(click-x - layout-x - __track-x) - 0.5) / float(__track-w)
            let v = __mn + rel.clamp(0.0, 1.0) * (__mx - __mn)
            let d-lo = (v - __lo).abs
            let d-hi = (v - __hi).abs
            if d-lo <= d-hi {
                __lo = min(v, __hi)
                __active = 0
            } else {
                __hi = max(v, __lo)
                __active = 1
            }
            __emit()
        }
    }

    on-event(ev) {
        let stp = float(step ?? ((__mx - __mn) / 20.0))

        match ev {
            event.Key({key: 'LEFT', event: (1 or 2), *})
            or event.Text('h') => do {
                if __active == 0 {
                    __lo = max(__lo - stp, __mn)
                } else {
                    __hi = max(__hi - stp, __lo)
                }
                __emit-set()
            },

            event.Key({key: 'RIGHT', event: (1 or 2), *}) or event.Text('l') => do {
                if __active == 0 {
                    __lo = min(__lo + stp, __hi)
                } else {
                    __hi = min(__hi + stp, __mx)
                }
                __emit-set()
            },

            event.Text('1') or event.Key({key: 'TAB', event: 1, mods: 0, *}) => {
                __active = (__active + 1) % 2
            },

            event.MouseMove({x, *}) and __dragging? =>
                __jump(int(x) - 1),

            event.MouseUp({x, *}) and __dragging? => {
                __dragging? = false
                __jump(int(x) - 1)
                if on-set { on-set(__lo, __hi) }
            },

            _ => Ignored
        }
    }

    render() -> Node {
        let total-w: Int = int(width ?? 20)
        let fs = focused? ? ['focused'] : []
        let lp = part('RangeSelector', 'label', fs, variant)
        let fp = part('RangeSelector', 'fill', fs, variant)
        let tp = part('RangeSelector', 'track', fs, variant)
        let vp = part('RangeSelector', 'value', fs, variant)
        let lo-p = part('RangeSelector', 'thumb', (focused? && __active == 0) ? [*fs, 'active'] : fs, variant)
        let hi-p = part('RangeSelector', 'thumb', (focused? && __active == 1) ? [*fs, 'active'] : fs, variant)
        let clr = color ? resolve(color) : nil
        let lbl = label
        let fmt = format ?? (v -> "{v:.1f}")
        let display = "{fmt(__lo)}–{fmt(__hi)}"

        let label-w = lbl ? lbl.width() : 0
        let gaps = (lbl ? 2 : 1)
        let tw = max(total-w - label-w - display.width() - gaps, 4)

        __track-w = tw
        __track-x = lbl ? label-w + 1 : 0

        let rng = __mx - __mn
        let lo-pos = (rng > 0.0)
            ? int(((__lo - __mn) / rng).clamp(0.0, 1.0) * tw)
            : 0
        let hi-pos = (rng > 0.0)
            ? int(((__hi - __mn) / rng).clamp(0.0, 1.0) * tw)
            : tw

        let thumb-lo = lo-p['content'] ?? '●'
        let thumb-hi = hi-p['content'] ?? '●'
        let track-ch = tp['content'] ?? '━'

        let seg-before = track-ch * max(lo-pos, 0)
        let seg-mid = (fp['content'] ?? '━') * max(hi-pos - lo-pos - 1, 0)
        let seg-after = track-ch * max(tw - hi-pos - 1, 0)

        let fill-spec = clr ?? spec-of-part(fp)
        let lo-spec = clr ? "{clr} bold" : spec-of-part(lo-p)
        let hi-spec = clr ? "{clr} bold" : spec-of-part(hi-p)
        let track-spec = spec-of-part(tp)
        let on-track-click = ev -> do {
            if let event.MouseDown({x, *}) = ev.raw {
                __dragging? = true
                __jump(int(x) - 1)
            }
        }

        let track = str(
            chalk"[{track-spec}]{seg-before}[/]"
                 "[{lo-spec}]{thumb-lo}[/]"
                 "[{fill-spec}]{seg-mid}[/]"
                 "[{hi-spec}]{thumb-hi}[/]"
                 "[{track-spec}]{seg-after}[/]"
        )
        let label-look = clr ? nil : lp
        let label-style = clr ? (focused? ? "{clr} bold" : clr) : nil

        if lbl {
            <Box direction="row" gap=1 on-click=on-track-click>
                <Text look=label-look style=label-style>
                    {lbl}
                </Text>
                <Text>{track}</Text>
                <Text look=vp>{display}</Text>
            </Box>
        } else {
            <Box direction="row" gap=1 on-click=on-track-click>
                <Text>{track}</Text>
                <Text look=vp>{display}</Text>
            </Box>
        }
    }
}

pub class TrackBar < Component {
    variant: String | nil
    value:     Float | nil
    min-val:   Float | nil
    max-val:   Float | nil
    width:     Int | nil
    color:     String | nil
    format:    Function | nil
    label:     String | nil
    playing?:  Bool | nil
    speed:     Float | nil
    speeds:    Array[Float] | nil
    on-change: Function | nil
    on-play:   Function | nil
    on-pause:  Function | nil
    on-speed:  Function | nil
    step:      Float | nil

    __dragging?: Bool = false
    __track-x: Int = 0
    __track-w: Int = 0

    focusable? -> Bool { true }

    __mn -> Float { float(min-val ?? 0.0) }
    __mx -> Float { float(max-val ?? 1.0) }
    __val -> Float { float(value ?? __mn).clamp(__mn, __mx) }
    __spd -> Float { float(speed ?? 1.0) }
    __spds -> Array[Float] { speeds ?? [-8.0, -4.0, -2.0, -1.0, -0.5, 0.25, 0.5, 1.0, 2.0, 4.0, 8.0] }

    __emit(v: Float) {
        if on-change { on-change(v.clamp(__mn, __mx)) }
    }

    __seek(click-x: Int) {
        if __track-w > 0 {
            let local = click-x - layout-x - __track-x
            let rel = 1.0 * local / __track-w
            __emit(__mn + rel * (__mx - __mn))
        }
    }

    __cycle-speed(dir: Int) {
        if !on-speed { return }
        let sp = __spds
        if #sp == 0 { return }
        let cur = __spd
        let idx = 0
        let best = (cur - sp[0]).abs
        for i in 1..#sp {
            let d = (cur - sp[i]).abs
            if d < best { idx = i; best = d }
        }
        on-speed(sp[(idx + dir).clamp(0, #sp - 1)])
    }

    __toggle() {
        if playing? ?? false {
            if on-pause { on-pause() }
        } else {
            if on-play { on-play() }
        }
    }

    on-event(ev) {
        let stp = step ?? ((__mx - __mn) / 200.0)

        match ev {
            event.Text(' ') => __toggle(),

            (event.Key({key: 'LEFT', event: (1 or 2), *}) or event.Text('h')) =>
                __emit(__val - stp),

            (event.Key({key: 'RIGHT', event: (1 or 2), *}) or event.Text('l')) =>
                __emit(__val + stp),

            event.Key({key: 'HOME', event: 1, *}) => __emit(__mn),

            event.Key({key: 'END', event: 1, *}) => __emit(__mx),

            event.Text('[') => __cycle-speed(-1),
            event.Text(']') => __cycle-speed(1),

            event.MouseMove({x, *}) and __dragging? =>
                __seek(x - 1),

            event.MouseUp({x, *}) and __dragging? => {
                __dragging? = false
                __seek(x - 1)
            },

            _ => Ignored
        }
    }

    render() -> Node {
        let total-w = width ?? 40
        let fs = focused? ? ['focused'] : []
        let lp = part('TrackBar', 'label', fs, variant)
        let fp = part('TrackBar', 'fill', fs, variant)
        let hp = part('TrackBar', 'thumb', fs, variant)
        let tp = part('TrackBar', 'track', fs, variant)
        let vp = part('TrackBar', 'value', fs, variant)
        let bp = part('TrackBar', 'button', fs, variant)
        let is-playing = playing? ?? false
        let pp = part('TrackBar', 'play', is-playing ? [*fs, 'playing'] : fs, variant)
        let sp-p = part('TrackBar', 'speed', fs, variant)
        let clr = color
        let fmt = format ?? (v -> "{v:.1f}")
        let sp = __spd

        let display = fmt(__val)
        let lbl = label
        let label-w = lbl ? lbl.width() + 1 : 0
        let display-w = display.width() + 1
        let tw = max(total-w - label-w - display-w, 4)

        __track-w = tw
        __track-x = label-w

        let rng = __mx - __mn
        let pos = (rng > 0.0)
            ? int(((__val - __mn) / rng).clamp(0.0, 1.0) * max(tw - 1, 0))
            : 0

        let thumb = hp['content'] ?? '●'
        let seg-before = (fp['content'] ?? '━') * max(pos, 0)
        let seg-after  = (tp['content'] ?? '━') * max(tw - pos - 1, 0)
        let fill-spec = clr ?? spec-of-part(fp)
        let thumb-spec = clr ? "{clr} bold" : spec-of-part(hp)
        let track-spec = spec-of-part(tp)
        let label-look = clr ? nil : lp
        let label-style = clr ? (focused? ? "{clr} bold" : clr) : nil

        let on-track-click = ev -> do {
            if let event.MouseDown({x, *}) = ev.raw {
                __dragging? = true
                __seek(x - 1)
            }
        }

        let track-str = str(
            chalk"[{fill-spec}]{seg-before}[/]"
                 "[{thumb-spec}]{thumb}[/]"
                 "[{track-spec}]{seg-after}[/]"
        )

        let play-icon = pp['content'] ?? (is-playing ? '‖' : '▶')
        let speed-str = match sp {
            s and s == float(int(s)) and s < 0.0 => "{int(s)}×",
            s and s == float(int(s))             => "{int(s)}×",
            s                                    => "{s}×"
        }

        <Box direction="column">
            {if lbl {
                <Box direction="row" gap=1 on-click=on-track-click>
                    <Text look=label-look style=label-style>{lbl}</Text>
                    <Text>{track-str}</Text>
                    <Text look=vp>{display}</Text>
                </Box>
            } else {
                <Box direction="row" gap=1 on-click=on-track-click>
                    <Text>{track-str}</Text>
                    <Text look=vp>{display}</Text>
                </Box>
            }}
            <Box direction="row" gap=1>
                <Box on-click=(ev -> __cycle-speed(-1))>
                    <Text look=bp>◀◀</Text>
                </Box>
                <Box on-click=(ev -> __toggle())>
                    <Text look=((clr && focused?) ? nil : pp) style=((clr && focused?) ? "{clr} bold" : nil)>{play-icon}</Text>
                </Box>
                <Box on-click=(ev -> __cycle-speed(1))>
                    <Text look=bp>▶▶</Text>
                </Box>
                <Box flex=1 />
                <Text look=sp-p>{speed-str}</Text>
            </Box>
        </Box>
    }
}

pub class BarChart < Component {
    variant: String | nil
    data:       Array[Float] | nil
    width:      Int | nil
    height:     Int | nil
    color:      String | nil
    colors:     Array[String] | nil
    labels:     Array[String] | nil
    show-vals?: Bool | nil
    min-val:    Float | nil
    max-val:    Float | nil
    bar-width:  Int | nil
    gap:        Int | nil
    y-axis?:    Bool | nil
    format:     Function | nil

    render() -> Node {
        let vs:  Array[Float] = data ?? []
        let h    = int(height ?? 8)
        let bw   = int(bar-width ?? 2)
        let g    = int(gap ?? 1)
        let clr  = color ?? (part('BarChart', 'bar', [], variant)['fg'] ?? 'primary')
        let axis-spec = spec-of-part(part('BarChart', 'axis', [], variant))
        let clrs = colors
        let lbls = labels
        let fmt  = format ?? (v -> "{v:.1f}")

        if #vs == 0 {
            let ep = part('BarChart', 'empty', [], variant)
            return <Text look=ep>{ep['content'] ?? 'no data'}</Text>
        }

        let ticks = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█']
        let lo = min-val ?? min(vs.min() ?? 0.0, 0.0)
        let hi = max-val ?? max(vs.max() ?? 0.0, 0.0)
        let hi = max(hi, lo + 1.0e-9)
        let range = hi - lo

        let ya? = y-axis? ?? true
        let yw = ya? ? max(fmt(lo).width(), fmt(hi).width(), 1) + 1 : 0
        let dim = fg-sgr(axis-spec)

        let color-table = [fg-sgr((clrs && i < #clrs) ? clrs[i] : clr) for i in ..#vs]

        let lines = []
        let line-w = 0

        for row in ..h {
            let buf = Blob()
            let rb = float(h - 1 - row) / float(h)
            let rt = float(h - row) / float(h)

            if ya? {
                let yl = (row == 0) ? fmt(hi) : (row == h - 1) ? fmt(lo) : ''
                buf.push("{dim}{"{yl:>{yw}}"}{RST}")
            }

            for i in ..#vs {
                if i > 0 && g > 0 { buf.push(' ' * g) }
                let norm = (vs[i] - lo) / range
                let fill = norm - rb
                let span = rt - rb
                let ch = if fill >= span     { ticks[7] }
                    else if fill > 0.0       { ticks[int(fill / span * 7.0).clamp(0, 6)] }
                    else                     { ' ' }
                buf.push("{color-table[i]}{ch * bw}{RST}")
            }
            let s = buf.str!()
            if row == 0 { line-w = s.width() }
            lines.push(s)
        }

        if lbls {
            let buf = Blob()
            if ya? { buf.push(' ' * yw) }
            for i in ..#vs {
                if i > 0 && g > 0 { buf.push(' ' * g) }
                let l = (i < #lbls) ? lbls[i] : ''
                buf.push("{dim}{"{l:^{bw}}"[;bw]}{RST}")
            }
            lines.push(buf.str!())
        }

        if show-vals? ?? false {
            let buf = Blob()
            if ya? { buf.push(' ' * yw) }
            for i in ..#vs {
                if i > 0 && g > 0 { buf.push(' ' * g) }
                let v = fmt(vs[i])
                buf.push("{dim}{"{v:^{bw}}"[;bw]}{RST}")
            }
            lines.push(buf.str!())
        }

        Raw(lines, line-w)
    }
}

pub class LinePlot < Component {
    variant: String | nil
    data:    Array[Float] | nil
    series:  Array[Array[Float]] | nil
    width:   Int | nil
    height:  Int | nil
    color:   String | nil
    colors:  Array[String] | nil
    min-val: Float | nil
    max-val: Float | nil
    y-axis?:  Bool | nil
    y-width:  Int | nil
    x-lo:     String | nil
    x-hi:     String | nil
    format:   Function | nil
    fill?:    Bool | nil
    kitty?:   Bool | nil
    x-format:    Function | nil
    raw-times:   Array[Int] | nil
    raw-values:  Array[Float] | nil
    t0:          Int | nil
    t1:          Int | nil
    view-t0:     Int | nil
    view-t1:     Int | nil
    on-x-zoom:   Function | nil
    time-format: Function | nil

    kitty-id: Int = 0
    kitty-entry: _ = nil
    __mouse-col: Int | nil = nil
    __cached-img-key: _ = nil
    __y-lo: Float | nil = nil
    __y-hi: Float | nil = nil
    __x-lo: Int | nil = nil
    __x-hi: Int | nil = nil
    __drag?: Bool = false
    __drag-x0: Int = 0
    __drag-y0: Int = 0
    __drag-x1: Int = 0
    __drag-y1: Int = 0
    __yw: Int = 0
    __cw: Int = 0
    __g-y-lo: Float = 0.0
    __g-y-hi: Float = 1.0
    __eff-y-lo: Float = 0.0
    __eff-y-hi: Float = 1.0

    wants-hover? -> Bool { true }
    focusable? -> Bool { true }

    mount() {
        kitty-id = kitty-next-id()
    }

    unmount() {}

    __bin(ts: Array[Int], vs: Array[Float], vt0: Int, vt1: Int, n: Int) -> (Array[Float], Float, Float) {
        let lo-i = do {
            let i = 0
            while i < #ts && ts[i] < vt0 { i += 1 }
            i
        }

        let end = min(#ts, #vs)
        let hi-i = do {
            let i = lo-i
            while i < end && ts[i] <= vt1 { i += 1 }
            i
        }

        let sample-count = hi-i - lo-i
        if sample-count == 0 {
            return ([0.0 for ..n], 0.0, 0.0)
        }

        let dlo = 1.0e308
        let dhi = -1.0e308
        for i in lo-i..hi-i {
            if vs[i] < dlo { dlo = vs[i] }
            if vs[i] > dhi { dhi = vs[i] }
        }

        let result = if sample-count <= n {
            [vs[i] for i in lo-i..hi-i]
        } else {
            let span = max(float(vt1 - vt0), 1.0)
            let bins   = [0.0 for ..n]
            let counts = [0 for ..n]
            for i in lo-i..hi-i {
                let bi = int((ts[i] - vt0) / span * n).clamp(0, n - 1)
                bins[bi]   += vs[i]
                counts[bi] += 1
            }
            [(counts[i] > 0) ? bins[i] / counts[i] : bins[i] for i in ..n]
        }

        (result, dlo, dhi)
    }

    __commit-zoom() {
        let dx = (__drag-x1 - __drag-x0).abs
        let dy = (__drag-y1 - __drag-y0).abs
        if dx < 2 && dy < 2 { return }

        if dx >= dy {
            let x0 = min(__drag-x0, __drag-x1) - __yw
            let x1 = max(__drag-x0, __drag-x1) - __yw
            let f0 = (float(x0) / float(max(__cw - 1, 1))).clamp(0.0, 1.0)
            let f1 = (float(x1) / float(max(__cw - 1, 1))).clamp(0.0, 1.0)
            let et0 = view-t0 ?? __x-lo ?? (t0 ?? 0)
            let et1 = view-t1 ?? __x-hi ?? (t1 ?? 1)
            let new-t0 = et0 + int(f0 * float(et1 - et0))
            let new-t1 = et0 + int(f1 * float(et1 - et0))
            if on-x-zoom {
                on-x-zoom(new-t0, new-t1)
            } else {
                __x-lo = new-t0
                __x-hi = new-t1
            }
        } else {
            let h = int(height ?? 8)
            let y0 = min(__drag-y0, __drag-y1)
            let y1 = max(__drag-y0, __drag-y1)
            let f0 = (float(y0) / float(max(h - 1, 1))).clamp(0.0, 1.0)
            let f1 = (float(y1) / float(max(h - 1, 1))).clamp(0.0, 1.0)
            __y-hi = __eff-y-hi - f0 * (__eff-y-hi - __eff-y-lo)
            __y-lo = __eff-y-hi - f1 * (__eff-y-hi - __eff-y-lo)
        }
    }

    __reset-zoom() {
        __y-lo = nil
        __y-hi = nil
        if on-x-zoom {
            on-x-zoom(nil, nil)
        } else {
            __x-lo = nil
            __x-hi = nil
        }
    }

    __y-at-mouse(my: Int, h: Int, vlo: Float, vhi: Float) -> Float {
        let frac = float(my - layout-y) / float(max(h - 1, 1))
        vhi - frac.clamp(0.0, 1.0) * (vhi - vlo)
    }

    on-event(ev) {
        match ev {
            (event.MouseDown({button: 2, *}) or event.MouseUp({button: 2, *})) => {
                __drag? = false
                __reset-zoom()
                invalidate!()
            },

            event.MouseDown({button: 0, x, y, *}) => {
                __drag? = true
                __drag-x0 = int(x) - 1 - layout-x
                __drag-y0 = int(y) - 1 - layout-y
                __drag-x1 = __drag-x0
                __drag-y1 = __drag-y0
            },

            event.MouseUp(_) and __drag? => {
                __drag? = false
                __commit-zoom()
                invalidate!()
            },

            event.MouseMove({x, y, *}) and __drag? => {
                __drag-x1 = int(x) - 1 - layout-x
                __drag-y1 = int(y) - 1 - layout-y
                __mouse-col = int(x) - 1 - layout-x
                invalidate!()
            },

            event.MouseMove({x, *}) => {
                let new-col = int(x) - 1 - layout-x
                if new-col != __mouse-col {
                    __mouse-col = new-col
                    invalidate!()
                }
            },

            event.ScrollUp({y: $my, *}) => {
                let h = int(height ?? 8)
                let glo = float(min-val ?? __g-y-lo)
                let ghi = float(max-val ?? __g-y-hi)
                let vlo = __y-lo ?? glo
                let vhi = __y-hi ?? ghi
                let anchor = __y-at-mouse(int(my) - 1, h, vlo, vhi)
                let factor = 0.8
                __y-lo = anchor - (anchor - vlo) * factor
                __y-hi = anchor + (vhi - anchor) * factor
                invalidate!()
            },

            event.ScrollDown({y: $my, *}) => {
                let h = int(height ?? 8)
                let glo = float(min-val ?? __g-y-lo)
                let ghi = float(max-val ?? __g-y-hi)
                let vlo = __y-lo ?? glo
                let vhi = __y-hi ?? ghi
                let anchor = __y-at-mouse(int(my) - 1, h, vlo, vhi)
                let factor = 1.25
                __y-lo = max(anchor - (anchor - vlo) * factor, glo)
                __y-hi = min(anchor + (vhi - anchor) * factor, ghi)
                invalidate!()
            },

            _ => Ignored
        }
    }

    __render-kitty(
        all-series: Array[Array[Float]],
        h: Int, cw: Int,
        lo: Float, hi: Float, range: Float,
        clr: String, clrs: Array[String] | nil,
        fmt: Function, do-fill: Bool
    ) {
        let (cell-w, cell-h) = term.cell-size()
        if cell-w == 0 || cell-h == 0 { cell-w = 8; cell-h = 16 }

        let ya? = y-axis? ?? true
        let yw = ya? ? max(fmt(lo).width(), fmt(hi).width(), 1) + 1 : 0
        let dim = fg-sgr(spec-of-part(part('LinePlot', 'axis', [], variant)))

        if range == 0.0 || range != range { range = 1.0 }
        let pw = min(cw * cell-w, 1120)
        let ph = min(h * cell-h, 560)

        let buf = Blob()
        buf.reserve(pw * ph * 4)
        buf.fill()

        fn plot-px(x: Int, y: Int, r: Int, g: Int, b: Int, a: Int) {
            if x < 0 || x >= pw || y < 0 || y >= ph { return }
            let off = (y * pw + x) * 4
            let old-a = buf[off + 3]
            if old-a == 0 {
                buf[off]     = r
                buf[off + 1] = g
                buf[off + 2] = b
                buf[off + 3] = a
            } else {
                let af = float(a) / 255.0
                let inv = 1.0 - af
                buf[off]     = int(float(r) * af + float(buf[off]) * inv)
                buf[off + 1] = int(float(g) * af + float(buf[off + 1]) * inv)
                buf[off + 2] = int(float(b) * af + float(buf[off + 2]) * inv)
                buf[off + 3] = min(old-a + a, 255)
            }
        }

        fn wu-line(x0: Float, y0: Float, x1: Float, y1: Float, r: Int, g: Int, b: Int) {
            let steep = (y1 - y0).abs > (x1 - x0).abs
            let (x0, y0, x1, y1) = steep ? (y0, x0, y1, x1) : (x0, y0, x1, y1)
            let (x0, y0, x1, y1) = (x0 > x1) ? (x1, y1, x0, y0) : (x0, y0, x1, y1)

            let dx = x1 - x0
            let dy = y1 - y0
            let grad = (dx < 0.001) ? 1.0 : dy / dx

            let xend = int(x0 + 0.5)
            let yend = y0 + grad * (float(xend) - x0)
            let gap  = 1.0 - ((x0 + 0.5) - float(int(x0 + 0.5)))
            let iy   = int(yend)
            let frac = yend - float(iy)

            if steep {
                plot-px(iy,     xend, r, g, b, int((1.0 - frac) * gap * 255.0))
                plot-px(iy + 1, xend, r, g, b, int(frac * gap * 255.0))
            } else {
                plot-px(xend, iy,     r, g, b, int((1.0 - frac) * gap * 255.0))
                plot-px(xend, iy + 1, r, g, b, int(frac * gap * 255.0))
            }

            let intery = yend + grad

            let xend2 = int(x1 + 0.5)
            let yend2 = y1 + grad * (float(xend2) - x1)
            let gap2  = (x1 + 0.5) - float(int(x1 + 0.5))
            let iy2   = int(yend2)
            let frac2 = yend2 - float(iy2)

            if steep {
                plot-px(iy2,     xend2, r, g, b, int((1.0 - frac2) * gap2 * 255.0))
                plot-px(iy2 + 1, xend2, r, g, b, int(frac2 * gap2 * 255.0))
            } else {
                plot-px(xend2, iy2,     r, g, b, int((1.0 - frac2) * gap2 * 255.0))
                plot-px(xend2, iy2 + 1, r, g, b, int(frac2 * gap2 * 255.0))
            }

            for x in xend + 1 .. xend2 {
                let iy = int(intery)
                let frac = intery - float(iy)
                if steep {
                    plot-px(iy,     x, r, g, b, int((1.0 - frac) * 255.0))
                    plot-px(iy + 1, x, r, g, b, int(frac * 255.0))
                } else {
                    plot-px(x, iy,     r, g, b, int((1.0 - frac) * 255.0))
                    plot-px(x, iy + 1, r, g, b, int(frac * 255.0))
                }
                intery += grad
            }
        }

        let rgb-table = []
        for si in ..#all-series {
            let c = (clrs && si < #clrs) ? clrs[si] : clr
            rgb-table.push(resolve-color-rgb(c))
        }

        for si in ..#all-series {
            let s = all-series[si]
            if #s < 2 { continue }
            let (cr, cg, cb) = rgb-table[si]

            for px in ..pw - 1 {
                let t0 = float(px) / float(max(pw - 1, 1)) * float(#s - 1)
                let t1 = float(px + 1) / float(max(pw - 1, 1)) * float(#s - 1)
                let i0 = int(t0).clamp(0, #s - 2)
                let i1 = int(t1).clamp(0, #s - 2)
                let f0 = t0 - float(i0)
                let f1 = t1 - float(i1)
                let v0 = s[i0] * (1.0 - f0) + s[i0 + 1] * f0
                let v1 = s[i1] * (1.0 - f1) + s[i1 + 1] * f1
                let py0 = (1.0 - (v0 - lo) / range) * float(ph - 1)
                let py1 = (1.0 - (v1 - lo) / range) * float(ph - 1)
                wu-line(float(px), py0, float(px + 1), py1, cr, cg, cb)
            }

            if do-fill {
                for px in ..pw {
                    let t = float(px) / float(max(pw - 1, 1)) * float(#s - 1)
                    let i0 = int(t).clamp(0, #s - 2)
                    let frac = t - float(i0)
                    let v = s[i0] * (1.0 - frac) + s[i0 + 1] * frac
                    let yline = int((1.0 - (v - lo) / range) * float(ph - 1) + 0.5)
                        .clamp(0, ph - 1)
                    for py in yline + 1 .. ph {
                        let off = (py * pw + px) * 4
                        if buf[off + 3] == 0 {
                            buf[off]     = cr
                            buf[off + 1] = cg
                            buf[off + 2] = cb
                            buf[off + 3] = 50
                        }
                    }
                }
            }
        }

        let img-escape = kitty-transmit(buf, pw, ph, cw, h, id=kitty-id)

        kitty-entry = {
            id: kitty-id,
            escape: img-escape,
            x-off: yw,
            fresh?: true
        }
    }

    __render-braille(
        all-series: Array[Array[Float]],
        h: Int, cw: Int,
        lo: Float, hi: Float, range: Float,
        clr: String, clrs: Array[String] | nil,
        fmt: Function, do-fill: Bool,
        xl-str: String | nil = nil, xr-str: String | nil = nil
    ) -> Node {
        if range == 0.0 || range != range { range = 1.0 }
        let ya? = y-axis? ?? true
        let yw = ya? ? max(fmt(lo).width(), fmt(hi).width(), 1) + 1 : 0
        let dim = fg-sgr(spec-of-part(part('LinePlot', 'axis', [], variant)))

        let dot-h = h * 4
        let dot-w = cw * 2
        let dot-bits = [6, 7, 2, 5, 1, 4, 0, 3]
        let cells = cw * h

        let bits  = [0 for ..cells]
        let owner = [-1 for ..cells]

        for si in ..#all-series {
            let s = all-series[si]
            if #s < 2 { continue }
            let steps = max(dot-w - 1, 1)

            for dx in ..dot-w {
                let t = float(dx) / float(steps) * float(#s - 1)
                let i0 = int(t).clamp(0, #s - 2)
                let frac = t - float(i0)
                let v = s[i0] * (1.0 - frac) + s[i0 + 1] * frac
                let dy = int((v - lo) / range * float(dot-h - 1) + 0.5).clamp(0, dot-h - 1)
                let cx = dx / 2
                let cd = dx % 2

                if do-fill {
                    for fy in ..dy + 1 {
                        let cy = h - 1 - fy / 4
                        let cr = fy % 4
                        let ci = cy * cw + cx
                        bits[ci]  |= (1 << dot-bits[cr * 2 + cd])
                        owner[ci] = si
                    }
                } else {
                    let cy = h - 1 - dy / 4
                    let cr = dy % 4
                    let ci = cy * cw + cx
                    bits[ci]  |= (1 << dot-bits[cr * 2 + cd])
                    owner[ci] = si
                }
            }
        }

        let color-table = []
        for si in ..#all-series {
            let c = (clrs && si < #clrs) ? clrs[si] : clr
            color-table.push(fg-sgr(c))
        }
        let default-fg = fg-sgr(clr)

        let sel-bg = resolve-bg-sgr(part('LinePlot', 'selection', [], variant)['bg'] ?? 'bg-hover')
        let (sel-c0, sel-c1, sel-r0, sel-r1) = if !__drag? {
            (-1, -1, -1, -1)
        } else {
            let ddx = (__drag-x1 - __drag-x0).abs
            let ddy = (__drag-y1 - __drag-y0).abs
            if ddx <= 1 && ddy <= 1 {
                (-1, -1, -1, -1)
            } else if ddx >= ddy {
                ((min(__drag-x0, __drag-x1) - yw).clamp(0, cw),
                 (max(__drag-x0, __drag-x1) - yw).clamp(0, cw),
                 -1, -1)
            } else {
                (-1, -1,
                 min(__drag-y0, __drag-y1).clamp(0, h),
                 max(__drag-y0, __drag-y1).clamp(0, h))
            }
        }

        let lines = []
        let line-w = 0

        for row in ..h {
            let buf = Blob()

            if ya? {
                let yl = (row == 0) ? fmt(hi) : (row == h - 1) ? fmt(lo) : ''
                buf.push("{dim}{"{yl:>{yw}}"}{RST}")
            }

            let cur-sgr = ''
            let cur-bg = false
            for col in ..cw {
                let ci = row * cw + col
                let sgr = (owner[ci] >= 0 && owner[ci] < #color-table)
                    ? color-table[owner[ci]]
                    : default-fg
                let want-bg = (col >= sel-c0 && col < sel-c1)
                           || (row >= sel-r0 && row < sel-r1)
                if sgr != cur-sgr || want-bg != cur-bg {
                    buf.push(RST)
                    buf.push(sgr)
                    if want-bg {
                        buf.push(sel-bg)
                    }
                    cur-sgr = sgr
                    cur-bg = want-bg
                }
                buf.push(chr(0x2800 + bits[ci]))
            }
            if #cur-sgr > 0 || cur-bg { buf.push(RST) }

            let s = buf.str!()
            if row == 0 { line-w = s.width() }
            lines.push(s)
        }

        let xl-show = xl-str ?? x-lo
        let xr-show = xr-str ?? x-hi
        if (xl-show ?? xr-show) != nil {
            let xl = xl-show ?? ''
            let xh = xr-show ?? ''
            let pad = ' ' * yw
            let avail = max(line-w - yw, 0)
            let mid = ' ' * max(avail - xl.width() - xh.width(), 1)
            lines.push("{dim}{pad}{xl}{mid}{xh}{RST}")
        }

        Raw(lines, line-w)
    }

    render() -> Node {
        let h   = int(height ?? 8)
        let clr = color ?? (part('LinePlot', 'series', [], variant)['fg'] ?? 'primary')
        let clrs = colors
        let fmt  = format ?? (v -> "{v:.2f}")
        let do-fill = fill? ?? false
        let ya? = y-axis? ?? true

        let raw? = raw-times != nil && raw-values != nil && t0 != nil && t1 != nil
        let eff-t0 = view-t0 ?? __x-lo ?? (t0 ?? 0)
        let eff-t1 = view-t1 ?? __x-hi ?? (t1 ?? 1)

        let yw-est = if let $ywo = y-width { ywo }
            else if ya? && min-val != nil && max-val != nil {
                max(fmt(float(min-val)).width(), fmt(float(max-val)).width(), 1) + 1
            } else if ya? { 6 } else { 0 }
        let total-w-est = int(width ?? 40)
        let cw-est = max(total-w-est - yw-est, 4)

        let bin-lo = 0.0
        let bin-hi = 0.0
        let all-series: Array[Array[Float]] = if let ($ts, $vs) = (raw-times, raw-values) {
            let n-bins = max(cw-est, 4)
            let (bins, blo, bhi) = __bin(ts, vs, eff-t0, eff-t1, n-bins)
            bin-lo = blo
            bin-hi = bhi
            [bins]
        } else if let $s = series {
            s
        } else if let $d = data {
            [d]
        } else {
            []
        }

        if #all-series == 0 || all-series.all?(s -> #s == 0) {
            let ep = part('LinePlot', 'empty', [], variant)
            return <Text look=ep>{ep['content'] ?? 'no data'}</Text>
        }

        let all-vals = all-series.flat()
        let g-lo = min-val ?? (raw? ? bin-lo : (all-vals.min() ?? 0.0))
        let g-hi = max-val ?? (raw? ? bin-hi : (all-vals.max() ?? 0.0))
        let lo = __y-lo ?? g-lo
        let hi = __y-hi ?? g-hi
        let hi = max(hi, lo + 1.0e-9)
        let range = hi - lo

        let yw = if let $ywo = y-width { ywo }
            else if ya? { max(fmt(lo).width(), fmt(hi).width(), 1) + 1 }
            else { 0 }
        let max-len = all-series.map(s -> #s).max() ?? 0
        let avail-w = (layout-max-w > 0 && layout-max-w < INF) ? layout-max-w : 80
        let total-w = int(width ?? min(max(max-len / 2 + yw, 10), avail-w))
        let cw = max(total-w - yw, 4)

        __yw = yw
        __cw = cw
        __g-y-lo = g-lo
        __g-y-hi = g-hi
        __eff-y-lo = lo
        __eff-y-hi = hi

        let use-kitty = (kitty? ?? true) && kitty-graphics?

        let img-key = (all-series, h, cw, lo, hi, do-fill, clr, clrs)
        if use-kitty && img-key != __cached-img-key {
            debug!("LinePlot: generating kitty image id={kitty-id} {cw}×{h}")
            __render-kitty(all-series, h, cw, lo, hi, range, clr, clrs, fmt, do-fill)
            __cached-img-key = img-key
        }
        if kitty-entry != nil { kitty-entry.x-off = yw }

        let dim = fg-sgr(spec-of-part(part('LinePlot', 'axis', [], variant)))
        let line-w = total-w

        let xl-label = if raw? && time-format != nil { time-format(eff-t0) } else { x-lo }
        let xr-label = if raw? && time-format != nil { time-format(eff-t1) } else { x-hi }

        let coord-text = if __drag? {
            let ddx = (__drag-x1 - __drag-x0).abs
            let ddy = (__drag-y1 - __drag-y0).abs
            if ddx >= ddy && ddx > 1 {
                let cx0 = min(__drag-x0, __drag-x1) - yw
                let cx1 = max(__drag-x0, __drag-x1) - yw
                let f0 = (float(cx0) / float(max(cw - 1, 1))).clamp(0.0, 1.0)
                let f1 = (float(cx1) / float(max(cw - 1, 1))).clamp(0.0, 1.0)
                if raw? && time-format {
                    let tv0 = eff-t0 + int(f0 * float(eff-t1 - eff-t0))
                    let tv1 = eff-t0 + int(f1 * float(eff-t1 - eff-t0))
                    "⌗ {time-format(tv0)}–{time-format(tv1)}"
                } else if x-format {
                    "⌗ {x-format(f0)}–{x-format(f1)}"
                } else {
                    "⌗ {f0:.2f}–{f1:.2f}"
                }
            } else if ddy > 1 {
                let ry0 = min(__drag-y0, __drag-y1)
                let ry1 = max(__drag-y0, __drag-y1)
                let vf0 = (float(ry0) / float(max(h - 1, 1))).clamp(0.0, 1.0)
                let vf1 = (float(ry1) / float(max(h - 1, 1))).clamp(0.0, 1.0)
                let v1 = hi - vf0 * (hi - lo)
                let v0 = hi - vf1 * (hi - lo)
                "⌗ {fmt(v0)}–{fmt(v1)}"
            }
        } else if (use-kitty || raw?) && __mouse-col != nil {
            let mx = __mouse-col - yw
            if mx >= 0 && mx < cw && #all-series > 0 && #all-series[0] > 0 {
                let frac = float(mx) / float(max(cw - 1, 1))
                let di = int(frac * float(#all-series[0] - 1) + 0.5)
                    .clamp(0, #all-series[0] - 1)
                let xv = if raw? && time-format {
                    let tv = eff-t0 + int(frac * float(eff-t1 - eff-t0))
                    time-format(tv)
                } else if x-format { x-format(frac) }
                  else { "{frac:.2f}" }
                let yv = fmt(all-series[0][di])
                "({xv}, {yv})"
            }
        }

        if use-kitty {
            let sel-bg = resolve-bg-sgr(part('LinePlot', 'selection', [], variant)['bg'] ?? 'bg-hover')
            let (sel-c0, sel-c1, sel-r0, sel-r1) = if !__drag? {
                (-1, -1, -1, -1)
            } else {
                let ddx = (__drag-x1 - __drag-x0).abs
                let ddy = (__drag-y1 - __drag-y0).abs
                if ddx <= 1 && ddy <= 1 {
                    (-1, -1, -1, -1)
                } else if ddx >= ddy {
                    ((min(__drag-x0, __drag-x1) - yw).clamp(0, cw),
                     (max(__drag-x0, __drag-x1) - yw).clamp(0, cw),
                     -1, -1)
                } else {
                    (-1, -1,
                     min(__drag-y0, __drag-y1).clamp(0, h),
                     max(__drag-y0, __drag-y1).clamp(0, h))
                }
            }

            fn sel-row(row: Int) -> String {
                let row-hit = row >= sel-r0 && row < sel-r1
                let col-hit = sel-c1 > sel-c0
                if row-hit {
                    "{' ' * yw}{sel-bg}{' ' * cw}{RST}"
                } else if col-hit {
                    let pre = ' ' * sel-c0
                    let mid = "{sel-bg}{' ' * (sel-c1 - sel-c0)}{RST}"
                    let post = ' ' * (cw - sel-c1)
                    "{' ' * yw}{pre}{mid}{post}"
                } else {
                    ' ' * yw
                }
            }

            let lines = []
            if ya? {
                let y-hi-s = "{dim}{"{fmt(hi):>{yw}}"}{RST}"
                let y-lo-s = "{dim}{"{fmt(lo):>{yw}}"}{RST}"
                if let $ct = coord-text and ct.width() < cw {
                    let rpad = 1
                    let pad = max(cw - ct.width() - rpad, 0)
                    lines.push("{y-hi-s}{' ' * pad}{dim}{ct}{RST}{' ' * rpad}")
                } else {
                    lines.push(y-hi-s)
                }
                for row in 1..(h - 1) { lines.push(sel-row(row)) }
                lines.push(y-lo-s)
            } else {
                if let $ct = coord-text and ct.width() < cw {
                    let rpad = 1
                    let pad = max(cw - ct.width() - rpad, 0)
                    lines.push("{' ' * pad}{dim}{ct}{RST}{' ' * rpad}")
                } else {
                    lines.push('')
                }
                for row in 1..h { lines.push(sel-row(row)) }
            }

            if (xl-label ?? xr-label) != nil {
                let xl = xl-label ?? ''
                let xh = xr-label ?? ''
                let pad = ' ' * yw
                let avail = max(line-w - yw, 0)
                let mid = ' ' * max(avail - xl.width() - xh.width(), 1)
                lines.push("{dim}{pad}{xl}{mid}{xh}{RST}")
            }

            Raw(lines, line-w)
        } else {
            __render-braille(all-series, h, cw, lo, hi, range, clr, clrs, fmt, do-fill,
                xl-str=xl-label, xr-str=xr-label)
        }
    }
}

pub class ScrollView < Component {
    variant: String | nil
    cls: String | nil
    height: Int | nil
    scroll-color: String | nil

    __scroll: Int = 0
    scroll-total: Int = 0

    focusable? -> Bool { true }

    on-event(ev) {
        let h = int(height ?? 10)
        match ev {
            event.ScrollUp(_)
            or event.Key({key: 'UP', event: (1 or 2), *})
            or event.Text('k') =>
                __scroll = max(__scroll - 1, 0),

            event.ScrollDown(_)
            or event.Key({key: 'DOWN', event: (1 or 2), *})
            or event.Text('j') =>
                __scroll += 1,

            event.Key({key: 'PAGE_UP', event: (1 or 2), *}) =>
                __scroll = max(__scroll - h, 0),

            event.Key({key: 'PAGE_DOWN', event: (1 or 2), *}) =>
                __scroll += h,

            event.Key({key: 'HOME', event: (1 or 2), *}) =>
                __scroll = 0,

            event.Key({key: 'END', event: (1 or 2), *}) =>
                __scroll = 999999,

            _ => Ignored
        }
    }

    render() -> Node {
        let h = int(height ?? 10)
        if scroll-total > 0 {
            __scroll = __scroll.clamp(0, max(scroll-total - h, 0))
        }

        <Box direction="column" height=h scroll=__scroll look=part('ScrollView', 'frame', focused? ? ['focused'] : [], variant) cls=cls>
            {children}
        </Box>
    }
}

pub class DatePicker < Component {
    variant: String | nil
    value:        date.PlainDate | nil
    on-change:    Function | nil
    on-select:    Function | nil
    first-day:    Int | nil
    header-color: String | nil
    cursor-color: String | nil
    today-color:  String | nil
    dim-color:    String | nil
    color:        String | nil

    __year:       Int = 0
    __month:      Int = 0
    __day:        Int = 0
    __today:      date.PlainDate | nil = nil
    __grid-offset: Int = 0
    __grid-dim:    Int = 0

    focusable? -> Bool { true }

    __ensure-init() {
        if __today { return }
        let td = date.today()
        __today = td
        let v = value ?? td
        __year  = v.year
        __month = v.month
        __day   = v.day
    }

    __cursor-date() {
        date.PlainDate(__year, __month, __day.clamp(1, __dim()))
    }

    __dim() -> Int {
        date.PlainDate(__year, __month, 1).daysInMonth
    }

    __nav(d) {
        let next = __cursor-date().add(d)
        __year  = next.year
        __month = next.month
        __day   = next.day
        __fire-change()
    }

    __set-month(y: Int, m: Int) {
        while m < 1  { m += 12; y -= 1 }
        while m > 12 { m -= 12; y += 1 }
        __year  = y
        __month = m
        __day   = __day.clamp(1, date.PlainDate(y, m, 1).daysInMonth)
        __fire-change()
    }

    __fire-change() {
        if on-change { on-change(__cursor-date()) }
    }

    __click(mx: Int, my: Int) {
        let row = my - layout-y - 2
        let col = (mx - layout-x) / 3
        if row < 0 || col < 0 || col > 6 { return }
        let d = row * 7 + col - __grid-offset + 1
        if d < 1 || d > __grid-dim { return }
        __day = d
        __fire-change()
        if on-select { on-select(__cursor-date()) }
    }

    on-event(ev) {
        __ensure-init()
        match ev {
            event.Key({key: 'LEFT', event: (1 or 2), *}) or event.Text('h') =>
                __nav(-1 * date.DAY),

            event.Key({key: 'RIGHT', event: (1 or 2), *}) or event.Text('l') =>
                __nav(1 * date.DAY),

            event.Key({key: 'UP', event: (1 or 2), *}) or event.Text('k') =>
                __nav(-7 * date.DAY),

            event.Key({key: 'DOWN', event: (1 or 2), *}) or event.Text('j') =>
                __nav(7 * date.DAY),

            event.Key({key: 'PAGE_UP', event: (1 or 2), *}) =>
                __set-month(__year, __month - 1),

            event.Key({key: 'PAGE_DOWN', event: (1 or 2), *}) =>
                __set-month(__year, __month + 1),

            event.Text('[') => __set-month(__year, __month - 1),
            event.Text(']') => __set-month(__year, __month + 1),
            event.Text('{') => __set-month(__year - 1, __month),
            event.Text('}') => __set-month(__year + 1, __month),

            event.Text('t') => if let $td = __today {
                __year  = td.year
                __month = td.month
                __day   = td.day
                __fire-change()
            },

            event.Key({key: 'HOME', event: 1, *}) =>
                { __day = 1; __fire-change() },

            event.Key({key: 'END', event: 1, *}) =>
                { __day = __dim(); __fire-change() },

            event.Key({key: 'ENTER', event: 1, *}) => {
                if on-select { on-select(__cursor-date()) }
            },

            event.MouseDown({x, y, *}) =>
                __click(int(x) - 1, int(y) - 1),

            _ => Ignored
        }
    }

    render() -> Node {
        __ensure-init()
        if let $v = value {
            __year  = v.year
            __month = v.month
            __day   = v.day
        }

        let fd    = int(first-day ?? 0)
        let fs    = focused? ? ['focused'] : []
        let hspec = header-color ? "{header-color} bold" : spec-of-part(part('DatePicker', 'header', fs, variant))
        let cspec = cursor-color ? "{cursor-color} reverse bold" : spec-of-part(part('DatePicker', 'day', [*fs, 'selected'], variant))
        let tspec = today-color ? "{today-color} bold" : spec-of-part(part('DatePicker', 'day', [*fs, 'today'], variant))
        let dclr  = dim-color ?? spec-of-part(part('DatePicker', 'weekday', fs, variant))
        let nclr  = color ?? spec-of-part(part('DatePicker', 'day', fs, variant))

        let first = date.PlainDate(__year, __month, 1)
        let dim   = first.daysInMonth
        let dow1  = first.dayOfWeek % 7

        let offset = (dow1 - fd + 7) % 7
        __grid-offset = offset
        __grid-dim = dim

        let month-names = [
            '', 'January', 'February', 'March', 'April',
            'May', 'June', 'July', 'August',
            'September', 'October', 'November', 'December'
        ]

        let day-names = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']
        let day-hdrs = [day-names[(fd + i) % 7] for i in ..7].join(' ')

        let title = "{month-names[__month]} {__year}"
        let w = 20
        let pad = max(w - title.width(), 0)
        let lpad = pad / 2
        let rpad = pad - lpad

        let rows: Array[Any] = [
            <Text style=hspec>{' ' * lpad}{title}{' ' * rpad}</Text>,
            <Text style=dclr>{day-hdrs}</Text>
        ]

        let $td = __today or return <Text style="text-dim">...</Text>
        let is-today-month = __year == td.year && __month == td.month
        let sel-day = __day.clamp(1, dim)

        let cell = 0
        let week-buf = Blob()
        for d in 1..dim + 1 {
            if d == 1 {
                for ..offset {
                    week-buf.push('   ')
                    cell += 1
                }
            }

            let cur?  = d == sel-day && focused?
            let tod?  = is-today-month && d == td.day
            let label = "{d:>2}"
            let styled = if cur? {
                str(chalk"[{cspec}] {label}[/]")
            } else if tod? {
                str(chalk"[{tspec}]{label}[/]")
            } else {
                str(chalk"[{nclr}]{label}[/]")
            }

            week-buf.push(cur? ? styled : " {styled}")
            cell += 1

            if cell % 7 == 0 || d == dim {
                rows.push(<Text>{week-buf.str!()}</Text>)
                week-buf.clear()
            }
        }

        <Box direction="column">
            {rows}
        </Box>
    }
}

pub class TreeView < Component {
    variant: String | nil
    cls:           String | nil
    root:          Any
    children:      Any
    label:         Function
    key:           Function | nil
    expandable:    Function | nil
    icon:          Function | nil
    on-select:     Function | nil
    on-cursor:     Function | nil
    // Called before built-in key handling. Returning a non-nil value consumes
    // the event; returning Exit also propagates through Ink's dispatcher.
    on-key:        Function | nil
    height:        Int | nil
    width:         Int | nil
    show-guides?:  Bool | nil
    // Forests can use a synthetic root and hide it from the rendered rows.
    show-root?:    Bool | nil
    guide-color:   String | nil
    color:         String | Function | nil
    cursor-color:  String | Function | nil
    // Optional background applied across the full focused row.
    cursor-bg:     String | Function | nil
    // When non-nil, revision opts into flattened-row caching. Change it whenever
    // children() can return a structurally different tree (including async data
    // publication or filtering). A nil revision preserves the legacy behavior
    // of consulting mutable callbacks on every render.
    revision:      Any = nil

    __current-root: Any = nil
    __prev-root:    Any = nil
    __expanded:     Set[String] = %[]
    __cursor:       Int = 0
    __scroll:       Int = 0
    __root-stack:   Array[Any] = []
    __visible:      Array[Any] = []
    __flat-dirty:   Bool = true
    __prev-revision: Any = nil

    focusable? -> Bool { true }

    __invalidate-flat!() { __flat-dirty = true }

    __key(node) -> String {
        key ? key(node) : "{node}"
    }

    __can-expand?(node) -> Bool {
        expandable ? expandable(node) : #children(node) > 0
    }

    __is-expanded?(node) -> Bool {
        __key(node) in __expanded
    }

    __toggle!(node) {
        __expanded ^= %[__key(node)]
        __invalidate-flat!()
    }

    __expand!(node) {
        if __expanded.insert(__key(node)) {
            __invalidate-flat!()
        }
    }

    __collapse!(node) {
        if __expanded.remove(__key(node)) {
            __invalidate-flat!()
        }
    }

    __flatten() -> Array[Any] {
        let rows: Array[Any] = []

        fn walk(node, depth: Int, lasts: Array[Bool]) {
            let can? = __can-expand?(node)
            let exp? = can? && __is-expanded?(node)
            rows.push({node: node, depth: depth, lasts: lasts, exp?: exp?, can?: can?})
            if exp? {
                let kids = children(node)
                for kid; i in kids {
                    walk(kid, depth + 1, [*lasts, i == #kids - 1])
                }
            }
        }

        if show-root? ?? true {
            walk(__current-root, 0, [])
        } else {
            let kids = children(__current-root)
            for kid; i in kids {
                walk(kid, 0, [i == #kids - 1])
            }
        }
        rows
    }

    __cursor-node {
        (__cursor >= 0 && __cursor < #__visible)
            ? __visible[__cursor].node
            : nil
    }

    __parent-idx(idx: Int) -> Int | nil {
        if idx <= 0 || idx >= #__visible { return nil }
        let target = __visible[idx].depth - 1
        if target < 0 { return nil }
        let i = idx - 1
        while i >= 0 {
            if __visible[i].depth == target { return i }
            i -= 1
        }
        nil
    }

    __fire-cursor() {
        if on-cursor && __cursor >= 0 && __cursor < #__visible {
            on-cursor(__visible[__cursor].node)
        }
    }

    on-event(ev) {
        let h = int(height ?? 20)
        let n = #__visible

        // Applications can layer shortcuts and modes (selection, search, quit)
        // over the navigation behavior without reimplementing tree flattening.
        if on-key {
            let handled = on-key(ev, __cursor-node)
            if handled != nil { return handled }
        }

        fn move-to(idx: Int) {
            let new-idx = idx.clamp(0, max(n - 1, 0))
            if new-idx != __cursor {
                __cursor = new-idx
                __fire-cursor()
            }
        }

        match ev {
            event.Key({key: 'UP', event: (1 or 2), *}) or event.Text('k') =>
                move-to(__cursor - 1),

            event.Key({key: 'DOWN', event: (1 or 2), *}) or event.Text('j') =>
                move-to(__cursor + 1),

            (event.Key({key: 'RIGHT', event: (1 or 2), *}) or event.Text('l')) => {
                if let $node = __cursor-node and __can-expand?(node) {
                    if !__is-expanded?(node) {
                        __expand!(node)
                    } else {
                        move-to(__cursor + 1)
                    }
                }
            },

            (event.Key({key: 'LEFT', event: (1 or 2), *}) or event.Text('h')) => {
                if let $node = __cursor-node {
                    if __can-expand?(node) && __is-expanded?(node) {
                        __collapse!(node)
                    } else if let $pi = __parent-idx(__cursor) {
                        move-to(pi)
                    }
                }
            },

            event.Key({key: 'ENTER', event: 1, *}) => {
                if let $node = __cursor-node {
                    if __can-expand?(node) { __toggle!(node) }
                    if on-select { on-select(node) }
                }
            },

            event.Text(' ') => {
                if let $node = __cursor-node and __can-expand?(node) {
                    __toggle!(node)
                }
            },

            event.Text('z') => {
                if let $node = __cursor-node and __can-expand?(node) {
                    __root-stack.push(__current-root)
                    __current-root = node
                    __expand!(node)
                    __invalidate-flat!()
                    __cursor = 0
                    __scroll = 0
                }
            },

            event.Key({key: 'BACKSPACE', event: (1 or 2), *}) => {
                if #__root-stack > 0 {
                    __current-root = __root-stack.pop()
                    __invalidate-flat!()
                    __cursor = 0
                    __scroll = 0
                }
            },

            event.Key({key: 'HOME', event: 1, *}) => move-to(0),
            event.Key({key: 'END', event: 1, *})  => move-to(n - 1),

            event.Key({key: 'PAGE_UP', event: (1 or 2), *}) =>
                move-to(__cursor - h),

            event.Key({key: 'PAGE_DOWN', event: (1 or 2), *}) =>
                move-to(__cursor + h),

            _ => Ignored
        }
    }

    render() -> Node {
        if __current-root == nil || root != __prev-root {
            __current-root = root
            __root-stack = []
            __cursor = 0
            __scroll = 0
            __prev-root = root
            __invalidate-flat!()
        }

        // A revision is an explicit promise that children() is structurally
        // stable until the token changes. Without one, retain TreeView's old
        // behavior for callers backed by mutable callbacks.
        if revision == nil {
            __flat-dirty = true
        } else if revision != __prev-revision {
            __prev-revision = revision
            __flat-dirty = true
        }
        if __flat-dirty {
            __visible = __flatten()
            __flat-dirty = false
        }
        let h = int(height ?? 20)
        let guides? = show-guides? ?? true
        let fs = focused? ? ['focused'] : []
        let clr = color ? resolve(color) : nil
        let cur-clr = cursor-color ? resolve(cursor-color) : nil
        let cur-bg = cursor-bg ? resolve(cursor-bg, 'selection') : nil
        let g-clr = guide-color ?? spec-of-part(part('TreeView', 'guide', fs, variant))
        let row-w = int(width ?? layout-max-w)

        if __cursor >= #__visible { __cursor = max(#__visible - 1, 0) }
        if __cursor < __scroll { __scroll = __cursor }
        if __cursor >= __scroll + h { __scroll = __cursor - h + 1 }
        __scroll = __scroll.clamp(0, max(#__visible - h, 0))

        let rows: Array[Any] = []
        let vis-end = min(__scroll + h, #__visible)

        for vi in __scroll..vis-end {
            let row = __visible[vi]
            let sel? = vi == __cursor
            let d = row.depth
            let lasts = row.lasts

            let depth = int(d)
            let guide-str = ''
            if guides? && depth > 0 {
                let buf = Blob()
                for i in ..depth {
                    buf.push((i == depth - 1)
                        ? (lasts[i] ? '└─ ' : '├─ ')
                        : (lasts[i] ? '   ' : '│  '))
                }
                guide-str = buf.str!()
            } else if depth > 0 {
                guide-str = '  ' * depth
            }

            let sts = sel? ? [*fs, 'selected'] : fs
            let tog = part('TreeView', 'toggle', row.exp? ? [*sts, 'expanded'] : sts, variant)
            let exp-str = row.can?
                ? (tog['content'] ?? (row.exp? ? '▾ ' : '▸ '))
                : (icon ? "{icon(row.node)} " : '  ')

            let lbl = label(row.node)
            let lbl-clr = match (sel?, cur-clr, clr) {
                (true, $c, _)  => "{c} bold",
                (false, _, $c) => c,
                _              => spec-of-part(part('TreeView', 'label', sts, variant))
            }
            let mark-p = part('TreeView', 'mark', (sel? && focused?) ? [*sts, 'active'] : sts, variant)
            let mark = mark-p['content'] ?? '  '
            let mark-clr = (sel? && cur-clr != nil) ? "{cur-clr} bold" : spec-of-part(mark-p)
            let row-bg = sel? ? (cur-bg ?? part('TreeView', 'row', sts, variant)['bg']) : nil

            let content=<Text>
                <Text style=mark-clr>{mark}</Text>
                <Text style=g-clr>{guide-str}</Text>
                <Text style=lbl-clr>{exp-str}{lbl}</Text>
            </Text>
            if row-bg != nil {
                rows.push(<Box direction="row" width=row-w bg=row-bg>{content}</Box>)
            } else {
                rows.push(content)
            }
        }

        if #__visible == 0 {
            let ep = part('TreeView', 'empty', fs, variant)
            rows.push(<Text look=ep>{ep['content'] ?? '  (empty)'}</Text>)
        }

        <Box direction="column" height=h width=width look=part('TreeView', 'frame', fs, variant) cls=cls>
            {rows}
        </Box>
    }
}

pub class Toast < Component {
    variant: String | nil
    duration: Float | nil
    color:    String | nil
    icon:     String | nil

    __visible: Bool = true

    mount() {
        after(float(duration ?? 3.0), -> do { __visible = false })
    }

    render() -> Node | nil {
        let fr = part('Toast', 'frame', [], variant)
        let ic = part('Toast', 'icon', [], variant)
        let icn = icon ?? ic['content'] ?? '✓'

        __visible ? <Text look=(color ? nil : fr) style=(color ? "{color} bold" : nil)> {icn} {children}</Text> : nil
    }
}

class Output {
    __lines: Array[String]
    __width: Int

    init(lines: Array[String], width: Int) {
        __lines = lines
        __width = width
    }

    lines  { __lines }
    width  { __width }
    height { #__lines }
}

pub class Element {
    x: Int
    y: Int
    w: Int
    h: Int
    props: Dict[String, _]
    children: Array[Element]
    focusable?: Bool
    component: Component | nil

    init(
        x: Int, y: Int, w: Int, h: Int,
        props: Dict[String, _],
        children: Array[Element] = [],
        component: Component | nil = nil
    ) {
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.props = props
        self.children = children
        focusable? = props['focusable'] ?? false
        self.component = component
    }

    contains?(px: Int, py: Int) -> Bool {
        px >= x && px < x + w && py >= y && py < y + h
    }

    hit(px: Int, py: Int) -> Array[Element] | nil {
        if !contains?(px, py) { return nil }
        for child in children[;;-1] {
            if let $path = child.hit(px, py) {
                path.push(self)
                return path
            }
        }
        [self]
    }

    focusables() -> Array[Element] {
        let out = []
        if focusable? { out.push(self) }
        for child in children {
            out += child.focusables()
        }
        out
    }
}

pub class InkEvent {
    __raw: Any
    __target: Element | nil
    __stopped: Bool

    init(raw: Any, target: Element | nil = nil) {
        __raw = raw
        __target = target
        __stopped = false
    }

    raw { __raw }
    target { __target }
    stopped? { __stopped }
    stop() { __stopped = true }
}

fn build-markup(children) -> String {
    let buf = Blob()
    for child in children {
        match child {
            (s: String) => buf.push(chalk-escape(s)),
            (n: Node) and n.tag == NodeText => {
                let inner = build-markup(n.children)
                if let $s = n.style {
                    buf.push("[{s}]{inner}[/]")
                } else {
                    buf.push(inner)
                }
            },
            nil or false => (),
            (n: Node) or (n: Component) => throw ValueError(
                "Text children must be strings or <Text> nodes, got {type(n)}"
            ),
            x => buf.push(chalk-escape("{x}"))
        }
    }
    buf.str!()
}

fn styled-lines(rendered: String) -> Array[String] {
    if !rendered.contains?('\n') || !rendered.contains?("\x1b") {
        return rendered.lines() ?? [rendered]
    }

    rendered.ansi-lines()
}

fn layout-text(
    node: Node,
    max-w: Int,
    max-h: Int,
    ox: Int,
    oy: Int
) -> (Output, Element) {
    let markup = build-markup(node.children)

    if #markup == 0 {
        return (Output([], 0), Element(ox, oy, 0, 0, node.props))
    }

    let spec = match (_inh-spec, node.style) {
        (nil, s)     => s,
        (i, nil)     => i,
        (i, s)       => "{i} {s}"
    }

    let rendered = if let $s = spec {
        chalk.render("[{s}]{markup}[/]")
    } else {
        chalk.render(markup)
    }
    let lines = fit-text(styled-lines(rendered), max-w, node.props['wrap'])
    let width = lines.map(&width).max() ?? 0
    let padded = lines.map(\_.fit(width))
    let output = Output(padded, width)
    (output, Element(ox, oy, width, output.height, node.props))
}

fn fit-text(lines: Array[String], max-w: Int, mode: Any) -> Array[String] {
    if max-w >= INF || mode == 'none' || !lines.any?(\_.width() > max-w) {
        return lines
    }
    match mode {
        'truncate' => lines.map(line -> (line.width() > max-w) ? clip-line(line, max-w) : line),
        _          => lines.flat-map(line -> (line.width() > max-w) ? (line.wrap(max(max-w, 1)).lines() ?? [line]) : [line])
    }
}

fn pad-line(line: String, lw: Int, target-w: Int) -> String {
    (lw >= target-w) ? line : line.fit(target-w)
}

fn clip-line(line: String, target-w: Int) -> String {
    line.fit(target-w)
}

fn align-line(line: String, lw: Int, w: Int, align: String) -> String {
    if lw >= w {
        return line
    }
    match align {
        'center'       => line.fit(w, 0),
        'end', 'right' => line.fit(w, 1),
        _              => line.fit(w)
    }
}

fn shift-element(el: Element, dx: Int, dy: Int) {
    el.x += dx
    el.y += dy
    if let $c = el.component {
        c.layout-x += dx
        c.layout-y += dy
    }
    for child in el.children {
        shift-element(child, dx, dy)
    }
}

fn compute-gaps(
    n: Int, content-size: Int, avail: Int,
    gap: Int, justify: String
) -> Array[Int] {
    if n <= 0 {
        return []
    }

    let extra = avail - content-size
    if extra <= 0 || justify == 'start' {
        return [0] + [gap for ..n - 1]
    }

    let free = extra + gap * (n - 1)

    fn spread(k: Int) -> Array[Int] {
        let g = free / k
        let rem = free - g * k
        [g + ((i < rem) ? 1 : 0) for i in ..k]
    }

    match justify {
        'center' => [extra / 2] + [gap for ..n - 1],
        'end'    => [extra] + [gap for ..n - 1],
        'space-between' => (n == 1) ? [0] : ([0] + spread(n - 1)),
        'space-around' => do {
            let unit = free / n
            [unit / 2] + [unit for ..n - 1]
        },
        'space-evenly' => spread(n + 1)[;n],
        _ => [0] + [gap for ..n - 1]
    }
}

fn stack-column(
    blocks: Array[Output], gap: Int,
    min-w: Int = 0, align: String = 'start',
    justify: String = 'start', avail-h: Int = 0
) -> (Array[String], Int) {
    let w: Int = max(blocks.map(&.width).max() ?? 0, min-w)
    let lines = []

    let use-justify = justify != 'start' && avail-h > 0 && avail-h < INF
    let content-h = blocks.map(&.height).sum(0) + gap * max(#blocks - 1, 0)
    let gaps = use-justify
        ? compute-gaps(#blocks, content-h, avail-h, gap, justify)
        : nil
    let blank = ' ' * w

    let do-align = align != 'start'

    for block; i in blocks {
        let g = gaps
            ? ((i < #gaps) ? gaps[i] : 0)
            : ((i > 0) ? gap : 0)
        for ..g { lines.push(blank) }
        if do-align {
            for line in block.lines {
                lines.push(align-line(line, line.width(), w, align))
            }
        } else if block.width >= w {
            for line in block.lines { lines.push(line) }
        } else {
            for line in block.lines {
                lines.push(pad-line(line, line.width(), w))
            }
        }
    }

    (lines, w)
}

fn stack-row(
    blocks: Array[Output], gap: Int,
    align: String = 'start',
    justify: String = 'start', avail-w: Int = 0,
    min-h: Int = 0
) -> (Array[String], Int) {
    let h = max(blocks.map(&.height).max() ?? 0, min-h)
    let content-w = blocks.map(&.width).sum(0) + gap * max(#blocks - 1, 0)

    let use-justify = justify != 'start' && avail-w > 0 && avail-w < INF
    let w = use-justify ? max(content-w, avail-w) : content-w

    let gaps = use-justify
        ? compute-gaps(#blocks, content-w, avail-w, gap, justify)
        : nil
    let lines = []

    let offsets = blocks.map(block -> match align {
        'center'          => (h - block.height) / 2,
        'end' or 'bottom' => h - block.height,
        _                 => 0
    })
    let blanks = blocks.map(block -> ' ' * block.width)

    for row in ..h {
        _buf.clear()
        for block; i in blocks {
            let g = gaps
                ? ((i < #gaps) ? gaps[i] : 0)
                : ((i > 0) ? gap : 0)
            if g > 0 { _buf.push(' ' * g) }
            let r = row - offsets[i]
            if r >= 0 && r < block.height {
                let ln = block.lines[r]
                _buf.push(
                    (ln.width() > block.width)
                        ? clip-line(ln, block.width)
                        : ln
                )
            } else {
                _buf.push(blanks[i])
            }
        }
        let row-line = _buf.str!()
        lines.push(use-justify ? pad-line(row-line, row-line.width(), w) : row-line)
    }

    (lines, w)
}

fn apply-bg(lines: Array[String], bg: String) -> Array[String] {
    let on = resolve-bg-sgr(bg)
    let off = "\x1b[49m"
    lines.map(line ->
        "{on}{line.sub(/\x1b\[(?:(?:[0-9:]*;)*(?:0|49)(?:;[0-9:]*)*)?m/, sgr -> "{sgr}{on}")}{off}"
    )
}

fn apply-forced-fg(lines: Array[String], fg: String) -> Array[String] {
    let on = fg-sgr(fg)
    if #on == 0 { return lines }
    let off = "\x1b[39m"
    // Selection is an interaction state, so its foreground must win over
    // semantic colors emitted anywhere below it. Re-assert it after every SGR
    // sequence while leaving attributes such as bold and reverse intact.
    lines.map(line -> do {
        let styled = line.sub(/\x1b\[[0-9:;]*m/, sgr -> "{sgr}{on}")
        "{on}{styled}{off}"
    })
}

fn apply-padding(lines: Array[String], w: Int, px: Int, py: Int) -> (Array[String], Int) {
    if px == 0 && py == 0 { return (lines, w) }

    if px == 0 {
        let blank = ' ' * w
        let out = [blank for ..py]
        for line in lines { out.push(line) }
        for ..py { out.push(blank) }
        return (out, w)
    }

    let total-w = w + 2 * px
    let out = []
    let blank = ' ' * total-w
    let lpad = ' ' * px

    for ..py { out.push(blank) }

    for line in lines {
        _buf.clear()
        _buf.push(lpad)
        _buf.push(line)
        let fill = total-w - px - line.width()
        if fill > 0 { _buf.push(' ' * fill) }
        out.push(_buf.str!())
    }

    for ..py { out.push(blank) }

    (out, total-w)
}

fn apply-border(
    lines: Array[String],
    w: Int,
    chars: Array[String],
    color: String | nil
) -> (Array[String], Int) {
    let [tl, tr, bl, br, hz, vt] = chars
    let total-w = w + 2
    let out = []

    let hbar = hz * w
    let (vl, vr) = color
        ? (str(chalk"[{color}]{vt}[/]"), str(chalk"[{color}]{vt}[/]"))
        : (vt, vt)

    fn styled-line(s) {
        color ? str(chalk"[{color}]{s}[/]") : s
    }

    out.push(styled-line("{tl}{hbar}{tr}"))
    for line in lines {
        _buf.clear()
        _buf.push(vl)
        _buf.push(line)
        let fill = w - line.width()
        if fill > 0 { _buf.push(' ' * fill) }
        _buf.push(vr)
        out.push(_buf.str!())
    }
    out.push(styled-line("{bl}{hbar}{br}"))

    (out, total-w)
}

let __tls::_fiber-log: Array[(String, Component)] = []
let __tls::_layout-owner: Any = nil

class LayoutMemo {
    path:       String
    max-w:      Int
    max-h:      Int
    fw:         Any
    fh:         Any
    inh:        String | nil
    output:     Output
    el:         Element
    fibers:     Array[(String, Component)]
    focusables: Array[Any]
    overlays:   Array[Any]
    kitties:    Array[Int]
    images:     Array[Any]

    init(
        path: String, max-w: Int, max-h: Int, fw: Any, fh: Any,
        output: Output, el: Element,
        fibers: Array[(String, Component)], focusables: Array[Any],
        overlays: Array[Any], kitties: Array[Int], images: Array[Any]
    ) {
        self.path       = path
        self.max-w      = max-w
        self.max-h      = max-h
        self.fw         = fw
        self.fh         = fh
        self.inh        = _inh-spec
        self.output     = output
        self.el         = el
        self.fibers     = fibers
        self.focusables = focusables
        self.overlays   = overlays
        self.kitties    = kitties
        self.images     = images
    }

    valid?(p: String, w: Int, h: Int, fw2: Any, fh2: Any) -> Bool {
        path == p && max-w == w && max-h == h && fw == fw2 && fh == fh2 && inh == _inh-spec
    }

    replay(ox: Int, oy: Int) -> (Output, Element) {
        let dx = ox - el.x
        let dy = oy - el.y
        if dx != 0 || dy != 0 {
            shift-element(el, dx, dy)
        }
        for (p, f) in fibers {
            _next-fibers[p] = f
            _fiber-log.push((p, f))
        }
        for focusables {
            _focusables.push(it)
        }
        for overlays {
            _overlays.push(it)
        }
        for kitties {
            _kitties.push(it)
        }
        for k: _ in images {
            _kitty-images.push({id: k.id, escape: k.escape, ox: el.x + k.rx, oy: el.y + k.ry, fresh?: false})
        }
        (output, el)
    }
}

fn reconcile(comp: Component, path: String) -> Component {
    let old = _fibers[path]
    if old != nil && type(old) == type(comp) {
        old.adopt(comp)
        _next-fibers[path] = old
        _fiber-log.push((path, old))
        old
    } else {
        if old != nil && old.mounted? {
            debug!("reconcile [{path}]: type changed {type(old)} -> {type(comp)}")
            old.unmount!()
        } else if old == nil {
            debug!("reconcile [{path}]: new {type(comp)}")
        }
        if !comp.mounted? {
            comp.mount!()
        }
        _next-fibers[path] = comp
        _fiber-log.push((path, comp))
        comp
    }
}

class Measured {
    output: Output
    el: Element
    overlays: Array[Any]
    focusables: Array[Any]
    kitties: Array[Any]

    init(output: Output, el: Element, overlays: Array[Any], focusables: Array[Any], kitties: Array[Any]) {
        self.output     = output
        self.el         = el
        self.overlays   = overlays
        self.focusables = focusables
        self.kitties    = kitties
    }

    replay(dx: Int, dy: Int) -> (Output, Element) {
        shift-element(el, dx, dy)
        for overlays {
            _overlays.push(it)
        }
        for focusables {
            _focusables.push(it)
        }
        for k: _ in kitties {
            _kitty-images.push({id: k.id, escape: k.escape, ox: k.ox + dx, oy: k.oy + dy, fresh?: k.fresh?})
        }
        (output, el)
    }
}

fn child-key(child: Any, i: Int) -> String {
    let key = match child {
        n: Node      => n.props['key'],
        c: Component => c.?key,
        _            => nil
    }
    match key {
        k: String => "#{k}",
        k: Int    => "#{k}",
        _         => "{i}"
    }
}

fn size-node(r: Any, w: Any, h: Any) -> Any {
    if !(r :: Node) || (w == nil && h == nil) {
        return r
    }
    let props = %{**r.props}
    if w != nil {
        props['width'] = w
    }
    if h != nil {
        props['height'] = h
    }
    Node(r.tag, props, r.children)
}

fn sync-interval(inst: Component) {
    let iv = inst.interval
    if iv == inst.ink-interval-period && (iv == nil || inst.ink-interval-timer != nil) {
        return
    }
    inst.ink-interval-timer.?cancel()
    inst.ink-interval-timer = nil
    inst.ink-interval-period = iv
    if let $p = iv {
        inst.ink-interval-timer = inst.every(p, -> do { inst.tick(); inst.invalidate!() })
    }
}

fn finish-box(
    lines: Array[String], w: Int,
    px: Int, py: Int, mx: Int, my: Int,
    bstyle: Array[String] | nil, bcolor: String | nil,
    bg: String | nil, forced-fg: String | nil,
    target-w: Int | nil, max-w: Int,
    ox: Int, oy: Int, props: Dict[String, Any],
    child-elements: Array[Element]
) -> (Output, Element) {
    let (lines, w) = apply-padding(lines, w, px, py)

    if let $fg = forced-fg {
        lines = apply-forced-fg(lines, fg)
    }

    if let $bg = bg {
        if target-w == nil && max-w < INF && max-w > w {
            for line; i in lines {
                lines[i] = pad-line(line, line.width(), max-w)
            }
            w = max-w
        }
        lines = apply-bg(lines, bg)
    }

    if bstyle {
        let (lines, w) = apply-border(lines, w, bstyle, bcolor)
        let (lines, w) = apply-padding(lines, w, mx, my)
        let output = Output(lines, w)
        return (output, Element(ox, oy, w, output.height, props, child-elements))
    }

    let (lines, w) = apply-padding(lines, w, mx, my)
    let output = Output(lines, w)
    (output, Element(ox, oy, w, output.height, props, child-elements))
}

fn layout-box(
    node: Node,
    max-w: Int,
    max-h: Int,
    path: String,
    ox: Int,
    oy: Int
) -> (Output, Element) {
    let children: Array[Any] = []
    let child-keys: Array[String] = []
    for c; i in node.children {
        if c != nil && c != false {
            children.push(c)
            child-keys.push(child-key(c, i))
        }
    }
    let n-children = #children
    let direction  = node.direction
    let gap        = node.gap
    let px         = node.px
    let py         = node.py
    let mx         = node.mx
    let my         = node.my
    let bstyle     = node.bstyle
    let bcolor     = node.bcolor
    let target-w   = node.width
    let target-h   = node.height
    let border-v   = bstyle ? 1 : 0

    let chrome-x = 2 * (mx + px + border-v)
    let chrome-y = 2 * (my + py + border-v)

    let outer-w = target-w ?? max-w
    let outer-h = target-h ?? max-h
    let content-w = (outer-w >= INF) ? INF : max(outer-w - chrome-x, 0)
    let content-h = (outer-h >= INF) ? INF : max(outer-h - chrome-y, 0)

    let content-ox = ox + mx + px + border-v
    let content-oy = oy + my + py + border-v

    if n-children == 0 {
        let w = (target-w != nil) ? content-w : 0
        let lines: Array[String] = []
        if target-h != nil {
            let blank = ' ' * w
            for ..max(int(target-h) - chrome-y, 0) {
                lines.push(blank)
            }
        }
        return finish-box(lines, w, px, py, mx, my, bstyle, bcolor,
                          node.bg, node.props['_forceFg'], target-w, max-w,
                          ox, oy, node.props, [])
    }

    let row? = (direction == 'row')
    let total-flex = 0
    let has-flex? = false
    let flexes: Array[Int | nil] = []

    for child in children {
        let f = match child {
            n: Node      => n.flex,
            c: Component => c.?flex,
            _            => nil
        }
        flexes.push(f)
        if f {
            total-flex += int(f)
            has-flex? = true
        }
    }

    let child-widths: Array[Int] = []
    let child-heights: Array[Int] = []

    let measured: Dict[Int, Measured] = %{}

    if has-flex? {
        let fixed = 0
        for child; i in children if flexes[i] == nil {
            let ov0 = #_overlays
            let fc0 = #_focusables
            let ki0 = #_kitty-images
            let (o, el) = layout-node(child, content-w, content-h, "{path}.{child-keys[i]}", 0, 0)
            measured[i] = Measured(o, el, _overlays[ov0;], _focusables[fc0;], _kitty-images[ki0;])
            _overlays.take!(ov0)
            _focusables.take!(fc0)
            _kitty-images.take!(ki0)
            fixed += row? ? o.width : o.height
        }
        let num-gaps = gap * max(n-children - 1, 0)
        let pool = max((row? ? content-w : content-h) - fixed - num-gaps, 0)
        debug!("{row? ? 'flex-row' : 'flex-col'} [{path}]: pool={pool} fixed={fixed} total-flex={total-flex}")
        let shares: Array[Int | nil] = [
            (f != nil && total-flex > 0) ? (pool * int(f) / total-flex) : nil
            for f in flexes
        ]
        let rem = pool - (shares.map(\_ ?? 0).sum() ?? 0)
        for i in ..n-children {
            let share = if let $sh = shares[i] {
                let bonus = (rem > 0) ? 1 : 0
                rem -= bonus
                sh + bonus
            }
            child-widths.push(row?  ? (share ?? content-w) : content-w)
            child-heights.push(row? ? content-h : (share ?? content-h))
        }
    } else {
        for ..n-children {
            child-widths.push(content-w)
            child-heights.push(content-h)
        }
    }

    let blocks: Array[Output] = []
    let child-elements: Array[Element] = []
    let cx = content-ox
    let cy = content-oy
    let flex-prop = row? ? 'width' : 'height'
    let pinh = _inh-spec
    if let $own = node.inh {
        _inh-spec = (pinh == nil) ? own : "{pinh} {own}"
    }

    for child; i in children {
        let fw = child-widths[i]
        let fh = child-heights[i]
        let cpath = "{path}.{child-keys[i]}"
        let (out, el) = if let $m = measured[i] {
            m.replay(cx, cy)
        } else if flexes[i] {
            match child {
                n: Node => layout-node(
                    Node(n.tag, n.props + %{flex-prop: (row? ? fw : fh)}, n.children),
                    fw, fh, cpath, cx, cy
                ),
                _ => layout-node(
                    child, fw, fh, cpath, cx, cy,
                    force-w=(row? ? fw : nil),
                    force-h=(row? ? nil : fh)
                )
            }
        } else {
            layout-node(child, fw, fh, cpath, cx, cy)
        }
        blocks.push(out)
        child-elements.push(el)
        if row? { cx += out.width  + gap }
        else    { cy += out.height + gap }
    }
    _inh-spec = pinh

    let min-content-w: Int = (target-w != nil) ? content-w : 0
    let min-content-h: Int = (target-h != nil) ? content-h : 0
    let justify-h = (target-h != nil) ? content-h : 0
    let align   = node.align
    let justify = node.justify

    let (lines, w) = row?
        ? stack-row(blocks, gap, align, justify, content-w, min-content-h)
        : stack-column(blocks, gap, min-content-w, align, justify, justify-h)

    if justify != 'start' || align != 'start' {
        let do-justify = justify != 'start'
        if !row? {
            let stacked-w = max(blocks.map(&.width).max() ?? 0, min-content-w)
            let stacked-h = blocks.map(&.height).sum(0) + gap * max(n-children - 1, 0)
            let gaps = (do-justify && justify-h > 0 && justify-h < INF)
                ? compute-gaps(n-children, stacked-h, justify-h, gap, justify)
                : nil
            let dy = 0
            for el; i in child-elements {
                let g = gaps ? ((i < #gaps) ? gaps[i] : 0) : ((i > 0) ? gap : 0)
                let extra-y = dy + g - ((i > 0) ? gap : 0)
                dy += g - ((i > 0) ? gap : 0)
                if extra-y != 0 {
                    shift-element(el, 0, extra-y)
                }
                let dx = match align {
                    'center'         => (stacked-w - el.w) / 2,
                    'end' or 'right' => stacked-w - el.w,
                    _                => 0
                }
                if dx != 0 { shift-element(el, dx, 0) }
            }
        } else {
            let stacked-h = max(blocks.map(&.height).max() ?? 0, min-content-h)
            let stacked-w = blocks.map(&.width).sum(0) + gap * max(n-children - 1, 0)
            let gaps = (do-justify && content-w > 0 && content-w < INF)
                ? compute-gaps(n-children, stacked-w, content-w, gap, justify)
                : nil
            let dx = 0
            for el; i in child-elements {
                let g = gaps ? ((i < #gaps) ? gaps[i] : 0) : ((i > 0) ? gap : 0)
                let extra-x = dx + g - ((i > 0) ? gap : 0)
                dx += g - ((i > 0) ? gap : 0)
                if extra-x != 0 {
                    shift-element(el, extra-x, 0)
                }
                let dy = match align {
                    'center'          => (stacked-h - el.h) / 2,
                    'end' or 'bottom' => stacked-h - el.h,
                    _                 => 0
                }
                if dy != 0 { shift-element(el, 0, dy) }
            }
        }
    }

    if target-w != nil {
        if w > content-w {
            for line; i in lines if line.width() > content-w {
                lines[i] = clip-line(line, content-w)
            }
            w = content-w
        } else if w < content-w {
            for line; i in lines {
                lines[i] = pad-line(line, line.width(), content-w)
            }
            w = content-w
        }
    }

    if target-h != nil {
        let th = max(int(target-h) - chrome-y, 0)
        let scroll-offset = node.props['scroll']
        if scroll-offset != nil {
            let total = #lines
            let s = int(scroll-offset).clamp(0, max(total - th, 0))
            debug!("scroll [{path}]: offset={s} visible={th} total={total}")
            lines = lines[s;min(s + th, total)]
            node.props['_scroll-total'] = total
            if s > 0 {
                for el in child-elements {
                    shift-element(el, 0, -s)
                }
            }
        }
        if #lines > th {
            lines.take!(th)
        } else {
            let blank = ' ' * w
            while #lines < th {
                lines.push(blank)
            }
        }
    }

    finish-box(lines, w, px, py, mx, my, bstyle, bcolor,
               node.bg, node.props['_forceFg'], target-w, max-w,
               ox, oy, node.props, child-elements)
}

fn layout-overlay(node: Node, max-w: Int, max-h: Int, path: String) -> (Output, Element) {
    let child = (#node.children == 1) ? node.children[0] : Box(*node.children)
    let ov-w = node.width
    let ov-h = node.height

    let sw = (_screen-w < INF) ? _screen-w : max-w
    let sh = (_screen-h < INF) ? _screen-h : max-h

    let (output, el) = layout-node(
        size-node(child, ov-w, ov-h),
        ov-w ?? sw, ov-h ?? sh, "{path}@", 0, 0,
        force-w=ov-w, force-h=ov-h
    )

    let ov-x = node.props['x']
    let ov-y = node.props['y']
    let center = node.props['center']

    let x: Int = ov-x ?? (center ? max((sw - output.width) / 2, 0) : 0)
    let y: Int = ov-y ?? (center ? max((sh - output.height) / 2, 0) : 0)

    shift-element(el, x, y)
    _overlays.push({output, x, y, el})

    (Output([], 0), Element(0, 0, 0, 0, node.props))
}

fn layout-node(
    node: Any,
    max-w: Int = INF,
    max-h: Int = INF,
    path: String = '',
    ox: Int = 0,
    oy: Int = 0,
    force-w: Int | nil = nil,
    force-h: Int | nil = nil
) -> (Output, Element) {
    match node {
        n: Node => match n.tag {
            NodeBox     => layout-box(n, max-w, max-h, path, ox, oy),
            NodeText    => layout-text(n, max-w, max-h, ox, oy),
            NodeOverlay => layout-overlay(n, max-w, max-h, path),
            NodeRaw => do {
                let lines = n.props['lines'] ?? []
                let w = int(n.props['width'] ?? 0)
                (Output(lines, w), Element(ox, oy, w, #lines, n.props))
            }
        },
        c: Component => do {
            let inst = reconcile(c, path)

            inst.focus!(inst == _focused)
            if inst.focusable? {
                _focusables.push(inst)
            }

            sync-interval(inst)
            inst.ink-parent = _layout-owner

            if !inst.dirty? && inst.stale? {
                inst.invalidate!()
            }

            let fw = force-w ?? inst.?width
            let fh = force-h ?? inst.?height

            if !inst.dirty? and let $memo = inst.ink-memo and memo.valid?(path, max-w, max-h, fw, fh) {
                return memo.replay(ox, oy)
            }

            let fl0 = #_fiber-log
            let fc0 = #_focusables
            let ov0 = #_overlays
            let ki0 = #_kitties
            let im0 = #_kitty-images

            inst.layout-x = ox
            inst.layout-y = oy

            let same-constraints = (inst.layout-max-w == max-w)
                                && (inst.layout-max-h == max-h)

            inst.layout-max-w = max-w
            inst.layout-max-h = max-h

            let rendered = if !inst.dirty? && inst.cached-node != nil && same-constraints {
                inst.cached-node
            } else {
                inst.dirty? = false
                _ctx-stack.push(%{})
                let r = inst.render()
                inst.ink-ctx-frame = _ctx-stack.pop()
                inst.cached-node = r
                r
            }

            let sized = size-node(rendered, fw, fh)

            if let $entry = inst.?kitty-entry {
                let fresh? = entry.fresh? ?? false
                let x-off = int(entry.?x-off ?? 0)
                let ki = { id: entry.id, escape: entry.escape, ox: ox + x-off, oy: oy, fresh?: fresh? }
                debug!("layout: kitty id={ki.id} fresh={fresh?} at ({ox + x-off},{oy}) for {type(inst)}")
                _kitties.push(ki.id)
                _kitty-images.push(ki)
                entry.fresh? = false
            }

            _ctx-stack.push(inst.ink-ctx-frame)
            let owner = _layout-owner
            _layout-owner = inst
            let (output, el) = layout-node(sized, max-w, max-h, "{path}${type(inst).__id__}", ox, oy)
            _layout-owner = owner
            _ctx-stack.pop()

            if (rendered :: Node) and let $st = rendered.props['_scroll-total'] {
                inst.scroll-total = int(st)
            }

            let wrapper = Element(
                ox, oy, output.width, output.height,
                %{}, [el], component=inst
            )

            let images: Array[Any] = []
            for k: _ in _kitty-images[im0;] {
                images.push({id: k.id, escape: k.escape, rx: k.ox - ox, ry: k.oy - oy})
            }

            inst.ink-memo = LayoutMemo(
                path, max-w, max-h, fw, fh, output, wrapper,
                _fiber-log[fl0;], _focusables[fc0;], _overlays[ov0;],
                _kitties[ki0;], images
            )

            (output, wrapper)
        },
        nil or false => (Output([], 0), Element(ox, oy, 0, 0, %{})),
        x => do {
            let ls = "{x}".lines() ?? ['']
            let w = ls.map(&width).max() ?? 0
            let out = Output(ls.map(fmt@('%-*s', w, _)), w)
            (out, Element(ox, oy, w, #ls, %{}))
        }
    }
}

let __tls::_screen-w: Int = INF
let __tls::_screen-h: Int = INF

fn drop-cols(line: String, n: Int) -> String {
    let out = Blob()
    let col = 0
    for tok in line.matches(/\x1b\[[0-9;:]*m|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\X/u) {
        if tok.match?(/^\x1b/) {
            out.push(tok)
        } else if col >= n {
            out.push(tok)
        } else {
            col += tok.width()
            if col > n {
                out.push(' ' * (col - n))
            }
        }
    }
    out.str!()
}

fn composite-overlays(lines: Array[String], width: Int) -> Array[String] {
    if #_overlays == 0 {
        return lines
    }
    let out: Array[String] = [*lines]
    for ov in _overlays {
        for piece; i in ov.output.lines {
            let row: Int = ov.y + i
            while #out <= row {
                out.push(' ' * width)
            }
            let base: String = out[row]
            let left = pad-line(clip-line(base, ov.x), min(base.width(), ov.x), ov.x)
            out[row] = "{left}{RST}{piece}{RST}{drop-cols(base, ov.x + ov.output.width)}"
        }
    }
    out
}

fn render-tree(root, max-w: Int, max-h: Int = INF) -> (Output, Element) {
    debug!("--- render-tree ({max-w}×{max-h}) ---")
    _screen-w = max-w
    _screen-h = max-h
    let prev-count = #_fibers
    _next-fibers = %{}
    _fiber-log = []
    _layout-owner = nil
    _inh-spec = nil
    _focusables = []
    _overlays = []
    _kitty-images = []
    let result = layout-node(root, max-w, max-h)
    let unmounted = 0
    for path, comp in _fibers {
        if _next-fibers[path] == nil {
            debug!("render-tree: pruning [{path}] {type(comp)}")
            comp.unmount!()
            unmounted += 1
        }
    }
    _fibers = _next-fibers

    if _focused != nil && !_focused.alive? {
        set-focus(nil)
    }
    debug!("render-tree: {#_fibers} fibers ({#_fibers - prev-count + unmounted} new, {unmounted} removed), {#_focusables} focusables, {#_overlays} overlays")

    if let $cls = _pending-focus-type {
        _pending-focus-type = nil
        debug!("render-tree: resolving deferred focus-by-type({cls})")
        let before = _focused
        focus-by-type(cls)
        if _focused != before {
            return render-tree(root, max-w, max-h)
        }
    }

    result
}

fn process-timers() -> Bool {
    let t0 = now()
    let fired = false
    let fire-count = 0

    for _timers if !it.canceled? {
        if it.deadline <= t0 {
            debug!("timer fired: owner={type(it.owner)} repeat={it.repeat != nil}")
            it.fire()
            if !it.reschedule() {
                it.cancel()
            }
            fired = true
            fire-count += 1
        }
    }

    let before = #_timers
    _timers.filter!(\!_.canceled?)
    if fire-count > 0 || before != #_timers {
        debug!("process-timers: {fire-count} fired, {before - #_timers} removed, {#_timers} remaining")
    }

    fired
}

fn next-timer-deadline() -> Float | nil {
    return _timers.filter(\!_.canceled?)
           .map(&.deadline)
           .min()
}

fn paint-output(output: Output) {
    _out.clear()
    for line in output.lines {
        _out.push(line)
        _out.push('\n')
    }
    write(1, _out)
}

fn restore-global-bg(line: String, bg: String) -> String {
    line.sub(/\x1b\[(?:(?:[0-9:]*;)*(?:0|49)(?:;[0-9:]*)*)?m/, sgr -> "{sgr}{bg}")
}

let __tls::_last-inline-height: Int = 0

let __tls::_cursor:       (Int, Int, String) | nil = nil
let __tls::_cursor-shown: (Int, Int, String) | nil = nil
let __tls::_shape-sent:   String | nil             = nil
let __tls::_title:        String | nil             = nil
let __tls::_title-sent:   String | nil             = nil

pub fn set-title(title: String | nil) {
    _title = title
}

fn strip-cursor(lines: Array[String], dx: Int = 0, dy: Int = 0) -> Array[String] {
    if !lines.any?(\_.contains?("\x1b]7777;")) {
        return lines
    }
    [unmark(line, row, dx, dy) for line; row in lines]
}

fn unmark(line: String, row: Int, dx: Int, dy: Int) -> String {
    let $at = line.search(CURSOR_MARK) or return line
    if _cursor == nil and let [_, shape] = line[at;].match(CURSOR_MARK) {
        _cursor = (row + dy, line[;at].width() + dx, shape)
    }
    line.sub(CURSOR_MARK, '')
}

fn title-escape() -> String {
    if _title == _title-sent {
        return ''
    }
    let push = (_title-sent == nil) ? "\x1b[22;0t" : ''
    _title-sent = _title ?? ''
    "{push}\x1b]0;{_title ?? ''}\x07"
}

fn cursor-shape-escape(shape: String) -> String {
    if shape == _shape-sent || shape == 'reverse' {
        return ''
    }
    _shape-sent = shape
    "\x1b[{CURSOR_SHAPES[shape] ?? 0} q"
}

fn release-terminal-state() -> String {
    let out = Blob()
    if _shape-sent != nil {
        out.push("\x1b[0 q")
    }
    if _title-sent != nil {
        out.push("\x1b[23;0t")
    }
    _shape-sent  = nil
    _title-sent  = nil
    _title       = nil
    _cursor      = nil
    _cursor-shown = nil
    out.str!()
}

fn paint-inline(output: Output, cols: Int) {
    _out.clear()
    _out.push("\x1b[?2026h\x1b[?7l\x1b[?25l")
    _out.push(title-escape())
    _cursor = nil
    let lines = strip-cursor(composite-overlays(output.lines, cols))
    if _last-inline-height > 0 {
        _out.push("\x1b[{_last-inline-height}A\r")
    }
    _out.push("\x1b[0J")
    let bg = _bg-global-sgr
    let bg-off = (#bg > 0) ? "\x1b[49m" : ''
    for line in lines {
        if #bg > 0 {
            _out.push("{bg}{restore-global-bg(line, bg)}{bg-off}\n")
        } else {
            _out.push("{line}\n")
        }
    }
    _last-inline-height = #lines
    if let ($row, $col, $shape) = _cursor {
        let up = #lines - row
        _out.push(cursor-shape-escape(shape))
        _out.push("\x1b[{up}A\r")
        if col > 0 {
            _out.push("\x1b[{col}C")
        }
        _out.push("\x1b[?25h")
        _last-inline-height = row
    }
    _out.push("\x1b[?7h\x1b[?2026l")
    write(1, _out)
}

pub fn ink-write(*args) {
    _out.clear()
    if _last-inline-height > 0 {
        _out.push("\x1b[{_last-inline-height}A\r")
    }
    _out.push("\x1b[0J")
    for arg in args { _out.push("{arg}") }
    _last-inline-height = 0
    _last-output = nil
    write(1, _out)
}

pub fn ink-log(*args) {
    _out.clear()
    if _last-inline-height > 0 {
        _out.push("\x1b[{_last-inline-height}A\r")
    }
    _out.push("\x1b[0J")
    for arg in args {
        match arg {
            (n: Node) or (n: Component) => {
                let (output, _) = layout-node(n, _tio ? _tio.size().1 : 80)
                for line in output.lines {
                    _out.push("{line}\n")
                }
            },
            _ => _out.push("{arg}\n")
        }
    }
    _last-inline-height = 0
    _last-output = nil
    write(1, _out)
}

pub fn invalidate-screen() {
    _screen.invalidate()
    _cursor-shown = nil
    _prev-kitties = []
}

let __tls::_screen: Screen = Screen(0, 0)
let __tls::_screen-touched?: Bool = false

fn paint-fullscreen(output: Output, rows: Int, cols: Int) {
    _out.clear()
    _out.push("\x1b[?2026h\x1b[?7l")
    let old-kitties = _prev-kitties
    for id in old-kitties if id not in _kitties {
        _out.push(kitty-delete(id))
    }
    _screen.resize(cols, rows)
    _screen.background = _bg-global-sgr
    if _debug-borders? || _screen-touched? {
        _screen.touch()
    }
    _screen-touched? = _debug-borders?
    _cursor = nil
    _screen.put-lines(strip-cursor(output.lines))
    for ov in _overlays {
        for line; i in strip-cursor(ov.output.lines, ov.x, ov.y) {
            _screen.put(ov.y + i, ov.x, line)
        }
    }
    _screen.flush(_out)
    _out.push(title-escape())
    match _cursor {
        ($row, $col, $shape) => {
            _out.push(cursor-shape-escape(shape))
            _out.push("\x1b[{row + 1};{col + 1}H")
            if _cursor-shown == nil {
                _out.push("\x1b[?25h")
            }
        },
        nil => {
            if _cursor-shown != nil {
                _out.push("\x1b[?25l")
            }
        }
    }
    _cursor-shown = _cursor
    for ki in _kitty-images {
        if ki.fresh? || ki.id not in old-kitties {
            if ki.id in old-kitties {
                _out.push(kitty-delete(ki.id))
            }
            _out.push("\x1b[{ki.oy + 1};{ki.ox + 1}H")
            _out.push(ki.escape)
        }
    }
    _prev-kitties = _kitties
    _kitties = []
    _out.push("\x1b[?7h\x1b[?2026l")
    write(1, _out)
}

let __tls::_debug-mouse-x: Int = 0
let __tls::_debug-mouse-y: Int = 0

fn paint-debug-borders(tree: Element, rows: Int) {
    let mx = _debug-mouse-x
    let my = _debug-mouse-y

    fn find-deepest(el: Element) -> Element | nil {
        if mx < el.x || mx >= el.x + el.w { return nil }
        if my < el.y || my >= el.y + el.h { return nil }
        for child in el.children[;;-1] {
            let $found = find-deepest(child) or continue
            return found
        }
        el
    }

    let $target = find-deepest(tree) or return

    fn draw-el(el: Element, color: String) {
        if el.w == 0 || el.h == 0 { return }
        let c = color
        let x = el.x + 1
        let y = el.y + 1
        let w = el.w
        let h = el.h

        let name = if let $comp = el.component {
            "{type(comp)}".comb(/^<class |>$/)
        } else {
            ''
        }

        for row in ..h if y + row >= 1 && y + row <= rows {
            _out.push("\x1b[{y + row};{x}H{c}│{RST}")
            if w > 1 {
                _out.push("\x1b[{y + row};{x + w - 1}H{c}│{RST}")
            }
        }

        if y >= 1 && y <= rows && w > 2 {
            _out.push("\x1b[{y};{x + 1}H{c}{'─' * (w - 2)}{RST}")
        }
        if h >= 2 && y + h - 1 <= rows && w > 2 {
            _out.push("\x1b[{y + h - 1};{x + 1}H{c}{'─' * (w - 2)}{RST}")
        }

        if y >= 1 && y <= rows {
            _out.push("\x1b[{y};{x}H{c}┌{RST}")
            if w > 1 { _out.push("\x1b[{y};{x + w - 1}H{c}┐{RST}") }
        }
        if h >= 2 && y + h - 1 <= rows {
            _out.push("\x1b[{y + h - 1};{x}H{c}└{RST}")
            if w > 1 { _out.push("\x1b[{y + h - 1};{x + w - 1}H{c}┘{RST}") }
        }

        let label = "{name} {w}×{h} @ ({el.x},{el.y})"
        if #label < w - 2 && y >= 1 && y <= rows {
            _out.push("\x1b[{y};{x + 1}H{c}\x1b[7m {label} {RST}")
        }
    }

    _out.clear()
    draw-el(target, "\x1b[93m")
    write(1, _out)
}

const CTRL_C = event.Key({key: 'c', _key: nil, base: nil, mods: CTRL, event: 1, text: [3]})

fn layout-key(ev) {
    match ev {
        event.Key({base: $b, mods: m, *} as k)
        and (m & (term.mod.CTRL | term.mod.ALT | term.mod.SUPER)) != 0 =>
            event.Key({*k, key: b, _key: nil}),
        _ => ev
    }
}

fn is-ctrl-c(ev) {
    match ev {
        event.Key({key: 'c' or 99, mods: m, *}) => (m & CTRL) != 0,
        _ => false
    }
}

fn is-ctrl-l(ev) {
    match ev {
        event.Key({key: 'l' or 108, mods: m, *}) => (m & CTRL) != 0,
        _ => false
    }
}

let __tls::_dragging?: Bool = false
let __tls::_capture: Any = nil

fn mouse-xy(ev) -> (Int, Int) | nil {
    match ev {
        event.MouseDown({x, y, *})  => (int(x) - 1, int(y) - 1),
        event.MouseUp({x, y, *})    => (int(x) - 1, int(y) - 1),
        event.MouseMove({x, y, *})  => (int(x) - 1, int(y) - 1),
        event.ScrollUp({x, y, *})   => (int(x) - 1, int(y) - 1),
        event.ScrollDown({x, y, *}) => (int(x) - 1, int(y) - 1),
        _                           => nil
    }
}

fn hit-path(tree: Element, x: Int, y: Int) -> Array[Element] {
    for ov in _overlays[;;-1] {
        if let $path = ov.el.hit(x, y) {
            return path
        }
    }
    tree.hit(x, y) ?? []
}

fn path-components(path: Array[Element]) -> Array[Component] {
    let comps: Array[Component] = []
    for el in path {
        if let $c = el.component {
            comps.push(c)
        }
    }
    comps
}

fn component-chain(el: Element, target: Component) -> Array[Component] | nil {
    if el.component == target {
        return [target]
    }
    for child in el.children {
        if let $chain = component-chain(child, target) {
            if let $c = el.component {
                chain.push(c)
            }
            return chain
        }
    }
    nil
}

fn call-prop-handlers(path: Array[Element], ev: InkEvent, name: String, app: Component) -> Bool {
    let handled? = false
    for el in path {
        if ev.stopped? {
            break
        }
        if let $handler = el.props[name] {
            handler(ev)
            handled? = true
        }
    }
    if handled? {
        for path-components(path) {
            it.invalidate!()
        }
        app.invalidate!()
    }
    handled?
}

fn deliver(c: Component, ev) -> Exit | Ignored | Bool {
    let $handler = c.?on-event or return Ignored
    let r = handler(ev)
    if r == Ignored {
        return Ignored
    }
    c.invalidate!()
    (r == Exit) ? Exit : true
}

fn bubble(comps: Array[Component], ev) -> Exit | Bool {
    for c in comps {
        match deliver(c, ev) {
            Ignored => continue,
            r       => return r
        }
    }
    false
}

fn set-focus(c: Component | nil) {
    if _focused == c {
        return
    }
    debug!("focus -> {type(c)}")
    _focused.?focus!(false)
    _focused = c
    c.?focus!(true)
}

fn dispatch-mouse(app: Component, tree: Element, ev) -> Exit | Bool {
    if not let (x, y) = mouse-xy(ev) {
        return false
    }

    let path  = hit-path(tree, x, y)
    let comps = path-components(path)
    let ie    = InkEvent(ev, target=((#path > 0) ? path[0] : nil))

    match ev {
        event.MouseDown({button, *}) => do {
            let focusable = comps.filter(\_.focusable?)
            if #focusable > 0 {
                set-focus(focusable[0])
            } else if !path.any?(el -> el.props['onClick'] != nil) {
                set-focus(nil)
            }
            _dragging? = true
            _capture = nil
            if button == 0 {
                call-prop-handlers(path, ie, 'onClick', app)
            }
            if ie.stopped? {
                return true
            }
            for c in comps {
                match deliver(c, ev) {
                    Ignored => continue,
                    Exit    => return Exit,
                    _       => do { _capture = c; break }
                }
            }
            true
        },

        event.MouseUp(_) => do {
            let cap = _capture
            _dragging? = false
            _capture = nil
            call-prop-handlers(path, ie, 'onMouseUp', app)
            let targets = (cap != nil) ? [cap] : comps
            (bubble(targets, ev) == Exit) ? Exit : true
        },

        event.MouseMove(_) => do {
            let handled? = call-prop-handlers(path, ie, 'onMouseMove', app)
            if _dragging? and let $c = _capture {
                return (deliver(c, ev) == Exit) ? Exit : true
            }
            let hover = comps.filter(\_.wants-hover?)
            if #hover > 0 && deliver(hover[0], ev) == true {
                handled? = true
            }
            handled?
        },

        _ => do {
            if call-prop-handlers(path, ie, 'onScroll', app) {
                return true
            }
            bubble([*comps, app], ev)
        }
    }
}

fn dispatch-key(app: Component, tree: Element, ev) -> Exit | Bool {
    match ev {
        event.Key({event: e, *}) and e == 3 => return false,
        event.Key({key: 'TAB', event: (1 or 2), mods: m, *})
        and !(_focused.?handles-tab? ?? false) => do {
            cycle-focus(reverse?=((m & SHIFT) != 0))
            return true
        },
        _ => ()
    }

    let chain = if _focused.?focusable? {
        component-chain(tree, _focused) ?? [_focused]
    } else {
        []
    }

    bubble([*chain, app], ev)
}

fn dispatch(app: Component, tree: Element | nil, ev, interrupt?: Bool) -> Exit | Bool {
    if ev == Exit || ev == event.EOF || (is-ctrl-c(ev) && !interrupt?) {
        return Exit
    }

    let $t = tree or return false

    match ev {
        event.MouseDown(_) or event.MouseUp(_) or event.MouseMove(_)
        or event.ScrollUp(_) or event.ScrollDown(_) => dispatch-mouse(app, t, ev),
        _ => dispatch-key(app, t, ev)
    }
}

let __tls::_root-node: Any = nil

let __tls::_app: Any = nil
let __tls::_last-output: Output | nil = nil
let __tls::_last-tree: Element | nil = nil

fn render-root(app: Component, cols: Int, rows: Int) -> (Output, Element) {
    _app = app
    refresh-looks()
    app.layout-max-w = cols
    app.layout-max-h = rows
    sync-interval(app)
    app.dirty? = false
    _ctx-stack.push(%{})
    _root-node = app.render()
    app.ink-ctx-frame = _ctx-stack.pop()
    _ctx-stack.push(app.ink-ctx-frame)
    let (out, tree) = render-tree(_root-node, cols, rows)
    _ctx-stack.pop()
    _last-output = out
    _last-tree = tree
    (out, tree)
}

const DEV_SKIP = %{
    'width', 'height', 'children', 'focused?', 'mounted?', 'alive?', 'dirty?',
    'cachedNode', 'scrollTotal', 'layoutX', 'layoutY', 'layoutMaxW', 'layoutMaxH',
    'inkCtxFrame', 'inkParent', 'inkMemo', 'inkIntervalTimer', 'inkIntervalPeriod'
}

fn plain-value?(v: Any) -> Bool {
    match v {
        nil or (_: Int) or (_: Float) or (_: String) or (_: Bool) => true,
        xs: Array => xs.all?(plain-value?),
        d: Dict   => d.keys().all?(\_ :: String) && d.values().all?(plain-value?),
        _         => false
    }
}

fn fiber-paths() -> Dict[Any, String] {
    let paths: Dict[Any, String] = %{}
    for p, c in _fibers {
        paths[c] = p
    }
    paths
}

fn dev-tree(el: Element, paths: Dict[Any, String]) -> Array[Any] {
    let kids = el.children.flat-map(\dev-tree(_, paths))
    match el.component {
        nil => kids,
        c   => [%{
            'path':     paths[c] ?? '',
            'type':     "{type(c)}".comb(/^<class |>$/),
            'rect':     [el.x, el.y, el.w, el.h],
            'focused':  c == _focused,
            'children': kids
        }]
    }
}

fn dev-target(req: Dict[String, Any]) -> Component {
    match req['path'] {
        nil or '' => _app,
        p         => _fibers[p] ?? throw ValueError("no component at path '{p}'")
    }
}

fn field-key(name: String) -> String {
    name.sub(/\$\d+$/, '').sub(/^_+/, '').sub(/-(\w)/, m -> m[1].upper())
}

fn dev-fields(c: Component) -> Dict[String, Any] {
    let fields: Dict[String, Any] = %{}
    for name, v in members(c) {
        let base = name.sub(/\$\d+$/, '')
        if base in DEV_SKIP || base == '_propNames' || !plain-value?(v) {
            continue
        }
        fields[base] = v
    }
    fields
}

fn dev-set(c: Component, field: String, value: Any) {
    let want = field-key(field)
    for name, _ in members(c) {
        if field-key(name) == want {
            c.{name} = value
            c.invalidate!()
            return
        }
    }
    throw ValueError("no field '{field}' on {type(c)}")
}

fn dev-key(name: String, mods: Int) -> Any {
    event.Key({key: name, _key: nil, base: nil, mods: mods, event: 1, text: []})
}

fn dev-exec(req: Dict[String, Any]) -> Any {
    match req['cmd'] {
        'tree' => %{
            'path':     '',
            'type':     "{type(_app)}".comb(/^<class |>$/),
            'children': dev-tree(_last-tree ?? throw ValueError('nothing rendered yet'), fiber-paths())
        },
        'get' => dev-fields(dev-target(req)),
        'set' => do {
            dev-set(dev-target(req), req['field'], req['value'])
            true
        },
        'focus' => do {
            set-focus(dev-target(req))
            true
        },
        'looks' => do {
            use-looks(req['src'] ?? '')
            true
        },
        'theme' => do {
            match req {
                %{'name': n: String} => set-theme(n),
                _                    => set-theme(req['tokens'] ?? %{})
            }
            true
        },
        'screen' => do {
            let out = _last-output ?? throw ValueError('nothing rendered yet')
            composite-overlays(out.lines, out.width).map(\_.comb(/\x1b\[[0-9;:]*m|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)/))
        },
        'key' => do {
            _event-queue.put(dev-key(req['key'], req['mods'] ?? 0))
            true
        },
        'text' => do {
            for ch in (req['text'] ?? '').chars() {
                _event-queue.put(event.Text(ch))
            }
            true
        },
        'invalidate' => do {
            invalidate-all()
            true
        },
        other => throw ValueError("unknown cmd '{other}'")
    }
}

fn dev-request(line: String) -> String {
    let reply = SharedQueue()
    let req = try {
        json.parse(line)
    } catch e {
        return json.encode(%{'ok': false, 'error': "bad json: {e}"})
    }
    post(fn () {
        let result = try {
            %{'ok': true, 'result': dev-exec(req)}
        } catch e {
            %{'ok': false, 'error': "{e}"}
        }
        reply.put(json.encode(result))
    })
    reply.take()
}

let _dev-sock: (Int, String) | nil = nil

fn stop-serving() {
    if let (fd, path) = _dev-sock {
        os.close(fd)
        unlink(path)
        _dev-sock = nil
    }
}

pub fn serve(path: String) {
    unlink(path)
    let sock = net.listen('unix', path)
    _dev-sock = (sock, path)
    Thread(fn () {
        for (;;) {
            let (conn, _) = os.accept(sock) ?? break
            Thread(fn () {
                let reader = io.LineReader(conn)
                while reader.fill() {
                    for line in reader {
                        if #line.trim() > 0 {
                            write(conn, "{dev-request(line)}\n")
                        }
                    }
                }
                os.close(conn)
            }).detach()
        }
    }).detach()
}

fn reset-runtime() {
    _root-node = nil
    for _, c in _fibers {
        if c.alive? {
            c.unmount!()
        }
    }
    _focused            = nil
    _timers             = []
    _fibers             = %{}
    _next-fibers        = %{}
    _ctx-stack          = [%{}]
    _focusables         = []
    _overlays           = []
    _prev-kitties       = []
    _kitties            = []
    _kitty-images       = []
    _pending-focus-type = nil
    _dragging?          = false
    _capture            = nil
    _status-claims.clear()
    _status-sent.clear()
    while let Some(_) = _event-queue.try-take(0) {
        ;
    }
}

pub fn render(root) {
    let (rows, cols) = term.size(1)
    let (output, tree) = render-tree(root, cols, rows)
    paint-output(output)
}

pub fn terminal-color(n: Int) -> (Int, Int, Int) | nil {
    _tio.?color(n)
}

pub fn run(
    app: Node | Component,
    fullscreen: Bool = true,
    title: String | nil = nil,
    probe: Float = 0.5,
    %terminal
) {
    if app :: Node {
        render(app)
        return
    }

    reset-runtime()

    let tio = (_tio = term.TermIO(events=cast(_event-queue), **(%{'mouse': fullscreen} + terminal)))
    _inline? = !fullscreen
    let interrupt? = app.handles-interrupt?

    if title != nil {
        set-title(title)
    }

    fn enter-screen() {
        _out.clear()
        if fullscreen {
            _out.push("\x1b[?1049h\x1b[?25l")
            if #_bg-global-sgr > 0 {
                _out.push(_bg-global-sgr)
                _out.push("\x1b[2J")
            }
        } else {
            _out.push("\x1b[?25l")
            _last-inline-height = 0
        }
        write(1, _out)
    }

    let dirty = true
    let tree: Element | nil = nil
    let last-paint = 0.0
    _dragging? = false
    _capture = nil

    if let $sock = getenv('INK_SOCK') {
        serve(sock)
    }
    signal(SIGWINCH, fn () { dirty = true })
    let on-term = signal(os.SIGTERM)
    let on-hup = signal(os.SIGHUP)
    signal(os.SIGTERM, -> _event-queue.put(Exit))
    signal(os.SIGHUP, -> _event-queue.put(Exit))
    defer signal(os.SIGTERM, on-term)
    defer signal(os.SIGHUP, on-hup)
    let on-interrupt = signal(os.SIGINT)
    signal(os.SIGINT, -> _event-queue.put(interrupt? ? CTRL_C : event.EOF))
    defer signal(os.SIGINT, on-interrupt)
    let on-suspend = signal(os.SIGTSTP)
    signal(os.SIGTSTP, suspend)
    defer signal(os.SIGTSTP, on-suspend)

    fn suspend-terminal() {
        tio.stop()
        let restore = release-terminal-state()
        if fullscreen {
            write(1, "\x1b[0m\x1b[?25h\x1b[?1049l{restore}")
        } else {
            ink-write("\x1b[0m\x1b[?25h{restore}")
        }

        signal(os.SIGTSTP, os.SIG_DFL)
        os.kill(0, os.SIGTSTP)
        signal(os.SIGTSTP, suspend)

        tio.start()
        if title != nil {
            set-title(title)
        }
        if fullscreen {
            write(1, "\x1b[?1049h\x1b[?25l")
        } else {
            write(1, "\x1b[?25l")
        }
        _dragging? = false
        _capture = nil
        invalidate-screen()
        dirty = true
    }

    fn cleanup() {
        stop-serving()
        for _, c in _fibers {
            if c.alive? {
                c.unmount!()
            }
        }
        if app.alive? {
            app.unmount!()
        }
        _out.clear()
        if fullscreen {
            _out.push("\x1b[?25h\x1b[?1049l")
        } else {
            if _last-inline-height < (_last-output.?height ?? 0) {
                _out.push("\x1b[{(_last-output.?height ?? 0) - _last-inline-height}B")
            }
            _out.push("\r\x1b[?25h\n")
        }
        _out.push(release-terminal-state())
        write(1, _out)
        tio.stop()
        tio.close()
    }

    fn repaint() {
        dirty = false
        last-paint = now()
        let (rows, cols) = tio.size()
        let (output, t) = render-root(app, cols, rows)
        tree = t
        if fullscreen {
            paint-fullscreen(output, rows, cols)
        } else {
            paint-inline(output, cols)
        }
        if _debug-borders? and let $t = tree {
            paint-debug-borders(t, rows)
            invalidate-screen()
        }
        sync-status(tio, app)
    }

    fn handle(ev) -> Bool {
        ev = layout-key(ev)

        if ev == Suspend {
            suspend-terminal()
            return false
        }

        if is-ctrl-l(ev) {
            invalidate-screen()
            _out.clear()
            if fullscreen {
                _out.push("\x1b[H{_bg-global-sgr}\x1b[2J")
            } else {
                _last-inline-height = 0
                _out.push("\x1b[2J\x1b[H")
            }
            write(1, _out)
            dirty = true
            return false
        }

        if (ev :: event.Key) && ev.nice-name() == 'C-S-i' {
            _debug-borders? = !_debug-borders?
            invalidate-screen()
            dirty = true
            return false
        }

        if _debug-borders? and let event.MouseMove({x: $dmx, y: $dmy, *}) = ev {
            _debug-mouse-x = int(dmx) - 1
            _debug-mouse-y = int(dmy) - 1
            dirty = true
        }

        match dispatch(app, tree, ev, interrupt?) {
            Exit => return true,
            true => dirty = true,
            _    => ()
        }

        false
    }

    tio.start(settle=probe)
    enter-screen()
    defer cleanup()

    if !app.mounted? {
        app.mount!()
    }

    repaint()

    for (;;) {
        let fps = app.max-fps ?? DEFAULT_FPS
        let frame = (fps > 0.0) ? 1.0 / fps : 0.0
        let deadline = next-timer-deadline()
        let timeout = (deadline != nil) ? min(max(deadline - now(), 0.0), IDLE_POLL) : IDLE_POLL
        if dirty {
            timeout = min(timeout, max(last-paint + frame - now(), 0.0))
        }

        while let Some(ev) = _event-queue.try-take(timeout) {
            timeout = 0.0
            if ev == Wake {
                dirty = true
            } else if let Call($f) = ev {
                f()
                dirty = true
            } else {
                break break if handle(ev)
            }
            if dirty && now() - last-paint >= frame {
                break
            }
        }

        if process-timers() {
            dirty = true
        }

        if dirty && now() - last-paint >= frame {
            repaint()
        }
    }
}

pub class TestHarness {
    __cursor: (Int, Int, String) | nil = nil
    __app: Component
    __tree: Element | nil
    __output: Output | nil
    __cols: Int
    __rows: Int

    init(app: Component, cols: Int = 80, rows: Int = 24, color?: Bool = true) {
        __app = app
        __cols = cols
        __rows = rows
        __tree = nil
        __output = nil

        reset-runtime()
        chalk.plain? = !color?
        _fg-cache = %{}
        _bg-cache = %{}
        set-theme(__theme-colors)

        if app :: Component {
            if !app.mounted? { app.mount!() }
        }

        repaint()
    }

    app   { __app }
    tree  { __tree }
    output { __output }
    focused { _focused }
    focusables { _focusables }

    lines -> Array[String] {
        __output ? __output.lines : []
    }

    painted-lines -> Array[String] {
        let bg = _bg-global-sgr
        (#bg > 0)
            ? lines.map(line -> "{bg}{restore-global-bg(line, bg)}{BG_RST}")
            : lines
    }

    plain-text -> String {
        lines.map(line ->
            line.comb(/\x1b\[[^m]*m/)
        ).unlines()
    }

    repaint() {
        while let Some(ev) = _event-queue.try-take(0) {
            if let Call($f) = ev {
                f()
            }
        }
        let (out, t) = render-root(__app, __cols, __rows)
        _cursor = nil
        __output = Output(strip-cursor(composite-overlays(out.lines, __cols)), out.width)
        __cursor = _cursor
        __tree = t
    }

    cursor -> (Int, Int, String) | nil { __cursor }

    __dispatch(ev) {
        ev = layout-key(ev)
        if is-ctrl-l(ev) {
            return
        }
        (dispatch(__app, __tree, ev, __app.handles-interrupt?) == Exit) ? Exit : nil
    }

    send(ev) {
        let r = __dispatch(ev)
        if r == Exit { return Exit }
        process-timers()
        repaint()
    }

    send-text(s: String) {
        for ch in s.chars() {
            let r = __dispatch(event.Text(ch))
            if r == Exit { return Exit }
        }
        process-timers()
        repaint()
    }

    send-key(key: String | Int, mods: Int = 0, ev-type: Int = 1) {
        send(event.Key({
            key: key, _key: nil, base: nil,
            mods: mods, event: ev-type, text: []
        }))
    }

    tab()      { send-key('TAB') }
    enter()    { send-key('ENTER') }
    up()       { send-key('UP') }
    down()     { send-key('DOWN') }
    left()     { send-key('LEFT') }
    right()    { send-key('RIGHT') }
    esc()      { send-key('ESCAPE') }
    backspace() { send-key('BACKSPACE') }
    del()      { send-key('DELETE') }
    home()     { send-key('HOME') }
    end()      { send-key('END') }
    pageup()   { send-key('PAGE_UP') }
    pagedown() { send-key('PAGE_DOWN') }

    find(cls) {
        for path, comp in _fibers {
            if comp :: cls { return comp }
        }
        nil
    }

    find-all(cls) -> Array[Component] {
        let result: Array[Component] = []
        for path, comp in _fibers {
            if comp :: cls { result.push(comp) }
        }
        result
    }

    line(n: Int) -> String {
        let ls = lines
        (n >= 0 && n < #ls) ? ls[n].comb(/\x1b\[[^m]*m/) : ''
    }

    line-count -> Int {
        __output ? __output.height : 0
    }

    assert-line(n: Int, pattern: String) {
        assert(line(n).match?(regex(pattern)))
    }

    focus!(comp: Component) {
        set-focus(comp)
        repaint()
    }

    focused-type -> String | nil {
        _focused ? "{type(_focused)}" : nil
    }

    advance(dt: Float) {
        for t in _timers if !t.canceled? {
            t.nudge(dt)
        }
        process-timers()
        repaint()
    }

    click(x: Int, y: Int) {
        send(event.MouseDown({x: x + 1, y: y + 1, button: 0, mods: 0}))
        send(event.MouseUp({x: x + 1, y: y + 1, button: 0, mods: 0}))
    }

    scroll-up(x: Int, y: Int) {
        send(event.ScrollUp({x: x + 1, y: y + 1, button: 0, mods: 0}))
    }

    scroll-down(x: Int, y: Int) {
        send(event.ScrollDown({x: x + 1, y: y + 1, button: 0, mods: 0}))
    }

    resize(cols: Int, rows: Int) {
        __cols = cols
        __rows = rows
        repaint()
    }

    snapshot() -> String { plain-text }

    assert-snapshot(name: String) {
        let p = Path("test/snapshots/{name}.txt")
        let actual = plain-text
        if p.file? {
            let expected = p.read-text()
            if actual != expected {
                throw "snapshot mismatch '{name}':\n"
                      "--- expected ---\n{expected}\n"
                      "--- actual ---\n{actual}"
            }
        } else {
            p.parent.mkdir(parents=true, exist-ok=true)
            p.write(actual)
        }
    }

    assert-focused(cls) {
        assert(_focused != nil && _focused :: cls)
    }

    assert-unfocused() {
        assert(_focused == nil)
    }

    assert-contains(needle: String) {
        assert(plain-text.match?(regex(needle)))
    }

    assert-not-contains(needle: String) {
        assert(!plain-text.match?(regex(needle)))
    }
}
