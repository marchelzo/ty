pub tag Exit;
pub tag Wake;
tag Suspend;
tag Call;

use InkEventInternal = Exit | Wake | Suspend | Call[Function] | event.Event

let _event-queue: SharedQueue[InkEventInternal] = SharedQueue()
let _tio: term.TermIO | nil = nil

pub fn suspend() {
    _event-queue.put(Suspend)
}

pub fn post(f: Function) {
    _event-queue.put(Call(f))
}

pub fn quit() {
    _event-queue.put(Exit)
}

let _status-claims: Dict[String, (Component, _)] = %{}
let _status-sent: Dict[String, _] = %{}

fn status-record(status: _) -> _ {
    match status {
        nil           => nil,
        s: String     => ({state: s}),
        {state: _, *} => status,
        _             => throw ValueError("not a terminal status: {status}")
    }
}

pub fn claim-status(owner: Component, id: String, status: _) {
    _status-claims[id] = (owner, {*status-record(status), id})
}

pub fn release-status(owner: Component) {
    let mine = [id for id, (o, _) in _status-claims if o == owner]

    for mine {
        _status-claims.remove(it)
    }
}

fn send-status(tio: term.TermIO, rec: _) {
    let {state, *opts} = rec
    tio.report-status(state, **opts)
}

fn sync-status(tio: term.TermIO, app: Component) {
    let want: Dict[String, _] = %{
        '': status-record(app.?status ?? term.status.IDLE)
    }

    for id, (_, rec) in _status-claims {
        want[id] = rec
    }

    for id in _status-sent.keys() {
        if !want.contains?(id) {
            tio.clear-status(id)
            _status-sent.remove(id)
        }
    }

    for id, rec in want {
        if _status-sent[id] != rec {
            send-status(tio, rec)
            _status-sent[id] = rec
        }
    }
}

pub tag CycleCompletions, ListCompletions, Insert, ReplaceLine;

use StyledText = String | chalk::Text

pub use CompletionLabel = StyledText | Array[StyledText | nil]
pub use CompletionItem = String | (CompletionLabel, String)
pub use CompletionAction = CycleCompletions[Array[CompletionItem]]
                         | ListCompletions[Array[CompletionItem]]
                         | Insert[String]
                         | ReplaceLine[String]
                         | None
pub use CompletionContext = {before: String, after: String}
pub use CompletionFunction = (CompletionContext) -> CompletionAction

fn text-window(chars: Array[String], cursor: Int, scroll: Int, inner-w: Int) -> (Int, Int) {
    let n = #chars
    let ws = chars.map(&width)
    let cur-w = (cursor < n) ? max(ws[cursor], 1) : 1
    let s = min(scroll, cursor)

    fn span(a: Int, b: Int) -> Int {
        ws[a;b].sum() ?? 0
    }

    while s < cursor && span(s, cursor) + cur-w > inner-w {
        s += 1
    }

    let tail-w = (cursor >= n) ? 1 : 0
    while s > 0 && span(s - 1, n) + tail-w <= inner-w {
        s -= 1
    }

    let e = s
    let used = 0
    while e < n && used + ws[e] <= inner-w {
        used += ws[e]
        e += 1
    }

    (s, e)
}

fn skip-cols(chars: Array[String], cols: Int) -> Int {
    let i = 0
    let used = 0
    while i < #chars && used < cols {
        used += chars[i].width()
        i += 1
    }
    i
}

fn completion-label(item: CompletionItem) -> CompletionLabel {
    (item :: String) ? item : item.0
}

fn completion-text(item: CompletionItem) -> String {
    match item {
        (_, s) => s,
        s      => s
    }
}

fn fit-items(items: Array[CompletionLabel], W: Int) -> Array[Array[String]] {
    fn width(text: StyledText | nil) -> Int {
        (text == nil) ? 0 : "{text}".width()
    }

    fn group-cols(n: Int) -> Array[Array[CompletionLabel]] {
        items.groups-of((#items + n - 1) / n)
    }

    fn widths(ncol: Int) -> Array[Array[Int]] {
        let cols = group-cols(ncol)

        fn col-widths(i: Int) -> Array[Int] {
            if i >= #cols { return [] }

            let nparts = cols[i]
                .map(label -> (label :: Array) ? #label : 1)
                .max() ?? 0

            let parts: Array[Int] = []

            fn limit() -> Int {
                W - (parts.sum() ?? 0)
            }

            let max-singleton = 0

            for j in ..nparts {
                let w = cols[i].map(match {
                    (label: Array[StyledText | nil]) and (#label > j) =>
                        min(limit(), width(label[j])),
                    (label: StyledText) and (j == 0) => do {
                        max-singleton = max(
                            max-singleton,
                            min(limit(), width(label))
                        )
                        0
                    },
                    _ => 0
                }).max() 
                parts.push(w || max-singleton ?? 0)
            }

            parts
        }

        [col-widths(it) for ..ncol]
    }

    let (ncol, ws) = (
        for ncol in 1..#items {
            let ws = widths(ncol + 1)
            if ws.flat().sum(0) + 6 * ncol > W {
                break (ncol, widths(ncol))
            }
        }
    ) ?? (#items, widths(#items))

    let cols: Array[Array[CompletionLabel]] = group-cols(ncol)
    let nrow: Int = cols.map(s -> #s).max() ?? 0

    fn s(x: StyledText | nil) -> String {
        match x {
            x: String => x,
            nil       => '',
            _         => "{x}"
        }
    }

    fn format(label: CompletionLabel, widths: Array[Int]) -> String {
        match label {
            parts: Array[StyledText | nil] => [
                "{s(parts[i]):<{widths[i]}}"
                for i in ..#parts
            ].str() ?? '',
            part => "{s(part):<{widths.sum()}}"
        }
    }

    return [
        cols.map(c -> (#c > i) ? c[i] : '').zip(ws, f=format)
        for i in ..nrow
    ]
}

