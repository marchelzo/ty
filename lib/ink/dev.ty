import os
import watchfs
import path (Path)
import time (now)
import ty

fn changed-source?(ev: _) -> Bool {
    match ev {
        (watchfs.Modify(p) or watchfs.Create(p)) => "{p}".match?(/\.ty$/),
        _ => false
    }
}

fn wait-for-change(w: watchfs.Watcher, timeout: Float) -> Bool {
    let deadline = now() + timeout
    for ev in w.events(timeout=timeout) {
        if now() > deadline {
            break
        }
        if changed-source?(ev) {
            for _ in w.events(timeout=0.05) {
                ;
            }
            return true
        }
    }
    false
}

fn exited?(pid: Int) -> Int | nil {
    match os.wait(pid, os.WNOHANG) {
        (_, status: Int) => status,
        _                => nil
    }
}

fn stop(pid: Int) {
    os.kill(pid, os.SIGUSR1)
    let deadline = now() + 2.0
    while now() < deadline {
        if exited?(pid) != nil {
            return
        }
        os.sleep(0.01)
    }
    os.kill(pid, os.SIGTERM)
    os.wait(pid, 0)
}

pub fn main(app: String) {
    let tmp = (getenv('TMPDIR') ?? '/tmp').comb(/\/+$/)
    let snap = "{tmp}/ink-dev-{os.getpid()}.json"
    setenv('INK_DEV_SNAP', snap)
    let sock = getenv('INK_SOCK') ?? "{tmp}/ink-{os.getpid()}.sock"
    setenv('INK_SOCK', sock)
    print("[ink.dev] control socket: {sock}")

    let lib = Path(ty.executable).parent / 'lib'
    let watchers = [
        watchfs.Watcher(Path(app).parent, recursive=true),
        watchfs.Watcher(lib),
        watchfs.Watcher(lib / 'ink')
    ]

    fn any-change?(timeout: Float) -> Bool {
        watchers.any?(w -> wait-for-change(w, timeout / float(#watchers)))
    }

    for (;;) {
        let child = os.spawn([ty.executable, app])
        let status = for (;;) {
            if any-change?(0.1) {
                stop(child.pid)
                break nil
            }
            if let $st = exited?(child.pid) {
                break st
            }
        }

        if status == 0 {
            os.exit(0)
        }

        if status != nil {
            print("[ink.dev] {app} exited with status {status}; waiting for changes...")
            while !any-change?(1.0) {
                ;
            }
        }
    }
}

if let [$app, *_] = argv {
    main(app)
}
