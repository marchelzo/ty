import ink (..)
import term
import zlib
import base64
import math
import path (Path)
import ink.image.png as png
import ink.image.gif as gif
import ink.image.bmp as bmp

pub import ink.image.raster as raster (Picture, Frame, ImageError)
pub import ink.image.glyphs (PRESETS, glyphs)

pub fn decode(data: Blob) -> Picture {
    match data {
        _ and #data >= 8 && data[;8] == png.SIGNATURE        => png.decode(data),
        _ and #data >= 6 && data[;3].str!() == 'GIF'         => gif.decode(data),
        _ and #data >= 2 && data[;2].str!() == 'BM'          => bmp.decode(data),
        _ => throw ImageError('unrecognized image format (expected PNG, GIF, or BMP)')
    }
}

pub fn load(src: String | Path) -> Picture {
    let data = try {
        slurp("{src}")
    } catch e: OSError {
        throw ImageError("{src}: {e}")
    }
    decode(Blob(data ?? throw ImageError("{src}: cannot read file")))
}

pub class Options {
    chars:   String
    bg?:     Bool
    texture: Float
    key?:    Bool
    crop?:   Bool
    term:    (Int, Int, Int)
    samples: (Int, Int)

    init(
        chars:   String          = 'blocks',
        bg?:     Bool            = true,
        texture: Float           = 0.0,
        key?:    Bool            = true,
        crop?:   Bool            = true,
        term:    (Int, Int, Int) = (0, 0, 0),
        samples: (Int, Int)      = (12, 24)
    ) {
        self.chars   = chars
        self.bg?     = bg?
        self.texture = texture
        self.key?    = key?
        self.crop?   = crop?
        self.term    = term
        self.samples = samples
    }

    __str__() -> String {
        "{chars}|{bg?}|{texture}|{key?}|{crop?}|{term}|{samples}"
    }
}

pub class Cut {
    rgba:   Blob
    stride: Int
    x:      Int
    y:      Int
    w:      Int
    h:      Int

    init(rgba: Blob, stride: Int, x: Int, y: Int, w: Int, h: Int) {
        self.rgba   = rgba
        self.stride = stride
        self.x      = x
        self.y      = y
        self.w      = w
        self.h      = h
    }

    box -> Array[Int] { [x, y, w, h] }

    whole? -> Bool { x == 0 && y == 0 && w == stride && #rgba == w * h * 4 }
}

fn median(hist: Array[Int], base: Int, n: Int) -> Int {
    let seen = 0
    for v in ..256 {
        seen += hist[base + v]
        if 2 * seen > n {
            return v
        }
    }
    255
}

pub fn key(rgba: Blob, w: Int, h: Int, t0: Float = 10.0, t1: Float = 40.0) -> Blob | nil {
    let hist = [0 for ..768]
    let n = raster.border-histogram(rgba, w, h, hist)
    let (r, g, b) = (median(hist, 0, n), median(hist, 256, n), median(hist, 512, n))
    if float(raster.border-near(rgba, w, h, r, g, b, t0)) < 0.6 * float(n) {
        return nil
    }
    let out = Blob(rgba)
    let mark = raster.zeros(w * h)
    raster.flood-border(out, w, h, r, g, b, t1, mark, raster.zeros(4 * w * h))
    raster.unblend(out, w * h, r, g, b, t0, t1, mark)
    out
}

pub fn cut(pic: Picture, frame: Frame, key?: Bool, crop?: Bool) -> Cut {
    let (w, h) = (pic.width, pic.height)
    let rgba = (key? ? key(frame.rgba, w, h) : nil) ?? frame.rgba
    let bb = [0, 0, w, h]
    if crop? && pic.animated? {
        bb = pic.extent()
    } else if crop? {
        raster.alpha-box(rgba, w, h, 12, bb)
    }
    let [x0, y0, x1, y1] = bb
    (x1 > x0 && y1 > y0) ? Cut(rgba, w, x0, y0, x1 - x0, y1 - y0) : Cut(rgba, w, 0, 0, w, h)
}

pub fn cell-pixels() -> (Int, Int) {
    match term.cell-size(1) {
        (0, _) or (_, 0) => (8, 16),
        size             => size
    }
}

pub fn fit(
    pw: Int, ph: Int,
    width: Int | nil = nil, height: Int | nil = nil,
    max-w: Int = INF, max-h: Int = INF,
    cell: (Int, Int) = cell-pixels()
) -> (Int, Int) {
    let (cw, ch) = cell
    let aspect = float(ph * cw) / float(max(pw * ch, 1))
    let (cols, rows) = match (width, height) {
        ($w, $h) => (w, h),
        ($w, _)  => (w, int(float(w) * aspect + 0.5)),
        (_, $h)  => (int(float(h) / aspect + 0.5), h),
        _        => ((pw + cw - 1) / cw, (ph + ch - 1) / ch)
    }
    if cols > max-w {
        rows = int(float(rows) * float(max-w) / float(cols) + 0.5)
        cols = max-w
    }
    if rows > max-h {
        cols = int(float(cols) * float(max-h) / float(rows) + 0.5)
        rows = max-h
    }
    (max(cols, 1), max(rows, 1))
}

fn sgr(code: Int, c: Int) -> String {
    let (r, g, b) = raster.rgb(c)
    "\x1b[{code};2;{r};{g};{b}m"
}

fn emit(g: _, cols: Int, rows: Int, idx: Array[Int], fgs: Array[Int], bgs: Array[Int]) -> Array[String] {
    let lines = []
    for row in ..rows {
        let line = Blob()
        let (cf, cb) = (-1, -1)
        for i in row * cols..(row + 1) * cols {
            let k = idx[i]
            let (ch, f, b) = match (g.full?[k], g.empty?[k], fgs[i], bgs[i]) {
                (true, _, f, b) and b >= 0 => (' ', -1, f),
                (_, true, _, b)            => (' ', -1, b),
                (_, _, f, b) and f == b    => (' ', -1, b),
                (_, _, f, b)               => (g.chars[k], f, b)
            }
            if b != cb {
                line.push((b < 0) ? "\x1b[49m" : sgr(48, b))
                cb = b
            }
            if f >= 0 && f != cf {
                line.push(sgr(38, f))
                cf = f
            }
            line.push(ch)
        }
        line.push("\x1b[0m")
        lines.push(line.str!())
    }
    lines
}

fn sinc(x: Float) -> Float {
    (x == 0.0) ? 1.0 : math.sin(x * math.pi) / (x * math.pi)
}

fn lanczos(x: Float) -> Float {
    (-3.0 <= x && x < 3.0) ? sinc(x) * sinc(x / 3.0) : 0.0
}

pub fn coefficients(n: Int, out: Int) -> (Array[Int], Array[Int], Array[Float], Int) {
    let scale = float(n) / float(out)
    let fs = max(scale, 1.0)
    let support = 3.0 * fs
    let taps = int(support.ceil) * 2 + 1
    let starts = []
    let counts = []
    let weights = []
    for o in ..out {
        let center = (float(o) + 0.5) * scale
        let lo = max(int(center - support + 0.5), 0)
        let hi = min(int(center + support + 0.5), n)
        let ws = [lanczos((float(x + lo) - center + 0.5) / fs) for x in ..hi - lo]
        let total = ws.sum(0.0)
        starts.push(lo)
        counts.push(#ws)
        weights += [(total != 0.0) ? w / total : w for w in ws]
        weights += [0.0 for ..taps - #ws]
    }
    (starts, counts, weights, taps)
}

fn reduce(c: Cut, gw: Int, gh: Int) -> Cut {
    let fx = max(c.w / gw, 1)
    let fy = max(c.h / gh, 1)
    if fx == 1 && fy == 1 {
        return c
    }
    let (w, h) = (c.w / fx, c.h / fy)
    let dst = raster.zeros(w * h * 4)
    raster.box-reduce(c.rgba, c.stride, c.x, c.y, fx, fy, dst, w, h, raster.LINEAR, raster.GAMMA)
    Cut(dst, w, 0, 0, w, h)
}

pub fn grid(c: Cut, gw: Int, gh: Int) -> Blob {
    let src = reduce(c, gw, gh)
    let (xs, xn, xw, xt) = coefficients(src.w, gw)
    let (ys, yn, yw, yt) = coefficients(src.h, gh)
    let tmp = raster.zeros(src.h * gw * 8)
    let out = raster.zeros(gh * gw * 8)
    raster.lanczos-rows(src.rgba, src.stride, src.x, src.y, src.h, xs, xn, xw, xt, gw, raster.LINEAR, tmp)
    raster.lanczos-cols(tmp, gw, ys, yn, yw, yt, gh, out)
    out
}

pub fn text(c: Cut, cols: Int, rows: Int, opts: Options = Options()) -> Array[String] {
    let (sw, sh) = opts.samples
    let g = glyphs(opts.chars, sw, sh)
    let n = sw * sh
    let (tr, tg, tb) = opts.term
    let idx = [0 for ..cols * rows]
    let fgs = [0 for ..cols * rows]
    let bgs = [0 for ..cols * rows]
    raster.fit-cells(
        grid(c, cols * sw, rows * sh), [cols, rows, sw, sh], raster.GAMMA,
        [float(tr), float(tg), float(tb), raster.LINEAR[tr], raster.LINEAR[tg], raster.LINEAR[tb]],
        g.basis, g.atoms, g.offs, g.ids,
        g.stats, g.count, opts.bg?, opts.texture,
        [0.0 for ..n * 3], [0.0 for ..n], [0.0 for ..4 * g.atoms], [0.0 for ..7],
        idx, fgs, bgs
    )
    emit(g, cols, rows, idx, fgs, bgs)
}

pub fn scale(c: Cut, w: Int, h: Int) -> Blob {
    if c.whole? && w == c.w && h == c.h {
        return c.rgba
    }
    let dst = raster.zeros(w * h * 4)
    raster.resample(c.rgba, c.stride, c.x, c.y, c.w, c.h, dst, w, h, raster.LINEAR, raster.GAMMA, [0.0 for ..4])
    dst
}

pub ns kitty {
    const PLACEHOLDER = chr(0x10EEEE)

    const RUNS = [
        (0x0305, 0x0305), (0x030D, 0x030E), (0x0310, 0x0310), (0x0312, 0x0312), (0x033D, 0x033F),
        (0x0346, 0x0346), (0x034A, 0x034C), (0x0350, 0x0352), (0x0357, 0x0357), (0x035B, 0x035B),
        (0x0363, 0x036F), (0x0483, 0x0487), (0x0592, 0x0595), (0x0597, 0x0599), (0x059C, 0x05A1),
        (0x05A8, 0x05A9), (0x05AB, 0x05AC), (0x05AF, 0x05AF), (0x05C4, 0x05C4), (0x0610, 0x0617),
        (0x0657, 0x065B), (0x065D, 0x065E), (0x06D6, 0x06DC), (0x06DF, 0x06E2), (0x06E4, 0x06E4),
        (0x06E7, 0x06E8), (0x06EB, 0x06EC), (0x0730, 0x0730), (0x0732, 0x0733), (0x0735, 0x0736),
        (0x073A, 0x073A), (0x073D, 0x073D), (0x073F, 0x0741), (0x0743, 0x0743), (0x0745, 0x0745),
        (0x0747, 0x0747), (0x0749, 0x074A), (0x07EB, 0x07F1), (0x07F3, 0x07F3), (0x0816, 0x0819),
        (0x081B, 0x0823), (0x0825, 0x0827), (0x0829, 0x082D), (0x0951, 0x0951), (0x0953, 0x0954),
        (0x0F82, 0x0F83), (0x0F86, 0x0F87), (0x135D, 0x135F), (0x17DD, 0x17DD), (0x193A, 0x193A),
        (0x1A17, 0x1A17), (0x1A75, 0x1A7C), (0x1B6B, 0x1B6B), (0x1B6D, 0x1B73), (0x1CD0, 0x1CD2),
        (0x1CDA, 0x1CDB), (0x1CE0, 0x1CE0), (0x1DC0, 0x1DC1), (0x1DC3, 0x1DC9), (0x1DCB, 0x1DCC),
        (0x1DD1, 0x1DE6), (0x1DFE, 0x1DFE), (0x20D0, 0x20D1), (0x20D4, 0x20D7), (0x20DB, 0x20DC),
        (0x20E1, 0x20E1), (0x20E7, 0x20E7), (0x20E9, 0x20E9), (0x20F0, 0x20F0), (0x2CEF, 0x2CF1),
        (0x2DE0, 0x2DFF), (0xA66F, 0xA66F), (0xA67C, 0xA67D), (0xA6F0, 0xA6F1), (0xA8E0, 0xA8F1),
        (0xAAB0, 0xAAB0), (0xAAB2, 0xAAB3), (0xAAB7, 0xAAB8), (0xAABE, 0xAABF), (0xAAC1, 0xAAC1),
        (0xFE20, 0xFE26), (0x10A0F, 0x10A0F), (0x10A38, 0x10A38), (0x1D185, 0x1D189), (0x1D1AA, 0x1D1AD),
        (0x1D242, 0x1D244)
    ]

    pub DIACRITICS = [chr(cp) for (lo, hi) in RUNS for cp in lo...hi]

    pub supported? = match getenv('INK_KITTY') {
        /^(?:0|no|false)/i => false,
        /^(?:1|yes|true)/i => true,
        _ => do {
            let tp = getenv('TERM_PROGRAM') ?? ''
            let tm = getenv('TERM') ?? ''
            (
                (tp == 'ghostty')
             || (tm == 'xterm-ghostty')
             || (tm == 'xterm-kitty')
             || !!getenv('KITTY_WINDOW_ID')
            )
        }
    }

    pub fn lines(id: Int, cols: Int, rows: Int) -> Array[String] {
        let pen = sgr(38, id)
        [
            "{pen}{[PLACEHOLDER + DIACRITICS[r] + DIACRITICS[c] for c in ..cols].join('')}\x1b[39m"
            for r in ..rows
        ]
    }

    pub fn transmit(rgba: Blob, w: Int, h: Int, id: Int, cols: Int, rows: Int) -> String {
        let payload = base64.encode(zlib.compress(rgba))
        let size = payload.size()
        let out = Blob()
        let i = 0
        while i < size {
            let end = min(i + 4096, size)
            let more = (end < size) ? 1 : 0
            if i == 0 {
                out.push("\x1b_Ga=T,U=1,q=2,f=32,o=z,s={w},v={h},i={id},c={cols},r={rows},m={more};")
            } else {
                out.push("\x1b_Gm={more};")
            }
            out.push(payload.bslice(i, end - i))
            out.push("\x1b\\")
            i = end
        }
        out.str!()
    }

    pub fn delete(id: Int) -> String {
        "\x1b_Ga=d,d=I,i={id},q=2\x1b\\"
    }

    pub fn fresh-id() -> Int {
        rand(1 << 16, 1 << 24)
    }

    pub fn encode(c: Cut, id: Int, cols: Int, rows: Int, cell: (Int, Int)) -> String {
        let (cw, ch) = cell
        let k = min(float(cols * cw) / float(c.w), float(rows * ch) / float(c.h), 1.0)
        let w = max(int(float(c.w) * k + 0.5), 1)
        let h = max(int(float(c.h) * k + 0.5), 1)
        transmit(scale(c, w, h), w, h, id, cols, rows)
    }
}

pub fn protocol() -> String {
    kitty.supported? ? 'kitty' : 'text'
}

fn terminal-background() -> (Int, Int, Int) {
    background-rgb() ?? (0, 0, 0)
}

pub class Image < Component {
    src:      String | Path | Blob | Picture | nil
    protocol: String | nil
    chars:    String | nil
    term-bg:  String | nil
    bg?:      Bool | nil
    texture:  Float | nil
    key?:     Bool | nil
    crop?:    Bool | nil
    animate?: Bool | nil
    samples:  (Int, Int) | nil
    variant:  String | nil

    __source:  _                           = nil
    __picture: Picture | nil               = nil
    __error:   String | nil                = nil
    __frame:   Int                         = 0
    __id:      Int                         = 0
    __shown:   String | nil                = nil
    __cuts:    Dict[String, Cut]           = %{}
    __lines:   Dict[String, Array[String]] = %{}
    __uploads: Dict[String, String]        = %{}

    mount() {
        __schedule()
    }

    unmount() {
        if __shown != nil {
            kitty-upload(kitty.delete(__id))
            __shown = nil
        }
    }

    __schedule() {
        let $pic = __load() or return
        if !(animate? ?? true) || !pic.animated? {
            return
        }
        let delay = max(pic.frames[__frame % #pic.frames].delay, 0.02)
        after(delay, () -> __advance())
    }

    __advance() {
        let $pic = __picture or return
        __frame = (__frame + 1) % #pic.frames
        notify()
        __schedule()
    }

    __load() -> Picture | nil {
        if __source != src || (__picture == nil && __error == nil) {
            __source  = src
            __frame   = 0
            __cuts    = %{}
            __lines   = %{}
            __uploads = %{}
            __shown   = nil
            __error   = nil
            __picture = try {
                match src {
                    p: Picture => p,
                    b: Blob    => decode(b),
                    nil        => nil,
                    s          => load(s)
                }
            } catch e: ImageError {
                __error = e.what
                nil
            }
        }
        __picture
    }

    __mode() -> String {
        match protocol {
            $p and (p == 'kitty' || p == 'text') => p,
            _                                    => kitty.supported? ? 'kitty' : 'text'
        }
    }

    __options(mode: String) -> Options {
        let term = match term-bg {
            $c => resolve-color-rgb(c),
            _  => terminal-background()
        }
        Options(
            chars   = chars ?? 'blocks',
            bg?     = bg? ?? true,
            texture = texture ?? 0.0,
            key?    = key? ?? (mode == 'text'),
            crop?   = crop? ?? true,
            term    = term,
            samples = samples ?? (12, 24)
        )
    }

    __cut(pic: Picture, opts: Options) -> Cut {
        let k = "{__frame}|{opts.key?}|{opts.crop?}"
        __cuts[k] ?? (__cuts[k] = cut(pic, pic.frames[__frame], opts.key?, opts.crop?))
    }

    render() -> Node {
        let $pic = __load() or return Text(look=part('Image', 'error', [], variant), __error ?? '')
        let mode = __mode()
        let opts = __options(mode)
        let cell = cell-pixels()
        let first = __cut(pic, opts)
        let (cols, rows) = fit(first.w, first.h, width, height, layout-max-w, layout-max-h, cell)
        let k = "{mode}|{__frame}|{cols}x{rows}|{opts}"
        if mode == 'kitty' {
            __id = (__id == 0) ? kitty.fresh-id() : __id
            let escape = __uploads[k] ?? (__uploads[k] = kitty.encode(first, __id, cols, rows, cell))
            if __shown != k {
                kitty-upload(escape)
                __shown = k
            }
            return Raw(__lines["kitty|{cols}x{rows}"] ?? (__lines["kitty|{cols}x{rows}"] = kitty.lines(__id, cols, rows)), cols)
        }
        Raw(__lines[k] ?? (__lines[k] = text(first, cols, rows, opts)), cols)
    }
}
