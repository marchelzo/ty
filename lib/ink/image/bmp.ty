import jit (kernel!)
import ink.image.raster (Picture, Frame, ImageError, zeros)

kernel! fn field(v: Int, mask: Int, shift: Int, top: Int) -> Int {
    (top == 0) ? 0 : ((v & mask) >> shift) * 255 / top
}

kernel! fn put(dst: Blob, o: Int, pal: Blob, c: Int) {
    let i = (c & 255) * 4
    dst[o]     = pal[i]
    dst[o + 1] = pal[i + 1]
    dst[o + 2] = pal[i + 2]
    dst[o + 3] = 255
}

kernel! fn rows(
    src: Blob, off: Int, w: Int, h: Int, bpp: Int, stride: Int, top-down: Bool,
    pal: Blob, masks: Array[Int], dst: Blob
) {
    for y in ..h {
        let row = off + (top-down ? y : h - 1 - y) * stride
        if row + stride > #src {
            continue
        }
        let out = y * w * 4
        for x in ..w {
            let o = out + x * 4
            if bpp <= 8 {
                let bit = x * bpp
                put(dst, o, pal, (src[row + (bit >> 3)] >> (8 - bpp - (bit & 7))) & ((1 << bpp) - 1))
            } else if bpp == 24 {
                let p = row + x * 3
                dst[o]     = src[p + 2]
                dst[o + 1] = src[p + 1]
                dst[o + 2] = src[p]
                dst[o + 3] = 255
            } else {
                let p = row + x * (bpp / 8)
                let v = src[p] | (src[p + 1] << 8)
                if bpp == 32 {
                    v = v | (src[p + 2] << 16) | (src[p + 3] << 24)
                }
                dst[o]     = field(v, masks[0], masks[4], masks[8])
                dst[o + 1] = field(v, masks[1], masks[5], masks[9])
                dst[o + 2] = field(v, masks[2], masks[6], masks[10])
                dst[o + 3] = (masks[3] == 0) ? 255 : field(v, masks[3], masks[7], masks[11])
            }
        }
    }
}

kernel! fn rle(src: Blob, i: Int, w: Int, h: Int, four: Bool, pal: Blob, dst: Blob) {
    let x = 0
    let y = 0
    while i + 1 < #src && y < h {
        let n = src[i]
        let v = src[i + 1]
        i += 2
        if n > 0 {
            for k in ..n {
                let c = four ? (((k & 1) == 0) ? v >> 4 : v & 15) : v
                if x < w {
                    put(dst, ((h - 1 - y) * w + x) * 4, pal, c)
                }
                x += 1
            }
        } else if v == 0 {
            x = 0
            y += 1
        } else if v == 1 {
            return
        } else if v == 2 {
            if i + 1 >= #src {
                return
            }
            x += src[i]
            y += src[i + 1]
            i += 2
        } else {
            let bytes = four ? (v + 1) / 2 : v
            for k in ..v {
                if i + (four ? k / 2 : k) >= #src {
                    return
                }
                let b = src[i + (four ? k / 2 : k)]
                let c = four ? (((k & 1) == 0) ? b >> 4 : b & 15) : b
                if x < w {
                    put(dst, ((h - 1 - y) * w + x) * 4, pal, c)
                }
                x += 1
            }
            i += bytes + (bytes & 1)
        }
    }
}

fn u16(b: Blob, i: Int) -> Int { b[i] | (b[i + 1] << 8) }

fn u32(b: Blob, i: Int) -> Int { u16(b, i) | (u16(b, i + 2) << 16) }

fn i32(b: Blob, i: Int) -> Int {
    let v = u32(b, i)
    (v >= (1 << 31)) ? v - (1 << 32) : v
}

fn shift-of(mask: Int) -> (Int, Int) {
    if mask == 0 {
        return (0, 0)
    }
    let s = 0
    while ((mask >> s) & 1) == 0 {
        s += 1
    }
    (s, mask >> s)
}

fn default-masks(bpp: Int) -> Array[Int] {
    (bpp == 16) ? [0x7C00, 0x3E0, 0x1F, 0] : [0xFF0000, 0xFF00, 0xFF, 0]
}

pub fn decode(data: Blob) -> Picture {
    if #data < 26 || data[;2].str!() != 'BM' {
        throw ImageError('BMP: bad signature')
    }
    let off = u32(data, 10)
    let hs = u32(data, 14)
    let core? = hs == 12
    let w = core? ? u16(data, 18) : i32(data, 18)
    let raw-h = core? ? u16(data, 20) : i32(data, 22)
    let bpp = core? ? u16(data, 24) : u16(data, 28)
    let compression = core? ? 0 : u32(data, 30)
    let h = raw-h.abs
    if w <= 0 || h == 0 || bpp not in [1, 2, 4, 8, 16, 24, 32] {
        throw ImageError("BMP: unsupported geometry {w}x{raw-h} at {bpp} bpp")
    }
    let fields? = compression in [3, 6]
    let masks = match (fields?, hs) {
        (true, 40) => [u32(data, 54), u32(data, 58), u32(data, 62), compression == 6 ? u32(data, 66) : 0],
        (true, _)  => [u32(data, 54), u32(data, 58), u32(data, 62), hs >= 56 ? u32(data, 66) : 0],
        _          => default-masks(bpp)
    }
    let shifts = masks.map(shift-of)
    let entry = core? ? 3 : 4
    let pal-at = 14 + hs + ((fields? && hs == 40) ? (compression == 6 ? 16 : 12) : 0)
    let used = core? ? 0 : u32(data, 46)
    let count = min((used > 0) ? used : ((bpp <= 8) ? 1 << bpp : 0), 256, max((off - pal-at) / entry, 0))
    let pal = zeros(1024)
    for i in ..count {
        let p = pal-at + i * entry
        pal[i * 4]     = data[p + 2]
        pal[i * 4 + 1] = data[p + 1]
        pal[i * 4 + 2] = data[p]
        pal[i * 4 + 3] = 255
    }
    let dst = zeros(w * h * 4)
    match compression {
        0 or 3 or 6 => rows(
            data, off, w, h, bpp, (w * bpp + 31) / 32 * 4, raw-h < 0, pal,
            [*masks, *shifts.map(&0), *shifts.map(&1)], dst
        ),
        1 or 2 => rle(data, off, w, h, compression == 2, pal, dst),
        _ => throw ImageError("BMP: unsupported compression {compression}")
    }
    Picture(w, h, [Frame(dst)], 'bmp')
}
