import os (stat)

pub class LookError < RuntimeError {
    msg: String

    init(msg: String) {
        self.msg = msg
    }

    what -> String { msg }
}

const INT_PROPS: Set[String] = %[
    'pad-x', 'pad-y', 'padding', 'gap', 'row-gap', 'column-gap',
    'pad-top', 'pad-right', 'pad-bottom', 'pad-left',
    'margin', 'margin-x', 'margin-y',
    'margin-top', 'margin-right', 'margin-bottom', 'margin-left',
    'width', 'height', 'min-width', 'max-width', 'min-height', 'max-height',
    'flex', 'shrink', 'basis', 'max-lines'
]
const PCT_PROPS: Set[String] = %['width', 'height', 'min-width', 'max-width', 'min-height', 'max-height', 'basis']
const BOOL_PROPS: Set[String] = %['bold', 'italic', 'underline', 'dim', 'reverse']
const STR_PROPS: Set[String] = %['fg', 'bg', 'border-color', 'border-left', 'content', 'text', 'overflow-note', 'overflow-note-color']
const ENUM_PROPS: Dict[String, Set[String]] = %{
    'content-visibility': %['auto', 'visible'],
    'scroll-snap': %['none', 'start'],
    'border':    %['none', 'single', 'double', 'round', 'bold'],
    'align':     %['start', 'center', 'end', 'stretch'],
    'text-align': %['start', 'center', 'end'],
    'align-self': %['start', 'center', 'end', 'stretch'],
    'flex-wrap': %['wrap', 'nowrap'],
    'display':   %['none', 'flex', 'table', 'columns'],
    'overflow':  %['hidden', 'scroll'],
    'text-overflow': %['clip', 'ellipsis', 'ellipsis-start'],
    'visibility': %['visible', 'hidden'],
    'scroll-anchor': %['start', 'end'],
    'line-fill': %['none', 'bg'],
    'justify':   %['start', 'center', 'end', 'space-between', 'space-around', 'space-evenly'],
    'direction': %['row', 'column'],
    'wrap':      %['word', 'pre-wrap', 'truncate', 'none'],
    'shape':     %[
        'reverse', 'terminal', 'block', 'underline', 'bar',
        'blinking-block', 'blinking-underline', 'blinking-bar'
    ]
}

pub PARTS: Dict[String, (Array[String], Array[String])] = %{
    'Select':        (['frame', 'item', 'indicator'], ['focused', 'selected']),
    'Checkbox':      (['icon', 'label'], ['focused', 'checked']),
    'Card':          (['frame'], ['focused']),
    'StatusBar':     (['bar', 'text'], []),
    'ProgressBar':   (['fill', 'track', 'pct'], ['done']),
    'Spinner':       (['frame', 'label'], []),
    'Divider':       (['line', 'title'], []),
    'Badge':         (['label'], []),
    'SectionHeader': (['title'], []),
    'Toast':         (['icon', 'text'], []),
    'TextInput':     (['frame', 'prompt', 'text', 'placeholder', 'cursor', 'popup', 'popup-item'], ['focused']),
    'TextArea':      (['frame', 'text', 'placeholder', 'cursor'], ['focused']),
    'SuggestionList': (['frame', 'grid', 'item', 'marker', 'label', 'match', 'detail', 'kind', 'empty', 'scroll-up', 'scroll-down'], ['selected']),
    'Slider':        (['label', 'fill', 'thumb', 'track', 'value'], ['focused']),
    'RangeSelector': (['label', 'fill', 'thumb', 'track', 'value'], ['focused', 'active']),
    'TrackBar':      (['label', 'fill', 'thumb', 'track', 'value', 'button', 'play', 'speed'], ['focused', 'playing']),
    'ScrollView':    (['frame'], ['focused']),
    'TreeView':      (['frame', 'row', 'mark', 'guide', 'toggle', 'label', 'empty'], ['focused', 'selected', 'active', 'expanded']),
    'DatePicker':    (['header', 'weekday', 'day'], ['focused', 'today', 'selected']),
    'BarChart':      (['bar', 'axis', 'empty'], []),
    'LinePlot':      (['series', 'axis', 'selection', 'empty'], [])
}

fn check-key(key: String, line: Int) {
    match key {
        /^\.[\w-]+$/ => (),
        /^([A-Z]\w*)(?:\.([\w-]+))?::([\w-]+)((?::[\w-]+)*)$/ => do {
            let w = $1
            let p = $3
            let sts = $4
            let (parts, states) = PARTS[w] ?? throw LookError("line {line}: unknown widget '{w}' in '{key}'")
            if p not in parts {
                throw LookError("line {line}: {w} has no part '{p}' (parts: {parts.join(', ')})")
            }
            for s in sts.split(':') if #s > 0 && s not in states {
                throw LookError("line {line}: {w} has no state ':{s}' (states: {states.join(', ')})")
            }
        },
        _ => throw LookError("line {line}: bad key '{key}' (want .class or Widget[.variant]::part[:state...])")
    }
}

fn check-value(k: String, v: _, ctx: String) -> _ {
    if k in PCT_PROPS && "{v}".match?(/^\d+%$/) {
        return "{v}"
    }
    if k in INT_PROPS {
        let n = (v :: Int) ? v : int(v, 10)
        if !(n :: Int) || n < 0 {
            throw LookError("{ctx}: '{k}' wants a non-negative integer, got '{v}'")
        }
        return n
    }
    if k in BOOL_PROPS {
        match v {
            true or 'true'   => return true,
            false or 'false' => return false,
            _                => throw LookError("{ctx}: '{k}' wants true/false, got '{v}'")
        }
    }
    if let $allowed = ENUM_PROPS[k] {
        if v not in allowed {
            throw LookError("{ctx}: unknown {k} '{v}' (want {allowed.list().join('|')})")
        }
        return v
    }
    if k in STR_PROPS {
        let s = "{v}"
        if s.match?(/[\[\]]/) {
            throw LookError("{ctx}: '{k}' value may not contain brackets: '{s}'")
        }
        return s
    }
    throw LookError("{ctx}: unknown property '{k}'")
}

fn unquote(v: String) -> String {
    match v {
        /^"(.*)"$/s => $1,
        /^'(.*)'$/s => $1,
        _           => v
    }
}

fn media-key(conds: String, line: Int) -> String {
    let parts = conds.split(/\s+and\s+/).map(&trim).filter(bool)
    if #parts == 0 {
        throw LookError("line {line}: @media needs at least one condition")
    }
    let keys = parts.map(c -> do {
        let $m = c.match(/^\(\s*((?:min|max)-(?:width|height))\s*:\s*(\d+)\s*\)$/)
            or throw LookError("line {line}: bad @media condition '{c}' (want (min-width: N), (max-height: N), ...)")
        "{m[1]}:{m[2]}"
    })
    "@media {keys.join(',')}"
}

fn holds?(media: String, w: Int, h: Int) -> Bool {
    for c in media[#'@media ';].split(',') {
        let [k, v] = c.split(':')
        let n = int(v)
        let ok? = match k {
            'min-width'  => w >= n,
            'max-width'  => w <= n,
            'min-height' => h >= n,
            'max-height' => h <= n,
            _            => true
        }
        if !ok? {
            return false
        }
    }
    true
}

pub fn parse(src: String) -> Dict[String, Dict[String, _]] {
    let out: Dict[String, Dict[String, _]] = %{}
    let line = 1
    let i = 0
    let n = #src
    while i < n {
        if let $mm = src[i;].match(/^(\s*(?:#[^\n]*\n\s*)*)@media\b([^{]*)\{/s) {
            line += #mm[1].matches(/\n/)
            let key   = media-key(mm[2].trim(), line)
            let start = i + #mm[0]
            let depth = 1
            let j     = start
            while j < n && depth > 0 {
                match src[j] {
                    '{' => depth += 1,
                    '}' => depth -= 1,
                    _   => ()
                }
                j += 1
            }
            if depth > 0 {
                throw LookError("line {line}: unterminated @media block")
            }
            let inner = src[start;j - 1]
            let pad   = '\n' * (line - 1)
            for k, d in parse("{pad}{inner}") {
                if k == '@tokens' || k.starts?('@media') {
                    throw LookError("line {line}: @media blocks may only contain rules")
                }
                out["{key}|{k}"] = %{**(out["{key}|{k}"] ?? %{}), **d}
            }
            line += #src[i + #mm[1];j].matches(/\n/)
            i = j
            continue
        }
        let $m = src[i;].match(/^(\s*(?:#[^\n]*\n\s*)*)([^{}\s][^{}]*?)\s*\{((?:'[^'\n]*'|"[^"\n]*"|[^{}'"])*)\}/s) or do {
            let rest = src[i;]
            if rest.match?(/^\s*(#[^\n]*\s*)*$/) { break }
            throw LookError("line {line}: expected 'key \{ prop: value; ... \}'")
        }
        line += #m[1].matches(/\n/)
        let key-line = line
        let keys = m[2].split(/\s*,\s*/)
        let body = m[3]
        let decl: Dict[String, _] = %{}
        let dl = key-line
        for d in body.matches(/(?:'[^'\n]*'|"[^"\n]*"|[^;\n'"])*[;\n]?/).filter(bool) {
            let t = d.sub(/[;\n]$/, '').trim()
            if #t > 0 {
                let $kv = t.match(/^([\w-]+)\s*:\s*(.+)$/s)
                    or throw LookError("line {dl}: bad declaration '{t}'")
                decl[kv[1]] = (keys == ['@tokens'])
                    ? unquote(kv[2].trim())
                    : check-value(kv[1], unquote(kv[2].trim()), "line {dl}")
            }
            dl += #d.matches(/\n/)
        }
        for k in keys {
            if k == '@tokens' {
                out[k] = %{**(out[k] ?? %{}), **decl}
                continue
            }
            check-key(k, key-line)
            out[k] = %{**(out[k] ?? %{}), **decl}
        }
        line += #m[0].matches(/\n/) - #m[1].matches(/\n/)
        i += #m[0]
    }
    out
}

fn spec-of(d: Dict[String, _]) -> String | nil {
    let ps: Array[String] = []
    if let $fg = d['fg'] { ps.push(fg) }
    match d['bold'] {
        true  => ps.push('bold'),
        false => ps.push('no-bold'),
        _     => ()
    }
    match d['italic'] {
        true  => ps.push('italic'),
        false => ps.push('no-italic'),
        _     => ()
    }
    match d['underline'] {
        true  => ps.push('u'),
        false => ps.push('no-u'),
        _     => ()
    }
    if d['dim'] == true { ps.push('dim') }
    if d['reverse'] == true { ps.push('reverse') }
    if let $t = d['text'] { ps.push(t) }
    (#ps > 0) ? ps.join(' ') : nil
}

pub class Looks {
    base:   Dict[String, Dict[String, _]]
    defs:   Dict[String, Dict[String, _]]
    cache:  Dict[String, Dict[String, _]]
    epoch:  Int
    medias: Array[String]
    active: Array[String]
    w:      Int
    h:      Int

    init(base: Dict[String, Dict[String, _]]) {
        self.base = base
        defs      = base
        cache     = %{}
        epoch     = 0
        medias    = []
        active    = []
        w         = 80
        h         = 24
    }

    use(user: Dict[String, Dict[String, _]]) {
        let merged = %{**base}
        for k, d in user {
            merged[k] = %{**(merged[k] ?? %{}), **d}
        }
        defs   = merged
        medias = %[k.split('|')[0] for k in user.keys() if k.starts?('@media ')].list()
        active = medias.filter(holds?@(_, w, h))
        cache  = %{}
        epoch += 1
    }

    viewport(cols: Int, rows: Int) -> Bool {
        w = cols
        h = rows
        let now = medias.filter(holds?@(_, w, h))
        if now == active {
            return false
        }
        active = now
        cache  = %{}
        epoch += 1
        true
    }

    merge(keys: Array[String], ck: String) -> Dict[String, _] {
        let d: Dict[String, _] = %{}
        for keys {
            if let $x = defs[it] {
                for k, v in x { d[k] = v }
            }
            for m in active {
                if let $x = defs["{m}|{it}"] {
                    for k, v in x { d[k] = v }
                }
            }
        }
        d['spec'] = spec-of(d)
        cache[ck] = d
        d
    }

    classes(cls: String) -> Dict[String, _] {
        cache[cls] ?? merge(cls.words().map(\".{_}"), cls)
    }

    part(w: String, p: String, states: Array[String], variant: String | nil = nil) -> Dict[String, _] {
        let ck = "{w}|{variant}|{p}|{states}"
        if let $hit = cache[ck] { return hit }
        let keys = ["{w}::{p}", *states.map(\"{w}::{p}:{_}")]
        if variant != nil {
            keys.push("{w}.{variant}::{p}")
            for states { keys.push("{w}.{variant}::{p}:{it}") }
        }
        merge(keys, ck)
    }
}

pub class LookFile {
    path:  String
    mtime: Float
    error: String | nil

    init(path: String) {
        self.path = path
        mtime     = -1.0
        error     = nil
    }

    poll() -> Dict[String, Dict[String, _]] | nil {
        let $st = stat(path) or return nil
        if st.mtime == mtime { return nil }
        mtime = st.mtime
        try {
            let parsed = parse(slurp(path) ?? '')
            error = nil
            parsed
        } catch e: LookError {
            error = "{path}: {e.what}"
            nil
        }
    }
}

