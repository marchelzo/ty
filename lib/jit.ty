import ffi as c
import os
import jit as j
import ty
import ty.token as jt
import ty.lex as jl
import ty.parse as jp
import math

let OPS = j._ops()
let OP_SIGNATURES = j._op-signatures()

pub ARCH = j._arch()
pub OS = __apple__ ? 'macos' : (__linux__ ? 'linux' : 'freebsd')

pub class Error < RuntimeError {
    op: Int;
    span: (Int, Int, Int);

    init(message: String, op: Int = -1, span: (Int, Int, Int) = (0, 0, 0)) {
        super(message)
        self.op = op
        self.span = span
    }
}

fn check-error(error: Any) {
    if let (message: String, op: Int, source: Int, start: Int, end: Int) = error {
        throw Error(message, op, (source, start, end))
    }
}

pub class Type {
    code: Int;
    name: String;
    cls: Int;
    size: Int;

    init(code: Int, name: String, cls: Int, size: Int) {
        self.code = code
        self.name = name
        self.cls = cls
        self.size = size
    }

    __str__() -> String { name }
}

pub VOID = Type(0, 'void', -1, 0)
pub I8   = Type(1, 'i8', 1, 1)
pub U8   = Type(2, 'u8', 1, 1)
pub I16  = Type(3, 'i16', 1, 2)
pub U16  = Type(4, 'u16', 1, 2)
pub I32  = Type(5, 'i32', 0, 4)
pub U32  = Type(6, 'u32', 0, 4)
pub I64  = Type(7, 'i64', 1, 8)
pub U64  = Type(8, 'u64', 1, 8)
pub F32  = Type(9, 'f32', 2, 4)
pub F64  = Type(10, 'f64', 3, 8)
pub BOOL = Type(11, 'bool', 1, 1)
pub PTR  = Type(12, 'ptr', 4, 8)
pub REF  = Type(13, 'ref', 5, 8)
pub VAL  = Type(14, 'val', 4, 32)

let TYPES = [VOID, I8, U8, I16, U16, I32, U32, I64, U64,
             F32, F64, BOOL, PTR, REF, VAL]
let CLASSES = [I32, I64, F32, F64, PTR, REF]

pub EQ  = 0
pub NE  = 1
pub LT  = 2
pub LE  = 3
pub GT  = 4
pub GE  = 5
pub ULT = 6
pub ULE = 7
pub UGT = 8
pub UGE = 9
pub FEQ = 10
pub FNE = 11
pub FLT = 12
pub FLE = 13
pub FGT = 14
pub FGE = 15
pub FUN = 16

pub MAY_GC = 1
pub MAY_THROW = 2
pub RETURNS_TWICE = 4
pub NORETURN = 8
pub SITE = 16

pub layout = j._layout()

pub `tag` = j._tags()

class Capstone {
    __version: Int;
    __open: (Int, Int, Ptr[Any]) -> Int;
    __close: Ptr[Any] -> Int;
    __decode: (Int, Ptr[Any], Int, Int, Int, Ptr[Any]) -> Int;
    __free: (Ptr[Any], Int) -> Any;

    init(lib: Ptr[Any], version: Int) {
        __version = version
        __open = c.wrap(lib, 'cs_open', c.i32, c.i32, c.i32, c.ptr)
        __close = c.wrap(lib, 'cs_close', c.i32, c.ptr)
        __decode = c.wrap(lib, 'cs_disasm', c.u64, c.u64, c.ptr,
                          c.u64, c.u64, c.u64, c.ptr)
        __free = c.wrap(lib, 'cs_free', c.void, c.ptr, c.u64)
    }

    instruction(p: Ptr[Any], version: Int) -> (Int, String) {
        let size-off = version == 6 ? 24 : 16
        let text-off = match version {
            4 => 34,
            5 => 42,
            6 => 50,
        }
        let size = c.load(c.u16, p + size-off)
        let name = c.str(p + text-off)
        let args = c.str(p + text-off + 32)
        (size, args == '' ? name : "{name} {args}")
    }

    dis(p: Ptr[Any], size: Int) -> Array[(Int, String)] | nil {
        let handle = c.box(c.u64, 0)
        defer c.free(handle)
        let x64-arch = __version == 6 ? 4 : 3
        let arch = ARCH == 'arm64' ? 1 : x64-arch
        let mode = ARCH == 'arm64' ? 0 : 8
        if __open(arch, mode, handle) != 0 {
            return nil
        }
        defer __close(handle)
        let out = c.box(c.ptr, nil)
        defer c.free(out)
        let lines = []
        let offset = 0
        while offset < size {
            if __decode(handle[0], p + offset, size - offset,
                        offset, 1, out) == 0 {
                return nil
            }
            let insn = out[0]
            let (n, text) = instruction(insn, __version)
            __free(insn, 1)
            if n <= 0 || n > size - offset {
                return nil
            }
            lines.push((offset, text))
            offset += n
        }
        lines
    }
}

fn open-capstone() -> Capstone | nil {
    let $lib = c.open('capstone', [nil, 5, 4, 6]) or return nil
    let version = c.wrap(lib, 'cs_version', c.u32, c.ptr, c.ptr)
    let major = version(nil, nil) >> 8
    if major in [4, 5, 6] {
        return Capstone(lib, major)
    }
}

let __tls::capstone: Capstone | Bool | nil = nil

fn objdump(bytes: Blob) -> Array[(Int, String)] | nil {
    let machine = ARCH == 'arm64' ? ['-maarch64'] : ['-mi386:x86-64', '-M', 'intel']
    let file = "{os.getenv('TMPDIR') ?? '/tmp'}/ty-jit-{os.getpid()}.bin"
    let fd = os.open(file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    if fd < 0 {
        return nil
    }
    os.write(fd, bytes)
    os.close(fd)
    defer os.unlink(file)
    let child = try {
        os.spawn(['objdump', '-D', '-b', 'binary', *machine, file],
                 stdout: os.SPAWN_PIPE, stderr: os.SPAWN_NULL)
    } catch _ {
        return nil
    }
    let out = Blob()
    while let $chunk = os.read(child.stdout, 65536) {
        out.push(chunk)
    }
    os.close(child.stdout)
    os.wait(child.pid)
    let lines = []
    for out.str!().lines() {
        if let [_, off, text] = /^\s*([0-9a-f]+):\t(?:[0-9a-f]{2} )+\s*\t(.*)$/(it) {
            lines.push((int("0x{off}"), text.replace(/\s+/, ' ')))
        }
    }
    #lines > 0 ? lines : nil
}

fn disassemble(p: Ptr[Any], bytes: Blob) -> Array[(Int, String)] {
    let decoder = capstone ?? (capstone = open-capstone() ?? false)
    if let cs: Capstone = decoder and let $lines = cs.dis(p, #bytes) {
        return lines
    }
    if let $lines = objdump(bytes) {
        return lines
    }
    let xs = bytes.list()
    [(i, xs[i;i+16].map(it -> "{it:02x}").join(' ')) for i in (0..#xs)[;;16]]
}

pub class Code {
    __handle: Ptr[Any];

    init(handle: Ptr[Any]) { __handle = handle }

    size -> Int { j._code-size(__handle) }

    lir() -> String { j._code-lir(__handle) }

    dis() -> String {
        let bytes = j._code-bytes(__handle)
        let lines = disassemble(j._ptr(__handle), bytes)
        for (pc, site-id) in j._code-sites(__handle) {
            lines.push((pc, "site {site-id}"))
        }
        ["{pc:04x}: {text}" for (pc, text) in lines.sort(by: &0)]
            .join('\n')
    }
}

pub class Fn < Function {
    ptr -> Ptr[Any] { j._ptr(self) }
    code -> Code { Code(j._code(self)) }
    name -> String { j._name(self) }

    sig -> {params: Array[Type], ret: Type, nfixed: Int,
            variadic?: Bool} {
        let (r, ps, fixed, var?, _) = j._sig(self)
        return {params: [TYPES[it] for ps], ret: TYPES[r],
                nfixed: fixed, variadic?: var?}
    }
}

pub class Encoding {
    bytes: Blob;
    ninputs: Int;
    captures: Array[Array[Any]];

    init(bytes: Blob, ninputs: Int = 0,
         captures: Array[Array[Any]] = []) {
        self.bytes = bytes
        self.ninputs = ninputs
        self.captures = captures
    }
}

pub class Hole {
    kind: Int;
    id: Int;
    type: Type;

    init(id: Int, type: Type, callee?: Bool = false) {
        self.id = id
        self.type = type
        kind = hole-kind(type, callee?)
    }

    encode() -> Array[Any] { [kind, id] }
}

fn hole-kind(type: Type, callee?: Bool) -> Int {
    if callee? {
        return 16
    }
    match type.code {
        9 or 10 => 13,
        12 => 14,
        14 => 15,
        1 or 2 or 3 or 4 or 5 or 6 or 7 or 8 or 11 => 12,
        _ => throw Error('unsupported hole type'),
    }
}

pub class Label {
    asm: Asm;
    id: Int;

    init(asm: Asm, id: Int) {
        self.asm = asm
        self.id = id
    }
}

pub class Mem {
    base: Reg;
    index: Reg | nil;
    scale: Int;
    disp: Int;
    type: Type;

    init(base: Reg, index: Reg | nil, scale: Int, disp: Int, type: Type) {
        self.base = base
        self.index = index
        self.scale = scale
        self.disp = disp
        self.type = type
    }

    encode(asm: Asm) -> Array[Any] {
        reg-operand(asm, base)
        if let r: Reg = index {
            reg-operand(asm, r)
        }
        [4, base.id, index.?id ?? -1, scale, disp, type.code]
    }
}

pub class Reg {
    asm: Asm;
    id: Int;
    type: Type;

    init(asm: Asm, id: Int, type: Type) {
        self.asm = asm
        self.id = id
        self.type = type
    }

    set(value: Any) { asm.move(self, value) }

    off(type: Type, disp: Int = 0) -> Mem {
        Mem(self, nil, 1, disp, type)
    }

    at(type: Type, index: Reg | Int, disp: Int = 0) -> Mem {
        match index {
            n: Int => off(type, disp + n * type.size),
            r: Reg => indexed-memory(self, type, r, disp),
        }
    }
}

fn indexed-memory(base: Reg, type: Type, index: Reg, disp: Int) -> Mem {
    if type.size in [1, 2, 4, 8] {
        return Mem(base, index, type.size, disp, type)
    }

    Mem(base, base.asm.mul(index, type.size), 1, disp, type)
}

fn reg-operand(asm: Asm, reg: Reg) -> Array[Any] {
    if reg.asm != asm {
        throw Error('register belongs to another assembler')
    }

    [1, reg.id]
}

fn label-operand(asm: Asm, label: Label) -> Array[Any] {
    if label.asm != asm {
        throw Error('label belongs to another assembler')
    }

    [5, label.id]
}

fn operand(asm: Asm, value: Any) -> Array[Any] {
    match value {
        r: Reg      => reg-operand(asm, r),
        h: Hole     => h.encode(),
        l: Label    => label-operand(asm, l),
        m: Mem      => m.encode(asm),
        n: Int      => [2, n],
        f: Float    => [3, f],
        p: Ptr[Any] => [2, p],
        _           => [7, j._const(asm.handle, value, false)],
    }
}

fn target-operand(asm: Asm, target: Any) -> Array[Any] {
    match target {
        r: Reg       => reg-operand(asm, r),
        h: Hole      => h.encode(),
        f: Fn        => [9, f],
        h: rt.Helper => [10, h.handle],
        _            => [2, target],
    }
}

fn mode-code(mode: String | nil) -> Int {
    match mode {
        nil        => 0,
        'detached' => 1,
        'attached' => 2,
        _          => throw Error("invalid mode: {mode}"),
    }
}

fn float?(reg: Reg) -> Bool { reg.type.cls in [2, 3] }

fn scalar-type(value: Any) -> Type {
    match value {
        r: Reg      => r.type,
        h: Hole     => h.type,
        _: Float    => F64,
        _: Int      => I64,
        _: Ptr[Any] => PTR,
        _           => VAL,
    }
}

pub class Asm {
    __handle: Ptr[Any];
    params: Array[Reg];
    name: String;
    result: Type;
    span: (Int, Int, Int);

    init(name: String, params: Array[Type], ret: Type = VOID,
         mode: String | nil = nil) {
        self.name = name
        result = ret
        span = (0, 0, 0)
        __handle = j._new(name, [it.code for params], ret.code, mode-code(mode))
        self.params = [
            Reg(self, id, CLASSES[cls])
            for (id, cls) in j._params(__handle)
        ]
    }

    handle -> Ptr[Any] { __handle }

    emit(op: String, dst: Reg | nil, args: Array[Array[Any]],
         meta: Dict[String, Any] | nil = nil) {
        if let r: Reg = dst {
            reg-operand(self, r)
        }
        let opcode = OPS[op] ?? throw Error("unknown operation: {op}")
        let data = meta ?? %{}
        data['span'] = [span[0], span[1], span[2]]
        check-error(j._emit(__handle, opcode, dst.?id ?? -1, args, data))
    }

    reg(type: Type, init: Any = nil) -> Reg {
        let r = Reg(self, j._reg(__handle, type.cls), type)
        if init != nil {
            r.set(init)
        }
        r
    }

    label() -> Label { Label(self, j._label(__handle)) }

    bind(label: Label) {
        label-operand(self, label)
        check-error(j._bind(__handle, label.id))
    }

    move(dst: Reg, value: Any) {
        emit('MOV', dst, [operand(self, value)])
    }

    unary(op: String, a: Reg, type: Type | nil = nil) -> Reg {
        let r = reg(type ?? a.type)
        emit(op, r, [operand(self, a)])
        r
    }

    binary(op: String, a: Reg, b: Any) -> Reg {
        let r = reg(a.type)
        emit(op, r, [operand(self, a), operand(self, b)])
        r
    }

    add(a: Reg, b: Any) -> Reg { binary(float?(a) ? 'FADD' : 'ADD', a, b) }
    sub(a: Reg, b: Any) -> Reg { binary(float?(a) ? 'FSUB' : 'SUB', a, b) }
    mul(a: Reg, b: Any) -> Reg { binary(float?(a) ? 'FMUL' : 'MUL', a, b) }
    div(a: Reg, b: Any) -> Reg { binary(float?(a) ? 'FDIV' : 'SDIV', a, b) }
    mod(a: Reg, b: Any) -> Reg { binary('SREM', a, b) }
    mulhs(a: Reg, b: Any) -> Reg { binary('MULHS', a, b) }
    mulhu(a: Reg, b: Any) -> Reg { binary('MULHU', a, b) }
    udiv(a: Reg, b: Any) -> Reg { binary('UDIV', a, b) }
    urem(a: Reg, b: Any) -> Reg { binary('UREM', a, b) }
    band(a: Reg, b: Any) -> Reg { binary('AND', a, b) }
    bor(a: Reg, b: Any) -> Reg { binary('OR', a, b) }
    bxor(a: Reg, b: Any) -> Reg { binary('XOR', a, b) }
    shl(a: Reg, b: Any) -> Reg { binary('SHL', a, b) }
    shr(a: Reg, b: Any) -> Reg { binary('SHR', a, b) }
    sar(a: Reg, b: Any) -> Reg { binary('SAR', a, b) }
    rotr(a: Reg, b: Any) -> Reg { binary('ROTR', a, b) }
    neg(a: Reg) -> Reg { unary(float?(a) ? 'FNEG' : 'NEG', a) }
    bnot(a: Reg) -> Reg { unary('NOT', a) }
    clz(a: Reg) -> Reg { unary('CLZ', a) }
    ctz(a: Reg) -> Reg { unary('CTZ', a) }
    popcnt(a: Reg) -> Reg { unary('POPCNT', a) }
    bswap(a: Reg) -> Reg { unary('BSWAP', a) }
    sext8(a: Reg) -> Reg { unary('SEXT8', a, I64) }
    sext16(a: Reg) -> Reg { unary('SEXT16', a, I64) }
    sext32(a: Reg) -> Reg { unary('SEXT32', a, I64) }
    zext8(a: Reg) -> Reg { unary('ZEXT8', a, I64) }
    zext16(a: Reg) -> Reg { unary('ZEXT16', a, I64) }
    zext32(a: Reg) -> Reg { unary('ZEXT32', a, I64) }
    fadd(a: Reg, b: Any) -> Reg { binary('FADD', a, b) }
    fsub(a: Reg, b: Any) -> Reg { binary('FSUB', a, b) }
    fmul(a: Reg, b: Any) -> Reg { binary('FMUL', a, b) }
    fdiv(a: Reg, b: Any) -> Reg { binary('FDIV', a, b) }
    fmin(a: Reg, b: Any) -> Reg { binary('FMIN', a, b) }
    fmax(a: Reg, b: Any) -> Reg { binary('FMAX', a, b) }
    fsqrt(a: Reg) -> Reg { unary('FSQRT', a) }
    fabs(a: Reg) -> Reg { unary('FABS', a) }
    fneg(a: Reg) -> Reg { unary('FNEG', a) }
    i2f(a: Reg, type: Type = F64) -> Reg { unary('I2F', a, type) }
    u2f(a: Reg, type: Type = F64) -> Reg { unary('U2F', a, type) }
    f2i(a: Reg, type: Type = I64) -> Reg { unary('F2I', a, type) }
    fext(a: Reg) -> Reg { unary('FEXT', a, F64) }
    ftrunc(a: Reg) -> Reg { unary('FTRUNC', a, F32) }
    bitcast(a: Reg, type: Type) -> Reg { unary('BITCAST', a, type) }

    fma(a: Reg, b: Reg, c: Reg) -> Reg {
        let r = reg(a.type)
        emit('FMA', r, [operand(self, a), operand(self, b), operand(self, c)])
        r
    }

    checked(op: String, a: Reg, b: Any, overflow: Label) -> Reg {
        let r = reg(a.type)
        emit(op, r, [operand(self, a), operand(self, b), operand(self, overflow)])
        r
    }

    addo(a: Reg, b: Any, overflow: Label) -> Reg { checked('ADDO', a, b, overflow) }
    subo(a: Reg, b: Any, overflow: Label) -> Reg { checked('SUBO', a, b, overflow) }
    mulo(a: Reg, b: Any, overflow: Label) -> Reg { checked('MULO', a, b, overflow) }

    jmp(label: Label) { emit('JMP', nil, [operand(self, label)]) }
    brz(a: Reg, label: Label) { emit('BRZ', nil, [operand(self, a), operand(self, label)]) }
    brnz(a: Reg, label: Label) { emit('BRNZ', nil, [operand(self, a), operand(self, label)]) }

    br(cc: Int, a: Reg, b: Any, label: Label) {
        emit(float?(a) ? 'FBR' : 'BR', nil,
             [[6, cc], operand(self, a), operand(self, b), operand(self, label)])
    }

    switch(a: Reg, labels: Array[Label], default: Label) {
        emit('SWITCH', nil, [operand(self, a), operand(self, default)],
             %{'targets': [label-operand(self, it)[1] for labels]})
    }

    setcc(cc: Int, a: Reg, b: Any) -> Reg {
        let r = reg(I64)
        emit(float?(a) ? 'FSETCC' : 'SETCC', r,
             [[6, cc], operand(self, a), operand(self, b)])
        r
    }

    select(cc: Int, a: Reg, b: Any, then: Reg, other: Any) -> Reg {
        let r = reg(then.type)
        emit(float?(a) ? 'FSELECT' : 'SELECT', r,
             [[6, cc], operand(self, a), operand(self, b),
              operand(self, then), operand(self, other)])
        r
    }

    load(mem: Mem) -> Reg {
        let r = reg(mem.type)
        emit(load-op(mem.type), r, [mem.encode(self)])
        r
    }

    store(mem: Mem, value: Any) {
        emit(store-op(mem.type), nil, [mem.encode(self), operand(self, value)])
    }

    lea(mem: Mem) -> Reg {
        let r = reg(PTR)
        emit('LEA', r, [mem.encode(self)])
        r
    }

    cas(mem: Mem, expected: Any, value: Any) -> Reg {
        let r = reg(mem.type)
        emit('CAS', r, [mem.encode(self), operand(self, expected),
                        operand(self, value)])
        r
    }

    xadd(mem: Mem, value: Any) -> Reg {
        let r = reg(mem.type)
        emit('XADD', r, [mem.encode(self), operand(self, value)])
        r
    }

    xchg(mem: Mem, value: Any) -> Reg {
        let r = reg(mem.type)
        emit('XCHG', r, [mem.encode(self), operand(self, value)])
        r
    }

    alloca(n: Int, align: Int = 8) -> Reg {
        let r = reg(PTR)
        emit('ALLOCA', r, [[2, n], [2, align]])
        r
    }

    const(value: Any) -> Reg {
        let r = reg(PTR)
        emit('MOV', r, [[7, j._const(__handle, value, false)]])
        r
    }

    ref(value: Any) -> Reg {
        let r = reg(REF)
        emit('MOV', r, [[8, j._const(__handle, value, true)]])
        r
    }

    vslot() -> Reg { Reg(self, j._vslot(__handle), PTR) }

    ret(value: Any = nil) {
        emit('RET', nil, value == nil ? [] : [operand(self, value)])
    }

    tag-of(value: Reg) -> Reg {
        band(load(value.off(U8, layout.OFF_TYPE)), ~j.tag.TAGGED)
    }

    unbox(value: Reg, type-class: Class, `else`: Label) -> Reg {
        let (wanted, type, offset) = unbox-layout(type-class)
        br(NE, tag-of(value), wanted, `else`)
        load(value.off(type, offset))
    }

    box(value: Reg, type-class: Class, into: Reg | nil = nil) -> Reg {
        let (kind, type, offset) = box-layout(type-class)
        let out = into ?? vslot()
        for [0, 8, 16, 24] {
            store(out.off(U64, it), 0)
        }
        store(out.off(type, offset), value)
        store(out.off(U8, layout.OFF_TYPE), kind)
        out
    }

    ty-context() -> Reg {
        ccall(j._current-ty(), [], ret: PTR, sig: []) as Reg
    }

    call-ty(f: Any, args: Array[Reg]) -> Reg {
        let xs = vslot()
        ccall(rt.array-new, [xs])
        for args {
            ccall(rt.array-push, [xs, xs, it])
        }
        let out = vslot()
        ccall(rt.call, [out, f, xs])
        out
    }

    raw(arm64: Array[Int] | nil = nil, x64: Blob | nil = nil,
        out: Dict[String, Reg] = %{}, clobber: Array[String] = [],
        %kwargs: Dict[String, Any]) {
        let inputs = raw-inputs(kwargs)
        let (gp, fp) = raw-clobbers(clobber)
        emit('RAW', nil, [], %{
            'arm64': arm64, 'x64': x64,
            'in': [raw-binding(self, name, r) for (name, r) in inputs],
            'out': [raw-binding(self, name, r) for (name, r) in out],
            'gpr-clobber': gp, 'fpr-clobber': fp,
        })
    }

    fence() { emit('FENCE', nil, []) }
    site(site-id: Int) { emit('SITE', nil, [[2, site-id]]) }
    entry(label: Label, entry-id: Int = 0) {
        emit('ENTRY', nil, [operand(self, label)], %{'tag': entry-id})
    }
    poll(deopt: Label) { emit('POLL', nil, [operand(self, deopt)]) }

    ccall(target: Any, args: Array[Any], ret: Type = VOID,
          sig: Array[Type] | nil = nil, may-gc: Bool = false,
          may-throw: Bool = false, flags: Int = 0,
          nfixed: Int | nil = nil) -> Reg | nil {
        call-op(self, 'CALL', target, args, ret, sig, may-gc, may-throw,
                flags, nfixed)
    }

    tailcall(target: Any, args: Array[Any], ret: Type = VOID,
             sig: Array[Type] | nil = nil, may-gc: Bool = false,
             may-throw: Bool = false, flags: Int = 0,
             nfixed: Int | nil = nil) {
        call-op(self, 'TAILCALL', target, args, ret, sig, may-gc, may-throw,
                flags, nfixed)
    }

    dump(stage: String = 'lir') -> String {
        let (text, error) = j._dump(__handle, stage)
        check-error(error)
        text as String
    }

    serialize() -> Encoding {
        let (bytes, inputs, captures, error) = j._serialize(__handle)
        check-error(error)
        Encoding(bytes as Blob, inputs, captures)
    }

    finish() -> Fn {
        let (compiled, error) = j._finish(__handle, Fn)
        check-error(error)
        compiled as Fn
    }
}

fn raw-inputs(kwargs: Dict[String, Any]) -> Dict[String, Reg] {
    let names = ['arm64', 'x64', 'in', 'out', 'clobber']
    if kwargs.keys().any?(\_ not in names) {
        throw Error('unknown raw option')
    }
    (kwargs['in'] ?? %{}) as Dict[String, Reg]
}

fn arm64-register(name: String) -> (Int, Bool) {
    let [_, bank, number] = /^([xwvsd])(\d+)$/(name)
        ?? throw Error("invalid arm64 register: {name}")
    let p = int(number)
    let fp? = bank in ['v', 's', 'd']
    if p < 0 || p >= (fp? ? 32 : 29) || (!fp? && p == 18) {
        throw Error("unavailable arm64 register: {name}")
    }
    (p, fp?)
}

fn x64-gpr(name: String, p: Int) -> (Int, Bool) {
    if p in [4, 5] {
        throw Error("unavailable x64 register: {name}")
    }
    (p, false)
}

fn x64-register(name: String) -> (Int, Bool) {
    let names = ['rax', 'rcx', 'rdx', 'rbx', 'rsp', 'rbp', 'rsi', 'rdi',
                 'r8', 'r9', 'r10', 'r11', 'r12', 'r13', 'r14', 'r15']
    if let p: Int = names.search(name) {
        return x64-gpr(name, p)
    }

    let [_, number] = /^xmm(\d+)$/(name)
        ?? throw Error("invalid x64 register: {name}")
    let p = int(number)
    if p >= 16 {
        throw Error("unavailable x64 register: {name}")
    }
    (p, true)
}

fn physical-register(name: String) -> (Int, Bool) {
    match ARCH {
        'arm64' => arm64-register(name),
        'x64'   => x64-register(name),
        _       => throw Error('raw instructions require a native target'),
    }
}

fn raw-binding(asm: Asm, name: String, reg: Reg) -> Array[Int] {
    reg-operand(asm, reg)
    let (p, fp?) = physical-register(name)
    if fp? != float?(reg) {
        throw Error("register class does not match {name}")
    }

    if ARCH == 'arm64' && !fp? && p in [16, 17] {
        throw Error("raw bindings cannot use scratch register {name}")
    }

    [p, reg.id]
}

fn raw-clobbers(names: Array[String]) -> (Int, Int) {
    let gp = 0
    let fp = 0
    for names {
        let (p, fp?) = physical-register(it)
        match fp? {
            true  => fp |= 1 << p,
            false => gp |= 1 << p,
        }
    }
    (gp, fp)
}

fn unbox-layout(type-class: Class) -> (Int, Type, Int) {
    match type-class {
        Int    => (j.tag.INT, I64, layout.OFF_Z),
        Float  => (j.tag.FLOAT, F64, layout.OFF_REAL),
        Bool   => (j.tag.BOOL, U8, layout.OFF_BOOL),
        Ptr    => (j.tag.PTR, PTR, layout.OFF_PTR),
        Blob   => (j.tag.BLOB, REF, layout.OFF_PTR),
        String => (j.tag.STRING, PTR, layout.OFF_STR),
        Array  => (j.tag.ARRAY, REF, layout.OFF_PTR),
        _      => throw Error('unsupported unbox type'),
    }
}

fn box-layout(type-class: Class) -> (Int, Type, Int) {
    match type-class {
        Int   => (j.tag.INT, I64, layout.OFF_Z),
        Float => (j.tag.FLOAT, F64, layout.OFF_REAL),
        Bool  => (j.tag.BOOL, U8, layout.OFF_BOOL),
        Ptr   => (j.tag.PTR, PTR, layout.OFF_PTR),
        _     => throw Error('unsupported box type'),
    }
}

fn load-op(type: Type) -> String {
    match type.code {
        8 or 12 or 13 or 14 => 'LD_I64',
        11                  => 'LD_U8',
        _                   => "LD_{type.name.upper()}",
    }
}

fn store-op(type: Type) -> String {
    match type.code {
        9  => 'ST_F32',
        10 => 'ST_F64',
        _  => "ST{type.size * 8}",
    }
}

fn known-target?(target: Any) -> Bool {
    let t = type(target)
    t == Fn || t == Function
}

fn call-op(asm: Asm, op: String, target: Any, args: Array[Any],
           ret: Type, sig: Array[Type] | nil, may-gc: Bool,
           may-throw: Bool, flags: Int, nfixed: Int | nil) -> Reg | nil {
    let types = sig ?? [scalar-type(it) for args]
    let fixed = nfixed ?? #types
    let var? = nfixed != nil
    let inferred-flags = 0

    if known-target?(target) {
        let (r, ps, nf, v?, fs) = j._sig(target)
        ret = ret == VOID ? TYPES[r] : ret
        types = sig ?? [TYPES[it] for ps]
        fixed = nfixed ?? nf
        var? = v?
        inferred-flags = fs
    }

    if let h: rt.Helper = target {
        ret = ret == VOID ? h.ret : ret
        types = sig ?? h.params
        fixed = #types
        var? = false
        inferred-flags = h.flags
        args = #args == #types - 1 ? [asm.ty-context(), *args] : args
    }

    let dst = (op == 'TAILCALL' || ret == VOID) ? nil : asm.reg(ret)
    let opts: Dict[String, Any] = %{
        'ret': ret.code,
        'types': [it.code for types],
        'args': [operand(asm, it) for args],
        'nfixed': fixed,
        'variadic': var?,
        'flags': flags | inferred-flags | (may-gc ? MAY_GC : 0)
            | (may-throw ? MAY_THROW : 0),
    }
    asm.emit(op, dst, [target-operand(asm, target)], opts)
    dst
}

pub fn +(a: Reg, b: Reg | Int | Float) -> Reg { a.asm.add(a, b) }
pub fn -(a: Reg, b: Reg | Int | Float) -> Reg { a.asm.sub(a, b) }
pub fn *(a: Reg, b: Reg | Int | Float) -> Reg { a.asm.mul(a, b) }
pub fn /(a: Reg, b: Reg | Int | Float) -> Reg { a.asm.div(a, b) }
pub fn %(a: Reg, b: Reg | Int) -> Reg { a.asm.mod(a, b) }
pub fn &(a: Reg, b: Reg | Int) -> Reg { a.asm.band(a, b) }
pub fn |(a: Reg, b: Reg | Int) -> Reg { a.asm.bor(a, b) }
pub fn ^(a: Reg, b: Reg | Int) -> Reg { a.asm.bxor(a, b) }
pub fn <<(a: Reg, b: Reg | Int) -> Reg { a.asm.shl(a, b) }
pub fn >>(a: Reg, b: Reg | Int) -> Reg { a.asm.sar(a, b) }
pub fn -(a: Reg) -> Reg { a.asm.neg(a) }

pub fn load(encoding: Encoding, holes: Array[Any] = []) -> Fn {
    let inputs = [hole-value(it) for holes]
    let (f, error) = j._load(encoding.bytes, encoding.ninputs,
                            encoding.captures, inputs, Fn)
    check-error(error)
    f as Fn
}

fn hole-value(value: Any) -> Any {
    match value {
        h: rt.Helper => h.handle,
        _            => value,
    }
}

pub fn serialize(asm: Asm) -> Encoding { asm.serialize() }

pub fn interp(asm: Asm) -> Fn {
    let (f, error) = j._interp(asm.handle, Fn)
    check-error(error)
    f as Fn
}

pub fn stats() -> {allocated: Int, used: Int, chunks: Int} {
    let (allocated, used, chunks) = j._stats()
    return {allocated, used, chunks}
}


pub ns rt {
    pub class Helper {
        name: String;
        handle: Ptr[Any];
        ret: Type;
        params: Array[Type];
        flags: Int;

        init(name: String, handle: Ptr[Any], ret: Type,
             params: Array[Type], flags: Int) {
            self.name = name
            self.handle = handle
            self.ret = ret
            self.params = params
            self.flags = flags
        }
    }

    let HELPERS = %{
        name: Helper(name, handle, TYPES[r], [TYPES[it] for params], flags)
        for (name, handle, r, params, flags) in j._helpers()
    }

    pub fn helper(name: String) -> Helper {
        HELPERS[name] ?? throw Error("unknown runtime helper: {name}")
    }

    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub add = helper('add')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub sub = helper('sub')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub mul = helper('mul')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub div = helper('div')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub mod = helper('mod')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub pow = helper('pow')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub eq = helper('eq')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub ne = helper('ne')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub lt = helper('lt')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub le = helper('le')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub gt = helper('gt')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub ge = helper('ge')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub cmp = helper('cmp')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub subscript = helper('subscript')
    /// (Ty*, Value* out, Value const* input, Value const* other, Value const* value) -> void
    pub subscript-set = helper('subscript-set')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub member = helper('member')
    /// (Ty*, Value* out, Value const* input, Value const* other, Value const* value) -> void
    pub member-set = helper('member-set')
    /// (Ty*, Value* out, Value const* function, Value const* arguments) -> void
    pub call = helper('call')
    /// (Ty*, Value* out, Value const* input, Value const* other, Value const* value) -> void
    pub call-method = helper('call-method')
    /// (Ty*, Value* out) -> void
    pub array-new = helper('array-new')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub array-push = helper('array-push')
    /// (Ty*, Value* out) -> void
    pub dict-new = helper('dict-new')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub dict-get = helper('dict-get')
    /// (Ty*, Value* out, Value const* input, Value const* other, Value const* value) -> void
    pub dict-set = helper('dict-set')
    /// (Ty*, Value* out, Value const* input, Value const* other) -> void
    pub str-concat = helper('str-concat')
    /// (Ty*, Value* out, Value const* input) -> void
    pub to-string = helper('to-string')
    /// (Ty*, Value* out, Value const* input) -> void
    pub hash = helper('hash')
    /// (Ty*, Value const* exception) -> void
    pub `throw` = helper('throw')
    /// (Ty*, Value* out, Value const* input) -> void
    pub alloc-object = helper('alloc-object')
    /// (Ty*, i32 expected, i32 actual) -> void
    pub arity-error = helper('arity-error')
    /// (Ty*, i32 index, i32 type, Value const* value) -> void
    pub arg-type-error = helper('arg-type-error')
    /// (Ty*, i32 kind, Value const* value, i64 n) -> void
    pub kernel-error = helper('kernel-error')
}

ns asm-ast {
    pub tag At;
    pub tag Goto;
    pub tag Label;
    pub tag Raw;
    pub tag Hole;
    pub tag Unsigned;
    pub tag Cast;
}

use Val = Reg | Int | Float

let ASM_TYPES = %{it.name: it for TYPES}
let KERNEL_TYPES = %{'Int': I64, 'Float': F64, 'Bool': BOOL}
let VIEWS = %{
    'f64': F64, 'f32': F32, 'i64': I64, 'i32': I32, 'u32': U32,
    'i16': I16, 'u16': U16, 'i8': I8, 'u8': U8,
}
let TY_NAMES = %{I64.code: 'Int', F64.code: 'Float', BOOL.code: 'Bool'}
let CONTAINERS = %{'Blob': 'blob', 'String': 'string'}
let CONTAINER_TAGS = %{'blob': j.tag.BLOB, 'string': j.tag.STRING, 'ints': j.tag.ARRAY, 'floats': j.tag.ARRAY}

let BINARY = %{
    'Add': 'ADD', 'Sub': 'SUB', 'Mul': 'MUL', 'Div': 'SDIV', 'Mod': 'SREM',
    'BitAnd': 'AND', 'BitOr': 'OR', 'Xor': 'XOR', 'Shl': 'SHL', 'Shr': 'SAR',
}
let FLOAT_BINARY = %{'Add': 'FADD', 'Sub': 'FSUB', 'Mul': 'FMUL', 'Div': 'FDIV'}
let UNSIGNED = %{'Div': 'UDIV', 'Mod': 'UREM', 'Shr': 'SHR'}
let COMPARE = %{'Eq': EQ, 'NotEq': NE, 'LT': LT, 'LEQ': LE, 'GT': GT, 'GEQ': GE}
let UNSIGNED_CC = %{LT: ULT, LE: ULE, GT: UGT, GE: UGE, EQ: EQ, NE: NE}
let NEGATED_CC = %{
    EQ: NE, NE: EQ, LT: GE, LE: GT, GT: LE, GE: LT,
    ULT: UGE, ULE: UGT, UGT: ULE, UGE: ULT, FEQ: FNE, FNE: FEQ,
}
let MUTATE = %{
    'MutAdd': 'Add', 'MutSub': 'Sub', 'MutMul': 'Mul', 'MutDiv': 'Div',
    'MutMod': 'Mod', 'MutAnd': 'BitAnd', 'MutOr': 'BitOr', 'MutXor': 'Xor',
    'MutShl': 'Shl', 'MutShr': 'Shr',
}
let RAW_CC = %{
    'eq': EQ, 'ne': NE, 'lt': LT, 'le': LE, 'gt': GT, 'ge': GE,
    'ult': ULT, 'ule': ULE, 'ugt': UGT, 'uge': UGE,
    'feq': FEQ, 'fne': FNE, 'flt': FLT, 'fle': FLE,
    'fgt': FGT, 'fge': FGE, 'fun': FUN,
}
let LIBM = %{
    math.sin: 'sin', math.cos: 'cos', math.tan: 'tan', math.asin: 'asin',
    math.acos: 'acos', math.atan: 'atan', math.sinh: 'sinh', math.cosh: 'cosh',
    math.tanh: 'tanh', math.exp: 'exp', math.log: 'log', math.log2: 'log2',
    math.log10: 'log10', math.cbrt: 'cbrt', math.atan2: 'atan2', math.pow: 'pow',
}

fn declared-type(node: Any) -> String {
    match node {
        ty.Id(id) and let $c = CONTAINERS[id.name] => c,
        ty.Id(id) => id.name,
        ty.Subscript(ty.Id(a), ty.Id(e)) and a.name == 'Array' => element-kind(e.name),
        ty.Array([ty.ArrayItem(item)]) => element-kind(ast-name(item.item) ?? ''),
        ty.Nil or nil => 'void',
        _ => throw Error("unsupported type annotation: {node}"),
    }
}

fn element-kind(name: String) -> String {
    match name {
        'Int'   => 'ints',
        'Float' => 'floats',
        _       => throw Error("unsupported array element type '{name}'"),
    }
}

fn negate-condition(cc: Int) -> Int {
    NEGATED_CC[cc] ?? throw Error('cannot negate an ordered float comparison')
}

fn float-type?(type: Type) -> Bool { type.cls in [2, 3] }

fn unsigned-type?(type: Type) -> Bool { type.code in [2, 4, 6, 8, 11] }

fn type-of(v: Val) -> Type {
    match v {
        r: Reg   => r.type,
        _: Float => F64,
        _        => I64,
    }
}

fn ast-tag-name(node: Any) -> String {
    let text = str(node)
    text[;text.search('(') ?? #text]
}

fn ast-name(node: Any) -> String | nil {
    match node {
        ty.Id(id) => id.name,
        _         => nil,
    }
}

fn operands(node: Any) -> (String, Any, Any) | nil {
    match node {
        ty.Add(a, b)    => ('Add', a, b),
        ty.Sub(a, b)    => ('Sub', a, b),
        ty.Mul(a, b)    => ('Mul', a, b),
        ty.Div(a, b)    => ('Div', a, b),
        ty.Mod(a, b)    => ('Mod', a, b),
        ty.BitAnd(a, b) => ('BitAnd', a, b),
        ty.BitOr(a, b)  => ('BitOr', a, b),
        ty.Xor(a, b)    => ('Xor', a, b),
        ty.Shl(a, b)    => ('Shl', a, b),
        ty.Shr(a, b)    => ('Shr', a, b),
        ty.Eq(a, b)     => ('Eq', a, b),
        ty.NotEq(a, b)  => ('NotEq', a, b),
        ty.LT(a, b)     => ('LT', a, b),
        ty.LEQ(a, b)    => ('LEQ', a, b),
        ty.GT(a, b)     => ('GT', a, b),
        ty.GEQ(a, b)    => ('GEQ', a, b),
        ty.MutAdd(a, b) => ('MutAdd', a, b),
        ty.MutSub(a, b) => ('MutSub', a, b),
        ty.MutMul(a, b) => ('MutMul', a, b),
        ty.MutDiv(a, b) => ('MutDiv', a, b),
        ty.MutMod(a, b) => ('MutMod', a, b),
        ty.MutAnd(a, b) => ('MutAnd', a, b),
        ty.MutOr(a, b)  => ('MutOr', a, b),
        ty.MutXor(a, b) => ('MutXor', a, b),
        ty.MutShl(a, b) => ('MutShl', a, b),
        ty.MutShr(a, b) => ('MutShr', a, b),
        _               => nil,
    }
}

fn assigned-names(node: Any, out: Dict[String, Bool]) {
    match node {
        ty.Assign(ty.Id(id), _) => out[id.name] = true,
        ty.Block(xs)            => for xs { assigned-names(it, out) },
        ty.If(_, yes, no)       => do { assigned-names(yes, out); assigned-names(no, out) },
        ty.While(_, body)       => assigned-names(body, out),
        ty.Each(e)              => assigned-names(e.expr, out),
        _ => do {
            if let (op, ty.Id(id), _) = operands(node) and op in MUTATE {
                out[id.name] = true
            }
        },
    }
}

fn unwrap(node: Any) -> Any {
    match node {
        asm-ast.At(x, _, _) => unwrap(x),
        _ => node,
    }
}

fn statements(node: Any) -> Array[Any] {
    match unwrap(node) {
        ty.Block(xs) => xs,
        x => [x],
    }
}

class Lin {
    c: Int;
    inv: Array[(Int, Any)];
    ind: Dict[String, Int];

    init(c: Int = 0, inv: Array[(Int, Any)] = [], ind: Dict[String, Int] = %{}) {
        self.c = c
        self.inv = inv
        self.ind = ind
    }

    plus(other: Lin, sign: Int) -> Lin {
        let ind = %{**self.ind}
        for k, v in other.ind {
            ind[k] = (ind[k] ?? 0) + sign * v
        }
        Lin(c + sign * other.c, [*inv, *[(sign * k, x) for (k, x) in other.inv]], ind)
    }

    times(n: Int) -> Lin {
        Lin(c * n, [(k * n, x) for (k, x) in inv], %{name: v * n for name, v in ind})
    }
}

fn writes(node: Any, out: Dict[String, Int]) {
    fn bump(name: String) { out[name] = (out[name] ?? 0) + 1 }
    match unwrap(node) {
        ty.Block(xs) => for xs { writes(it, out) },
        ty.Let(ty.Id(id), _) => bump(id.name),
        ty.Assign(ty.Id(id), _) => bump(id.name),
        ty.If(_, yes, no) => do { writes(yes, out); writes(no, out) },
        ty.While(_, body) => writes(body, out),
        ty.Each(e) => do {
            for e.pattern {
                if let $name = ast-name(it) { bump(name) }
            }
            writes(e.expr, out)
        },
        n => do {
            if let (op, ty.Id(id), _) = operands(n) and op in MUTATE {
                bump(id.name)
            }
        },
    }
}

class Var {
    kind: String;
    reg: Reg;
    data: Reg;
    count: Reg;
    bound: String | nil;
    elem: Type;

    init(kind: String, reg: Reg) {
        self.kind = kind
        self.reg = reg
        data = reg
        count = reg
        bound = nil
        elem = U8
    }
}

fn view-names(node: Any, out: Dict[String, Bool]) {
    let walk = x -> view-names(x, out)
    match unwrap(node) {
        ty.MemberAccess(x, name) => do {
            if VIEWS[name] != nil {
                out[name] = true
            }
            walk(x)
        },
        ty.Block(xs) => xs.each(walk),
        ty.Let(_, v) => walk(v),
        ty.Assign(t, v) => do { walk(t); walk(v) },
        ty.If(conds, yes, no) => do { conds.each(walk); walk(yes); if no != nil { walk(no) } },
        ty.While(conds, body) => do { conds.each(walk); walk(body) },
        ty.Each(e) => do { walk(e.iter); walk(e.expr) },
        ty.Return(v) => if v != nil { walk(v) },
        ty.Call(c) => c.args.each(a -> walk(argument(a))),
        ty.MethodCall(m) => do { walk(m.object); m.args.each(a -> walk(argument(a))) },
        ty.Subscript(x, i) => do { walk(x); walk(i) },
        ty.Cond(c, a, b) => do { walk(c); walk(a); walk(b) },
        ty.Neg(x) or ty.Not(x) or ty.Count(x) => walk(x),
        ty.And(a, b) or ty.Or(a, b) => do { walk(a); walk(b) },
        n => if let (_, a, b) = operands(n) {
            walk(a)
            walk(b)
        },
    }
}

class Fault {
    label: Label;
    kind: Int;
    value: Reg | nil;
    n: Reg | Int;

    init(label: Label, kind: Int, value: Reg | nil, n: Reg | Int) {
        self.label = label
        self.kind = kind
        self.value = value
        self.n = n
    }
}

let __tls::kernel-signatures: Dict[String, (Array[String], String)] = %{}
let __tls::kernel-bodies: Dict[String, (Array[(String, String)], String, Any)] = %{}

fn argument(arg: Any) -> Any {
    match arg {
        ty.Arg(a) => a.arg,
        _         => arg,
    }
}

fn weight(node: Any) -> Int {
    let n = unwrap(node)
    match n {
        ty.Block(xs) => xs.map(weight).sum(0) + 1,
        ty.Let(_, v) or ty.Assign(_, v) => weight(v) + 1,
        ty.If(conds, yes, no) => conds.map(weight).sum(0) + weight(yes) + ((no == nil) ? 0 : weight(no)) + 1,
        ty.While(conds, body) => conds.map(weight).sum(0) + weight(body) + 4,
        ty.Each(e) => weight(e.expr) + 4,
        ty.Return(v) => (v == nil) ? 1 : weight(v) + 1,
        ty.Call(c) => c.args.map(a -> weight(argument(a))).sum(0) + 2,
        ty.MethodCall(m) => m.args.map(a -> weight(argument(a))).sum(0) + weight(m.object) + 1,
        ty.Subscript(x, i) => weight(x) + weight(i) + 1,
        ty.Cond(c, a, b) => weight(c) + weight(a) + weight(b) + 1,
        ty.Neg(x) or ty.Not(x) or ty.Count(x) => weight(x) + 1,
        ty.And(a, b) or ty.Or(a, b) => weight(a) + weight(b) + 1,
        _ => match operands(n) {
            (_, a, b) => weight(a) + weight(b) + 1,
            _         => 1,
        },
    }
}

class Lower {
    asm: Asm;
    tool: String;
    safe: Bool;
    holes: Array[Any];
    known: Array[Any];
    __scopes: Array[Dict[String, Var]];
    __loops: Array[(Label, Label)];
    __labels: Dict[String, Label];
    __faults: Array[Fault];
    __hole-ids: Dict[String, Int];
    __proven: Array[Array[Var]];
    __inline: Array[(Reg | nil, Label, Type)];
    __views: Array[(Var, String, Var)];

    init(tool: String, name: String, params: Array[(String, String)],
         ret: String, mode: String | nil, known: Array[Any]) {
        self.tool = tool
        safe = tool == 'kernel!'
        self.known = known
        holes = []
        __scopes = [%{}]
        __loops = []
        __labels = %{}
        __faults = []
        __hole-ids = %{}
        __proven = []
        __inline = []
        __views = []
        asm = Asm(name, params: [lir-type(k) for (_, k) in params], ret: lir-type(ret), mode: mode)
        for (pname, kind); i in params {
            bind-param(pname, kind, asm.params[i], i)
        }
    }

    fail(message: String) { throw Error("{tool}: {message}") }

    type-name(t: Type) -> String {
        safe ? (TY_NAMES[t.code] ?? t.name) : t.name
    }

    lir-type(kind: String) -> Type {
        if kind in ['blob', 'string', 'ints', 'floats'] {
            return VAL
        }
        ASM_TYPES[kind] ?? KERNEL_TYPES[kind] ?? (kind == 'void' ? VOID : fail("unknown type '{kind}'"))
    }

    bind-param(pname: String, kind: String, r: Reg, i: Int) {
        let v = Var(kind, r)
        if let $wanted = CONTAINER_TAGS[kind] {
            let bad = fault(2, r, i)
            asm.br(NE, asm.load(r.off(U8, layout.OFF_TYPE)), wanted, bad)
            if kind == 'string' {
                v.data = asm.load(r.off(PTR, layout.OFF_STR))
                v.count = asm.zext32(asm.load(r.off(U32, layout.OFF_BYTES)))
            } else {
                let object = asm.load(r.off(PTR, layout.OFF_PTR))
                let offsets = kind == 'blob' ? layout.Blob : layout.Array
                v.data = asm.load(object.off(PTR, offsets.OFF_ITEMS))
                v.count = asm.load(object.off(I64, offsets.OFF_COUNT))
            }
        } else {
            v = Var('scalar', Reg(asm, r.id, lir-type(kind)))
        }
        define(pname, v)
    }

    define(vname: String, v: Var) { __scopes[-1][vname] = v }

    lookup(vname: String) -> Var | nil {
        for ..#__scopes {
            if let $v = __scopes[-1 - it][vname] {
                return v
            }
        }
        nil
    }

    scalar-var(vname: String) -> Var | nil {
        let v = lookup(vname) ?? return nil
        v.kind == 'scalar' ? v : fail("'{vname}' is a container, not a scalar")
    }

    container(node: Any) -> Var | nil {
        if let ty.MemberAccess(base, name) = unwrap(node) and VIEWS[name] != nil {
            let $blob = container(base) or return nil
            return view(blob, name)
        }
        let v = lookup(ast-name(node) ?? return nil) ?? return nil
        v.kind == 'scalar' ? nil : v
    }

    view(blob: Var, name: String) -> Var {
        if blob.kind != 'blob' {
            fail("'.{name}' views apply to Blob parameters")
        }
        for (b, n, v) in __views {
            if b == blob && n == name {
                return v
            }
        }
        fail("internal error: the '.{name}' view was not prepared")
    }

    prepare-views(body: Any, blobs: Array[Var]) {
        let names = %{}
        view-names(body, names)
        for name, _ in names {
            let type = VIEWS[name]!
            let shift = [1, 2, 4, 8].search(type.size)!
            for b in blobs {
                let v = Var('view', b.reg)
                v.data = b.data
                v.count = asm.reg(I64, (shift == 0) ? b.count : asm.sar(b.count, shift))
                v.elem = type
                __views.push((b, name, v))
            }
        }
    }

    fault(kind: Int, value: Reg | nil, n: Reg | Int) -> Label {
        let label = asm.label()
        __faults.push(Fault(label, kind, value, n))
        label
    }

    raise(kind: Int) {
        asm.ccall(rt.kernel-error, [asm.reg(I32, kind), asm.reg(PTR, 0), asm.reg(I64, 0)])
    }

    finish(done?: Bool) {
        if !done? {
            if asm.result == VOID {
                asm.ret()
            } else if safe {
                raise(4)
            }
        }
        for __faults {
            asm.bind(it.label)
            let n = (it.n :: Int) ? asm.reg(I64, it.n) : it.n
            asm.ccall(rt.kernel-error, [asm.reg(I32, it.kind), it.value ?? asm.reg(PTR, 0), n])
        }
    }

    reg(v: Val, type: Type | nil = nil) -> Reg {
        let x = convert(v, type ?? type-of(v))
        (x :: Reg) ? (x as Reg) : asm.reg(type ?? type-of(v), x)
    }

    implicit(v: Val, type: Type) -> Val {
        let from = type-of(v)
        if !safe || from == type || (from in [I64, BOOL] && type == F64) || (from == BOOL && type == I64) {
            return convert(v, type)
        }
        fail("expected {type-name(type)} but found {type-name(from)}")
    }

    convert(v: Val, type: Type) -> Val {
        match v {
            n: Int => float-type?(type) ? float(n) : n,
            x: Float => float-type?(type) ? x : (safe ? fail('cannot use a Float as an Int') : int(x)),
            r: Reg => convert-reg(r, type),
        }
    }

    convert-reg(r: Reg, type: Type) -> Reg {
        let from = r.type
        if from == type || type == VOID {
            return r
        }
        if type == BOOL {
            return asm.setcc(float-type?(from) ? FNE : NE, r, float-type?(from) ? 0.0 : 0)
        }
        if float-type?(from) && float-type?(type) {
            return from == F32 ? asm.fext(r) : asm.ftrunc(r)
        }
        if float-type?(type) {
            return unsigned-type?(from) ? asm.u2f(r, type) : asm.i2f(r, type)
        }
        if float-type?(from) {
            return asm.f2i(r, type)
        }
        if type.code in [1, 2, 3, 4, 5, 6] {
            return asm.unary(['SEXT8', 'ZEXT8', 'SEXT16', 'ZEXT16', 'SEXT32', 'ZEXT32'][type.code - 1], r, type)
        }
        if from.cls == 0 && type.cls == 1 {
            return asm.unary(unsigned-type?(from) ? 'ZEXT32' : 'SEXT32', r, type)
        }
        from.cls == type.cls ? Reg(asm, r.id, type) : asm.bitcast(r, type)
    }

    common(a: Val, b: Val) -> Type {
        let types = [type-of(it) for [a, b] if it :: Reg]
        if (a :: Float) || (b :: Float) {
            types.push(F64)
        }
        for [PTR, F64, F32] {
            if it in types {
                return it
            }
        }
        let t = (#types > 0) ? types[0] : I64
        t == BOOL ? I64 : t
    }

    function(body: Any) {
        prepare-views(body, __scopes[0].values().filter(v -> v.kind == 'blob'))
        finish(safe && asm.result != VOID ? tail(body) : statement(body))
    }

    tail(node: Any) -> Bool {
        match node {
            ty.Block(xs) => do {
                __scopes.push(%{})
                let done? = false
                for x; i in xs {
                    done? = (i == #xs - 1) ? tail(x) : statement(x)
                }
                __scopes.pop()
                done?
            },
            ty.If([cond], yes, no) and no != nil => do {
                let other = asm.label()
                branch(cond, false, other)
                if !tail(yes) {
                    raise(4)
                }
                asm.bind(other)
                if !tail(no) {
                    raise(4)
                }
                true
            },
            _ and statement?(node) => statement(node),
            _                      => do { return-value(node); true },
        }
    }

    statement?(node: Any) -> Bool {
        ast-tag-name(node) in ['Let', 'Assign', 'While', 'Each', 'Break', 'Continue',
                               'Return', 'Block', 'If', 'At', 'Goto', 'Label', 'Raw']
            || ast-tag-name(node) in MUTATE
    }

    return-value(node: Any) {
        if #__inline > 0 {
            let (out, end, rt) = __inline[-1]
            if let $o = out {
                o.set(implicit(expression(node, rt), rt))
            } else if node != nil && node != ty.Nil {
                expression(node)
            }
            asm.jmp(end)
            return
        }
        if node == nil || node == ty.Nil {
            asm.ret()
        } else if asm.result == VOID {
            expression(node)
            asm.ret()
        } else {
            asm.ret(reg(implicit(expression(node, asm.result), asm.result), asm.result))
        }
    }

    block(xs: Array[Any]) -> Bool {
        __scopes.push(%{})
        let done? = false
        for xs {
            done? = statement(it)
        }
        __scopes.pop()
        done?
    }

    statement(node: Any) -> Bool {
        match node {
            asm-ast.At(x, start, end) => do { asm.span = (0, start, end); statement(x) },
            ty.Block(xs)              => block(xs),
            ty.Let(target, value)     => let-statement(target, value),
            ty.Assign(target, value)  => assign(target, nil, value),
            ty.If([cond], yes, no)    => if-statement(cond, yes, no),
            ty.If(_, _, _)            => fail('if-let and multiple conditions are not supported'),
            ty.While([cond], body)    => while-statement(cond, body),
            ty.Each(e)                => each-statement(e),
            ty.Break(b)               => exit-loop(false, b.depth),
            ty.Continue(depth)        => exit-loop(true, depth),
            ty.Return(value)          => do { return-value(value); true },
            asm-ast.Goto(name)        => do { asm.jmp(label(name)); true },
            asm-ast.Label(name)       => do { asm.bind(label(name)); false },
            asm-ast.Raw(name, args)   => raw(name, args),
            _                         => other-statement(node),
        }
    }

    other-statement(node: Any) -> Bool {
        if let (op, target, value) = operands(node) and let $base = MUTATE[op] {
            return assign(target, base, value)
        }
        match node {
            ty.Call(c) => call(c.func, [arg-node(it) for c.args], VOID),
            _          => expression(node),
        }
        false
    }

    label(name: String) -> Label {
        __labels[name] ?? (__labels[name] = asm.label())
    }

    let-statement(target: Any, value: Any) -> Bool {
        let ty.Id(id) = target or fail('only simple let bindings are supported')
        if safe and let $alias = container(value) {
            define(id.name, alias)
            return false
        }
        if !safe && id.name in __scopes[-1] {
            fail("invalid or duplicate declaration '{id.name}'")
        }
        let type = id.constraint == nil ? nil : lir-type(declared-type(id.constraint))
        if type == VOID || type == VAL && safe {
            fail("cannot declare '{id.name}' as {type}")
        }
        let r = if value == nil {
            asm.reg(type ?? I64)
        } else {
            let v = expression(value, type)
            let t = type ?? type-of(v)
            let out = asm.reg(t)
            out.set(implicit(v, t))
            out
        }
        define(id.name, Var('scalar', r))
        false
    }

    assign(target: Any, op: String | nil, value: Any) -> Bool {
        match target {
            ty.Id(id) => do {
                let v = scalar-var(id.name) ?? fail("assignment to undefined variable '{id.name}'")
                let rhs = op == nil ? expression(value, v.reg.type) : arithmetic(op, target, value)
                v.reg.set(implicit(rhs, v.reg.type))
            },
            ty.Subscript(x, index) => assign-element(x, index, op, value),
            _                      => fail("unsupported assignment target: {target}"),
        }
        false
    }

    assign-element(x: Any, index: Any, op: String | nil, value: Any) {
        if let $v = container(x) {
            if v.kind == 'string' {
                fail('strings are immutable')
            }
            let i = checked-index(v, index)
            let rhs = expression(value)
            if let $o = op {
                rhs = combine(o, load-element(v, i), rhs)
            }
            return store-element(v, i, rhs, op != nil)
        }
        let mem = memory(x, index)
        let rhs = expression(value, mem.type)
        if let $o = op {
            rhs = combine(o, asm.load(mem), rhs)
        }
        asm.store(mem, convert(rhs, mem.type))
    }

    if-statement(cond: Any, yes: Any, no: Any) -> Bool {
        let other = asm.label()
        branch(cond, false, other)
        let yes? = statement(yes)
        if no == nil {
            asm.bind(other)
            return false
        }
        let done = asm.label()
        if !yes? {
            asm.jmp(done)
        }
        asm.bind(other)
        let no? = statement(no)
        asm.bind(done)
        yes? && no?
    }

    loop(top: Label, next: Label, done: Label, body: Any) {
        asm.bind(top)
        __loops.push((next, done))
        statement(body)
        __loops.pop()
        asm.bind(next)
    }

    while-statement(cond: Any, body: Any) -> Bool {
        let (top, next, done) = (asm.label(), asm.label(), asm.label())
        branch(cond, false, done)
        loop(top, next, done, body)
        branch(cond, true, top)
        asm.bind(done)
        false
    }

    exit-loop(continue?: Bool, depth: Int) -> Bool {
        if depth != 1 {
            fail('labelled break/continue is not supported')
        }
        let (next, done) = __loops[-1] ?? fail('break/continue outside a loop')
        asm.jmp(continue? ? next : done)
        true
    }

    each-statement(e: Any) -> Bool {
        let names = [
            ast-name(it) ?? (ast-tag-name(it) in ['MatchAny', 'Any'] ? '_' : fail('for loops bind plain names'))
            for e.pattern
        ]
        match e.iter {
            ty.DotDot(a, b)    => range-loop(names, a, b, false, e),
            ty.DotDotDot(a, b) => range-loop(names, a, b, true, e),
            _                  => element-loop(names, e),
        }
        false
    }

    range-loop(names: Array[String], a: Any, b: Any, inclusive?: Bool, e: Any) {
        if #names != 1 {
            fail('range loops bind exactly one name')
        }
        let counter = asm.reg(I64, reg(implicit(expression(a), I64), I64))
        let limit = asm.reg(I64, reg(implicit(expression(b), I64), I64))
        let bound = range-bound(a, b, inclusive?, names[0], e.expr)
        let bind = -> do {
            let v = Var('scalar', asm.reg(I64, counter))
            v.bound = bound
            define(names[0], v)
        }
        let $plan = safe ? affine-plan(names[0], e) : nil or return counted-loop(counter, limit, inclusive?, e, bind)
        let (fast, slow, after) = (asm.label(), asm.label(), asm.label())
        affine-guard(plan, names[0], counter, limit, inclusive?, slow)
        asm.bind(fast)
        __proven.push(plan.0)
        counted-loop(counter, limit, inclusive?, e, bind)
        __proven.pop()
        asm.jmp(after)
        asm.bind(slow)
        counted-loop(counter, limit, inclusive?, e, bind)
        asm.bind(after)
    }

    scalar-int?(name: String) -> Bool {
        let $v = lookup(name) or return false
        v.kind == 'scalar' && v.reg.type == I64
    }

    invariant?(node: Any, local: Dict[String, Int]) -> Bool {
        match unwrap(node) {
            ty.Int(_) => true,
            ty.Id(id) => local[id.name] == nil && scalar-int?(id.name),
            ty.Count(x) => container(x) != nil,
            ty.Neg(x) => invariant?(x, local),
            ty.MethodCall(m) => m.method == 'size' && #m.args == 0 && container(m.object) != nil,
            n => do {
                let (op, a, b) = operands(n) ?? return false
                op in ['Add', 'Sub', 'Mul', 'BitAnd', 'BitOr', 'Xor', 'Shl', 'Shr']
                    && invariant?(a, local)
                    && invariant?(b, local)
            },
        }
    }

    linear(node: Any, local: Dict[String, Int], inductions: Dict[String, Any]) -> Lin | nil {
        let n = unwrap(node)
        if let ty.Int(k) = n {
            return Lin(c: k)
        }
        if let ty.Id(id) = n and inductions[id.name] != nil {
            return Lin(ind: %{id.name: 1})
        }
        if invariant?(n, local) {
            return Lin(inv: [(1, n)])
        }
        match n {
            ty.Neg(x) => linear(x, local, inductions).?times(-1),
            ty.Add(a, b) => do {
                let $x = linear(a, local, inductions) or return nil
                let $y = linear(b, local, inductions) or return nil
                x.plus(y, 1)
            },
            ty.Sub(a, b) => do {
                let $x = linear(a, local, inductions) or return nil
                let $y = linear(b, local, inductions) or return nil
                x.plus(y, -1)
            },
            ty.Mul(ty.Int(k), b) => linear(b, local, inductions).?times(k),
            ty.Mul(a, ty.Int(k)) => linear(a, local, inductions).?times(k),
            _ => nil,
        }
    }

    accesses(node: Any, pos: Int, out: Array[(Var, Any, Int)]) -> Bool {
        let n = unwrap(node)
        let walk = x -> accesses(x, pos, out)
        match n {
            ty.Int(_) or ty.Float(_) or ty.Bool(_) or ty.Id(_) or ty.Break(_) or ty.Continue(_) => true,
            ty.Subscript(x, i) => do {
                if let $v = container(x) {
                    out.push((v, i, pos))
                    walk(i)
                } else {
                    false
                }
            },
            ty.MethodCall(m) => do {
                let args = [arg-node(it) for m.args]
                if let $v = container(m.object) and m.method == 'byte' && #args == 1 {
                    out.push((v, args[0], pos))
                }
                args.all?(walk)
            },
            ty.Call(c) => [arg-node(it) for c.args].all?(walk),
            ty.Let(_, value) => container(value) == nil && walk(value),
            ty.Assign(target, value) => walk(target) && walk(value),
            ty.Block(xs) => xs.all?(walk),
            ty.If(conds, yes, no) => conds.all?(walk) && walk(yes) && (no == nil || walk(no)),
            ty.While(conds, body) => conds.all?(walk) && walk(body),
            ty.Each(e) => walk(e.iter) && walk(e.expr)
                       && (e.?`while` == nil || walk(e.`while`))
                       && (e.?`if` == nil || walk(e.`if`)),
            ty.Return(value) => value == nil || walk(value),
            ty.Neg(x) or ty.Not(x) or ty.Count(x) or ty.UserOp('~', x) => walk(x),
            ty.And(a, b) or ty.Or(a, b) => walk(a) && walk(b),
            ty.Cond(c, a, b) => walk(c) && walk(a) && walk(b),
            ty.MemberAccess(x, _) => walk(x),
            _ => do {
                let (_, a, b) = operands(n) ?? return false
                walk(a) && walk(b)
            },
        }
    }

    step-at(steps: Dict[String, (Int, Int, Any)], name: String) -> Int {
        match steps[name] {
            (at, _, _) => at,
            _          => -2,
        }
    }

    affine-plan(vname: String, e: Any) -> (Array[Var], Array[(Var, Lin, Int)], Dict[String, (Int, Int, Any)]) | nil {
        let body = statements(e.expr)
        let local = %{}
        writes(e.expr, local)
        if local[vname] != nil {
            return nil
        }
        local[vname] = 1
        let inductions: Dict[String, Any] = %{vname: true}
        let steps: Dict[String, (Int, Int, Any)] = %{}
        for stmt; p in body {
            if let (op, ty.Id(id), step) = operands(unwrap(stmt))
            and (op == 'MutAdd' || op == 'MutSub')
            and local[id.name] == 1
            and scalar-int?(id.name)
            and invariant?(step, local) {
                steps[id.name] = (p, op == 'MutAdd' ? 1 : -1, step)
                inductions[id.name] = true
            }
        }
        let found = []
        let guards = [e.?`while`, e.?`if`].filter(\_ != nil)
        if !guards.all?(g -> accesses(g, -1, found)) {
            return nil
        }
        for stmt; p in body {
            if !accesses(stmt, p, found) {
                return nil
            }
        }
        let plan = []
        let dirty = []
        for (v, index, p) in found {
            if let $lin = linear(index, local, inductions)
            and lin.ind.keys().all?(k -> (k == vname) || (step-at(steps, k) != p)) {
                plan.push((v, lin, p))
            } else {
                dirty.push(v)
            }
        }
        let unique: Array[Var] = []
        for (v, _, _) in plan {
            if v not in dirty && v not in unique {
                unique.push(v)
            }
        }
        if #unique == 0 {
            return nil
        }
        (unique, plan.filter(|(v, _, _)| -> v in unique), steps)
    }

    affine-guard(
        plan: (Array[Var], Array[(Var, Lin, Int)], Dict[String, (Int, Int, Any)]),
        vname: String, counter: Reg, limit: Reg, inclusive?: Bool, slow: Label
    ) {
        let (vars, accesses, steps) = plan
        let n = asm.reg(I64, asm.sub(limit, counter))
        if inclusive? {
            n.set(asm.add(n, 1))
        }
        asm.br(LE, n, 0, slow)
        asm.br(GT, n, 1 << 31, slow)
        let last = asm.reg(I64, asm.sub(n, 1))
        let groups: Dict[String, (Var, Lin, Int, Int, Int)] = %{}
        for (v, lin, p) in accesses {
            let phases = lin.ind.keys().sort().map(k -> (k == vname) ? '' : "{p > step-at(steps, k)}")
            let key = "{vars.search(v)}|{lin.inv}|{lin.ind.list().sort()}|{phases}"
            groups[key] = match groups[key] {
                (_, _, _, lo, hi) => (v, lin, p, min(lo, lin.c), max(hi, lin.c)),
                _                 => (v, lin, p, lin.c, lin.c),
            }
        }
        for _, (v, lin, p, lo, hi) in groups {
            let base = asm.reg(I64, 0)
            let slope = asm.reg(I64, 0)
            for (k, node) in lin.inv {
                base.set(asm.add(base, asm.mul(reg(integer(expression(node)), I64), k)))
            }
            for name, coef in lin.ind {
                if name == vname {
                    base.set(asm.add(base, asm.mul(counter, coef)))
                    slope.set(asm.add(slope, coef))
                    continue
                }
                let (at, sign, step) = steps[name]!
                let s = asm.reg(I64, asm.mul(reg(integer(expression(step)), I64), sign))
                let start = (p > at) ? asm.add(lookup(name)!.reg, s) : lookup(name)!.reg
                base.set(asm.add(base, asm.mul(start, coef)))
                slope.set(asm.add(slope, asm.mul(s, coef)))
            }
            asm.br(GT, slope, 1 << 31, slow)
            asm.br(LT, slope, -(1 << 31), slow)
            let span = asm.mul(slope, last)
            let low = asm.add(base, lo)
            let high = asm.add(base, hi)
            asm.br(LT, low, 0, slow)
            asm.br(LT, asm.add(low, span), 0, slow)
            asm.br(GE, high, v.count, slow)
            asm.br(GE, asm.add(high, span), v.count, slow)
        }
    }

    range-bound(a: Any, b: Any, inclusive?: Bool, vname: String, body: Any) -> String | nil {
        let ty.Count(ty.Id(id)) = b or return nil
        let ty.Int(n) = a or return nil
        let assigned = %{}
        assigned-names(body, assigned)
        (n >= 0 && !inclusive? && container(ty.Id(id)) != nil && !assigned[vname]) ? id.name : nil
    }

    element-loop(names: Array[String], e: Any) {
        let v = container(e.iter) ?? fail('for loops iterate ranges, Blobs, or Arrays')
        if v.kind == 'string' || #names > 2 {
            fail('element loops bind one or two names over a Blob or Array')
        }
        let counter = asm.reg(I64, 0)
        counted-loop(counter, asm.reg(I64, v.count), false, e, -> do {
            let x = load-element(v, counter)
            define(names[0], Var('scalar', asm.reg(type-of(x), x)))
            if #names == 2 {
                define(names[1], Var('scalar', asm.reg(I64, counter)))
            }
        })
    }

    counted-loop(counter: Reg, limit: Reg, inclusive?: Bool, e: Any, bind: () -> _) {
        let (top, next, done) = (asm.label(), asm.label(), asm.label())
        let cc = inclusive? ? LE : LT
        asm.br(negate-condition(cc), counter, limit, done)
        __scopes.push(%{})
        asm.bind(top)
        bind()
        if let $cond = e.?`while` {
            branch(cond, false, done)
        }
        if let $guard = e.?`if` {
            branch(guard, false, next)
        }
        __loops.push((next, done))
        statement(e.expr)
        __loops.pop()
        __scopes.pop()
        asm.bind(next)
        counter.set(asm.add(counter, 1))
        asm.br(cc, counter, limit, top)
        asm.bind(done)
    }

    expression(node: Any, expected: Type | nil = nil) -> Val {
        match node {
            ty.Int(n) => n,
            ty.Float(x) => x,
            ty.Bool(b) => asm.reg(BOOL, b ? 1 : 0),
            ty.Id(id) => variable(id.name, node, expected),
            asm-ast.Hole(i) => asm-hole(i, expected),
            asm-ast.Cast(x, name) => convert(expression(x), lir-type(name)),
            asm-ast.Unsigned(op, a, b) => unsigned(op, a, b),
            ty.Neg(x) => negate(expression(x, expected)),
            ty.UserOp('~', x) => asm.bnot(reg(integer(expression(x, expected)))),
            ty.Not(_) or ty.And(_, _) or ty.Or(_, _) => boolean(node),
            ty.Count(x) => count(x),
            ty.Subscript(x, i) => subscript(x, i),
            ty.Cond(c, a, b) => conditional(c, a, b, expected),
            ty.Call(c) => call(c.func, [arg-node(it) for c.args], expected),
            ty.MethodCall(m) => method-call(m.object, m.method, [arg-node(it) for m.args]),
            ty.MemberAccess(x, field) => member(x, field),
            _ => compound(node, expected),
        }
    }

    compound(node: Any, expected: Type | nil) -> Val {
        let (op, a, b) = operands(node) ?? fail("unsupported expression: {ast-tag-name(node)}")
        op in COMPARE ? boolean(node) : arithmetic(op, a, b, expected)
    }

    arg-node(arg: Any) -> Any {
        let ty.Arg(a) = arg
        if a.?name != nil || a.?cond != nil {
            fail('keyword and conditional arguments are not supported')
        }
        a.arg
    }

    variable(vname: String, node: Any, expected: Type | nil) -> Val {
        if let $v = scalar-var(vname) {
            return v.reg
        }
        if !safe {
            fail("undefined register '{vname}'")
        }
        let value = j._static-value(node)
        let type = known-type(value, nil) ?? fail("'{vname}' is not a kernel variable or a constant known at compile time")
        if vname not in __hole-ids {
            holes.push(node)
            __hole-ids[vname] = #holes - 1
        }
        asm.reg(type, Hole(__hole-ids[vname] as Int, type))
    }

    known-type(value: Any, fallback: Type | nil) -> Type | nil {
        match value {
            _: Float    => F64,
            _: Bool     => BOOL,
            _: Int      => I64,
            _: Ptr[Any] => PTR,
            nil         => fallback,
            _           => safe ? nil : VAL,
        }
    }

    asm-hole(i: Int, expected: Type | nil) -> Reg {
        let type = known-type(known[i], expected ?? I64) ?? I64
        asm.reg(type, Hole(i, type))
    }

    integer(v: Val) -> Val {
        let t = type-of(v)
        if float-type?(t) {
            fail("expected an integer but found a {type-name(t)}")
        }
        t == BOOL && safe ? convert(v, I64) : v
    }

    negate(v: Val) -> Val {
        match v {
            n: Int   => -n,
            x: Float => -x,
            r: Reg   => float-type?(r.type) ? asm.fneg(r) : asm.neg(reg(integer(r))),
        }
    }

    arithmetic(op: String, left: Any, right: Any, expected: Type | nil = nil) -> Val {
        let a = expression(left, expected)
        combine(op, a, expression(right, (a :: Reg) ? (a as Reg).type : expected))
    }

    combine(op: String, a: Val, b: Val) -> Val {
        let type = common(a, b)
        if float-type?(type) {
            return float-arithmetic(op, reg(implicit(a, type), type), implicit(b, type))
        }
        if safe && (type-of(a) not in [I64, BOOL] || type-of(b) not in [I64, BOOL]) {
            fail("arithmetic on a {type-name(type-of(a))} and a {type-name(type-of(b))}")
        }
        let x = reg(convert(integer(a), type), type)
        let y = convert(integer(b), type == PTR ? I64 : type)
        if safe && op in ['Div', 'Mod'] {
            return int-division(BINARY[op] as String, x, y)
        }
        asm.binary(BINARY[op] ?? fail("unsupported operator {op}"), x, y)
    }

    unsigned(op: String, left: Any, right: Any) -> Val {
        let a = reg(expression(left))
        let b = convert(expression(right, a.type), a.type)
        if let $cc = COMPARE[op] {
            return asm.setcc(UNSIGNED_CC[cc] as Int, a, b)
        }
        asm.binary(UNSIGNED[op] ?? fail("unsupported unsigned operator {op}"), a, b)
    }

    int-division(code: String, x: Reg, y: Val) -> Reg {
        if let n: Int = y and n != 0 and n != -1 {
            return asm.binary(code, x, n)
        }
        let d = reg(y, I64)
        let out = asm.reg(I64)
        let special = asm.label()
        let done = asm.label()
        asm.br(EQ, d, 0, fault(1, nil, 0))
        asm.br(EQ, d, -1, special)
        out.set(asm.binary(code, x, d))
        asm.jmp(done)
        asm.bind(special)
        out.set(code == 'SDIV' ? asm.neg(x) : 0)
        asm.bind(done)
        out
    }

    float-arithmetic(op: String, x: Reg, y: Val) -> Reg {
        if safe && op in ['Div', 'Mod'] {
            asm.br(FEQ, reg(y, x.type), 0.0, fault(1, nil, 0))
        }
        if op == 'Mod' {
            return libm('fmod', [x, reg(y, F64)])
        }
        asm.binary(FLOAT_BINARY[op] ?? fail("unsupported Float operator {op}"), x, y)
    }

    boolean(node: Any) -> Reg {
        let out = asm.reg(BOOL, 1)
        let done = asm.label()
        branch(node, true, done)
        out.set(0)
        asm.bind(done)
        out
    }

    branch(node: Any, truth: Bool, target: Label) {
        match node {
            ty.Not(x)    => branch(x, !truth, target),
            ty.And(a, b) => logical(a, b, truth, !truth, target),
            ty.Or(a, b)  => logical(a, b, truth, truth, target),
            ty.Bool(b) => do {
                if b == truth {
                    asm.jmp(target)
                }
            },
            asm-ast.Unsigned(op, a, b) and op in COMPARE => do {
                let x = reg(expression(a))
                let cc = UNSIGNED_CC[COMPARE[op] as Int] as Int
                asm.br(truth ? cc : negate-condition(cc), x, convert(expression(b, x.type), x.type), target)
            },
            _ => do {
                if let (op, a, b) = operands(node) and op in COMPARE {
                    return compare(COMPARE[op] as Int, a, b, truth, target)
                }
                let v = reg(expression(node))
                if safe && v.type != BOOL {
                    fail("conditions must be Bool, found {type-name(v.type)}")
                }
                if float-type?(v.type) {
                    asm.br(truth ? FNE : FEQ, v, 0.0, target)
                } else if truth {
                    asm.brnz(v, target)
                } else {
                    asm.brz(v, target)
                }
            },
        }
    }

    logical(a: Any, b: Any, truth: Bool, simple: Bool, target: Label) {
        if simple {
            branch(a, truth, target)
            branch(b, truth, target)
        } else {
            let skip = asm.label()
            branch(a, !truth, skip)
            branch(b, truth, target)
            asm.bind(skip)
        }
    }

    compare(cc: Int, left: Any, right: Any, truth: Bool, target: Label) {
        let a = expression(left)
        let b = expression(right, (a :: Reg) ? (a as Reg).type : nil)
        let type = common(a, b)
        let x = reg(implicit(a, type), type)
        let y = implicit(b, type == PTR ? I64 : type)
        if float-type?(type) {
            cc += FEQ
        }
        if truth || !float-type?(type) || cc in [FEQ, FNE] {
            return asm.br(truth ? cc : negate-condition(cc), x, y, target)
        }
        let skip = asm.label()
        asm.br(cc, x, y, skip)
        asm.jmp(target)
        asm.bind(skip)
    }

    conditional(cond: Any, a: Any, b: Any, expected: Type | nil) -> Reg {
        let (other, done) = (asm.label(), asm.label())
        branch(cond, false, other)
        let x = expression(a, expected)
        let out = asm.reg(type-of(x), x)
        asm.jmp(done)
        asm.bind(other)
        let y = expression(b, out.type)
        if safe && type-of(y) != out.type && !(y :: Int && out.type == I64) {
            fail('both branches of ?: must have the same type')
        }
        out.set(convert(y, out.type))
        asm.bind(done)
        out
    }

    count(x: Any) -> Reg {
        let v = container(x) ?? fail('# applies to Blob and Array parameters')
        v.kind == 'string' ? fail('#s counts characters; use s.size() for the byte length') : v.count
    }

    checked-index(v: Var, index: Any) -> Reg {
        if let ty.Id(id) = index and let $iv = lookup(id.name) and iv.bound != nil and container(ty.Id(name: iv.bound)) == v {
            return iv.reg
        }
        if __proven.any?(vs -> v in vs) {
            return reg(integer(expression(index)), I64)
        }
        let raw = reg(integer(expression(index)), I64)
        if natural?(index) {
            asm.br(UGE, raw, v.count, fault(0, v.reg, raw))
            return raw
        }
        let i = asm.reg(I64, raw)
        let positive = asm.label()
        asm.br(GE, i, 0, positive)
        i.set(asm.add(i, v.count))
        asm.bind(positive)
        asm.br(UGE, i, v.count, fault(0, v.reg, raw))
        i
    }

    natural?(x: Any) -> Bool {
        match unwrap(x) {
            ty.Int(k) => k >= 0,
            ty.BitAnd(ty.Int(k), _) or ty.BitAnd(_, ty.Int(k)) => k >= 0,
            ty.Subscript(c, _) => unsigned?(container(c)),
            _ => false,
        }
    }

    unsigned?(v: Var | nil) -> Bool {
        let $c = v or return false
        c.kind in ['blob', 'string'] || (c.kind == 'view' && c.elem in [U8, U16, U32])
    }

    subscript(x: Any, index: Any) -> Val {
        if let $v = container(x) {
            if v.kind == 'string' {
                fail('s[i] is a character; use s.byte(i)')
            }
            return load-element(v, checked-index(v, index))
        }
        asm.load(memory(x, index))
    }

    memory(x: Any, addr: Any) -> Mem {
        let name = ast-name(x) ?? fail('subscripts apply to containers or typed memory')
        if safe || lookup(name) != nil {
            fail("'{name}' cannot be subscripted")
        }
        address(lir-type(name), addr)
    }

    address(type: Type, addr: Any) -> Mem {
        match addr {
            ty.Add(base, ty.Int(n)) => displaced(address(type, base), n),
            ty.Sub(base, ty.Int(n)) => displaced(address(type, base), -n),
            ty.Add(base, ty.Mul(index, ty.Int(n))) and n in [1, 2, 4, 8] => Mem(reg(expression(base), PTR), reg(expression(index), I64), n, 0, type),
            ty.Add(base, index) and pointer?(base) && !pointer?(index) => Mem(reg(expression(base), PTR), reg(expression(index), I64), 1, 0, type),
            _ => reg(expression(addr), PTR).off(type, 0),
        }
    }

    pointer?(node: Any) -> Bool {
        match node {
            ty.Id(id) => lookup(id.name).?reg.?type == PTR,
            _         => false,
        }
    }

    displaced(mem: Mem, n: Int) -> Mem {
        Mem(mem.base, mem.index, mem.scale, mem.disp + n, mem.type)
    }

    element-address(v: Var, i: Reg) -> Reg { asm.add(v.data, asm.shl(i, 5)) }

    load-element(v: Var, i: Reg) -> Val {
        if v.kind == 'view' {
            let raw = asm.load(Mem(v.data, i, v.elem.size, 0, v.elem))
            return convert(raw, float-type?(v.elem) ? F64 : I64)
        }
        if v.kind in ['blob', 'string'] {
            return convert(asm.load(Mem(v.data, i, 1, 0, U8)), I64)
        }
        let p = element-address(v, i)
        let kind = asm.load(p.off(U8, layout.OFF_TYPE))
        if v.kind == 'ints' {
            asm.br(NE, kind, j.tag.INT, fault(3, p, i))
            return asm.load(p.off(I64, layout.OFF_Z))
        }
        let out = asm.reg(F64)
        let (integer, done) = (asm.label(), asm.label())
        asm.br(NE, kind, j.tag.FLOAT, integer)
        out.set(asm.load(p.off(F64, layout.OFF_REAL)))
        asm.jmp(done)
        asm.bind(integer)
        asm.br(NE, kind, j.tag.INT, fault(3, p, i))
        out.set(asm.i2f(asm.load(p.off(I64, layout.OFF_Z))))
        asm.bind(done)
        out
    }

    store-element(v: Var, i: Reg, value: Val, tagged?: Bool = false) {
        if v.kind == 'view' {
            let wide = float-type?(v.elem) ? F64 : I64
            return asm.store(Mem(v.data, i, v.elem.size, 0, v.elem), convert(reg(implicit(value, wide), wide), v.elem))
        }
        if v.kind == 'blob' {
            return asm.store(Mem(v.data, i, 1, 0, U8), reg(implicit(value, I64), I64))
        }
        let float? = v.kind == 'floats'
        let type = float? ? F64 : I64
        let p = element-address(v, i)
        if tagged? && !float? {
            return asm.store(p.off(I64, 8), reg(implicit(value, I64), I64))
        }
        asm.store(p.off(U64, 0), float? ? j.tag.FLOAT : j.tag.INT)
        asm.store(p.off(U64, 16), 0)
        asm.store(p.off(U64, 24), 0)
        asm.store(p.off(type, 8), reg(implicit(value, type), type))
    }

    member(x: Any, name: String) -> Val {
        let v = reg(expression(x))
        let float? = float-type?(v.type)
        match name {
            'abs' => float? ? asm.fabs(v) : int-abs(reg(integer(v), I64)),
            'float' => convert(v, F64),
            'int' and float? => asm.f2i(v),
            'sqrt' => asm.fsqrt(reg(implicit(v, F64), F64)),
            f and f in ['floor', 'ceil', 'round'] && float? => libm(f, [v]),
            'iround' and float? => asm.f2i(libm('round', [v])),
            _ => fail("unsupported member {v.type}.{name}"),
        }
    }

    int-abs(x: Reg) -> Reg {
        let out = asm.reg(I64, x)
        let done = asm.label()
        asm.br(GE, x, 0, done)
        out.set(asm.neg(x))
        asm.bind(done)
        out
    }

    libm(name: String, args: Array[Reg]) -> Reg {
        let f = c.dlsym(name) ?? fail("libm function '{name}' is unavailable")
        asm.ccall(f, args, ret: F64, sig: [F64 for args]) as Reg
    }

    method-call(object: Any, name: String, args: Array[Any]) -> Val {
        if let $v = container(object) {
            return match (v.kind, name, #args) {
                ('string' or 'blob', 'size', 0) => v.count,
                ('string', 'byte', 1) => load-element(v, checked-index(v, args[0])),
                _ => fail("unsupported method {v.kind}.{name}()"),
            }
        }
        if name == 'clamp' && #args == 2 {
            return extreme(false, extreme(true, expression(object), expression(args[0])), expression(args[1]))
        }
        fail("unsupported method .{name}()")
    }

    extreme(greatest: Bool, a: Val, b: Val) -> Val {
        let type = common(a, b)
        let x = reg(implicit(a, type), type)
        let y = reg(implicit(b, type), type)
        asm.select((greatest ? GT : LT) + (float-type?(type) ? FEQ : 0), y, x, y, x)
    }

    call(func: Any, args: Array[Any], expected: Type | nil) -> Val {
        let result = match func {
            ty.MemberAccess(ty.Id(id), name) and id.name == 'rt' && lookup('rt') == nil
                => helper-call(rt.helper(name), args, 'CALL'),
            asm-ast.Hole(i)    => hole-call(i, args, expected, 'CALL'),
            ty.Id(id) and safe => builtin-call(id.name, func, args),
            _                  => fail('calls must target a {...} hole or an rt helper'),
        }
        result ?? (expected == VOID ? 0 : fail('void call used as a value'))
    }

    builtin-call(name: String, func: Any, args: Array[Any]) -> Val {
        match (name, #args) {
            ('int', 1) => do {
                let v = expression(args[0])
                float-type?(type-of(v)) ? asm.f2i(reg(v)) : integer(v)
            },
            ('float', 1) => implicit(integer(expression(args[0])), F64),
            ('abs', 1)   => member(args[0], 'abs'),
            ('min' or 'max', n) and n >= 2 => do {
                let acc = expression(args[0])
                for args[1;] {
                    acc = extreme(name == 'max', acc, expression(it))
                }
                acc
            },
            _ => static-call(name, func, args),
        }
    }

    static-call(name: String, func: Any, args: Array[Any]) -> Val {
        let target = j._static-value(func)
        if target == math.sqrt && #args == 1 {
            return asm.fsqrt(reg(implicit(integer(expression(args[0])), F64), F64))
        }
        if let $f = LIBM[target] {
            return libm(f, [reg(implicit(integer(expression(it)), F64), F64) for args])
        }
        if let $inlined = inline-call(name, args) {
            return inlined
        }
        let (params, ret) = (target :: Fn ? kernel-signature(target as Fn) : nil)
            ?? (name != asm.name ? kernel-signatures[name] : nil)
            ?? fail("cannot call '{name}' from a kernel")
        if #args != #params {
            fail("wrong number of arguments to kernel '{name}'")
        }
        let values = []
        for (node, kind) in args.zip(params) {
            if kind in ['blob', 'string', 'ints', 'floats'] {
                let v = container(node) ?? fail("kernel argument must be a {kind} parameter")
                values.push(v.kind == kind ? v.reg : fail("expected a {kind} argument, found a {v.kind}"))
            } else {
                let t = lir-type(kind)
                values.push(reg(implicit(expression(node, t), t), t))
            }
        }
        holes.push(func)
        let types = [lir-type(it) for params]
        call-op(asm, 'CALL', Hole(#holes - 1, PTR, callee?: true), values, lir-type(ret),
                types, true, true, 0, nil) ?? 0
    }

    inline-call(name: String, args: Array[Any]) -> Val | nil {
        if name == asm.name || #__inline >= 3 || getenv('TY_KERNEL_NO_INLINE') != nil {
            return nil
        }
        let $callee = kernel-bodies[name] or return nil
        let (params, ret, body) = callee
        if #args != #params || weight(body) > 80 {
            return nil
        }
        let scope = %{}
        for (node, (pname, kind)) in args.zip(params) {
            if kind in ['blob', 'string', 'ints', 'floats'] {
                let v = container(node) ?? fail("kernel argument must be a {kind} parameter")
                if v.kind != kind {
                    fail("expected a {kind} argument, found a {v.kind}")
                }
                let alias = Var(kind, v.reg)
                alias.data = v.data
                alias.count = v.count
                scope[pname] = alias
            } else {
                let t = lir-type(kind)
                scope[pname] = Var('scalar', asm.reg(t, reg(implicit(expression(node, t), t), t)))
            }
        }
        prepare-views(body, scope.values().filter(v -> v.kind == 'blob'))
        let rt = (ret == 'void') ? VOID : lir-type(ret)
        let out = (rt == VOID) ? nil : asm.reg(rt)
        let end = asm.label()
        let saved = (__scopes, __loops, __proven)
        __scopes = [scope]
        __loops = []
        __proven = []
        __inline.push((out, end, rt))
        let done? = (rt != VOID) ? tail(body) : statement(body)
        if !done? {
            if rt == VOID {
                asm.jmp(end)
            } else {
                raise(4)
            }
        }
        __inline.pop()
        (__scopes, __loops, __proven) = saved
        asm.bind(end)
        out ?? 0
    }

    helper-call(helper: rt.Helper, args: Array[Any], op: String) -> Reg | nil {
        let types = #args == #helper.params - 1 ? helper.params[1;] : helper.params
        if #args != #types {
            fail("wrong argument count for rt.{helper.name}")
        }
        let values = [reg(convert(expression(node, t), t), t) for (node, t) in args.zip(types)]
        call-op(asm, op, helper, values, VOID, nil, false, false, 0, nil)
    }

    hole-call(i: Int, args: Array[Any], expected: Type | nil, op: String) -> Reg | nil {
        let signature = known[i] == nil ? nil : j._sig(known[i])
        let (ret, values, types) = if signature == nil {
            let regs = [reg(expression(it)) for args]
            (expected ?? I64, regs, [it.type for regs])
        } else {
            (TYPES[signature[0]], [], [TYPES[it] for signature[1]])
        }
        if #args != #types {
            fail('callee argument count does not match signature')
        }
        if signature != nil {
            values = [reg(convert(expression(node, t), t), t) for (node, t) in args.zip(types)]
        }
        call-op(asm, op, Hole(i, PTR, callee?: true), values, ret, types, false, false,
                signature.?[4] ?? 0, signature.?[3] ? signature.?[2] : nil)
    }

    raw(name: String, args: Array[Any]) -> Bool {
        match name {
            'RET' => return-value(args[0]),
            'JMP' => asm.jmp(label(raw-name(args[0]))),
            'FENCE' => asm.fence(),
            'SITE' => asm.site(raw-number(args[0])),
            'ENTRY' => asm.entry(label(raw-name(args[0]))),
            'SWITCH' => asm.switch(reg(expression(args[0])), [label(raw-name(it)) for args[2;]], label(raw-name(args[1]))),
            'CALL' or 'TAILCALL' => raw-call(name, args),
            'RAW' => raw-words(args),
            _ => raw-scalar(name, args),
        }
        name in ['RET', 'JMP', 'TAILCALL']
    }

    raw-call(name: String, args: Array[Any]) {
        let dst = name == 'CALL' ? scalar-var(ast-name(args[0]) ?? '') : nil
        let target = dst == nil ? args[0] : args[1]
        let values = args[(dst == nil ? 1 : 2);]
        let type = name == 'TAILCALL' ? asm.result : (dst.?reg.?type ?? VOID)
        let result = match target {
            asm-ast.Hole(i)       => hole-call(i, values, type, name),
            ty.MemberAccess(_, h) => helper-call(rt.helper(h), values, name),
            _                     => fail('call target must be a {...} hole or an rt helper'),
        }
        if let $v = dst {
            v.reg.set(result)
        }
    }

    raw-words(args: Array[Any]) {
        let words = [raw-number(it) for args]
        if ARCH == 'arm64' {
            asm.raw(arm64: words)
        } else {
            asm.raw(x64: Blob(words))
        }
    }

    raw-scalar(name: String, args: Array[Any]) {
        let signature = OP_SIGNATURES[name] ?? fail("unknown instruction '{name}'")
        let dst? = signature.starts?('d,')
        let dst = dst? ? scalar-var(raw-name(args[0])).?reg : nil
        asm.emit(name, dst, [raw-operand(it) for args[(dst? ? 1 : 0);]])
    }

    raw-operand(node: Any) -> Array[Any] {
        match node {
            ty.Subscript(x, addr) => memory(x, addr).encode(asm),
            ty.Int(n)             => operand(asm, n),
            ty.Float(x)           => operand(asm, x),
            ty.Id(id) => do {
                if let $cc = RAW_CC[id.name] {
                    return [6, cc]
                }
                operand(asm, scalar-var(id.name).?reg ?? label(id.name))
            },
            _ => operand(asm, reg(expression(node))),
        }
    }

    raw-name(node: Any) -> String { ast-name(node) ?? fail('expected a name') }

    raw-number(node: Any) -> Int {
        let ty.Int(n) = node or fail('expected an integer')
        n
    }
}

fn kernel-signature(f: Fn) -> (Array[String], String) | nil {
    let (r, ps, _, _, _) = j._sig(f)
    let names = %{I64.code: 'Int', F64.code: 'Float', BOOL.code: 'Bool', VOID.code: 'void'}
    let ret = names[r] ?? return nil
    let params = []
    for ps {
        params.push(names[it] ?? return nil)
    }
    (params, ret)
}

fn ty-type(kind: String) -> Any {
    match kind {
        'Float' or 'f32' or 'f64' => $$[: Float $$],
        'Bool' or 'bool'          => $$[: Bool $$],
        'ptr' or 'ref'            => $$[: Ptr[Any] $$],
        'val'                     => ty.Any,
        'blob'                    => $$[: Blob $$],
        'string'                  => $$[: String $$],
        'ints'                    => $$[: Array[Int] $$],
        'floats'                  => $$[: Array[Float] $$],
        'void'                    => ty.Nil,
        _                         => $$[: Int $$],
    }
}

fn expansion(lower: Lower, params: Array[(String, String)], ret: String, holes: Array[Any]) -> Any {
    let encoding = lower.asm.serialize()
    let call = ty.Call(func: ty.Value(load), args: [
        ty.Arg(arg: ty.Value(encoding)),
        ty.Arg(arg: ty.Array([ty.ArrayItem(item: it) for holes])),
    ])
    let signature = ty.FuncType(
        ty.Record([ty.RecordEntry({item: ty-type(k)}) for (_, k) in params]),
        ty-type(ret)
    )
    ty.Cast(call, ty.And(ty.Value(Fn), signature))
}

class AsmToken {
    text: String;
    value: Any;
    start: Int;
    end: Int;

    init(text: String, value: Any, start: Int, end: Int) {
        self.text = text
        self.value = value
        self.start = start
        self.end = end
    }
}

let ASM_OPERATORS = ['<<=', '>>=', '<<', '>>', '<=', '>=', '==', '!=', '+=', '-=', '*=',
                     '/=', '%=', '&=', '|=', '^=', '&&', '||']
let ASM_PRECEDENCE = %{
    '||': 1, '&&': 2, '|': 3, '^': 4, '&': 5, '==': 6, '!=': 6,
    '<': 7, '<=': 7, '>': 7, '>=': 7, 'u<': 7, 'u<=': 7, 'u>': 7, 'u>=': 7,
    '<<': 8, '>>': 8, 'u>>': 8, '+': 9, '-': 9,
    '*': 10, '/': 10, '%': 10, 'u/': 10, 'u%': 10,
}
let ASM_BINARY = %{
    '+': 'Add', '-': 'Sub', '*': 'Mul', '/': 'Div', '%': 'Mod',
    '&': 'BitAnd', '|': 'BitOr', '^': 'Xor', '<<': 'Shl', '>>': 'Shr',
    '==': 'Eq', '!=': 'NotEq', '<': 'LT', '<=': 'LEQ', '>': 'GT', '>=': 'GEQ',
}
let ASM_NODES = %{
    'Add': ty.Add, 'Sub': ty.Sub, 'Mul': ty.Mul, 'Div': ty.Div, 'Mod': ty.Mod,
    'BitAnd': ty.BitAnd, 'BitOr': ty.BitOr, 'Xor': ty.Xor, 'Shl': ty.Shl, 'Shr': ty.Shr,
    'Eq': ty.Eq, 'NotEq': ty.NotEq, 'LT': ty.LT, 'LEQ': ty.LEQ, 'GT': ty.GT, 'GEQ': ty.GEQ,
    'MutAdd': ty.MutAdd, 'MutSub': ty.MutSub, 'MutMul': ty.MutMul, 'MutDiv': ty.MutDiv,
    'MutMod': ty.MutMod, 'MutAnd': ty.MutAnd, 'MutOr': ty.MutOr, 'MutXor': ty.MutXor,
    'MutShl': ty.MutShl, 'MutShr': ty.MutShr,
}
let ASM_MUTATE = %{
    '+=': 'MutAdd', '-=': 'MutSub', '*=': 'MutMul', '/=': 'MutDiv', '%=': 'MutMod',
    '&=': 'MutAnd', '|=': 'MutOr', '^=': 'MutXor', '<<=': 'MutShl', '>>=': 'MutShr',
}

fn word-char?(ch: String | nil) -> Bool {
    ch != nil && (('a' <= ch && ch <= 'z') || ('A' <= ch && ch <= 'Z') || ('0' <= ch && ch <= '9') || ch == '_')
}

fn digit?(ch: String | nil) -> Bool { ch != nil && '0' <= ch && ch <= '9' }

class AsmParser {
    __pending: Array[AsmToken];
    holes: Array[Any];
    known: Array[Any];
    position: Int;

    init() {
        __pending = []
        holes = []
        known = []
        position = jl.state().position.byte
    }

    read() -> AsmToken {
        while jl.peekc() in [' ', '\t', '\r'] {
            jl.getc()
        }
        let start = jl.state().position.byte
        let ch = jl.getc() ?? throw Error('asm!: unexpected end of source')
        let (text, value) = if ch == '\n' {
            (';', nil)
        } else if digit?(ch) || (ch == '.' && digit?(jl.peekc())) {
            ('number', number(ch))
        } else if word-char?(ch) {
            word(ch)
        } else {
            (symbol(ch), nil)
        }
        AsmToken(text, value, start, jl.state().position.byte)
    }

    word(first: String) -> (String, Any) {
        let chars = [first]
        while word-char?(jl.peekc()) {
            chars.push(jl.getc() as String)
        }
        let name = chars.join('')
        (name == 'u' && jl.peekc() in ['/', '%', '<', '>']) ? ("u{symbol(jl.getc() as String)}", nil) : (name, nil)
    }

    number(first: String) -> Int | Float {
        let chars = [first]
        while let $ch = jl.peekc() and (word-char?(ch) || ch == '.' || (ch in ['+', '-'] && chars[-1] in ['e', 'E'] && !chars.contains?('x'))) {
            chars.push(jl.getc() as String)
        }
        let digits = chars.join('').comb('_')
        (digits.starts?('0x') || !digits.match?(/[.eE]/)) ? int(digits) : float(digits)
    }

    symbol(first: String) -> String {
        let text = first
        while let $next = jl.peekc() and ASM_OPERATORS.any?(\_.starts?("{text}{next}")) {
            text = "{text}{jl.getc()}"
        }
        text
    }

    peek(n: Int = 0) -> AsmToken {
        while #__pending <= n {
            __pending.push(read())
        }
        __pending[n]
    }

    next() -> AsmToken {
        let token = peek()
        __pending.pop(0)
        position = token.end
        token
    }

    accept(text: String) -> Bool {
        if peek().text != text {
            return false
        }
        next()
        true
    }

    expect(text: String) -> AsmToken {
        let token = next()
        if token.text != text {
            throw Error("asm!: expected '{text}', found '{token.text}'", span: (0, token.start, token.end))
        }
        token
    }

    separators() {
        while accept(';') {
            ;
        }
    }

    hole() -> Any {
        if #__pending != 0 {
            throw Error('asm!: buffered tokens inside a Ty hole')
        }
        let expr = jp.expr()
        let close = jt.next()
        if close.type != '}' {
            throw Error('asm!: expected closing brace after a Ty expression')
        }
        holes.push(expr)
        known.push(j._static-value(expr))
        position = close.end.byte
        asm-ast.Hole(#holes - 1)
    }

    block() -> Any {
        expect('{')
        let out = []
        separators()
        while peek().text != '}' {
            let start = peek().start
            let body = statement()
            out.push(asm-ast.At(body, start, position))
            separators()
        }
        expect('}')
        ty.Block(out)
    }

    statement() -> Any {
        match peek().text {
            'if' => do {
                next()
                let cond = expression()
                let yes = block()
                separators()
                let no = !accept('else') ? nil : (peek().text == 'if' ? ty.Block([statement()]) : block())
                ty.If([cond], yes, no)
            },
            'while'    => do { next(); let cond = expression(); ty.While([cond], block())        },
            'loop'     => do { next(); ty.While([ty.Bool(true)], block())                        },
            'break'    => do { next(); ty.Break(value: nil, depth: 1)                            },
            'continue' => do { next(); ty.Continue(1)                                            },
            'goto'     => do { next(); asm-ast.Goto(next().text)                                 },
            'return'   => do { next(); ty.Return(peek().text in [';', '}'] ? nil : expression()) },
            '.' => do {
                next()
                let name = next().text.upper()
                let args = peek().text in [';', '}'] ? [] : [expression()]
                while accept(',') {
                    args.push(expression())
                }
                asm-ast.Raw(name, args)
            },
            _ => assignment(),
        }
    }

    assignment() -> Any {
        let first = peek().text
        if word-char?(first[0]) && peek(1).text == ':' {
            let name = next().text
            next()
            if peek().text not in ASM_TYPES {
                return asm-ast.Label(name)
            }
            let type = next().text
            let target = ty.Id(name: name, module: nil, constraint: ty.Id(name: type, module: nil, constraint: nil))
            return ty.Let(target, accept('=') ? expression() : nil)
        }
        let target = expression()
        let op = peek().text
        if op == '=' {
            next()
            return ty.Assign(target, expression())
        }
        if let $mutate = ASM_MUTATE[op] {
            next()
            return (ASM_NODES[mutate] as Any)(target, expression())
        }
        target
    }

    expression(min: Int = 0) -> Any {
        let left = primary()
        while (ASM_PRECEDENCE[peek().text] ?? -1) >= min {
            let op = next().text
            let right = expression((ASM_PRECEDENCE[op] as Int) + 1)
            left = binary(op, left, right)
        }
        left
    }

    binary(op: String, a: Any, b: Any) -> Any {
        match op {
            '&&'                  => ty.And(a, b),
            '||'                  => ty.Or(a, b),
            _ and op.starts?('u') => asm-ast.Unsigned(ASM_BINARY[op[1;]] as String, a, b),
            _                     => (ASM_NODES[ASM_BINARY[op] as String] as Any)(a, b),
        }
    }

    primary() -> Any {
        let token = next()
        let value = match token.text {
            'number' => (token.value :: Float) ? ty.Float(token.value) : ty.Int(token.value),
            '('      => do { let x = expression(); expect(')'); x },
            '{'      => hole(),
            '-'      => ty.Neg(primary()),
            '+'      => primary(),
            '~'      => ty.UserOp('~', primary()),
            '!'      => ty.Not(primary()),
            'true'   => ty.Int(1),
            'false'  => ty.Int(0),
            'rt' => do {
                expect('.')
                let parts = [next().text]
                while accept('-') {
                    parts.push(next().text)
                }
                ty.MemberAccess(ty.Id(name: 'rt', module: nil, constraint: nil), parts.join('-'))
            },
            name and name in ASM_TYPES && peek().text == '[' => do {
                next()
                let addr = expression()
                expect(']')
                ty.Subscript(ty.Id(name: name, module: nil, constraint: nil), addr)
            },
            name => ty.Id(name: name, module: nil, constraint: nil),
        }
        while peek().text in ['(', 'as'] {
            if accept('as') {
                value = asm-ast.Cast(value, next().text)
            } else {
                next()
                let args = peek().text == ')' ? [] : [expression()]
                while accept(',') {
                    args.push(expression())
                }
                expect(')')
                value = ty.Call(func: value, args: [ty.Arg(arg: it) for args])
            }
        }
        value
    }
}

fn header-word() -> String {
    let token = jt.next()
    token.?id ?? token.type
}

fn header-expect(word: String) {
    let actual = header-word()
    if actual != word {
        throw Error("asm!: expected '{word}', found '{actual}'")
    }
}

fn expand-asm() -> Any {
    let name = header-word()
    header-expect('(')
    let params = []
    while jt.peek().type != ')' {
        let pname = header-word()
        header-expect(':')
        let type = header-word()
        if type not in ASM_TYPES {
            throw Error("asm!: unknown type '{type}'")
        }
        params.push((pname, type))
        if jt.peek().type != ')' {
            header-expect(',')
        }
    }
    header-expect(')')
    let ret = 'void'
    if jt.peek().type == '->' {
        jt.next()
        ret = header-word()
    }
    let mode = jt.peek().?id in ['attached', 'detached'] ? header-word() : nil
    let parser = AsmParser()
    let body = parser.block()
    let lower = Lower('asm!', name, params, ret, mode, parser.known)
    lower.function(body)
    expansion(lower, params, ret, parser.holes)
}

pub macro asm! { try { expand-asm() } catch e: Error { jp.fail(e.what) } }

fn kernel-param(p: Any) -> (String, String) {
    let ty.Param(pm) = p or throw Error('kernel!: kernels take plain positional parameters')
    if pm.?default != nil {
        throw Error("kernel!: parameter '{pm.name}' cannot have a default")
    }
    (pm.name, declared-type(pm.?constraint ?? throw Error("kernel!: parameter '{pm.name}' needs a type")))
}

fn expand-kernel() -> Any {
    let public? = jt.peek().type == 'pub'
    if public? {
        jt.next()
    }
    let ty.FuncDef(fd) = jp.stmt() or throw Error('kernel!: expected a function definition')
    let name = fd.name ?? throw Error('kernel!: kernels need a name')
    let params = [kernel-param(it) for (fd.params ?? [])]
    let ret = match fd.rt {
        nil or ty.Nil => 'void',
        ty.Id(id) and id.name in KERNEL_TYPES => id.name,
        _ => throw Error('kernel!: kernels return Int, Float, Bool, or nothing'),
    }
    let lower = Lower('kernel!', name, params, ret, nil, [])
    lower.function(fd.body)
    kernel-signatures[name] = ([k for (_, k) in params], ret)
    kernel-bodies[name] = (params, ret, fd.body)
    ty.Let(ty.Id(name: name), expansion(lower, params, ret, lower.holes), public: public?)
}

pub macro kernel! { try { expand-kernel() } catch e: Error { jp.fail(e.what) } }
