    );
    int LZ4_compress_continue(
        LZ4_stream_t* LZ4_streamPtr,
        const char* source,
        char* dest,
        int inputSize
    );
    int LZ4_compress_limitedOutput_continue(
        LZ4_stream_t* LZ4_streamPtr,
        const char* source,
        char* dest,
        int inputSize,
        int maxOutputSize
    );
    int LZ4_uncompress (const char* source, char* dest, int outputSize);
    int LZ4_uncompress_unknownOutputSize(
        const char* source,
        char* dest,
        int isize,
        int maxOutputSize
    );
    void* LZ4_create (char* inputBuffer);
    int LZ4_sizeofStreamState(void);
    int LZ4_resetStreamState(void* state, char* inputBuffer);
    char* LZ4_slideInputBuffer (void* state);
    int LZ4_decompress_safe_withPrefix64k(
        const char* src,
        char* dst,
        int compressedSize,
        int maxDstSize
    );
    int LZ4_decompress_fast_withPrefix64k (const char* src, char* dst, int originalSize);
