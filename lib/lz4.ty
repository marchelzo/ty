import ffi as c (C!)

if not let $lz4 = c.open('lz4') {
    throw RuntimeError('failed to open lz4 library')
}

const LZ4_i8 = c.i8
const LZ4_byte = c.u8
const LZ4_u16 = c.u16
const LZ4_u32 = c.u32

pub const LZ4_FREESTANDING = 0
pub const LZ4_MAX_INPUT_SIZE = 0x7E000000
pub const LZ4_MEMORY_USAGE_DEFAULT = 14
pub const LZ4_MEMORY_USAGE_MAX = 20
pub const LZ4_MEMORY_USAGE_MIN = 10
pub const LZ4_STREAMDECODE_MINSIZE = 32
pub const LZ4_VERSION_MAJOR = 1
pub const LZ4_VERSION_MINOR = 10
pub const LZ4_VERSION_RELEASE = 0

C! struct LZ4_stream_t_internal {
    LZ4_u32 hashTable[(1 << (14 - 2))];
    LZ4_byte* dictionary;
    LZ4_stream_t_internal* dictCtx;
    LZ4_u32 currentOffset;
    LZ4_u32 tableType;
    LZ4_u32 dictSize;
}

C! struct LZ4_streamDecode_t_internal {
    LZ4_byte* externalDict;
    LZ4_byte* prefixEnd;
    size_t extDictSize;
    size_t prefixSize;
}

C! lz4 fn {
    int LZ4_versionNumber (void);
    const char* LZ4_versionString (void);
    int LZ4_compress_default(const char* src, char* dst, int srcSize, int dstCapacity);
    int LZ4_decompress_safe(
        const char* src,
        char* dst,
        int compressedSize,
        int dstCapacity
    );
    int LZ4_compressBound(int inputSize);
    int LZ4_compress_fast(
        const char* src,
        char* dst,
        int srcSize,
        int dstCapacity,
        int acceleration
    );
    int LZ4_sizeofState(void);
    int LZ4_compress_fast_extState(
        void* state,
        const char* src,
        char* dst,
        int srcSize,
        int dstCapacity,
        int acceleration
    );
    int LZ4_compress_destSize(
        const char* src,
