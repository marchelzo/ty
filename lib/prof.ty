import dirs
import json
import math
import os
import ty
import ty.parse as parse
import chalk (chalk, hsl-hex, hash-hsl)
import ink (Component, Box, Raw, TreeView, Ignored, run, focus)
import ink.chart (LinePlot)
import term (event, mod)
import ty.jit as jit (Src, Op, Insn, Data)

pub const DEFAULT_PATH = 'ty-prof.data'

const SELECTED = '#343842'
const SHADE    = '#2b2f38'
const ACCENT   = '#e5c07b'
const BLOCKS   = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█']
const KIB      = 1024
const MIB      = 1024 * 1024
const GIB      = 1024 * 1024 * 1024

fn lerp(lo: Int, hi: Int, a: Float, x: Float, b: Float) -> Int {
    int(lo + (x - a) / (b - a) * (hi - lo))
}

pub fn heat(frac: Float) -> String {
    let p = math.sqrt(max(min(frac, 1.0), 0.0))
    let (r, g, b) = match p {
        _ and p < 0.1  => (lerp(0, 100, 0.0, p, 0.1), lerp(255, 225, 0.0, p, 0.1), 65),
        _ and p < 0.3  => (lerp(130, 180, 0.1, p, 0.3), lerp(200, 120, 0.1, p, 0.3), 40),
        _ and p < 0.65 => (lerp(200, 255, 0.3, p, 0.65), lerp(120, 60, 0.3, p, 0.65), 60),
        _              => (255, lerp(50, 20, 0.65, p, 1.0), 60)
    }
    "#{r:02x}{g:02x}{b:02x}"
}

fn hot(frac: Float, text: String) -> String {
    "{chalk"[{heat(frac)}]{text}[/]"}"
}

fn dim(text: String) -> String {
    "{chalk"[dim]{text}[/]"}"
}

fn bold(text: String) -> String {
    "{chalk"[b]{text}[/]"}"
}

fn place(file: String, line: Int) -> String {
    "{chalk"[cyan]{file}:{line}[/]"}"
}

pub fn fmt-bytes(b: Int | Float) -> String {
    match b {
        _ and b >= GIB => "{b / float(GIB):.2f} GiB",
        _ and b >= MIB => "{b / float(MIB):.1f} MiB",
        _ and b >= KIB => "{b / float(KIB):.1f} KiB",
        _              => "{int(b)} B"
    }
}

pub fn fmt-count(c: Int | Float) -> String {
    match c {
        _ and c >= 1e10 => "{c / 1e9:.1f}G",
        _ and c >= 1e7  => "{c / 1e6:.1f}M",
        _ and c >= 1e5  => "{c / 1e3:.0f}K",
        _               => str(int(c))
    }
}

pub fn fmt-ns(t: Int | Float) -> String {
    match t {
        _ and t >= 1e10 => "{t / 1e9:.1f}s",
        _ and t >= 1e9  => "{t / 1e9:.2f}s",
        _ and t >= 1e6  => "{t / 1e6:.1f}ms",
        _               => "{t / 1e3:.0f}µs"
    }
}

fn col(label: String, w: Int) -> String {
    dim(label.fit(w, 1))
}

fn sorted-col(label: String, w: Int, active?: Bool, desc?: Bool) -> String {
    if !active? {
        return col(label, w)
    }
    let text = "{label}{desc? ? '▼' : '▲'}".fit(w, 1)
    "{chalk"[b {ACCENT}]{text}[/]"}"
}

fn toggle(key: String, options: Array[String], active: String) -> String {
    let parts = options.map(o -> (o == active) ? "{chalk"[b {ACCENT}]{o}[/]"}" : dim(o))
    "{chalk"[cyan]{key}[/]"} {parts.join(dim(' · '))}"
}

fn spread(left: String, right: String, w: Int) -> String {
    let gap = w - left.width() - right.width() - 1
    (gap >= 2) ? "{left}{' ' * gap}{right}" : left
}

class Spot {
    file: String
    line: Int
    func: _
    notes: Array[String]

    init(file: String, line: Int, func: _ = nil, notes: Array[String] = []) {
        self.file = file
        self.line = line
        self.func = func
        self.notes = notes
    }
}

pub class Source {
    text: String
    starts: Array[Int]
    module: _
    painted: Dict[Int, String]

    init(text: String) {
        self.text = text
        starts = [0]
        let at = 0
        for line in text.split("\n") {
            at += line.size() + 1
            starts.push(at)
        }
        module = match ty.parse(text) {
            Ok(m) => m,
            _     => nil
        }
        painted = %{}
    }

    count -> Int { #starts - 1 }

    plain(line: Int) -> String {
        if line < 1 || line > count {
            return ''
        }
        let a = starts[line - 1]
        let b = max(starts[line] - 1, a)
        text.bslice(a, b - a)
    }

    line(n: Int) -> String {
        if let $s = painted[n] {
            return s
        }
        let plain = plain(n)
        let s = if module != nil && plain.size() > 0 && !chalk.plain? {
            let a = starts[n - 1]
            (try { parse.highlight(module, a, a + plain.size()) }) ?? plain
        } else {
            plain
        }
        let out = s.comb(/\n+$/)
        painted[n] = out
        out
    }
}

pub class TreeNode {
    func: Int
    path: String
    total: Int
    own: Int
    kids: Dict[Int, TreeNode]
    up: TreeNode | nil

    init(func: Int, path: String, up: TreeNode | nil = nil) {
        self.func = func
        self.path = path
        self.up = up
        total = 0
        own = 0
        kids = %{}
    }

    kid(f: Int) -> TreeNode {
        if let $k = kids[f] {
            return k
        }
        let k = TreeNode(f, "{path}/{f}", self)
        kids[f] = k
        k
    }

    sorted -> Array[TreeNode] {
        kids.values().sort!(by=\_.total, desc=true)
    }
}

pub class Profile {
    path: String
    data: _
    funcs: Array[_]
    lines: Array[_]
    stacks: Array[_]
    cats: Array[_]
    total: Int
    alloc-total: Int
    unit: String
    by-loc: Dict[String, _]
    sources: Dict[String, Source]

    init(path: String) {
        self.path = path
        data = json.parse(slurp(path) ?? throw Err("cannot read {path}"))
        funcs = data['functions']
        lines = data['lines']
        stacks = data['stacks']
        cats = data['category_order'] ?? []
        total = data['total']
        alloc-total = data['alloc_total']
        unit = data['unit']
        by-loc = %{}
        sources = %{}
        for l; i in lines {
            l['id'] = i
            by-loc["{l['file']}:{l['line']}"] = l
        }
        for f; i in funcs {
            f['id'] = i
        }
        let stats = data['jit_stats'] ?? %{}
        for r in [*(stats['sites'] ?? []), *(stats['compiled'] ?? [])] {
            r['file'] = display(r['file'] ?? '')
        }
    }

    display(path: String) -> String {
        let cwd = "{data['cwd'] ?? ''}/"
        let home = "{dirs.HOME}/"
        match () {
            _ and cwd != '/' && path.starts?(cwd)   => path[#cwd;],
            _ and home != '/' && path.starts?(home) => "~/{path[#home;]}",
            _                                       => path
        }
    }

    at(file: String, line: Int) -> _ {
        by-loc["{file}:{line}"]
    }

    source(file: String) -> Source | nil {
        if let $s = sources[file] {
            return s
        }
        let $text = (data['files'] ?? %{})[file] or return nil
        sources[file] = Source(text)
    }

    pct(w: Int | Float) -> Float {
        (total > 0) ? 100.0 * w / total : 0.0
    }

    qty(w: Int | Float) -> String {
        (unit == 'ns') ? fmt-ns(w) : fmt-count(w)
    }

    share(w: Int | Float) -> String {
        let p = pct(w)
        (p > 0) ? hot(p / 100, "{p:5.1f}%") : ' ' * 6
    }

    alloc-share(bytes: Int, width: Int = 9) -> String {
        if bytes == 0 || alloc-total == 0 {
            return ' ' * width
        }
        hot(bytes / float(alloc-total), fmt-bytes(bytes).fit(width, 1))
    }

    title -> String {
        let mode = match data['mode'] {
            'cpu'   => "CPU, {data['hz']} Hz",
            'wall'  => "Wall clock, {data['hz']} Hz",
            'event' => "{data['event']}, every {data['period']}",
            'ops'   => "Every {data['period']} bytecode ops",
            m       => m
        }
        [
            data['target'],
            mode,
            "{fmt-count(data['samples'])} samples",
            "{fmt-ns(data['wall_ns'])} wall"
        ].join(' · ')
    }

    tree(inverted?: Bool = false, kind: String = 'time') -> TreeNode {
        let root = TreeNode(-1, '')
        for s in stacks {
            let time? = s['kind'] != 'alloc' && s['kind'] != 'throw'
            if (kind == 'alloc') ? s['kind'] != 'alloc' : !time? {
                continue
            }
            let frames: Array[_] = s['frames']
            let w: Int = s['weight']
            let node = root
            root.total += w
            for fr in (inverted? ? frames.reverse() : frames) {
                node = node.kid(fr[0])
                node.total += w
            }
            node.own += w
        }
        root
    }

    func-named(name: String, file: String) -> _ {
        for f in funcs {
            if f['name'] == name && f['file'] == file {
                return f
            }
        }
        nil
    }

    compiled-for(f: _) -> _ {
        let best = nil
        for r in (data['jit_stats'] ?? %{})['compiled'] ?? [] {
            let label = r['class'] ? "{r['class']}.{r['name']}" : r['name']
            if label == f['name'] && r['file'] == f['file'] && r['code'] {
                if best == nil || (r['samples'] ?? 0) > (best['samples'] ?? 0) {
                    best = r
                }
            }
        }
        if best != nil {
            best['label'] = f['name']
        }
        best
    }

    hottest(f: _) -> Int {
        let best = 0
        let line = f['line']
        for l in lines {
            if l['func'] == f['id'] && l['self'] > best {
                best = l['self']
                line = l['line']
            }
        }
        line
    }

    edges(func: Int) -> (Array[_], Array[_]) {
        let callers = []
        let callees = []
        for e in data['edges'] {
            if e[1] == func {
                callers.push((funcs[e[0]], e[2]))
            }
            if e[0] == func {
                callees.push((funcs[e[1]], e[2]))
            }
        }
        (callers.sort!(by=\_.1, desc=true), callees.sort!(by=\_.1, desc=true))
    }
}

class Screen {
    title: String
    sel: Int
    top: Int
    filter: String

    init(title: String) {
        self.title = title
        sel = 0
        top = 0
        filter = ''
    }

    count -> Int { 0 }
    header(w: Int) -> String { '' }
    row(i: Int, w: Int) -> String { '' }
    hint -> String { '' }
    open(app: App) { }
    refresh() { }
    widget(h: Int) -> Component | nil { nil }
    key(app: App, k: String) -> Bool { false }
    preview -> Spot | nil { nil }
    previews? -> Bool { false }
    min-width -> Int { 0 }
    tree-view -> TreeView | nil { nil }

    move(n: Int) {
        sel = (sel + n).clamp(0, max(count - 1, 0))
    }

    view(w: Int, h: Int) -> (Array[String], Int) {
        let head = header(w)
        let room = head ? h - 1 : h
        sel = sel.clamp(0, max(count - 1, 0))
        top = top.clamp(sel - room + 1, sel).clamp(0, max(count - room, 0))
        let out = head ? [head.fit(w)] : []
        let at = (count > 0) ? #out + sel - top : -1
        for i in top..min(top + room, count) {
            out.push(row(i, w).fit(w))
        }
        (out, at)
    }
}

fn matches?(name: String, file: String, filter: String) -> Bool {
    let f = filter.lower()
    !f || f in name.lower() || f in file.lower()
}

fn jit-label(kind: String) -> String {
    let label = kind.fit(8)
    match kind {
        'declined'         => "{chalk"[red]{label}[/]"}",
        'tier1' or 'tier2' => "{chalk"[green]{label}[/]"}",
        _                  => dim(label)
    }
}

fn cycle(options: Array[String], at: String) -> String {
    for o; i in options {
        if o == at {
            return options[(i + 1) % #options]
        }
    }
    options[0]
}

class Functions < Screen {
    prof: Profile
    rows: Array[_]
    sort: String
    desc?: Bool
    name-w: Int
    most-calls: Int

    init(prof: Profile) {
        super('Functions')
        self.prof = prof
        sort = 'self'
        desc? = true
        refresh()
    }

    refresh() {
        let key = sort
        rows = prof.funcs
            .filter(f -> f[key] > 0 && matches?(f['name'], f['file'], filter))
            .sort!(by=\_[key], desc=desc?)
        name-w = (rows[;200].map(\_['name'].width()).max() ?? 8).clamp(8, 48)
        most-calls = max(prof.funcs.map(\_['calls']).max() ?? 1, 1)
    }

    count -> Int { #rows }

    hint -> String { 's sort · S reverse · d disassembly' }

    previews? -> Bool { true }

    header(w: Int) -> String {
        [
            sorted-col('self', 6, sort == 'self', desc?),
            sorted-col('total', 6, sort == 'total', desc?),
            sorted-col('calls', 8, sort == 'calls', desc?),
            sorted-col('alloc', 9, sort == 'alloc_total', desc?),
            dim('JIT'.fit(8)),
            dim('function'.fit(name-w)),
            dim('location')
        ].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let f = rows[i]
        let calls = (f['calls'] > 0) ? fmt-count(f['calls']) : ''
        [
            prof.share(f['self']),
            prof.share(f['total']),
            (f['calls'] > 0) ? hot(f['calls'] / float(most-calls), calls.fit(8, 1)) : ' ' * 8,
            prof.alloc-share(f['alloc_total']),
            jit-label(f['jit']),
            bold(f['name'].fit(name-w)),
            place(f['file'], f['line'])
        ].join(' ')
    }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        let f = rows[sel]
        Spot(f['file'], prof.hottest(f), f)
    }

    open(app: App) {
        if #rows > 0 {
            let f = rows[sel]
            app.push(SourceView(prof, f['file'], f['line'], f))
        }
    }

    key(app: App, k: String) -> Bool {
        match k {
            's' => sort = cycle(['self', 'total', 'calls', 'alloc_total'], sort),
            'S' => desc? = !desc?,
            'd' => {
                if #rows > 0 and let $r = prof.compiled-for(rows[sel]) {
                    app.push(Disasm(prof, r))
                }
                return true
            },
            _   => return false
        }
        refresh()
        true
    }
}

class Lines < Screen {
    prof: Profile
    rows: Array[_]
    sort: String
    desc?: Bool

    init(prof: Profile, sort: String = 'self', title: String = 'Lines') {
        super(title)
        self.prof = prof
        self.sort = sort
        desc? = true
        refresh()
    }

    refresh() {
        let key = sort
        rows = prof.lines
            .filter(l -> l[key] > 0 && matches?(l['text'] ?? '', l['file'], filter))
            .sort!(by=\_[key], desc=desc?)
    }

    count -> Int { #rows }

    hint -> String { 's sort · S reverse' }

    previews? -> Bool { true }

    header(w: Int) -> String {
        let alloc = (sort == 'retained') ? 'retained' : 'alloc'
        [
            sorted-col('self', 6, sort == 'self', desc?),
            sorted-col('total', 6, sort == 'total', desc?),
            sorted-col(alloc, 9, sort == 'alloc' || sort == 'retained', desc?),
            dim('location'.fit(28)),
            dim('source')
        ].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let l = rows[i]
        let src = prof.source(l['file'])
        let text = (src != nil) ? src.line(l['line']) : (l['text'] ?? '')
        let bytes = (sort == 'retained') ? l['retained'] : l['alloc']
        [
            prof.share(l['self']),
            prof.share(l['total']),
            prof.alloc-share(bytes),
            place(l['file'], l['line']).fit(28),
            text.strip()
        ].join(' ')
    }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        let l = rows[sel]
        Spot(l['file'], l['line'], prof.funcs[l['func']])
    }

    open(app: App) {
        if #rows > 0 {
            app.push(SourceView(prof, rows[sel]['file'], rows[sel]['line'], nil))
        }
    }

    key(app: App, k: String) -> Bool {
        match k {
            's' => sort = cycle(['self', 'total', 'alloc', 'retained'], sort),
            'S' => desc? = !desc?,
            _   => return false
        }
        refresh()
        true
    }
}

class CallTree < TreeView {
    handles-tab? -> Bool { true }
}

class Tree < Screen {
    prof: Profile
    inverted?: Bool
    kind: String
    root: TreeNode
    rebuilds: Int
    tree: CallTree
    cursor: TreeNode | nil
    poke: Function

    init(prof: Profile, push: Function, poke: Function) {
        super('Call tree')
        self.prof = prof
        self.poke = poke
        inverted? = false
        kind = 'time'
        rebuilds = 0
        cursor = nil
        root = prof.tree()
        tree = CallTree(
            root: root,
            children: kids,
            key: \_.path,
            label: label,
            gutter: gutter,
            expanded: hot-path(root),
            show-root?: false,
            cursor-bg: SELECTED,
            revision: 0,
            on-cursor: node -> moved(node),
            on-key: (ev, node) -> match ev {
                event.Key({key: 'ENTER', event: 1, *}) and node != nil => push(source(node)),
                _                                                      => nil
            }
        )
    }

    hint -> String { '←/→ fold · z zoom' }

    previews? -> Bool { true }

    tree-view -> TreeView | nil { tree }

    header(w: Int) -> String {
        let label = inverted? ? 'function ← callers' : 'function → callees'
        let left = [col('total', 6), col('self', 6), '  ', dim(label)].join(' ')
        let modes = [
            toggle('i', ['callees', 'callers'], inverted? ? 'callers' : 'callees'),
            toggle('a', ['time', 'alloc'], kind)
        ]
        spread(left, modes.join('   '), w)
    }

    widget(h: Int) -> Component | nil {
        tree.height = h
        tree
    }

    moved(node: TreeNode | nil) {
        cursor = node
        poke()
    }

    preview -> Spot | nil {
        let $node = cursor ?? root.sorted[0] or return nil
        if node.func < 0 {
            return nil
        }
        let f = prof.funcs[node.func]
        Spot(f['file'], prof.hottest(f), f)
    }

    rebuild() {
        root = prof.tree(inverted?: inverted?, kind: kind)
        rebuilds += 1
        tree.root = root
        tree.expanded = hot-path(root)
        tree.revision = rebuilds
        cursor = nil
    }

    kids(node: TreeNode) -> Array[TreeNode] {
        node.sorted.filter(k -> k.total * 1000 >= root.total)
    }

    hot-path(node: TreeNode) -> Array[String] {
        let path = []
        let at = node
        while #at.kids > 0 && #path < 40 {
            path.push(at.path)
            let top = at.sorted[0]
            if top.total * 2 < at.total {
                break
            }
            at = top
        }
        path
    }

    share(w: Int) -> String {
        let p = (root.total > 0) ? 100.0 * w / root.total : 0.0
        (p > 0) ? hot(p / 100, "{p:5.1f}%") : ' ' * 6
    }

    gutter(node: TreeNode) -> String {
        "{share(node.total)} {share(node.own)} "
    }

    label(node: TreeNode) -> String {
        let f = prof.funcs[node.func]
        "{bold(f['name'])} {place(f['file'], f['line'])}"
    }

    source(node: TreeNode) -> Screen {
        let f = prof.funcs[node.func]
        SourceView(prof, f['file'], f['line'], f)
    }

    key(app: App, k: String) -> Bool {
        match k {
            'i' => inverted? = !inverted?,
            'a' => kind = (kind == 'time') ? 'alloc' : 'time',
            _   => return false
        }
        rebuild()
        true
    }
}

class FlameGraph < Component {
    prof: Profile
    root: TreeNode
    zoom: TreeNode
    cur: TreeNode
    hover: TreeNode | nil
    height: Int
    query: String
    by-name?: Bool
    bytes?: Bool
    on-open: Function
    boxes: Array[(TreeNode, Int, Int, Int)]
    top: Int

    init(prof: Profile, root: TreeNode, on-open: Function) {
        super()
        self.prof = prof
        self.on-open = on-open
        height = 10
        query = ''
        by-name? = false
        bytes? = false
        boxes = []
        top = 0
        reset(root)
    }

    reset(root: TreeNode) {
        self.root = root
        zoom = root
        cur = root
        hover = nil
        top = 0
        invalidate!()
    }

    focusable? -> Bool { true }

    handles-tab? -> Bool { true }

    wants-hover? -> Bool { true }

    name(node: TreeNode) -> String {
        (node.func < 0) ? 'all' : prof.funcs[node.func]['name']
    }

    match?(node: TreeNode) -> Bool {
        if node.func < 0 {
            return false
        }
        let f = prof.funcs[node.func]
        matches?(f['name'], f['file'], query)
    }

    depth(node: TreeNode) -> Int {
        let d = 0
        let at = node.up
        while at != nil {
            d += 1
            at = at.up
        }
        d
    }

    layout(w: Int) {
        boxes = []
        let chain = []
        let at = zoom.up
        while at != nil {
            chain.push(at)
            at = at.up
        }
        for node; d in chain.reverse() {
            boxes.push((node, d, 0, w))
        }
        let scale = w / float(max(zoom.total, 1))
        fn place(node: TreeNode, d: Int, x: Float) {
            let a = int(x + 0.5)
            let b = int(x + node.total * scale + 0.5)
            if b - a < 1 {
                return
            }
            boxes.push((node, d, a, b))
            let at = x
            for k in node.sorted {
                place(k, d + 1, at)
                at += k.total * scale
            }
        }
        place(zoom, #chain, 0.0)
    }

    color(node: TreeNode) -> String {
        if by-name? {
            return hsl-hex(*hash-hsl(name(node), h: (0.0, 0.13), s: (0.65, 0.95), l: (0.5, 0.65)))
        }
        heat(node.own / float(max(node.total, 1)))
    }

    cell(node: TreeNode, width: Int, below?: Bool) -> String {
        let gap = (width >= 3) ? 1 : 0
        let text = " {name(node)}".fit(width - gap)
        let pad = ' ' * gap
        let style = match () {
            _ and node.path == cur.path  => '#000000 bg-#e8ecff b',
            _ and below?                 => '#9a9a9a bg-#3a3d44',
            _ and query && !match?(node) => '#7a7a7a bg-#2a2c31',
            _ and query                  => '#000000 bg-#ff6fd8 b',
            _                            => "#141414 bg-{color(node)}"
        }
        "{chalk"[{style}]{text}[/]"}{pad}"
    }

    info(w: Int) -> String {
        let node = hover ?? cur
        let share = (root.total > 0) ? node.total / float(root.total) : 0.0
        let own = (root.total > 0) ? node.own / float(root.total) : 0.0
        let parts = [bold(name(node))]
        if node.func >= 0 {
            let f = prof.funcs[node.func]
            parts.push(place(f['file'], f['line']))
        }
        let amount = bytes? ? fmt-bytes(node.total) : prof.qty(node.total)
        parts.push("total {hot(share, "{100 * share:.1f}%")} {dim(amount)}")
        parts.push("self {hot(own, "{100 * own:.1f}%")}")
        if query {
            let hit = matched(root)
            let p = hit / float(max(root.total, 1))
            parts.push("matched {hot(p, "{100 * p:.1f}%")}")
        }
        parts.join(dim(' · ')).fit(w)
    }

    matched(node: TreeNode) -> Int {
        if match?(node) {
            return node.total
        }
        let n = 0
        for k in node.kids.values() {
            n += matched(k)
        }
        n
    }

    render() -> ink::Node {
        let w = max(layout-max-w, 20)
        let rows = max(height - 1, 1)
        layout(w)
        let d = depth(cur)
        top = top.clamp(d - rows + 1, d).clamp(0, max(d, 0))
        let lines = []
        for r in top..top + rows {
            let line = ''
            let x = 0
            for (node, bd, a, b) in boxes {
                if bd != r {
                    continue
                }
                line += ' ' * (a - x)
                line += cell(node, b - a, node.path != zoom.path && depth(node) < depth(zoom))
                x = b
            }
            lines.push(line + ' ' * max(w - x, 0))
        }
        lines.push(info(w))
        Raw(lines, w)
    }

    at(x: Int, y: Int) -> TreeNode | nil {
        let r = y + top
        for (node, d, a, b) in boxes {
            if d == r && x >= a && x < b {
                return node
            }
        }
        nil
    }

    row(node: TreeNode) -> Array[(TreeNode, Int, Int, Int)] {
        let d = depth(node)
        boxes.filter(\_.1 == d)
    }

    step(n: Int) {
        let row = row(cur)
        for bx; i in row {
            if bx.0.path == cur.path {
                cur = row[(i + n).clamp(0, #row - 1)].0
                return
            }
        }
    }

    descend() {
        for (node, d, a, b) in boxes {
            if node.path == "{cur.path}/{node.func}" {
                cur = node
                return
            }
        }
    }

    zoom-in(node: TreeNode) {
        zoom = node
        cur = node
    }

    zoom-out() -> Bool {
        let $up = zoom.up or return false
        cur = zoom
        zoom = up
        true
    }

    on-key(k: String) -> Bool {
        match k {
            'LEFT' or 'h'           => step(-1),
            'RIGHT' or 'l'          => step(1),
            'UP' or 'k'             => cur = cur.up ?? cur,
            'DOWN' or 'j'           => descend(),
            'ENTER'                 => zoom-in(cur),
            'BACKSPACE' or 'ESCAPE' => return zoom-out(),
            'o' and cur.func >= 0   => on-open(cur),
            _                       => return false
        }
        true
    }

    point(x: Int, y: Int) -> Bool {
        hover = at(x - 1 - layout-x, y - 1 - layout-y)
        true
    }

    click(x: Int, y: Int) {
        let $node = at(x - 1 - layout-x, y - 1 - layout-y) or return
        if node.path == cur.path {
            zoom-in(node)
        } else {
            cur = node
        }
    }

    on-event(ev) {
        if !(ev :: event.MouseMove) {
            hover = nil
        }
        let handled? = match ev {
            event.Key({key: $k, event: (1 or 2), *}) => (k :: String) && on-key(k),
            event.Text($t)                           => on-key(t),
            event.MouseDown({button: 0, x, y, *})    => click(int(x), int(y)) ?? true,
            event.MouseDown({button: 2, *})          => zoom-out(),
            event.MouseMove({x, y, *})               => point(int(x), int(y)),
            _                                        => false
        }
        if !handled? {
            return Ignored
        }
        invalidate!()
    }
}

class Flame < Screen {
    prof: Profile
    inverted?: Bool
    kind: String
    graph: FlameGraph

    init(prof: Profile, push: Function) {
        super('Flame graph')
        self.prof = prof
        inverted? = false
        kind = 'time'
        graph = FlameGraph(prof, prof.tree(), node -> do {
            let f = prof.funcs[node.func]
            push(SourceView(prof, f['file'], f['line'], f))
        })
    }

    hint -> String { '⏎ zoom · ⌫ out · o source' }

    header(w: Int) -> String {
        let modes = [
            toggle('i', ['callees', 'callers'], inverted? ? 'callers' : 'callees'),
            toggle('a', ['time', 'alloc'], kind),
            toggle('c', ['self share', 'function'], graph.by-name? ? 'function' : 'self share')
        ]
        let what = dim("width: {(kind == 'time') ? 'time' : 'bytes allocated'}")
        spread(what, modes.join('   '), w)
    }

    widget(h: Int) -> Component | nil {
        if graph.height != h || graph.query != filter {
            graph.height = h
            graph.query = filter
            graph.invalidate!()
        }
        graph
    }

    key(app: App, k: String) -> Bool {
        if k == 'c' {
            graph.by-name? = !graph.by-name?
            graph.invalidate!()
            return true
        }
        match k {
            'i' => inverted? = !inverted?,
            'a' => kind = (kind == 'time') ? 'alloc' : 'time',
            _   => return false
        }
        graph.bytes? = kind == 'alloc'
        graph.reset(prof.tree(inverted?: inverted?, kind: kind))
        true
    }
}

class Natives < Screen {
    prof: Profile
    rows: Array[_]

    init(prof: Profile) {
        super('Native')
        self.prof = prof
        rows = (prof.data['natives'] ?? []).sort!(by=\_['self'], desc=true)
    }

    count -> Int { #rows }

    header(w: Int) -> String {
        [col('self', 6), col('time', 9), dim('C function')].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let n = rows[i]
        let time = hot(prof.pct(n['self']) / 100, prof.qty(n['self']).fit(9, 1))
        [prof.share(n['self']), time, n['name']].join(' ')
    }
}

class Page < Screen {
    text: Array[String]

    init(title: String) {
        super(title)
        text = []
    }

    count -> Int { #text }

    build(w: Int) { }

    view(w: Int, h: Int) -> (Array[String], Int) {
        build(w)
        top = top.clamp(0, max(#text - h, 0))
        sel = top
        (text[top;top + h], -1)
    }

    move(n: Int) {
        top = max(top + n, 0)
    }
}

class Summary < Page {
    prof: Profile

    init(prof: Profile) {
        super('Summary')
        self.prof = prof
    }

    categories(out: Array[String]) {
        let cats = prof.cats.filter(\_['total'] > 0).sort!(by=\_['total'], desc=true)
        let cw = cats.map(\_['name'].width()).max() ?? 10
        out.push(bold('Time by category'))
        for c in cats {
            let p = prof.pct(c['total'])
            let bar = '█' * int(p / 100 * 30)
            let amount = hot(p / 100, "{prof.qty(c['total']).fit(9, 1)}  {bar}")
            out.push("  {c['name'].fit(cw)}  {prof.share(c['total'])} {amount}")
        }
    }

    timeline(out: Array[String], w: Int) {
        let tl: Array[Array[Int]] = prof.data['timeline'] ?? []
        let order = [c for c in ..#prof.cats if prof.cats[c]['total'] > 0]
            .sort!(by=c -> prof.cats[c]['total'], desc=true)
        if #tl == 0 || #order == 0 {
            return
        }
        let cw = order.map(c -> prof.cats[c]['name'].width()).max() ?? 10
        let cols = min(#tl, max(w - cw - 4, 10), max(prof.data['samples'] / 10, 10))
        let slices = [[0 for ..#prof.cats] for ..cols]
        for bucket; b in tl {
            let slice = slices[b * cols / #tl]
            for n; c in bucket {
                slice[c] += n
            }
        }
        let sums = slices.map(\_.sum())
        let span = "0s – {fmt-ns(prof.data['timeline_ns'])}, share of each slice"
        out.push('')
        out.push("{bold('Timeline')}  {dim(span)}")
        for c in order {
            let strip = ''
            for slice; k in slices {
                let share = (sums[k] > 0) ? slice[c] / float(sums[k]) : 0.0
                let level = int(share * 8 + 0.5)
                strip += (level == 0) ? ' ' : hot(share, BLOCKS[level - 1])
            }
            out.push("  {prof.cats[c]['name'].fit(cw)}  {strip}")
        }
    }

    memory(out: Array[String], w: Int) {
        let d = prof.data
        let g = d['gc'] ?? %{'count': 0}
        if g['count'] > 0 {
            out.push('')
            let wall = float(max(d['wall_ns'], 1))
            let rss = float(max(d['max_rss'] ?? 0, 1))
            out.push([
                "{bold('GC')}  {g['count']} {(g['count'] == 1) ? 'collection' : 'collections'}",
                "{hot(g['pause_ns'] / wall, fmt-ns(g['pause_ns']))} paused",
                "longest {hot(g['max_ns'] / wall, fmt-ns(g['max_ns']))}",
                "{fmt-bytes(g['freed'])} reclaimed",
                "peak heap {hot(g['peak'] / rss, fmt-bytes(g['peak']))}"
            ].join(' · '))
            heap(out, w)
        }
        if prof.alloc-total > 0 {
            let sampled = "{fmt-bytes(prof.alloc-total)} sampled"
            let every = "one stack per {fmt-bytes(d['alloc_every'])}"
            out.push('')
            out.push("{bold('Allocation')}  {sampled}, {every}")
            if d['retained'] > 0 {
                let when = d['retained_exact'] ? 'after the last GC' : 'at exit (no GC ran)'
                let rss = float(max(d['max_rss'] ?? 0, 1))
                out.push("  {hot(d['retained'] / rss, fmt-bytes(d['retained']))} retained {when}")
            }
        }
    }

    heap(out: Array[String], w: Int) {
        let points: Array[Array[Int]] = prof.data['heap'] ?? []
        let span = max(prof.data['timeline_ns'] ?? 0, points.map(\_[0]).max() ?? 0, 1)
        if #points < 2 {
            return
        }
        let n = max(min(w - 14, 120), 10) * 2
        let bins = [-1 for ..n]
        for [t, bytes] in points {
            let i: Int = int(t * n / span).clamp(0, n - 1)
            bins[i] = max(bins[i], bytes)
        }
        let series = []
        let last = points[0][1]
        for b in bins {
            last = (b >= 0) ? b : last
            series.push(float(last))
        }
        let plot = LinePlot(
            data: series,
            width: n / 2 + 12,
            height: 5,
            fill?: true,
            kitty?: false,
            color: '#5fafd7',
            min-val: 0.0,
            format: fmt-bytes,
            x-lo: '0s',
            x-hi: fmt-ns(span)
        )
        out.push("  {dim('Heap after each collection')}")
        for line in plot.render().props['lines'] {
            out.push("  {chalk.plain? ? line.comb(/\e\[[\d;]*m/) : line}")
        }
    }

    imports(out: Array[String]) {
        let mods = prof.data['modules'] ?? []
        if #mods == 0 {
            return
        }
        out.push('')
        let wall = float(max(prof.data['wall_ns'], 1))
        let ms = mods.map(m -> (m, m['total_ns'] - m['child_ns'])).sort!(by=\_.1, desc=true)
        let all = ms.map(\_.1).sum() ?? 0
        let share = hot(all / wall, "{100 * all / wall:.1f}%")
        let note = "{hot(all / wall, fmt-ns(all))} in all ({share} of the run)"
        out.push("{bold('Imports')}  {note}, {dim('self time, excluding nested imports')}")
        for (m, own) in ms[;12] {
            let compile = hot(m['compile_ns'] / wall, fmt-ns(m['compile_ns']))
            let detail = "{dim("{m['lines']} lines, compile+check")} {compile}"
            out.push("  {hot(own / wall, fmt-ns(own).fit(9, 1))}  {m['name'].fit(20)} {detail}")
        }
    }

    threads(out: Array[String]) {
        let threads = prof.data['threads'] ?? []
        if #threads < 2 {
            return
        }
        out.push('')
        out.push(bold('Threads'))
        for t in threads {
            out.push("  {prof.share(t['total'])}  {str(t['id']).fit(3, 1)} {t['name']}")
        }
    }

    build(w: Int) {
        let d = prof.data
        let facts = [
            prof.title,
            "{fmt-ns(d['cpu_ns'] ?? 0)} CPU",
            "{fmt-bytes(d['max_rss'] ?? 0)} max RSS"
        ]
        let out = ["{bold(d['target'])}  {dim(d['argv'].join(' '))}", facts.join(' · '), '']
        categories(out)
        timeline(out, w)
        memory(out, w)
        imports(out)
        threads(out)
        text = out.map(\_.fit(w))
    }
}

fn pct(frac: Float) -> String {
    hot(frac, "{100 * frac:5.1f}%")
}

fn bar(frac: Float, w: Int) -> String {
    let n = frac * w
    let full = int(n)
    let rest = int((n - full) * 8)
    let tail = (rest > 0 && full < w) ? BLOCKS[rest - 1] : ''
    hot(frac, "{'█' * full}{tail}")
}

fn type-label(t: Array[_]) -> String {
    (t[1] != '') ? "{t[0]}, {t[1]}" : t[0]
}

fn type-mix(types: Array[_], limit: Int = 3) -> String {
    let all = float(max(types.map(\_[2]).sum() ?? 0, 1))
    types
        .sort(by=\_[2], desc=true)[;limit]
        .map(t -> "{type-label(t)} {100 * t[2] / all:.0f}%")
        .join(dim(' · '))
}

class JitOverview < Page {
    prof: Profile
    stats: _

    init(prof: Profile) {
        super('Overview')
        self.prof = prof
        stats = prof.data['jit_stats'] ?? %{}
    }

    paths(out: Array[String]) {
        let rows = stats['paths'] ?? []
        if #rows == 0 {
            out.push("{bold('Fast paths')}  {dim('not counted (recorded with --no-jit-stats)')}")
            return
        }
        out.push(bold('Fast paths'))
        let head = [col('', 36), col('inline hits', 12), col('misses', 12), col('miss rate', 10)]
        out.push(head.join(' '))
        for r in rows {
            let miss = r['slow']
            let line = if let $fast = r['fast'] {
                let rate = miss / float(max(fast + miss, 1))
                [
                    fmt-count(fast).fit(12, 1),
                    hot(rate, fmt-count(miss).fit(12, 1)),
                    pct(rate).fit(10, 1),
                    bar(rate, 20)
                ]
            } else {
                [dim('not counted'.fit(12, 1)), fmt-count(miss).fit(12, 1), ' ' * 10]
            }
            out.push(["  {r['op'].fit(34)}", *line].join(' '))
        }
    }

    plans(out: Array[String]) {
        let rows = stats['plans'] ?? []
        if #rows == 0 {
            return
        }
        let most = float(max(rows.map(\_['sites']).max() ?? 1, 1))
        out.push('')
        out.push(bold('Optimizations applied'))
        out.push([col('sites', 10), col('units', 10), dim('optimization')].join(' '))
        for r in rows.sort(by=\_['sites'], desc=true) {
            let sites = hot(r['sites'] / most, fmt-count(r['sites']).fit(10, 1))
            out.push([sites, fmt-count(r['units']).fit(10, 1), r['name']].join(' '))
        }
    }

    build(w: Int) {
        let fns = stats['compiled'] ?? []
        let wall = float(max(prof.data['wall_ns'], 1))
        let deopts = prof.data['jit_deopts'] ?? []
        let despec = prof.data['jit_despecialized'] ?? []
        let out = []
        if #fns > 0 {
            let spent = stats['compile_ns']
            let share = hot(spent / wall, "{100 * spent / wall:.1f}%")
            let n = deopts.map(\_['n']).sum() ?? 0
            out.push([
                "{bold("{#fns}")} functions compiled",
                "{hot(spent / wall, fmt-ns(spent))} compiling ({share} of the run)",
                "{fmt-bytes(stats['native_bytes'])} native code"
            ].join(dim(' · ')))
            out.push([
                "{bold("{#deopts}")} deopt sites, {fmt-count(n)} deopts",
                "{bold("{#despec}")} recompiled without speculation",
                "{bold("{#prof.funcs.filter(\_['decline'])}")} not compiled"
            ].join(dim(' · ')))
            out.push('')
        }
        paths(out)
        plans(out)
        if #out == 0 {
            out.push(dim('No JIT data in this profile.'))
        }
        text = out.map(\_.fit(w))
    }
}

class JitMisses < Screen {
    prof: Profile
    all: Array[_]
    rows: Array[_]
    sort: String
    desc?: Bool
    most: Float

    init(prof: Profile) {
        super('Fast-path misses')
        self.prof = prof
        all = ((prof.data['jit_stats'] ?? %{})['sites'] ?? []).filter(\calls(_) > 0)
        most = float(max(all.map(calls).max() ?? 1, 1))
        sort = 'miss'
        desc? = true
        refresh()
    }

    static calls(r: _) -> Int {
        r['miss'] + (r['cold'] ?? 0)
    }

    rate(r: _) -> Float {
        r['inline'] ? r['miss'] / float(max(r['fast'] + r['miss'], 1)) : -1.0
    }

    refresh() {
        let key = (sort == 'rate') ? rate : calls
        rows = all
            .filter(r -> matches?(r['func'], r['file'], filter) || matches?(r['kind'], '', filter))
            .sort!(by=key, desc=desc?)
    }

    count -> Int { #rows }

    hint -> String { 's sort · S reverse' }

    previews? -> Bool { true }

    header(w: Int) -> String {
        [
            sorted-col('misses', 9, sort == 'miss', desc?),
            sorted-col('rate', 7, sort == 'rate', desc?),
            dim('kind'.fit(17)),
            dim('location'.fit(26)),
            dim('function'.fit(20)),
            dim('operand types')
        ].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let r = rows[i]
        let rt = rate(r)
        [
            hot(calls(r) / most, fmt-count(calls(r)).fit(9, 1)),
            (rt >= 0) ? pct(rt).fit(7, 1) : dim('—'.fit(7, 1)),
            r['kind'].fit(17),
            "{place(r['file'], r['line'])}{dim(":{r['col']}")}".fit(26),
            bold(r['func'].fit(20)),
            dim(type-mix(r['types']))
        ].join(' ')
    }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        let r = rows[sel]
        let rt = rate(r)
        let inline = (rt >= 0) ? [
            "{fmt-count(r['fast'])} inline hits",
            "{fmt-count(r['miss'])} misses",
            "{100 * rt:.1f}% miss rate"
        ] : []
        let cold = (r['cold'] ?? 0) > 0 ? ["{fmt-count(r['cold'])} calls with no inline path"] : []
        let warm = (r['warm'] ?? 0) > 0 ? ["{fmt-count(r['warm'])} before tier-up"] : []
        let counts = [*inline, *cold, *warm].join(' · ')
        let notes = ["{bold(r['kind'])} at column {r['col']}  {dim(counts)}"]
        let all = float(max(r['types'].map(\_[2]).sum() ?? 0, 1))
        for t in r['types'].sort(by=\_[2], desc=true)[;6] {
            let frac = t[2] / all
            notes.push("  {type-label(t).fit(18)} {pct(frac)} {bar(frac, 16)}")
        }
        Spot(r['file'], r['line'], prof.func-named(r['func'], r['file']), notes)
    }

    open(app: App) {
        if #rows > 0 {
            let r = rows[sel]
            app.push(SourceView(prof, r['file'], r['line'], nil))
        }
    }

    key(app: App, k: String) -> Bool {
        match k {
            's' => sort = cycle(['miss', 'rate', 'fast'], sort),
            'S' => desc? = !desc?,
            _   => return false
        }
        refresh()
        true
    }
}

class JitDeopts < Screen {
    prof: Profile
    all: Array[_]
    rows: Array[_]
    despec: Dict[String, _]
    most: Float

    init(prof: Profile) {
        super('Deoptimizations')
        self.prof = prof
        all = (prof.data['jit_deopts'] ?? []).sort(by=\_['n'], desc=true)
        most = float(max(all.map(\_['n']).max() ?? 1, 1))
        despec = %{}
        for d in prof.data['jit_despecialized'] ?? [] {
            despec[d['func']] = d
        }
        refresh()
    }

    refresh() {
        rows = all.filter(
            d -> matches?(d['func'], d['file'], filter) || matches?(d['why'], '', filter)
        )
    }

    count -> Int { #rows }

    previews? -> Bool { true }

    header(w: Int) -> String {
        [
            sorted-col('deopts', 8, true, true),
            dim('reason'.fit(20)),
            dim('location'.fit(26)),
            dim('function'.fit(20)),
            dim('details')
        ].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let d = rows[i]
        let notes = d['notes'].sort(by=\_[1], desc=true).map(\_[0])
        let mark = despec[d['func']] ? chalk"[{ACCENT}]↺[/]" : ' '
        [
            hot(d['n'] / most, fmt-count(d['n']).fit(8, 1)),
            d['why'].fit(20),
            place(d['file'], d['line']).fit(26),
            "{bold(d['func'].fit(18))} {mark}",
            dim(d['guard'] || notes.join(' · '))
        ].join(' ')
    }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        let d = rows[sel]
        let wall = float(max(prof.data['wall_ns'], 1))
        let when = if d['n'] > 1 {
            "{fmt-ns(d['first'])} – {fmt-ns(d['last'])}"
        } else {
            "at {fmt-ns(d['first'])}"
        }
        let times = hot(d['n'] / most, "{fmt-count(d['n'])} deopts")
        let notes = ["{bold(d['why'])}  {times} {dim(when)}"]
        if let $guard = d['guard'] {
            notes.push("  {guard}")
        }
        let total = float(max(d['notes'].map(\_[1]).sum() ?? 0, 1))
        for [text, n] in d['notes'].sort(by=\_[1], desc=true) {
            notes.push("  {dim(text.fit(28))} {fmt-count(n).fit(7, 1)} {bar(n / total, 12)}")
        }
        if let [shot, *_] = d['shots'] ?? [] {
            let vars = shot['vars'].filter(\_[3] == 'local')[;8]
            let nw = (vars.map(\_[0].width()).max() ?? 4).clamp(4, 12)
            for [name, type, value, _] in vars {
                notes.push("  {bold(name.fit(nw))} {chalk"[cyan]{type.fit(8)}[/]"} {value}")
            }
        }
        if let $x = despec[d['func']] {
            let at = hot(x['at'] / wall, fmt-ns(x['at']))
            let mark = chalk"[{ACCENT}]↺[/]"
            notes.push("{mark} recompiled without speculation at {at}, after {x['deopts']} deopts")
        }
        Spot(d['file'], d['line'], prof.func-named(d['func'], d['file']), notes)
    }

    hint -> String { '⏎ details' }

    open(app: App) {
        if #rows > 0 {
            app.push(DeoptView(prof, rows[sel]))
        }
    }
}

class JitCompiled < Screen {
    prof: Profile
    all: Array[_]
    rows: Array[_]
    sort: String
    desc?: Bool
    total-ns: Float
    total-native: Float
    lo: Float
    hi: Float

    init(prof: Profile) {
        super('Compiled')
        self.prof = prof
        let stats = prof.data['jit_stats'] ?? %{}
        all = stats['compiled'] ?? []
        for r in all {
            r['label'] = r['class'] ? "{r['class']}.{r['name']}" : r['name']
            r['ratio'] = r['native'] / float(max(r['bc'], 1))
        }
        total-ns = float(max(stats['compile_ns'] ?? 1, 1))
        total-native = float(max(stats['native_bytes'] ?? 1, 1))
        lo = math.log(all.map(\_['ratio']).min() ?? 1.0)
        hi = math.log(all.map(\_['ratio']).max() ?? 1.0)
        for r in all {
            r['samples'] = r['samples'] ?? 0
        }
        sort = (all.map(\_['samples']).sum() ?? 0) > 0 ? 'samples' : 'ns'
        desc? = true
        refresh()
    }

    refresh() {
        let key = sort
        rows = all
            .filter(r -> matches?(r['label'], r['file'], filter))
            .sort!(by=\_[key], desc=desc?)
    }

    count -> Int { #rows }

    hint -> String { 's sort · S reverse · ⏎ disassembly' }

    previews? -> Bool { true }

    header(w: Int) -> String {
        [
            sorted-col('self', 6, sort == 'samples', desc?),
            sorted-col('compile', 9, sort == 'ns', desc?),
            sorted-col('native', 10, sort == 'native', desc?),
            sorted-col('bytecode', 10, sort == 'bc', desc?),
            sorted-col('ratio', 7, sort == 'ratio', desc?),
            dim('tier'),
            dim('function')
        ].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let r = rows[i]
        let spread = (hi > lo) ? (math.log(r['ratio']) - lo) / (hi - lo) : 0.0
        let n = float(max(prof.data['samples'], 1))
        [
            (r['samples'] > 0) ? hot(r['samples'] / n, "{100 * r['samples'] / n:5.1f}%") : ' ' * 6,
            hot(r['ns'] / total-ns, fmt-ns(r['ns']).fit(9, 1)),
            hot(r['native'] / total-native, fmt-bytes(r['native']).fit(10, 1)),
            fmt-bytes(r['bc']).fit(10, 1),
            hot(spread, "{r['ratio']:6.1f}x"),
            dim("{r['tier']}".fit(4, 1)),
            bold(r['label'])
        ].join(' ')
    }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        let r = rows[sel]
        let f = prof.func-named(r['label'], r['file'])
        let sizes = "{fmt-bytes(r['bc'])} bytecode → {fmt-bytes(r['native'])} native"
        let notes = ["tier {r['tier']} · {sizes}"]
        if !r['code'] {
            notes.push(dim('machine code not recorded'))
        }
        Spot(r['file'], f ? prof.hottest(f) : r['line'], f, notes)
    }

    open(app: App) {
        if #rows > 0 {
            let r = rows[sel]
            if r['code'] {
                app.push(Disasm(prof, r))
            } else {
                let f = prof.func-named(r['label'], r['file'])
                app.push(SourceView(prof, r['file'], r['line'], f))
            }
        }
    }

    key(app: App, k: String) -> Bool {
        match k {
            's' => sort = cycle(['samples', 'ns', 'native', 'bc', 'ratio'], sort),
            'S' => desc? = !desc?,
            _   => return false
        }
        refresh()
        true
    }
}

class JitDeclined < Screen {
    prof: Profile
    rows: Array[_]

    init(prof: Profile) {
        super('Not compiled')
        self.prof = prof
        refresh()
    }

    refresh() {
        rows = prof.funcs
            .filter(f -> f['decline'] && matches?(f['name'], f['file'], filter))
            .sort!(by=\_['total'], desc=true)
    }

    count -> Int { #rows }

    previews? -> Bool { true }

    header(w: Int) -> String {
        [sorted-col('total', 6, true, true), dim('function'.fit(24)), dim('reason')].join(' ')
    }

    row(i: Int, w: Int) -> String {
        let f = rows[i]
        [prof.share(f['total']), bold(f['name'].fit(24)), f['decline']].join(' ')
    }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        let f = rows[sel]
        let line = (f['decline_line'] > 0) ? f['decline_line'] : f['line']
        let why = "Not compiled: {f['decline']}"
        Spot(f['file'], line, f, [why])
    }

    open(app: App) {
        if #rows > 0 {
            let f = rows[sel]
            app.push(SourceView(prof, f['file'], f['line'], f))
        }
    }
}

class Disasm < Screen {
    prof: Profile
    rec: _
    rows: Array[jit.Row]
    samples: Int
    most: Float
    func: _

    init(prof: Profile, rec: _) {
        super("{rec['label']} (native)")
        self.prof = prof
        self.rec = rec
        func = prof.func-named(rec['label'], rec['file'])
        samples = rec['samples'] ?? 0
        rows = jit.rows(rec)
        let hits = rows.map(match Insn(i) => i.hits else 0)
        most = float(max(hits.max() ?? 1, 1))
        sel = ((hits.max() ?? 0) > 0) ? (hits.argmax() ?? 0) : 0
        top = max(sel - 8, 0)
    }

    count -> Int { #rows }

    hint -> String { 'n/N next/previous hot instruction' }

    previews? -> Bool { true }

    header(w: Int) -> String {
        let share = (prof.data['samples'] > 0) ? samples / float(prof.data['samples']) : 0.0
        let info = [
            "{fmt-count(samples)} samples ({100 * share:.1f}% of the run)",
            "{fmt-bytes(rec['native'])} native",
            "tier {rec['tier']}"
        ].join(dim(' · '))
        "{col('self', 6)}   {col('offset', 6)}  {dim('instruction')}    {info}"
    }

    share(n: Int) -> String {
        (n > 0 && samples > 0) ? hot(n / most, "{100.0 * n / samples:5.1f}%") : ' ' * 6
    }

    row(i: Int, w: Int) -> String {
        match rows[i] {
            Src(s) => {
                let src = prof.source(rec['file'])
                let text = (src != nil && s.line > 0) ? src.line(s.line).strip() : ''
                let num = "{chalk"[{ACCENT}]{s.line}[/]"}"
                let mark = (s.hits > 0 && samples > 0) ? dim("{100.0 * s.hits / samples:5.1f}%") : ' ' * 6
                "{mark}   {dim('──────')}  {num} {dim('│')} {text}"
            },
            Op(o)   => "{' ' * 6}   {' ' * 6}  {jit.op-text(o)}",
            Data(d) => "{' ' * 6}   {dim("{d.off:06x}")}  {dim("literal pool · {fmt-bytes(d.size)}")}",
            Insn(x) => "{share(x.hits)} {jit.badge(x.role)} {dim("{x.off:06x}")}  {jit.insn-text(x)}"
        }
    }

    line-at(i: Int) -> Int {
        let line = jit.line-of(rows[i])
        (line > 0) ? line : rec['line']
    }

    preview -> Spot | nil {
        (#rows > 0) ? Spot(rec['file'], line-at(sel), func) : nil
    }

    open(app: App) {
        if #rows > 0 {
            app.push(SourceView(prof, rec['file'], line-at(sel), func))
        }
    }

    jump(dir: Int) {
        let i = sel + dir
        while i >= 0 && i < #rows {
            if let Insn(x) = rows[i] and x.hits > 0 {
                sel = i
                return
            }
            i += dir
        }
    }

    key(app: App, k: String) -> Bool {
        match k {
            'n' => jump(1),
            'N' => jump(-1),
            _   => return false
        }
        true
    }
}

class DeoptView < Screen {
    prof: Profile
    d: _
    rows: Array[(String, Spot | nil)]

    init(prof: Profile, d: _) {
        super("{d['func']} deopt")
        self.prof = prof
        self.d = d
        rows = []
        let here = Spot(d['file'], d['line'], prof.func-named(d['func'], d['file']))
        let when = if d['n'] > 1 {
            "{fmt-ns(d['first'])} – {fmt-ns(d['last'])}"
        } else {
            "at {fmt-ns(d['first'])}"
        }
        rows.push(("{bold(d['why'])}  {fmt-count(d['n'])} deopts  {dim(when)}", here))
        if let $guard = d['guard'] {
            rows.push(('', nil))
            rows.push(("{chalk"[b {ACCENT}]Assumption[/]"}", here))
            for line in guard.wrap(72).lines() {
                rows.push(("  {line}", here))
            }
        }
        if #d['notes'] > 0 {
            let notes = d['notes'].sort(by=\_[1], desc=true).map(n -> "{n[0]} ×{n[1]}")
            rows.push(("  {dim(notes.join(' · '))}", here))
        }
        let shots = d['shots'] ?? []
        for shot; k in shots {
            rows.push(('', nil))
            let times = (shot['count'] > 1) ? " · seen {shot['count']}×" : ''
            let label = "{chalk"[b {ACCENT}]Snapshot {k + 1} of {#shots}[/]"}"
            rows.push(("{label}{dim(" · at {fmt-ns(shot['t'])}{times}")}", nil))
            rows.push((dim('  call stack'), nil))
            for [func, file, line]; j in shot['stack'] {
                let mark = (j == 0) ? "{chalk"[{ACCENT}]▶[/]"}" : ' '
                let spot = Spot(file, line, prof.func-named(func, file))
                rows.push(("  {mark} {bold(func.fit(28))} {place(file, line)}", spot))
            }
            let vars = shot['vars']
            if #vars > 0 {
                rows.push((dim('  values'), nil))
                let nw = (vars.map(\_[0].width()).max() ?? 4).clamp(4, 16)
                for [name, type, value, kind] in vars {
                    let label = (kind == 'stack') ? dim(name.fit(nw)) : bold(name.fit(nw))
                    rows.push(("    {label} {chalk"[cyan]{type.fit(10)}[/]"} {value}", here))
                }
            }
        }
        sel = 0
    }

    count -> Int { #rows }

    previews? -> Bool { true }

    hint -> String { '⏎ open frame' }

    row(i: Int, w: Int) -> String { rows[i].0 }

    preview -> Spot | nil {
        if #rows == 0 {
            return nil
        }
        rows[sel].1 ?? Spot(d['file'], d['line'], prof.func-named(d['func'], d['file']))
    }

    open(app: App) {
        if let $spot = (#rows > 0) ? rows[sel].1 : nil {
            app.push(SourceView(prof, spot.file, spot.line, spot.func))
        }
    }
}

class Jit < Screen {
    views: Array[Screen]
    at: Int

    init(prof: Profile) {
        super('JIT')
        views = [
            JitOverview(prof),
            JitMisses(prof),
            JitDeopts(prof),
            JitCompiled(prof),
            JitDeclined(prof)
        ]
        at = 0
    }

    cur -> Screen { views[at] }

    strip -> String {
        let labels = []
        for v; i in views {
            let n = (i > 0) ? " {v.count}" : ''
            labels.push((i == at) ? "{chalk"[b {ACCENT}]{v.title}{n}[/]"}" : dim("{v.title}{n}"))
        }
        "{chalk"[cyan]←/→[/]"} {labels.join('   ')}"
    }

    count -> Int { cur.count }

    hint -> String { cur.hint }

    header(w: Int) -> String { cur.header(w) }

    min-width -> Int { strip.width() }

    row(i: Int, w: Int) -> String { cur.row(i, w) }

    previews? -> Bool { cur.previews? }

    preview -> Spot | nil { cur.preview }

    refresh() {
        for v in views {
            v.filter = filter
            v.refresh()
            v.sel = 0
            v.top = 0
        }
    }

    move(n: Int) { cur.move(n) }

    open(app: App) { cur.open(app) }

    key(app: App, k: String) -> Bool {
        match k {
            'LEFT'  => at = (at + #views - 1) % #views,
            'RIGHT' => at = (at + 1) % #views,
            _       => return cur.key(app, k)
        }
        true
    }

    view(w: Int, h: Int) -> (Array[String], Int) {
        let (rows, sel) = cur.view(w, h - 2)
        ([strip.fit(w), '', *rows], (sel >= 0) ? sel + 2 : -1)
    }
}

class SourceView < Screen {
    prof: Profile
    file: String
    func: _
    src: Source
    hot: Array[Int]

    init(prof: Profile, file: String, line: Int, func: _) {
        super(func ? func['name'] : "{file}:{line}")
        self.prof = prof
        self.file = file
        self.func = func
        src = prof.source(file) ?? Source('')
        let lo = func ? func['line'] : 1
        let hi = (func && func['end'] > 0) ? func['end'] : max(src.count, line)
        hot = prof.lines
            .filter(l -> l['file'] == file && l['line'] >= lo && l['line'] <= hi)
            .filter(l -> prof.pct(l['self']) >= 0.5)
            .map(\_['line'])
            .sort!()
        let focus = line
        if func {
            let best = prof.lines
                .filter(l -> l['func'] == func['id'] && l['self'] > 0)
                .sort!(by=\_['self'], desc=true)
            if #best > 0 {
                focus = best[0]['line']
            }
        }
        sel = focus - 1
        top = max(sel - 8, 0)
    }

    count -> Int { src.count }

    hint -> String { 'n/N next/previous hot line · c callers/callees' }

    header(w: Int) -> String {
        let alloc = (prof.alloc-total > 0) ? [col('alloc', 9)] : []
        [col('self', 6), col('total', 6), *alloc, dim("{' ' * 7}{file}")].join(' ')
    }

    brief(i: Int, w: Int) -> String {
        let n = i + 1
        let l = prof.at(file, n)
        let num = str(n).fit(5, 1)
        [
            l ? prof.share(l['self']) : ' ' * 6,
            in-func?(n) ? num : dim(num),
            "{dim('│')} {src.line(n)}"
        ].join(' ').fit(w)
    }

    in-func?(n: Int) -> Bool {
        func == nil || (n >= func['line'] && (func['end'] == 0 || n <= func['end']))
    }

    row(i: Int, w: Int) -> String {
        let n = i + 1
        let l = prof.at(file, n)
        let alloc = (prof.alloc-total > 0) ? [prof.alloc-share(l ? l['alloc'] : 0)] : []
        let num = str(n).fit(5, 1)
        let note = (l && l['jit_slow']) ? "  {dim("JIT: {l['jit_slow']}")}" : ''
        [
            l ? prof.share(l['self']) : ' ' * 6,
            l ? prof.share(l['total']) : ' ' * 6,
            *alloc,
            in-func?(n) ? num : dim(num),
            "│ {src.line(n)}{note}"
        ].join(' ')
    }

    key(app: App, k: String) -> Bool {
        match k {
            'n' => {
                if let $next = hot.find(\_ > sel + 1) {
                    sel = next - 1
                }
            },
            'N' => {
                if let $prev = hot.reverse().find(\_ < sel + 1) {
                    sel = prev - 1
                }
            },
            'c' => {
                if func {
                    app.push(Edges(prof, func))
                }
            },
            _ => return false
        }
        true
    }
}

class Edges < Screen {
    prof: Profile
    rows: Array[_]

    init(prof: Profile, func: _) {
        super("{func['name']} callers/callees")
        self.prof = prof
        let (callers, callees) = prof.edges(func['id'])
        rows = [
            *callers.map(c -> ('↑', c.0, c.1)),
            ('·', func, func['total']),
            *callees.map(c -> ('↓', c.0, c.1))
        ]
        sel = #callers
    }

    count -> Int { #rows }

    header(w: Int) -> String { [col('share', 6), ' ', dim('function')].join(' ') }

    row(i: Int, w: Int) -> String {
        let (dir, f, weight) = rows[i]
        let arrow = match dir {
            '↑' => "{chalk"[cyan]↑[/]"}",
            '↓' => "{chalk"[yellow]↓[/]"}",
            _   => ' '
        }
        [prof.share(weight), arrow, bold(f['name']), place(f['file'], f['line'])].join(' ')
    }

    open(app: App) {
        if #rows > 0 {
            let f = rows[sel].1
            app.push(SourceView(prof, f['file'], f['line'], f))
        }
    }
}

pub class App < Component {
    prof: Profile
    tabs: Array[Screen]
    tab: Int
    stack: Array[Screen]
    editing?: Bool
    page: Int
    previews: Dict[String, SourceView]
    pane?: Bool
    widths: Dict[String, Int]

    init(prof: Profile) {
        super()
        self.prof = prof
        tabs = [
            Functions(prof),
            Lines(prof),
            Tree(prof, s -> push(s), () -> invalidate!()),
            Flame(prof, s -> push(s)),
            Lines(prof, sort: 'alloc', title: 'Allocations'),
            Natives(prof),
            Jit(prof),
            Summary(prof)
        ]
        tab = 0
        stack = []
        editing? = false
        page = 10
        previews = %{}
        pane? = true
        widths = %{}
    }

    screen -> Screen { (#stack > 0) ? stack[-1] : tabs[tab] }

    focusable? -> Bool { true }

    handles-tab? -> Bool { true }

    mount() {
        refocus()
    }

    refocus() {
        focus(screen.widget(page) ?? self)
    }

    push(s: Screen) {
        stack.push(s)
        refocus()
    }

    tab-line -> String {
        let labels = []
        for t; i in tabs {
            let label = " {i + 1} {t.title} "
            labels.push((#stack == 0 && i == tab) ? "{chalk"[reverse]{label}[/]"}" : dim(label))
        }
        labels.join('')
    }

    crumbs -> String {
        if #stack == 0 {
            return ''
        }
        "{dim("{tabs[tab].title} › ")}{bold(stack.map(\_.title).join(' › '))}"
    }

    status-line -> String {
        let s = screen
        let filter = (editing? || s.filter) ? "/{s.filter}{editing? ? '▏' : ''}  " : ''
        let keys = [
            '↑↓ move',
            *('⏎' in s.hint ? [] : ['⏎ open']),
            '⌫ back',
            'tab view',
            '/ filter',
            *(s.previews? ? [pane? ? 'e hide preview' : 'e preview'] : []),
            *(s.hint ? [s.hint] : []),
            'q quit'
        ]
        "{filter}{dim(keys.join(' · '))}"
    }

    pane(spot: Spot | nil, w: Int, h: Int) -> ink::Node {
        let $spot = spot or return Raw([dim(' nothing selected')], w)
        let key = "{spot.file}:{spot.func ? spot.func['id'] : -1}"
        let view = previews[key] ?? SourceView(prof, spot.file, spot.line, spot.func)
        previews[key] = view
        let name = spot.func ? bold(spot.func['name']) : ''
        let head = [" {name} {place(spot.file, spot.line)}".fit(w)]
        for note in spot.notes {
            for line in " {note}".wrap(w - 1, indent: '   ', first: '').lines() {
                head.push(line.fit(w))
            }
        }
        head.push(' ' * w)
        let room = max(h - #head, 1)
        let n = view.count
        let at = (spot.line - 1).clamp(0, max(n - 1, 0))
        let top = (at - room / 3).clamp(0, max(n - room, 0))
        let before = [view.brief(i, w) for i in top..at]
        let after = [view.brief(i, w) for i in at + 1..min(top + room, n)]
        let pad = [' ' * w for ..max(room - #before - 1 - #after, 0)]
        if prof.source(spot.file) == nil {
            return Raw([*head, dim(' source not recorded').fit(w), *[' ' * w for ..room - 1]], w)
        }
        Box(
            Raw([*head, *before], w),
            Box(Raw([view.brief(at, w)], w), bg: SHADE),
            Raw([*after, *pad], w),
            direction: 'column'
        )
    }

    body(s: Screen, w: Int, h: Int) -> ink::Node {
        if let $widget = s.widget(h - 1) {
            return Box(Raw([s.header(w).fit(w)], w), widget, direction: 'column', width: w)
        }
        let (rows, at) = s.view(w, h)
        let pad = [' ' * w for ..max(h - #rows, 0)]
        if at < 0 || at >= #rows {
            return Raw([*rows, *pad], w)
        }
        Box(
            Raw(rows[;at], w),
            Box(Raw([rows[at]], w), bg: SELECTED),
            Raw([*rows[at + 1;], *pad], w),
            direction: 'column',
            width: w
        )
    }

    natural(s: Screen, h: Int) -> Int {
        let head = s.header(4096)
        let key = "{tab}/{#stack}/{s.title}/{s.filter}/{s.count}/{head}"
        let w = widths[key] ?? do {
            let most = max(head.width(), s.min-width)
            for i in ..min(s.count, 300) {
                most = max(most, s.row(i, 4096).width())
            }
            widths[key] = most
        }
        for i in s.top..min(s.top + h, s.count) {
            w = max(w, s.row(i, 4096).width())
        }
        w
    }

    render() -> ink::Node {
        let W = max(layout-max-w, 40)
        let H = max(layout-max-h, 8)
        let head = ["{bold('profile')} {dim(prof.title)}".fit(W), tab-line.fit(W), crumbs.fit(W)]
        let s = screen
        let h = H - 4
        page = max(h - 1, 1)
        let split? = W >= 120 && s.previews? && pane?
        let L = if !split? {
            W
        } else if s.tree-view != nil {
            W - (W * 2 / 5).clamp(48, 100) - 1
        } else {
            (natural(s, h) + 4).clamp(40, W - max(48, W * 2 / 5) - 1)
        }
        let R = split? ? W - L - 1 : 0
        if let $tree = s.tree-view {
            tree.width = L
        }
        let main = body(s, L, h)
        let middle = if split? {
            let bar = [dim('│') for ..h]
            Box(main, Raw(bar, 1), pane(s.preview, R, h), direction: 'row')
        } else {
            main
        }
        Box(Raw(head, W), middle, Raw([status-line.fit(W)], W), direction: 'column')
    }

    back() {
        if #stack > 0 {
            stack.pop()
            refocus()
        }
    }

    refilter(s: Screen) {
        s.refresh()
        s.sel = 0
        s.top = 0
    }

    switch(i: Int) {
        stack = []
        tab = (i + #tabs) % #tabs
        refocus()
    }

    on-text(t: String) {
        let s = screen
        if editing? {
            s.filter += t
            return refilter(s)
        }
        if s.key(self, t) {
            return
        }
        match t {
            'q'       => return ink::Exit,
            'j'       => s.move(1),
            'k'       => s.move(-1),
            'g'       => s.move(-s.count),
            'G'       => s.move(s.count),
            '/'       => {
                editing? = true
                focus(self)
            },
            'e'       => pane? = !pane?,
            /^[1-8]$/ => switch(int(t) - 1),
            _         => ()
        }
    }

    on-edit-key(k: Int | String) {
        let s = screen
        match k {
            'ENTER'     => {
                editing? = false
                refocus()
            },
            'ESCAPE'    => {
                editing? = false
                s.filter = ''
                refilter(s)
                refocus()
            },
            'BACKSPACE' => {
                s.filter = s.filter[;-1]
                refilter(s)
            },
            _           => ()
        }
    }

    on-key(k: Int | String, m: Int) {
        let s = screen
        if (m & mod.CTRL) != 0 {
            return (k == 'c' || k == 99) ? ink::Exit : nil
        }
        if editing? {
            return on-edit-key(k)
        }
        if (k :: String) && s.key(self, str(k)) {
            return
        }
        let step = ((m & mod.SHIFT) != 0) ? -1 : 1
        match k {
            'UP'                      => s.move(-1),
            'DOWN'                    => s.move(1),
            'PAGE_UP' or 'PAGEUP'     => s.move(-page),
            'PAGE_DOWN' or 'PAGEDOWN' => s.move(page),
            'HOME'                    => s.move(-s.count),
            'END'                     => s.move(s.count),
            'ENTER'                   => s.open(self),
            'BACKSPACE' or 'ESCAPE'   => back(),
            'LEFT'                    => back(),
            'TAB'                     => switch(tab + step),
            _                         => ()
        }
    }

    on-event(ev) {
        match ev {
            event.Text($t)                                     => return on-text(t),
            event.Key({key: $k, mods: $m, event: (1 or 2), *}) => return on-key(k, m),
            event.ScrollUp(_)                                  => screen.move(-3),
            event.ScrollDown(_)                                => screen.move(3),
            event.EOF                                          => return ink::Exit,
            _                                                  => ()
        }
    }
}

pub fn stdio(prof: Profile, w: Int = 120) {
    for page in [Summary(prof), JitOverview(prof)] {
        page.build(w)
        for line in page.text {
            print(line.comb(/ +$/))
        }
        print('')
    }
    let sections = [
        Functions(prof),
        Lines(prof),
        Lines(prof, sort: 'alloc', title: 'Allocations'),
        Natives(prof),
        JitMisses(prof),
        JitDeopts(prof),
        JitCompiled(prof),
        JitDeclined(prof)
    ]
    for s in sections {
        if s.count == 0 {
            continue
        }
        print('')
        print(bold(s.title))
        print(s.header(w).fit(w).comb(/ +$/))
        for i in ..min(s.count, 50) {
            print(s.row(i, w).fit(w).comb(/ +$/))
        }
    }
}

pub fn main(args: Array[String] = argv[1;]) {
    let path = DEFAULT_PATH
    let stdio? = !os.isatty(1)
    for a in args {
        match a {
            /^--color=/                     => (),
            '--stdio'                       => stdio? = true,
            '--tui'                         => stdio? = false,
            /^-/                            => {
                eprint("ty --prof-report: unknown option {a}")
                os.exit(2)
            },
            _                               => path = a
        }
    }
    let prof = try {
        Profile(path)
    } catch e {
        eprint("ty --prof-report: {path}: {e}")
        os.exit(1)
    }
    if stdio? {
        return stdio(prof)
    }
    run(App(prof), title: "profile {prof.data['target']}")
}
