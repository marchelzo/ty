import os
import time (now)
import errno (EINTR)

#|if __windows__
const SHELL = ['cmd.exe', '/c']
#|else
const SHELL = ['/bin/sh', '-c']
#|]

pub tag Exit, Killed, Timeout;

pub use Fate = Exit[Int] | Killed[Int] | Timeout

pub const Success = Exit(0)

pub class CmdResult {
    fate:   Fate
    stdout: String
    stderr: String
    rusage: os.RUsage

    ok? -> Bool {
        fate == Success
    }
}

pub fn run(
    cmd: String,
    argv: Array[String],
    input: Blob | String | nil = nil,
    timeout: Float | Int | nil = nil,
    signal: Int = os.SIGTERM,
    combineOutput: Bool = false,
    shareStderr: Bool = false,
    chdir: Int | String | Blob | nil = nil,
    env: Dict[String, String] | nil = nil,
    rlimits: Dict[Int, Int | (Int, Int)] | nil = nil,
    sigdefault: ?Array[Int] = nil,
    inherit: Array[Int] | Bool | nil = nil,
    umask: ?Int = nil,
    pdeathsig: ?Int = nil
) -> CmdResult {
    let stderr = combineOutput ? os.SPAWN_MERGED_STDERR
               : shareStderr   ? os.SPAWN_INHERIT
               :                 os.SPAWN_PIPE

    let p = os.spawn(
        cmd,
        argv,
        stdin=(input != nil) ? os.SPAWN_PIPE : os.SPAWN_NULL,
        stdout=os.SPAWN_PIPE,
        stderr=stderr,
        chdir=chdir,
        env=env,
        rlimits=rlimits,
        sigdefault=sigdefault,
        inherit=inherit,
        umask=umask,
        pdeathsig=pdeathsig,
        detach=timeout != nil
    )

    let out = Blob()
    let err = Blob()

    if input != nil {
        os.write(p.stdin, input)
        os.close(p.stdin)
    }

    let deadline = (timeout == nil) ? nil : now() + timeout

    let timed-out? = false

    let pfds-in = [
        (p.stdout, os::POLLIN, out),
        (p.stderr, os::POLLIN, err) if p.stderr != p.stdout
    ]
    let pfds-out = []

#|if __apple__ || __linux__ || __bsd__
    for (;;) {
        let left = deadline ?: (deadline - now())

        if left && left <= 1.0e-3 {
            os.kill(-p.pid, signal)
            timed-out? = true
            break
        }

        let n = os.poll(pfds-in, pfds-out, left)

        continue if (n == 0) || (n == EINTR)

        let stop = (n < 0)

        for (fd, ev, buf) in pfds-out {
            if ev & os.POLLIN {
                os.read(fd, buf, 4096)
            }
            if ev & (os.POLLERR | os.POLLHUP) {
                stop = true
            }
        }

        break if stop
    }

    os.close(p.stdout)
    if p.stderr != p.stdout {
        os.close(p.stderr)
    }

    let {status, rusage, *} = os.wait4(p.pid)!

    let fate = timed-out?             ? Timeout
             : os.WIFSIGNALED(status) ? Killed(os.WTERMSIG(status))
             :                          Exit(os.WEXITSTATUS(status))

    CmdResult(fate:, stdout: out.str!(), stderr: err.str!(), rusage:)
#|else
    let stdoutThread = Thread(-> do {
        while let $data = os.read(p.stdout, 4096) {
            out.push(data)
        }
    })

    let stderrThread = Thread(-> do {
        while let $data = os.read(p.stderr, 4096) {
            err.push(data)
        }
    })

    if timeout == nil {
        stdoutThread.join()
        stderrThread.join()
    } else {
        let start = utime()
        let remainingMs = int(timeout * 1.0e3)

        if not let Some(_) = stdoutThread.join(remainingMs) {
            return nil
        }

        remainingMs -= (utime() - start) / 1000

        if not let Some(_) = stderrThread.join(max(0, remainingMs)) {
            return nil
        }

    }

    return out.str!()
#|]
}

pub fn run(
    argv: Array[String],
    input: Blob | String | nil = nil,
    timeout: Float | Int | nil = nil,
    signal: Int = os.SIGTERM,
    combineOutput: Bool = false,
    shareStderr: Bool = false,
    chdir: Int | String | Blob | nil = nil,
    env: Dict[String, String] | nil = nil,
    rlimits: Dict[Int, Int | (Int, Int)] | nil = nil,
    sigdefault: ?Array[Int] = nil,
    inherit: Array[Int] | Bool | nil = nil,
    umask: ?Int = nil,
    pdeathsig: ?Int = nil
) -> CmdResult {
    run(
        argv[0], argv,
        input:, timeout:, signal:, combineOutput:, shareStderr:, chdir:, env:,
        rlimits:, sigdefault:, inherit:, umask:, pdeathsig:
    )
}

pub fn sh(
    cmd: String,
    input: Blob | String | nil = nil,
    timeout: Float | Int | nil = nil,
    signal: Int = os.SIGTERM,
    combineOutput: Bool = false,
    shareStderr: Bool = false,
    chdir: Int | String | Blob | nil = nil,
    shell: Array[String] = SHELL,
    env: Dict[String, String] | nil = nil,
    rlimits: Dict[Int, Int | (Int, Int)] | nil = nil,
    sigdefault: ?Array[Int] = nil,
    inherit: Array[Int] | Bool | nil = nil,
    umask: ?Int = nil,
    pdeathsig: ?Int = nil
) -> CmdResult {
    run(
        [*shell, cmd],
        input:, timeout:, signal:, combineOutput:, shareStderr:, chdir:, env:,
        rlimits:, sigdefault:, inherit:, umask:, pdeathsig:
    )
}

pub fn ls(d: String, flags: String = '') -> Array[String] {
    sh("ls '{d}' {flags}").stdout.split("\n")
}

pub fn expand(s: String) -> String {
    sh("echo -n {s}").stdout
}
