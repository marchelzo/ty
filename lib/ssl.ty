/**
 * TLS via OpenSSL 3.
 *
 * `Context` holds certificates, verification settings, ALPN and SNI.
 * `Session` is a socket-free TLS engine over memory BIOs for event loops,
 * `Stream` is blocking TLS over a connected socket, and `connect` dials one.
 *
 * ```
 * import ssl
 *
 * let s = ssl.connect('example.com', 443, alpn: ['http/1.1'])
 * s.write('GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n')
 * print(s.read-all().str())
 * ```
 *
 * A Context may be shared between threads; a Session or Stream must be used
 * by one thread at a time.
 *
 * libssl and libcrypto are loaded on first use, so importing this module
 * never fails; `available?()` reports whether OpenSSL 3 could be loaded.
 */
import _ssl as x
import os
import net
import time
import base64

pub const TLS1_2 = 0x0303
pub const TLS1_3 = 0x0304

pub const VERIFY_NONE                 = 0x00
pub const VERIFY_PEER                 = 0x01
pub const VERIFY_FAIL_IF_NO_PEER_CERT = 0x02

const SSL_CTRL_MODE                  = 33
const SSL_CTRL_SET_SESS_CACHE_MODE   = 44
const SSL_CTRL_SET_MIN_PROTO_VERSION = 123
const SSL_CTRL_SET_MAX_PROTO_VERSION = 124

const SSL_MODE_ENABLE_PARTIAL_WRITE       = 0x01
const SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER = 0x02
const SSL_MODE_RELEASE_BUFFERS            = 0x10

const SSL_OP_NO_TICKET                = 1 << 14
const SSL_OP_NO_COMPRESSION           = 1 << 17
const SSL_OP_CIPHER_SERVER_PREFERENCE = 1 << 22
const SSL_OP_NO_RENEGOTIATION         = 1 << 30

const SSL_SESS_CACHE_SERVER = 0x0002

const E_BASE = -1000

const READ_CHUNK = 1 << 14

/// Whether OpenSSL 3 (libssl and libcrypto) could be loaded.
pub fn available?() -> Bool {
    x.available?()
}

pub class SSLError < RuntimeError {
    code:    Int
    reasons: Array[String]

    init(what: String, code: Int = 0, reasons: Array[String] = x.errors()) {
        self.code    = code
        self.reasons = reasons
        super(reasons ? "{what}: {reasons.join('; ')}" : what)
    }
}

pub class CertificateError < SSLError {
    init(what: String, result: Int) {
        super(what, result, [x.verify-error(result)])
    }
}

fn need() {
    if let $why = x.load-error() {
        throw SSLError("ssl: {why}", 0, [])
    }
}

fn pem?(v: String | Blob) -> Bool {
    let s = (v :: Blob) ? v.str!(0, min(#v, 4096)) : v
    s.contains?('-----BEGIN ')
}

fn wire-protocols(protocols: Array[String]) -> Blob {
    let b = Blob()
    for p in protocols {
        if p.size() == 0 || p.size() > 255 {
            throw ValueError("ssl: invalid ALPN protocol name: '{p}'")
        }
        b.push(p.size())
        b.push(p)
    }
    b
}

fn ctx-check!(what: String, rc: Int) {
    if rc != 1 {
        throw SSLError(what)
    }
}

fn step!(failed: String | nil) {
    if let $what = failed {
        throw SSLError(what)
    }
}

/// TLS configuration. `cert`/`key`/`ca` accept PEM text or file paths.
/// Clients verify peers against the system store by default (`verify: false`
/// disables it); servers request client certificates only with
/// `verify: true`.
pub class Context {
    server?: Bool

    __ctx:    Ptr
    __sni:    Dict[String, Context]
    __sni-fn: ((String) -> Context | nil) | nil
    __sni?:   Bool

    init(
        server: Bool = false,
        cert: ?(String | Blob) = nil,
        key: ?(String | Blob) = nil,
        ca: ?(String | Blob) = nil,
        ca-path: ?String = nil,
        verify: ?Bool = nil,
        alpn: Array[String] = [],
        min-version: Int = TLS1_2,
        max-version: Int = 0,
        ciphers: ?String = nil,
        ciphersuites: ?String = nil,
        tickets: Bool = true
    ) {
        need()

        server?  = server
        __sni    = %{}
        __sni-fn = nil
        __sni?   = false
        __ctx    = x.ctx-new(server) ?? throw SSLError('SSL_CTX_new')

        x.ctx-ctrl(__ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, min-version)
        if max-version != 0 {
            x.ctx-ctrl(__ctx, SSL_CTRL_SET_MAX_PROTO_VERSION, max-version)
        }

        x.ctx-ctrl(
            __ctx,
            SSL_CTRL_MODE,
            SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER | SSL_MODE_RELEASE_BUFFERS
        )

        x.ctx-options(
            __ctx,
            SSL_OP_NO_COMPRESSION | SSL_OP_NO_RENEGOTIATION | (server ? SSL_OP_CIPHER_SERVER_PREFERENCE : 0)
        )

        if !tickets {
            x.ctx-options(__ctx, SSL_OP_NO_TICKET)
        }

        if server {
            x.ctx-ctrl(__ctx, SSL_CTRL_SET_SESS_CACHE_MODE, SSL_SESS_CACHE_SERVER)
            x.ctx-session-id(__ctx, 'ty-ssl')
        }

        if let $list = ciphers {
            ctx-check!('SSL_CTX_set_cipher_list', x.ctx-cipher-list(__ctx, list))
        }

        if let $suites = ciphersuites {
            ctx-check!('SSL_CTX_set_ciphersuites', x.ctx-ciphersuites(__ctx, suites))
        }

        if cert != nil {
            load-cert-chain(cert, key ?? cert)
        }

        if ca != nil || ca-path != nil {
            load-verify(ca, ca-path)
        } else if !server && verify != false {
            ctx-check!('SSL_CTX_set_default_verify_paths', x.ctx-default-verify(__ctx))
        }

        let mode = match (server, verify) {
            (_, true)      => VERIFY_PEER | (server ? VERIFY_FAIL_IF_NO_PEER_CERT : 0),
            (false, nil)   => VERIFY_PEER,
            _              => VERIFY_NONE
        }
        x.ctx-verify(__ctx, mode)

        if alpn {
            set-alpn(alpn)
        }
    }

    static server(cert: String | Blob, key: ?(String | Blob) = nil, %kwargs) -> Context {
        Context(server: true, cert: cert, key: key, **kwargs)
    }

    static client(%kwargs) -> Context {
        Context(server: false, **kwargs)
    }

    ptr -> Ptr {
        __ctx
    }

    load-cert-chain(cert: String | Blob, key: String | Blob = cert) {
        x.clear-errors()

        if pem?(cert) {
            step!(x.ctx-cert-pem(__ctx, cert))
        } else {
            ctx-check!("SSL_CTX_use_certificate_chain_file('{cert}')", x.ctx-cert-file(__ctx, str(cert)))
        }

        if pem?(key) {
            step!(x.ctx-key-pem(__ctx, key))
        } else {
            ctx-check!("SSL_CTX_use_PrivateKey_file('{key}')", x.ctx-key-file(__ctx, str(key)))
        }

        ctx-check!('SSL_CTX_check_private_key', x.ctx-check-key(__ctx))
    }

    load-verify(ca: ?(String | Blob) = nil, ca-path: ?String = nil) {
        x.clear-errors()

        if let $pem = ca and pem?(pem) {
            step!(x.ctx-ca-pem(__ctx, pem))
            if ca-path != nil {
                ctx-check!('SSL_CTX_load_verify_locations', x.ctx-verify-locations(__ctx, nil, ca-path))
            }
            return
        }

        ctx-check!(
            'SSL_CTX_load_verify_locations',
            x.ctx-verify-locations(__ctx, (ca == nil) ? nil : str(ca), ca-path)
        )
    }

    set-alpn(protocols: Array[String]) {
        if x.ctx-alpn(__ctx, wire-protocols(protocols), server?) != 0 {
            throw SSLError('SSL_CTX_set_alpn_protos')
        }
    }

    sni(host: String, ctx: Context) -> Context {
        __sni[host.lower()] = ctx
        __install-sni()
        self
    }

    on-sni(f: (String) -> Context | nil) -> Context {
        __sni-fn = f
        __install-sni()
        self
    }

    /// Called by `_ssl` during a server handshake that carries SNI: the
    /// context to switch to, or nil to keep this one.
    sni-select(host: String) -> Ptr | nil {
        let name = host.lower()
        let other = __sni[name] ?? (__sni-fn ?? (_ -> nil))(name)
        (other == nil) ? nil : other.ptr
    }

    __install-sni() {
        if !__sni? {
            __sni? = true
            x.ctx-sni(__ctx)
        }
    }

    session(host: ?String = nil) -> Session {
        Session(self, host)
    }

    wrap(fd: Int, host: ?String = nil) -> Stream {
        Stream(self, fd, host)
    }
}

fn fail!(what: String, rc: Int) {
    throw SSLError(what, E_BASE - rc)
}

/// TLS state machine over memory BIOs: feed it ciphertext, read plaintext,
/// write plaintext, and drain ciphertext. It never touches a socket, so it
/// works under any event loop (io_uring, kqueue). Not thread-safe: use one
/// Session from one thread at a time.
pub class Session {
    __ctx: Context
    __s:   Ptr

    init(ctx: Context, host: ?String = nil) {
        __ctx = ctx
        let ip? = host != nil && (host.contains?(':') || host.match?(/^\d+\.\d+\.\d+\.\d+$/))
        __s = x.new(ctx.ptr, ctx.server?, host, ip?) ?? throw SSLError('SSL_new')
    }

    context -> Context {
        __ctx
    }

    ptr -> Ptr {
        __s
    }

    handshaken? -> Bool {
        x.done?(__s)
    }

    closed? -> Bool {
        x.eof?(__s)
    }

    alpn -> String | nil {
        x.alpn(__s)
    }

    version -> String {
        x.version(__s)
    }

    cipher -> String | nil {
        x.cipher(__s)
    }

    server-name -> String | nil {
        x.server-name(__s)
    }

    peer -> String | nil {
        x.peer(__s)
    }

    verify-result -> Int {
        x.verify-result(__s)
    }

    feed(data: Blob | String | Ptr, n: ?Int = nil) -> Int {
        let len = n ?? data.size()
        let rc = x.feed(__s, data, len)
        if rc != len {
            throw SSLError('BIO_write')
        }
        rc
    }

    feed-eof() {
        x.feed-eof(__s)
    }

    handshake() -> Bool {
        match x.handshake(__s, __ctx) {
            1 => true,
            0 => false,
            e => do {
                let result = x.verify-result(__s)
                if result != 0 {
                    throw CertificateError('ssl: certificate verification failed', result)
                }
                throw SSLError('ssl: handshake failed', -e)
            }
        }
    }

    read(out: Blob, max: Int = READ_CHUNK) -> Int {
        match x.read(__s, out, #out, max, true) {
            n and n <= E_BASE => fail!('ssl: read failed', n),
            n                 => n
        }
    }

    read-into(out: Blob, at: Int, max: Int) -> Int {
        match x.read(__s, out, at, max, false) {
            n and n <= E_BASE => fail!('ssl: read failed', n),
            n                 => n
        }
    }

    write(data: Blob | String, off: Int = 0, n: ?Int = nil) -> Int {
        match x.write(__s, data, off, n ?? (data.size() - off)) {
            k and k <= E_BASE => fail!('ssl: write failed', k),
            k                 => k
        }
    }

    write-ptr(p: Ptr, len: Int) -> Int {
        match x.write(__s, p, 0, len) {
            k and k <= E_BASE => fail!('ssl: write failed', k),
            k                 => k
        }
    }

    pending -> Int {
        x.pending(__s)
    }

    buffered -> Int {
        x.buffered(__s)
    }

    drain(out: Blob) -> Int {
        x.drain(__s, out)
    }

    shutdown() {
        x.shutdown(__s)
    }
}

/// Blocking TLS over a connected socket. Uses MSG_NOSIGNAL (SO_NOSIGPIPE on
/// macOS), so writing to a closed peer throws instead of raising SIGPIPE.
pub class Stream {
    fd: Int

    __s: Session

    init(ctx: Context, fd: Int, host: ?String = nil) {
        self.fd = fd
        __s     = Session(ctx, host)
#|if __apple__
        os.setsockopt(fd, 0xFFFF, 0x1022, 1)
#|]
    }

    session -> Session {
        __s
    }

    alpn -> String | nil {
        __s.alpn
    }

    version -> String {
        __s.version
    }

    cipher -> String | nil {
        __s.cipher
    }

    peer -> String | nil {
        __s.peer
    }

    __flush() {
        let rc = x.send-to(__s.ptr, fd)
        if rc < 0 {
            throw OSError('ssl: send', -rc)
        }
    }

    __fill() -> Bool {
        match x.recv-from(__s.ptr, fd) {
            0          => false,
            n and n < 0 => throw OSError('ssl: recv', -n),
            _          => true
        }
    }

    handshake() -> Stream {
        while true {
            let done? = __s.handshake()
            __flush()
            if done? {
                return self
            }
            if !__fill() {
                throw SSLError('ssl: connection closed during handshake')
            }
        }
    }

    read(n: Int = READ_CHUNK) -> Blob | nil {
        let out = Blob()
        while true {
            let k = __s.read(out, n)
            __flush()
            if k > 0 {
                return out
            }
            if k < 0 || !__fill() {
                return nil
            }
        }
    }

    read-all() -> Blob {
        let out = Blob()
        while let $chunk = read() {
            out.push(chunk)
        }
        out
    }

    write(data: Blob | String) -> Int {
        let n = __s.write(data)
        __flush()
        n
    }

    shutdown() {
        try {
            __s.shutdown()
            __flush()
        } catch _ {
        }
    }

    close() {
        if fd >= 0 {
            shutdown()
            os.close(fd)
            fd = -1
        }
    }

    __drop__ = use close
}

pub fn connect(
    host: String,
    port: Int = 443,
    ctx: ?Context = nil,
    alpn: Array[String] = [],
    verify: Bool = true
) -> Stream {
    let ctx = ctx ?? Context(server: false, alpn: alpn, verify: verify)
    let fd = net.dial('tcp', "{host}:{port}")
    try {
        Stream(ctx, fd, host).handshake()
    } catch e {
        os.close(fd)
        throw e
    }
}

/// Generates a self-signed P-256 certificate, returning PEM strings
/// `(cert, key)`. Intended for development servers and tests.
pub fn self-signed(
    cn: String = 'localhost',
    days: Int = 30,
    san: Array[String] = ['DNS:localhost', 'IP:127.0.0.1', 'IP:::1']
) -> (String, String) {
    need()
    match x.self-signed(cn, days, san.join(','), (os.getpid() << 16) ^ int(time.utc())) {
        what: String => throw SSLError(what),
        pair         => pair
    }
}

/// `n` cryptographically secure random bytes.
pub fn random-bytes(n: Int) -> Blob {
    need()
    x.random-bytes(n) ?? throw SSLError('RAND_bytes')
}

/// HMAC-SHA256 of `data` keyed by `key` (32 bytes).
pub fn hmac-sha256(key: String | Blob, data: String | Blob) -> Blob {
    need()
    x.hmac-sha256(key, data) ?? throw SSLError('HMAC')
}

/// Constant-time comparison of two byte strings.
pub fn equal?(a: String | Blob, b: String | Blob) -> Bool {
    x.equal?(a, b)
}

/// URL-safe base64 without padding.
pub fn b64url(data: String | Blob) -> String {
    let b = (data :: Blob) ? data : Blob(data)
    b.base64().sub('+', '-').sub('/', '_').sub('=', '')
}

pub fn b64url-decode(s: String) -> Blob | nil {
    if !s.match?(/^[A-Za-z0-9_-]*$/) {
        return nil
    }
    let t = s.sub('-', '+').sub('_', '/')
    let pad = (4 - t.size() % 4) % 4
    if pad == 3 {
        return nil
    }
    try {
        base64.decode(t + '=' * pad)
    } catch _ {
        nil
    }
}
