import os
import ty
import ty.mod as tmod
import path (Path)
import syn
import syn.lint as lint
import syn.fmt as sf
import syn.fix as fixer
import json
import diff

let LINT_HELP = '''usage: ty --lint [OPTIONS] [PATH...]

Lint Ty sources. Directories are searched recursively for *.ty files.

options:
    --fix            apply safe fixes in place
    --unsafe         also apply unsafe fixes (with --fix)
    --rules FILE     load rules from FILE (a module exporting `RULES`)
    --select A,B     only run the named rules
    --ignore A,B     skip the named rules
    --list           list available rules and exit
    --semantic       also run rules that need name resolution and types
    --shallow        do not run imports while parsing
    --help           show this message
'''

let FMT_HELP = '''usage: ty --fmt [OPTIONS] [PATH...]

Format Ty sources. Without --write or --check, prints the result.

options:
    --write          rewrite files in place
    --check          exit with status 1 if any file would change
    --diff           print a unified diff instead of the result
    --tidy           style-preserving mode (only whitespace hygiene)
    --shallow        do not run imports while parsing (macro regions stay verbatim)
    --width N        target line width (default 80)
    --indent N       indentation width (default 4)
    --help           show this message
'''

let FIX_HELP = '''usage: ty --fix [OPTIONS] [PATH...]

Fix everything that can be fixed safely, then tidy the layout, until nothing
changes. Runs every lint rule, including the semantic and style rules; prints
the problems that are left. Directories are searched recursively.

options:
    --check          change nothing; exit with status 1 if any file would change
    --diff           change nothing; print a unified diff of what would change
    --ignore A,B     skip the named rules
    --rules FILE     also run the rules in FILE (a module exporting `RULES`)
    --no-style       skip the style rules
    --first-pass     also run the rules meant for a one-time sweep of old code
                     (e.g. multi-line `if c { return }` → `return if c`)
    --no-fmt         skip the formatter
    --help           show this message
'''

fn collect(paths: Array[String]) -> Array[String] {
    let out: Array[String] = []
    for paths {
        let path = Path(it)
        if path.dir? {
            out += [str(f) for f in path.rglob('*.ty')].sort()
        } else {
            out.push(it)
        }
    }
    out
}

fn split-list(s: String) -> Array[String] {
    s.split(/\s*,\s*/).filter(\_ != '')
}

fn load-rules(file: String) -> Array[lint.Rule] {
    let source = slurp(file) ?? throw ValueError("cannot read rules file {file}")
    let mod = tmod.compile("{source}\nRULES\n", path=str(Path(file).absolute))
    match tmod.eval(mod) {
        rules: Array => [r for r in rules if r :: lint.Rule],
        _            => throw ValueError("{file} does not define RULES"),
    }
}

fn lint-main(args: Array[String]) -> Int {
    let paths: Array[String] = []
    let fix? = false
    let unsafe? = false
    let rules = lint.DEFAULT_RULES
    let select: Array[String] | nil = nil
    let ignore: Array[String] = []
    let deep? = true
    let i = 0
    while i < #args {
        match args[i] {
            '--help' => do {
                print(LINT_HELP)
                return 0
            },
            '--fix'      => fix? = true,
            '--unsafe'   => unsafe? = true,
            '--shallow'  => deep? = false,
            '--semantic' => rules = [*rules, *lint.SEMANTIC_RULES],
            '--rules'   => do {
                i += 1
                rules = [*rules, *load-rules(args[i])]
            },
            '--select'  => do {
                i += 1
                select = split-list(args[i])
            },
            '--ignore'  => do {
                i += 1
                ignore = split-list(args[i])
            },
            '--list'    => do {
                for rules {
                    let note = it.semantic? ? ' (semantic)' : ''
                    print("{it.name:-22} {it.severity:-8} {it.doc}{note}")
                }
                return 0
            },
            a => paths.push(a),
        }
        i += 1
    }

    let active = [
        r
        for r in rules
        if (select == nil || r.name in select) && r.name not in ignore
    ]
    let semantic? = lint.semantic?(active)

    let total = 0
    let fixed = 0
    for f in collect((#paths == 0) ? ['.'] : paths) {
        let source = slurp(f) ?? do {
            eprint("ty --lint: cannot read {f}")
            continue
        }
        if fix? {
            let outcome = lint.fix(
                source,
                active,
                path=f,
                unsafe?=unsafe?,
                semantic=semantic?,
                deep=deep?
            )
            if outcome.source != source {
                Path(f).write(outcome.source)
            }
            fixed += outcome.fixed
            for outcome.diagnostics {
                print(it)
                total += (it.severity == 'info') ? 0 : 1
            }
        } else {
            let tree = syn.parse(source, path=f, deep=deep?, resolve=deep?, semantic=semantic?)
            if let $err = tree.error {
                eprint("{f}: parse error: {err.lines()[0] ?? err}")
                total += 1
                continue
            }
            for lint.check(tree, active) {
                print(it)
                total += (it.severity == 'info') ? 0 : 1
            }
        }
    }

    if fixed > 0 {
        eprint("fixed {fixed} problem(s)")
    }

    (total > 0) ? 1 : 0
}

fn fmt-main(args: Array[String]) -> Int {
    let paths: Array[String] = []
    let write? = false
    let check? = false
    let diff? = false
    let mode = 'canonical'
    let opts = sf.Options()
    let deep? = true
    let i = 0
    while i < #args {
        match args[i] {
            '--help'   => do {
                print(FMT_HELP)
                return 0
            },
            '--write'   => write? = true,
            '--check'   => check? = true,
            '--diff'    => diff? = true,
            '--tidy'    => mode = 'tidy',
            '--shallow' => deep? = false,
            '--width'  => do {
                i += 1
                opts.width = int(args[i]) ?? 80
            },
            '--indent' => do {
                i += 1
                opts.indent = int(args[i]) ?? 4
            },
            a => paths.push(a),
        }
        i += 1
    }

    let changed = 0
    for collect((#paths == 0) ? ['.'] : paths) {
        let source = slurp(it) ?? do {
            eprint("ty --fmt: cannot read {it}")
            continue
        }
        let out = sf.format(source, path=it, mode=mode, opts=opts, deep=deep?)
        continue if out == source
        changed += 1
        if check? {
            print("{it}: would reformat")
        } else if diff? {
            print("--- {it}\n+++ {it} (formatted)")
            print(diff.unified(diff.edits(source.lines(), out.lines())).join('\n'))
        } else if write? {
            Path(it).write(out)
            print("formatted {it}")
        } else {
            print(out, end='')
        }
    }

    (check? && changed > 0) ? 1 : 0
}

class FileResult {
    out:       Array[String]
    err:       Array[String]
    changed?:  Bool
    fixed:     Int
    remaining: Int

    init() {
        self.out = []
        self.err = []
        self.changed? = false
        self.fixed = 0
        self.remaining = 0
    }
}

class FixMode {
    rules:   Array[lint.Rule]
    check?:  Bool
    diff?:   Bool
    format?: Bool

    init(rules: Array[lint.Rule], check: Bool, diff: Bool, format: Bool) {
        self.rules = rules
        self.check? = check
        self.diff? = diff
        self.format? = format
    }
}

fn fix-file(f: String, mode: FixMode) -> FileResult {
    let r = FileResult()
    let $source = slurp(f) or do {
        r.err.push("ty --fix: cannot read {f}")
        r.remaining += 1
        return r
    }
    let out = fixer.run(source, path=f, rules=mode.rules, format=mode.format?)
    if let $err = out.error {
        let line = err.lines().find(\_.match?(/^\w*Error:/)) ?? err.lines()[0] ?? err
        r.err.push("{f}: parse error: {line}")
        r.remaining += 1
        return r
    }
    if !out.converged? {
        r.err.push("{f}: fixes did not settle after {out.passes} passes")
    }
    for out.diagnostics {
        if it.severity != 'info' {
            r.out.push(str(it))
            r.remaining += 1
        }
    }
    return r if out.source == source
    r.changed? = true
    r.fixed = out.fixed
    if mode.check? {
        r.out.push("{f}: would change")
    } else if mode.diff? {
        r.out.push("--- {f}\n+++ {f} (fixed)")
        r.out.push(diff.unified(diff.edits(source.lines(), out.source.lines())).join('\n'))
    } else {
        Path(f).write(out.source)
        r.err.push("fixed {f}")
    }
    r
}

fn preload(files: Array[String]) {
    let seen: Dict[String, Bool] = %{}
    for files {
        let $source = slurp(it) or continue
        for [_, name] in source.matches(/^(?:pub\s+)?import\s+([\w.\/-]+)/m) {
            let m = name.replace('.', '/')
            continue if seen[m]
            seen[m] = true
            try {
                tmod.load(m)
            } catch _ {
            }
        }
    }
    for tmod.list() {
        syn.adopt(it)
    }
}

fn preparse(f: String) {
    let $source = slurp(f) or return
    return if syn.adoptable?(source, f)
    try {
        syn.preparse(source, f, false)
        if !fixer.prelude?(f) {
            syn.preparse(source, f, true)
        }
    } catch _ {
    }
}

fn prepare(files: Array[String]) {
    preload(files)
    for files {
        preparse(it)
    }
}

fn encode(r: FileResult) -> String {
    json.encode({
        out: r.out,
        err: r.err,
        changed: r.changed?,
        fixed: r.fixed,
        remaining: r.remaining
    })
}

fn decode(text: String) -> FileResult {
    let d: Dict[String, _] = json.parse(text)
    let r = FileResult()
    r.out = [str(it) for d['out'] ?? []]
    r.err = [str(it) for d['err'] ?? []]
    r.changed? = d['changed'] == true
    r.fixed = int(d['fixed']) ?? 0
    r.remaining = int(d['remaining']) ?? 0
    r
}

fn child(files: Array[String], mode: FixMode, queue: Int, dir: String) {
    while let $rec = os.read(queue, 8) {
        break if #rec < 8
        let i = int(rec.str().strip()) ?? break
        let r = try {
            fix-file(files[i], mode)
        } catch e {
            let fail = FileResult()
            fail.err.push("{files[i]}: {e}")
            fail.remaining += 1
            fail
        }
        Path("{dir}/{i}.json").write(encode(r))
    }
    os.exit(0)
}

fn fix-all(files: Array[String], mode: FixMode) -> Array[FileResult] {
    syn.derive-plain(true)
    prepare(files)
    if #files == 1 {
        return [fix-file(files[0], mode)]
    }
    let sizes = files.map(f -> os.stat(f).?size ?? 0)
    let order = [i for i in ..#files].sort(by=\-sizes[_])
    let (r, w) = os.pipe()
    for order {
        os.write(w, "{it:7}\n")
    }
    os.close(w)
    let dir = os.mkdtemp() ?? throw OSError('mkdtemp()')
    let n = max(1, min(os.ncpu(), #files))
    let pids: Array[Int] = []
    for ..n {
        let pid = os.fork() ?? throw OSError('fork()')
        if pid == 0 {
            child(files, mode, r, dir)
        }
        pids.push(pid)
    }
    os.close(r)
    for pids {
        os.wait(it)
    }
    let results: Array[FileResult] = []
    for f; i in files {
        let $text = slurp("{dir}/{i}.json") or do {
            let lost = FileResult()
            lost.err.push("ty --fix: {f}: no result")
            lost.remaining += 1
            results.push(lost)
            continue
        }
        results.push(decode(text))
        os.unlink("{dir}/{i}.json")
    }
    os.rmdir(dir)
    results
}

fn fix-main(args: Array[String]) -> Int {
    let paths: Array[String] = []
    let check? = false
    let diff? = false
    let format? = true
    let rules = fixer.ALL_RULES
    let ignore: Array[String] = []
    let i = 0
    while i < #args {
        match args[i] {
            '--help'       => do {
                print(FIX_HELP)
                return 0
            },
            '--check'      => check? = true,
            '--diff'       => diff? = true,
            '--no-fmt'     => format? = false,
            '--no-style'   => rules = rules.filter(\_ not in fixer.STYLE_RULES),
            '--first-pass' => rules = [*rules, *fixer.FIRST_PASS_RULES],
            '--ignore'     => do {
                i += 1
                ignore = split-list(args[i])
            },
            '--rules'      => do {
                i += 1
                rules = [*rules, *load-rules(args[i])]
            },
            a              => paths.push(a),
        }
        i += 1
    }

    let files = collect((#paths == 0) ? ['.'] : paths)
    let mode = FixMode(rules.filter(\_.name not in ignore), check?, diff?, format?)
    let changed = 0
    let remaining = 0
    let fixed = 0
    for fix-all(files, mode) {
        for line in it.out {
            print(line)
        }
        for line in it.err {
            eprint(line)
        }
        changed += it.changed? ? 1 : 0
        fixed += it.fixed
        remaining += it.remaining
    }

    if changed > 0 && !check? && !diff? {
        eprint("{changed} file(s) changed, {fixed} fix(es)")
    }

    match (check?, changed > 0, remaining > 0) {
        (true, true, _) => 1,
        (_, _, true)    => 1,
        _               => 0,
    }
}

pub fn main(mode: String) {
    let args = argv[1;]
    let status = match mode {
        'lint' => lint-main(args),
        'fmt'  => fmt-main(args),
        'fix'  => fix-main(args),
        _      => do {
            eprint("unknown tool mode: {mode}")
            2
        },
    }
    os.exit(status)
}
