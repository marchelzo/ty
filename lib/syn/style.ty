import syn (Node)
import syn.lint as lint (Rule)
import syn.rules (rules!, RuleSet)

let LIMIT = 100

fn indent-of(n: Node) -> String {
    let tree = n.tree
    tree.text(tree.line-start(n.line), n.start).match(/^[ \t]*/) ?? ''
}

fn one-line?(n: Node) -> Bool { n.line == n.end-line }

fn value-site?(n: Node) -> Bool {
    let $p = n.parent or return false
    let returned? = p.kind == 'Block'
                 && p.parent.?kind == 'Function'
                 && one-line?(p)
                 && #p.nodes == 1
    p.kind != 'If' && (p.kind not in ['Block', 'Module'] || returned?)
}

fn simple-compr?(n: Node) -> Bool {
    let clause = n.own.map(&.text).filter(\_ in ['for', 'in', 'if', 'where', 'while'])
    let sugared? = clause[;2] != ['for', 'in']
    let shape = sugared? ? clause[1;] : clause[2;]
    if shape != [] && shape != ['if'] {
        return false
    }
    let $kw-for = n.own.find(\_.text == 'for') or return false
    let rest = n.nodes.filter(k -> k.start > kw-for.start)
    #rest == (sugared? ? 1 : 2) + #shape && (sugared? || rest[0].kind == 'List')
}

fn first-word(n: Node) -> String { n.first-token.?text ?? 'loop' }

fn blank-pattern(p: Node) -> String { '_'.pad(p.text.width()) }

fn count-of(xs: Array[Any]) -> Int { #xs }

fn it-members(n: Node) -> Array[Node] {
    [m for m in [n, *n.descendants()] if m.kind == 'MemberAccess' && m.nodes.?[0].?text == 'it']
}

fn repeated-member(e: Node, c: Node) -> Node | nil {
    let uses = [*it-members(e), *it-members(c)].filter(one-line?)
    let repeated = uses.group-by(&.text).filter(\#_ >= 2)
    (#repeated == 1) ? repeated[0][0] : nil
}

fn where-name(m: Node, compr: Node) -> String | nil {
    let name = m.text.comb(/^it\./)
    let taken? = [compr, *compr.descendants()].any?(k -> k.kind == 'Identifier' && k.text == name)
    (name.match?(/^[a-z][\w-]*$/) && !taken?) ? name : nil
}

fn plain-literal?(n: Node) -> Bool {
    let $p = n.parent or return n.text.match?(/^["']/)
    let concat? = p.kind == 'Sugar' && p.form == 'string-concat'
    let markup? = p.kind == 'FunctionCall' && p.first-token.?text == '<'
    n.text.match?(/^["']/) && !concat? && !markup?
}

fn interpolating?(n: Node) -> Bool { n.own.any?(\_.text == '{') }

fn single-body(body: String) -> String | nil {
    let out: Array[String] = []
    let cs = body.chars()
    let i = 0
    while i < #cs {
        let c = cs[i]
        if c == "'" {
            return nil
        }
        if c != '\\' || i + 1 >= #cs {
            out.push(c)
            i += 1
            continue
        }
        let next = cs[i + 1]
        out.push((next in ['{', '}', '"']) ? next : "\\{next}")
        i += 2
    }
    out.join('')
}

fn double-body(body: String) -> String {
    let out: Array[String] = []
    let cs = body.chars()
    let i = 0
    while i < #cs {
        let c = cs[i]
        if c == '\\' && i + 1 < #cs {
            let next = cs[i + 1]
            out.push((next == "'") ? "'" : "\\{next}")
            i += 2
            continue
        }
        out.push((c in ['{', '}', '"']) ? "\\{c}" : c)
        i += 1
    }
    out.join('')
}

fn single-quoted(n: Node) -> String | nil {
    let $body = single-body(n.text[1;-1]) or return nil
    "'{body}'"
}

fn double-quoted(n: Node) -> String | nil {
    let body = n.text[1;-1]
    ("\\'" in body && !body.match?(/["{}]/)) ? "\"{double-body(body)}\"" : nil
}

fn one-line-holes?(n: Node) -> Bool {
    let tree = n.tree
    let opens = n.own.filter(\_.text == '{')
    let closes = n.own.filter(\_.text == '}')
    #opens == #closes
 && opens.zip(closes).all?(|(a, b)| -> tree.line-of(a.start) == tree.line-of(b.start))
}

fn folds?(n: Node) -> Bool {
    let $p = n.parent or return false
    let slice? = p.kind == 'Slice'
              && p.nodes[0] == n
              && #p.nodes == 2
              && p.nodes[1].text == '1'
              && p.own.map(&.text) == ['[', ';', ']']
    slice? && n.text[1;-1].split('\n')[0] == ''
}

fn triple-quoted(n: Node, mode: String) -> String | nil {
    let double? = n.kind == 'SpecialString'
    let delim = double? ? '"""' : "'''"
    let body = n.text[1;-1]
    if double? && (!one-line-holes?(n) || '"""' in body) {
        return nil
    }
    if !double? && ('\\' in body || "'''" in body) {
        return nil
    }
    let ind = indent-of(n)
    let lines = body.split('\n')
    if mode == 'fold' {
        return nil if lines[0] != ''
        lines = lines[1;]
    }
    let shifted = lines.map(l -> (l == '') ? '' : "{ind}{l}")
    if shifted.zip(lines).any?(|(a, b)| -> a.width() > LIMIT && b.width() <= LIMIT) {
        return nil
    }
    "{delim}\n{shifted.join('\n')}\n{ind}{delim}"
}

fn plus-operands(n: Node) -> Array[Node] {
    if n.kind != 'Plus' || #n.nodes != 2 {
        return [n]
    }
    [*plus-operands(n.nodes[0]), n.nodes[1]]
}

fn str-argument(n: Node) -> Node | nil {
    if n.kind != 'FunctionCall' || #n.nodes != 2 || n.nodes[0].text != 'str' {
        return nil
    }
    let arg = n.nodes[1]
    (arg.kind in ['Kwarg', 'Spread', 'SplatArg']) ? nil : arg
}

fn interpolation-piece(n: Node) -> String | nil {
    if !one-line?(n) {
        return nil
    }
    if n.kind == 'String' && plain-literal?(n) {
        return double-body(n.text[1;-1])
    }
    if n.kind == 'SpecialString' && plain-literal?(n) {
        return n.text.match?(/^"""/) ? nil : n.text[1;-1]
    }
    let e = (str-argument(n) ?? n).unwrapped
    (e.text.match?(/[{}]/)) ? nil : "\{{e.text}\}"
}

fn interpolation(n: Node) -> String | nil {
    let ops = plus-operands(n)
    if !ops.all?(o -> o.of-type?('String') == true) {
        return nil
    }
    let pieces: Array[String] = []
    for ops {
        let $piece = interpolation-piece(it) or return nil
        pieces.push(piece)
    }
    "\"{pieces.join('')}\""
}

pub SET: RuleSet = rules! {
let jump = 'return' | 'break' | 'continue'
let jump-if = `if $$_ { return }` | `if $$_ { break }` | `if $$_ { continue }`
let short-if = `if $$_ { *$$_ }` & !child(0, Condition) & oneline & bare
let it-binder = Function | ImplicitFunction | Sugar | ArrayCompr | DictCompr | EachLoop | Match

@mixed-if-run@ match
$$R: run 2.., statement short-if, contiguous, samecol, !all(jump-if)
@@
* $$+R($$s)

@postfix-jump@
$$c: oneline !Condition
$$j: jump
$$p: statement oneline !mixed-if-run.R
message: use `$$j if …`
doc: `return if c` for a bare jump
@@
- if $$c { $$j }@$$p
+ $$j if $$c

@postfix-jump-multiline@ optional
$$c: oneline !Condition
$$j: jump
$$p: statement !mixed-if-run.R
message: use `$$j if …`
doc: `return if c` for a bare jump, even from a multi-line if
@@
- if $$c { $$j }@$$p
+ $$j if $$c

@if-expression@ soft
$$c: oneline !Condition
$$a, $$b: oneline value bare
$$p: value-site?
message: use `c ? a : b` for a value-producing if/else
doc: `c ? a : b` for a value if/else
@@
- if $$c { $$a } else { $$b }@$$p
+ $$c ? $$a : $$b

@if-let-match@
$$P, $$e: oneline
$$a, $$b: oneline value bare
$$p: value-site?
$$blank = blank-pattern($$P)
message: use `match` instead of a value-producing if-let/else
doc: `match` for a value if-let/else
@@
- if let $$P = $$e { $$a } else { $$b }@$$p
+ match $$e {
+     $$P => $$a,
+     $$blank => $$b
+ }

@comprehension-layout@ layout
kinds: ArrayCompr, DictCompr
$$C: multiline simple-compr?
message: lay the comprehension out one clause per line
doc: one clause per line
@@
  $$C
  group $$C break-before('for', 'if') soft

@kwarg-spacing@ layout
$$k: !aligned('=')
message: no spaces around `=` in a named argument
doc: `name=value` in calls
@@
  $$f($$^($$k
- $$<a ~ /^[ \t]*$/>=$$<b ~ /^[ \t]*$/>
+ =
  $$v))

@statement-lines@ layout
$$a: in (Module | Block & multiline)
message: one statement per line in a multi-line block
doc: one statement per line
@@
  $$a
- $$<g ~ /^[ \t]*;[ \t]*$/>
+ ;$$<nl>
  $$b

@dangling-else@ layout
$$T: multiline
$$E: If
message: `else` belongs right after `}`
doc: `} else {` after a multi-line if
@@
  if $$c { *$$t }@$$T
- $$<g ~ /\n/>else
+ $$<sp>else
  $$E

@dangling-else@ layout
$$T: multiline
$$B: simple
message: `else` belongs right after `}`
@@
  if $$c { *$$t }@$$T
- $$<g ~ /\n/>else { *$$u }@$$B
+ $$<sp>else {
+     $$u
+ }

@dangling-else@ layout
$$T: multiline
$$B: oneline simple
message: expand the `else` of a multi-line `if`
@@
  if $$c { *$$t }@$$T else { *$$u }@$$B
- $$B
+ {
+     $$u
+ }

@dangling-else@ layout
$$T: multiline
$$B: oneline simple in (If & oneline)
message: expand the `else if` of a multi-line `if`
@@
(
  if $$c { *$$t }@$$T else if $$d { *$$u }@$$B
|
  if $$c { *$$t }@$$T else if $$d { *$$u }@$$B else $$E
)
- $$B
+ {
+     $$u
+ }

@align-if-else@ format
$$c: !Condition
$$T, $$E: oneline
message: align the braces of a one-line if/else
doc: aligned one-line if/else
when: bare
@@
  if $$c { *$$t }@$$T$$<nl>else$$<ws>{ *$$e }@$$E
  align '{' of ($$T, $$E) at $$T
  align '}' of ($$T, $$E)

@align-match-arms@ format
$$A: run 2.., oneline first-on-line, adjacent, samecol
message: align the arms of the match
doc: aligned arms
when: bare
@@
  match $$_ { $$+A($$P => $$B) }
  align '=>' after $$P in $$A spread <= 24
  align '}' of $$B: Block in $$A when count($$B: Block) >= 2, all($$B: Block | Null)

@inline-if@
$$p: statement oneline !mixed-if-run.R !(jump-if & !child(0, Condition))
$$p: !if-expression.p !if-let-match.p
$$B: simple
message: put the body of the `if` on its own lines
doc: no one-line if statements
@@
  if $$c
(
- $$<ws>{ *$$s }@$$B
+ $$<sp>{
+     $$s
+ }
|
- $$<ws>{}@$$B
+ $$<sp>{
+     ;
+ }
)
(
  @$$p
|
  else $$E@$$p
)

@align-inline-ifs@ format
$$R: run 2.., statement short-if, contiguous, samecol, !all(jump-if)
$$B: Block
message: align the braces of a run of one-line ifs
doc: aligned runs of one-line ifs
@@
  $$+R(if $$c { *$$b }@$$B)
  align '{' of $$B in $$R spread <= 24
  align '}' of $$B in $$R spread <= 24

@inline-loop@
$$p: statement oneline
$$B: simple
$$word = first-word($$p)
message: put the body of the `$$word` on its own lines
doc: no one-line loops
@@
(
  while $$c
|
  for $$x in $$xs
|
  for $$x in $$xs if $$f
|
  for $$xs
|
  for $$xs if $$f
)
(
- $$<ws>{ *$$s }@$$B
+ $$<sp>{
+     $$s
+ }
|
- $$<ws>{}@$$B
+ $$<sp>{
+     ;
+ }
)
  @$$p

@sugared-for@ semantic
$$x: identifier def !('it' | '_')
$$p: lines <= 13 !inside sugared-for.p !inside (EachLoop & kids == 2)
message: iterate with the implicit `it` instead of `$$x`
doc: `for xs { it }`
when: !mentions('it')
@@
- for $$x in $$xs {
+ for $$xs {
  <...
- $$x
+ it
  ...> when !inside it-binder
  }@$$p

@iso comb@
@@
$$s.sub($$re, '') => $$s.replace($$re, '')

@use-comb@ typed
message: use `.comb(…)` to delete matches
doc: `.comb(re)` to delete matches
@@
- $$(s :? String).sub($$re, '')
+ $$s.comb($$re)

@use-where@
$$m = repeated-member($$e, $$c)
$$name = where-name($$m, $$C)
message: bind `$$m` once with `where`
doc: bind a repeated `it.f` with `where`
@@
  [$$e for $$xs if $$c
+ $$<sp>where $$name = $$m
  ]@$$C
  <... in $$C
- $$m
+ $$name
  ...>

@wrong-string@
kinds: SpecialString
$$s: oneline plain-literal? !interpolating?
$$t = single-quoted($$s)
message: use single quotes for a string without interpolation
doc: '…' without interpolation, triple quotes for multi-line text
@@
- $$s
+ $$t

@wrong-string@
kinds: String
$$s: oneline plain-literal?
$$t = double-quoted($$s)
message: use double quotes instead of escaping single quotes
@@
- $$s
+ $$t

@wrong-string@
kinds: Slice
$$s: string multiline plain-literal? !/^('''|""")/
$$t = triple-quoted($$s, 'fold')
message: use a triple-quoted string for multi-line text
@@
- $$s[1;]
+ $$t

@wrong-string@
kinds: String, SpecialString
$$s: multiline plain-literal? !folds? !/^('''|""")/
$$t = triple-quoted($$s, 'keep')
message: use a triple-quoted string for multi-line text
@@
- $$s
+ $$t

@use-interpolation@ typed
kinds: Plus
$$e: oneline !in Plus
$$t = interpolation($$e)
message: use interpolation instead of concatenating strings
doc: "{a}{b}" instead of a + b on strings
@@
- $$e
+ $$t

@bare-if-argument@ info
$$p: value-site? in (FunctionCall | MethodCall)
message: bind the if/else to a name instead of passing it as an argument
doc: if/else passed as an argument
@@
* $$_($$^(if $$c { *$$x } else { *$$y }@$$p))

@repeated-condition@ info
$$R: run 3.., same($$c)
$$n = count-of($$R)
message: $$n definitions test `$$c`; branch once
doc: one test repeated across definitions
@@
* $$+R(let $$_ = $$c ? $$_ : $$_)
}

pub RULES: Array[Rule] = SET.rules

pub FIRST_PASS_RULES: Array[Rule] = SET.named(['postfix-jump-multiline'])
