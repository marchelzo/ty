import ffi as c (C!)
import os
import time

pub const TFD_NONBLOCK      = 0x800
pub const TFD_CLOEXEC       = 0x80000
pub const TFD_TIMER_ABSTIME = 1

C! struct Itimerspec {
    long interval_sec;
    long interval_nsec;
    long value_sec;
    long value_nsec;
}

C! fn {
    int timerfd_create(int clockid, int flags);
    int timerfd_settime(int fd, int flags, void *nv, void *ov);
    int timerfd_gettime(int fd, void *cv);
}

fn span(sec: Int, nsec: Int) -> Duration {
    Duration(sec * 1000000000 + nsec)
}

pub class TimerFD {
    __fd: Int
    __spec: _

    init(clockid: Int = time.CLOCK_MONOTONIC, flags: Int = TFD_CLOEXEC) {
        __fd = timerfd_create(clockid, flags)
        __spec = Itimerspec()
    }

    fd -> Int { __fd }

    set(initial: Duration | Time[Any], interval: Duration = 0s, flags: Int = 0) -> Int {
        let abs? = !(initial :: Duration)
        __spec.value_sec     = int(initial)  / 1000000000
        __spec.value_nsec    = int(initial)  % 1000000000
        __spec.interval_sec  = int(interval) / 1000000000
        __spec.interval_nsec = int(interval) % 1000000000
        timerfd_settime(__fd, flags | (abs? ? TFD_TIMER_ABSTIME : 0), __spec.get(), nil)
    }

    get() -> {expiry: Duration, interval: Duration} {
        timerfd_gettime(__fd, __spec.get())
        return {
            expiry:   span(__spec.value_sec,    __spec.value_nsec),
            interval: span(__spec.interval_sec, __spec.interval_nsec)
        }
    }

    close() {
        os.close(__fd)
    }
}
