import json
import path (Path)
import tpm.core (fail, config-root, read-json, write-private)

/// API tokens saved by `tpm login`, keyed by registry URL. The file is only
/// ever written with mode 0600.
pub fn file() -> Path {
    config-root() / 'credentials.json'
}

fn key(url: String) -> String {
    url.comb(/\/+$/)
}

fn load() -> Dict {
    let p = file()
    if !p.file? {
        return %{}
    }
    let d = try {
        read-json(p)
    } catch _ {
        fail("{p} is not valid JSON; fix or delete it")
    }
    ((d :: Dict) && (d['registries'] :: Dict)) ? d['registries'] : %{}
}

fn store(registries: Dict) {
    write-private(file(), json.encode(%{'registries': registries}) + '\n')
}

pub fn token(url: String) -> String | nil {
    match load()[key(url)] {
        d: Dict and d['token'] :: String => d['token'],
        _                                => nil
    }
}

pub fn save(url: String, token: String) {
    let all = load()
    all[key(url)] = %{'token': token}
    store(all)
}

/// Forgets the token for `url`; false when there was none.
pub fn forget(url: String) -> Bool {
    let all = load()
    if all[key(url)] == nil {
        return false
    }
    all.remove(key(url))
    store(all)
    true
}
