import ty.mod as tymod
import path (Path)
import tpm.core (TpmError, fail, real, read-json, write-json, write-atomic)
import tpm.manifest as man (Manifest, Native, native-key)
import tpm.registry (Registry)
import tpm.resolve (Resolution, Pkg)
import tpm.platform as plat
import tpm.store as store
import tpm.lock as lock

pub const FILE = '.ty/env.json'

fn shared-library?(name: String) -> Bool {
    name.match?(/\.so(\.[0-9.]+)?$|\.dylib$/)
}

fn dev-native(dir: Path, n: Native) -> Path {
    let here = plat.host()
    let arch = (here == nil) ? 'unsupported' : "{here.os}-{here.arch}"
    let key = native-key(n.lib)
    for d in [dir / 'native' / arch, dir / 'native'] {
        if !d.dir? {
            continue
        }
        let hits = d.ls().filter(f -> shared-library?(f.name) && native-key(f.name) == key)
        if #hits > 0 {
            return real(hits.sort(by=\#_.name)[0])
        }
    }
    let file = (here.?os == 'macos') ? "lib{key}.dylib" : "lib{key}.so"
    dir / 'native' / arch / file
}

fn stem(dir: Path, roots: Array[String], name: String) -> Path {
    let dirs = roots.map(r -> real(dir / r))
    for r in dirs {
        if (r / "{name}.ty").exists? || (r / name).dir? {
            return r / name
        }
    }
    dirs[0] / name
}

class Located {
    dir:     Path
    roots:   Array[String]
    natives: Dict[String, String]

    init(dir: Path, roots: Array[String], natives: Dict[String, String]) {
        self.dir     = dir
        self.roots   = roots
        self.natives = natives
    }
}

fn registry-for(url: String, known: Registry | nil, offline: Bool) -> Registry {
    (known != nil && known.url == url) ? known : Registry(url, offline)
}

fn locate(p: Pkg, registry: Registry | nil, offline: Bool, inputs: Array[_]) -> Located {
    if let $m = p.manifest {
        let natives = %{}
        for n in m.bundled {
            let file = dev-native(m.dir, n)
            natives[n.name] = str(file)
            if p.source != 'git' {
                inputs.push(str(file))
            }
        }
        return Located(m.dir, m.roots, natives)
    }

    let tags = p.artifacts.map(\_.platform)
    let chosen = plat.best(tags) ?? fail(
        "{p.name} {p.version} has no build for {plat.host-tag()} (available: {(#tags == 0) ? 'none' : tags.join(', ')})"
    )
    let art = p.artifacts.find(\_.platform == chosen)!
    let dir = store.fetch(registry-for((p.url)!, registry, offline), p.name, str(p.version), art)
    let meta = read-json(dir / store.META)
    let natives = %{k: str(dir / v) for k, v in meta['natives'] ?? %{}}

    Located(real(dir), meta['roots'] ?? ['.'], natives)
}

/// Writes <project>/.ty/env.json for `res`, fetching registry packages into the store.
pub fn write(res: Resolution, registry: Registry | nil, offline: Bool) -> Path {
    let root = (res.root.manifest)!
    let inputs = [str(root.file), str(root.dir / lock.FILE)]
    let found = %{}

    for p in res.sorted {
        if p.source == 'path' {
            inputs.push(str((p.manifest)!.file))
        }
        found[p.name] = locate(p, registry, offline, inputs)
    }

    let packages = [
        do {
            let here = found[p.name]!
            %{
                'name':    p.name,
                'dir':     str(here.dir),
                'roots':   here.roots.map(r -> str(real(here.dir / r))),
                'deps':    %{
                    d.alias: str(stem(found[d.package]!.dir, found[d.package]!.roots, d.package))
                    for d in p.deps
                },
                'natives': here.natives
            }
        }
        for p in [res.root, *res.sorted.filter(\_ != res.root)]
    ]

    let file = root.dir / FILE
    write-atomic(root.dir / '.ty' / '.gitignore', '*\n')
    write-json(file, %{
        'version':  1,
        'inputs':   inputs.map(f -> [f, tymod.stamp(f)]),
        'packages': packages
    })

    file
}
