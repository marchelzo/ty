import json
import toml
import path (Path)
import tpm.core (TpmError, warn, write-atomic)
import tpm.registry (Artifact)

pub const FILE = 'ty.lock'

pub class Locked {
    name:      String
    version:   String
    source:    String
    deps:      Array[String]
    natives:   Array[String]
    artifacts: Array[Artifact]

    /// `(kind, location, commit)` from `root`, `path+DIR`, `git+URL#COMMIT` or `registry+URL`.
    origin -> (String, String, String | nil) {
        match source {
            'root'                  => ('root', '', nil),
            s and s.starts?('git+') => do {
                let [url, ?commit] = s.comb(/^git\+/).split('#')
                ('git', url, commit)
            },
            s                       => do {
                let [kind, *rest] = s.split('+')
                (kind, rest.join('+'), nil)
            }
        }
    }
}

pub class Lock {
    inputs:   String | nil
    packages: Dict[String, Locked]
}

fn q(s: String) -> String {
    json.encode(s)
}

fn list(xs: Array[String]) -> String {
    "[{xs.map(q).join(', ')}]"
}

pub fn render(inputs: String, packages: Array[Locked]) -> String {
    let out = [
        '# Generated by tpm. Do not edit by hand.',
        'version = 1',
        "inputs = {q(inputs)}",
    ]
    for p in packages.sort(by=\_.name) {
        out.push('')
        out.push('[[package]]')
        out.push("name = {q(p.name)}")
        out.push("version = {q(p.version)}")
        out.push("source = {q(p.source)}")
        if #p.deps > 0 {
            out.push("dependencies = {list(p.deps.sort())}")
        }
        if #p.natives > 0 {
            out.push("natives = {list(p.natives.sort())}")
        }
        for a in p.artifacts.sort(by=\_.platform) {
            out.push('')
            out.push('[[package.artifact]]')
            out.push("platform = {q(a.platform)}")
            out.push("url = {q(a.url)}")
            out.push("sha256 = {q(a.sha256)}")
        }
    }
    out.join('\n') + '\n'
}

pub fn write(file: Path, inputs: String, packages: Array[Locked]) -> Bool {
    let text = render(inputs, packages)
    if file.file? && file.read-text() == text {
        return false
    }
    write-atomic(file, text)
    true
}

pub fn read(file: Path) -> Lock | nil {
    if !file.file? {
        return nil
    }

    let doc = try {
        toml.load(file)
    } catch e {
        warn("ignoring {file}, which cannot be read: {e}")
        return nil
    }

    if doc['version'] != 1 {
        return nil
    }

    let packages = %{}
    for p in doc['package'] ?? [] {
        let artifacts = [
            Artifact(a['platform'], a['url'], a['sha256'])
            for a in p['artifact'] ?? []
        ]
        packages[p['name']] = Locked(
            p['name'],
            p['version'],
            p['source'],
            p['dependencies'] ?? [],
            p['natives'] ?? [],
            artifacts
        )
    }

    Lock(doc['inputs'], packages)
}
