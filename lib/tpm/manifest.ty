import ffi
import toml
import path (Path)
import tpm.core (TpmError, fail, real)
import tpm.semver (Version, Req, SemverError)
import tpm.platform as plat

pub const FILE = 'ty.toml'

const NAME = /^[a-z][a-z0-9_]*$/

pub class Dep {
    alias:   String
    package: String
    req:     Req | nil = nil
    path:    Path | nil = nil
    git:     String | nil = nil
    rev:     String | nil = nil

    kind -> String {
        (path != nil) ? 'path' : (git != nil) ? 'git' : 'registry'
    }

    /// A stable description of where the dependency comes from, for fingerprints and messages.
    spec -> String {
        let source = match kind {
            'path' => "path={path}",
            'git'  => "git={git}#{rev ?? 'HEAD'}",
            _      => "req={req}"
        }
        "{alias}={package}:{source}"
    }
}

pub class Native {
    name:    String
    lib:     String
    system?: Bool
}

pub class Manifest {
    dir:         Path
    file:        Path
    name:        String
    version:     Version
    description: String | nil = nil
    roots:       Array[String] = ['.']
    deps:        Array[Dep] = []
    natives:     Array[Native] = []
    exclude:     Array[String] = []
    system-libs: Array[String] = []
    registry:    String | nil = nil

    root-dirs -> Array[Path] {
        roots.map(r -> real(dir / r))
    }

    bundled -> Array[Native] {
        natives.filter(\!_.system?)
    }

    /// Where the package keeps its own builds of its bundled libraries.
    native-dirs -> Array[Path] {
        let here = plat.host()
        let arch = (here == nil) ? 'unsupported' : "{here.os}-{here.arch}"
        [dir / 'native' / arch, dir / 'native']
    }

    /// The module path stem for `import NAME` of this package: `<root>/NAME`, taken from the
    /// first root holding `NAME.ty` or `NAME/`.
    stem() -> Path {
        for r in root-dirs {
            if (r / "{name}.ty").exists? || (r / name).dir? {
                return r / name
            }
        }
        root-dirs[0] / name
    }
}

pub fn native-key(lib: String) -> String {
    ffi.library-key(lib)
}

const SHARED = /\.so(\.[0-9.]+)?$|\.dylib$/

/// The shared library named `lib` in the first of `dirs` that has one.
pub fn find-library(dirs: Array[Path], lib: String) -> Path | nil {
    let key = native-key(lib)
    for d in dirs if d.dir? {
        let hits = d.ls().filter(f -> f.name.match?(SHARED) && native-key(f.name) == key)
        if #hits > 0 {
            return real(hits.sort(by=\#_.name)[0])
        }
    }
}

pub class ManifestError < TpmError {
    init(file: Path, what: String) {
        super("{file}: {what}")
    }
}

const BAD_NAME = 'use lowercase letters, digits and `_`'
const SYSTEM_TABLE = '`{ system = "NAME" }`'

fn string-list(m: Path, what: String, v: _) -> Array[String] {
    match v {
        nil               => [],
        s: String         => [s],
        xs: Array[String] => xs,
        _                 => throw ManifestError(m, "{what} must be a string or array of strings")
    }
}

fn dependency(m: Path, dir: Path, alias: String, v: _) -> Dep {
    let bad = what -> ManifestError(m, "[dependencies] {alias}: {what}")

    if !alias.match?(NAME) {
        throw ManifestError(m, "invalid dependency name `{alias}` ({BAD_NAME})")
    }

    let req = fn (s: _) {
        if s == nil {
            return nil
        }
        if !(s :: String) {
            throw bad('`version` must be a string')
        }
        try {
            Req.parse(s)
        } catch e: SemverError {
            throw bad(e.what)
        }
    }

    if let s: String = v {
        return Dep(alias, alias, req: req(s))
    }

    if !(v :: Dict) {
        throw bad('expected a version string or a table')
    }

    let package = v['package'] ?? alias
    if !(package :: String) || !package.match?(NAME) {
        throw bad("invalid package name `{package}`")
    }

    for key in v.keys() if !(key in ['version', 'path', 'git', 'rev', 'package']) {
        throw bad("unknown key `{key}`")
    }

    let sources = ['version', 'path', 'git'].filter(\v[_] != nil)
    if #sources != 1 {
        throw bad('give exactly one of `version`, `path` or `git`')
    }

    if v['rev'] != nil && v['git'] == nil {
        throw bad('`rev` needs `git`')
    }

    match sources[0] {
        'path' => Dep(alias, package, path: real(dir / str(v['path']))),
        'git'  => Dep(alias, package, git: str(v['git']), rev: v['rev'] && str(v['rev'])),
        _      => Dep(alias, package, req: req(v['version']))
    }
}

fn native(m: Path, name: String, v: _) -> Native {
    match v {
        s: String                         => Native(native-key(name), s, false),
        d: Dict and d['system'] :: String => Native(native-key(name), d['system'], true),
        _ => throw ManifestError(m, "[native] {name}: expected a library name or {SYSTEM_TABLE}")
    }
}

fn default-name(dir: Path) -> String {
    dir.name.lower().sub(/[^a-z0-9_]/, '_').sub(/^([^a-z])/, \"x{_}")
}

pub fn parse(source: String, file: Path) -> Manifest {
    let doc = try {
        toml.parse(source)
    } catch e {
        throw ManifestError(file, e.what)
    }

    let table = fn (key: String) {
        let t = doc[key] ?? %{}
        if !(t :: Dict) {
            throw ManifestError(file, "[{key}] must be a table")
        }
        t
    }

    let dir = real(file.parent)
    let pkg = table('package')
    let tpm = table('tpm')
    let name = pkg['name'] ?? default-name(dir)

    if !(name :: String) || !name.match?(NAME) {
        throw ManifestError(file, "invalid package name `{name}` ({BAD_NAME})")
    }

    let version = try {
        Version.parse(str(pkg['version'] ?? '0.0.0'))
    } catch e: SemverError {
        throw ManifestError(file, e.what)
    }

    let roots = string-list(file, '[package] roots', pkg['roots'])

    for r in roots if r.starts?('/') || '..' in r.split('/') {
        throw ManifestError(file, "[package] roots must stay inside the package: `{r}`")
    }

    Manifest(
        dir:         dir,
        file:        file,
        name:        name,
        version:     version,
        description: pkg['description'] && str(pkg['description']),
        roots:       (#roots == 0) ? ['.'] : roots,
        deps:        [dependency(file, dir, alias, v) for alias, v in table('dependencies')],
        natives:     [native(file, key, v) for key, v in table('native')],
        exclude:     string-list(file, '[package] exclude', pkg['exclude']),
        system-libs: string-list(file, '[build] system-libs', table('build')['system-libs']),
        registry:    tpm['registry'] && str(tpm['registry'])
    )
}

pub fn load(dir: Path | String) -> Manifest {
    let file = Path(dir) / FILE
    if !file.file? {
        fail("no {FILE} in {dir}")
    }
    parse(file.read-text(), file)
}

/// The nearest directory at or above `start` that holds a ty.toml.
pub fn find(start: Path | String) -> Path | nil {
    let dir = real(start)
    while true {
        if (dir / FILE).file? {
            return dir
        }
        if dir.parent == dir {
            return nil
        }
        dir = dir.parent
    }
}
