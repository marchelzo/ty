import ffi
import toml
import path (Path)
import tpm.core (TpmError, fail, real)
import tpm.semver (Version, Req, SemverError)

pub const FILE = 'ty.toml'

const NAME = /^[a-z][a-z0-9_]*$/

pub class Dep {
    alias:   String
    package: String
    req:     Req | nil
    path:    Path | nil
    git:     String | nil
    rev:     String | nil

    init(alias: String, package: String, req: Req | nil = nil, path: Path | nil = nil, git: String | nil = nil, rev: String | nil = nil) {
        self.alias   = alias
        self.package = package
        self.req     = req
        self.path    = path
        self.git     = git
        self.rev     = rev
    }

    kind -> String {
        (path != nil) ? 'path' : (git != nil) ? 'git' : 'registry'
    }

    /// A stable description of where the dependency comes from, for fingerprints and messages.
    spec -> String {
        let source = match kind {
            'path' => "path={path}",
            'git'  => "git={git}#{rev ?? 'HEAD'}",
            _      => "req={req}"
        }
        "{alias}={package}:{source}"
    }
}

pub class Native {
    name:    String
    lib:     String
    system?: Bool

    init(name: String, lib: String, system?: Bool) {
        self.name    = name
        self.lib     = lib
        self.system? = system?
    }
}

pub class Manifest {
    dir:         Path
    file:        Path
    name:        String
    version:     Version
    description: String | nil
    roots:       Array[String]
    deps:        Array[Dep]
    natives:     Array[Native]
    exclude:     Array[String]
    system-libs: Array[String]
    registry:    String | nil

    init(dir: Path, file: Path, name: String, version: Version) {
        self.dir         = dir
        self.file        = file
        self.name        = name
        self.version     = version
        self.description = nil
        self.roots       = ['.']
        self.deps        = []
        self.natives     = []
        self.exclude     = []
        self.system-libs = []
        self.registry    = nil
    }

    root-dirs -> Array[Path] {
        roots.map(r -> real(dir / r))
    }

    bundled -> Array[Native] {
        natives.filter(\!_.system?)
    }

    /// The module path stem for `import NAME` of this package: `<root>/NAME`, taken from the
    /// first root holding `NAME.ty` or `NAME/`.
    stem() -> Path {
        for r in root-dirs {
            if (r / "{name}.ty").exists? || (r / name).dir? {
                return r / name
            }
        }
        root-dirs[0] / name
    }
}

pub fn native-key(lib: String) -> String {
    ffi.library-key(lib)
}

pub class ManifestError < TpmError {
    init(file: Path, what: String) {
        super("{file}: {what}")
    }
}

fn string-list(m: Path, what: String, v: _) -> Array[String] {
    match v {
        nil                => [],
        s: String          => [s],
        xs: Array[String]  => xs,
        _                  => throw ManifestError(m, "{what} must be a string or an array of strings")
    }
}

fn dependency(m: Path, dir: Path, alias: String, v: _) -> Dep {
    if !alias.match?(NAME) {
        throw ManifestError(m, "invalid dependency name `{alias}` (use lowercase letters, digits and `_`)")
    }

    let req = fn (s: _) {
        if s == nil {
            return nil
        }
        if !(s :: String) {
            throw ManifestError(m, "[dependencies] {alias}: `version` must be a string")
        }
        try {
            Req.parse(s)
        } catch e: SemverError {
            throw ManifestError(m, "[dependencies] {alias}: {e.what}")
        }
    }

    match v {
        s: String => Dep(alias, alias, req: req(s)),
        d: Dict   => do {
            let package = d['package'] ?? alias
            if !(package :: String) || !package.match?(NAME) {
                throw ManifestError(m, "[dependencies] {alias}: invalid package name `{package}`")
            }
            for key in d.keys() {
                if !(key in ['version', 'path', 'git', 'rev', 'package']) {
                    throw ManifestError(m, "[dependencies] {alias}: unknown key `{key}`")
                }
            }
            let sources = ['version', 'path', 'git'].filter(\d[_] != nil)
            if #sources != 1 {
                throw ManifestError(m, "[dependencies] {alias}: give exactly one of `version`, `path` or `git`")
            }
            if d['rev'] != nil && d['git'] == nil {
                throw ManifestError(m, "[dependencies] {alias}: `rev` needs `git`")
            }
            match sources[0] {
                'path' => Dep(alias, package, path: real(dir / str(d['path']))),
                'git'  => Dep(alias, package, git: str(d['git']), rev: d['rev'] && str(d['rev'])),
                _      => Dep(alias, package, req: req(d['version']))
            }
        },
        _ => throw ManifestError(m, "[dependencies] {alias}: expected a version string or a table")
    }
}

fn native(m: Path, name: String, v: _) -> Native {
    match v {
        s: String => Native(native-key(name), s, false),
        d: Dict and d['system'] :: String => Native(native-key(name), d['system'], true),
        _ => throw ManifestError(m, "[native] {name}: expected a library name or " + '`{ system = "NAME" }`')
    }
}

pub fn parse(source: String, file: Path) -> Manifest {
    let doc = try {
        toml.parse(source)
    } catch e {
        throw ManifestError(file, e.what)
    }

    let dir = real(file.parent)
    let pkg = doc['package'] ?? %{}
    let tbl = fn (key: String) {
        let t = doc[key] ?? %{}
        if !(t :: Dict) {
            throw ManifestError(file, "[{key}] must be a table")
        }
        t
    }

    let name = pkg['name'] ?? dir.name.lower().sub(/[^a-z0-9_]/, '_').sub(/^([^a-z])/, \"x{_}")
    if !(name :: String) || !name.match?(NAME) {
        throw ManifestError(file, "invalid package name `{name}` (use lowercase letters, digits and `_`)")
    }

    let version = try {
        Version.parse(str(pkg['version'] ?? '0.0.0'))
    } catch e: SemverError {
        throw ManifestError(file, e.what)
    }

    let m = Manifest(dir, file, name, version)

    m.description = pkg['description'] && str(pkg['description'])
    m.roots       = string-list(file, '[package] roots', pkg['roots'])
    m.exclude     = string-list(file, '[package] exclude', pkg['exclude'])
    m.system-libs = string-list(file, '[build] system-libs', tbl('build')['system-libs'])
    m.registry    = tbl('tpm')['registry'] && str(tbl('tpm')['registry'])

    if #m.roots == 0 {
        m.roots = ['.']
    }

    for r in m.roots {
        if r.starts?('/') || '..' in r.split('/') {
            throw ManifestError(file, "[package] roots must stay inside the package: `{r}`")
        }
    }

    for alias, v in tbl('dependencies') {
        m.deps.push(dependency(file, dir, alias, v))
    }

    for key, v in tbl('native') {
        m.natives.push(native(file, key, v))
    }

    m
}

pub fn load(dir: Path | String) -> Manifest {
    let file = Path(dir) / FILE
    if !file.file? {
        fail("no {FILE} in {dir}")
    }
    parse(file.read-text(), file)
}

/// The nearest directory at or above `start` that holds a ty.toml.
pub fn find(start: Path | String) -> Path | nil {
    let dir = real(start)
    while true {
        if (dir / FILE).file? {
            return dir
        }
        if dir.parent == dir {
            return nil
        }
        dir = dir.parent
    }
}
