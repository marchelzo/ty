import ty.mod
import json
import os
import path (Path)
import tpm.core (TpmError, warn, cache-root, sha256, sha256-file, write-atomic, real)
import tpm.semver (Version, Req)
import tpm.manifest (Dep)

pub class Artifact {
    platform: String
    url:      String
    sha256:   String
}

pub class Entry {
    name:      String
    version:   Version
    deps:      Array[Dep]
    natives:   Array[String]
    artifacts: Array[Artifact]
    yanked?:   Bool = false
}

fn bad-index(url: String, what: String) {
    throw TpmError("{url}: malformed registry index: {what}")
}

fn absolute(base: String, file: String) -> String {
    file.match?(/^[a-z][a-z0-9+.\-]*:\/\//) ? file : "{base}/{file}"
}

fn entry(url: String, base: String, line: String) -> Entry {
    let d = try {
        json.parse(line)
    } catch _ {
        bad-index(url, 'invalid JSON')
    }

    if !(d :: Dict) || !(d['name'] :: String) || !(d['version'] :: String) {
        bad-index(url, 'each line needs a name and a version')
    }

    Entry(
        name:      d['name'],
        version:   Version.parse(d['version']),
        deps:      [
            Dep(dep['name'], dep['package'] ?? dep['name'], req: Req.parse(dep['req'] ?? '*'))
            for dep in d['deps'] ?? []
        ],
        natives:   d['natives'] ?? [],
        artifacts: [
            Artifact(a['platform'], absolute(base, a['url']), a['sha256'])
            for a in d['artifacts'] ?? []
        ],
        yanked?:   d['yanked'] ?? false
    )
}

/// GETs `url` with the HTTP client, which is loaded only when a remote registry is used.
fn fetch(url: String, timeout: Float) -> _ {
    let client = ty.mod.load('http/client')
    let get = client.get
    try {
        get(url, timeout: timeout, follow-redirects: true)
    } catch e: client.RequestError {
        throw TpmError("{url}: {e.what}")
    }
}

fn api(method: String, url: String, token: String, headers: Dict = %{}, %kwargs) -> Dict {
    let client = ty.mod.load('http/client')
    let request = client.request
    let opts = %{**kwargs, 'headers': %{'Authorization': "Bearer {token}", **headers}}
    let r = try {
        request(method, url, **opts)
    } catch e: client.RequestError {
        throw TpmError("{url}: {e.what}")
    }
    let body = try {
        r.json()
    } catch _ {
        nil
    }
    if r.status-code < 400 {
        return (body :: Dict) ? body : throw TpmError("{url}: unexpected response from the registry")
    }
    let why = ((body :: Dict) && (body['error'] :: String)) ? body['error'] : "HTTP {r.status-code}"
    match r.status-code {
        401        => throw TpmError("{why}; run `tpm login` with a valid token"),
        404 or 405 => throw TpmError("{url}: this registry does not accept uploads ({why})"),
        _          => throw TpmError(why)
    }
}

/// Who `token` belongs to on the HTTP registry at `url`: `{user, admin}`.
pub fn whoami(url: String, token: String) -> Dict {
    api('GET', "{url}/api/v1/me", token, timeout: 30.0)
}

/// Uploads a built archive to the HTTP registry at `url`. The result says whether it was
/// `created` (false when the registry already had these exact bytes) and where it now lives.
pub fn upload(url: String, token: String, archive: Path) -> Dict {
    api(
        'PUT',
        "{url}/api/v1/packages",
        token,
        content: archive,
        timeout: 300.0,
        headers: %{
            'Content-Type':      'application/gzip',
            'X-Checksum-Sha256': sha256-file(archive)
        }
    )
}

pub class Registry {
    url:     String
    offline: Bool = false
    __index: Dict[String, Array[Entry]] = %{}

    init(url: String, offline: Bool = false) {
        self.url     = url.comb(/\/+$/)
        self.offline = offline
    }

    /// `url` may be a plain path (relative to `base`), a file:// URL or an http(s):// URL.
    static open(url: String, base: Path, offline: Bool = false) -> Registry {
        if url.match?(/^https?:\/\//) || url.starts?('file://') {
            return Registry(url, offline)
        }
        let p = url.starts?('/') ? Path(url) : base / url
        Registry("file://{real(p)}", offline)
    }

    local -> Path | nil {
        url.starts?('file://') ? Path(url.comb(/^file:\/\//)) : nil
    }

    cache-dir -> Path {
        cache-root() / 'index' / sha256(url).slice(0, 16)
    }

    __read(rel: String) -> String | nil {
        if let $dir = local {
            let p = dir / rel
            return p.file? ? p.read-text() : nil
        }

        let cached = cache-dir / rel
        if offline {
            return cached.file? ? cached.read-text() : nil
        }

        let r = try {
            fetch("{url}/{rel}", 30.0)
        } catch e: TpmError {
            if !cached.file? {
                throw e
            }
            warn("{e.what}; using the cached index")
            return cached.read-text()
        }

        match r.status-code {
            200        => do {
                write-atomic(cached, r.text)
                r.text
            },
            404 or 410 => nil,
            code       => throw TpmError("{url}/{rel}: HTTP {code}")
        }
    }

    entries(name: String) -> Array[Entry] {
        if let $known = __index[name] {
            return known
        }
        let index = "{url}/index/{name}"
        let found = [
            entry(index, url, line)
            for line in (__read("index/{name}") ?? '').lines()
            if line.trim() != ''
        ]
        for e in found if e.name != name {
            bad-index(index, "found an entry for `{e.name}`")
        }
        __index[name] = found
        found
    }

    /// Downloads `art` to `dest` and checks its digest.
    download(art: Artifact, dest: Path) {
        dest.parent.mkdir(parents: true, exist-ok: true)
        let tmp = dest.parent / ".{dest.name}.{os.getpid()}.part"

        if art.url.starts?('file://') {
            let src = Path(art.url.comb(/^file:\/\//))
            if !src.file? {
                throw TpmError("{art.url}: no such file")
            }
            src.copy(tmp)
        } else if offline {
            throw TpmError("{art.url}: not in the cache, and --offline was given")
        } else {
            let r = fetch(art.url, 300.0)
            if r.status-code != 200 {
                throw TpmError("{art.url}: HTTP {r.status-code}")
            }
            tmp.write(r.content)
        }

        let got = sha256-file(tmp)
        if got != art.sha256 {
            tmp.unlink(missing-ok: true)
            throw TpmError("{art.url}: checksum mismatch (expected {art.sha256}, got {got})")
        }

        tmp.rename(dest)
    }
}

/// Adds one built artifact to a local registry directory.
pub fn publish(registry: Path, meta: Dict, archive: Path) -> String {
    let name     = meta['name']
    let version  = meta['version']
    let platform = meta['platform']
    let rel      = "files/{name}/{archive.name}"
    let digest   = sha256-file(archive)
    let index    = registry / 'index' / name

    let lines = index.file? ? index.read-text().lines().filter(\_.trim() != '') : []
    let entries = lines.map(json.parse)
    let same = entries.filter(\_['version'] == version)

    let art = %{'platform': platform, 'url': rel, 'sha256': digest}
    let deps = meta['deps']

    if let [e] = same {
        if json.encode(e['deps']) != json.encode(deps) {
            throw TpmError("{name} {version} is already published with different dependencies")
        }
        let arts = e['artifacts'] ?? []
        if let $old = arts.find(\_['platform'] == platform) {
            if old['sha256'] != digest {
                throw TpmError("{name} {version} is already published for {platform}")
            }
            return rel
        }
        arts.push(art)
        e['artifacts'] = arts
    } else {
        entries.push(%{
            'name':      name,
            'version':   version,
            'deps':      deps,
            'natives':   (meta['natives'] ?? %{}).keys().sort(),
            'artifacts': [art],
            'yanked':    false
        })
    }

    let dest = registry / rel
    dest.parent.mkdir(parents: true, exist-ok: true)
    archive.copy(dest)

    entries.sort!(by=\Version.parse(_['version']))
    write-atomic(index, entries.map(json.encode).join('\n') + '\n')

    rel
}
