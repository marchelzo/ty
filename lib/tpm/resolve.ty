import path (Path)
import tpm.core (TpmError, SET_REGISTRY, fail, sha256)
import tpm.semver (Version, Req)
import tpm.manifest as man (Manifest, Dep)
import tpm.registry (Registry, Entry, Artifact)
import tpm.lock (Lock, Locked)
import tpm.store as store

pub class Pkg {
    name:      String
    version:   Version
    source:    String
    manifest:  Manifest | nil = nil
    url:       String | nil = nil
    commit:    String | nil = nil
    deps:      Array[Dep] = []
    natives:   Array[String] = []
    artifacts: Array[Artifact] = []

    static of(m: Manifest, source: String) -> Pkg {
        Pkg(m.name, m.version, source, manifest: m, deps: m.deps, natives: m.bundled.map(\_.name))
    }

    static from(e: Entry, url: String) -> Pkg {
        Pkg(
            e.name,
            e.version,
            'registry',
            url:       url,
            deps:      e.deps,
            natives:   e.natives,
            artifacts: e.artifacts
        )
    }

    dir -> Path | nil {
        manifest.?dir
    }

    source-id(root: Path) -> String {
        match source {
            'root'     => 'root',
            'path'     => "path+{(manifest)!.dir.relative-to(root)}",
            'git'      => "git+{url}#{commit}",
            'registry' => "registry+{url}",
        }
    }

    locked(root: Path) -> Locked {
        let edges = deps.map(d -> (d.alias == d.package) ? d.alias : "{d.alias}={d.package}")
        Locked(name, str(version), source-id(root), edges, natives, artifacts)
    }
}

pub class Options {
    offline: Bool = false
    upgrade: Bool = false
    only:    Array[String] = []
    frozen:  Bool = false

    upgrade?(name: String) -> Bool {
        upgrade || name in only
    }
}

pub class Resolution {
    root:     Pkg
    packages: Dict[String, Pkg]
    inputs:   String
    reused:   Bool

    /// The package that `dep` (declared by any package) resolved to.
    target(dep: Dep) -> Pkg {
        packages[dep.package]!
    }

    sorted -> Array[Pkg] {
        packages.values().sort(by=\_.name)
    }
}

fn relative-spec(d: Dep, root: Path) -> String {
    match d.kind {
        'path' => "{d.alias}={d.package}:path={(d.path)!.relative-to(root)}",
        _      => d.spec
    }
}

fn fingerprint(sources: Dict[String, Pkg], root: Path) -> String {
    let lines = []
    for name in sources.keys().sort() {
        let p = sources[name]!
        lines.push("{name}@{p.version}:{p.source}")
        for d in p.deps.sort(by=\_.alias) {
            lines.push("  {relative-spec(d, root)}")
        }
    }
    sha256(lines.join('\n'))
}

fn locked-commit(lock: Lock | nil, d: Dep) -> String | nil {
    if lock == nil {
        return nil
    }
    let l = lock.packages[d.package] ?? return nil
    let (kind, url, commit) = l.origin
    (kind == 'git' && url == d.git) ? commit : nil
}

fn path-package(d: Dep) -> (Pkg, String) {
    let dir = (d.path)!
    if !(dir / man.FILE).file? {
        throw TpmError("no {man.FILE} in {dir}")
    }
    (Pkg.of(man.load(dir), 'path'), str(dir))
}

fn git-package(d: Dep, lock: Lock | nil, opts: Options) -> (Pkg, String) {
    let url = (d.git)!
    let locked = opts.upgrade?(d.package) ? nil : locked-commit(lock, d)
    let (commit, dir) = store.checkout(url, d.rev, locked, opts.offline)
    if !(dir / man.FILE).file? {
        throw TpmError("{url} has no {man.FILE}")
    }
    let p = Pkg.of(man.load(dir), 'git')
    p.url    = url
    p.commit = commit
    (p, "{url}#{commit}")
}

/// The path or git package that `d` (declared by `m`) names.
fn source-package(m: Manifest, d: Dep, lock: Lock | nil, opts: Options) -> Pkg {
    let context = "{m.file}: [dependencies] {d.alias}"
    let (p, origin) = try {
        (d.kind == 'path') ? path-package(d) : git-package(d, lock, opts)
    } catch e: TpmError {
        throw TpmError("{context}: {e.what}")
    }
    if p.name != d.package {
        throw TpmError("{context}: {origin} is package `{p.name}`, not `{d.package}`")
    }
    p
}

/// The root package plus every path and git package reachable through path/git edges.
fn collect-sources(root: Manifest, lock: Lock | nil, opts: Options) -> Dict[String, Pkg] {
    let found = %{root.name: Pkg.of(root, 'root')}
    let queue = [root]

    while #queue > 0 {
        let m = queue.pop(0)
        for d in m.deps if d.kind != 'registry' {
            let p = source-package(m, d, lock, opts)
            match found[p.name] {
                $other and other.dir == p.dir => (),
                $other => fail("package `{p.name}` comes from two places: {other.dir} and {p.dir}"),
                _      => do {
                    found[p.name] = p
                    queue.push((p.manifest)!)
                }
            }
        }
    }

    found
}

class Want {
    package: String
    req:     Req
    by:      String
}

class Solver {
    registry: Registry
    sources:  Dict[String, Pkg]
    prefer:   Dict[String, Version]
    selected: Dict[String, Entry] = %{}
    chosen:   Dict[String, String] = %{}
    failure:  (Int, String) = (-1, 'no solution')

    /// Records `what` if it is the deepest failure so far, so the error names the real conflict.
    fail-at(what: String) -> Bool {
        if #selected >= failure.0 {
            failure = (#selected, what)
        }
        false
    }

    candidates(w: Want) -> Array[Entry] {
        let preferred = prefer[w.package]
        let usable? = e -> w.req.matches?(e.version) && (!e.yanked? || e.version == preferred)
        let ok = registry.entries(w.package).filter(usable?).sort(by=\_.version).reverse()
        match ok.find(\_.version == preferred) {
            $e => [e, *ok.filter(\_ != e)],
            _  => ok
        }
    }

    solve(pending: Array[Want]) -> Bool {
        if #pending == 0 {
            return true
        }

        let w = pending[0]
        let rest = pending[1;]
        let wanted = "`{w.by}` requires {w.package} {w.req}"

        if let $fixed = sources[w.package] {
            if !w.req.matches?(fixed.version) {
                let what = "{fixed.source} package at {fixed.version}"
                return fail-at("{wanted}, but {w.package} is a {what}")
            }
            return solve(rest)
        }

        if let $picked = selected[w.package] {
            if !w.req.matches?(picked.version) {
                let by = chosen[w.package]
                let what = "{w.package} {picked.version} was already chosen for `{by}`"
                return fail-at("{wanted}, but {what}")
            }
            return solve(rest)
        }

        let options = candidates(w)
        if #options == 0 {
            let known = registry.entries(w.package).map(\str(_.version))
            let have = (#known == 0) ? "{w.package} is not in the registry"
                     :                 "available: {known.join(', ')}"
            return fail-at(
                "no version of {w.package} matches {w.req} (required by `{w.by}`); {have}"
            )
        }

        for e in options {
            selected[w.package] = e
            chosen[w.package] = w.by
            let more = [Want(d.package, (d.req)!, "{e.name} {e.version}") for d in e.deps]
            if solve(rest + more) {
                return true
            }
            selected.remove(w.package)
            chosen.remove(w.package)
        }

        false
    }
}

fn wants(sources: Dict[String, Pkg]) -> Array[Want] {
    [
        Want(d.package, (d.req)!, p.name)
        for p in sources.values().sort(by=\_.name)
        for d in p.deps
        if d.kind == 'registry'
    ]
}

fn locked-package(name: String, l: Locked, url: String) -> Pkg {
    let version = Version.parse(l.version)
    let deps = l.deps.map(fn (s) {
        let [alias, ?package] = s.split('=')
        Dep(alias, package ?? alias, req: Req.exact(version))
    })
    Pkg(name, version, 'registry', url: url, deps: deps, natives: l.natives, artifacts: l.artifacts)
}

/// The registry packages of `lock`, if it still covers every package and edge of `sources`.
fn from-lock(lock: Lock, sources: Dict[String, Pkg]) -> Dict[String, Pkg] | nil {
    let out = %{}

    for name, l in lock.packages {
        let (kind, url, _) = l.origin
        if kind == 'registry' {
            out[name] = locked-package(name, l, url)
        } else if sources[name] == nil {
            return nil
        }
    }

    for name in sources.keys() if lock.packages[name] == nil {
        return nil
    }

    for p in [*sources.values(), *out.values()] {
        for d in p.deps if sources[d.package] == nil && out[d.package] == nil {
            return nil
        }
    }

    out
}

pub fn resolve(
    root: Manifest,
    registry: Registry | nil,
    lock: Lock | nil,
    opts: Options
) -> Resolution {
    let sources = collect-sources(root, lock, opts)
    let inputs = fingerprint(sources, root.dir)
    let top = sources[root.name]!

    for name, p in sources if name != root.name {
        for d in p.deps if d.package == root.name {
            fail("`{name}` depends on `{root.name}`, the package being resolved")
        }
    }

    if lock != nil && lock.inputs == inputs && !opts.upgrade && #opts.only == 0 {
        if let $locked = from-lock(lock, sources) {
            return Resolution(top, sources + locked, inputs, true)
        }
    }

    if opts.frozen {
        fail("{root.dir / 'ty.lock'} is out of date with {root.file}; run `tpm lock`")
    }

    let pending = wants(sources)
    if #pending == 0 {
        return Resolution(top, sources, inputs, false)
    }

    if registry == nil {
        fail("{root.file}: registry dependencies need a registry; {SET_REGISTRY}")
    }

    let prefer = %{
        name: Version.parse(l.version)
        for name, l in (lock == nil) ? %{} : lock.packages
        if !opts.upgrade?(name)
    }

    let solver = Solver((registry)!, sources, prefer)
    if !solver.solve(pending) {
        fail("cannot resolve dependencies: {solver.failure.1}")
    }

    let picked = %{name: Pkg.from(e, (registry)!.url) for name, e in solver.selected}

    Resolution(top, sources + picked, inputs, false)
}
