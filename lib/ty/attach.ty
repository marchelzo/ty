import os (read, write, close, signal, isatty, SIGINT)
import net
import json
import chalk (chalk)
import path (Path)
import readln (readln)

const HELP = '
  c, continue            resume all threads
  n, next                step over
  s, step                step into
  o, out, finish         step out
  si, stepi              step one instruction
  pause                  stop all threads (Ctrl-C while running)
  b LOC [if COND]        set a breakpoint; LOC is FILE:LINE, LINE, or FUNC
  log LOC MESSAGE        set a logpoint; {expr} in MESSAGE is interpolated
  d [ID]                 delete breakpoint ID (or all breakpoints)
  bl                     list breakpoints
  catch raised|uncaught|none
                         choose when exceptions stop the program
  bt                     show the stack of the selected thread
  f N, up, down          select a stack frame
  l [LINE]               list source around the current location
  locals, globals        show variables of the selected frame
  threads                list threads
  t ID                   select a thread
  p EXPR                 evaluate EXPR in the selected frame
  EXPR                   anything else is evaluated as well
  q, detach              detach and let the program keep running
  kill                   detach and terminate the program
'

fn split-message(buf: Blob) -> String | nil {
    let $end = buf.search('\r\n\r\n') or return nil
    let header = buf.str(0, end)

    if not let [_, n] = header.match(/Content-Length:\s*(\d+)/i) {
        return nil
    }

    let size = int(n)

    if #buf < end + 4 + size {
        return nil
    }

    let body = buf.str(end + 4, size)
    buf.splice(0, end + 4 + size)
    body
}

fn source-name(frame: Dict[String, Any]) -> String {
    (frame['source'] ?? %{})['name'] ?? '?'
}

fn source-path(frame: Dict[String, Any]) -> String | nil {
    (frame['source'] ?? %{})['path']
}

fn merge(a: Dict[String, Any], b: Dict[String, Any]) -> Dict[String, Any] {
    let out = %{}

    for k, v in a {
        out[k] = v
    }

    for k, v in b {
        out[k] = v
    }

    out
}

class Session {
    __fd: Int
    __pid: Int
    __seq: Int
    __lock: Mutex
    __replies: Dict[Int, Channel]
    __stops: Channel
    __interrupted: Bool
    __sources: Dict[String, Array[String]]
    __keys: Int

    thread: Int
    frame: Int
    frames: Array[Dict[String, Any]]
    running?: Bool
    alive?: Bool
    line-bps: Dict[String, Array[Dict[String, Any]]]
    fn-bps: Array[Dict[String, Any]]
    known: Array[Dict[String, Any]]

    init(fd: Int, pid: Int) {
        __fd = fd
        __pid = pid
        __seq = 0
        __lock = Mutex()
        __replies = %{}
        __stops = Channel()
        __interrupted = false
        __sources = %{}
        __keys = 0
        thread = 1
        frame = 0
        frames = []
        running? = true
        alive? = true
        line-bps = %{}
        fn-bps = []
        known = []
    }

    interrupt() {
        __interrupted = true
    }

    __send(message: Dict[String, Any]) {
        let body = json.encode(message)
        write(__fd, "Content-Length: {#body}\r\n\r\n{body}", all=true)
    }

    request(command: String, args: Dict[String, Any] = %{}) -> Dict[String, Any] {
        let reply = Channel()
        let seq = with __lock {
            __seq += 1
            __replies[__seq] = reply
            __seq
        }

        __send(%{
            'seq': seq,
            'type': 'request',
            'command': command,
            'arguments': args
        })

        match reply.recv() {
            Some($msg) => msg,
            _          => %{'success': false, 'message': 'connection closed'}
        }
    }

    body(command: String, args: Dict[String, Any] = %{}) -> Dict[String, Any] | nil {
        let reply = request(command, args)

        if !reply['success'] {
            print(chalk"[red]{command}: {reply['message'] ?? 'failed'}[/]")
            return nil
        }

        reply['body'] ?? %{}
    }

    reader() {
        let buf = Blob()

        while true {
            let chunk = read(__fd, 65536)

            if #chunk == 0 {
                break
            }

            buf.push(chunk)

            while let $text = split-message(buf) {
                dispatch(json.parse(text))
            }
        }

        alive? = false

        with __lock {
            for _, reply in __replies {
                reply.send(nil)
            }
        }

        __stops.send(nil)
    }

    dispatch(msg: Dict[String, Any]) {
        match msg['type'] {
            'response' => deliver(msg),
            'event'    => on-event(msg['event'], msg['body'] ?? %{}),
            _          => ()
        }
    }

    deliver(msg: Dict[String, Any]) {
        let reply = with __lock {
            __replies.remove(msg['request_seq'])
        }

        reply.?send(msg)
    }

    on-event(event: String, body: Dict[String, Any]) {
        match event {
            'stopped' => __stops.send(body),

            'output' => print(chalk"[blue]{body['output'] ?? ''}[/]", end='', flush=true),

            'thread' => print(chalk"[grey]thread {body['threadId']} {body['reason']}[/]"),

            'breakpoint' => note-breakpoint(body['breakpoint']),

            'exited' => print(chalk"[yellow]process {__pid} exited with status {body['exitCode']}[/]"),

            'terminated' => do {
                alive? = false
                __stops.send(nil)
            },

            _ => ()
        }
    }

    note-breakpoint(bp: Dict[String, Any]) {
        for known {
            if it['id'] == bp['id'] {
                it['verified'] = bp['verified']
                it['line'] = bp['line']
            }
        }

        if bp['verified'] {
            print(chalk"[green]breakpoint {bp['id']} is now active at line {bp['line']}[/]")
        }
    }

    start() {
        Thread(-> self.reader())

        body('initialize', %{
            'clientID': 'ty',
            'adapterID': 'ty',
            'linesStartAt1': true,
            'columnsStartAt1': true,
            'pathFormat': 'path'
        })

        body('attach')
        body('setExceptionBreakpoints', %{'filters': ['uncaught']})
        body('configurationDone')
        pause()
    }

    wait-stop() {
        while alive? {
            if __interrupted {
                __interrupted = false
                body('pause', %{'threadId': thread})
            }

            if let Some(stop) = __stops.recv(100) {
                on-stop(stop)
                return
            }
        }
    }

    on-stop(stop: Dict[String, Any] | nil) {
        let $stop = stop or return

        running? = false
        thread = stop['threadId'] ?? thread
        frame = 0

        let reason = stop['reason'] ?? 'unknown'
        let text = stop['text']

        load-frames()

        print(chalk"[yellow]stopped[/] ([bold]{reason}[/]) in thread {thread}")

        if text != nil {
            print(chalk"  [red]{stop['description'] ?? 'exception'}: {text}[/]")
        }

        show-location()
    }

    load-frames() {
        frames = (body('stackTrace', %{'threadId': thread}) ?? %{})['stackFrames'] ?? []
    }

    current() -> Dict[String, Any] | nil {
        (frame < #frames) ? frames[frame] : nil
    }

    source-lines(frame: Dict[String, Any]) -> Array[String] {
        let key = source-path(frame) ?? source-name(frame)

        if let $lines = __sources[key] {
            return lines
        }

        let lines = match source-path(frame) {
            $p => slurp(p).?lines() ?? [],
            _  => fetch-source((frame['source'] ?? %{})['sourceReference'])
        }

        __sources[key] = lines
        lines
    }

    fetch-source(ref: Int | nil) -> Array[String] {
        let $ref = ref or return []
        let $reply = body('source', %{'sourceReference': ref}) or return []
        reply['content'].?lines() ?? []
    }

    list(center: Int | nil = nil) {
        let $f = current() or return print(chalk"[red]no frame selected[/]")
        let lines = source-lines(f)
        let here = f['line']
        let mid = center ?? here
        let lo = max(1, mid - 5)
        let hi = min(#lines, mid + 5)

        for lo...hi {
            let marker = (it == here) ? chalk"[bold yellow]->[/]" : '  '
            print(chalk"{marker} [grey]{it:4}[/] {lines[it - 1]}")
        }
    }

    show-location() {
        let $f = current() or return print(chalk"[red]no stack available[/]")
        print(chalk"  at [bold]{f['name']}[/] ([cyan]{source-name(f)}:{f['line']}[/])")
        list()
    }

    backtrace() {
        for f, i in frames {
            let marker = (i == frame) ? '*' : ' '
            print(chalk"{marker} [grey]#{i}[/] [bold]{f['name']}[/] ([cyan]{source-name(f)}:{f['line']}[/])")
        }
    }

    select-frame(n: Int) {
        if n < 0 || n >= #frames {
            print(chalk"[red]no frame #{n}[/]")
            return
        }

        frame = n
        show-location()
    }

    select-thread(id: Int) {
        thread = id
        frame = 0
        load-frames()
        show-location()
    }

    threads() {
        let $info = body('threads') or return

        for info['threads'] {
            let marker = (it['id'] == thread) ? '*' : ' '
            print(chalk"{marker} [bold]{it['id']}[/] {it['name']}")
        }
    }

    show-scope(name: String) {
        let $f = current() or return print(chalk"[red]no frame selected[/]")
        let $scopes = body('scopes', %{'frameId': f['id']}) or return

        for scopes['scopes'] {
            if it['name'] == name || (name == 'Locals' && it['name'] == 'Closure') {
                print-variables(it['variablesReference'])
            }
        }
    }

    print-variables(ref: Int) {
        let $vars = body('variables', %{'variablesReference': ref}) or return

        for vars['variables'] {
            print(chalk"  [bold]{it['name']}[/] = {it['value']} [grey]: {it['type']}[/]")
        }
    }

    evaluate(expr: String) {
        let args = %{'expression': expr, 'context': 'repl'}

        if let $f = current() {
            args['frameId'] = f['id']
        }

        if let $result = body('evaluate', args) {
            print(result['result'])
        }
    }

    resume(command: String, args: Dict[String, Any] = %{}) {
        if running? {
            print(chalk"[red]the program is already running[/]")
            return
        }

        running? = true

        if body(command, merge(%{'threadId': thread}, args)) == nil {
            running? = false
            return
        }

        wait-stop()
    }

    pause() {
        if !running? {
            return
        }

        body('pause', %{'threadId': thread})
        wait-stop()
    }

    current-path() -> String | nil {
        let $f = current() or return nil
        source-path(f)
    }

    location(spec: String) -> (String | nil, Int | nil, String | nil) {
        match spec {
            /^(.+):(\d+)$/ => (str(Path($1).resolve), int($2), nil),
            /^\d+$/        => (current-path(), int(spec), nil),
            _              => (nil, nil, spec)
        }
    }

    add-breakpoint(spec: String, log: String | nil = nil) {
        let (loc, cond) = match spec {
            /^(\S+)\s+if\s+(.+)$/ => ($1, $2),
            _                     => (spec.strip(), nil)
        }

        __keys += 1

        let entry: Dict[String, Any] = %{'key': __keys}

        if cond != nil {
            entry['condition'] = cond
        }

        if log != nil {
            entry['logMessage'] = log
        }

        let (path, line, name) = location(loc)

        if let $name = name {
            entry['name'] = name
            fn-bps.push(entry)
            sync-functions()
            return
        }

        if not let ($path, $line) = (path, line) {
            print(chalk"[red]no current file; use FILE:LINE[/]")
            return
        }

        entry['line'] = line
        line-bps[path] = [*(line-bps[path] ?? []), entry]
        sync-lines(path)
    }

    sync-lines(path: String) {
        let specs = line-bps[path] ?? []
        let $reply = body('setBreakpoints', %{
            'source': %{'path': path},
            'breakpoints': specs
        }) or return

        known = known.filter(\_['path'] != path)

        for spec, i in specs {
            let bp = reply['breakpoints'][i]
            known.push(merge(bp, %{'path': path, 'spec': spec}))
            report(bp, "{Path(path).name}:{spec['line']}")
        }
    }

    sync-functions() {
        let $reply = body('setFunctionBreakpoints', %{'breakpoints': fn-bps}) or return

        known = known.filter(\_['path'] != nil)

        for spec, i in fn-bps {
            let bp = reply['breakpoints'][i]
            known.push(merge(bp, %{'path': nil, 'spec': spec}))
            report(bp, spec['name'])
        }
    }

    report(bp: Dict[String, Any], what: String) {
        if bp['verified'] {
            print(chalk"[green]breakpoint {bp['id']}[/] at {what} (line {bp['line']})")
        } else {
            print(chalk"[yellow]breakpoint {bp['id']}[/] at {what} is pending: {bp['message'] ?? 'unresolved'}")
        }
    }

    delete-breakpoint(id: Int | nil) {
        let doomed = known.filter(\id == nil || _['id'] == id)

        if #doomed == 0 {
            print(chalk"[red]no such breakpoint[/]")
            return
        }

        for doomed {
            let key = it['spec']['key']
            match it['path'] {
                nil => fn-bps = fn-bps.filter(\_['key'] != key),
                $p  => line-bps[p] = (line-bps[p] ?? []).filter(\_['key'] != key)
            }
        }

        for doomed.map(&['path']).uniq() {
            match it {
                nil => sync-functions(),
                $p  => sync-lines(p)
            }
        }
    }

    list-breakpoints() {
        for known {
            let spec = it['spec']
            let loc = (it['path'] != nil) ? "{Path(it['path']).name}:{spec['line']}" : spec['name']
            let state = it['verified'] ? chalk"[green]active[/]" : chalk"[yellow]pending[/]"
            let cond = (spec['condition'] != nil) ? " if {spec['condition']}" : ''
            print("  {it['id']:3}  {state}  {loc}{cond}")
        }
    }

    exceptions(mode: String) {
        let filters = match mode {
            'none' => [],
            m      => [m]
        }

        body('setExceptionBreakpoints', %{'filters': filters})
    }

    detach(kill: Bool = false) {
        if alive? {
            request('disconnect', %{'terminateDebuggee': kill})
        }

        close(__fd)
    }

    command(line: String) -> Bool {
        match line {
            ''                              => (),
            /^(c|continue)$/                => resume('continue'),
            /^(n|next)$/                    => resume('next'),
            /^(s|step)$/                    => resume('stepIn'),
            /^(o|out|finish)$/              => resume('stepOut'),
            /^(si|stepi)$/                  => resume('stepIn', %{'granularity': 'instruction'}),
            'pause'                         => pause(),
            /^(b|break)\s+(.+)$/            => add-breakpoint($2),
            /^log\s+(\S+)\s+(.+)$/          => add-breakpoint($1, $2),
            /^(d|delete)$/                  => delete-breakpoint(nil),
            /^(d|delete)\s+(\d+)$/          => delete-breakpoint(int($2)),
            /^(bl|breakpoints)$/            => list-breakpoints(),
            /^catch\s+(raised|uncaught|none)$/ => exceptions($1),
            /^(bt|where|backtrace)$/        => backtrace(),
            /^(f|frame)\s+(\d+)$/           => select-frame(int($2)),
            'up'                            => select-frame(frame + 1),
            'down'                          => select-frame(frame - 1),
            /^(l|list)$/                    => list(),
            /^(l|list)\s+(\d+)$/            => list(int($2)),
            /^(locals|lo)$/                 => show-scope('Locals'),
            /^(globals|g)$/                 => show-scope('Globals'),
            'threads'                       => threads(),
            /^(t|thread)\s+(\d+)$/          => select-thread(int($2)),
            /^(h|help)$/                    => print(HELP),
            /^(q|quit|detach)$/             => return false,
            'kill' => do {
                detach(kill=true)
                alive? = false
                return false
            },
            /^(p|print)\s+(.+)$/            => evaluate($2),
            expr                            => evaluate(expr)
        }

        true
    }
}

fn next-command(interactive?: Bool) -> String | nil {
    interactive? ? readln(chalk"[bold purple](ty-dbg)[/] ") : readLine()
}

pub fn run(sock: String, pid: Int) {
    let session = Session(net.dial('unix', sock), pid)
    let interactive? = isatty(0)

    signal(SIGINT, fn (_) { session.interrupt() })

    print(chalk"[green]attached to process {pid}[/] (type [bold]help[/] for commands)")

    session.start()

    while session.alive? {
        if session.running? {
            session.wait-stop()
            continue
        }

        let $line = next-command(interactive?) or break

        if !interactive? {
            print(chalk"[bold purple](ty-dbg)[/] {line}")
        }

        if !session.command(line.strip()) {
            break
        }
    }

    if session.alive? {
        session.detach()
        print(chalk"[green]detached from process {pid}[/]")
    }
}
