import base64
import errno
import json
import os
import time (now, CLOCK_MONOTONIC)
import ty

const OUTPUT_LIMIT = 65536
const GRACE = 5.0
const FRAME_LIMIT = 64 * 1024 * 1024

#|if __apple__
const SEND_FLAGS = 0
#|else
const SEND_FLAGS = os.MSG_NOSIGNAL
#|]

use Completion = {
    type: 'result', id: Int, value: String | nil, error: String | nil,
    truncated: Bool
}
use Call = {type: 'call', id: Int, method: String, args: Any}
use Reply = {type: 'ready', version: 1} | Completion | Call

pub use Result = {
    output: String, value: String | nil, error: String | nil,
    truncated: Bool, reset: Bool
}

fn check(result: Int, operation: String) {
    if result < 0 {
        throw OSError(operation)
    }
}

fn nonblocking(fd: Int) {
    check(os.fcntl(fd, os.F_SETFD, os.FD_CLOEXEC), 'fcntl')
    check(os.fcntl(fd, os.F_SETFL, os.O_NONBLOCK), 'fcntl')
}

fn retry?(error: Int) -> Bool {
    error == errno.EAGAIN || error == errno.EWOULDBLOCK || error == errno.EINTR
}

class Kernel {
    __fd: Int
    __pid: Int
    __stderr: Int
    __pending: Blob = Blob()
    __buffer:  Blob = Blob()
    __closed?: Bool = false

    init(wrap: Array[String] = [], adopt: _ = nil) {
        if let $state = adopt {
            __fd     = state.fd
            __pid    = state.pid
            __stderr = state.stderr
            __pending.push(base64.decode(state.pending))
            check(os.fcntl(__fd, os.F_SETFD, os.FD_CLOEXEC), 'fcntl')
            check(os.fcntl(__stderr, os.F_SETFD, os.FD_CLOEXEC), 'fcntl')
            return
        }
        let (parent, child) = os.socketpair(os.AF_UNIX, os.SOCK_STREAM, 0)
        defer os.close(child)
        __fd = parent
        __stderr = -1
        try {
            check(os.fcntl(child, os.F_SETFD, os.FD_CLOEXEC), 'fcntl')
            nonblocking(parent)
#|if __apple__
            check(os.fcntl(parent, os.F_SETNOSIGPIPE, 1), 'fcntl')
#|]
            let process = os.spawn(
                [
                    *wrap,
                    ty.executable,
                    '-b',
                    '--color=never',
                    '-M', 'ty.interpreter.worker',
                    '-e', 'run()'
                ],
                stdin=child,
                stdout=child,
                stderr=os.SPAWN_PIPE,
                detach=true
            )
            __pid    = process.pid
            __stderr = process.stderr
        } catch error {
            os.close(parent)
            throw error
        }
        try {
            nonblocking(__stderr)
        } catch error {
            close()
            throw error
        }
    }

    handoff() -> _ {
        check(os.fcntl(__fd, os.F_SETFD, 0), 'fcntl')
        check(os.fcntl(__stderr, os.F_SETFD, 0), 'fcntl')
        return {fd: __fd, pid: __pid, stderr: __stderr, pending: base64.encode(__pending)}
    }

    pid -> Int {
        __pid
    }

    interrupt() {
        os.kill(__pid, os.SIGUSR2)
    }

    write(data: Blob) {
        let count = os.sendto(__fd, data, SEND_FLAGS)
        if count < 0 && !retry?(errno.get()) {
            throw OSError('write Ty REPL')
        }
        data.clear(0, max(0, count))
    }

    read(fd: Int) -> Int {
        __buffer.clear()
        let count = os.read(fd, __buffer, 65536)
        if count < 0 && !retry?(errno.get()) {
            throw OSError('read Ty REPL')
        }
        count
    }

    output(target: Blob) -> Bool {
        let truncated? = false
        for ..32 {
            break if read(__stderr) <= 0
            let remaining = max(0, OUTPUT_LIMIT - #target)
            truncated? = truncated? || #__buffer > remaining
            __buffer.clear(min(remaining, #__buffer))
            target.push(__buffer)
        }
        truncated?
    }

    reply(id: Int) -> Completion | Call | nil {
        let count = read(__fd)
        if count == 0 {
            throw RuntimeError('Ty REPL exited')
        }
        __pending.push(__buffer)
        if #__pending > FRAME_LIMIT {
            throw RuntimeError("Ty REPL reply exceeds {FRAME_LIMIT / (1024 * 1024)} MiB")
        }
        while let $end = __pending.search(10) {
            let line = __pending.str(0, end)
            __pending.clear(0, end + 1)
            let message = json.parse(Reply, line)
            match message {
                {type: 'ready', *} => (),
                {type: 'result', id: >id, *} => return message,
                {type: 'call', *} => return message,
                _ => throw RuntimeError('unexpected Ty REPL reply')
            }
        }
    }

    poll(writing?: Bool) {
        let events = os.POLLIN | (writing? ? os.POLLOUT : 0)
        match os.poll([(__fd, events), __stderr], 0.05) {
            Ok(_) or Err(errno.EINTR) => (),
            Err(error)                => throw OSError('poll Ty REPL', error)
        }
    }

    close() {
        return if __closed?
        __closed? = true
        let result = os.kill(-__pid, os.SIGKILL)
        let error = result < 0 ? errno.get() : 0
        os.close(__fd)
        os.close(__stderr)
        os.wait(__pid)
        if error != 0 && error != errno.ESRCH && error != errno.EPERM {
            throw OSError('stop Ty REPL', error)
        }
    }
}

class Cell {
    id:         Int
    request:    Blob
    output      = Blob()
    truncated?  = false
    began       = now(CLOCK_MONOTONIC)
    stopping:   String | nil = nil
    deadline    = 0.0
    nudged      = 0.0

    init(id: Int, code: String) {
        self.id = id
        request = Blob(json.encode({id, code}), 10)
    }

    stop(why: String) {
        if stopping == nil {
            stopping = why
            deadline = now(CLOCK_MONOTONIC) + GRACE
        }
    }

    handoff() -> _ {
        return {
            id, began, stopping, deadline, nudged,
            request: base64.encode(request),
            output: base64.encode(output),
            truncated: truncated?
        }
    }

    static adopt(state: _) -> Cell {
        let cell = Cell(state.id, '')
        cell.request = base64.decode(state.request)
        cell.output = base64.decode(state.output)
        cell.truncated? = state.truncated
        cell.began = state.began
        cell.stopping = state.stopping
        cell.deadline = state.deadline
        cell.nudged = state.nudged
        cell
    }
}

pub class Repl {
    __kernel: Kernel | nil = nil
    __cell: Cell | nil = nil
    __next = 0
    __canceled?: () -> Bool
    __host: ((String, Any) -> Any) | nil
    __wrap: Array[String]

    init(
        canceled?: () -> Bool = -> false,
        host: ((String, Any) -> Any) | nil = nil,
        wrap: Array[String] = []
    ) {
        __canceled? = canceled?
        __host = host
        __wrap = wrap
    }

    busy? -> Bool {
        __cell != nil
    }

    pid -> Int | nil {
        __kernel.?pid
    }

    running-for -> Float {
        __cell ? now(CLOCK_MONOTONIC) - __cell.began : 0.0
    }

    partial -> String {
        __cell.?output.?str!() ?? ''
    }

    handoff() -> _ {
        return {kernel: __kernel.?handoff(), cell: __cell.?handoff(), next: __next}
    }

    adopt(state: _) {
        __kernel = state.?kernel ? Kernel(adopt=state.kernel) : nil
        __cell = (state.?cell && __kernel) ? Cell.adopt(state.cell) : nil
        __next = state.?next ?? 0
    }

    respond(call: Call) -> Blob {
        let value: Any = nil
        let error: String | nil = nil
        try {
            let $host = __host or throw RuntimeError('no interpreter host')
            value = host(call.method, call.args)
        } catch exception {
            error = str(exception)
        }
        Blob(json.encode({type: 'reply', id: call.id, value, error}), 10)
    }

    close() {
        __cell = nil
        let $kernel = __kernel or return
        __kernel = nil
        kernel.close()
    }

    start(code: String) {
        if __cell != nil {
            throw RuntimeError('a Ty REPL cell is already running')
        }
        if __canceled?() {
            throw RuntimeError('Canceled')
        }
        __kernel = __kernel ?? Kernel(__wrap)
        __next += 1
        __cell = Cell(__next, code)
    }

    pump(until: Float) -> Result | nil {
        let $cell = __cell or throw RuntimeError('no Ty REPL cell is running')
        try {
            let result = exchange(cell, until)
            if result != nil {
                __cell = nil
            }
            return result
        } catch error {
            close()
            return {
                output: cell.output.str!(), value: nil, error: str(error),
                truncated: cell.truncated?, reset: true
            }
        }
    }

    stop(why: String) -> Result {
        let $cell = __cell or throw RuntimeError('no Ty REPL cell is running')
        cell.stop(why)
        pump(now(CLOCK_MONOTONIC) + GRACE * 2) ?? throw RuntimeError('the Ty REPL cell did not stop')
    }

    eval(code: String, timeout-ms: Int = 30000) -> Result {
        if timeout-ms <= 0 {
            throw ValueError('timeout-ms must be positive')
        }
        start(code)
        pump(now(CLOCK_MONOTONIC) + timeout-ms / 1000.0) ?? stop("Timed out after {timeout-ms / 1000}s")
    }

    exchange(cell: Cell, until: Float) -> Result | nil {
        let $kernel = __kernel or throw RuntimeError('Ty REPL is not running')
        while true {
            if __canceled?() {
                cell.stop('Canceled')
            }
            let clock = now(CLOCK_MONOTONIC)
            if let $why = cell.stopping and clock >= cell.deadline {
                throw RuntimeError("{why}; the cell did not stop, so the Ty REPL state was discarded")
            }
            if cell.stopping == nil && clock >= until {
                return nil
            }
            if cell.stopping && clock - cell.nudged >= 1.0 {
                kernel.interrupt()
                cell.nudged = clock
            }
            if #cell.request {
                kernel.write(cell.request)
            }
            cell.truncated? = kernel.output(cell.output) || cell.truncated?
            match kernel.reply(cell.id) {
                {type: 'call', *} as call => cell.request = respond(call),
                {type: 'result', value, error, truncated, *} => do {
                    cell.truncated? = kernel.output(cell.output) || cell.truncated?
                    let failure = (error && cell.stopping) ? "{cell.stopping}; the cell was interrupted, and state from earlier cells is kept" : error
                    return {output: cell.output.str!(), value, error: failure,
                            truncated: cell.truncated? || truncated, reset: false}
                },
                nil => ()
            }
            kernel.poll(bool(#cell.request))
        }
    }
}
