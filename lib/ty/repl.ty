import ty
import ty.mod
import ty.lex as lex
import ty.parse as parse
import ty.types as types
import os
import chalk (chalk)
import json
import path (Path)
import time
import readln (
    InteractiveLineReader,
    ListCompletions,
    CycleCompletions,
    CompletionItem,
    CompletionLabel,
    CompletionAction
)

chalk.fg0    = '#e1c78f'
chalk.fg1    = '#ddc7a1'
chalk.red    = '#ea6962'
chalk.aqua   = '#89b482'
chalk.orange = '#e78a4e'
chalk.yellow = '#d8a657'
chalk.green  = '#a9b665'
chalk.green2 = '#9dbd60'
chalk.blue   = '#7daea3'
chalk.blue2  = '#3193ce'
chalk.purple = '#d3869b'
chalk.aqua   = '#89b482'
chalk.grey   = '#847a6d'
chalk.pink   = '#d677be'

fn key(s: String) -> String {
    s.sub(/^__/, 'zz').sub(/^_/, 'z')
}

pub fn pretty-code(
    prompt: Any,
    lines: Array[Array[String]],
    line: Int,
    col: Int
) -> (Array[String], Int, Int) {
    let source = (lines.map(&join).unlines() ?? '') + '\n'
    let styled = parse.highlight(
        match ty.parse(source) {
            Ok(module)       => module,
            Err({module, *}) => module
        }
    )
    ((styled ?? source).lines()[;#lines], line, col)
}

fn type-completions(type: _, prefix: String) -> Array[_] {
    fn label(method) {
        [chalk"[bright blue]{method.name}[/][grey]:[/] ", types::show(method.type, color=true)]
    }

    match type {
        types::Scheme({body, *})
            => type-completions(body, prefix),

        types::Func(_)
            => type-completions(types::Object(Function, []), prefix),

        types::Object(_) or types::Class(_) => do {
            let $info = types.info(type) or return []
            let members: _ = [
                *info.methods,
                *info.fields,
                *info.getters,
                *info.setters
            ]

            fn fix-name(name: _) -> String {
                let name = name.match?(/\p{L}/) ? name : "`{name}`"
                let name = name[#prefix;]
                name.comb(/#\d+$/)
            }

            let completions = members
                .filter(\_.name.starts?(prefix.comb('`')))
                .filter(\_.type !:: types::Intersect)
                .sort(by=\key(_.name))
                .map(${(label(it), fix-name(it.name))})

            for info.traits {
                completions += type-completions(it, prefix)
            }

            if info.`super` != nil {
                completions += type-completions(info.`super`, prefix)
            }

            completions.uniq()
        }

        types::Record(members ~> $fields)
            => fields.keys()
                .filter(\_.starts?(prefix))
                .map(\_[#prefix;])
                .sort(by=key),

        _ => []
    }
}

fn mod-completions(mod: Dict[String, _], prefix: String) -> Array[CompletionItem] {
    let completions: Array[(CompletionLabel, String)] = []

    for name, item in mod if name.starts?(prefix) {
        let label: CompletionLabel | nil = match item {
            _ns: Dict => [chalk"[bright blue]{name}[/][grey]:[/] ", chalk"[b yellow]namespace[/]"],
            {type, *} => [chalk"[bright blue]{name}[/][grey]:[/] ", types::show(type, color=true)],
            _         => nil
        }

        if label {
            completions.push((label, name[#prefix;]))
        }
    }

    return [*completions.sort!(by=\key(_.1))]
}

fn get-import(name: String) -> Module | nil {
    ty.mod.get().imports[name.sub('.', '/')]
}

pub fn tab-complete(before: String, after: String) -> CompletionAction {
    if let [_, space, prefix] = before.match(/^\s*import\b(\s*)((?:\w|\.)*)$/) {
        let mod-paths = [Path(dir).glob('*.ty') for dir in ty.path].flat()
        let mod-names = mod-paths.map(\_.stem).sort!().uniq!()
        return CycleCompletions([
            (chalk"[bright yellow]{mod}[/]", (space ? '' : ' ') + mod[#prefix;])
            for mod in mod-names if mod.starts?(prefix)
        ])
    }

    let expr = match ty.parse("{before} .? \{") {
        Err({last: $expr, *}) => parse.ast(expr),

        Ok(mod) => mod.ast[-1],

        _ => do return ListCompletions([])
    }

    let expr = match expr {
        ty.Let(_, e) => e,
        _            => expr
    }

    if (before[-1] != '.') and let ty.Id({name, *}) = expr {
        return CycleCompletions(mod-completions(ty.mod.dict(), name))
    }


    let (subject, prefix) = match expr {
        ty.MemberAccess(o, m) and (before[-1] != '.')
            => (o, m),
        _
            => (expr, '')
    }

    if let ty.Id({name, *}) = subject and let $mod = get-import(name) {
        return CycleCompletions(mod-completions(mod.dict, prefix))
    }

    return CycleCompletions(type-completions(types.infer(subject), prefix))
}

_readln = InteractiveLineReader(
    prompt=() -> chalk"[#d3a2ff b]>>[/] ",
    complete=tab-complete,
    render=pretty-code,
    history-file=Path.home() / '.ty' / '.history'
).readln
