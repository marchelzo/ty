pub import ty.test.core (..)
pub import ty.test.assert (..)
pub import ty.test.patch (patch, patch-method, Patch)
pub import ty.test.spy (Spy, Call, spy, stub, spy-method)

import os
import stdio
import ty.test.worker as worker

if getenv('TY_TEST_WORKER') == '1' {
    stdio.setvbuf(stdio.stdout, stdio._IOLBF)
}

pub fn main(args: Array[String]) -> Int {
    worker.run(args)
}
