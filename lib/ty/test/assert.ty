import ty
import ty.parse as parse
import pretty (Raw)
import ty.test.core as core (SkipTest, TestTimeout)

use Site = {src: String, kind: String | nil, pattern: String | nil}

fn describe(x: Any) -> String {
    match x {
        e: BaseException => "{Class.name(type(e))}({show(e.what)})",
        _                => show(x)
    }
}

fn text-of(x: Any) -> String {
    match x {
        e: BaseException => e.what,
        _                => str(x)
    }
}

fn capture(f: () -> Any) -> (Bool, Any) {
    try {
        return (false, f())
    } catch e: SkipTest {
        throw e
    } catch e: TestTimeout {
        throw e
    } catch e {
        return (true, e)
    }
}

fn matches?(x: Any, pattern: Regex | String) -> Bool {
    match pattern {
        re: Regex => text-of(x).match?(re),
        s         => s in text-of(x)
    }
}

fn failure(
    site:      Site,
    file:      ?String,
    line:      ?Int,
    value:     Any,
    returned?: Bool
) -> AssertionError {
    let expected = match site {
        {kind: nil, pattern: nil, *} => 'an exception',
        {kind: nil, pattern: $p, *}  => "an exception matching {p}",
        {kind: $k, pattern: nil, *}  => k,
        {kind: $k, pattern: $p, *}   => "{k} matching {p}"
    }

    let shown  = describe(value)
    let detail = returned?
               ? "expected {expected}, nothing was thrown (returned {shown})"
               : "expected {expected}, got {shown}"

    let args = match site {
        {kind: nil, pattern: nil, *} => [site.src],
        {kind: $k, pattern: nil, *}  => [site.src, k],
        {kind: k, pattern: $p, *}    => [site.src, k ?? 'nil', p]
    }

    let src = "assert-throws({args.join(', ')})"

    AssertionError(
        "failed assertion: {src}\n    {detail}",
        src: src,
        file: file,
        line: line,
        op: 'throws',
        values: [value],
        note: detail
    )
}

pub macro assert-throws(expr, kind, pattern) {
    fn given(e) {
        match e {
            ty.Nil => nil,
            _      => e
        }
    }

    fn source-of(e) {
        (e == nil) ? nil : (parse.show(e) ?? '?')
    }

    let kind    = given(kind)
    let pattern = given(pattern)

    let site = {
        src: source-of(expr),
        kind: source-of(kind),
        pattern: source-of(pattern)
    }

    let thrown? = ty.Id(name: ty.gensym())
    let caught  = ty.Id(name: ty.gensym())

    let kind-ok    = (kind == nil) ? $$[ true $$] : $$[ $$caught :: $$kind $$]
    let pattern-ok = (pattern == nil)
                   ? $$[ true $$]
                   : $$[ $$::(matches?)($$caught, $$pattern) $$]

    let fail = $$[ $$::(failure) $$]

    $$[
        do {
            let ($$thrown?, $$caught) = $$::(capture)(() -> $$expr)
            if !$$thrown? {
                throw $$fail($${site}, __file__, __line__, $$caught, true)
            }
            if !$$kind-ok {
                throw $$fail($${site}, __file__, __line__, $$caught, false)
            }
            if !$$pattern-ok {
                throw $$fail($${site}, __file__, __line__, $$caught, false)
            }
            $$caught
        }
    $$]
}

pub class Approx {
    value: Any
    rel:   Float
    abs:   Float

    init(value: Any, rel: Float, abs: Float) {
        self.value = value
        self.rel   = rel
        self.abs   = abs
    }

    close?(x: Any) -> Bool {
        match (value, x) {
            (v: Int | Float, y: Int | Float) => within?(float(v), float(y)),
            (vs: Array, ys: Array) => #vs == #ys && vs.zip(ys).all?(
                |(v, y)| -> Approx(v, rel, abs).close?(y)
            ),
            _ => value == x,
        }
    }

    within?(v: Float, y: Float) -> Bool {
        (y - v).abs <= max(abs, rel * v.abs)
    }

    __str__() -> String {
        match value {
            v: Int | Float => "{v} ± {max(abs, rel * float(v).abs)}",
            v              => "approx({show(v)})",
        }
    }

    __pretty__() -> Array[Any] {
        [Raw(str(self))]
    }
}

pub fn approx(value: Any, rel: Float = 1.0e-9, abs: Float = 0.0) -> Approx {
    Approx(value, rel, abs)
}

fn ==(a: Float, b: Approx) -> Bool { b.close?(a) }
fn ==(a: Approx, b: Float) -> Bool { a.close?(b) }
fn ==(a: Int, b: Approx) -> Bool { b.close?(a) }
fn ==(a: Approx, b: Int) -> Bool { a.close?(b) }
fn ==(a: Array[Any], b: Approx) -> Bool { b.close?(a) }
fn ==(a: Approx, b: Array[Any]) -> Bool { a.close?(b) }

fn record(e: AssertionError) {
    let tr = ty.trace()
    match core.current-test() {
        nil => throw e,
        t   => t.record-check(e, tr),
    }
}

pub macro check(condition, message) {
    let assertion = __assert-expansion(condition, message)
    $$[
        try {
            $$assertion
        } catch caught: AssertionError {
            $$::(record)(caught)
        }
    $$]
}

fn indented(src: String) -> String {
    src.strip().lines().map(l -> "    {l}").join('\n')
}

pub fn assert-compile-error(
    src: String,
    pattern: Regex | String | nil = nil
) -> CompileError {
    let caught = try {
        __eval__(src)
        nil
    } catch e: CompileError {
        e
    }
    let $e = caught or throw AssertionError(
        "expected a compile error from:\n{indented(src)}",
        op: 'compile-error'
    )
    if let $p = pattern and !matches?(e, p) {
        throw AssertionError(
            "the compile error did not match {show(p)}:\n{indented(e.what)}",
            op: 'compile-error'
        )
    }
    e
}
