import os
import stdio

fn flush() {
    stdio.fflush(stdio.stdout)
    stdio.fflush(stdio.stderr)
}

pub class Capture {
    path:      ?String
    __fd:      Int
    __saved:   (Int, Int)
    __active?: Bool = false

    init(path: String, anonymous?: Bool = false) {
        let flags = os.O_RDWR | os.O_CREAT | os.O_APPEND
        let fd = os.open(path, flags, 0o600)
        if fd < 0 {
            throw RuntimeError("ty --test: cannot open capture file {path}")
        }
        if anonymous? {
            os.unlink(path)
        }
        self.path = anonymous? ? nil : path
        __fd      = fd
        __saved   = (os.dup(1), os.dup(2))
    }

    static temp() -> Capture {
        let base = (getenv('TMPDIR') ?? '/tmp').sub(/\/+$/, '')
        let (fd, p) = os.mktemp("{base}/ty-test-capture")
        if fd < 0 {
            throw RuntimeError("ty --test: cannot create a capture file under {base}")
        }
        os.close(fd)
        Capture(p, anonymous?: true)
    }

    offset -> Int {
        os.lseek(__fd, 0, stdio.SEEK_END)
    }

    begin() {
        if __active? {
            return
        }
        flush()
        os.dup2(__fd, 1)
        os.dup2(__fd, 2)
        __active? = true
    }

    end() {
        if !__active? {
            return
        }
        flush()
        os.dup2(__saved.0, 1)
        os.dup2(__saved.1, 2)
        __active? = false
    }

    read(from: Int) -> String {
        let stop = offset
        if stop <= from {
            return ''
        }
        os.lseek(__fd, from, stdio.SEEK_SET)
        os.read(__fd, stop - from, all: true).str()
    }

    close() {
        end()
        os.close(__fd)
        os.close(__saved.0)
        os.close(__saved.1)
    }
}

pub use Captured = {stdout: String, stderr: String, result: Any}

fn scratch(fd: Int) -> (Int, String) {
    let base = (getenv('TMPDIR') ?? '/tmp').sub(/\/+$/, '')
    let (out, p) = os.mktemp("{base}/ty-test-capture-{fd}")
    if out < 0 {
        throw RuntimeError("t.capture(): cannot create a file under {base}")
    }
    os.unlink(p)
    (out, p)
}

fn drain(fd: Int) -> String {
    let n = os.lseek(fd, 0, stdio.SEEK_END)
    if n <= 0 {
        return ''
    }
    os.lseek(fd, 0, stdio.SEEK_SET)
    os.read(fd, n, all: true).str()
}

pub fn call(f: () -> Any) -> Captured {
    let (out, _) = scratch(1)
    let (err, _) = scratch(2)
    let saved = (os.dup(1), os.dup(2))
    flush()
    os.dup2(out, 1)
    os.dup2(err, 2)
    let result = try {
        f()
    } finally {
        flush()
        os.dup2(saved.0, 1)
        os.dup2(saved.1, 2)
        os.close(saved.0)
        os.close(saved.1)
    }
    let c = {stdout: drain(out), stderr: drain(err), result}
    os.close(out)
    os.close(err)
    c
}
