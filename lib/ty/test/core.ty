import os
import path (Path)
import time
import ty
import ty.test.capture as cap (Captured)

pub use XFail = {reason: String, strict?: Bool}

pub use Condition = Bool | (() -> Bool)

pub class SkipTest < BaseException {
    reason: String

    init(reason: String) {
        self.reason = reason
    }

    what -> String {
        reason
    }
}

pub class TestTimeout < RuntimeError {
    secs: Float

    init(secs: Float) {
        super("test exceeded its {secs}s timeout")
        self.secs = secs
    }
}

pub class Case {
    values: Any
    id:     ?String
    skip:   ?String
    xfail:  ?String
    tags:   Array[String]

    init(
        values: Any,
        id:     ?String = nil,
        skip:   ?String = nil,
        xfail:  ?String = nil,
        tags:   Array[String] = []
    ) {
        self.values = values
        self.id     = id
        self.skip   = skip
        self.xfail  = xfail
        self.tags   = tags
    }
}

pub class Meta {
    tags:      Array[String] = []
    skip:      ?String = nil
    skip-if:   Array[(Condition, String)] = []
    platforms: Array[String] = []
    xfail:     ?XFail = nil
    todo:      ?String = nil
    only?:     Bool = false
    timeout:   ?Float = nil
    slow?:     Bool = false
    cases:     ?Array[Any] = nil
    retries:   ?Int = nil
    names:     Array[String] = []

    for-case(c: ?Case) -> Meta {
        let m = Meta()
        m.tags      = [*tags]
        m.skip      = skip
        m.skip-if   = skip-if
        m.platforms = platforms
        m.xfail     = xfail
        m.todo      = todo
        m.only?     = only?
        m.timeout   = timeout
        m.slow?     = slow?
        m.retries   = retries
        m.names     = names
        let $k = c or return m
        m.tags.push(*k.tags.filter(\!(_ in m.tags)))
        m.skip = k.skip ?? m.skip
        if let $x = k.xfail {
            m.xfail = {reason: x, strict?: true}
        }
        m
    }
}

pub class Fixture {
    name:  String
    func:  Any
    scope: String

    init(name: String, func: Any, scope: String) {
        self.name  = name
        self.func  = func
        self.scope = scope
    }
}

pub HOOK_KINDS = ['before-each', 'after-each', 'after-all']

let META: Dict[Any, Meta] = %{}

let FILE-SKIP: Array[String] = []

let FIXTURES: Dict[String, Fixture] = %{}

let HOOKS: Dict[String, Array[Any]] = %{k: [] for k in HOOK_KINDS}

let SPECIAL: Dict[Any, String] = %{}

pub fn camel-name(name: String) -> String {
    let parts = name.split('-')
    let tail = parts[1;].map(p -> "{p[;1].upper()}{p[1;]}")
    [parts[0], *tail].join('')
}

pub fn kebab-name(name: String) -> String {
    let out: Array[String] = []
    for ch; i in name.chars() {
        let hump? = i > 0
                 && ch.match?(/^[A-Z]$/)
                 && name[i - 1].match?(/^[a-z0-9]$/)
        out.push(hump? ? "-{ch.lower()}" : ch)
    }
    out.join('')
}

fn func-name(f: Any) -> String {
    match f {
        g: Function => g.__name__,
        _           => show(f),
    }
}

fn meta-of(f: Any, name: String) -> Meta {
    let m = META[f] ?? Meta()
    META[f] = m
    m.names.push(name)
    m
}

pub fn meta-for(f: Any) -> ?Meta {
    META[f]
}

pub fn meta-keys() -> Array[Any] {
    [k for k, _ in META]
}

pub fn file-skip-reason() -> ?String {
    (#FILE-SKIP > 0) ? FILE-SKIP[0] : nil
}

pub fn skip[F](f: F, reason: String) -> F {
    meta-of(f, 'skip').skip = reason
    f
}

pub fn skip-if[F](f: F, cond: Condition, reason: String) -> F {
    meta-of(f, 'skip-if').skip-if.push((cond, reason))
    f
}

pub fn platform[F](f: F, *names: String) -> F {
    meta-of(f, 'platform').platforms.push(*names)
    f
}

pub fn xfail[F](f: F, reason: String, strict: Bool = true) -> F {
    meta-of(f, 'xfail').xfail = {reason, strict?: strict}
    f
}

pub fn todo[F](f: F, reason: String) -> F {
    meta-of(f, 'todo').todo = reason
    f
}

pub fn only[F](f: F) -> F {
    meta-of(f, 'only').only? = true
    f
}

pub fn tags[F](f: F, *names: String) -> F {
    meta-of(f, 'tags').tags.push(*names)
    f
}

pub fn timeout[F](f: F, secs: Int | Float) -> F {
    meta-of(f, 'timeout').timeout = float(secs)
    f
}

pub fn slow[F](f: F) -> F {
    let m = meta-of(f, 'slow')
    m.slow? = true
    if !('slow' in m.tags) {
        m.tags.push('slow')
    }
    f
}

pub fn retries[F](f: F, n: Int) -> F {
    meta-of(f, 'retries').retries = n
    f
}

pub fn cases[F](f: F, rows: Array[Any]) -> F {
    meta-of(f, 'cases').cases = rows
    f
}

pub fn fixture[F](f: F, scope: String = 'test', name: ?String = nil) -> F {
    if !(scope in ['test', 'file']) {
        throw RuntimeError(
            "@fixture: scope must be 'test' or 'file', not '{scope}'"
        )
    }
    let key = camel-name(name ?? func-name(f))
    FIXTURES[key] = Fixture(key, f, scope)
    SPECIAL[f] = 'fixture'
    f
}

fn hook[F](kind: String, f: F) -> F {
    let hs = HOOKS[kind] ?? []
    HOOKS[kind] = hs
    hs.push(f)
    SPECIAL[f] = kind
    f
}

pub fn before-each[F](f: F) -> F {
    hook('before-each', f)
}

pub fn after-each[F](f: F) -> F {
    hook('after-each', f)
}

pub fn after-all[F](f: F) -> F {
    hook('after-all', f)
}

pub fn fixture-for(name: String) -> ?Fixture {
    FIXTURES[camel-name(name)]
}

pub fn hooks(kind: String) -> Array[Any] {
    HOOKS[kind] ?? []
}

pub fn special?(f: Any) -> Bool {
    SPECIAL[f] != nil
}

pub fn skip-file(reason: String) {
    FILE-SKIP.push(reason)
}

pub fn skip-file-unless(cond: Bool, reason: String) {
    if !cond {
        FILE-SKIP.push(reason)
    }
}

pub class StepResult {
    name:    String
    outcome: String
    dur:     Float
    error:   Any = nil
    trace:   Any = nil
    reason:  ?String = nil

    init(name: String, outcome: String, dur: Float) {
        self.name    = name
        self.outcome = outcome
        self.dur     = dur
    }
}

pub class Test {
    id:        String
    name:      String
    file:      String
    line:      Int
    seed:      Int
    attempt:   Int
    __cleanups: Array[() -> Any] = []
    __logs:     Array[String] = []
    __tmp:      ?String = nil
    __steps:    Array[StepResult] = []

    init(id: String, name: String, file: String, line: Int, seed: Int, attempt: Int = 1) {
        self.id      = id
        self.name    = name
        self.file    = file
        self.line    = line
        self.seed    = seed
        self.attempt = attempt
    }

    skip(reason: String) -> Any {
        throw SkipTest(reason)
    }

    cleanup(f: () -> Any) {
        __cleanups.push(f)
    }

    pop-cleanup() -> (() -> Any) | nil {
        (#__cleanups > 0) ? __cleanups.pop() : nil
    }

    logs -> Array[String] {
        __logs
    }

    tmp-path -> ?String {
        __tmp
    }

    tmp-dir() -> Path {
        if let $p = __tmp {
            return Path(p)
        }
        let base = getenv('TMPDIR') ?? '/tmp'
        let slug = name.sub(/[^A-Za-z0-9_.-]+/, '-')[;40]
        let $p = os.mkdtemp("{base.sub(/\/+$/, '')}/ty-{slug}")
              or throw RuntimeError("ty --test: cannot create a tmp dir under {base}")
        __tmp = p
        Path(p)
    }

    log(msg: String) {
        __logs.push(msg)
    }

    steps -> Array[StepResult] {
        __steps
    }

    step(name: String, f: () -> Any) -> Bool {
        let t0 = time.now()
        let r = try {
            f()
            StepResult(name, 'pass', time.now() - t0)
        } catch e: SkipTest {
            let s = StepResult(name, 'skip', time.now() - t0)
            s.reason = e.reason
            s
        } catch e: TestTimeout {
            throw e
        } catch e {
            let s = StepResult(name, 'fail', time.now() - t0)
            s.error = e
            s.trace = ty.trace()
            s
        }
        __steps.push(r)
        r.outcome != 'fail'
    }

    setenv(key: String, value: String) {
        let old = getenv(key)
        put-env(key, value)
        cleanup(-> put-env(key, old))
    }

    unsetenv(key: String) {
        let old = getenv(key)
        put-env(key, nil)
        cleanup(-> put-env(key, old))
    }

    chdir(dir: String | Path) {
        let old = os.getcwd()
        if os.chdir(str(dir)) != 0 {
            throw RuntimeError("t.chdir(): cannot change to {dir}")
        }
        cleanup(-> os.chdir(old))
    }

    capture(f: () -> Any) -> Captured {
        cap.call(f)
    }
}

fn put-env(key: String, value: ?String) {
    match value {
        nil => do {
            unsetenv(key)
            __env.remove(key)
        },
        v => do {
            setenv(key, v)
            __env[key] = v
        },
    }
}
