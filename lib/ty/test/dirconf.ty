import json
import os
import path (Path)
import time
import ty.test.events as events (Event)
import ty.test.sched as sched (Proc)
import ty.test.config as config (MARKER, SKIP_STATUS)

pub CONFIG = '__test__.ty'
pub PROBE_TIMEOUT = 30.0

pub class DirConf {
    dir:          String
    timeout:      ?Float = nil
    load-timeout: ?Float = nil
    tags:         Array[String] = []
    opt-in:       Bool | String | nil = nil
    serial:       ?Bool = nil
    env:          Dict[String, String] = %{}
    exclude:      Array[String] = []
    scripts:      Array[String] = []
    allow-empty:  Array[String] = []
    skip:         ?String = nil
    source:       ?String = nil
    error:        ?String = nil
    status:       ?Event = nil
    stdout:       String = ''
    stderr:       String = ''

    init(dir: String) {
        self.dir = dir
    }

    file(name: String) -> String {
        "{self.dir}/{name}"
    }
}

pub class Effective {
    timeout:      ?Float = nil
    load-timeout: ?Float = nil
    tags:         Array[String] = []
    group:        ?String = nil
    env:          Dict[String, String] = %{}
    excludes:     Array[(String, String)] = []
    skip:         ?DirConf = nil
    error:        ?DirConf = nil

    child(c: DirConf) -> Effective {
        let e = Effective()
        e.timeout      = c.timeout ?? self.timeout
        e.load-timeout = c.load-timeout ?? self.load-timeout
        e.tags         = [*self.tags, *c.tags.filter(t -> !(t in self.tags))]
        e.env          = sched.merge(self.env, c.env)
        e.excludes     = [*self.excludes, *c.exclude.map(p -> (c.dir, p))]
        e.skip         = self.skip ?? ((c.skip == nil) ? nil : c)
        e.error        = self.error ?? ((c.error == nil) ? nil : c)
        e.group        = match c.serial {
            true  => c.dir,
            false => nil,
            _     => self.group,
        }
        e
    }

    excluded?(file: String) -> Bool {
        self.excludes.any?(|(dir, pat)| -> pattern-matches?(dir, pat, file))
    }
}

fn glob-regex(pat: String) -> Regex {
    let out = Blob()
    let i = 0
    while i < #pat {
        let c = pat[i]
        match c {
            '*' and pat[i + 1;1] == '*' => do {
                out.push('.*')
                i += 1
            },
            '*' => out.push('[^/]*'),
            '?' => out.push('[^/]'),
            _ :: c.match?(/[\\.+()\[\]{}^$|]/) => out.push("\\{c}"),
            _ => out.push(c),
        }
        i += 1
    }
    regex("^{out.str()}$")
}

pub fn pattern-matches?(dir: String, pat: String, file: String) -> Bool {
    if file[;#dir + 1] != "{dir}/" {
        return false
    }
    let rel = file[#dir + 1;]
    let p = pat.comb(/^\.\//).comb(/\/+$/)
    let re = glob-regex(p)
    if rel.match?(re) {
        return true
    }
    !p.match?(/\//) && rel.split('/').any?(\_.match?(re))
}

fn as-float(x: Any) -> ?Float {
    match x {
        f: Float => f,
        n: Int   => float(n),
        _        => nil,
    }
}

fn as-strs(x: Any) -> Array[String] {
    let out: Array[String] = []
    if !(x :: Array) {
        return out
    }
    for match x {
        s: String => out.push(s),
        _         => nil,
    }
    out
}

fn as-env(x: Any) -> Dict[String, String] {
    let out: Dict[String, String] = %{}
    if !(x :: Dict) {
        return out
    }
    for k, v in x {
        out[str(k)] = str(v)
    }
    out
}

fn key(d: Dict[String, Any], name: String) -> Any {
    d[name] ?? d[name.sub(/-/, '_')]
}

fn parse-marker(line: String) -> ?Dict[String, Any] {
    let doc = try {
        json.parse(line)
    } catch _: RuntimeError {
        return nil
    }
    match doc {
        d: Dict => match d[MARKER] {
            m: Dict => m,
            _       => nil,
        },
        _ => nil,
    }
}

fn markers(text: String) -> Array[Dict[String, Any]] {
    let out: Array[Dict[String, Any]] = []
    for text.lines() {
        continue if !it.match?(/^\s*\{"ty_test_dir"/)
        if let $m = parse-marker(it.strip()) {
            out.push(m)
        }
    }
    out
}

fn first-line(text: String) -> ?String {
    let lines = text.lines()
                    .filter(l -> !l.match?(/^\s*\{"ty_test_dir"/))
                    .map(&strip)
                    .filter(\#_ > 0)
    (#lines > 0) ? lines[0] : nil
}

fn apply(c: DirConf, m: Dict[String, Any]) {
    if let $t = as-float(key(m, 'timeout')) {
        c.timeout = t
    }
    if let $t = as-float(key(m, 'load-timeout')) {
        c.load-timeout = t
    }
    match key(m, 'opt-in') {
        b: Bool   => c.opt-in = b,
        s: String => c.opt-in = s,
        _         => nil,
    }
    match key(m, 'serial') {
        b: Bool => c.serial = b,
        _       => nil,
    }
    c.tags        = [*c.tags, *as-strs(key(m, 'tags'))]
    c.env         = sched.merge(c.env, as-env(key(m, 'env')))
    c.exclude     = [*c.exclude, *as-strs(key(m, 'exclude'))]
    c.scripts     = [*c.scripts, *as-strs(key(m, 'scripts'))]
    c.allow-empty = [*c.allow-empty, *as-strs(key(m, 'allow-empty'))]
}

class Probe {
    conf:       DirConf
    name:       String
    proc:       Proc
    timed-out?: Bool = false
    done?:      Bool = false

    init(conf: DirConf, name: String, proc: Proc) {
        self.conf = conf
        self.name = name
        self.proc = proc
    }
}

fn fail(p: Probe, why: String, st: Event) {
    let c = p.conf
    return if c.error != nil
    c.error  = why
    c.source = p.name
    c.status = st
    c.stdout = sched.tail-str(p.proc.out-buf)
    c.stderr = sched.tail-str(p.proc.err-buf)
}

fn interpret(p: Probe, timeout: Float) {
    let c = p.conf
    let out = sched.tail-str(p.proc.out-buf)
    let err = sched.tail-str(p.proc.err-buf)
    let ms = markers(out)
    if p.timed-out? {
        let st = events.status('timeout', signal: 'SIGKILL', phase: 'load')
        fail(p, "{p.name} timed out after {timeout}s", st)
        return
    }
    if let $sig = p.proc.signal {
        let name = sched.signal-name(sig)
        let st = events.status('signal', signal: name, phase: 'load')
        fail(p, "{p.name} was killed by {name}", st)
        return
    }
    let skip-marker = ms.map(m -> m['skip']).filter(\_ :: String)
    match p.proc.code {
        0 and #skip-marker == 0 => ms.each(m -> apply(c, m)),
        $rc :: rc == 0 || rc == SKIP_STATUS => do {
            ms.each(m -> apply(c, m))
            if c.skip == nil {
                let reason = match skip-marker {
                    [s: String, *] => s,
                    _              => first-line(out) ?? first-line(err) ?? 'requirements not met',
                }
                c.skip   = reason
                c.source = p.name
            }
        },
        code => do {
            let st = events.status('exit', code: code, phase: 'load')
            fail(p, "{p.name} exited {code}", st)
        },
    }
}

pub fn probe(
    dirs: Array[String],
    cmd: Array[String],
    interrupted?: () -> Bool,
    timeout: Float = PROBE_TIMEOUT
) -> Dict[String, DirConf] {
    let out: Dict[String, DirConf] = %{}
    let running: Array[Probe] = []
    for dirs {
        let c = DirConf(it)
        out[it] = c
        let f = c.file(CONFIG)
        if Path(f).file? {
            running.push(Probe(c, CONFIG, Proc([*cmd, f])))
        }
    }
    let deadline = time.now() + timeout
    while #running > 0 {
        if interrupted?() {
            for running {
                it.proc.kill(os.SIGKILL)
                it.proc.reap-blocking()
                it.proc.drain()
            }
            break
        }
        let fds: Array[(Int, Int)] = []
        for running {
            fds += it.proc.fds()
        }
        let hits: Array[(Int, Int)] = []
        os.poll(fds, hits, sched.TICK)
        for (fd, _) in hits {
            for running {
                if it.proc.owns?(fd) {
                    it.proc.ready(fd)
                    break
                }
            }
        }
        let late? = time.now() >= deadline
        for [*running] {
            if late? && !it.proc.exited? {
                it.timed-out? = true
                it.proc.kill(os.SIGKILL)
                it.proc.reap-blocking()
            }
            if it.proc.reap() {
                it.proc.drain()
                interpret(it, timeout)
                it.done? = true
            }
        }
        running = running.filter(p -> !p.done?)
    }
    out
}
