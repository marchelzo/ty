import os
import path (Path)
import ty
import ty.test.core as core (XFail, Meta, Case, camel-name, kebab-name)
import ty.test.fixtures as fixtures

pub use TestSite = {
    module:      String,
    file:        ?String,
    scopes:      Array[String],
    name:        String,
    ident:       String,
    line:        Int,
    col:         Int,
    end-line:    Int,
    doc:         ?String,
    params:      Array[String],
    required:    Int,
    generator?:  Bool,
    public?:     Bool,
    overloaded?: Bool,
    func:        Any
}

pub use Warning = {code: String, message: String, line: ?Int}

pub class TestCase {
    id:        String
    local:     String
    file:      String
    name:      String
    scopes:    Array[String]
    line:      Int
    end-line:  Int
    doc:       ?String
    meta:      Meta
    func:      Any
    wants-t?:  Bool
    error:     ?String
    args:      Array[Any] = []
    kwargs:    Dict[String, Any] = %{}
    fixtures:  Array[String] = []

    init(
        id:       String,
        local:    String,
        file:     String,
        site:     TestSite,
        meta:     Meta,
        wants-t?: Bool,
        error:    ?String
    ) {
        self.id       = id
        self.local    = local
        self.file     = file
        self.name     = site.name
        self.scopes   = site.scopes
        self.line     = site.line
        self.end-line = site.end-line
        self.doc      = site.doc
        self.meta     = meta
        self.func     = site.func
        self.wants-t? = wants-t?
        self.error    = error
    }

    tags -> Array[String] {
        meta.tags
    }

    xfail -> ?XFail {
        meta.xfail
    }

    only? -> Bool {
        meta.only?
    }
}

pub class Collection {
    file:     String
    cases:    Array[TestCase] = []
    warnings: Array[Warning] = []

    init(file: String) {
        self.file = file
    }
}

pub fn relative(p: String) -> String {
    let cwd = os.getcwd()
    match p {
        _ :: p[;#cwd + 1] == "{cwd}/" => p[#cwd + 1;],
        _                             => p,
    }
}

pub fn resolve(p: String) -> String {
    os.realpath(p) ?? p
}

pub fn sites() -> Array[TestSite] {
    ty.tests()
}

fn local-id(site: TestSite) -> String {
    [*site.scopes, site.name].join('::')
}

fn callable?(x: Any) -> Bool {
    match x {
        _: Function => true,
        _: Class    => true,
        _           => false,
    }
}

fn site-error(site: TestSite, static?: Bool) -> ?String {
    if site.overloaded? {
        return 'overloaded functions cannot be tests'
    }
    if site.generator? {
        return 'generator functions cannot be tests'
    }
    if !static? && !callable?(site.func) {
        return "test is not callable (bound to {show(site.func)}; "
               'does a decorator return its argument?)'
    }
    nil
}

use Binding = {args: Array[Any], kwargs: Dict[String, Any]}

fn quoted(name: String) -> String {
    "`{kebab-name(name)}`"
}

fn extra-params(site: TestSite) -> Array[String] {
    match site.params {
        ['t', *rest] => rest,
        ps           => ps,
    }
}

fn row-values(row: Any) -> Any {
    match row {
        c: Case => c.values,
        v       => v,
    }
}

fn keyed(
    kws:   Dict[String, Any],
    site:  TestSite,
    label: String
) -> Binding | String {
    let fun = quoted(site.ident)
    for k, _ in kws {
        if !(k in extra-params(site)) {
            return "case {label} sets {quoted(k)}, which {fun} doesn't take"
        }
    }
    ({args: [], kwargs: kws})
}

fn bind-row(row: Any, site: TestSite, label: String) -> Binding | String {
    let n = #extra-params(site)
    match row-values(row) {
        d: Dict => do {
            let kws: Dict[String, Any] = %{}
            for k, v in d {
                kws[camel-name(str(k))] = v
            }
            keyed(kws, site, label)
        },
        tp: Tuple => do {
            let ms = members(tp)
            if ms.keys().any?(\_ :: String) {
                let kws: Dict[String, Any] = %{}
                for k, v in ms {
                    kws[str(k)] = v
                }
                return keyed(kws, site, label)
            }
            let vs = [*tp]
            if #vs > n {
                let fun = quoted(site.ident)
                return "case {label} has {#vs} values but {fun} takes {n}"
            }
            ({args: vs, kwargs: %{}})
        },
        x => ({args: [x], kwargs: %{}}),
    }
}

fn covered(site: TestSite, b: Binding) -> Array[String] {
    let extra = extra-params(site)
    [*extra[;#b.args], *b.kwargs.keys()]
}

fn param-error(site: TestSite, b: Binding, label: ?String) -> ?String {
    let have = covered(site, b)
    let $p = fixtures.missing(site.params, site.required, have) or return nil
    match label {
        nil => "test takes required parameter {quoted(p)}, "
               'which is not a fixture',
        l   => "case {l} doesn't provide {quoted(p)}, which is not a fixture",
    }
}

fn word-regex(name: String) -> Regex {
    regex("(?<![\\w-])\\Q{name}\\E(?![\\w?!-])")
}

fn uncalled?(site: TestSite, source: String) -> Bool {
    let takes-args? = match site.params {
        [] or ['t'] => false,
        _           => site.required > 0,
    }
    !takes-args? && source.count(word-regex(site.name)) <= 1
}

fn decorator-names(m: Meta) -> String {
    m.names.map(n -> "@{n}").join(', ')
}

fn missing-pub(site: TestSite, meta: ?Meta) -> Warning {
    let why = match meta {
        $m => "has {decorator-names(m)}",
        _  => 'is never called',
    }
    {
        code: 'missing-pub',
        message: "`{local-id(site)}` {why} but is not `pub`, "
                 'so it never runs (missing `pub`?)',
        line: site.line
    }
}

fn row-label(row: Any, i: Int) -> String {
    match row {
        k: Case => k.id ?? str(i),
        _       => str(i),
    }
}

fn make-case(
    site:    TestSite,
    file:    String,
    meta:    Meta,
    error:   ?String,
    row:     Any,
    label:   ?String,
    static?: Bool
) -> TestCase {
    let local = match label {
        nil => local-id(site),
        l   => "{local-id(site)}[{l}]",
    }
    let k = match row {
        c: Case => c,
        _       => nil,
    }
    let wants-t? = (#site.params > 0) && (site.params[0] == 't')
    let b: Binding = {args: [], kwargs: %{}}
    if let $l = label and !static? {
        match bind-row(row, site, l) {
            msg: String => error = error ?? msg,
            bound       => b = bound,
        }
    }
    if !static? {
        error = error ?? param-error(site, b, label)
    }
    let m = meta.for-case(k)
    let tc = TestCase("{file}::{local}", local, file, site, m, wants-t?, error)
    tc.args     = b.args
    tc.kwargs   = b.kwargs
    tc.fixtures = static? ? [] : fixtures.wants(site.params, covered(site, b))
    tc
}

pub fn collect(target: String, static?: Bool = false) -> Collection {
    let path = resolve(target)
    let file = relative(path)
    let c = Collection(file)
    let funcs: Array[Any] = []
    let source = try {
        Path(path).read-text()
    } catch _: RuntimeError {
        ''
    }

    for site in sites() {
        funcs.push(site.func)

        continue if core.special?(site.func)

        if !site.public? {
            let meta = core.meta-for(site.func)
            if meta != nil || uncalled?(site, source) {
                c.warnings.push(missing-pub(site, meta))
            }
            continue
        }

        let meta = core.meta-for(site.func) ?? Meta()
        let error = site-error(site, static?)

        let $rows = meta.cases or do {
            c.cases.push(make-case(site, file, meta, error, nil, nil, static?))
            continue
        }
        if #rows == 0 {
            let why = error ?? '@cases has no rows'
            c.cases.push(make-case(site, file, meta, why, nil, nil, static?))
            continue
        }
        for row; i in rows {
            let label = row-label(row, i)
            let tc = make-case(site, file, meta, error, row, label, static?)
            c.cases.push(tc)
        }
    }

    for f in core.meta-keys() {
        continue if f in funcs
        let names = decorator-names(core.meta-for(f) ?? Meta())
        c.warnings.push({
            code: 'metadata-on-non-test',
            message: "{names} applied to {show(f)}, "
                     'which is not a test (decorator order?)',
            line: nil
        })
    }

    c
}
