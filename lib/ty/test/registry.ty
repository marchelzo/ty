import os
import ty
import ty.test.core as core (XFail, Meta)

pub use TestSite = {
    module:      String,
    file:        ?String,
    scopes:      Array[String],
    name:        String,
    ident:       String,
    line:        Int,
    col:         Int,
    end-line:    Int,
    doc:         ?String,
    params:      Array[String],
    required:    Int,
    generator?:  Bool,
    public?:     Bool,
    overloaded?: Bool,
    func:        Any
}

pub use Warning = {code: String, message: String, line: ?Int}

pub class TestCase {
    id:        String
    local:     String
    file:      String
    name:      String
    scopes:    Array[String]
    line:      Int
    end-line:  Int
    doc:       ?String
    meta:      Meta
    func:      Any
    wants-t?:  Bool
    error:     ?String

    init(
        id:       String,
        local:    String,
        file:     String,
        site:     TestSite,
        meta:     Meta,
        wants-t?: Bool,
        error:    ?String
    ) {
        self.id       = id
        self.local    = local
        self.file     = file
        self.name     = site.name
        self.scopes   = site.scopes
        self.line     = site.line
        self.end-line = site.end-line
        self.doc      = site.doc
        self.meta     = meta
        self.func     = site.func
        self.wants-t? = wants-t?
        self.error    = error
    }

    tags -> Array[String] {
        meta.tags
    }

    xfail -> ?XFail {
        meta.xfail
    }

    only? -> Bool {
        meta.only?
    }
}

pub class Collection {
    file:     String
    cases:    Array[TestCase] = []
    warnings: Array[Warning] = []
    private:  Array[String] = []

    init(file: String) {
        self.file = file
    }
}

pub fn relative(p: String) -> String {
    let cwd = os.getcwd()
    match p {
        _ :: p[;#cwd + 1] == "{cwd}/" => p[#cwd + 1;],
        _                             => p,
    }
}

pub fn resolve(p: String) -> String {
    os.realpath(p) ?? p
}

pub fn sites() -> Array[TestSite] {
    ty.tests()
}

fn local-id(site: TestSite) -> String {
    [*site.scopes.filter(\_ != 'test'), site.name].join('::')
}

fn callable?(x: Any) -> Bool {
    match x {
        _: Function => true,
        _: Class    => true,
        _           => false,
    }
}

fn site-error(site: TestSite, static?: Bool) -> ?String {
    if site.overloaded? {
        return 'overloaded functions cannot be tests'
    }
    if site.generator? {
        return 'generator functions cannot be tests'
    }
    let extra = match site.params {
        ['t', *rest] => rest,
        ps           => ps,
    }
    let required = site.required - (#site.params - #extra)
    if required > 0 {
        let names = extra[;required].map(p -> "`{p}`").join(', ')
        return "test takes required parameter {names} "
               '(only a first parameter named `t` is supported)'
    }
    if !static? && !callable?(site.func) {
        return "test is not callable (bound to {show(site.func)}; "
               'does a decorator return its argument?)'
    }
    nil
}

pub fn collect(
    target: String,
    include-imported?: Bool = false,
    static?: Bool = false
) -> Collection {
    let path = resolve(target)
    let file = relative(path)
    let c = Collection(file)
    let seen: Dict[String, Int] = %{}
    let funcs: Array[Any] = []

    for site in sites() {
        funcs.push(site.func)

        let site-path = resolve(site.file ?? '')
        let here? = site-path == path

        if !here? && !include-imported? {
            continue
        }

        if !site.public? {
            if here? {
                c.private.push(local-id(site))
            }
            continue
        }

        let owner = here? ? file : relative(site-path)
        let local = local-id(site)
        let id = "{owner}::{local}"
        let meta = core.meta-for(site.func) ?? Meta()

        let error = match seen[id] {
            nil  => site-error(site, static?),
            line => "duplicate test id (also defined at line {line})",
        }

        seen[id] = seen[id] ?? site.line

        let wants-t? = (#site.params > 0) && (site.params[0] == 't')

        c.cases.push(TestCase(id, local, owner, site, meta, wants-t?, error))
    }

    if #c.private > 0 && #c.cases == 0 {
        let n = #c.private
        let what = (n == 1) ? 'function is' : 'functions are'
        c.warnings.push({
            code: 'private-tests',
            message: "{n} {what} in `ns test` but not `pub` and never run "
                     "(missing `pub`?): {c.private.join(', ')}",
            line: nil
        })
    }

    for f in core.meta-keys() {
        if f in funcs {
            continue
        }
        let names = (core.meta-for(f).?names ?? []).map(n -> "@{n}").join(', ')
        c.warnings.push({
            code: 'metadata-on-non-test',
            message: "{names} applied to {show(f)}, which is not a test (decorator order?)",
            line: nil
        })
    }

    c
}
