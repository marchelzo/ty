import os
import path (Path)
import ty
import ty.test.core as core (XFail, Meta)

pub use TestSite = {
    module:      String,
    file:        ?String,
    scopes:      Array[String],
    name:        String,
    ident:       String,
    line:        Int,
    col:         Int,
    end-line:    Int,
    doc:         ?String,
    params:      Array[String],
    required:    Int,
    generator?:  Bool,
    public?:     Bool,
    overloaded?: Bool,
    func:        Any
}

pub use Warning = {code: String, message: String, line: ?Int}

pub class TestCase {
    id:        String
    local:     String
    file:      String
    name:      String
    scopes:    Array[String]
    line:      Int
    end-line:  Int
    doc:       ?String
    meta:      Meta
    func:      Any
    wants-t?:  Bool
    error:     ?String

    init(
        id:       String,
        local:    String,
        file:     String,
        site:     TestSite,
        meta:     Meta,
        wants-t?: Bool,
        error:    ?String
    ) {
        self.id       = id
        self.local    = local
        self.file     = file
        self.name     = site.name
        self.scopes   = site.scopes
        self.line     = site.line
        self.end-line = site.end-line
        self.doc      = site.doc
        self.meta     = meta
        self.func     = site.func
        self.wants-t? = wants-t?
        self.error    = error
    }

    tags -> Array[String] {
        meta.tags
    }

    xfail -> ?XFail {
        meta.xfail
    }

    only? -> Bool {
        meta.only?
    }
}

pub class Collection {
    file:     String
    cases:    Array[TestCase] = []
    warnings: Array[Warning] = []

    init(file: String) {
        self.file = file
    }
}

pub fn relative(p: String) -> String {
    let cwd = os.getcwd()
    match p {
        _ :: p[;#cwd + 1] == "{cwd}/" => p[#cwd + 1;],
        _                             => p,
    }
}

pub fn resolve(p: String) -> String {
    os.realpath(p) ?? p
}

pub fn sites() -> Array[TestSite] {
    ty.tests()
}

fn local-id(site: TestSite) -> String {
    [*site.scopes, site.name].join('::')
}

fn callable?(x: Any) -> Bool {
    match x {
        _: Function => true,
        _: Class    => true,
        _           => false,
    }
}

fn site-error(site: TestSite, static?: Bool) -> ?String {
    if site.overloaded? {
        return 'overloaded functions cannot be tests'
    }
    if site.generator? {
        return 'generator functions cannot be tests'
    }
    let extra = match site.params {
        ['t', *rest] => rest,
        ps           => ps,
    }
    let required = site.required - (#site.params - #extra)
    if required > 0 {
        let names = extra[;required].map(p -> "`{p}`").join(', ')
        return "test takes required parameter {names} "
               '(only a first parameter named `t` is supported)'
    }
    if !static? && !callable?(site.func) {
        return "test is not callable (bound to {show(site.func)}; "
               'does a decorator return its argument?)'
    }
    nil
}

fn word-regex(name: String) -> Regex {
    regex("(?<![\\w-])\\Q{name}\\E(?![\\w?!-])")
}

fn uncalled?(site: TestSite, source: String) -> Bool {
    let takes-args? = match site.params {
        [] or ['t'] => false,
        _           => site.required > 0,
    }
    !takes-args? && source.count(word-regex(site.name)) <= 1
}

fn decorator-names(m: Meta) -> String {
    m.names.map(n -> "@{n}").join(', ')
}

fn missing-pub(site: TestSite, meta: ?Meta) -> Warning {
    let why = match meta {
        $m => "has {decorator-names(m)}",
        _  => 'is never called',
    }
    {
        code: 'missing-pub',
        message: "`{local-id(site)}` {why} but is not `pub`, "
                 'so it never runs (missing `pub`?)',
        line: site.line
    }
}

pub fn collect(target: String, static?: Bool = false) -> Collection {
    let path = resolve(target)
    let file = relative(path)
    let c = Collection(file)
    let funcs: Array[Any] = []
    let source = try {
        Path(path).read-text()
    } catch _: RuntimeError {
        ''
    }

    for site in sites() {
        funcs.push(site.func)

        if !site.public? {
            let meta = core.meta-for(site.func)
            if meta != nil || uncalled?(site, source) {
                c.warnings.push(missing-pub(site, meta))
            }
            continue
        }

        let local = local-id(site)
        let id = "{file}::{local}"
        let meta = core.meta-for(site.func) ?? Meta()

        let error = site-error(site, static?)
        let wants-t? = (#site.params > 0) && (site.params[0] == 't')

        c.cases.push(TestCase(id, local, file, site, meta, wants-t?, error))
    }

    for f in core.meta-keys() {
        if f in funcs {
            continue
        }
        let names = decorator-names(core.meta-for(f) ?? Meta())
        c.warnings.push({
            code: 'metadata-on-non-test',
            message: "{names} applied to {show(f)}, "
                     'which is not a test (decorator order?)',
            line: nil
        })
    }

    c
}
