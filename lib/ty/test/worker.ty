import json
import os
import path (Path)
import thread
import time
import ty
import ty.test.args as args (Options, UsageError, USAGE)
import ty.test.cache as cache
import ty.test.capture (Capture)
import ty.test.core as core (
    Test, SkipTest, TestTimeout, StepResult, kebab-name
)
import ty.test.events as events (Event, EventSink)
import ty.test.fixtures as fixtures (Resolver)
import ty.test.patch as patching
import ty.test.registry as registry (TestCase, Collection)
import ty.test.report as report
import ty.test.select as select

let RUNNER-DIR = Path(__file__).parent.str()

let DEFAULT-WORKER-TIMEOUT = 10.0

class AlarmState {
    tid:     Int = thread.id()
    secs:    Float = 0.0
    armed?:  Bool = false
}

let ALARM = AlarmState()

fn on-alarm(sig: Int) {
    return if !ALARM.armed?
    if thread.id() == ALARM.tid {
        ALARM.armed? = false
        throw TestTimeout(ALARM.secs)
    }
    os.kill(os.getpid(), os.SIGALRM)
}

fn arm(secs: ?Float) {
    let $s = secs or return
    if s <= 0.0 {
        return
    }
    ALARM.tid    = thread.id()
    ALARM.secs   = s
    ALARM.armed? = true
    os.alarm(s)
}

fn disarm() {
    ALARM.armed? = false
    os.alarm(0.0)
}

fn cpu-time() -> Float {
    let t = time.gettime(time.CLOCK_PROCESS_CPUTIME_ID)
    t.sec + t.nsec / 1.0e9
}

use Frame = {file: ?String, line: Int, col: Int, func: ?String, src: String}

fn runner-frame?(f: Frame) -> Bool {
    match f.file {
        nil => true,
        p   => p[;#RUNNER-DIR + 1] == "{RUNNER-DIR}/" || p == "{RUNNER-DIR}.ty",
    }
}

fn user-frames(tr: Any) -> Array[Frame] {
    let frames: Array[Frame] = ty.frames(tr)
    frames.filter(f -> !runner-frame?(f)).reverse()
}

fn render-frames(frames: Array[Frame]) -> String {
    let lines: Array[String] = []
    for f in frames {
        let at = "{registry.relative(f.file ?? '?')}:{f.line}:{f.col}"
        let who = match f.func {
            nil => '',
            fun => " in {fun}",
        }
        lines.push("at {at}{who}")
        lines.push("    {f.src.strip()}")
    }
    lines.join('\n')
}

fn diff-of(e: Any) -> ?Event {
    match e {
        a: AssertionError and a.op == '==' and #a.values == 2 => explain(a),
        _                                                     => nil,
    }
}

fn explain(a: AssertionError) -> ?Event {
    let lines: Array[String] = try {
        let differ: Any = Module('diff')
        let explain: Any = differ.explain
        explain(a.values[0], a.values[1])
    } catch _: RuntimeError {
        []
    }
    if #lines == 0 {
        return nil
    }
    let sides = (#a.sides == 2) ? a.sides : ['left', 'right']
    %{'left': sides[0], 'right': sides[1], 'lines': lines}
}

fn failure-of(e: Any, tr: Any) -> Event {
    let frames = user-frames(tr)
    let fl = events.failure-of(e, trace: render-frames(frames))
    if let $p = fl['file'] {
        fl['file'] = registry.relative(p)
    } else if #frames > 0 {
        fl['file'] = registry.relative(frames[0].file ?? '?')
        fl['line'] = frames[0].line
    }
    if let $d = diff-of(e) {
        fl['diff'] = d
    }
    fl
}

class Outcome {
    kind:     String
    reason:   ?String = nil
    failure:  ?Event = nil
    result:   Any = nil

    init(kind: String, reason: ?String = nil, failure: ?Event = nil, result: Any = nil) {
        self.kind    = kind
        self.reason  = reason
        self.failure = failure
        self.result  = result
    }
}

fn hook-name(f: Any) -> String {
    let name = match f {
        g: Function => kebab-name(g.__name__),
        _           => show(f),
    }
    "`{name}`"
}

fn call-hook(f: Any, t: Test) -> Any {
    let sig = ty.signature(f)
    let g: Any = f
    match sig.?params {
        ['t', *] => g(t),
        _        => g(),
    }
}

class Stage {
    what: ?String = nil
}

fn invoke(c: TestCase, t: Test, secs: ?Float, fx: Resolver) -> Outcome {
    let stage = Stage()
    try {
        arm(secs)
        for core.hooks('before-each') {
            stage.what = "before-each hook {hook-name(it)} failed"
            call-hook(it, t)
        }
        let kws: Dict[String, Any] = %{}
        for k, v in c.kwargs {
            kws[k] = v
        }
        for c.fixtures {
            stage.what = "fixture `{kebab-name(it)}` failed"
            kws[it] = fx.value(it, t)
        }
        stage.what = nil
        let pos: Array[Any] = c.wants-t? ? [t, *c.args] : c.args
        let f: Any = c.func
        let r = f(*pos, **kws)
        disarm()
        return Outcome('pass', result: r)
    } catch e: SkipTest {
        disarm()
        return Outcome('skip', reason: e.reason)
    } catch e: TestTimeout {
        disarm()
        let tr = ty.trace()
        return Outcome('timeout', reason: "exceeded {e.secs}s", failure: failure-of(e, tr))
    } catch e {
        disarm()
        let tr = ty.trace()
        let kind = (stage.what == nil) ? 'fail' : 'error'
        return Outcome(kind, reason: stage.what, failure: failure-of(e, tr))
    }
}

fn run-after-each(t: Test) -> ?(String, Event) {
    let first: ?(String, Event) = nil
    for core.hooks('after-each').reverse() {
        try {
            call-hook(it, t)
        } catch e {
            let tr = ty.trace()
            let why = "after-each hook {hook-name(it)} failed"
            first = first ?? (why, failure-of(e, tr))
        }
    }
    first
}

fn step-events(c: TestCase, steps: Array[StepResult]) -> Array[Event] {
    steps.map(s -> events.step-result(
        "{c.id}/{s.name}",
        s.name,
        s.outcome,
        dur: s.dur,
        reason: s.reason,
        failure: (s.error == nil) ? nil : failure-of(s.error, s.trace)
    ))
}

fn check-failure(e: Any, tr: Any) -> Event {
    let fl = failure-of(e, tr)
    fl['via'] = 'check'
    fl
}

fn with-checks(o: Outcome, checks: Array[Event]) -> Outcome {
    if o.kind != 'pass' || #checks == 0 {
        return o
    }
    let n = #checks
    let why = "{n} check{(n == 1) ? '' : 's'} failed"
    Outcome('fail', reason: why, failure: checks[0])
}

fn with-steps(o: Outcome, steps: Array[Event]) -> Outcome {
    if o.kind != 'pass' {
        return o
    }
    let failed = steps.filter(\events.get-str(_, 'outcome') == 'fail')
    if #failed == 0 {
        return o
    }
    let names = failed.map(s -> "`{events.get-str(s, 'name')}`").join(', ')
    let what = (#failed == 1) ? 'step' : 'steps'
    let fl = events.get-event(failed[0], 'failure')
    Outcome('fail', reason: "{what} {names} failed", failure: fl)
}

fn run-cleanups(t: Test) -> ?Event {
    let first: ?Event = nil
    while let $f = t.pop-cleanup() {
        try {
            f()
        } catch e {
            let tr = ty.trace()
            first = first ?? failure-of(e, tr)
        }
    }
    first
}

fn eval-condition(cond: core.Condition) -> Bool {
    match cond {
        b: Bool => b,
        f       => f() == true,
    }
}

fn static-skip(c: TestCase, file-skip: ?String) -> ?String {
    if let $r = file-skip {
        return r
    }
    if let $r = c.meta.skip {
        return r
    }
    for (cond, reason) in c.meta.skip-if {
        if eval-condition(cond) {
            return reason
        }
    }
    let ps = c.meta.platforms
    if #ps > 0 && !(ty.platform in ps) {
        return "only on {ps.join(', ')}"
    }
    nil
}

class Attempt {
    o:      Outcome
    dur:    Float
    output: String
    logs:   Array[String]
    tmp:    ?String
    steps:  Array[Event]
    checks: Array[Event] = []

    init(
        o:      Outcome,
        dur:    Float,
        output: String,
        logs:   Array[String],
        tmp:    ?String,
        steps:  Array[Event]
    ) {
        self.o      = o
        self.dur    = dur
        self.output = output
        self.logs   = logs
        self.tmp    = tmp
        self.steps  = steps
    }

    discard(opts: Options) {
        if let $p = tmp and !opts.keep-tmp? {
            Path(p).rmtree(quiet: true)
        }
        tmp = nil
    }

    keep-or-discard(opts: Options) {
        if !(o.kind in events.FAILING) {
            discard(opts)
        }
    }
}

class Attempts {
    count: Int = 0
    flaky: ?Attempt = nil
}

fn retry?(c: TestCase, a: Attempt) -> Bool {
    c.xfail == nil && a.o.kind in events.FAILING
}

fn plural(n: Int, word: String) -> String {
    (n == 1) ? "{n} {word}" : "{n} {word}s"
}

fn effective-timeout(c: TestCase, o: Options) -> ?Float {
    let base = c.meta.timeout
            ?? o.timeout
            ?? (o.worker? ? DEFAULT-WORKER-TIMEOUT : nil)
    let $secs = base or return nil
    c.meta.slow? ? secs * 5.0 : secs
}

class Run {
    opts:     Options
    sink:     EventSink
    seed:     Int
    capture:  ?Capture
    counts:   Dict[String, Int] = %{}
    failed:   Int = 0
    rc:       Int = 0
    fixtures: Resolver = Resolver()
    outcomes: Dict[String, Bool] = %{}

    init(opts: Options, sink: EventSink, seed: Int, capture: ?Capture) {
        self.opts    = opts
        self.sink    = sink
        self.seed    = seed
        self.capture = capture
    }

    count(kind: String) {
        counts[kind] = (counts[kind] ?? 0) + 1
    }

    finish(
        c:      TestCase,
        o:      Outcome,
        dur:    Float = 0.0,
        output: String = '',
        logs:   Array[String] = [],
        tmp:    ?String = nil,
        steps:  Array[Event] = [],
        checks: Array[Event] = []
    ) {
        let kind = o.kind
        let reason = o.reason
        if let $x = c.xfail {
            match kind {
                'fail' or 'timeout' => do {
                    kind = 'xfail'
                    reason = x.reason
                },
                'pass' => do {
                    kind = 'xpass'
                    reason = x.reason
                },
                _ => nil,
            }
        }

        count(kind)

        let failing? = kind in events.FAILING
                    || (kind == 'xpass' && (c.xfail.?strict? ?? true))

        if failing? {
            failed += 1
            rc = 1
        }

        outcomes[c.id] = failing?

        let ev = events.test-end(
            c.id,
            kind,
            dur: dur,
            reason: reason,
            failure: o.failure,
            output: output,
            logs: logs,
            steps: steps,
            checks: checks
        )

        if failing? && tmp != nil {
            ev['tmp_dir'] = tmp
        }

        sink.emit(ev)
    }

    stop?() -> Bool {
        let limit = opts.max-fail ?? (opts.fail-fast? ? 1 : 0)
        limit > 0 && failed >= limit
    }

    run-case(c: TestCase, file-skip: ?String) {
        if let $err = c.error {
            finish(c, Outcome('error', reason: err))
            return
        }

        if let $why = c.meta.todo {
            finish(c, Outcome('todo', reason: why))
            return
        }

        let skip = try {
            static-skip(c, file-skip)
        } catch e {
            let tr = ty.trace()
            let fl = failure-of(e, tr)
            finish(c, Outcome('error', reason: 'skip-if condition threw', failure: fl))
            return
        }

        if let $why = skip {
            finish(c, Outcome('skip', reason: why))
            return
        }

        let n = Attempts()
        let runs = max(1, opts.repeat)
        let a = run-with-retries(c, n)
        let run = 1
        while a.o.kind == 'pass' && run < runs {
            a.discard(opts)
            run += 1
            a = run-with-retries(c, n)
        }
        if a.o.kind != 'pass' && runs > 1 {
            a.o.reason = a.o.reason ?? "failed on run {run} of {runs}"
        }

        if a.o.kind == 'pass' && a.o.result == false {
            sink.emit(events.warning(
                'returned-false',
                'test returned false (ignored; use assert)',
                file: c.file,
                id: c.id,
                line: c.line
            ))
        }

        report(c, a, n)
    }

    report(c: TestCase, a: Attempt, n: Attempts) {
        if let $f = n.flaky and a.o.kind == 'pass' {
            a.discard(opts)
            f.discard(opts)
            let why = "passed after {plural(n.count, 'attempt')}"
            f.o = Outcome('flaky', reason: why, failure: f.o.failure)
            finish-attempt(c, f)
            return
        }
        if let $f = n.flaky {
            f.discard(opts)
        }
        a.keep-or-discard(opts)
        finish-attempt(c, a)
    }

    finish-attempt(c: TestCase, a: Attempt) {
        finish(
            c,
            a.o,
            dur:    a.dur,
            output: a.output,
            logs:   a.logs,
            tmp:    a.tmp,
            steps:  a.steps,
            checks: a.checks
        )
    }

    run-with-retries(c: TestCase, n: Attempts) -> Attempt {
        let limit = c.meta.retries ?? opts.retries
        let a = next-attempt(c, n)
        let tries = 0
        while retry?(c, a) && tries < limit {
            tries += 1
            let b = next-attempt(c, n)
            if b.o.kind == 'pass' && n.flaky == nil {
                n.flaky = a
            } else {
                a.discard(opts)
            }
            a = b
        }
        a
    }

    next-attempt(c: TestCase, n: Attempts) -> Attempt {
        n.count += 1
        run-once(c, n.count)
    }

    run-once(c: TestCase, attempt: Int) -> Attempt {
        let offset = capture.?offset ?? 0
        sink.emit(events.test-start(
            c.id,
            attempt: attempt,
            capture-path: capture.?path,
            capture-offset: offset
        ))

        srand(seed ^ select.fnv1a32(c.id) ^ (attempt - 1))

        let t = Test(c.id, c.name, c.file, c.line, seed, attempt: attempt)
        let secs = effective-timeout(c, opts)

        fixtures.begin-test()
        capture.?begin()
        let t0 = time.now()
        patching.push-scope(t.cleanup)
        core.enter-test(t)
        let o = invoke(c, t, secs, fixtures)
        let after-failure = run-after-each(t)
        let cleanup-failure = run-cleanups(t)
        core.leave-test()
        patching.pop-scope()
        let dur = time.now() - t0
        capture.?end()

        let output = capture.?read(offset) ?? ''
        let steps = step-events(c, t.steps)
        let checks = t.checks.map(|(e, tr)| -> check-failure(e, tr))
        o = with-checks(with-steps(o, steps), checks)

        if let ($why, $fl) = after-failure {
            if o.kind in ['pass', 'skip'] {
                o = Outcome('error', reason: why, failure: fl)
            }
        }

        if let $fl = cleanup-failure {
            if o.kind in ['pass', 'skip'] {
                o = Outcome('error', reason: 'cleanup failed', failure: fl)
            }
        }

        let a = Attempt(o, dur, output, t.logs, t.tmp-path, steps)
        a.checks = checks
        a
    }

    finish-file(file: String) {
        let errors: Array[(String, Event)] = []
        let t = Test("{file}::(after-all)", '(after-all)', file, 0, seed)
        for core.hooks('after-all') {
            try {
                call-hook(it, t)
            } catch e {
                let tr = ty.trace()
                let why = "after-all hook {hook-name(it)} failed"
                errors.push((why, failure-of(e, tr)))
            }
        }
        for (e, tr) in fixtures.teardown-file() {
            let why = 'file-scoped fixture teardown failed'
            errors.push((why, failure-of(e, tr)))
        }
        return if #errors == 0
        let id = "{file}::(teardown)"
        sink.emit(events.test-start(id))
        let why = errors.map(&0).join('; ')
        let fl = errors[0].1
        count('error')
        failed += 1
        rc = 1
        sink.emit(events.test-end(id, 'error', reason: why, failure: fl))
    }
}

fn read-ids(p: ?String) -> ?Array[String] {
    let $file = p or return nil
    let text = slurp(file) ?? ''
    text.split('\n').filter(\_ != '')
}

fn select-cases(col: Collection, o: Options) -> Array[TestCase] | String {
    let cases = col.cases

    if #o.ids > 0 {
        cases = cases.filter(c -> o.ids.any?(p -> select.id-matches?(p, c.local)))
    }

    if let $n = o.line {
        let hits = cases.filter(c -> c.line <= n && n <= c.end-line)
        if #hits == 0 {
            let nearest = cases.min(c -> (c.line - n).abs)
            let hint = match nearest {
                nil => 'the file has no tests',
                c   => "nearest: {c.local} (line {c.line})",
            }
            return "no test at {col.file}:{n}; {hint}"
        }
        cases = hits
    }

    if #o.filters > 0 {
        cases = cases.filter(c -> o.filters.any?(p -> select.pattern-matches?(p, c.id)))
    }

    if #o.excludes > 0 {
        cases = cases.filter(c -> !o.excludes.any?(p -> select.pattern-matches?(p, c.id)))
    }

    if let $src = o.tags {
        let e = select.parse-tags(src)
        cases = cases.filter(c -> e.matches?(c.tags))
    }

    if let $keep = read-ids(o.select-file) {
        cases = cases.filter(c -> c.id in keep)
    }

    if let $skip = read-ids(o.skip-ids) {
        cases = cases.filter(c -> !(c.id in skip))
    }

    let only = cases.filter(&.only?)
    if #only > 0 {
        if o.forbid-only? {
            for only {
                it.error = it.error ?? '@only is forbidden here (--forbid-only, or CI is set)'
            }
        } else {
            cases = only
        }
    }

    cases
}

fn xfail-event(c: TestCase) -> ?Event {
    let $x = c.xfail or return nil
    events.xfail-info(x.reason, strict?: x.strict?)
}

fn collect-event(col: Collection, cases: Array[TestCase], file-skip: ?String) -> Event {
    let tests = cases.map(c -> events.collect-test(
        c.id,
        c.local,
        c.line,
        end-line: c.end-line,
        tags: c.tags,
        skip: c.meta.skip,
        xfail: xfail-event(c),
        todo: c.meta.todo,
        only?: c.only?,
        timeout: c.meta.timeout
    ))
    let warnings = col.warnings.map(w -> events.collect-warning(w.code, w.message, line: w.line))
    events.collect(col.file, tests: tests, file-skip: file-skip, warnings: warnings)
}

fn list-cases(cases: Array[TestCase], ev: Event, o: Options) {
    match o.list {
        'json' => print(json.encode(ev['tests'])),
        _      => for cases { print(it.id) },
    }
}

fn make-sink(o: Options, file-mode?: Bool) -> EventSink {
    let sink = match o.events {
        nil => EventSink(),
        p   => EventSink.to-file(p),
    }
    if o.worker? || o.list != nil {
        return sink
    }
    let specs = (#o.reporters > 0) ? o.reporters : ['pretty']
    for specs {
        sink.add(report.make(
            it,
            mode: 'file',
            quiet?: o.quiet?,
            slowest: o.durations
        ))
    }
    sink
}

fn seed-of(o: Options) -> Int {
    if let $s = o.seed {
        return s
    }
    match getenv('TY_TEST_SEED') {
        $s :: s.match?(/^\d+$/) => int(s),
        _                       => rand(1, 1 << 30),
    }
}

fn target-file() -> ?String {
    match argv {
        [f, *] => f,
        _      => nil,
    }
}

pub fn run(argv: Array[String]) -> Int {
    let o = try {
        args.parse(argv)
    } catch e: UsageError {
        eprint("ty --test: {e.what}")
        return 2
    }

    if o.help? {
        print(USAGE)
        return 0
    }

    let $file = target-file() or do {
        eprint('ty --test: no test file')
        return 2
    }

    let col = registry.collect(file, static?: o.static?)
    let file-skip = core.file-skip-reason()

    let picked = try {
        select-cases(col, o)
    } catch e: select.TagError {
        eprint("ty --test: {e.what}")
        return 2
    }

    let cases = match picked {
        msg: String => do {
            eprint("ty --test: {msg}")
            return 5
        },
        cs => cs,
    }

    let seed = seed-of(o)

    if o.shuffle? {
        cases = select.shuffled(cases, seed)
    }

    let remember? = !o.worker? && o.list == nil && cache.claim()
    let lf? = o.last-failed? || o.failed-first? || remember?
    let previous = lf? ? cache.load-last-failed() : %{}
    let earlier = cache.failed-in(previous, col.file)

    if o.last-failed? && #earlier > 0 {
        cases = cases.filter(c -> c.id in earlier)
    } else if o.last-failed? {
        eprint('ty --test: no earlier failures in this file; running everything')
    }

    if o.failed-first? {
        let (first, rest) = cases.partition(c -> c.id in earlier)
        cases = [*first, *rest]
    }

    let filtered? = #o.ids > 0
                 || #o.filters > 0
                 || #o.excludes > 0
                 || o.tags != nil
                 || o.line != nil

    let cev = collect-event(col, cases, file-skip)

    if o.list != nil {
        if let $p = o.events {
            let sink = EventSink.to-file(p)
            sink.emit(cev)
            sink.done()
        }
        list-cases(cases, cev, o)
        return 0
    }

    let sink = make-sink(o, !o.worker?)
    let t0 = time.now()
    let cpu0 = cpu-time()

    if !o.worker? {
        sink.emit(events.run-start(seed, argv: [file, *argv], root: os.getcwd(), mode: 'file'))
    }

    sink.emit(cev)

    let capture = match (o.no-capture?, o.capture) {
        (true, _) => nil,
        (_, nil)  => Capture.temp(),
        (_, $p)   => Capture(p),
    }

    let old-handler = os.signal(os.SIGALRM)
    os.signal(os.SIGALRM, on-alarm)

    let r = Run(o, sink, seed, capture)

    try {
        for cases {
            break if r.stop?()
            r.run-case(it, file-skip)
        }
        capture.?begin()
        r.finish-file(col.file)
        capture.?end()
    } catch e {
        capture.?end()
        throw e
    }

    os.signal(os.SIGALRM, old-handler)
    capture.?close()

    if #col.cases == 0 && file-skip == nil {
        let ev = events.warning('empty-file', 'no tests found', file: col.file)
        sink.emit(ev)
        if o.strict? {
            r.rc = 1
        }
    }

    if #cases == 0 && filtered? && #col.cases > 0 && r.rc == 0 {
        eprint('ty --test: no tests matched the selection')
        r.rc = 5
    }

    sink.emit(events.file-end(col.file, r.rc, r.counts))

    if remember? {
        let ids = previous
        ids.remove(col.file)
        for id, bad? in r.outcomes {
            if bad? {
                ids[id] = col.file
            } else {
                ids.remove(id)
            }
        }
        cache.save-last-failed(ids)
    }

    if !o.worker? {
        let files = %{'total': 1, 'failed': (r.failed > 0) ? 1 : 0, 'skipped': 0, 'empty': 0}
        sink.emit(events.run-end(
            r.counts,
            files: files,
            dur: time.now() - t0,
            cpu: %{'user': cpu-time() - cpu0},
            rc: r.rc
        ))
    }

    sink.done()

    r.rc
}
