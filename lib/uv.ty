pub class UVError < RuntimeError {
    init(ctx: String, err: Int) {
        super("{ctx}: {c.str(uv_strerror(err))}")
    }
}

pub class TimeoutError < RuntimeError {
    init() {
        super('Operation timed out')
    }
}

pub class CanceledError < RuntimeError {
    init() {
        super('Operation was canceled')
    }
}

tag Running;

fn fileno(hnd) {
    let fd = static!(c.box(c.int))
    let err = uv_fileno(hnd, fd)
    (err == 0) ? fd[0] : -1
}

let __tls::thread-tasks: ?Set[Generator[_, _]] = nil

fn live-tasks() -> Set[Generator[_, _]] {
    thread-tasks ?? (thread-tasks = Set())
}

let __tls::thread-failure: ?Some[_] = nil

fn fail(e: _) {
    thread-failure ?= Some(e)
    stop()
}

fn _spawn*(func: _, args: _, kwargs: _) {
    let me = co.this()
    live-tasks().insert(me)
    try {
        func(*args, **kwargs)
    } catch _: CanceledError {
    } catch e {
        fail(e)
    } finally {
        live-tasks().remove(me)
    }
}

pub fn spawn(func: _, *args: _, %kwargs: _) -> Generator[_, _] {
    let task = _spawn(func, args, kwargs)
    task()
    task
}

fn nop() {}

pub fn cancel(task: Generator[_, _]) {
    if live-tasks().contains?(task) {
        task.raise(CanceledError())
    }
}

fn suspend(cleanup: _) {
    let resumed? = false
    try {
        let val = yield Running
        resumed? = true
        return val
    } finally {
        if !resumed? {
            cleanup()
        }
    }
}

fn reap() {
    let me = co.this()
    for task in live-tasks().to-array() if task != me {
        task.close()
    }
}

pub class UVHandle {
    __loop: UV
    __hnd:  Ptr

    init(loop: UV, hnd: Ptr) {
        __loop = loop
        __hnd  = hnd
    }

    handle -> Ptr {
        __hnd
    }

    loop -> UV {
        __loop
    }

    fileno -> Int {
        let fd = c.auto(c.box(c.int))
        let err = uv_fileno(handle, fd)
        (err == 0) ? fd[0] : -1
    }

    close() {
        __loop.close(self)
    }
}

pub class UVTimer < UVHandle {
    __fire_cb: (() -> _) | nil


    on-fire=(cb: () -> _) {
        __fire_cb = cb
    }

    on-fire {
        __fire_cb
    }

    start(msecs: Int, repeat: Int = 0) {
        loop.timer-start(self, msecs, repeat)
    }

    stop() {
        loop.timer-stop(self)
    }

    again() {
        let err = uv_timer_again(handle)
        if err != 0 {
            throw UVError('uv_timer_again()', err)
        }
    }
}

pub class UVStream < UVHandle {
    __read_cb:  (String -> _) | nil
    __eof_cb:   (()     -> _) | nil
    __close_cb: (()     -> _) | nil

    on-read=(cb: (String -> _) | nil) {
        if cb == nil {
            loop.read-stop(self)
            __read_cb = nil
        } else {
            __read_cb = cb
            loop.read-start(self)
        }
    }

    on-eof=(cb: (() -> _) | nil) {
        __eof_cb = cb
    }

    on-close=(cb: (() -> _) | nil) {
        __close_cb = cb
    }

    on-read {
        __read_cb
    }

    on-eof {
        __eof_cb
    }

    on-close {
        __close_cb
    }

    __inbox: Blob = Blob()
    __eof?:  Bool = false

    eof? -> Bool {
        __eof? && #__inbox == 0
    }

    __fill(enough?: Blob -> Bool) {
        if __eof? || enough?(__inbox) {
            return
        }

        let resume = co.this()

        fn cleanup() {
            self.on-read = nil
            self.on-eof  = nil
        }

        self.on-eof  = fn () {
            __eof? = true
            cleanup()
            resume()
        }
        self.on-read = fn (data) {
            __inbox.push(data)
            if enough?(__inbox) {
                cleanup()
                resume()
            }
        }

        suspend(cleanup)
    }

    __take(n: Int) -> String {
        __inbox.splice(0, min(n, #__inbox)).str!()
    }

    read(n: Int) -> String {
        __fill(b -> #b >= n)
        __take(n)
    }

    read-line() -> String | nil {
        __fill(b -> b.search('\n') != nil)
        match (__inbox.search('\n'), #__inbox) {
            (nil,    0) => nil,
            (nil,    n) => __take(n),
            (i: Int, _) => __take(i + 1),
        }
    }

    lines() -> UVLines {
        UVLines(self)
    }

    read-all() -> String {
        __fill(_ -> false)
        __take(#__inbox)
    }

    write(data: String | Blob) {
        loop.write(self, data)
    }

    shutdown() {
        loop.shutdown(self)
    }
}

pub class UVLines : Iter[String] {
    __stream: UVStream

    init(stream: UVStream) {
        __stream = stream
    }

    __next__() -> Some[String] | None {
        match __stream.read-line() {
            $line => Some(line),
            nil   => None,
        }
    }
}

pub class UVSocket < UVStream {
    __address: Blob | nil
    __connection_cb: (UVSocket -> _) | nil

    connect(addr: Blob) {
        loop.connect(self, addr)
        __address = nil
    }

    bind(addr: Blob, flags: Int = 0) {
        loop.bind(self, addr, flags)
        __address = nil
    }

    listen(backlog: Int = 512) {
        loop.listen(self, backlog)
    }

    accept() -> UVSocket {
        loop.accept(self)
    }

    address -> Blob {
        if __address == nil {
            let addr = c.auto(c.alloc(128))
            let len = c.auto(c.box(c.int, 128))
            let err = uv_tcp_getsockname(handle, addr, len)
            if err != 0 {
                throw UVError('uv_tcp_getsockname()', err)
            }
            __address = Blob(c.as_str(addr, len[0]))
        }
        __address
    }

    name -> String | nil {
        if let $addr = address {
            let (host, serv) = os.getnameinfo(addr, os.NI_NUMERICHOST | os.NI_NUMERICSERV)
            "{host}:{serv}"
        }
    }

    on-connection=(cb: (UVSocket -> _) | nil) {
        __connection_cb = cb
    }

    on-connection {
        __connection_cb
    }
}

pub class UVPipe < UVStream {
}

pub class UVFSEvent < UVHandle {
    __event_cb: _

    on-event=(cb) { __event_cb = cb }
    on-event { __event_cb }

    start(p: String, flags: Int = 0) {
        loop.fs-event-start(self, p, flags)
    }

    stop() {
        loop.fs-event-stop(self)
    }
}

pub class SockAddr {
    family:   Int
    socktype: Int
    protocol: Int
    addr:     Blob

    init(family: Int, socktype: Int, protocol: Int, addr: Blob) {
        self.family   = family
        self.socktype = socktype
        self.protocol = protocol
        self.addr     = addr
    }

    addr-string -> String {
        let (host, serv) = os.getnameinfo(addr, os.NI_NUMERICHOST | os.NI_NUMERICSERV)
        "{host}:{serv}"
    }
}

pub class UV {
    __loop:          Ptr
    __reading:       Dict[Ptr, UVStream]
    __listening:     Dict[Ptr, UVSocket]
    __ticking:       Dict[Ptr, UVTimer]
    __watching:      Dict[Ptr, UVFSEvent]
    __pending:       Dict[Ptr, _]
    __on_close:      Ptr
    __on_connect:    Ptr
    __on_connection: Ptr
    __on_fs:         Ptr
    __on_fs_event:   Ptr
    __on_gai:        Ptr
    __on_read:       Ptr
    __on_shutdown:   Ptr
    __on_timer:      Ptr
    __on_write:      Ptr
    __alloc_cb:      Ptr
    __free_reqs:     DefaultDict[Int, Array[Ptr]]
    __free_hnds:     DefaultDict[Int, Array[Ptr]]

    init(loop: Ptr | nil = nil) {
        C! closure alloc_cb(
            handle: c.ptr,
            suggested_size: size_t,
            buf: c.ptr
        ) {
            let buf = uv_buf_t(buf)
            buf.base = c.realloc(buf.base, suggested_size)
            buf.len  = suggested_size
        }

        C! closure on_gai(req: c.ptr, status: c.int, res: c.ptr) {
            let $cb = __pending.remove(req) or return

            if status != 0 {
                cb(Err(status))
            } else {
                let addrs = []
                let ptr = res
                while ptr != nil {
                    let ai = addrinfo(ptr)
                    addrs.push(
                        SockAddr(
                            family=ai.ai_family,
                            socktype=ai.ai_socktype,
                            protocol=ai.ai_protocol,
                            addr=Blob(c.as_str(ai.ai_addr, ai.ai_addrlen))
                        )
                    )
                    ptr = ai.ai_next
                }
                uv_freeaddrinfo(res)
                cb(Ok(addrs))
            }
        }

        C! closure on_timer(handle: c.ptr) {
            let $timer = __ticking[handle] or return
            timer.on-fire()
        }

        C! closure on_connect(req: c.ptr, status: c.int) {
            let $cb = __pending.remove(req) or return
            if status != 0 {
                cb(Err(status))
            } else {
                cb(Ok(()))
            }
        }

        C! closure on_connection(server: c.ptr, status: c.int) {
            let sock = __listening[server]!
            if status == 0 {
                spawn(sock.on-connection, sock)
            } else {
                fail(UVError('on_connection', status))
            }
        }

        C! closure on_shutdown(
            req: c.ptr,
            status: c.int
        ) {
            let $cb = __pending.remove(req) or return
            if status != 0 {
                cb(Err(status))
            } else {
                cb(Ok(()))
            }
        }

        C! closure on_close(hnd: c.ptr) {
            __reading.remove(hnd)
            __listening.remove(hnd)
            __watching.remove(hnd)
            __ticking.remove(hnd)
            _free-hnd(hnd)
        }

        C! closure on_read(
            handle: c.ptr,
            nread: ssize_t,
            buf: c.ptr
        ) {
            let stream = __reading[handle]!
            let buf    = uv_buf_t(buf)

            let data = (nread > 0) ? c.str(buf.base, nread) : nil
            c.free(buf.base)
            if nread < 0 {
                let err = uv_read_stop(handle)
                if err != 0 {
                    fail(UVError('uv_read_stop()', err))
                }
                __reading.remove(handle)
                if let $cb = stream.on-eof {
                    spawn(cb)
                }
            } else if data != nil {
                spawn(stream.on-read, data)
            }
        }

        C! closure on_write(
            req: c.ptr,
            status: c.int
        ) {
            let $cb = __pending.remove(req) or return
            if status != 0 {
                cb(Err(status))
            } else {
                cb(Ok(()))
            }
        }

        C! closure on_fs(req: c.ptr) {
            let $cb = __pending.remove(req) or return
            let res = uv_fs_get_result(req)
            if res < 0 {
                cb(Err(res))
            } else {
                cb(Ok(res))
            }
        }

        C! closure on_fs_event(
            handle: c.ptr,
            filename: c.ptr,
            events: c.int,
            status: c.int
        ) {
            return if status < 0
            let watcher = __watching[handle]!
            if let $cb = watcher.on-event {
                let name = (filename != nil) ? c.str(filename) : nil
                cb(name, events)
            }
        }

        __alloc_cb  = alloc_cb

        __on_close      = on_close
        __on_connect    = on_connect
        __on_connection = on_connection
        __on_fs         = on_fs
        __on_fs_event   = on_fs_event
        __on_gai        = on_gai
        __on_read       = on_read
        __on_shutdown   = on_shutdown
        __on_timer      = on_timer
        __on_write      = on_write

        __loop = match loop {
            $loop => loop,

            _ => do {
                let loop = c.alloc(uv_loop_size())
                let err = uv_loop_init(loop)
                if err != 0 {
                    throw UVError('uv_loop_init()', err)
                }
                loop
            }
        }

        __free_reqs = %{*: []}
        __free_hnds = %{*: []}

        __pending   = %{}
        __reading   = %{}
        __listening = %{}
        __ticking   = %{}
        __watching  = %{}
    }

    _req(type: Int) -> Ptr {
        if let Some(free) = __free_reqs[type].try-pop() {
            free
        } else {
            c.alloc(uv_req_size(type))
        }
    }

    _free-req(req: Ptr) {
        __free_reqs[uv_req_get_type(req)].push(req)
    }

    _hnd(type: Int) -> Ptr {
        if let Some(free) = __free_hnds[type].try-pop() {
            free
        } else {
            c.alloc(uv_handle_size(type))
        }
    }

    _free-hnd(hnd: Ptr) {
        __free_hnds[uv_handle_get_type(hnd)].push(hnd)
    }

    close(handle: UVHandle) {
        let hnd = handle.handle
        if !uv_is_closing(hnd) {
            uv_close(hnd, __on_close)
        }
    }

    _await(req: Ptr, release: () -> _, start: () -> Int, finish: _ = id) -> _ {
        __pending[req] = co.this()
        let err = start()
        let res = Err(err)
        if err == 0 {
            let settled? = false
            try {
                res = yield Running
                settled? = true
            } finally {
                if !settled? {
                    __pending[req] = (_ -> release())
                    uv_cancel(req)
                }
            }
        } else {
            __pending.remove(req)
        }
        defer release()
        finish(res)
    }

    _ok(what: String, finish: _ = id) -> _ {
        return match {
            Ok(x)  => finish(x),
            Err(e) => throw UVError(what, e),
        }
    }

    _fs(what: String, start: Ptr -> Int, finish: Int -> _ = id, *bufs: Ptr) -> _ {
        let req = _req(UV_FS)
        _await(
            req,
            fn () {
                uv_fs_req_cleanup(req)
                _free-req(req)
                for bufs {
                    c.free(it)
                }
            },
            -> start(req),
            _ok(what, finish)
        )
    }

    shutdown(stream: UVStream) {
        let req = _req(UV_SHUTDOWN)
        _await(
            req,
            -> _free-req(req),
            -> uv_shutdown(req, stream.handle, __on_shutdown),
            _ok('uv_shutdown()')
        )
    }

    tcp-socket() {
        let hnd = _hnd(UV_TCP)
        let err = uv_tcp_init(__loop, hnd)
        if err != 0 {
            _free-hnd(hnd)
            throw UVError('uv_tcp_init()', err)
        }
        uv_tcp_simultaneous_accepts(hnd, 0)
        UVSocket(self, hnd)
    }

    connect(sock: UVSocket, addr: Blob) {
        let req = _req(UV_CONNECT)
        _await(
            req,
            -> _free-req(req),
            -> uv_tcp_connect(req, sock.handle, addr, __on_connect),
            _ok('uv_tcp_connect()')
        )
    }

    bind(sock: UVSocket, addr: Blob, flags: Int = 0) {
        let err = uv_tcp_bind(sock.handle, addr, flags)
        if err != 0 {
            throw UVError('uv_tcp_bind()', err)
        }
    }

    listen(sock: UVSocket, backlog: Int = 128) {
        let err = uv_listen(sock.handle, backlog, __on_connection)
        if err != 0 {
            throw UVError('uv_listen()', err)
        }
        __listening[sock.handle] = sock
    }

    accept(server: UVSocket) -> UVSocket {
        let client-hnd = _hnd(UV_TCP)
        let err = uv_tcp_init(__loop, client-hnd)
        if err != 0 {
            _free-hnd(client-hnd)
            throw UVError('uv_tcp_init()', err)
        }
        err = uv_accept(server.handle, client-hnd)
        if err != 0 {
            uv_close(client-hnd, nil)
            _free-hnd(client-hnd)
            throw UVError('uv_accept()', err)
        }
        UVSocket(self, client-hnd)
    }

    fs-open(path: Any, flags: Int = os.O_RDONLY, mode: Int = 0) -> Int {
        _fs('uv_fs_open()', uv_fs_open@(__loop, _, "{path}".cstr(), flags, mode, __on_fs))
    }

    fs-close(file: Int) {
        let req = _req(UV_FS)
        let err = uv_fs_close(__loop, req, file, nil)
        uv_fs_req_cleanup(req)
        _free-req(req)
        if err < 0 {
            throw UVError('uv_fs_close()', err)
        }
    }

    fs-read(file: Int, n: Int, off: Int = 0) -> String | nil {
        let data = c.alloc(n)
        let buf  = uv_buf_init(data, n)
        _fs(
            'uv_fs_read()',
            uv_fs_read@(__loop, _, file, buf, 1, off, __on_fs),
            nread -> (nread > 0) ?: c.str(data, nread),
            buf,
            data
        )
    }

    fs-write(file: Int, data: String | Blob, off: Int = -1) -> Int {
        let n    = data.size()
        let copy = c.memcpy(c.alloc(n), data, n)
        let buf  = uv_buf_init(copy, n)
        _fs('uv_fs_write()', uv_fs_write@(__loop, _, file, buf, 1, off, __on_fs), id, buf, copy)
    }

    fs-unlink(path: Any) {
        _fs('uv_fs_unlink()', uv_fs_unlink@(__loop, _, "{path}".cstr(), __on_fs))
    }

    fs-rename(from: Any, to: Any) {
        _fs('uv_fs_rename()', uv_fs_rename@(__loop, _, "{from}".cstr(), "{to}".cstr(), __on_fs))
    }

    pipe(fd: Int) -> UVPipe {
        let hnd = _hnd(UV_NAMED_PIPE)
        let err = uv_pipe_init(__loop, hnd, 0)
        if err != 0 {
            _free-hnd(hnd)
            throw UVError('uv_pipe_init()', err)
        }
        let pipe = UVPipe(self, hnd)
        err = uv_pipe_open(hnd, fd)
        if err != 0 {
            pipe.close()
            throw UVError('uv_pipe_open()', err)
        }
        pipe
    }

    timer() -> UVTimer {
        let hnd = _hnd(UV_TIMER)
        let err = uv_timer_init(__loop, hnd)
        if err != 0 {
            _free-hnd(hnd)
            throw UVError('uv_timer_init()', err)
        }
        UVTimer(self, hnd)
    }

    timer-start(timer: UVTimer, msecs: Int, repeat: Int = 0) {
        __ticking[timer.handle] = timer
        let err = uv_timer_start(timer.handle, __on_timer, msecs, repeat)
        if err != 0 {
            __ticking.remove(timer.handle)
            throw UVError('uv_timer_start()', err)
        }
    }

    timer-stop(timer: UVTimer) {
        let err = uv_timer_stop(timer.handle)
        if err != 0 {
            throw UVError('uv_timer_stop()', err)
        }
        __ticking.remove(timer.handle)
    }

    timer-again(timer: UVTimer) {
        __ticking[timer.handle] = timer
        let err = uv_timer_again(timer.handle)
        if err != 0 {
            __ticking.remove(timer.handle)
            throw UVError('uv_timer_again()', err)
        }
    }

    sleep(msecs: Int) {
        let timer = timer()
        defer {
            timer.close()
        }
        let resume = co.this()
        let fired = false
        timer.on-fire = fn () {
            fired = true
            timer.stop()
            resume()
        }
        timer.start(msecs)
        while !fired {
            suspend(nop)
        }
    }

    fs-event() -> UVFSEvent {
        let hnd = _hnd(UV_FS_EVENT)
        let err = uv_fs_event_init(__loop, hnd)
        if err != 0 {
            _free-hnd(hnd)
            throw UVError('uv_fs_event_init()', err)
        }
        UVFSEvent(self, hnd)
    }

    fs-event-start(watcher: UVFSEvent, p: String, flags: Int = 0) {
        __watching[watcher.handle] = watcher
        let err = uv_fs_event_start(watcher.handle, __on_fs_event, p.cstr(), flags)
        if err != 0 {
            __watching.remove(watcher.handle)
            throw UVError('uv_fs_event_start()', err)
        }
    }

    fs-event-stop(watcher: UVFSEvent) {
        let err = uv_fs_event_stop(watcher.handle)
        if err != 0 {
            throw UVError('uv_fs_event_stop()', err)
        }
        __watching.remove(watcher.handle)
    }

    getaddrinfo(
        host: String,
        service: Int | String,
        family: Int = 0,
        socktype: Int = 0,
        protocol: Int = 0
    ) -> Ok[Array[SockAddr]] | Err[Int] {
        let req = _req(UV_GETADDRINFO)
        let hints = addrinfo(
            ai_family=family,
            ai_socktype=socktype,
            ai_protocol=protocol
        )
        defer c.free(hints)
        _await(
            req,
            -> _free-req(req),
            -> uv_getaddrinfo(__loop, req, __on_gai, host.cstr(), "{service}".cstr(), hints)
        )
    }

    read-start(stream: UVStream) {
        __reading[stream.handle] = stream
        let err = uv_read_start(
            stream.handle,
            __alloc_cb,
            __on_read
        )
        if err != 0 {
            __reading.remove(stream.handle)
            throw UVError('uv_read_start()', err)
        }
    }

    read-stop(stream: UVStream) {
        let err = uv_read_stop(stream.handle)
        if err != 0 {
            throw UVError('uv_read_stop()', err)
        }
        __reading.remove(stream.handle)
    }

    write(
        stream: UVStream,
        data: String | Blob
    ) {
        let req  = _req(UV_WRITE)
        let n    = data.size()
        let copy = c.memcpy(c.alloc(n), data, n)
        let buf  = uv_buf_init(copy, n)
        _await(
            req,
            fn () {
                c.free(buf)
                c.free(copy)
                _free-req(req)
            },
            -> uv_write(req, stream.handle, buf, 1, __on_write),
            _ok('uv_write()')
        )
    }

    now() -> Int {
        uv_now(__loop)
    }

    stop() {
        uv_stop(__loop)
    }

    run() {
        uv_run(__loop, UV_RUN_DEFAULT)
    }

    run-once() -> Bool {
        uv_run(__loop, UV_RUN_ONCE) != 0
    }

    run-nowait() -> Bool {
        uv_run(__loop, UV_RUN_NOWAIT) != 0
    }

    metrics() {
        let metrics = uv_metrics_t()
        uv_metrics_info(__loop, metrics)
        return {
            loop_count: metrics.loop_count,
            events: metrics.events,
            events_waiting: metrics.events_waiting
        }
    }

    handles() -> Dict[String, Int] {
        let counts = %{*: 0}

        C! closure tally(hnd: c.ptr, arg: c.ptr) {
            if !uv_is_closing(hnd) {
                counts[c.str(uv_handle_type_name(uv_handle_get_type(hnd)))] += 1
            }
        }

        uv_walk(__loop, tally, nil)

        c.free-closure(tally)

        counts
    }

    pending -> Int {
        #__pending
    }

    debug() {
        pp({
            counts: handles(),
            reading: #__reading,
            listening: #__listening,
            ticking: #__ticking,
            pending: #__pending,
            now: now(),
            metrics: metrics()
        })
    }
}

let __tls::thread-loop: ?UV = nil

pub fn loop() {
    thread-loop ?? (thread-loop = UV())
}

pub fn now() {
    loop().now()
}

pub fn getrusage() -> os.RUsage {
    let ru = uv_rusage_t()
    uv_getrusage(ru)
    return {
        utime:    ru.ru_utime_sec + ru.ru_utime_usec / 1.0e6,
        stime:    ru.ru_stime_sec + ru.ru_stime_usec / 1.0e6,
        maxrss:   ru.ru_maxrss,
        ixrss:    ru.ru_ixrss,
        idrss:    ru.ru_idrss,
        isrss:    ru.ru_isrss,
        minflt:   ru.ru_minflt,
        majflt:   ru.ru_majflt,
        nswap:    ru.ru_nswap,
        inblock:  ru.ru_inblock,
        oublock:  ru.ru_oublock,
        msgsnd:   ru.ru_msgsnd,
        msgrcv:   ru.ru_msgrcv,
        nsignals: ru.ru_nsignals,
        nvcsw:    ru.ru_nvcsw,
        nivcsw:   ru.ru_nivcsw
    }
}

pub fn run(func: _) {
    let lp = loop()

    if func == nil {
        return lp.run()
    }

    thread-failure = nil

    try {
        spawn(func)
        lp.run()
    } finally {
        reap()
        lp.run-nowait()
    }

    if let Some(e) = thread-failure {
        thread-failure = nil
        throw e
    }
}

pub fn stop() {
    loop().stop()
}

pub fn getaddrinfo(
    host: String,
    service: Int | String,
    family: Int = 0,
    socktype: Int = 0,
    protocol: Int = 0
) -> Ok[Array[SockAddr]] | Err[Int] {
    loop().getaddrinfo(host, service, family, socktype, protocol)
}

pub fn race(fns: _, stagger: Int = 0) {
    if #fns == 0 { throw RuntimeError('race: empty') }
    if #fns == 1 { return fns[0]()                   }

    let lp         = loop()
    let resume     = co.this()
    let winner     = nil
    let winner-idx = -1
    let last-err   = nil
    let coros      = []
    let pending    = 0
    let next-idx   = 0
    let settled?   = false
    let awaiting?  = false
    let timer      = lp.timer()

    fn settle() {
        if !settled? && (winner != nil || (pending == 0 && next-idx >= #fns)) {
            settled? = true
            if awaiting? {
                resume()
            }
        }
    }

    fn launch-next() {
        if next-idx < #fns && winner == nil {
            let f = fns[next-idx++]
            let my-idx = #coros
            let coro = generator {
                pending += 1
                try {
                    let val = f()
                    if winner == nil {
                        winner = val
                        winner-idx = my-idx
                    }
                } catch e {
                    last-err = e
                    launch-next()
                }
                pending -= 1
                settle()
            }
            coros.push(coro)
            coro()
            if next-idx < #fns {
                timer.start(stagger)
            } else {
                timer.stop()
            }
        }
    }

    timer.on-fire = fn () { launch-next() }
    launch-next()

    fn cleanup() {
        timer.stop()
        timer.close()
        for coros {
            it.close()
        }
    }

    if !settled? {
        awaiting? = true
        suspend(cleanup)
    }

    timer.stop()
    timer.close()

    for coro; i in coros if i != winner-idx {
        coro.close()
    }

    if let $val = winner {
        return val
    }

    throw last-err ?? RuntimeError('race: all attempts failed')
}

pub fn gather(fns: _) -> Array {
    let resume   = co.this()
    let results  = fns.map(_ -> nil)
    let done     = fns.map(_ -> false)
    let left     = #fns
    let failure  = None
    let waiting? = false
    let tasks    = []

    fn finish(i: Int) {
        done[i] = true
        left   -= 1
        if waiting? && (left == 0 || failure != None) {
            waiting? = false
            resume()
        }
    }

    fn stragglers() {
        waiting? = false
        for task; i in tasks if !done[i] {
            task.close()
        }
    }

    for f; i in fns {
        tasks.push(spawn(fn () {
            try {
                results[i] = f()
            } catch e {
                if failure == None {
                    failure = Some(e)
                }
            } finally {
                finish(i)
            }
        }))
    }

    if left > 0 && failure == None {
        waiting? = true
        suspend(stragglers)
    }

    stragglers()

    if let Some(e) = failure {
        throw e
    }

    results
}

fn interleave-families(addrs) {
    let v6 = []
    let v4 = []

    for addrs {
        if it.family == os.AF_INET6 {
            v6.push(it)
        } else {
            v4.push(it)
        }
    }

    let result = []
    let i = 0
    let j = 0

    while i < #v6 || j < #v4 {
        if i < #v6 { result.push(v6[i]); i += 1 }
        if j < #v4 { result.push(v4[j]); j += 1 }
    }

    result
}

pub fn dial(
    host: String,
    service: Int | String,
    family: Int = os.AF_UNSPEC,
    stagger: Int = 250
) -> UVSocket {
    let addrs = match loop().getaddrinfo(host, service, family, os.SOCK_STREAM) {
        Ok(addrs) => interleave-families(addrs),
        Err(e)    => throw UVError('getaddrinfo()', e)
    }

    if #addrs == 0 {
        throw RuntimeError('dial: no addresses resolved')
    }

    race(addrs.map(addr -> fn () {
        let sock      = loop().tcp-socket()
        let connected? = false
        try {
            sock.connect(addr.addr)
            connected? = true
            sock
        } finally {
            if !connected? {
                sock.close()
            }
        }
    }), stagger)
}

pub fn server(
    addr: String,
    port: Int | String,
    family: Int = os.AF_UNSPEC
) -> UVSocket {
    let addr = match loop().getaddrinfo(addr, port, family, os.SOCK_STREAM) {
        Ok([addr, *]) => addr.addr,
        Err(e)        => throw UVError('getaddrinfo()', e)
    }
    let sock = loop().tcp-socket()
    try {
        sock.bind(addr)
        sock
    } catch e: UVError {
        sock.close()
        throw e
    }
}

pub fn server(port: Int | String) -> UVSocket {
    server('0.0.0.0', port)
}

pub fn socket() -> UVSocket {
    loop().tcp-socket()
}

pub fn sleep(msecs: Int) {
    loop().sleep(msecs)
}

pub fn write(stream: UVStream, data: String | Blob) {
    loop().write(stream, data)
}

pub fn open(path: Any, flags: Int = os.O_RDONLY, mode: Int = 0) -> Int {
    loop().fs-open(path, flags, mode)
}

pub fn read(file: Int, n: Int, off: Int = 0) -> String | nil {
    loop().fs-read(file, n, off)
}

pub fn close(file: Int) {
    loop().fs-close(file)
}

pub fn write(file: Int, data: String | Blob, off: Int = -1) -> Int {
    loop().fs-write(file, data, off)
}

pub fn unlink(path: Any) {
    loop().fs-unlink(path)
}

pub fn rename(from: Any, to: Any) {
    loop().fs-rename(from, to)
}

pub fn pipe(fd: Int) -> UVPipe {
    loop().pipe(fd)
}

pub fn slurp(file: Int) -> String {
    let buf = Blob()
    let off = 0

    while let $chunk = read(file, 4096, off) {
        buf.push(chunk)
        off += #chunk
    }

    buf.str!()
}

pub fn slurp(path: Any) -> String {
    let fd = open(path, os.O_RDONLY)
    defer close(fd)
    slurp(fd)
}

pub fn spit(path: Any, data: String | Blob) {
    let fd = open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    defer close(fd)
    let blob = Blob(data)
    let off  = 0
    while off < #blob {
        off += write(fd, blob.slice(off), off)
    }
}

pub class UVDeadline {
    __msec:  Int
    __timer: UVTimer | nil

    init(msec: Int) {
        __msec  = msec
        __timer = nil
    }

    __enter__() {
        let task  = co.this() ?? throw RuntimeError('uv.timeout() used outside of a task')
        let timer = loop().timer()

        timer.on-fire = fn () {
            timer.stop()
            task.raise(TimeoutError())
        }

        timer.start(__msec)
        __timer = timer

        self
    }

    __drop__() {
        let $timer = __timer or return
        __timer = nil
        timer.stop()
        timer.close()
    }
}

pub fn timeout(msec: Int) {
    UVDeadline(msec)
}
