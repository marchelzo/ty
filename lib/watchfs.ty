import path (Path)
import os

#|if __linux__
import inotify
#|else
import kqueue
#|]

pub tag Create;
pub tag Delete;
pub tag Modify;
pub tag Attrib;

#|if __linux__

pub class Watcher {
    __ino: inotify.Inotify
    __dir: Path
    __recursive: Bool
    __wd-to-dir: Dict[Int, Path]
    __closed: Bool

    init(dir: String | Path, recursive: Bool = false) {
        __dir = Path(dir)
        __recursive = recursive
        __ino = inotify.Inotify()
        __wd-to-dir = %{}
        __closed = false
        __add-dir(__dir)
    }

    __add-dir(dir: Path) {
        let mask = inotify.IN_CREATE | inotify.IN_DELETE
                 | inotify.IN_MODIFY | inotify.IN_ATTRIB
                 | inotify.IN_MOVED_FROM | inotify.IN_MOVED_TO
        let wd = __ino.add("{dir}", mask)
        __wd-to-dir[wd] = dir
        if __recursive {
            for name in os.listdir("{dir}") {
                let p = dir / name
                if p.dir? { __add-dir(p) }
            }
        }
    }

    dir -> Path { __dir }
    open? -> Bool { !__closed }

    events*(timeout: Float = -1.0) {
        for ev in __ino.events(timeout) {
            let $name = ev.name or continue
            let $dir = __wd-to-dir[ev.wd] or continue
            let p = dir / name
            let m = ev.mask

            if m & (inotify.IN_CREATE | inotify.IN_MOVED_TO) {
                if __recursive && (p.dir?) { __add-dir(p) }
                yield Create(p)
            }
            if m & (inotify.IN_DELETE | inotify.IN_MOVED_FROM) {
                yield Delete(p)
            }
            if m & inotify.IN_MODIFY {
                yield Modify(p)
            }
            if m & inotify.IN_ATTRIB {
                yield Attrib(p)
            }
        }
    }

    close() {
        if __closed { return }
        __ino.close()
        __closed = true
    }

    __drop__ = use close
    __free__ = use close
}

#|else

const VNODE_FFLAGS = kqueue.NOTE_WRITE | kqueue.NOTE_DELETE
                   | kqueue.NOTE_RENAME | kqueue.NOTE_ATTRIB

const DIR_FFLAGS = kqueue.NOTE_WRITE | kqueue.NOTE_DELETE | kqueue.NOTE_RENAME

const GONE = kqueue.NOTE_DELETE | kqueue.NOTE_RENAME

pub class Watcher {
    __kq: kqueue.Kqueue
    __dir: Path
    __recursive: Bool
    __dir-fds: Dict[Int, Path]
    __file-fds: Dict[Int, Path]
    __paths: Set[String]
    __closed: Bool

    init(dir: String | Path, recursive: Bool = false) {
        __dir = Path(dir)
        __recursive = recursive
        __kq = kqueue.Kqueue()
        __dir-fds = %{}
        __file-fds = %{}
        __paths = %[]
        __closed = false
        __add-dir(__dir)
    }

    __add-dir(dir: Path) {
        let ds = "{dir}"
        return if (ds in __paths)
        let fd = os.open(ds, os.O_RDONLY)
        return if fd == -1
        let entries = os.listdir(ds)
        if entries == nil {
            os.close(fd)
            return
        }
        __kq.clear(fd, kqueue.EVFILT_VNODE, fflags=DIR_FFLAGS)
        __dir-fds[fd] = dir
        __paths << ds
        for entries {
            let p = dir / it
            if __recursive && (p.dir?) {
                __add-dir(p)
            } else {
                __add-file(p)
            }
        }
    }

    __add-file(p: Path) {
        let ps = "{p}"
        return if (ps in __paths)
        let fd = os.open(ps, os.O_RDONLY)
        return if fd == -1
        __kq.clear(fd, kqueue.EVFILT_VNODE, fflags=VNODE_FFLAGS)
        __file-fds[fd] = p
        __paths << ps
    }

    __remove(fd: Int) {
        if let $p = __file-fds.remove(fd) {
            __paths.remove("{p}")
        } else if let $p = __dir-fds.remove(fd) {
            __paths.remove("{p}")
        }
        os.close(fd)
    }

    __add(p: Path) {
        if __recursive && p.dir? {
            __add-dir(p)
        } else {
            __add-file(p)
        }
    }

    __rescan(dir: Path) {
        for os.listdir("{dir}") ?? [] {
            let p = dir / it
            if "{p}" not in __paths {
                __add(p)
                yield Create(p)
            }
        }
    }

    __replaced(fd: Int, p: Path) {
        __remove(fd)

        if p.exists? {
            __add(p)
            yield Create(p)
        } else {
            yield Delete(p)
        }
    }

    dir -> Path { __dir }
    open? -> Bool { !__closed }

    events*(timeout: Float = -1.0) {
        for ev in __kq.events(timeout) {
            let fd = ev.ident
            let ff = ev.fflags

            if let $dir = __dir-fds[fd] {
                if ff & GONE {
                    __replaced(fd, dir)
                } else {
                    __rescan(dir)
                }
                continue
            }

            if let $p = __file-fds[fd] {
                if ff & GONE {
                    __replaced(fd, p)
                } else {
                    if ff & kqueue.NOTE_WRITE  { yield Modify(p) }
                    if ff & kqueue.NOTE_ATTRIB { yield Attrib(p) }
                }
            }
        }
    }

    close() {
        return if __closed
        for [*__file-fds.keys()] {
            os.close(it)
        }
        for [*__dir-fds.keys()] {
            os.close(it)
        }
        __kq.close()
        __closed = true
    }

    __drop__ = use close
    __free__ = use close
}

#|]

pub fn watch*(dir: String | Path, recursive: Bool = false, timeout: Float = -1.0) {
    let ^w = Watcher(dir, recursive)
    yield *w.events(timeout)
}
