/**
 * zlib (built in): one-shot compression in the zlib format, decompression
 * of zlib or gzip data, and CRC-32/Adler-32 checksums. Streaming codecs
 * live in `http.codec`.
 */
import _codec as native

pub VERSION = native.zlib-version()

pub class ZlibError < RuntimeError {
}

fn inflate(s: String | Blob, coding: String, limit: Int | nil) -> Blob | nil {
    let z = match native.open(coding, false) {
        p: Ptr => p,
        why    => throw ZlibError("zlib: {why}")
    }
    let out = Blob()
    match native.run(z, s, out, 0, limit ?? -1) {
        0  => nil,
        -2 => return nil,
        _  => throw ZlibError("zlib: {native.message(z)}")
    }
    if !native.finish(z) {
        throw ZlibError('zlib: truncated stream')
    }
    out
}

/// Compresses `s` into the zlib format (`level` 0-9, -1 for the default).
pub fn compress(s: String | Blob, level: Int = -1) -> Blob {
    native.zlib-compress(s, level)
}

/// Decompresses zlib-format data; nil when the output would exceed `maxSize`.
pub fn uncompress(s: String | Blob, maxSize: Int | nil = nil) -> Blob | nil {
    inflate(s, 'deflate', maxSize)
}

/// Decompresses zlib or gzip data (detected from the header); `maxSize`
/// bounds the output as for `uncompress`.
pub fn uncompress2(s: String | Blob, maxSize: Int | nil = nil) -> Blob | nil {
    inflate(s, 'zlib-auto', nil)
}

pub fn crc32(s: String | Blob, crc: Int = 0) -> Int {
    native.crc32(s, crc)
}

pub fn adler32(s: String | Blob, adler: Int = 1) -> Int {
    native.adler32(s, adler)
}
