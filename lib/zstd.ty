/**
 * Zstandard (built in): one-shot and streaming compression.
 */
import _codec as native

pub VERSION = native.zstd-version()

pub class ZstdError < RuntimeError {
}

pub fn compress(data: String | Blob, level: Int = 3) -> Blob {
    native.zstd-compress(data, level)
}

pub fn content-size(data: String | Blob) -> Int {
    match native.zstd-content-size(data) {
        -1 => throw ZstdError('zstd: the frame does not record its content size'),
        -2 => throw ZstdError('zstd: not a zstd frame'),
        n  => n
    }
}

pub fn decompress(data: String | Blob, originalSize: Int = content-size(data)) -> Blob {
    native.zstd-decompress(data, originalSize)
}

fn open(encode: Bool, level: Int = 0) -> Ptr {
    match native.open('zstd', encode, level) {
        z: Ptr => z,
        why    => throw ZstdError("zstd: {why}")
    }
}

/// Streaming compressor: `write` buffers compressed output, `flush` ends
/// the frame and returns it, after which the compressor starts a new one.
pub class Compressor {
    __z:   Ptr
    __out: Blob

    init(level: Int = 3) {
        __z   = open(true, level)
        __out = Blob()
    }

    write(data: String | Blob) {
        if native.run(__z, data, __out, 0) != 0 {
            throw ZstdError("zstd: {native.message(__z)}")
        }
    }

    flush() -> Blob {
        if native.run(__z, nil, __out, 2) != 0 {
            throw ZstdError("zstd: {native.message(__z)}")
        }
        let result = __out
        __out = Blob()
        native.reset(__z)
        result
    }
}

/// Streaming decompressor: `write` feeds compressed data, `flush` returns
/// the output so far and starts over.
pub class Decompressor {
    __z:   Ptr
    __out: Blob

    init() {
        __z   = open(false)
        __out = Blob()
    }

    write(data: String | Blob) {
        if native.run(__z, data, __out) != 0 {
            throw ZstdError("zstd: {native.message(__z)}")
        }
    }

    flush() -> Blob {
        let result = __out
        __out = Blob()
        native.reset(__z)
        result
    }
}
