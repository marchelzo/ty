import sql (table, connect, disconnect, transaction, rows as sql-rows)
import path (Path)
import date (utc-now)
import hash (sha256)
import json
import os
import math
import chalk (chalk)
import sh (sh, run, Success)
import ty

import lib (Result, fmt-time, fmt-delta)

let PERF_DIR = Path(__file__).parent
let ROOT_DIR = PERF_DIR.parent

pub DEFAULT_DATABASE = "{PERF_DIR}/history.sqlite3"
let MAX_CV = 0.25

use Metadata = {
    commit: String,
    branch: String,
    dirty: Bool,
    dirtyFiles: [String],
    machineJson: String,
    machineId: String,
    build: String,
    buildInfo: BuildInfo,
    suite: String,
}

use BuildInfo = {
    compiler: String | nil,
    platform: String | nil,
    pgo: String | nil,
    bolt: String | nil,
    cflags: String | nil,
    ldflags: String | nil,
    version: String,
}

@table
class Run {
    table-name = 'runs'

    id:                  Int
    recorded_at:         String
    duration_seconds:    Float | nil
    runner:              String
    mode:                String
    build_config:        String
    commit_hash:         String | nil
    branch:              String | nil
    dirty:               Int
    dirty_file_count:    Int = 0
    dirty_files_json:    String = '[]'
    machine_id:          String
    machine_json:        String
    suite_hash:          String
    warmup:              Int
    rounds:              Int
    benchmark_filter:    String | nil
    benchmark_count:     Int
    expected_count:      Int | nil
    full_suite:          Int
    auto_eligible:       Int
    eligibility_reason:  String
    manual_eligible:     Int | nil
    manual_reason:       String | nil
    note:                String | nil
    command:             String | nil
    compiler:            String | nil
    platform:            String | nil
    pgo:                 String | nil
    bolt:                String | nil
    cflags:              String | nil
    ldflags:             String | nil
    version_text:        String | nil
}

@table
class Measurement {
    table-name = 'measurements'

    id:                  Int
    run_id:              ForeignKey[Run.id]
    benchmark:           String
    iterations:          Int
    sample_count:        Int
    mean_seconds:        Float
    median_seconds:      Float
    min_seconds:         Float
    max_seconds:         Float
    stddev_seconds:      Float
    cv:                  Float
    auto_valid:          Int
    validity_reason:     String | nil
    manual_valid:        Int | nil
    manual_reason:       String | nil
    verdict:             String
}

@table
class Sample {
    table-name = 'samples'
    primary-key = [measurement_id, sample_index]

    measurement_id: ForeignKey[Measurement.id]
    sample_index:   Int
    seconds:        Float
}

fn command(cmd: String) -> String {
    let result = sh(cmd, chdir="{ROOT_DIR}")

    match result.fate {
        Success => result.stdout,
        fate    => throw RuntimeError("command `{cmd}` failed: {fate}\n{result.stderr}")
    }
}

fn suite-hash() -> String {
    let h = sha256()
    let files = [PERF_DIR / 'lib.ty', *(PERF_DIR / 'benchmarks').glob('*.ty').sort(by: \_.name)]
    for path in files {
        h.update("{path.name}\0")
        h.update(path)
        h.update('\0')
    }
    h.hexdigest().slice(0, 20)
}

fn version-info() -> (String, Bool, BuildInfo) {
    let result = run([ty.executable, '--version'])
    let text = match result.fate {
        Success => result.stdout,
        fate    => throw RuntimeError("`{ty.executable} --version` failed: {fate}\n{result.stderr}")
    }
    let fields = %{}
    for match text.lines() {
        /^(\w+):\s*(.*)$/ => fields[$1.lower()] = $2.trim(),
        _                  => ()
    }
    let [commit, *flags] = (fields['commit'] ?? 'unknown').split(/\s+/)
    (commit, '(dirty)' in flags, {
        compiler: fields['compiler'],
        platform: fields['platform'],
        pgo: fields['pgo'],
        bolt: fields['bolt'],
        cflags: fields['cflags'],
        ldflags: fields['ldflags'],
        version: text,
    })
}

fn metadata() -> Metadata {
    let (commit, dirty, info) = version-info()
    let dirty-text = command('git status --porcelain=v1 --untracked-files=no')
    let machine = %{
        'hostname': command('hostname'),
        'system': command('uname -s'),
        'release': command('uname -r'),
        'architecture': command('uname -m'),
        'cpu': command("sysctl -n machdep.cpu.brand_string 2>/dev/null || sed -n 's/^model name[^:]*: //p' /proc/cpuinfo 2>/dev/null | head -1"),
    }
    let machine-json = json.encode(machine)
    let build = [info.compiler, info.platform, info.pgo, info.bolt, info.cflags, info.ldflags]
    return {
        commit: commit,
        branch: command('git branch --show-current'),
        dirty: dirty,
        dirtyFiles: dirty-text ? dirty-text.lines() : [],
        machineJson: machine-json,
        machineId: sha256(machine-json).hexdigest().slice(0, 16),
        build: sha256(build.map(\_ ?? '').join('\0')).hexdigest().slice(0, 16),
        buildInfo: info,
        suite: suite-hash(),
    }
}

pub fn open-history(path: String = DEFAULT_DATABASE) {
    connect(
        path,
        full-mutex=false,
        schema=(PERF_DIR / 'history.sql').read-text(),
        sync=true
    )
}

fn close-history() {
    disconnect()
}

pub fn record-run(
    path: String,
    results: [Result],
    mode: String,
    warmup: Int,
    rounds: Int,
    filter: String | nil,
    expected-count: Int,
    duration: Float,
    note: String | nil,
) -> Int {
    open-history(path)
    let meta = metadata()
    let full-suite = filter == nil && #results == expected-count
    let eligible = !meta.dirty && full-suite && rounds >= 3
    let eligibility-reason = if meta.dirty { 'dirty working tree' }
        else if !full-suite { 'partial/filtered suite' }
        else if rounds < 3 { 'fewer than 3 timed rounds' }
        else { 'clean, complete suite' }

    let run-id = 0
    let dirty-value = Int(meta.dirty)
    let full-suite-value = Int(full-suite)
    let eligible-value = Int(eligible)
    let recorded-at = "{utc-now()}Z"
    let benchmark-count = #results
    let phase = "run metadata (dirty={dirty-value}, full_suite={full-suite-value}, "
                "auto_eligible={eligible-value}, benchmarks={#results}/{expected-count})"
    try {
        transaction(fn () {
            let run = Run(
                recorded_at=recorded-at,
                duration_seconds=duration,
                runner='ty',
                mode=mode,
                build_config=meta.build,
                compiler=meta.buildInfo.compiler,
                platform=meta.buildInfo.platform,
                pgo=meta.buildInfo.pgo,
                bolt=meta.buildInfo.bolt,
                cflags=meta.buildInfo.cflags,
                ldflags=meta.buildInfo.ldflags,
                version_text=meta.buildInfo.version,
                commit_hash=meta.commit,
                branch=meta.branch,
                dirty=dirty-value,
                dirty_file_count=#meta.dirtyFiles,
                machine_id=meta.machineId,
                machine_json=meta.machineJson,
                suite_hash=meta.suite,
                warmup=warmup,
                rounds=rounds,
                benchmark_filter=filter,
                benchmark_count=benchmark-count,
                expected_count=expected-count,
                full_suite=full-suite-value,
                auto_eligible=eligible-value,
                eligibility_reason=eligibility-reason,
                note=note
            ).insert()
            let $inserted-run-id = run.id
                or throw RuntimeError('run insert did not return an id')
            run-id = inserted-run-id

            for r in results {
                phase = "measurement '{r.name}'"
                let cv = r.mean > 0 ? r.sd / r.mean : 1.0 / 0.0
                let reason = r.med <= 0  ? 'non-positive timing value'
                           : cv > MAX_CV ? "within-run CV {cv * 100:.1}% exceeds {MAX_CV * 100:.0}%"
                           :               nil
                let $stddev = r.sd
                    or throw RuntimeError("'{r.name}' has no timing samples")
                let measurement = Measurement(
                    run_id=run-id,
                    benchmark=r.name,
                    iterations=r.iters,
                    sample_count=r.n,
                    mean_seconds=r.mean,
                    median_seconds=r.med,
                    min_seconds=r.best,
                    max_seconds=r.worst,
                    stddev_seconds=stddev,
                    cv=cv,
                    auto_valid=Int(reason == nil),
                    validity_reason=reason,
                    verdict=reason == nil ? 'valid' : 'anomaly'
                ).insert()
                let $measurement-id = measurement.id
                    or throw RuntimeError('measurement insert did not return an id')
                for seconds; i in r.per-iter-times {
                    phase = "sample {i} for '{r.name}'"
                    Sample(
                        measurement_id=measurement-id,
                        sample_index=i,
                        seconds=seconds
                    ).insert()
                }
            }
            phase = 'dirty-file metadata'
            Run.where('id = ?', run-id).update-all!(
                "dirty_files_json = COALESCE(?, '[]')",
                json.encode(meta.dirtyFiles.slice(0, min(100, #meta.dirtyFiles)))
            )
            phase = 'transaction commit'
        })
    } catch e {
        close-history()
        throw RuntimeError("performance history failed at {phase}: {e}")
    }
    close-history()
    run-id
}

fn status-label(row, width: Int = 0) {
    let (text, style) = row['manual_eligible'] == 0 ? ('excluded', 'red')
                      : row['manual_eligible'] == 1 ? ('accepted', 'bright green')
                      : row['auto_eligible']   == 1 ? ('eligible', 'green')
                      : row['dirty']           == 1 ? ('dirty',    'yellow')
                      :                               ('partial',  'dim')
    chalk"[{style}]{text:<{width}}[/]"
}

pub fn build-label(row, width: Int = 0) {
    let pgo? = row['pgo'] == 'use'
    let bolt? = (row['bolt'] ?? '').starts?('yes')
    let (text, style) = row['pgo'] == nil && row['bolt'] == nil ? ('?',    'dim')
                      : pgo? && bolt?                         ? ('opt',  'bright magenta bold')
                      : pgo?                                  ? ('pgo',  'magenta')
                      : bolt?                                 ? ('bolt', 'magenta')
                      :                                         ('—',    'dim')
    chalk"[{style}]{text:<{width}}[/]"
}

fn display-time(value: Float | nil) -> String {
    value == nil ? '—' : fmt-time(value)
}

fn identity-key(value: String) -> String {
    sha256("{value}").hexdigest().slice(0, 10)
}

pub fn benchmark-label(name, width: Int = 0) {
    let value = String(name)
    let text = width > 0 ? "{value:{width}}" : value
    chalk"[bold]{text}[/]"
}

pub fn tag-label(name) {
    let value = String(name)
    chalk"[tag-{identity-key(value)}?]{value}[/]"
}

pub fn run-label(id, width: Int = 0) {
    let value = String(id)
    let text = width > 0 ? "#{value:{width}}" : "#{value}"
    chalk"[bright cyan bold]{text}[/]"
}

pub fn revision-label(revision, width: Int = 10) {
    let full = String(revision ?? 'unknown')
    let text = full.slice(0, width)
    chalk"[rev-{full}?]{text:{width}}[/]"
}

pub fn branch-label(branch) {
    let name = String(branch ?? 'detached')
    chalk"[blue]{name}[/]"
}

pub fn machine-label(machine) {
    let id = String(machine ?? 'unknown')
    chalk"[machine-{id}?]{id}[/]"
}

pub fn timestamp-label(timestamp, date-only: Bool = false) {
    let value = String(timestamp)
    let day = value.slice(0, 10)
    if date-only {
        chalk"[blue]{day}[/]"
    } else {
        let rest = value.slice(10, min(9, #value - 10))
        chalk"[blue]{day}[/][dim]{rest}[/]"
    }
}

pub fn mode-label(mode, width: Int = 0) {
    let name = String(mode)
    let text = width > 0 ? "{name:{width}}" : name
    if name == 'jit' { chalk"[bright green bold]{text}[/]" }
    else { chalk"[yellow]{text}[/]" }
}

pub fn duration-label(value: Float | nil, role: String = 'current', verdict: String | nil = nil, width: Int = 0) {
    let text = display-time(value)
    let padded = width > 0 ? "{text:>{width}}" : text
    let style = match verdict {
        'regression' => 'red bold',
        'improvement' => 'bright green bold',
        'anomaly' => 'yellow bold',
        _ => role == 'baseline' ? 'magenta' : role == 'spread' ? 'dim cyan' : 'bright cyan'
    }
    chalk"[{style}]{padded}[/]"
}

pub fn delta-label(ratio, width: Int = 0) {
    let value: Float | nil = ratio == nil ? nil : Float(ratio)
    let text = value == nil ? '—' : fmt-delta(value)
    let padded = width > 0 ? "{text:>{width}}" : text
    let style = value == nil ? 'dim'
              : value > 1.05 ? 'red bold'
              : value < 0.95 ? 'bright green bold'
              :                'dim'
    chalk"[{style}]{padded}[/]"
}

pub fn verdict-label(verdict) {
    let value = String(verdict)
    let style = match value {
        'regression' => 'red bold',
        'improvement' => 'bright green bold',
        'anomaly' => 'yellow bold',
        'stable' => 'green',
        _ => 'dim'
    }
    chalk"[{style}]{value}[/]"
}

fn best-times(excluding: Int | nil = nil) -> String {
    let skip = excluding == nil ? '' : "AND run_id != {excluding}"
    """
    SELECT benchmark, MIN(median_seconds) AS best, run_id AS best_run
      FROM measurements WHERE median_seconds > 0 {skip}
     GROUP BY benchmark
    """
}

pub fn print-run(path: String, run-id: Int) {
    open-history(path)
    let $stored-run = Run.get(run-id)
        or throw ValueError("no performance run #{run-id}")
    let run = stored-run.to-dict()
    let rows: [_] = sql-rows(
        """
        SELECT m.benchmark, m.median_seconds AS current, b.best, b.best_run
          FROM measurements AS m LEFT JOIN ({best-times(excluding=run-id)}) AS b
            ON b.benchmark = m.benchmark
         WHERE m.run_id = ?
         ORDER BY m.benchmark
        """, run-id
    )
    let ratios = rows.filter(r -> r['best'] && r['current']).map(r -> r['current'] / r['best'])
    let geomean = #ratios > 0 ? math.exp(ratios.map(math.log).sum()! / #ratios) : nil
    print(chalk"[bold bright cyan]Run[/] {run-label(run-id)}  {timestamp-label(run['recorded_at'])}  "
               "[dim]{run['runner']}[/]/[bold]{mode-label(run['mode'])}[/]  {status-label(run)}  {build-label(run)}")
    print(chalk"{revision-label(run['commit_hash'], 12)}  {branch-label(run['branch'])}  "
               "[dim]machine=[/]{machine-label(run['machine_id'])}")
    if run['note'] { print(chalk"[italic dim]Note:[/] [italic]{run['note']}[/]") }
    print()
    let width: Int = (rows.map(r -> #String(r['benchmark'])).max() ?? 7) + 2
    print(chalk"[bold]  {'Benchmark':{width}} {'Current':>10}  {'Best':>10}  {'vs Best':>8}  Best run[/]")
    print(chalk"[dim]  {'─'.repeat(width + 46)}[/]")
    for row in rows {
        print(chalk"  {benchmark-label(row['benchmark'], width)}"
                   " {duration-label(row['current'], width=10)}  "
                   "{duration-label(row['best'], role='baseline', width=10)}  "
                   "{delta-label(row['best'] ? row['current'] / row['best'] : nil, 8)}  "
                   "{row['best_run'] ? run-label(row['best_run'], 4) : ''}")
    }
    print(chalk"[dim]  {'─'.repeat(width + 46)}[/]")
    print(chalk"  {'Geomean':>{width}} {' ':>10}  {' ':>10}   {geomean-label(geomean)}")
    close-history()
}

fn run-geomeans() -> Dict {
    let ratios = sql-rows(
        """
        SELECT m.run_id, m.median_seconds / b.best AS ratio
          FROM measurements AS m JOIN ({best-times()}) AS b ON b.benchmark = m.benchmark
         WHERE m.median_seconds > 0
         ORDER BY m.run_id
        """
    )
    let geomeans = %{}
    for rs in ratios.group-by(&['run_id']) {
        geomeans[rs[0]['run_id']] = math.exp(rs.map(\math.log(_['ratio'])).sum()! / #rs)
    }
    geomeans
}

fn geomean-label(g: Float | nil) {
    if g == nil {
        return chalk"[dim]{'—':>7}[/]"
    }
    let color = g <= 1.05 ? 'bright green' : g <= 1.25 ? 'yellow' : 'red'
    chalk"[{color}]{g:>7.2f}[/]"
}

pub fn print-history(
    path: String,
    limit: Int = 20,
    all: Bool = false,
    filter: String | nil = nil,
) {
    open-history(path)
    let rows: [_] = if filter {
        sql-rows(
            """
            SELECT DISTINCT r.* FROM runs AS r
            JOIN measurements AS m ON m.run_id = r.id
            WHERE m.benchmark LIKE ?
              AND (? OR COALESCE(r.manual_eligible, r.auto_eligible) = 1)
            ORDER BY r.id DESC LIMIT ?
            """, "%{filter}%", Int(all), limit
        )
    } else {
        Run.where(
            '? OR COALESCE(manual_eligible, auto_eligible) = 1', Int(all)
        ).order('id DESC').limit(limit).all().map(\_.to-dict())
    }
    let geomeans = run-geomeans()
    print(chalk"[bold bright cyan]Performance history[/]  [dim]{#rows} run(s)[/]")
    print()
    print(chalk"[bold]  {'Run':>5}  {'Timestamp (UTC)':<19}  {'Mode':>11}  {'Build':<5}  {'Commit':<10}  {'State':<10}  {'Benches':>7}  {'Geomean':>7}  Note[/]")
    print(chalk"[dim]  {'─'.repeat(104)}[/]")
    for row in rows {
        let note = row['note'] ?? ''
        print(chalk"  {run-label(row['id'], 4)}  {timestamp-label(row['recorded_at'])}  "
                   "{mode-label(row['mode'], 11)}  {build-label(row, 5)}  {revision-label(row['commit_hash'])}  "
                   "{status-label(row, 10)}  [cyan]{row['benchmark_count']:>7}[/]  "
                   "{geomean-label(geomeans[row['id']])}  [italic dim]{note}[/]")
    }
    if #rows == 0 {
        print(chalk"[dim]  No matching runs. Use --all to include dirty and partial runs.[/]")
    }
    close-history()
}

pub fn print-goats(path: String, filter: String | nil = nil) {
    open-history(path)
    let rows: [_] = sql-rows(
        """
        WITH ranked AS (
            SELECT m.benchmark, m.median_seconds, m.run_id, r.commit_hash, r.pgo, r.bolt,
                   ROW_NUMBER() OVER (
                       PARTITION BY m.benchmark ORDER BY m.median_seconds
                   ) AS place
              FROM measurements AS m JOIN runs AS r ON r.id = m.run_id
             WHERE m.median_seconds > 0 AND m.benchmark LIKE ?
        )
        SELECT g.benchmark, g.median_seconds AS best, g.run_id, g.commit_hash, g.pgo, g.bolt,
               n.median_seconds AS next, n.run_id AS next_run,
               n.pgo AS next_pgo, n.bolt AS next_bolt
          FROM ranked AS g LEFT JOIN ranked AS n
            ON n.benchmark = g.benchmark AND n.place = 2
         WHERE g.place = 1
         ORDER BY g.benchmark
        """, "%{filter ?? ''}%"
    )
    let width: Int = (rows.map(r -> #String(r['benchmark'])).max() ?? 9) + 2
    print(chalk"[bold bright cyan]GOATs[/]  [dim]{#rows} benchmark(s)[/]")
    print()
    print(chalk"[bold]  {'Benchmark':>{width}} {'Best':>10}  {'Run':>5}       {'Commit':<10}  {'Next':>10}  {'Run':>5}       {'Lead':>8}[/]")
    print(chalk"[dim]  {'─'.repeat(width + 71)}[/]")
    for row in rows {
        let lead = row['next'] ? row['next'] / row['best'] : nil
        let next-run = row['next_run']
            ? chalk"{run-label(row['next_run'], 4)} {build-label(%{'pgo': row['next_pgo'], 'bolt': row['next_bolt']}, 4)}"
            : chalk"[dim]{'—':>5}[/]     "
        print(chalk"  {benchmark-label(row['benchmark'], width)}"
                   " {duration-label(row['best'], width=10)}  {run-label(row['run_id'], 4)} {build-label(row, 4)}  "
                   "{revision-label(row['commit_hash'])}  "
                   "{duration-label(row['next'], role='baseline', width=10)}  {next-run}  "
                   "{lead-label(lead, 8)}")
    }
    close-history()
}

fn lead-label(ratio: Float | nil, width: Int) {
    if ratio == nil {
        return chalk"[dim]{'—':>{width}}[/]"
    }
    let text = "{(ratio - 1.0) * 100:.1f}%"
    let color = ratio >= 1.05 ? 'bright green bold' : ratio >= 1.01 ? 'green' : 'dim'
    chalk"[{color}]{text:>{width}}[/]"
}

pub fn latest-run-id(path: String) -> Int | nil {
    open-history(path)
    let id = Run.query().max('id')
    close-history()
    id == nil ? nil : Int(id)
}

pub fn compare-runs(path: String, run-id: Int, against: Int | nil = nil) {
    open-history(path)
    let rows: [_] = if against != nil {
        sql-rows(
            """
            SELECT n.benchmark, n.median_seconds AS current, o.median_seconds AS baseline
              FROM measurements AS n LEFT JOIN measurements AS o
                ON o.run_id = ? AND o.benchmark = n.benchmark
             WHERE n.run_id = ? ORDER BY n.benchmark
            """, against, run-id
        )
    } else {
        sql-rows(
            """
            SELECT m.benchmark, m.median_seconds AS current, b.best AS baseline
              FROM measurements AS m LEFT JOIN ({best-times(excluding=run-id)}) AS b
                ON b.benchmark = m.benchmark
             WHERE m.run_id = ? ORDER BY m.benchmark
            """, run-id
        )
    }
    let reference-label = if against != nil {
        run-label(against)
    } else {
        chalk"[magenta]best of other runs[/]"
    }
    print(chalk"[bold bright cyan]Compare[/]  {run-label(run-id)} "
               "[dim]vs[/] {reference-label}")
    print()
    let width: Int = (rows.map(r -> #String(r['benchmark'])).max() ?? 7) + 2
    for row in rows {
        let ratio = row['baseline'] ? row['current'] / row['baseline'] : nil
        let verdict = ratio == nil ? nil : ratio > 1.05 ? 'regression' : ratio < 0.95 ? 'improvement' : 'stable'
        print(chalk"  {benchmark-label(row['benchmark'], width)} "
                   "{duration-label(row['baseline'], role='baseline', width=10)} "
                   "[dim]→[/] {duration-label(row['current'], verdict=verdict, width=10)}  "
                   "{delta-label(ratio, 8)}")
    }
    close-history()
}

let SPARKS = '▁▂▃▄▅▆▇█'

pub fn print-trend(path: String, benchmark: String, limit: Int = 20, all: Bool = false) {
    open-history(path)
    let rows: [_] = sql-rows(
        """
        SELECT r.id, r.recorded_at, r.commit_hash, r.dirty, r.pgo, r.bolt, m.median_seconds
          FROM measurements AS m JOIN runs AS r ON r.id = m.run_id
         WHERE m.benchmark LIKE ?
           AND (? OR (COALESCE(r.manual_eligible, r.auto_eligible) = 1
                  AND COALESCE(m.manual_valid, m.auto_valid) = 1))
         ORDER BY r.id DESC LIMIT ?
        """, "%{benchmark}%", Int(all), limit
    )
    rows.reverse!()
    if #rows == 0 {
        print(chalk"[yellow]No history for benchmark matching '{benchmark}'.[/]")
        close-history()
        return
    }
    let values: [Float] = rows.map(r -> Float(r['median_seconds']))
    let lo = values.min() ?? 0.0
    let hi = values.max() ?? lo
    let spark = values.map(v -> do {
        let i = hi == lo ? 0 : int(((v - lo) / (hi - lo) * (#SPARKS - 1)).round)
        SPARKS[i]
    }).join('')
    let overall-ratio = values[-1] / values[0]
    print(chalk"{benchmark-label(benchmark)} [bold bright cyan]trend[/]  "
               "[cyan]{spark}[/]")
    let overall-verdict = overall-ratio > 1.05 ? 'regression'
                        : overall-ratio < 0.95 ? 'improvement'
                        : nil
    print(chalk"{duration-label(values[0], role='baseline')} [dim]→[/] "
               "{duration-label(values[-1], verdict=overall-verdict)}  "
               "[cyan]{#values} runs[/] [dim]· lower is better[/]")
    print()
    for row in rows {
        let dirty = row['dirty'] ? chalk" [yellow]dirty[/]" : ''
        print(chalk"  {run-label(row['id'], 4)} {timestamp-label(row['recorded_at'], date-only=true)}  "
                   "{duration-label(row['median_seconds'], width=10)}  "
                   "{build-label(row, 4)}  {revision-label(row['commit_hash'])}{dirty}")
    }
    close-history()
}

pub fn check-run(path: String, run-id: Int, threshold: Float) -> Bool {
    open-history(path)
    let rows: [_] = sql-rows(
        """
        SELECT m.benchmark, m.verdict, m.median_seconds / b.best AS ratio
          FROM measurements AS m LEFT JOIN ({best-times(excluding=run-id)}) AS b
            ON b.benchmark = m.benchmark
         WHERE m.run_id = ? ORDER BY m.benchmark
        """, run-id
    )
    let failures = rows.filter(row -> (
        row['verdict'] == 'anomaly'
        || (row['ratio'] != nil && row['ratio'] > 1.0 + threshold)
    ))
    if #failures == 0 {
        print(chalk"[bright green bold]PASS[/] {run-label(run-id)}[dim]: no regressions above[/] "
                   "[yellow]{threshold * 100:.1}%[/]")
    } else {
        print(chalk"[red bold]FAIL[/] {run-label(run-id)}[dim]:[/] "
                   "[red bold]{#failures} performance problem(s)[/]")
        for row in failures {
            print(chalk"  {benchmark-label(row['benchmark'])}  {verdict-label(row['verdict'])}  "
                       "{delta-label(row['ratio'])}")
        }
    }
    close-history()
    #failures == 0
}

pub fn set-status(path: String, run-id: Int, status: String, reason: String | nil) {
    if status not in ['auto', 'eligible', 'excluded'] {
        throw ValueError("status must be auto, eligible, or excluded")
    }
    open-history(path)
    let value = match status { 'auto' => nil, 'eligible' => 1, 'excluded' => 0 }
    transaction(fn () {
        Run.where('id = ?', run-id).update-all!(
            'manual_eligible = ?, manual_reason = ?', value, reason
        )
        if status == 'eligible' {
            Measurement.where(
                'run_id = ? AND auto_valid = 0', run-id
            ).update-all!(
                'manual_valid = 1, manual_reason = ?', reason ?? 'manually validated'
            )
        } else if status == 'auto' {
            Measurement.where('run_id = ?', run-id).update-all!(
                'manual_valid = NULL, manual_reason = NULL'
            )
        }
    })
    let label = status == 'eligible' ? chalk"[bright green bold]{status}[/]"
              : status == 'excluded' ? chalk"[red bold]{status}[/]"
              :                        chalk"[dim]{status}[/]"
    print(chalk"{run-label(run-id)} [dim]status →[/] {label}")
    close-history()
}
