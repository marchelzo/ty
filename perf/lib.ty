import time (now)
import json
import io
import path (Path)
import os
import ty

import sched (inherit-elevation)
import counters (Counters)

pub use BenchRecord = {
    name: String,
    times: Array[Float],
    iters: Int,
    mean: Float,
    median: Float,
    min: Float,
    max: Float,
    stddev: Float
}

pub use SuiteRecord = Array[BenchRecord]

pub use Build = {
    exe:  String,
    lib:  String | nil,
    tree: String | nil,
}

pub use Benchmark = {
    name: String,
    program: String,
    tags: Array[String],
}

use BenchmarkInfo = {
    name: String,
    tags: Array[String],
}

use BenchmarkOutput = {
    name: String,
    iters: Int,
    times: Array[Float],
    metrics: Dict[String, Array[Float]],
    coverage: Dict[String, Float],
}

use CalibrationOutput = Int

// ---------------------------------------------------------------------------
//  Statistics helpers
// ---------------------------------------------------------------------------

pub fn median(xs: [Float]) {
    let sorted = xs.sort()
    let nn = #sorted
    if nn % 2 == 0 {
        (sorted[nn / 2 - 1] + sorted[nn / 2]) / 2.0
    } else {
        sorted[nn / 2]
    }
}

fn stddev(xs: [Float]) {
    let m = xs.mean() as Float
    let variance = xs.map(x -> (x - m) * (x - m)).mean() as Float
    variance.sqrt
}

fn percentile(xs: [Float], p: Float) {
    let sorted = xs.sort()
    let k = (p / 100.0) * (#sorted - 1)
    let f = int(k.floor)
    let c = min(f + 1, #sorted - 1)
    let d = k - f
    sorted[f] + d * (sorted[c] - sorted[f])
}

// ---------------------------------------------------------------------------
//  Result type
// ---------------------------------------------------------------------------

pub class Result {
    name:     String
    times:    [Float]
    metrics:  Dict[String, [Float]]
    coverage: Dict[String, Float]
    iters:    Int

    init(
        name:     String,
        times:    [Float],
        metrics:  Dict[String, [Float]] = %{},
        coverage: Dict[String, Float] = %{},
        iters:    Int = 1
    ) {
        self.name     = name
        self.times    = times
        self.metrics  = metrics
        self.coverage = coverage
        self.iters    = iters
    }

    // Per-iteration times (the meaningful metric)
    per-iter-times { times.map(t -> t / iters) }

    per-iter(metric: String) -> [Float] | nil {
        metrics[metric].?map(x -> x / iters)
    }

    metric(name: String) -> Float | nil {
        let $xs = per-iter(name) or return nil
        median(xs)
    }

    mean   { (times.mean() ?? 0.0) / iters  }
    med    { median(per-iter-times) }
    best   { (times.min() ?? 0.0) / iters   }
    worst  { (times.max() ?? 0.0) / iters   }
    sd     { stddev(per-iter-times) }
    p95    { percentile(per-iter-times, 95.0) }
    n      { #times }

    to-dict() -> _ {
        %{
            'name':   name,
            'times':  per-iter-times,
            'iters':  iters,
            'mean':   mean,
            'median': med,
            'min':    best,
            'max':    worst,
            'stddev': sd
        }
    }
}

// ---------------------------------------------------------------------------
//  Benchmark programs
// ---------------------------------------------------------------------------

const INFO_MODE = '--ty-perf-info'
const CALIBRATE_MODE = '--ty-perf-calibrate'
const BENCH_MODE = '--ty-perf-bench'

fn benchmark-program(name: String, categories: String, f) {
    if #argv < 2 { return }

    let tags = categories.words().nub().sort()
    match argv[1] {
        INFO_MODE => {
            print(json.encode(%{'name': name, 'tags': tags}))
            os.exit(0)
        },
        CALIBRATE_MODE => {
            if #argv != 3 {
                throw ValueError("{CALIBRATE_MODE} requires TARGET-SECONDS")
            }
            inherit-elevation()
            print(json.encode(calibrate(f, Float(argv[2]))))
            os.exit(0)
        },
        BENCH_MODE => {
            if #argv != 5 {
                throw ValueError("{BENCH_MODE} requires ITERATIONS WARMUP ROUNDS")
            }
            inherit-elevation()
            let iters = Int(argv[2])
            let warmup = Int(argv[3])
            let rounds = Int(argv[4])
            for ..warmup { f(1) }
            let counters = Counters.open()
            let times: [Float] = []
            let metrics: Dict[String, [(Float, Float)]] = %{}
            for ..rounds {
                let s0 = counters.snapshot()
                let t0 = now()
                f(iters)
                let t1 = now()
                let s1 = counters.snapshot()
                times.push(t1 - t0)
                for k, x in Counters.delta(s0, s1) {
                    (metrics[k] ?= []).push(x)
                }
            }
            let full = %{k: xs for k, xs in metrics if #xs == rounds}
            print(json.encode(%{
                'name':     name,
                'iters':    iters,
                'times':    times,
                'metrics':  %{k: xs.map(&0) for k, xs in full},
                'coverage': %{k: xs.map(&1).min() ?? 0.0 for k, xs in full}
            }))
            os.exit(0)
        },
        /^\d+$/ => {
            let iters = int($0)
            inherit-elevation()
            let t0 = now()
            f(iters)
            let dt = now() - t0
            print("{name}: {iters} iters in {fmt-time(dt)} ({fmt-time(dt / iters)}/iter)")
            os.exit(0)
        },
        _ => nil
    }
}

// Expand the original definition followed by a tiny program entrypoint. The
// entrypoint remains dormant during ordinary imports and only responds to the
// private modes used by the suite runner.
pub macro bench(def, categories = nil) {
    let ty.FuncDef({name, *}) = def
    let label = ty.String(name)
    let categories = categories ?? ty.String('')
    let callable = ty.Id({name})
    ty.Multi([
        def,
        $$[ $$::(benchmark-program)($$label, $$categories, $$callable) $$]
    ])
}

pub fn matches-filter(entry: Benchmark, query: String) -> Bool {
    query.words().all?(term -> term in entry.name || term in entry.tags)
}

const LIB_ENV = 'TY_LIBRARY_PATH'

fn this-build() -> Build {
    {exe: ty.executable, lib: nil, tree: nil}
}

fn start-benchmark(build: Build, program: String, *args: String) {
    let saved = getenv(LIB_ENV)
    if let $lib = build.lib {
        setenv(LIB_ENV, lib)
    }
    let child = os.spawn([build.exe, '-j' if !ty.jit, program, *args], stdout=os.SPAWN_PIPE)
    match saved {
        $lib => setenv(LIB_ENV, lib),
        _    => unsetenv(LIB_ENV)
    }
    child
}

fn finish-benchmark(program: String, child) -> String {
    let output = Blob()
    while let $chunk = os.read(child.stdout, 4096) { output.push(chunk) }
    os.close(child.stdout)
    let (_, status) = os.wait(child.pid)!
    if !os.WIFEXITED(status) || os.WEXITSTATUS(status) != 0 {
        let outcome = os.WIFEXITED(status)
            ? "exit status {os.WEXITSTATUS(status)}"
            : "signal {os.WTERMSIG(status)}"
        throw RuntimeError("benchmark program '{program}' failed with {outcome}")
    }
    output.str!().trim()
}

fn invoke-benchmark(build: Build, program: String, *args: String) -> String {
    finish-benchmark(program, start-benchmark(build, program, *args))
}

pub fn load-benchmarks(dir: String | Path) -> Array[Benchmark] {
    let pending = [do {
        let program = "{path}"
        (program, start-benchmark(this-build(), program, INFO_MODE))
    } for path in Path(dir).glob('*.ty').sort(by: \_.name)]
    return [do {
        let info = json.parse(BenchmarkInfo, finish-benchmark(program, child))
        let entry: Benchmark = {name: info.name, program: program, tags: info.tags}
        entry
    } for (program, child) in pending]
}

// ---------------------------------------------------------------------------
//  Runner helpers
// ---------------------------------------------------------------------------

pub fn calibrate(f, target: Float = 0.5) {
    let iters = 1
    while true {
        let t0 = now()
        f(iters)
        let elapsed = now() - t0
        if elapsed >= target {
            return iters
        }
        iters = if elapsed < 0.01 {
            iters * 10
        } else {
            max(iters + 1, int((iters * target / elapsed).ceil))
        }
    }
    iters
}

pub fn calibrate-on(build: Build, benchmark: Benchmark, target: Float) -> Int {
    json.parse(
        CalibrationOutput,
        invoke-benchmark(build, benchmark.program, CALIBRATE_MODE, "{target}")
    )
}

pub fn measure(build: Build, benchmark: Benchmark, iters: Int, warmup: Int, rounds: Int) -> Result {
    let output = json.parse(
        BenchmarkOutput,
        invoke-benchmark(
            build, benchmark.program, BENCH_MODE, "{iters}", "{warmup}", "{rounds}"
        )
    )
    if output.name != benchmark.name || output.iters != iters || #output.times != rounds {
        throw RuntimeError("invalid result from benchmark program '{benchmark.program}'")
    }
    Result(benchmark.name, output.times, output.metrics, output.coverage, iters)
}

pub fn run-one(
    benchmark: Benchmark,
    warmup:  Int = 3,
    rounds:  Int = 5,
    target:  Float = 0.5
) {
    // Calibration and measurement deliberately happen in separate child
    // processes. Measurement gets its own warmup, then all timed rounds run in
    // that benchmark's otherwise-pristine process.
    let build = this-build()
    let iters = calibrate-on(build, benchmark, target)
    measure(build, benchmark, iters, warmup, rounds)
}

// ---------------------------------------------------------------------------
//  Formatting helpers
// ---------------------------------------------------------------------------

pub fn fmt-time(secs) {
    if secs >= 1.0 {
        "{secs:.3}s"
    } else if secs >= 0.001 {
        "{secs * 1000:.2}ms"
    } else {
        "{secs * 1_000_000:.1}us"
    }
}

pub fn fmt-count(n: Float | Int) -> String {
    n >= 1.0e9 ? "{n / 1.0e9:.2}G"
  : n >= 1.0e6 ? "{n / 1.0e6:.2}M"
  : n >= 1.0e3 ? "{n / 1.0e3:.1}K"
  :              "{Int(n)}"
}

pub fn fmt-delta(ratio: Float) -> String {
    let pct = (ratio - 1.0) * 100.0
    if pct.abs < 0.5 {
        'same'
    } else if pct > 0 {
        "+{pct:.1}%"
    } else {
        "{pct:.1}%"
    }
}

// ---------------------------------------------------------------------------
//  Persistence (JSON results file)
// ---------------------------------------------------------------------------

pub fn save-results(path: String, results: [Result]) {
    let data = [r.to-dict() for r in results]
    let text = json.encode(data)
    with f = io.open(path, 'w') {
        f.write(text)
    }
}

pub fn load-results(path: String) -> Array[BenchRecord] | nil {
    try json.parse(SuiteRecord, Path(path).read-text()) else nil
}
