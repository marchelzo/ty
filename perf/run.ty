import os
import time (now)
import chalk (chalk)
import path (Path)
import clap (clap!)
import ty

import lib (
    run-one,
    load-benchmarks,
    load-results,
    save-results,
    matches-filter,
    Result,
    BenchRecord,
)
import sched (elevate, SCHED_ENV)
import history (
    DEFAULT_DATABASE,
    record-run,
    print-run,
    print-history,
    print-goats,
    latest-run-id,
    compare-runs,
    print-trend,
    check-run,
    set-status,
    benchmark-label,
    tag-label,
    mode-label,
    duration-label,
    delta-label,
)

let PERF_DIR = Path(__file__).parent
let JIT_SFX = if ty.jit { '_jit' } else { '' }
let RESULTS_FILE = "{PERF_DIR}/results{JIT_SFX}.json"

/** Run benchmarks and append the result to history. */
clap! RunOptions v1 {
    /// Benchmark name or tag filter (space-separated terms are ANDed)
    filter: String, pos: true

    /// Also compare with the disposable previous-run cache
    compare: Bool, short: 'c'

    /// Don't save the result cache or historical record
    noSave: Bool, short: 'S'

    /// Attach a note to this historical run
    note: String, short: None

    /// Number of warmup iterations
    warmup: Int, short: 'w', default: 3, check: 0..100

    /// Number of timed rounds
    rounds: Int, short: 'n', default: 5, check: 1..100

    /// CPU to pin benchmark processes to (Linux; default: fastest available)
    cpu: Int, short: None, check: 0..65536

    /// Don't pin benchmark processes or raise their scheduling priority
    noPin: Bool, short: 'P'
}

/** Browse available benchmarks and their tags. */
clap! ListOptions v1 {
    /// Only show benchmarks matching this name/tag filter
    filter: String, pos: true
}

/** View recent benchmark runs. */
clap! HistoryOptions v1 {
    /// Maximum number of runs to show
    limit: Int, short: 'n', default: 20, check: 1..1000

    /// Only show eligible runs
    eligible: Bool, short: 'e'

    /// Only show runs containing a matching benchmark
    filter: String, short: 'f'
}

/** View one run and all of its benchmark results. */
clap! ShowOptions v1 {
    /// Run ID (default: latest)
    runId: Int, pos: true

    /// Verbose output (include the list of dirty files and the binary's build options)
    verbose: Bool
}

/** Compare one run with the best recorded times or another run. */
clap! CompareOptions v1 {
    /// Run ID (default: latest)
    runId: Int, pos: true

    /// Other run ID (default: best time from any other run)
    against: Int, pos: true
}

/** Visualize a benchmark over time. */
clap! TrendOptions v1 {
    /// Benchmark name filter
    benchmark: String, pos: true, required: true

    /// Maximum number of measurements
    limit: Int, short: 'n', default: 20, check: 1..1000

    /// Include dirty, partial, and anomalous measurements
    all: Bool, short: 'a'
}

/** Exit nonzero when a run is slower than the best recorded times or has anomalies. */
clap! CheckOptions v1 {
    /// Run ID (default: latest)
    runId: Int, pos: true

    /// Regression threshold as a percentage
    threshold: Float, short: 't', default: 5.0, check: 0..100
}

/** Mark a run as eligible or excluded. */
clap! StatusOptions v1 {
    /// Run ID
    runId: Int, pos: true, required: true

    /// auto, eligible, or excluded
    status: String, pos: true, required: true

    /// Explain the manual decision
    reason: String, short: 'r'
}

/** Show the record holder for each benchmark and its lead over the runner-up. */
clap! GoatsOptions v1 {
    /// Only show benchmarks matching this name filter
    filter: String, pos: true
}

/** Ty performance suite — benchmark, inspect history, and catch regressions. */
clap! Perf v1 {
    /// SQLite history database
    database: String, short: None, default: DEFAULT_DATABASE

    /// Run benchmarks
    cmd run: RunOptions

    /// List benchmarks
    cmd list: ListOptions

    /// View recent recorded runs
    cmd history: HistoryOptions

    /// View one recorded run
    cmd show: ShowOptions

    /// Compare runs or compare a run with the best recorded times
    cmd compare: CompareOptions

    /// Visualize a benchmark over time
    cmd trend: TrendOptions

    /// Check a run for regressions
    cmd check: CheckOptions

    /// Override a run's eligibility
    cmd status: StatusOptions

    /// Show the best run for each benchmark
    cmd goats: GoatsOptions
}

let COMMANDS = ['run', 'list', 'history', 'show', 'compare', 'trend', 'check', 'status', 'goats']

fn normalized-argv() -> [String] {
    let args = argv
    if #args == 1 { return [args[0], 'run'] }
    if args[1] == '--list' { return [args[0], 'list', *args.slice(2)] }
    if args[1] in ['-h', '--help', '--version', '--completions'] { return args }
    if args[1] == '--database' && #args >= 4 && args[3] in COMMANDS { return args }
    if args[1].starts?('--database=') && #args >= 3 && args[2] in COMMANDS { return args }
    if args[1] not in COMMANDS { return [args[0], 'run', *args.slice(1)] }
    args
}

fn benchmarks() {
    load-benchmarks(PERF_DIR / 'benchmarks').sort(by: \_.name)
}

fn print-catalog(opts: ListOptions) {
    let entries = benchmarks()
    if opts.filter {
        entries = entries.filter(entry -> matches-filter(entry, opts.filter))
    }
    if #entries == 0 {
        print(chalk"[yellow bold]No benchmarks matched[/] '{opts.filter}'.")
        return
    }

    let width: Int = max(12, entries.map(\#_.name).max() ?? 12) + 2
    print(chalk"[bold bright cyan]Ty benchmark catalog[/]  [dim]{#entries} benchmark(s)[/]")
    print(chalk"[dim]Filter by name or combine tags: perf/run.ty run 'numeric float'[/]")
    print()
    print(chalk"[bold]  {'Benchmark':{width}} Tags[/]")
    print(chalk"[dim]  {'─'.repeat(width + 62)}[/]")
    for entry in entries {
        let tags = entry.tags.map(tag-label).join(' · ')
        print(chalk"  {benchmark-label(entry.name, width)} {tags}")
    }
}

fn print-comparison(
    title: String,
    ref-map: Dict[String, BenchRecord],
    results: [Result],
    name-width: Int,
) {
    print()
    print(chalk"[bold bright cyan]{title}[/]")
    print()
    for r in results {
        let label = benchmark-label(r.name, name-width)
        if let $old = ref-map[r.name] {
            let ratio = r.med / old.median
            let verdict = ratio < 0.95 ? 'improvement'
                        : ratio > 1.05 ? 'regression'
                        :                'stable'
            print(chalk"  {label} {duration-label(old.median, role='baseline', width=10)} "
                       "[dim]→[/] {duration-label(r.med, verdict=verdict, width=10)}  "
                       "{delta-label(ratio)}")
        } else {
            print(chalk"  {label} [dim]no previous data[/]")
        }
    }
}

fn run-suite(opts: RunOptions, database: String) {
    let all = benchmarks()
    let running = opts.filter
        ? all.filter(entry -> matches-filter(entry, opts.filter))
        : all
    if #running == 0 {
        print(chalk"[red bold]No benchmarks matched[/] '{opts.filter}'.")
        print(chalk"[dim]Use 'perf/run.ty list' to browse names and tags.[/]")
        os.exit(1)
    }

    unsetenv(SCHED_ENV)
    let settings = opts.noPin ? [] : elevate(opts.cpu)

    let mode = ty.jit ? 'jit' : 'interpreter'
    print(chalk"[bold bright cyan]Ty performance suite[/]  {mode-label(mode)}")
    print(chalk"[cyan]{#running} benchmark(s)[/] [dim]· {opts.rounds} rounds · "
               "{opts.warmup} warmup[/]")
    print(chalk"[dim]{settings.join(' · ') || 'default scheduling'}[/]")
    print()

    let started = now()
    let results: [Result] = []
    let name-width: Int = (running.map(\#_.name).max() ?? 0) + 2
    for entry in running {
        let label = benchmark-label(entry.name, name-width)
        print(chalk"{label} [dim]calibrating…[/]", end='', flush=true)
        let r = run-one(entry, warmup=opts.warmup, rounds=opts.rounds)
        results.push(r)
        print("\r\x1b[K", end='')
        print(chalk"{label} {duration-label(r.med, width=10)}[dim]/iter[/] "
                   "[dim]±[/] {duration-label(r.sd, role='spread', width=9)}  "
                   "[dim]{r.iters:>7} iters × {opts.rounds:>3} rounds[/]")
    }

    if opts.compare {
        if let $previous = load-results(RESULTS_FILE) {
            print-comparison(
                'Previous-run cache', %{e.name: e for e in previous},
                results, name-width
            )
        } else {
            print(chalk"\n[dim]No previous-run cache.[/]")
        }
    }

    print()
    print(chalk"[bold]Total:[/] {duration-label(results.map(\_.med).sum(0.0))}")
    if opts.noSave { return }

    let run-id = record-run(
        database, results, mode, opts.warmup, opts.rounds, opts.filter,
        #all, now() - started, opts.note
    )
    save-results(RESULTS_FILE, results)
    print()
    print-run(database, run-id)
}

fn required-run-id(database: String, requested: Int | nil) -> Int {
    requested ?? latest-run-id(database)
        ?? throw ValueError('no performance runs have been recorded')
}

fn main() {
    let (opts, _) = Perf.parse(normalized-argv())
    match opts.cmd {
        run: RunOptions => run-suite(run, opts.database),
        list: ListOptions => print-catalog(list),
        history: HistoryOptions => print-history(
            opts.database, history.limit, !history.eligible, history.filter
        ),
        show: ShowOptions => print-run(
            opts.database, required-run-id(opts.database, show.runId), show.verbose
        ),
        compare: CompareOptions => compare-runs(
            opts.database, required-run-id(opts.database, compare.runId), compare.against
        ),
        trend: TrendOptions => print-trend(
            opts.database, trend.benchmark, trend.limit, trend.all
        ),
        check: CheckOptions => {
            let ok = check-run(
                opts.database, required-run-id(opts.database, check.runId),
                check.threshold / 100.0
            )
            if !ok { os.exit(1) }
        },
        status: StatusOptions => set-status(
            opts.database, status.runId, status.status, status.reason
        ),
        goats: GoatsOptions => print-goats(opts.database, goats.filter),
        _ => nil
    }
}

main()
