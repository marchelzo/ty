|.arch arm64
|.actionlist lir_actions
|.section code, cold
|
|.macro W2, ins, x, y
|| if (narrow) {
|  ins Rw(x), Rw(y)
|| } else {
|  ins Rx(x), Rx(y)
|| }
|.endmacro
|
|.macro W3, ins, x, y, z
|| if (narrow) {
|  ins Rw(x), Rw(y), Rw(z)
|| } else {
|  ins Rx(x), Rx(y), Rx(z)
|| }
|.endmacro
|
|.macro W4, ins, x, y, z, w
|| if (narrow) {
|  ins Rw(x), Rw(y), Rw(z), Rw(w)
|| } else {
|  ins Rx(x), Rx(y), Rx(z), Rx(w)
|| }
|.endmacro
|
|.macro WI, ins, x, y, imm
|| if (narrow) {
|  ins Rw(x), Rw(y), #imm
|| } else {
|  ins Rx(x), Rx(y), #imm
|| }
|.endmacro
|
|.macro WZ, ins, x
|| if (narrow) {
|  ins Rw(x), >1
|| } else {
|  ins Rx(x), >1
|| }
|.endmacro
|
|.macro F2, ins, x, y
|| if (narrow) {
|  ins Rs(x), Rs(y)
|| } else {
|  ins Rd(x), Rd(y)
|| }
|.endmacro
|
|.macro F3, ins, x, y, z
|| if (narrow) {
|  ins Rs(x), Rs(y), Rs(z)
|| } else {
|  ins Rd(x), Rd(y), Rd(z)
|| }
|.endmacro
|
|.macro F4, ins, x, y, z, w
|| if (narrow) {
|  ins Rs(x), Rs(y), Rs(z), Rs(w)
|| } else {
|  ins Rd(x), Rd(y), Rd(z), Rd(w)
|| }
|.endmacro

static void
label(dasm_State **Dst, u32 label)
{
        |=>label:
}

static void
jump(dasm_State **Dst, u32 label)
{
        | b =>label
}

static void
li(dasm_State **Dst, u8 d, u64 bits)
{
        | movz Rx(d), #(bits & 0xffff)
        if ((bits >> 16) & 0xffff) {
                | movk Rx(d), #((bits >> 16) & 0xffff), lsl #16
        }
        if ((bits >> 32) & 0xffff) {
                | movk Rx(d), #((bits >> 32) & 0xffff), lsl #32
        }
        if ((bits >> 48) & 0xffff) {
                | movk Rx(d), #((bits >> 48) & 0xffff), lsl #48
        }
}

static void
mov(dasm_State **Dst, u8 d, u8 a, LirClass cls, bool from_gp, bool to_gp)
{
        bool narrow = (cls == LIR_I32) || (cls == LIR_F32);

        if (d == a && from_gp == to_gp) {
                return;
        }

        if (cls != LIR_F32 && cls != LIR_F64) {
                | W2 mov, d, a
        } else if (from_gp && narrow) {
                | fmov Rs(d), Rw(a)
        } else if (from_gp) {
                | fmov Rd(d), Rx(a)
        } else if (to_gp && narrow) {
                | fmov Rw(d), Rs(a)
        } else if (to_gp) {
                | fmov Rx(d), Rd(a)
        } else {
                | F2 fmov, d, a
        }
}

static void
addr(dasm_State **Dst, u8 d, u8 base, i64 disp)
{
        if (disp >= 0 && disp <= 4095) {
                | add Rx(d), Rx(base), #disp
        } else if (disp < 0 && disp >= -4095) {
                | sub Rx(d), Rx(base), #(-disp)
        } else {
                li(Dst, TMP1, disp);
                | add Rx(d), Rx(base), x17
        }
}

static void
mem(dasm_State **Dst, bool w, u8 r, u8 base, i64 disp, u32 size, bool sign, bool fp)
{
        if (disp < 0 || (u64)disp > 4095 * size || disp % size != 0) {
                addr(Dst, TMP1, base, disp);
                base = TMP1;
                disp = 0;
        }

        if (fp && size == 4) {
                if (w) {
                        | str Rs(r), [Rx(base), #disp]
                } else {
                        | ldr Rs(r), [Rx(base), #disp]
                }
        } else if (fp) {
                if (w) {
                        | str Rd(r), [Rx(base), #disp]
                } else {
                        | ldr Rd(r), [Rx(base), #disp]
                }
        } else if (size == 1) {
                if (w) {
                        | strb Rw(r), [Rx(base), #disp]
                } else if (sign) {
                        | ldrsb Rx(r), [Rx(base), #disp]
                } else {
                        | ldrb Rw(r), [Rx(base), #disp]
                }
        } else if (size == 2) {
                if (w) {
                        | strh Rw(r), [Rx(base), #disp]
                } else if (sign) {
                        | ldrsh Rx(r), [Rx(base), #disp]
                } else {
                        | ldrh Rw(r), [Rx(base), #disp]
                }
        } else if (size == 4) {
                if (w) {
                        | str Rw(r), [Rx(base), #disp]
                } else if (sign) {
                        | ldrsw Rx(r), [Rx(base), #disp]
                } else {
                        | ldr Rw(r), [Rx(base), #disp]
                }
        } else if (w) {
                | str Rx(r), [Rx(base), #disp]
        } else {
                | ldr Rx(r), [Rx(base), #disp]
        }
}

static void
peek(dasm_State **Dst, u32 offset)
{
        if (offset <= 4095 * 8 && offset % 8 == 0) {
                | ldr x16, [x29, #offset]
        } else {
                li(Dst, TMP0, offset);
                | add x16, x29, x16
                | ldr x16, [x16]
        }
}

static void
stack_bounds(dasm_State **Dst, u32 ty_slot, u32 base, u32 end)
{
        peek(Dst, ty_slot);
        ld(Dst, TMP0, TMP0, offsetof(Ty, stack.items));
        st(Dst, TMP0, FRAME, base);
        peek(Dst, ty_slot);
        ld(Dst, TMP0, TMP0, offsetof(Ty, stack.capacity));
        ld(Dst, TMP1, FRAME, base);
        | add x16, x17, x16, lsl #5
        st(Dst, TMP0, FRAME, end);
}

static void
rebase_check(dasm_State **Dst, u32 base, u32 stub)
{
        ld(Dst, TMP1, FRAME, base);
        | cmp x16, x17
        | bne =>stub
}

static void
rebase_delta(dasm_State **Dst, u32 ty_slot, u32 base)
{
        peek(Dst, ty_slot);
        ld(Dst, TMP0, TMP0, offsetof(Ty, stack.items));
        ld(Dst, TMP1, FRAME, base);
        | sub x16, x16, x17
}

static void
rebase_pointer(dasm_State **Dst, u8 p, u32 ty_slot, u32 base, u32 end)
{
        peek(Dst, base);
        | cmp Rx(p), x16
        | blo >1
        peek(Dst, end);
        | cmp Rx(p), x16
        | bhs >1
        peek(Dst, base);
        | sub Rx(p), Rx(p), x16
        peek(Dst, ty_slot);
        ld(Dst, TMP0, TMP0, offsetof(Ty, stack.items));
        | add Rx(p), Rx(p), x16
        |1:
}

static void
cold(dasm_State **Dst)
{
        |.cold
}

static void
hot(dasm_State **Dst)
{
        |.code
}

static void
fli(dasm_State **Dst, u8 d, LirClass cls, u32 label)
{
        if (cls == LIR_F32) {
                | ldr Rs(d), =>label
        } else {
                | ldr Rd(d), =>label
        }
}

static void
literal(dasm_State **Dst, u32 label, u64 bits)
{
        |.align 8
        |=>label:
        |.quad bits
}

static void
prologue(dasm_State **Dst, u32 frame, u32 align, u32 origin)
{
        | stp x29, x30, [sp, #-16]!
        | mov x17, sp
        if (frame <= 4095) {
                | sub sp, sp, #frame
        } else {
                li(Dst, TMP0, frame);
                | sub sp, sp, x16
        }
        if (align > 16) {
                | mov x16, sp
                | and x16, x16, #(-(i64)align)
                | mov sp, x16
        }
        | mov x29, sp
        | mov x16, x17
        st(Dst, TMP0, FRAME, origin);
}

static void
epilogue(dasm_State **Dst, u32 origin, bool tail)
{
        ld(Dst, TMP1, FRAME, origin);
        | mov sp, x17
        | ldp x29, x30, [sp], #16
        if (tail) {
                | br x16
        } else {
                | ret
        }
}

static void
thunk(dasm_State **Dst, u32 label, u32 pc_slot)
{
        |=>label:
        st(Dst, 30, FRAME, pc_slot);
        | blr x16
        ld(Dst, 30, FRAME, pc_slot);
        | ret
}

static void
vm_top(dasm_State **Dst, u8 d, u8 ty)
{
        ld(Dst, d, ty, offsetof(Ty, stack.items));
        ld(Dst, TMP1, ty, offsetof(Ty, stack.count));
        | add Rx(d), Rx(d), x17, lsl #5
}

static void
vm_slots(dasm_State **Dst, u8 d, u8 ty, u32 top_slot)
{
        ld(Dst, d, ty, offsetof(Ty, stack.items));
        ld(Dst, TMP1, FRAME, top_slot);
        | add Rx(d), Rx(d), x17, lsl #5
}

static void
call(dasm_State **Dst, bool site, u32 thunk, u32 pc_slot)
{
        if (site) {
                | bl =>thunk
        } else {
                | blr x16
        }
}

static void
twice(dasm_State **Dst, u32 slot, u32 label)
{
        | adr x17, =>label
        if (slot <= 4095 * 8 && slot % 8 == 0) {
                st(Dst, TMP1, FRAME, slot);
        } else {
                | str x16, [sp, #-16]!
                | mov x16, x17
                st(Dst, TMP0, FRAME, slot);
                | ldr x16, [sp], #16
        }
        | blr x16
}

static void
varargs(dasm_State **Dst, u32 nf)
{
}

static void
alui(dasm_State **Dst, LirOp op, u8 d, u8 a, u64 imm, bool narrow)
{
        i32 n = imm;

        switch (op) {
        case LIR_ADD:
                | WI add, d, a, n
                break;
        case LIR_SHL:
                | WI lsl, d, a, n
                break;
        default:
                | WI sub, d, a, n
                break;
        }
}

static void
alu(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, bool narrow)
{
        switch (op) {
        case LIR_ADD:
                | W3 add, d, a, b
                break;
        case LIR_SUB:
                | W3 sub, d, a, b
                break;
        case LIR_MUL:
                | W3 mul, d, a, b
                break;
        case LIR_SDIV:
                | W3 sdiv, d, a, b
                break;
        case LIR_UDIV:
                | W3 udiv, d, a, b
                break;
        case LIR_AND:
                | W3 and, d, a, b
                break;
        case LIR_OR:
                | W3 orr, d, a, b
                break;
        case LIR_XOR:
                | W3 eor, d, a, b
                break;
        case LIR_SHL:
                | W3 lsl, d, a, b
                break;
        case LIR_SHR:
                | W3 lsr, d, a, b
                break;
        case LIR_SAR:
                | W3 asr, d, a, b
                break;
        case LIR_ROTR:
                | W3 ror, d, a, b
                break;
        case LIR_SREM:
                | W3 sdiv, TMP0, a, b
                | W4 msub, d, TMP0, b, a
                break;
        case LIR_UREM:
                | W3 udiv, TMP0, a, b
                | W4 msub, d, TMP0, b, a
                break;
        case LIR_MULHS:
                if (narrow) {
                        | smull x16, Rw(a), Rw(b)
                        | lsr x16, x16, #32
                        | mov Rw(d), w16
                } else {
                        | smulh Rx(d), Rx(a), Rx(b)
                }
                break;
        case LIR_MULHU:
                if (narrow) {
                        | umull x16, Rw(a), Rw(b)
                        | lsr x16, x16, #32
                        | mov Rw(d), w16
                } else {
                        | umulh Rx(d), Rx(a), Rx(b)
                }
                break;
        }
}

static void
popcnt(dasm_State **Dst, u8 d, u8 a, bool narrow)
{
        if (narrow) {
                | fmov s31, Rw(a)
        } else {
                | fmov d31, Rx(a)
        }
        |.long 0x0e205bff
        |.long 0x0e31bbff
        | fmov Rw(d), s31
}

static void
unary(dasm_State **Dst, LirOp op, u8 d, u8 a, bool narrow)
{
        switch (op) {
        case LIR_POPCNT:
                popcnt(Dst, d, a, narrow);
                break;
        case LIR_NEG:
                | W2 neg, d, a
                break;
        case LIR_NOT:
                | W2 mvn, d, a
                break;
        case LIR_CLZ:
                | W2 clz, d, a
                break;
        case LIR_BSWAP:
                | W2 rev, d, a
                break;
        case LIR_CTZ:
                | W2 rbit, TMP0, a
                | W2 clz, d, TMP0
                break;
        case LIR_SEXT8:
                | W2 sxtb, d, a
                break;
        case LIR_SEXT16:
                | W2 sxth, d, a
                break;
        case LIR_SEXT32:
                if (narrow) {
                        | mov Rw(d), Rw(a)
                } else {
                        | sxtw Rx(d), Rw(a)
                }
                break;
        case LIR_ZEXT8:
                | uxtb Rw(d), Rw(a)
                break;
        case LIR_ZEXT16:
                | uxth Rw(d), Rw(a)
                break;
        case LIR_ZEXT32:
                | mov Rw(d), Rw(a)
                break;
        }
}

static void
fop(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, u8 c, bool narrow)
{
        switch (op) {
        case LIR_FADD:
                | F3 fadd, d, a, b
                break;
        case LIR_FSUB:
                | F3 fsub, d, a, b
                break;
        case LIR_FMUL:
                | F3 fmul, d, a, b
                break;
        case LIR_FDIV:
                | F3 fdiv, d, a, b
                break;
        case LIR_FMIN:
                | F3 fminnm, d, a, b
                break;
        case LIR_FMAX:
                | F3 fmaxnm, d, a, b
                break;
        case LIR_FSQRT:
                | F2 fsqrt, d, a
                break;
        case LIR_FABS:
                | F2 fabs, d, a
                break;
        case LIR_FNEG:
                | F2 fneg, d, a
                break;
        case LIR_FMA:
                | F4 fmadd, d, a, b, c
                break;
        }
}

static void
compare(dasm_State **Dst, u8 a, u8 b, LirClass cls)
{
        switch (cls) {
        case LIR_I32:
                | cmp Rw(a), Rw(b)
                break;
        case LIR_F32:
                | fcmp Rs(a), Rs(b)
                break;
        case LIR_F64:
                | fcmp Rd(a), Rd(b)
                break;
        default:
                | cmp Rx(a), Rx(b)
                break;
        }
}

static void
cmpz(dasm_State **Dst, u8 a, LirClass cls)
{
        compare(Dst, a, 31, cls);
}

static void
branch(dasm_State **Dst, LirCC cc, u32 label)
{
        switch (cc) {
        case LIR_EQ:
        case LIR_FEQ:
                | bne >1
                break;
        case LIR_NE:
        case LIR_FNE:
                | beq >1
                break;
        case LIR_LT:
                | bge >1
                break;
        case LIR_LE:
                | bgt >1
                break;
        case LIR_GT:
        case LIR_FGT:
                | ble >1
                break;
        case LIR_GE:
        case LIR_FGE:
                | blt >1
                break;
        case LIR_ULT:
                | bhs >1
                break;
        case LIR_ULE:
        case LIR_FLE:
                | bhi >1
                break;
        case LIR_UGT:
                | bls >1
                break;
        case LIR_UGE:
                | blo >1
                break;
        case LIR_FLT:
                | bpl >1
                break;
        case LIR_FUN:
                | bvc >1
                break;
        }
        | b =>label
        |1:
}

static void
pick(dasm_State **Dst, u8 d, u8 a, u8 b, LirClass cls, u32 yes, u32 end)
{
        mov(Dst, d, b, cls, false, false);
        jump(Dst, end);
        label(Dst, yes);
        mov(Dst, d, a, cls, false, false);
        label(Dst, end);
}

static void
setcc(dasm_State **Dst, u8 d, LirCC cc, u32 yes, u32 end)
{
        switch (cc) {
        case LIR_EQ:
        case LIR_FEQ:
                | cset Rx(d), eq
                break;
        case LIR_NE:
        case LIR_FNE:
                | cset Rx(d), ne
                break;
        case LIR_LT:
                | cset Rx(d), lt
                break;
        case LIR_LE:
                | cset Rx(d), le
                break;
        case LIR_GT:
        case LIR_FGT:
                | cset Rx(d), gt
                break;
        case LIR_GE:
        case LIR_FGE:
                | cset Rx(d), ge
                break;
        case LIR_ULT:
                | cset Rx(d), lo
                break;
        case LIR_ULE:
        case LIR_FLE:
                | cset Rx(d), ls
                break;
        case LIR_UGT:
                | cset Rx(d), hi
                break;
        case LIR_UGE:
                | cset Rx(d), hs
                break;
        case LIR_FLT:
                | cset Rx(d), mi
                break;
        case LIR_FUN:
                | cset Rx(d), vs
                break;
        }
}

static void
brz(dasm_State **Dst, u8 a, bool nonzero, bool narrow, u32 label)
{
        if (nonzero) {
                | WZ cbz, a
        } else {
                | WZ cbnz, a
        }
        | b =>label
        |1:
}

inline static bool
wide(LirClass cls)
{
        return (cls == LIR_I64) || (cls == LIR_PTR) || (cls == LIR_REF);
}

static void
convert(dasm_State **Dst, LirOp op, u8 d, u8 a, LirClass dst, LirClass src)
{
        bool sign = (op == LIR_I2F);
        bool word = (src == LIR_I32);

        switch (op) {
        case LIR_I2F:
        case LIR_U2F:
                if (dst == LIR_F32 && word) {
                        if (sign) {
                                | scvtf Rs(d), Rw(a)
                        } else {
                                | ucvtf Rs(d), Rw(a)
                        }
                } else if (dst == LIR_F32) {
                        if (sign) {
                                | scvtf Rs(d), Rx(a)
                        } else {
                                | ucvtf Rs(d), Rx(a)
                        }
                } else if (word) {
                        if (sign) {
                                | scvtf Rd(d), Rw(a)
                        } else {
                                | ucvtf Rd(d), Rw(a)
                        }
                } else if (sign) {
                        | scvtf Rd(d), Rx(a)
                } else {
                        | ucvtf Rd(d), Rx(a)
                }
                break;

        case LIR_F2I:
                if (dst == LIR_I32 && src == LIR_F32) {
                        | fcvtzs Rw(d), Rs(a)
                } else if (dst == LIR_I32) {
                        | fcvtzs Rw(d), Rd(a)
                } else if (src == LIR_F32) {
                        | fcvtzs Rx(d), Rs(a)
                } else {
                        | fcvtzs Rx(d), Rd(a)
                }
                break;

        case LIR_FEXT:
                | fcvt Rd(d), Rs(a)
                break;

        case LIR_FTRUNC:
                | fcvt Rs(d), Rd(a)
                break;

        case LIR_BITCAST:
                if (src == dst || (wide(src) && wide(dst))) {
                        mov(Dst, d, a, dst, false, false);
                } else if (dst == LIR_F32) {
                        | fmov Rs(d), Rw(a)
                } else if (dst == LIR_F64) {
                        | fmov Rd(d), Rx(a)
                } else if (src == LIR_F32) {
                        | fmov Rw(d), Rs(a)
                } else {
                        | fmov Rx(d), Rd(a)
                }
                break;
        }
}

static void
fit(dasm_State **Dst, u8 d, LirType type)
{
        switch (type) {
        case LT_I8:
                | sxtb Rx(d), Rx(d)
                break;
        case LT_U8:
                | uxtb Rw(d), Rw(d)
                break;
        case LT_I16:
                | sxth Rx(d), Rx(d)
                break;
        case LT_U16:
                | uxth Rw(d), Rw(d)
                break;
        case LT_I32:
                | sxtw Rx(d), Rw(d)
                break;
        case LT_U32:
                | mov Rw(d), Rw(d)
                break;
        case LT_BOOL:
                | cmp Rx(d), #0
                | cset Rx(d), ne
                break;
        }
}

static void
checked(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, bool narrow)
{
        switch (op) {
        case LIR_ADDO:
                | W3 adds, d, a, b
                break;
        case LIR_SUBO:
                | W3 subs, d, a, b
                break;
        default:
                if (narrow) {
                        | smull x16, Rw(a), Rw(b)
                        | mov Rw(d), w16
                        | sxtw x17, Rw(d)
                        | cmp x16, x17
                } else {
                        | smulh x16, Rx(a), Rx(b)
                        | mul Rx(d), Rx(a), Rx(b)
                        | asr x17, Rx(d), #63
                        | cmp x16, x17
                }
                break;
        }
}

static void
overflow(dasm_State **Dst, LirOp op, u32 label)
{
        if (op == LIR_MULO) {
                | beq >1
        } else {
                | bvc >1
        }
        | b =>label
        |1:
}

static void
lea(dasm_State **Dst, u8 d, u8 base, u8 index, u8 scale, i32 disp, bool narrow)
{
        if (index == LIR_PHYS_NONE) {
                addr(Dst, d, base, disp);
                return;
        }

        u32 shift = __builtin_ctz(scale);

        if (narrow) {
                | add Rx(d), Rx(base), Rw(index), uxtw #shift
        } else {
                | add Rx(d), Rx(base), Rx(index), lsl #shift
        }

        if (disp != 0) {
                addr(Dst, d, d, disp);
        }
}

static void
copy32(dasm_State **Dst, u8 dst, i32 ddisp, u8 src, i32 sdisp)
{
        for (i32 i = 0; i < 32; i += 8) {
                ld(Dst, TMP0, src, sdisp + i);
                st(Dst, TMP0, dst, ddisp + i);
        }
}

static void
zero(dasm_State **Dst, u8 base)
{
        st(Dst, 31, base, 0);
}

static void
fence(dasm_State **Dst)
{
        |.long 0xd5033bbf
}

static bool
raw(dasm_State **Dst, LirRaw const *r)
{
        for (u32 i = 0; i < r->narm64; ++i) {
                |.long r->arm64[i]
        }

        return r->narm64 != 0;
}

static void
atomic(
        dasm_State **Dst,
        LirOp op,
        u8 d,
        u8 address,
        u8 expected,
        u8 value,
        bool narrow,
        u32 loop,
        u32 done
)
{
        u32 base = (u32)address << 5;

        label(Dst, loop);

        if (narrow) {
                |.long (0x885ffc00u | base | d)
                if (op == LIR_CAS) {
                        | cmp Rw(d), Rw(expected)
                        | bne =>done
                        |.long (0x8811fc00u | base | value)
                } else if (op == LIR_XADD) {
                        | add w15, Rw(d), Rw(expected)
                        |.long (0x8811fc00u | base | 15)
                } else {
                        |.long (0x8811fc00u | base | expected)
                }
        } else {
                |.long (0xc85ffc00u | base | d)
                if (op == LIR_CAS) {
                        | cmp Rx(d), Rx(expected)
                        | bne =>done
                        |.long (0xc811fc00u | base | value)
                } else if (op == LIR_XADD) {
                        | add x15, Rx(d), Rx(expected)
                        |.long (0xc811fc00u | base | 15)
                } else {
                        |.long (0xc811fc00u | base | expected)
                }
        }

        | cbnz w17, =>loop
        label(Dst, done);
        |.long 0xd5033f5f
}

static void
table(dasm_State **Dst, u32 label, LirLabel const *targets, u32 n)
{
        |.align 8
        |=>label:
        for (u32 i = 0; i < n; ++i) {
                |.quad 0
        }
}

static void
jtab(dasm_State **Dst, u8 a, u32 n, u32 fallback, u32 table)
{
        li(Dst, TMP1, n);
        | cmp Rx(a), x17
        | blo >1
        | b =>fallback
        |1:
        | mov x17, Rx(a)
        | adr x16, =>table
        | ldr x17, [x16, x17, lsl #3]
        | br x17
}

static bool
legalize(Ty *ty, Lir *L, LirConstraint **out, u32 *nout, LirError *err)
{
        vec(LirConstraint) cs = {0};

        for (u32 pc = 0; pc < vN(L->insts); ++pc) {
                LirInst const *in = v_(L->insts, pc);

                switch (in->op) {
                case LIR_POPCNT:
                        svP(cs, fix(pc, LIR_NONE, 31, true, true));
                        break;

                case LIR_CAS:
                case LIR_XADD:
                case LIR_XCHG:
                        svP(cs, fix(pc, in->args[0].mem.base, TMP0, false, false));
                        svP(cs, fix(pc, in->args[1].reg,      14,   false, false));
                        svP(cs, fix(pc, in->dst,              13,   true,  false));
                        svP(cs, fix(pc, LIR_NONE,             15,   true,  false));
                        if (in->op == LIR_CAS) {
                                svP(cs, fix(pc, in->args[2].reg, 12, false, false));
                        }
                        break;
                }
        }

        *out  = vv(cs);
        *nout = vN(cs);

        return true;
}

static LirTarget const Native = {
        .arch        = LIR_ARCH_ARM64,
#ifdef __APPLE__
        .abi         = LIR_ABI_APPLE_ARM64,
#else
        .abi         = LIR_ABI_AAPCS64,
#endif
        .name        = "arm64",
        .gpr         = {
                .available    = 0x1ff8ffff,
                .callee_saved = 0x1ff80000,
                .args         = { 0, 1, 2, 3, 4, 5, 6, 7 },
                .nargs        = 8,
                .ret          = 0,
                .scratch      = { TMP0, TMP1 },
                .nscratch     = 2
        },
        .fpr         = {
                .available    = UINT32_MAX,
                .callee_saved = 0xff00,
                .args         = { 0, 1, 2, 3, 4, 5, 6, 7 },
                .nargs        = 8,
                .ret          = 0
        },
        .pins        = { 19, 20, 21, 22, 23, 24, 25, 26 },
        .npins       = 8,
        .stack_align = 16,
        .legalize    = legalize,
        .emit        = emit
};
