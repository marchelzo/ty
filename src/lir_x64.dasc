|.arch x64
|.actionlist lir_actions
|.section code, cold

static void
native_label(dasm_State **Dst, u32 label)
{
        |=>label:
}

static void
native_jump(dasm_State **Dst, u32 label)
{
        | jmp =>label
}

static void
native_li(dasm_State **Dst, u8 d, u64 bits)
{
        if (bits <= UINT32_MAX) {
                | mov Rd(d), (u32)bits
        } else if ((i64)bits >= INT32_MIN && (i64)bits < 0) {
                | mov Rq(d), (i32)bits
        } else {
                | mov64 Rq(d), bits
        }
}

static void
native_mov(dasm_State **Dst, u8 d, u8 a, LirClass cls, bool from_gp, bool to_gp)
{
        if (d == a && from_gp == to_gp) {
                return;
        }
        if (cls == LIR_F32 || cls == LIR_F64) {
                if (from_gp) {
                        if (cls == LIR_F32) {
                                | movd xmm(d), Rd(a)
                        } else {
                                | movd xmm(d), Rq(a)
                        }
                } else if (to_gp) {
                        if (cls == LIR_F32) {
                                | movd Rd(d), xmm(a)
                        } else {
                                | movd Rq(d), xmm(a)
                        }
                } else {
                        | movaps xmm(d), xmm(a)
                }
        } else if (cls == LIR_I32) {
                | mov Rd(d), Rd(a)
        } else {
                | mov Rq(d), Rq(a)
        }
}

static void
native_addr(dasm_State **Dst, u8 d, u8 base, i64 disp)
{
        | lea Rq(d), [Rq(base)+disp]
}

static void
native_copy32(dasm_State **Dst, u8 dst, i32 ddisp, u8 src, i32 sdisp)
{
        u8 t = src != 10 && dst != 10 ? 10 : src != 11 && dst != 11 ? 11 : LIR_PHYS_NONE;
        if (t != LIR_PHYS_NONE) {
                | mov Rq(t), [Rq(src)+sdisp]
                | mov [Rq(dst)+ddisp], Rq(t)
                | mov Rq(t), [Rq(src)+sdisp+8]
                | mov [Rq(dst)+ddisp+8], Rq(t)
        } else {
                | movq xmm14, qword [Rq(src)+sdisp]
                | movq qword [Rq(dst)+ddisp], xmm14
                | movq xmm14, qword [Rq(src)+sdisp+8]
                | movq qword [Rq(dst)+ddisp+8], xmm14
        }
        | movups xmm15, [Rq(src)+sdisp+16]
        | movups [Rq(dst)+ddisp+16], xmm15
}

static void
native_memory(dasm_State **Dst, bool write, u8 reg, u8 base, i64 disp,
              u32 size, bool sign, bool floating)
{
        if (floating) {
                if (size == 4) {
                        if (write) {
                                | movss dword [Rq(base)+disp], xmm(reg)
                        } else {
                                | movss xmm(reg), dword [Rq(base)+disp]
                        }
                } else {
                        if (write) {
                                | movsd qword [Rq(base)+disp], xmm(reg)
                        } else {
                                | movsd xmm(reg), qword [Rq(base)+disp]
                        }
                }
        } else if (size == 1) {
                if (write) {
                        | mov byte [Rq(base)+disp], Rb(reg)
                } else if (sign) {
                        | movsx Rq(reg), byte [Rq(base)+disp]
                } else {
                        | movzx Rd(reg), byte [Rq(base)+disp]
                }
        } else if (size == 2) {
                if (write) {
                        | mov word [Rq(base)+disp], Rw(reg)
                } else if (sign) {
                        | movsx Rq(reg), word [Rq(base)+disp]
                } else {
                        | movzx Rd(reg), word [Rq(base)+disp]
                }
        } else if (size == 4) {
                if (write) {
                        | mov dword [Rq(base)+disp], Rd(reg)
                } else if (sign) {
                        | movsxd Rq(reg), dword [Rq(base)+disp]
                } else {
                        | mov Rd(reg), dword [Rq(base)+disp]
                }
        } else if (write) {
                | mov qword [Rq(base)+disp], Rq(reg)
        } else {
                | mov Rq(reg), qword [Rq(base)+disp]
        }
}

static void
native_frame_read10(dasm_State **Dst, u32 offset)
{
        native_memory(Dst, false, 10, 5, offset, 8, false, false);
}

static void
native_stack_bounds(dasm_State **Dst, u32 ty_slot, u32 base, u32 end)
{
        native_frame_read10(Dst, ty_slot);
        native_memory(Dst, false, 10, 10, offsetof(Ty, stack.items), 8, false, false);
        native_memory(Dst, true, 10, 5, base, 8, false, false);
        native_frame_read10(Dst, ty_slot);
        native_memory(Dst, false, 10, 10, offsetof(Ty, stack.capacity), 8, false, false);
        | shl r10, 5
        native_memory(Dst, false, 11, 5, base, 8, false, false);
        | add r10, r11
        native_memory(Dst, true, 10, 5, end, 8, false, false);
}

static void
native_rebase_check(dasm_State **Dst, u32 base, u32 stub)
{
        native_memory(Dst, false, 11, 5, base, 8, false, false);
        | cmp r10, r11
        | jne =>stub
}

static void
native_rebase_delta(dasm_State **Dst, u32 ty_slot, u32 base)
{
        native_frame_read10(Dst, ty_slot);
        native_memory(Dst, false, 10, 10, offsetof(Ty, stack.items), 8, false, false);
        native_memory(Dst, false, 11, 5, base, 8, false, false);
        | sub r10, r11
}

static void
native_cold(dasm_State **Dst)
{
        |.cold
}

static void
native_hot(dasm_State **Dst)
{
        |.code
}

static void
native_rebase_pointer(dasm_State **Dst, u8 p, u32 ty_slot, u32 base, u32 end)
{
        native_frame_read10(Dst, base);
        | cmp Rq(p), r10
        | jb >1
        native_frame_read10(Dst, end);
        | cmp Rq(p), r10
        | jae >1
        native_frame_read10(Dst, base);
        | sub Rq(p), r10
        native_frame_read10(Dst, ty_slot);
        native_memory(Dst, false, 10, 10, offsetof(Ty, stack.items), 8, false, false);
        | add Rq(p), r10
        |1:
}

static void
native_fli(dasm_State **Dst, u8 d, LirClass cls, u32 label)
{
        if (cls == LIR_F32) {
                | movss xmm(d), dword [=>label]
        } else {
                | movsd xmm(d), qword [=>label]
        }
}

static void
native_literal(dasm_State **Dst, u32 label, u64 bits)
{
        |.align 8
        |=>label:
        |.quad bits
}

static void
native_prologue(dasm_State **Dst, u32 frame, u32 align, u32 origin)
{
        | push rbp
        | mov r11, rsp
        | sub rsp, frame
        if (align > 16) {
                | and rsp, -(i32)align
        }
        | mov rbp, rsp
        native_memory(Dst, true, 11, 5, origin, 8, false, false);
}

static void
native_epilogue(dasm_State **Dst, u32 origin, bool tail)
{
        native_memory(Dst, false, 11, 5, origin, 8, false, false);
        | mov rsp, r11
        | pop rbp
        if (tail) {
                | jmp r10
        } else {
                | ret
        }
}

static void
native_runtime_call(dasm_State **Dst, u32 label, u32 pc_slot)
{
        |=>label:
        | pop qword [rbp+pc_slot]
        | call r10
        | push qword [rbp+pc_slot]
        | ret
}

static void
native_vm_top(dasm_State **Dst, u8 d, u8 ty)
{
        native_memory(Dst, false, 11, ty, offsetof(Ty, stack.count), 8, false, false);
        native_memory(Dst, false, d, ty, offsetof(Ty, stack.items), 8, false, false);
        | shl r11, 5
        | add Rq(d), r11
}

static void
native_vm_slots(dasm_State **Dst, u8 d, u8 ty, u32 top_slot)
{
        native_memory(Dst, false, d, ty, offsetof(Ty, stack.items), 8, false, false);
        native_memory(Dst, false, 11, 5, top_slot, 8, false, false);
        | shl r11, 5
        | add Rq(d), r11
}

static void
native_call(dasm_State **Dst, bool site, u32 thunk, u32 pc_slot)
{
        if (site) {
                | lea r11, [>1]
                | mov [rbp+pc_slot], r11
                | call r10
                |1:
        } else {
                | call r10
        }
}

static void
native_varargs(dasm_State **Dst, u32 nf)
{
        | mov eax, nf
}

static void
native_integer_imm(dasm_State **Dst, LirOp op, u8 d, u8 a, u64 imm, bool narrow)
{
        i32 n = (i32)imm;
        native_mov(Dst, d, a, narrow ? LIR_I32 : LIR_I64, false, false);
        if (narrow) {
                switch (op) {
                case LIR_ADD:
                        | add Rd(d), n
                        break;
                case LIR_SUB:
                        | sub Rd(d), n
                        break;
                case LIR_AND:
                        | and Rd(d), n
                        break;
                case LIR_OR:
                        | or Rd(d), n
                        break;
                case LIR_XOR:
                        | xor Rd(d), n
                        break;
                case LIR_MUL:
                        | imul Rd(d), Rd(d), n
                        break;
                case LIR_SHL:
                        | shl Rd(d), (u8)n
                        break;
                case LIR_SHR:
                        | shr Rd(d), (u8)n
                        break;
                case LIR_SAR:
                        | sar Rd(d), (u8)n
                        break;
                case LIR_ROTR:
                        | ror Rd(d), (u8)n
                        break;
                default:
                        break;
                }
                return;
        }
        switch (op) {
        case LIR_ADD:
                | add Rq(d), n
                break;
        case LIR_SUB:
                | sub Rq(d), n
                break;
        case LIR_AND:
                | and Rq(d), n
                break;
        case LIR_OR:
                | or Rq(d), n
                break;
        case LIR_XOR:
                | xor Rq(d), n
                break;
        case LIR_MUL:
                | imul Rq(d), Rq(d), n
                break;
        case LIR_SHL:
                | shl Rq(d), (u8)n
                break;
        case LIR_SHR:
                | shr Rq(d), (u8)n
                break;
        case LIR_SAR:
                | sar Rq(d), (u8)n
                break;
        case LIR_ROTR:
                | ror Rq(d), (u8)n
                break;
        default:
                break;
        }
}

static void
native_compare_imm(dasm_State **Dst, u8 a, i64 imm, LirClass cls)
{
        if (cls == LIR_I32) {
                | cmp Rd(a), (i32)imm
        } else {
                | cmp Rq(a), (i32)imm
        }
}

static void
native_store_imm(dasm_State **Dst, u8 base, i64 disp, u32 size, i64 imm)
{
        switch (size) {
        case 1:
                | mov byte [Rq(base)+disp], (u8)imm
                break;
        case 2:
                | mov word [Rq(base)+disp], (u16)imm
                break;
        case 4:
                | mov dword [Rq(base)+disp], (i32)imm
                break;
        default:
                | mov qword [Rq(base)+disp], (i32)imm
                break;
        }
}

static void
native_divide(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, bool narrow)
{
        bool sign = op == LIR_SDIV || op == LIR_SREM;
        bool rem = op == LIR_SREM || op == LIR_UREM;
        LirClass cls = narrow ? LIR_I32 : LIR_I64;
        native_mov(Dst, 10, a, cls, false, false);
        native_mov(Dst, 11, b, cls, false, false);
        | test r11, r11
        | jz >1
        if (sign) {
                native_li(Dst, 0, narrow ? (u32)INT32_MIN : (u64)INT64_MIN);
                if (narrow) {
                        | cmp r10d, eax
                        | jne >2
                        | cmp r11d, -1
                } else {
                        | cmp r10, rax
                        | jne >2
                        | cmp r11, -1
                }
                | jne >2
                if (rem) {
                        | xor r10d, r10d
                }
                | jmp >3
                |2:
        }
        native_mov(Dst, 0, 10, cls, false, false);
        if (narrow) {
                if (sign) {
                        | cdq
                        | idiv r11d
                } else {
                        | xor edx, edx
                        | div r11d
                }
        } else if (sign) {
                | cqo
                | idiv r11
        } else {
                | xor edx, edx
                | div r11
        }
        native_mov(Dst, 10, rem ? 2 : 0, cls, false, false);
        | jmp >3
        |1:
        if (!rem) {
                | xor r10d, r10d
        }
        |3:
        native_mov(Dst, d, 10, cls, false, false);
}

static void
native_integer(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, bool narrow)
{
        LirClass cls = narrow ? LIR_I32 : LIR_I64;
        if (op == LIR_SDIV || op == LIR_UDIV || op == LIR_SREM || op == LIR_UREM) {
                native_divide(Dst, op, d, a, b, narrow);
                return;
        }
        bool plain = op == LIR_ADD || op == LIR_SUB || op == LIR_MUL || op == LIR_AND || op == LIR_OR || op == LIR_XOR;
        if (plain) {
                bool commutes = op != LIR_SUB;
                u8 x = a;
                u8 y = b;
                if (d == b && d != a) {
                        if (!commutes) {
                                goto Scratch;
                        }
                        x = b;
                        y = a;
                }
                native_mov(Dst, d, x, cls, false, false);
                if (narrow) {
                        switch (op) {
                        case LIR_ADD:
                                | add Rd(d), Rd(y)
                                break;
                        case LIR_SUB:
                                | sub Rd(d), Rd(y)
                                break;
                        case LIR_MUL:
                                | imul Rd(d), Rd(y)
                                break;
                        case LIR_AND:
                                | and Rd(d), Rd(y)
                                break;
                        case LIR_OR:
                                | or Rd(d), Rd(y)
                                break;
                        default:
                                | xor Rd(d), Rd(y)
                                break;
                        }
                } else {
                        switch (op) {
                        case LIR_ADD:
                                | add Rq(d), Rq(y)
                                break;
                        case LIR_SUB:
                                | sub Rq(d), Rq(y)
                                break;
                        case LIR_MUL:
                                | imul Rq(d), Rq(y)
                                break;
                        case LIR_AND:
                                | and Rq(d), Rq(y)
                                break;
                        case LIR_OR:
                                | or Rq(d), Rq(y)
                                break;
                        default:
                                | xor Rq(d), Rq(y)
                                break;
                        }
                }
                return;
        }
Scratch:
        native_mov(Dst, 10, a, cls, false, false);
        if (op == LIR_MULHS || op == LIR_MULHU) {
                native_mov(Dst, 11, b, cls, false, false);
                native_mov(Dst, 0, 10, cls, false, false);
                if (narrow) {
                        if (op == LIR_MULHS) {
                                | imul r11d
                        } else {
                                | mul r11d
                        }
                } else if (op == LIR_MULHS) {
                        | imul r11
                } else {
                        | mul r11
                }
                native_mov(Dst, d, 2, cls, false, false);
                return;
        }
        if (op == LIR_SHL || op == LIR_SHR || op == LIR_SAR || op == LIR_ROTR) {
                native_mov(Dst, 1, b, cls, false, false);
        }
        if (narrow) {
                switch (op) {
                case LIR_ADD:
                        | add Rd(10), Rd(b)
                        break;
                case LIR_SUB:
                        | sub Rd(10), Rd(b)
                        break;
                case LIR_MUL:
                        | imul Rd(10), Rd(b)
                        break;
                case LIR_AND:
                        | and Rd(10), Rd(b)
                        break;
                case LIR_OR:
                        | or Rd(10), Rd(b)
                        break;
                case LIR_XOR:
                        | xor Rd(10), Rd(b)
                        break;
                case LIR_SHL:
                        | shl Rd(10), cl
                        break;
                case LIR_SHR:
                        | shr Rd(10), cl
                        break;
                case LIR_SAR:
                        | sar Rd(10), cl
                        break;
                case LIR_ROTR:
                        | ror Rd(10), cl
                        break;
                default:
                        break;
                }
        } else {
                switch (op) {
                case LIR_ADD:
                        | add Rq(10), Rq(b)
                        break;
                case LIR_SUB:
                        | sub Rq(10), Rq(b)
                        break;
                case LIR_MUL:
                        | imul Rq(10), Rq(b)
                        break;
                case LIR_AND:
                        | and Rq(10), Rq(b)
                        break;
                case LIR_OR:
                        | or Rq(10), Rq(b)
                        break;
                case LIR_XOR:
                        | xor Rq(10), Rq(b)
                        break;
                case LIR_SHL:
                        | shl Rq(10), cl
                        break;
                case LIR_SHR:
                        | shr Rq(10), cl
                        break;
                case LIR_SAR:
                        | sar Rq(10), cl
                        break;
                case LIR_ROTR:
                        | ror Rq(10), cl
                        break;
                default:
                        break;
                }
        } 
        native_mov(Dst, d, 10, cls, false, false);
}

static void
native_unary(dasm_State **Dst, LirOp op, u8 d, u8 a, bool narrow)
{
        LirClass cls = narrow ? LIR_I32 : LIR_I64;
        native_mov(Dst, 10, a, cls, false, false);
        switch (op) {
        case LIR_NEG:
                if (narrow) {
                        | neg r10d
                } else {
                        | neg r10
                }
                break;
        case LIR_NOT:
                if (narrow) {
                        | not r10d
                } else {
                        | not r10
                }
                break;
        case LIR_BSWAP:
                if (narrow) {
                        | bswap r10d
                } else {
                        | bswap r10
                }
                break;
        case LIR_CLZ:
        case LIR_CTZ:
                | test r10, r10
                | jz >1
                if (op == LIR_CLZ) {
                        if (narrow) {
                                | bsr r10d, r10d
                                | xor r10d, 31
                        } else {
                                | bsr r10, r10
                                | xor r10d, 63
                        }
                } else if (narrow) {
                        | bsf r10d, r10d
                } else {
                        | bsf r10, r10
                }
                | jmp >2
                |1:
                native_li(Dst, 10, narrow ? 32 : 64);
                |2:
                break;
        case LIR_SEXT8:
                | movsx r10, r10b
                break;
        case LIR_SEXT16:
                | movsx r10, r10w
                break;
        case LIR_SEXT32:
                | movsxd r10, r10d
                break;
        case LIR_ZEXT8:
                | movzx r10d, r10b
                break;
        case LIR_ZEXT16:
                | movzx r10d, r10w
                break;
        case LIR_ZEXT32:
                | mov r10d, r10d
                break;
        default:
                break;
        }
        native_mov(Dst, d, 10, cls, false, false);
}

static void
native_popcnt(dasm_State **Dst, u8 d, u8 a, bool narrow)
{
        native_mov(Dst, 11, a, narrow ? LIR_I32 : LIR_I64, false, false);
        | xor r10d, r10d
        | test r11, r11
        | jz >2
        |1:
        | shr r11, 1
        | adc r10d, 0
        | test r11, r11
        | jnz <1
        |2:
        native_mov(Dst, d, 10, LIR_I64, false, false);
}

static void
native_float(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, u8 c, bool narrow)
{
        LirClass cls = narrow ? LIR_F32 : LIR_F64;
        if (op == LIR_FMA || op == LIR_FMIN || op == LIR_FMAX) {
                void *fn;
                switch (op) {
                case LIR_FMA: fn = narrow ? (void *)fmaf : (void *)fma; break;
                case LIR_FMIN: fn = narrow ? (void *)fminf : (void *)fmin; break;
                default: fn = narrow ? (void *)fmaxf : (void *)fmax; break;
                }
                native_li(Dst, 10, (uptr)fn);
                | call r10
                return;
        }
        native_mov(Dst, 14, a, cls, false, false);
        if (narrow) {
                switch (op) {
                case LIR_FADD:
                        | addss xmm14, xmm(b)
                        break;
                case LIR_FSUB:
                        | subss xmm14, xmm(b)
                        break;
                case LIR_FMUL:
                        | mulss xmm14, xmm(b)
                        break;
                case LIR_FDIV:
                        | divss xmm14, xmm(b)
                        break;
                case LIR_FSQRT:
                        | sqrtss xmm14, xmm14
                        break;
                default:
                        break;
                }
        } else {
                switch (op) {
                case LIR_FADD:
                        | addsd xmm14, xmm(b)
                        break;
                case LIR_FSUB:
                        | subsd xmm14, xmm(b)
                        break;
                case LIR_FMUL:
                        | mulsd xmm14, xmm(b)
                        break;
                case LIR_FDIV:
                        | divsd xmm14, xmm(b)
                        break;
                case LIR_FSQRT:
                        | sqrtsd xmm14, xmm14
                        break;
                default:
                        break;
                }
        } 
        if (op == LIR_FABS || op == LIR_FNEG) {
                u64 mask = narrow ? UINT32_C(0x80000000) : UINT64_C(0x8000000000000000);
                if (op == LIR_FABS) {
                        mask = ~mask;
                }
                native_li(Dst, 10, mask);
                native_mov(Dst, 15, 10, cls, true, false);
                if (op == LIR_FABS) {
                        | andps xmm14, xmm15
                } else {
                        | xorps xmm14, xmm15
                }
        }
        native_mov(Dst, d, 14, cls, false, false);
}

static void
native_compare(dasm_State **Dst, u8 a, u8 b, LirClass cls)
{
        switch (cls) {
        case LIR_I32:
                | cmp Rd(a), Rd(b)
                break;
        case LIR_F32:
                | ucomiss xmm(a), xmm(b)
                break;
        case LIR_F64:
                | ucomisd xmm(a), xmm(b)
                break;
        default:
                | cmp Rq(a), Rq(b)
                break;
        }
}

static void
native_branch(dasm_State **Dst, LirCC cc, u32 label)
{
        switch (cc) {
        case LIR_EQ:
                | je =>label
                break;
        case LIR_NE:
                | jne =>label
                break;
        case LIR_LT:
                | jl =>label
                break;
        case LIR_LE:
                | jle =>label
                break;
        case LIR_GT:
                | jg =>label
                break;
        case LIR_GE:
                | jge =>label
                break;
        case LIR_ULT:
                | jb =>label
                break;
        case LIR_ULE:
                | jbe =>label
                break;
        case LIR_UGT:
                | ja =>label
                break;
        case LIR_UGE:
                | jae =>label
                break;
        case LIR_FGT:
                | ja =>label
                break;
        case LIR_FGE:
                | jae =>label
                break;
        case LIR_FUN:
                | jp =>label
                break;
        case LIR_FEQ:
                | jp >1
                | je =>label
                |1:
                break;
        case LIR_FLT:
                | jp >1
                | jb =>label
                |1:
                break;
        case LIR_FLE:
                | jp >1
                | jbe =>label
                |1:
                break;
        case LIR_FNE:
                | jp =>label
                | jne =>label
                break;
        default:
                break;
        }
}

static void
native_setcc(dasm_State **Dst, u8 d, LirCC cc)
{
        switch (cc) {
        case LIR_EQ:
                | je >2
                break;
        case LIR_NE:
                | jne >2
                break;
        case LIR_LT:
                | jl >2
                break;
        case LIR_LE:
                | jle >2
                break;
        case LIR_GT:
                | jg >2
                break;
        case LIR_GE:
                | jge >2
                break;
        case LIR_ULT:
                | jb >2
                break;
        case LIR_ULE:
                | jbe >2
                break;
        case LIR_UGT:
                | ja >2
                break;
        case LIR_UGE:
                | jae >2
                break;
        case LIR_FGT:
                | ja >2
                break;
        case LIR_FGE:
                | jae >2
                break;
        case LIR_FUN:
                | jp >2
                break;
        case LIR_FEQ:
                | jp >1
                | je >2
                |1:
                break;
        case LIR_FLT:
                | jp >1
                | jb >2
                |1:
                break;
        case LIR_FLE:
                | jp >1
                | jbe >2
                |1:
                break;
        case LIR_FNE:
                | jp >2
                | jne >2
                break;
        default:
                break;
        }
        native_li(Dst, d, 0);
        | jmp >3
        |2:
        native_li(Dst, d, 1);
        |3:
}


static void
native_convert(dasm_State **Dst, LirOp op, u8 d, u8 a, LirClass dst, LirClass src)
{
        if (op == LIR_BITCAST) {
                bool sf = src == LIR_F32 || src == LIR_F64;
                bool df = dst == LIR_F32 || dst == LIR_F64;
                native_mov(Dst, d, a, sf ? src : dst, !sf && df, sf && !df);
        } else if (op == LIR_FEXT) {
                | cvtss2sd xmm(d), xmm(a)
        } else if (op == LIR_FTRUNC) {
                | cvtsd2ss xmm(d), xmm(a)
        } else if (op == LIR_F2I) {
                if (dst == LIR_I32) {
                        if (src == LIR_F32) {
                                | cvttss2si Rd(d), xmm(a)
                        } else {
                                | cvttsd2si Rd(d), xmm(a)
                        } 
                } else {
                        if (src == LIR_F32) {
                                | cvttss2si Rq(d), xmm(a)
                        } else {
                                | cvttsd2si Rq(d), xmm(a)
                        } 
                } 
        } else {
                native_mov(Dst, 10, a, src == LIR_I32 ? LIR_I32 : LIR_I64, false, false);
                if (op == LIR_U2F && src != LIR_I32) {
                        | test r10, r10
                        | jns >1
                        | mov r11, r10
                        | and r11d, 1
                        | shr r10, 1
                        | or r10, r11
                        if (dst == LIR_F32) {
                                | cvtsi2ss xmm(d), r10
                                | addss xmm(d), xmm(d)
                        } else {
                                | cvtsi2sd xmm(d), r10
                                | addsd xmm(d), xmm(d)
                        }
                        | jmp >2
                        |1:
                }
                if (op == LIR_I2F && src == LIR_I32) {
                        | movsxd r10, r10d
                }
                if (dst == LIR_F32) {
                        | cvtsi2ss xmm(d), r10
                } else {
                        | cvtsi2sd xmm(d), r10
                }
                if (op == LIR_U2F && src != LIR_I32) {
                        |2:
                }
        }
}

static void
native_narrow(dasm_State **Dst, u8 d, LirType type)
{
        switch (type) {
        case LIR_TYPE_I8:
                | movsx Rq(d), Rb(d)
                break;
        case LIR_TYPE_U8:
                | movzx Rd(d), Rb(d)
                break;
        case LIR_TYPE_I16:
                | movsx Rq(d), Rw(d)
                break;
        case LIR_TYPE_U16:
                | movzx Rd(d), Rw(d)
                break;
        case LIR_TYPE_I32:
                | movsxd Rq(d), Rd(d)
                break;
        case LIR_TYPE_U32:
                | mov Rd(d), Rd(d)
                break;
        case LIR_TYPE_BOOL:
                | test Rq(d), Rq(d)
                | setnz Rb(d)
                | movzx Rd(d), Rb(d)
                break;
        default:
                break;
        }
}

static void
native_checked(dasm_State **Dst, LirOp op, u8 d, u8 a, u8 b, bool narrow)
{
        native_mov(Dst, 10, a, narrow ? LIR_I32 : LIR_I64, false, false);
        if (narrow) {
                switch (op) {
                case LIR_ADDO:
                        | add Rd(10), Rd(b)
                        break;
                case LIR_SUBO:
                        | sub Rd(10), Rd(b)
                        break;
                case LIR_MULO:
                        | imul Rd(10), Rd(b)
                        break;
                default:
                        break;
                }
        } else {
                switch (op) {
                case LIR_ADDO:
                        | add Rq(10), Rq(b)
                        break;
                case LIR_SUBO:
                        | sub Rq(10), Rq(b)
                        break;
                case LIR_MULO:
                        | imul Rq(10), Rq(b)
                        break;
                default:
                        break;
                }
        } 
        native_mov(Dst, d, 10, narrow ? LIR_I32 : LIR_I64, false, false);
}

static void
native_checked_branch(dasm_State **Dst, LirOp op, u32 label)
{
        | jo =>label
}

static void
native_select(dasm_State **Dst, u8 d, u8 a, u8 b, LirClass cls, u32 yes, u32 end)
{
        native_mov(Dst, d, b, cls, false, false);
        native_jump(Dst, end);
        native_label(Dst, yes);
        native_mov(Dst, d, a, cls, false, false);
        native_label(Dst, end);
}

static void
native_zero_branch(dasm_State **Dst, u8 a, bool nonzero, bool narrow, u32 label)
{
        if (narrow) {
                | test Rd(a), Rd(a)
        } else {
                | test Rq(a), Rq(a)
        }
        if (nonzero) {
                | jnz =>label
        } else {
                | jz =>label
        }
}

static void
native_lea(dasm_State **Dst, u8 d, u8 base, u8 index, u8 scale, i32 disp, bool narrow)
{
        if (index == LIR_PHYS_NONE) {
                native_addr(Dst, d, base, disp);
                return;
        }
        if (narrow) {
                | mov r11d, Rd(index)
                index = 11;
        }
        switch (scale) {
        case 1:
                | lea Rq(d), [Rq(base)+Rq(index)+disp]
                break;
        case 2:
                | lea Rq(d), [Rq(base)+Rq(index)*2+disp]
                break;
        case 4:
                | lea Rq(d), [Rq(base)+Rq(index)*4+disp]
                break;
        case 8:
                | lea Rq(d), [Rq(base)+Rq(index)*8+disp]
                break;
        }
}

static void
native_fence(dasm_State **Dst)
{
        | mfence
}

static void
native_byte(dasm_State **Dst, u8 byte)
{
        |.byte byte
}

static void
native_atomic(dasm_State **Dst, LirOp op, u8 d, u8 address, u8 expected, u8 value,
              bool narrow, u32 yes, u32 end)
{
        native_mov(Dst, 11, address, LIR_PTR, false, false);
        native_mov(Dst, 10, op == LIR_CAS ? value : expected,
                   narrow ? LIR_I32 : LIR_I64, false, false);
        if (op == LIR_CAS) {
                if (narrow) {
                        | lock
                        | cmpxchg dword [r11], r10d
                } else {
                        | lock
                        | cmpxchg qword [r11], r10
                }
        } else if (op == LIR_XADD) {
                if (narrow) {
                        | lock
                        | xadd dword [r11], r10d
                } else {
                        | lock
                        | xadd qword [r11], r10
                }
                native_mov(Dst, d, 10, narrow ? LIR_I32 : LIR_I64, false, false);
        } else {
                if (narrow) {
                        | xchg dword [r11], r10d
                } else {
                        | xchg qword [r11], r10
                }
                native_mov(Dst, d, 10, narrow ? LIR_I32 : LIR_I64, false, false);
        }
}

static void
native_table(dasm_State **Dst, u32 label, LirLabel const *targets, u32 n)
{
        |.align 8
        |=>label:
        for (u32 i = 0; i < n; ++i) {
                |.quad 0
        }
}

static void
native_switch(dasm_State **Dst, u8 a, u32 n, u32 fallback, u32 table)
{
        | cmp Rq(a), n
        | jae =>fallback
        | lea r11, [=>table]
        | jmp qword [r11+Rq(a)*8]
}

static void
native_zero_store(dasm_State **Dst, u8 base)
{
        | mov qword [Rq(base)], 0
}

static void
native_zero_compare(dasm_State **Dst, u8 a, LirClass cls)
{
        if (cls == LIR_I32) {
                | test Rd(a), Rd(a)
        } else {
                | test Rq(a), Rq(a)
        }
}

static void
native_twice_call(dasm_State **Dst, u32 slot, u32 label)
{
        | lea r11, [=>label]
        native_memory(Dst, true, 11, 5, slot, 8, false, false);
        | call r10
}
