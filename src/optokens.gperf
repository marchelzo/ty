%language=ANSI-C
%define lookup-function-name optoken_lookup
%define hash-function-name optoken_hash
%readonly-tables
%compare-strncmp
%struct-type
%enum
%includes
%null-strings
struct optoken_entry { char const *name; int toktype; };
