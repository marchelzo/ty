import os
import ty.test.cli as cli

fn legacy(args: Array[String]) -> Array[String] {
    match args {
        []                => [],
        ['-a', *rest]     => ['--all', *legacy(rest)],
        ['--full', *rest] => ['--with', 'full', *legacy(rest)],
        ['-n', re, *rest] => ['--path-exclude', re, *legacy(rest)],
        [a, *rest] :: !a.match?(/^-/) => ['--path-filter', a, *legacy(rest)],
        [a, *rest]        => [a, *legacy(rest)],
    }
}

let timeout = match getenv('TY_TEST_TIMEOUT') {
    nil => [],
    s   => ['--timeout', s],
}

os.exit(cli.main(['tests', *timeout, *legacy(argv[1;])]))
