pub fn arr() {
    let x = []
    assert(x.len() == 0 && #x == 0)
    match x {
     [] => ;,
     _  => assert(false)
    }
    x.push(1)
    x.push(2)
    assert(x.len() == 2)
    x.map!((+5))
    assert(x == [6, 7])
    assert(x.sum() == 13)
    x.splice(0)
    assert(#x == 0)
    let a = try x[4] else {
        return
    }
    assert(false)
}

pub fn classify-groups-without-leaking-a-default() {
    let groups = ['a1', 'b1', 'a2'].classify(\_[0])
    assert(#groups == 2 && groups['a'] == ['a1', 'a2'] && groups['b'] == ['b1'])
    assert(groups['c'] == nil)
    assert('c' not in groups)
}

pub fn postfix-bang-ends-a-subscript() {
    let xs = [10, 20, 30]
    let at = (s: String) -> int(s)
    assert(xs[at('1')!] == 20)
    assert(xs[at('0')!;at('2')!] == [10, 20])
    assert([1, 2, 3].map(\_ * 2)[at('2')!] == 6)
}
