import os (..)

ns test

class IsolatedWorker {
    gate: Channel
    result: Channel
    value: Int

    init(gate: Channel, result: Channel, value: Int) {
        self.gate = gate
        self.result = result
        self.value = value
    }

    run() {
        gate.recv()
        result.send(value)
    }
}

pub fn chan() {
    let ch = Channel()
    Thread(isolated=true, fn () {
        sleep(0.05)
        ch.send('hello')
    })
    assert(ch.recv(0) == None)
    assert(ch.recv() == Some('hello'))

    // Composite message headers must not point into the sender's GC heap.
    // Join first so the isolated heap is gone before reconstruction begins.
    let composite = Channel()
    let sender = Thread(isolated=true, fn () {
        composite.send((42, 'answer', 1 << 40))
    })
    sender.join()
    let got = composite.recv()
    for i in ..100000 {
        let garbage = "composite-garbage-{i}-{'x' * 64}"
    }
    assert(got == Some((42, 'answer', 1 << 40)))

    // The launching group must not own the environment used by an isolated
    // thread. Force several collections after the launcher drops its closure.
    let gate = Channel()
    let result = Channel()
    let captured = 42
    let t = Thread(isolated=true, fn () {
        gate.recv()
        result.send(captured)
    })
    for i in ..100000 {
        let garbage = "garbage-{i}-{'x' * 64}"
    }
    gate.send(nil)
    assert(result.recv() == Some(captured))
    t.join()

    // Bound functions have one additional environment cell for self.
    let bound-gate = Channel()
    let bound-result = Channel()
    let worker = IsolatedWorker(bound-gate, bound-result, 99)
    let bound-thread = Thread(worker.run, isolated=true)
    for i in ..100000 {
        let garbage = "bound-garbage-{i}-{'x' * 64}"
    }
    bound-gate.send(nil)
    assert(bound-result.recv() == Some(worker.value))
    bound-thread.join()
}
