import os
import path
import time

fn burn(cpu: Duration) {
    let start = time.now(time.CLOCK_THREAD_CPUTIME_ID)
    let acc = 0

    while time.since(start) < cpu {
        for ..1000 {
            acc += it
        }
    }
}

fn sub-microsecond?(ts: Array[Time[Any]]) -> Bool {
    ts.any?(\int(_) % 1000 != 0)
}

pub fn monotonic-is-not-the-wall-clock() {
    let mono = time.now()
    let real = time.time()

    assert(int(mono) < 1_000_000_000 * 1_000_000_000, "monotonic clock reads {mono}")
    assert(int(real) > 1_000_000_000 * 1_000_000_000, "realtime clock reads {real}")
}

pub fn now-defaults-to-monotonic() {
    let drift = time.now() - time.now(time.CLOCK_MONOTONIC)
    assert(abs(drift) < 1s, "time.now() is {drift} off CLOCK_MONOTONIC")
    assert(time.now().clock == time.CLOCK_MONOTONIC)
}

pub fn monotonic-never-goes-backwards() {
    let prev = time.now()

    for ..1000 {
        let now = time.now()
        assert(now >= prev, "time.now() went from {prev} back to {now}")
        prev = now
    }
}

pub fn cpu-clocks-ignore-sleep() {
    let cpu0  = time.now(time.CLOCK_THREAD_CPUTIME_ID)
    let wall0 = time.now()

    os.sleep(200ms)

    let cpu  = time.since(cpu0)
    let wall = time.since(wall0)

    assert(wall >= 190ms, "slept 200ms but wall time advanced {wall}")
    assert(cpu < 100ms, "slept 200ms but thread CPU time advanced {cpu}")
}

pub fn absolute-sleep-waits-for-the-deadline() {
    let deadline = time.now() + 30ms

    assert(os.sleep(deadline) == nil)
    assert(time.diff(deadline) <= 0s)
    assert(time.until(deadline) == 0s)
}

pub fn thread-cpu-time-is-bounded-by-wall-time() {
    let cpu0  = time.now(time.CLOCK_THREAD_CPUTIME_ID)
    let wall0 = time.now()

    burn(30ms)

    let cpu  = time.since(cpu0)
    let wall = time.since(wall0)

    assert(cpu >= 30ms, "burned CPU but thread CPU time advanced {cpu}")
    assert(cpu <= wall + 1ms, "thread CPU {cpu} exceeds wall {wall}")
}

pub fn process-cpu-time-is-sane() {
    let thread  = int(time.now(time.CLOCK_THREAD_CPUTIME_ID))
    let process = int(time.now(time.CLOCK_PROCESS_CPUTIME_ID))
    let uptime  = int(time.now())

    assert(process < int(1h), "process CPU time is {process}ns")
    assert(process <= uptime, "process CPU {process}ns > uptime {uptime}ns")
    assert(process + int(1ms) >= thread, "process {process}ns < thread {thread}ns")
}

pub fn thread-cpu-clock-has-nanosecond-resolution() {
    let ts = [time.now(time.CLOCK_THREAD_CPUTIME_ID) for ..20]
    assert(sub-microsecond?(ts), "whole microseconds only: {ts}")
}

pub fn touch-stamps-wall-clock-time() {
    with tmp = path.tempdir() {
        let file = tmp / 'touched'
        file.touch()
        let skew = file.stat.mtime - time.time()
        assert(abs(skew) < 60s, "touch() set mtime {skew} off the wall clock")
    }
}

#|if __linux__
pub fn monotonic-clock-has-nanosecond-resolution() {
    let ts = [time.now() for ..20]
    assert(sub-microsecond?(ts), "whole microseconds only: {ts}")
}
#|]
