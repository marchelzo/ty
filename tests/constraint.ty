import ty

ns test

pub fn constraint() {
    fn f(x: Int, s: String) -> Float { return 0.4 }
    f(10, 'foo')
    try {
        __eval__('f(10, 20)')
        assert(ty.q)
    } catch ex :: 'invalid argument type' in ex.what {
        ;
    }
}

pub fn bounded-type-parameters() {
    use Scalar = Int | String
    use Sized = String | Array

    fn identity[T](x: T) -> T where T: Scalar { x }
    fn singleton[T](x: T) -> Array[T] where T: Scalar { [x] }
    fn first[T, U](xs: T) -> U where T: Array[U] { xs[0] }
    fn size[T](x: T) -> Int where T: Sized { #x }

    fn integer() -> Int { identity(42) }
    fn strings() -> Array[String] { singleton('x') }
    fn first-integer() -> Int { first([10, 20]) }

    assert(integer() == 42)
    assert(strings() == ['x'])
    assert(first-integer() == 10)
    assert(size('abc') == 3)
    assert(size([1, 2]) == 2)

    try {
        __eval__('identity(1.5)')
        assert(false, 'bounded call accepted an argument outside its upper bound')
    } catch ex :: 'unsatisfied type constraint' in ex.what {
        ;
    }

    try {
        __eval__('fn invalid[T](x: T) -> T where T: Scalar { 1 }')
        assert(false, 'bounded return type was widened to its upper bound')
    } catch ex :: 'type mismatch' in ex.what {
        ;
    }
}

pub fn deferred-subscript-constraints() {
    let pairs = [(1, 'a'), (0, 'b')]

    assert(pairs.map(&0) == [1, 0])
    assert(
        str(typeof [(1, 'a'), ('x', 'b')].map(&0))
            == "Array[1 | 'x']"
    )
    assert(pairs.sort(by=&0) == [(0, 'b'), (1, 'a')])
    assert(
        pairs.sort(by=x -> match x { (a, _) => a })
            == [(0, 'b'), (1, 'a')]
    )

    fn first(x: (1, 'a') | (0, 'b')) { x[0] }

    assert(first((1, 'a')) == 1)
    assert(first((0, 'b')) == 0)

    fn both(x) { (x[0], x[1]) }

    assert(both((1, 'a')) == (1, 'a'))

    try {
        __eval__("[(1, 'a'), true].map(&0)")
        assert(false, 'subscript constraint accepted a non-subscriptable union arm')
    } catch ex :: 'type constraint' in ex.what {
        ;
    }

    try {
        __eval__("[(1,), (2, 3)].map(x -> x[1])")
        assert(false, 'subscript constraint ignored an out-of-range union arm')
    } catch ex :: 'type constraint' in ex.what {
        ;
    }

    fn check-view(msg) {
        match msg {
            %{'trace': &0 ~> _} => true,
            _ => false
        }
    }

    assert(check-view(%{'trace': [1]}))

    let by-parent = %{}
    let ppid: Int = 2
    (by-parent[ppid] ?? (by-parent[ppid] = [])).push({pid: 1})

    fn collect(id: Int) {
        for p in by-parent[id] ?? [] {
            collect(p.pid)
        }
    }

    collect(ppid)

    let first-type = xss -> match xss[0][0] {
        x: {type: Int | nil} => x.type,
        _ => nil
    }
    let nested: Array[Array[String | {type: Int | nil}]] = [[{type: 1}]]
    assert(first-type(nested) == 1)
}
