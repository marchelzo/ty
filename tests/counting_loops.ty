class Countdown {
    n: Int
    init(n: Int) { self.n = n }
    downto*(b: Int) {
        yield "custom {n} {b}"
    }
}

fn bound(log: Array[String], x: Int, label: String) -> Int {
    log.push(label)
    x
}

pub fn int-counting-loops-visit-the-same-values() {
    let seen = []
    let k = 6
    let lvl = 2
    for i in k.downto(lvl) {
        seen.push(i)
    }
    for i in lvl.upto(k - 2) {
        seen.push(i)
    }
    for i in (k - 1).downto(lvl + 1) if i % 2 == 1 {
        seen.push(-i)
    }
    assert(seen == [6, 5, 4, 3, 2, 2, 3, 4, -5, -3])
}

pub fn empty-and-single-ranges() {
    let a = []
    for i in 3.downto(4) {
        a.push(i)
    }
    for i in 4.upto(3) {
        a.push(i)
    }
    for i in 7.downto(7) {
        a.push(i)
    }
    assert(a == [7])
}

pub fn break-and-continue-work() {
    let a = []
    for i in 10.downto(0) {
        if i == 7 { continue }
        if i == 4 { break }
        a.push(i)
    }
    assert(a == [10, 9, 8, 6, 5])
}

pub fn comprehensions-count-too() {
    let n = 4
    assert([i * i for i in n.downto(1)] == [16, 9, 4, 1])
    assert([i for i in 1.upto(n) if i != 2] == [1, 3, 4])
}

pub fn user-classes-keep-their-own-methods() {
    let out = []
    for s in Countdown(3).downto(1) {
        out.push(s)
    }
    assert(out == ["custom 3 1"])
}

pub fn bounds-with-calls-run-once() {
    let log = []
    let out = []
    for i in bound(log, 3, "recv").downto(bound(log, 1, "arg")) {
        out.push(i)
    }
    assert(out == [3, 2, 1])
    assert(log.sort() == ["arg", "recv"])
}

pub fn generators-are-still-values() {
    let g = 3.downto(1)
    assert([x for x in g] == [3, 2, 1])
    let mutated = []
    let k = 3
    for i in k.downto(1) {
        mutated.push(i)
        k = 100
    }
    assert(mutated == [3, 2, 1])
}
