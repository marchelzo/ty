ns test

pub fn defparam() {
    fn f(g=(x -> x + 1), x=4) {
        g(x)
    }
    assert(f() == 5)
    assert(f(&.pred, 8) == 7)
}

pub fn parameter-constraints-and-defaults() {
    fn foo(x: String = 'hello!') -> String {
        assert(str(typeof x) == 'String')
        x
    }

    fn bar(x: String = nil) -> String {
        assert(str(typeof x) == 'nil | String')
        x ?? 'hello!'
    }

    assert(str(typeof foo) == str(typeof bar))
    assert(foo() == 'hello!')
    assert(bar() == 'hello!')
    assert(foo('supplied') == 'supplied')
    assert(bar(x='supplied') == 'supplied')

    for source in ['foo(nil)', 'bar(nil)', 'foo(x=nil)', 'bar(x=nil)',
                   'foo(*(nil,))', 'bar(**{x: nil})'] {
        try {
            __eval__(source)
            assert(false, source)
        } catch ex :: '[bad-call]' in ex.what {
            ;
        }
    }

    try {
        __eval__('let accepts-nil: (String | nil) -> String = foo')
        assert(false, 'optional parameter bypassed callback input constraints')
    } catch ex :: '[assignment-type]' in ex.what {
        ;
    }
}

pub fn default-types-inside-functions() {
    fn different(x: String = 0) {
        assert(str(typeof x) == 'Int | String')
        x
    }

    assert(different() == 0)
    assert(different('given') == 'given')

    fn dependent(x: String = nil, count: Int = x == nil ? 0 : #x) {
        count
    }

    assert(dependent() == 0)
    assert(dependent('abc') == 3)

    fn choose[T](first: T, second: T = nil) -> T {
        second ?? first
    }

    assert(choose('first') == 'first')
    assert(choose(1, 2) == 2)

    try {
        __eval__('fn bad(x: String = nil) -> String { x }')
        assert(false, 'default nil was absent from the body parameter type')
    } catch ex :: '[function-fallthrough]' in ex.what {
        ;
    }
}

class DefaultParameter {
    value: String

    init(value: String = nil) {
        assert(str(typeof value) == 'nil | String')
        self.value = value ?? 'default'
    }

    value-or(x: String = nil) -> String {
        x ?? self.value
    }
}

pub fn method-and-keyword-defaults() {
    let instance = DefaultParameter()
    assert(instance.value-or() == 'default')
    assert(instance.value-or(x='given') == 'given')

    fn keyword(*args, x: String = nil) -> String {
        x ?? 'default'
    }

    assert(keyword() == 'default')
    assert(keyword(x='given') == 'given')

    for source in ['DefaultParameter(nil)', 'instance.value-or(nil)',
                   'keyword(x=nil)'] {
        try {
            __eval__(source)
            assert(false, source)
        } catch ex :: '[bad-call]' in ex.what {
            ;
        }
    }
}

pub fn slice-defaults() {
    fn tail(x) { x[1;] }
    fn head(x) { x[;2] }
    fn reverse(x) { x[;;-1] }

    assert(['abc'].map(tail) == ['bc'])
    assert(['abc'].map(head) == ['ab'])
    assert(['abc'].map(reverse) == ['cba'])
}

fn early-length() -> Int {
    Lengths().take([1, 2, 3])
}

class Lengths {
    take[U](xs: Array[Int], n: U = #xs) -> U {
        n
    }
}

pub fn type-variable-defaults-apply-only-when-omitted() {
    fn pick[U](d: U = nil) -> U {
        d
    }

    fn given() -> Int {
        pick(3)
    }

    fn omitted() -> nil {
        pick()
    }

    fn explicit() -> String {
        Lengths().take([1], 'x')
    }

    fn implicit() -> Int {
        Lengths().take([1, 2])
    }

    assert(given() == 3)
    assert(omitted() == nil)
    assert(explicit() == 'x')
    assert(implicit() == 2)
    assert(early-length() == 3)
    assert(str(typeof [nil, 'x'].coalesce('d')) == 'String')
    assert(str(typeof [nil, 1].coalesce()) == 'nil | Int')

    for source in ['let n: Int = pick()', 'let n: Int = [nil, 1].coalesce()'] {
        try {
            __eval__(source)
            assert(false, source)
        } catch ex :: '[assignment-type]' in ex.what {
            ;
        }
    }
}

class Label {
    init(text: String) {
        self.text = text
    }

    text: String
}

class Keyed[T] {
    init(x: T) {
        self.x = x
    }

    x: T

    key[U](by: T -> U = id) -> U {
        by(x)
    }

    rekey[U](by: T -> U) -> U {
        key(by)
    }
}

pub fn structured-defaults-apply-only-when-omitted() {
    fn apply[U](x: Int, f: Int -> U = id) -> U {
        f(x)
    }

    fn forward(x, f) {
        apply(x, f)
    }

    assert(str(typeof apply(1)) == 'Int')
    assert(str(typeof apply(1, str)) == 'String')
    assert(str(typeof apply) == '(x: Int, ?f: (Int) -> a) -> a where (x: b) -> b <: (Int) -> a if f omitted')
    assert(str(typeof forward) == '(x: Int, f: (Int) -> a) -> a')
    assert(str(typeof Keyed.rekey) == '(by: (a) -> b) -> b')
    assert(str(typeof Keyed(str(1)).key()) == 'String')
    assert(str(typeof Keyed(str(1)).key(int)) == 'Int')

    assert(str(typeof 'abc'.__iter__().tally(Label)) == 'Dict[Label, Int]')
    assert(str(typeof 'abc'.__iter__().tally()) == 'Dict[String, Int]')
    assert(str(typeof 'abc'.classify(Label)) == 'Dict[Label, Array[String]]')
    assert(str(typeof 'abc'.classify()) == 'Dict[String, Array[String]]')
    assert(str(typeof [1].classify(str)) == 'Dict[String, Array[Int]]')
    assert('abc'.__iter__().tally(Label).keys().map(&.text).sort() == ['a', 'b', 'c'])
}
