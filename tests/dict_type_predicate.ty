ns test

pub fn test-dict-type-predicate-accepts-matching-entries() {
    assert(%{1: 'a', 2: 'b'} :: Dict[Int, String])
    assert(%{'x': 1.5} :: Dict[String, Float])
    assert(%{} :: Dict[Int, String])
}

pub fn test-dict-type-predicate-rejects-wrong-keys() {
    assert(!(%{'a': 1} :: Dict[Int, Int]))
    assert(!(%{1: 1, 'b': 2} :: Dict[Int, Int]))
}

pub fn test-dict-type-predicate-rejects-wrong-values() {
    assert(!(%{1: 'a'} :: Dict[Int, Int]))
    assert(!(%{1: 1, 2: 'b'} :: Dict[Int, Int]))
}

pub fn test-dict-type-predicate-rejects-non-dicts() {
    assert(!([(1, 2)] :: Dict[Int, Int]))
    assert(!(nil :: Dict[Int, Int]))
    assert(!('dict' :: Dict[String, String]))
}

pub fn test-dict-type-predicate-in-match() {
    let describe = match {
        d :: Dict[String, Int] => 'counts',
        d :: Dict[Int, String] => 'names',
        d :: Dict              => 'dict',
        _                      => 'other',
    }

    assert(describe(%{'a': 1}) == 'counts')
    assert(describe(%{1: 'a'}) == 'names')
    assert(describe(%{1.5: 'a'}) == 'dict')
    assert(describe([1]) == 'other')
}

pub fn default-factory-inference() {
    fn nested(outer: String, inner: String, value: String) {
        let dict = %{*: %{}}
        dict[outer][inner] = value
        dict
    }

    fn arrays(key: String) {
        let dict = %{*: []}
        dict[key].push(chr(97))
        dict
    }

    fn dependent(key: String) {
        let dict = %{*: it.upper()}
        dict[key]
        dict
    }

    assert(str(typeof nested('', '', '')) == 'DefaultDict[String, Dict[String, String]]')
    assert(str(typeof arrays('')) == 'DefaultDict[String, Array[String]]')
    assert(str(typeof dependent('')) == 'DefaultDict[String, String]')
    assert(nested('outer', 'inner', 'value')['outer']['inner'] == 'value')
    assert(arrays('letters')['letters'] == ['a'])
    assert(dependent('key')['key'] == 'KEY')
}
