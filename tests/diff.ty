import diff

class Point {
    x: Int
    y: Int
}

pub fn edit-scripts() {
    let es = diff.edits(['a', 'b', 'c'], ['a', 'x', 'c', 'd'])
    assert(es == [('=', 'a'), ('-', 'b'), ('+', 'x'), ('=', 'c'), ('+', 'd')])
    assert(diff.edits([], []) == [])
    assert(diff.edits(['a'], []) == [('-', 'a')])
    assert(diff.edits([], ['b']) == [('+', 'b')])
}

pub fn line-diffs-elide-unchanged-runs() {
    let a = [str(n) for n in ..20].join("\n")
    let b = a.sub('10', 'ten')
    assert(diff.line-diff(a, b, context: 1) == [
        '  … 9 unchanged lines',
        '  9',
        '- 10',
        '+ ten',
        '  11',
        '  … 8 unchanged lines',
    ])
}

pub fn carets-point-at-the-first-difference() {
    assert(diff.caret('hello world', 'hello wrld') == [
        "- 'hello world'",
        "+ 'hello wrld'",
        '          ^',
    ])
}

pub fn carets-window-long-strings() {
    let a = "{'x' * 200}A{'y' * 200}"
    let b = "{'x' * 200}B{'y' * 200}"
    let [la, lb, at] = diff.caret(a, b, width: 40)
    assert(#la < 50)
    assert(la[#at - 1] == 'A' && lb[#at - 1] == 'B')
}

pub fn paths-name-each-difference() {
    let a = [1, {a: 2, b: [3, 4]}, 5]
    let b = [1, {a: 2, b: [3, 9]}, 5, 6]
    assert(diff.paths(a, b) == ['[1].b[1]: 4 != 9', '[3]: only on the right: 6'])
    assert(diff.paths(%{'k': 1, 'x': 2}, %{'k': 1, 'y': 3}) == [
        "['x']: only on the left: 2",
        "['y']: only on the right: 3",
    ])
    assert(diff.paths(Point(1, 2), Point(1, 3)) == ['.y: 2 != 3'])
}

pub fn paths-stop-at-the-limit() {
    let a = [n for n in ..50]
    let b = [-n for n in ..50]
    assert(#diff.paths(a, b, limit: 5) == 5)
}

pub fn explain-picks-a-view() {
    assert(diff.explain(3, 4) == [])
    assert(diff.explain('a', 1) == [])
    assert(diff.explain("a\nb", "a\nc") == ['  a', '- b', '+ c'])
    assert(diff.explain([1, 2], [1, 3]) == ['[1]: 2 != 3'])
    let big = [{id: n, name: "user {n}"} for n in ..8]
    let other = [*big[;7], {id: 7, name: 'someone else'}]
    let lines = diff.explain(big, other)
    assert(lines[0] == "[7].name: 'user 7' != 'someone else'")
    assert(lines.any?(\_.match?(/^- .*user 7/)))
    assert(lines.any?(\_.match?(/^\+ .*someone else/)))
}
