import ffi as c (C!)
import ptr
import io

C! fn {
    void qsort(void* base, c.u64 nmemb, c.u64 size, void *cmp);
    long labs(long);
}

C! closure cmp(pa: c.ptr, pb: c.ptr) -> c.int {
    let a = c.load(c.i8, pa)
    let b = c.load(c.i8, pb)
    labs(a) <=> labs(b)
}

pub fn sorting() {
    fn check(n: Int) -> Bool {
        let bytes = with f = io.open('/dev/urandom', 'r') {
            f.next(n)
        }
        if #bytes != n {
            return false
        }
        qsort(bytes, #bytes, 1, cmp)
        let p = ptr.typed(bytes.ptr(), c.i8)
        for i in 1..n {
            if p[i - 1].abs > p[i].abs {
                return false
            }
        }
        true
    }
    assert(check(1 << 12))
}

C! struct Holder {
    int x;
};

pub fn integer-fields-take-addresses() {
    let p = c.new-auto(c.u64)
    let b = Blob('xyz')
    let h = Holder(x: 1)

    c.store(c.u64, p, b)
    assert(c.load(c.u64, p) == int(b.ptr()))

    c.store(c.u64, p, h)
    assert(c.load(c.u64, p) == int(h.get()))

    c.store(c.u64, p, 'abc')
    assert(c.load(c.u64, p) != 0)

    c.store(c.u64, p, nil)
    assert(c.load(c.u64, p) == 0)

    c.store(c.i32, p, true)
    assert(c.load(c.i32, p) == 1)

    c.store(c.i32, p, 3.9)
    assert(c.load(c.i32, p) == 3)

    let err = try {
        c.store(c.u64, p, %{})
        nil
    } catch e {
        e
    }
    assert("{err}".match?(/non-addressable/))
}
