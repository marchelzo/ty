import ffi as c (C!)

ns test

C! struct Foo {
    int a;
    union {
        int b;
        float c;
    };
    int y;
    int z;
};

pub fn ffiunion() {
    assert(#Foo == 16)
    let foo = Foo(a=2, c=4.5, z=11)
    assert(foo.c == 4.5)
    foo.b = 7
    assert(foo.b == 7)
}

pub fn constructor-sets-any-union-member() {
    let foo = Foo(a=2, b=42, y=5)
    assert(foo.b == 42)
    assert(foo.a == 2)
    assert(foo.y == 5)
    assert(foo.z == 0)
}
