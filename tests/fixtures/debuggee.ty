import os (sleep, setproctitle, write)

class Box {
    value: Int
}

fn hot(n: Int) -> Int {
    let acc = 0
    for i in ..n {
        acc = (acc + i) % 1000003
    }
    acc
}

fn helper(box: Box, k: Int) -> Int {
    let doubled = box.value * 2
    doubled + k
}

fn worker(started: Channel) {
    started.send(true)

    let n = 0
    while true {
        try {
            n += 1
            if n % 20 == 0 {
                throw "worker-{n}"
            }
        } catch _ {
            n += 0
        }
        sleep(0.002)
    }
}

if let [_, $title] = argv {
    setproctitle(title)
}

let started = Channel()
let thread = Thread(worker, started)
let total = 0
let calls = 0

while true {
    if calls == 1 && started.recv().some? {
        write(1, "ready\n")
    }

    total = hot(200000)
    calls += 1
    total += helper(Box(value: 21), calls % 4)
    sleep(0.001)
}
