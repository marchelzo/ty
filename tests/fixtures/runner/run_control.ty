import ty.test (retries)

let COUNTS: Dict[String, Int] = %{}

fn bump(name: String) -> Int {
    let n = (COUNTS[name] ?? 0) + 1
    COUNTS[name] = n
    n
}

pub fn flaky-twice() {
    let n = bump('flaky-twice')
    assert(n > 2, "attempt {n}")
}

@retries(1)
pub fn decorated-flaky() {
    assert(bump('decorated-flaky') > 1)
}

pub fn second-run-fails() {
    assert(bump('second-run-fails') != 2)
}

pub fn stable() {
}

pub fn always-fails() {
    assert(false)
}

pub fn env-gated() {
    assert(getenv('RC_FIX') == '1')
}
