fn later-assignment() {
    let value = nil
    value = 'present'
    let read = fn () { value.len() }
    value = nil
    read()
}

fn repeated-assignment() {
    let value = nil
    let readers = []
    for i in 0..2 {
        value = 'present' if i == 0
        readers.push(fn () { value.len() })
    }
    readers[0]()
}
