fn complete-domain(value: Int | String) -> Int {
    match value {
        text: String => #text,
        number: Int => number
    }
}

fn duplicate-boolean(value: Bool) -> Int {
    match value {
        true => 1,
        true => 2,
        false => 3
    }
}

fn incomplete-boolean(value: Bool) -> Int {
    match value {
        true => 1
    }
}

fn open-domain(value: _) -> Int {
    match value {
        number: Int => number,
        _ => 0
    }
}

fn tuple-domain(value: Float | (Float, Float)) -> Float {
    match value {
        (left, right) => left + right,
        scalar => scalar
    }
}

fn optional-field(value: Err[{?module: Int}]) -> Int {
    match value {
        Err({module, *}) => module
    }
}

fn nullable-field(value: Err[{module: ?Int}]) -> Int {
    match value {
        Err({$module, *}) => module
    }
}

fn literal-field(value: Err[{module: Int}]) -> Int {
    match value {
        Err({module: 0, *}) => 0
    }
}

fn extra-fields(value: Err[{module: Int}]) -> Int {
    match value {
        Err({module}) => module
    }
}

fn covered-record(value: Err[{module: Int}]) -> Int {
    match value {
        Err({module, *}) => module,
        _ => 0
    }
}

print(
    complete-domain('covered'),
    duplicate-boolean(false),
    open-domain('open'),
    tuple-domain(1.5)
)
