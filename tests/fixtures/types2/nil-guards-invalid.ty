class Slot {
    __value: String | nil

    init() {
        __value = nil
    }

    clear() {
        __value = nil
    }

    other() -> _ { nil }

    length() -> Int {
        if __value != nil {
            __value = other()
            return __value.len()
        }
        0
    }
}

print(Slot().length())
