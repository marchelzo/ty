class Money {
    cents: Int
    init(cents: Int) { self.cents = cents }
}

fn -(a: Money, b: Money) -> Money { Money(a.cents - b.cents) }

fn epoch-days(year: Int, month: Int) -> Int {
    let y = year
    let m = month
    y -= (m <= 2)
    y * 12 + m
}

class Meter {
    total(x: Int) -> Float {
        let nanos = scale(x)
        match x {
            0 => Float(nanos),
            _ => nanos / 2.0
        }
    }
}

fn scale(x: Int) -> Int { x * 4 }

fn halve(x) { x / 2.0 }
fn small?(x) { x < 5 }
fn sum(a, b) { a + b }

fn from-end(xs: Array[String], i) {
    if #xs < i { return nil }
    xs[-i]
}

let slack = o -> max(1, #o / 4)

class Ranked[T] {
    items: Array[T]
    init(items: Array[T]) { self.items = items }

    argmax[U](f: T -> U) -> ?Int where (U > U): Bool {
        if #items == 0 { return nil }
        let i, best = 0, f(items[0])
        for j in 1..#items {
            let y = f(items[j])
            if y > best {
                i, best = j, y
            }
        }
        i
    }
}

print(
    (Money(5) - Money(2)).cents,
    epoch-days(2024, 2),
    Meter().total(3),
    Meter().total(0),
    halve(3),
    halve(2.5),
    small?(3),
    small?(7.5),
    sum(1, 2),
    sum('a', 'b'),
    from-end(['a', 'b'], 1),
    slack('abcdefghij'),
    Ranked([3, 9, 4]).argmax(x -> -x),
    Ranked(['bb', 'a', 'ccc']).argmax(\#_)
)
