use Renderer = (String, Dict[Int, Renderer]) -> String

fn render(text: String, renderers: Dict[Int, Renderer] = %{}) -> String {
    if let $custom = renderers[0] {
        return custom(text, renderers)
    }
    text
}

fn uppercase(text: String, renderers: Dict[Int, Renderer]) -> String {
    text.upper()
}

class Type {
    value: Int

    init(value: Int) {
        self.value = value
    }
}

fn type-value(value: Type) -> Int {
    value.value
}

class Indexed {
    __value: String = 'initial'

    [](i: Int) -> Int { i }
    [](i: Int, j: Int) -> String { __value }

    []=(i: Int, j: Int, value: String) {
        __value = value
    }

    at(i: Int, j: Int) -> String { self[i, j] }
}

class Property {
    __value: Int = 3

    value { __value }

    value=(value: Int) {
        __value = value
    }
}

class DoubledProperty < Property {
    value { 2 * super() }

    value=(value: Int) {
        super(value + 1)
    }
}

fn filtered(values: Array[Int | String]) -> Array[Int] {
    let numbers: Array[Int] = []
    for value in values if value :: Int {
        numbers.push(value)
    }
    numbers
}

fn until-text(values: Array[Int | String]) -> Array[Int] {
    let numbers: Array[Int] = []
    for value in values while value :: Int {
        numbers.push(value)
    }
    numbers
}

fn positive-prefix(values: Array[Int | nil]) -> Array[Int] {
    let numbers: Array[Int] = []
    for value in values while value != nil if value > 0 {
        numbers.push(value)
    }
    numbers
}

fn read-later(value) {
    read-field(value)
}

fn read-field(value) {
    value.raw
}

fn call-handler(options: _) {
    options.handler({raw: 7})
}

fn optional-blob(text: String) -> Blob | nil {
    text ? Blob(text) : nil
}

fn opaque[T](value: _) -> T {
    cast(value)
}

ns test

pub fn forward-call-inference() {
    let number: Int = read-later({raw: 7})
    let text: String = read-later({raw: 'seven'})
    assert(number == 7)
    assert(text == 'seven')

    try {
        __eval__('read-later({other: 7})')
        assert(false, 'accepted a value without the required field')
    } catch ex :: '[bad-call]' in ex.what {
        ;
    }
}

pub fn callback-and-return-protocols() {
    let handler = ev -> ev.raw
    assert(call-handler({handler}) == 7)

    let row = opaque(%{'value': 7})
    assert(row['value'] == 7)

    let lengths = %{*: #it}
    assert(#lengths == 0)
    assert(lengths['seven'] == 5)
}

pub fn optional-composition-inference() {
    let text = &str .? optional-blob
    assert(text('hello') == 'hello')
    assert(text('') == nil)

    let typed = (fn (blob: Blob) { blob.str() }) .? optional-blob
    assert(typed('hello') == 'hello')
    assert(typed('') == nil)
}

pub fn stable-captures() {
    let value = nil
    value = 'ready'
    let read = fn () { value.upper() }
    assert(read() == 'READY')

    let pending = nil
    pending = 'ready'

    fn consume() {
        if pending != nil {
            let result = pending.upper()
            assert(#pending == 5)
            pending = nil
            return result
        }
    }

    assert(consume() == 'READY')
    assert(consume() == nil)
}

pub fn recursive-callbacks-and-defaults() {
    assert(render('hello') == 'hello')
    assert(render('hello', %{0: uppercase}) == 'HELLO')

    try {
        __eval__('let bad: Renderer = fn (s: String, rs: Dict[Int, Renderer]) -> Int { 1 }')
        assert(false, 'accepted an incompatible recursive callback')
    } catch ex :: '[assignment-type]' in ex.what {
        ;
    }
}

pub fn class-shadows-type-name() {
    fn get(value) -> Int {
        if value :: Type {
            return type-value(value)
        }
        -1
    }

    assert(get(Type(7)) == 7)
    assert(get('other') == -1)
}

pub fn multiple-subscript-arguments() {
    let indexed = Indexed()
    assert(indexed[2] == 2)
    assert(indexed.at(1, 2) == 'initial')
    indexed[1, 2] = 'updated'
    assert(indexed[1, 2] == 'updated')

    for (source, code) in [
        ('indexed[1, true]', '[no-overload]'),
        ('do { indexed[1, 2] = 3 }', '[bad-call]')
    ] {
        try {
            __eval__(source)
            assert(false, source)
        } catch ex :: code in ex.what {
            ;
        }
    }
}

pub fn inherited-property-accessors() {
    let property = DoubledProperty()
    assert(property.value == 6)
    property.value = 4
    assert(property.value == 10)
}

pub fn loop-condition-narrowing() {
    assert(filtered([1, 'skip', 2]) == [1, 2])
    assert(until-text([1, 2, 'stop', 3]) == [1, 2])
    assert(positive-prefix([1, -2, 3, nil, 4]) == [1, 3])

    let total = 0
    for let value: Int | nil = 2; value != nil; value = nil {
        total += value
    }
    assert(total == 2)

    try {
        __eval__('fn bad(value: Int | nil) -> Int {
            for i in [1] if value != nil { ; }
            value
        }')
        assert(false, 'loop refinement escaped its scope')
    } catch ex :: '[function-fallthrough]' in ex.what {
        ;
    }
}
