class WideInput < ink.Component {
    render() -> ink.Node { <ink.Box><ink.TextInput width=12 /></ink.Box> }
}

pub fn text-input-keeps-its-width-with-wide-text() {
    let h = ink.TestHarness(WideInput(), cols=40, rows=5, color?=false)
    h.tab()
    h.send-text('hello 日本語テキスト é😀👍🏽x')
    assert(h.lines.all?(\_.width() == 12))
    for ..12 {
        h.backspace()
    }
    assert(h.line(1).match?(/│hello +│/))
}

class LongArea < ink.Component {
    render() -> ink.Node {
        <ink.Box><ink.TextArea width=12 height=4 value="ab\nthis is a much longer line" /></ink.Box>
    }
}

pub fn text-area-scrolls-horizontally() {
    let h = ink.TestHarness(LongArea(), cols=40, rows=8, color?=false)
    h.tab()
    h.down()
    for ..20 {
        h.right()
    }
    assert(h.line(2).match?(/longer/))
    h.up()
    h.down()
    assert(h.line(2).match?(/longer/))
}

