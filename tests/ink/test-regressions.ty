class LongSelect < ink.Component {
    submitted: Int = -1

    submit(i: Int) {
        submitted = i
    }

    render() -> ink.Node {
        <ink.Box><ink.Select items=[*"abcdefghij"] height=5 on-submit=submit /></ink.Box>
    }
}

pub fn select-scrolls-and-submits() {
    let app = LongSelect()
    let h = ink.TestHarness(app, cols=30, rows=12, color?=false)
    h.tab()
    for ..5 {
        h.down()
    }
    assert(h.line-count == 5)
    assert(h.line(3).match?(/▸ f/))
    h.click(3, 2)
    h.enter()
    assert(app.submitted == 4)
}

pub fn select-with-no-items-ignores-keys() {
    let h = ink.TestHarness(EmptySelect(), cols=30, rows=6)
    h.tab()
    h.down()
    h.up()
}

class EmptySelect < ink.Component {
    render() -> ink.Node { <ink.Box><ink.Select items=[] /></ink.Box> }
}

class LookApp < ink.Component {
    render() -> ink.Node {
        <ink.Box cls="card">
            <ink.Select items=['one', 'two'] selected=1 />
        </ink.Box>
    }
}

pub fn looks-restyle-classes-and-parts() {
    ink.use-looks('.card { border: double; pad-x: 2 }\nSelect::indicator:selected { content: "→" }')
    let h = ink.TestHarness(LookApp(), cols=30, rows=10, color?=false)
    assert(h.line(0).match?(/^╔/))
    h.assert-contains('→ two')
    ink.use-looks('')
}

pub fn looks-file-reloads-and-reports-errors() {
    let file = "{getenv('TMPDIR') ?? '/tmp'}/ink-looks-test.looks"
    path.Path(file).write('.card { border: single }')
    ink.watch-looks(file)
    let h = ink.TestHarness(LookApp(), cols=30, rows=10, color?=false)
    assert(h.line(0).match?(/^┌/))
    os.sleep(1.1)
    path.Path(file).write('.card { borderr: double }')
    h.repaint()
    assert(h.line(0).match?(/^┌/))
    assert(ink.look-error() != nil)
    os.sleep(1.1)
    path.Path(file).write('.card { border: bold }')
    h.repaint()
    assert(h.line(0).match?(/^┏/))
    ink.use-looks('')
}

class SockApp < ink.Component {
    __count: Int = 0

    render() -> ink.Node {
        <ink.Box><ink.Text>count={__count}</ink.Text></ink.Box>
    }
}

fn sock-session(h: ink.TestHarness, path: String, reqs: Array[String]) -> Array[Dict[String, _]] {
    let replies: SharedQueue[String] = SharedQueue()
    Thread(fn () {
        let fd = net.dial('unix', path)
        let reader = io.LineReader(fd)
        for reqs {
            os.write(fd, "{it}\n")
            let got? = false
            while !got? && reader.fill() {
                for line in reader {
                    replies.put(line)
                    got? = true
                }
            }
        }
        os.close(fd)
    }).detach()
    let out: Array[Dict[String, _]] = []
    while #out < #reqs {
        h.repaint()
        if let Some(line) = replies.try-take(0.01) {
            out.push(json.parse(line))
        }
    }
    out
}

pub fn control-socket-reads-and-modifies-the-ui() {
    let h = ink.TestHarness(SockApp(), cols=30, rows=5, color?=false)
    let path = "{getenv('TMPDIR') ?? '/tmp'}/ink-test-{os.getpid()}.sock"
    ink.serve(path)
    let rs = sock-session(h, path, [
        '{"cmd":"screen"}',
        '{"cmd":"set","field":"count","value":7}',
        '{"cmd":"get"}',
        '{"cmd":"nope"}'
    ])
    h.repaint()
    assert(rs[0]['result'][0].match?(/count=0/))
    assert(rs[1]['ok'])
    assert(rs[2]['result']['_count'] == 7)
    assert(!rs[3]['ok'])
    assert(h.line(0).match?(/count=7/))
}

class PartsApp < ink.Component {
    render() -> ink.Node {
        <ink.Box>
            <ink.Slider width=20 value=0.5 />
            <ink.TreeView root='r' label=(n -> n) children=(n -> (n == 'r') ? ['a'] : []) height=2 />
            <ink.ProgressBar value=0.5 width=12 />
            <ink.BarChart data=[] />
        </ink.Box>
    }
}

pub fn looks-reach-every-widget() {
    ink.use-looks('''
        Slider::thumb { content: "◉" }
        TreeView::toggle { content: "+ " }
        ProgressBar::fill { content: "█" }
        BarChart::empty { content: "nothing" }
    ''')
    let h = ink.TestHarness(PartsApp(), cols=40, rows=10, color?=false)
    h.assert-contains('◉')
    h.assert-contains('[+] r')
    h.assert-contains('█')
    h.assert-contains('nothing')
    ink.use-looks('')
}
