import ink
import term (event)

let CTRL = 4

ns test

class TIApp < ink.Component {
    submitted: String | nil = nil
    changed: String | nil = nil

    render() {
        <ink.Box>
            <ink.TextInput
                width=30
                placeholder="type here"
                on-submit=(t -> do { submitted = t })
                on-change=(t -> do { changed = t })
            />
        </ink.Box>
    }
}

class TIValueApp < ink.Component {
    val: String = 'preset'
    render() {
        <ink.Box><ink.TextInput width=30 value=val /></ink.Box>
    }
}

class TIHistApp < ink.Component {
    hist: Array[String] = []
    render() {
        <ink.Box><ink.TextInput width=30 history=hist /></ink.Box>
    }
}

fn make() {
    let app = TIApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let $ti = h.find(ink.TextInput) or throw 'no TextInput'
    h.focus!(ti)
    (h, ti)
}

fn chars(ti) -> Array[String] {
    ti.ed.chars
}

fn cursor(ti) -> Int {
    ti.ed.cursor
}

pub fn typing() {
    let (h, ti) = make()
    h.send-text('hello')
    assert(chars(ti).join() == 'hello')
    assert(cursor(ti) == 5)
    h.assert-contains('hello')
}

pub fn backspace() {
    let (h, ti) = make()
    h.send-text('abc')
    h.backspace()
    assert(chars(ti).join() == 'ab')
    assert(cursor(ti) == 2)
}

pub fn delete-key() {
    let (h, ti) = make()
    h.send-text('abc')
    h.home()
    h.del()
    assert(chars(ti).join() == 'bc')
}

pub fn cursor-left-right() {
    let (h, ti) = make()
    h.send-text('abcd')
    assert(cursor(ti) == 4)
    h.left()
    assert(cursor(ti) == 3)
    h.left()
    assert(cursor(ti) == 2)
    h.right()
    assert(cursor(ti) == 3)
}

pub fn cursor-home-end() {
    let (h, ti) = make()
    h.send-text('abcd')
    h.home()
    assert(cursor(ti) == 0)
    h.end()
    assert(cursor(ti) == 4)
}

pub fn ctrl-a-e() {
    let (h, ti) = make()
    h.send-text('hello')
    h.send-key('a', mods=CTRL)
    assert(cursor(ti) == 0)
    h.send-key('e', mods=CTRL)
    assert(cursor(ti) == 5)
}

pub fn ctrl-k() {
    let (h, ti) = make()
    h.send-text('hello world')
    h.send-key('a', mods=CTRL)
    h.right()
    h.right()
    h.right()
    h.right()
    h.right()
    h.send-key('k', mods=CTRL)
    assert(chars(ti).join() == 'hello')
}

pub fn ctrl-u() {
    let (h, ti) = make()
    h.send-text('hello world')
    h.send-key('a', mods=CTRL)
    for ..5 { h.right() }
    h.send-key('u', mods=CTRL)
    assert(chars(ti).join() == ' world')
    assert(cursor(ti) == 0)
}

pub fn ctrl-w() {
    let (h, ti) = make()
    h.send-text('hello world')
    h.send-key('w', mods=CTRL)
    assert(chars(ti).join() == 'hello ')
}

pub fn submit() {
    let app = TIApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let $ti = h.find(ink.TextInput) or throw 'no TI'
    h.focus!(ti)
    h.send-text('test')
    h.enter()
    assert(app.submitted == 'test')
}

pub fn on-change-fires() {
    let app = TIApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let $ti = h.find(ink.TextInput) or throw 'no TI'
    h.focus!(ti)
    h.send-text('x')
    assert(app.changed == 'x')
    h.send-text('y')
    assert(app.changed == 'xy')
}

pub fn placeholder() {
    let h = ink.TestHarness(TIApp(), cols=40, rows=10)
    h.assert-contains('type here')
    let $ti = h.find(ink.TextInput) or throw 'no TI'
    h.focus!(ti)
    h.send-text('x')
    h.assert-not-contains('type here')
}

pub fn scroll-long-input() {
    let (h, ti) = make()
    let long = 'abcdefghijklmnopqrstuvwxyz0123456789'
    h.send-text(long)
    assert(chars(ti).join() == long)
    h.assert-contains('0123456789')
    h.assert-not-contains('abcdef')
}

pub fn history-up-down() {
    let app = TIHistApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let $ti = h.find(ink.TextInput) or throw 'no TI'
    h.focus!(ti)

    fn clear(h) {
        h.send-key('a', mods=CTRL)
        h.send-key('k', mods=CTRL)
    }

    h.send-text('first')
    h.enter()
    clear(h)

    h.send-text('second')
    h.enter()
    clear(h)

    h.send-text('third')
    h.enter()
    clear(h)

    h.up()
    assert(chars(ti).join() == 'third')
    h.up()
    assert(chars(ti).join() == 'second')
    h.up()
    assert(chars(ti).join() == 'first')
    h.down()
    assert(chars(ti).join() == 'second')
    h.down()
    assert(chars(ti).join() == 'third')
    h.down()
    assert(chars(ti).join() == '')
}

pub fn value-prop() {
    let app = TIValueApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    h.assert-contains('preset')

    app.val = 'changed'
    h.repaint()
    h.assert-contains('changed')
}

pub fn escape-unfocuses() {
    let (h, ti) = make()
    h.assert-focused(ink.TextInput)
    h.esc()
    h.assert-unfocused()
}

pub fn insert-at-cursor() {
    let (h, ti) = make()
    h.send-text('ac')
    h.left()
    h.send-text('b')
    assert(chars(ti).join() == 'abc')
    assert(cursor(ti) == 2)
}

pub fn backspace-at-start-noop() {
    let (h, ti) = make()
    h.backspace()
    assert(chars(ti).join() == '')
    assert(cursor(ti) == 0)
}

pub fn left-at-start-noop() {
    let (h, ti) = make()
    h.left()
    assert(cursor(ti) == 0)
}

pub fn right-at-end-noop() {
    let (h, ti) = make()
    h.send-text('ab')
    h.right()
    assert(cursor(ti) == 2)
}

fn cyrillic(base: String, mods: Int = CTRL) -> event.Event {
    let key = %{'a': 1092, 'e': 1091, 'c': 1089}[base]!
    event.Key({key, _key: nil, base: ord(base), mods, event: 1, text: []})
}

pub fn ctrl-shortcuts-use-base-layout-key() {
    let (h, ti) = make()
    h.send-text('hello')
    h.send(cyrillic('a'))
    assert(cursor(ti) == 0)
    h.send(cyrillic('e'))
    assert(cursor(ti) == 5)
}

pub fn ctrl-c-with-base-layout-key-exits() {
    let (h, ti) = make()
    assert(h.send(cyrillic('c')) == ink.Exit)
}

class Shared < ink.Component {
    ed: ink.Editor
    render() {
        <ink.Box direction="column">
            <ink.TextInput editor=ed width=30 popup-at="below"
                highlight=ink.spans-of([(/#\w+/, 'magenta')]) />
            <ink.Text>{"len={#ed.text}"}</ink.Text>
        </ink.Box>
    }
}

fn shared(ed: ink.Editor, looks: String = '') {
    ink.use-looks(looks)
    let h = ink.TestHarness(Shared(ed=ed), cols=40, rows=12)
    h.focus!(h.find(ink.TextInput)!)
    h
}

pub fn terminal-cursor-shape-places-real-cursor() {
    let h = shared(ink.Editor(), 'TextInput::cursor \{ shape: bar \}')
    h.send-text('abc')
    assert(h.cursor == (1, 4, 'bar'))
    h.left()
    assert(h.cursor == (1, 3, 'bar'))
    ink.use-looks('')
}

pub fn fake-cursor-keeps-terminal-cursor-hidden() {
    let h = shared(ink.Editor())
    h.send-text('abc')
    assert(h.cursor == nil)
}

pub fn popup-renders-and-navigates() {
    let ed = ink.Editor(triggers=[
        ink.Trigger(/(?<=^|\s)#(\w*)$/, c -> ink.narrow(['red', 'green', 'grey'], c.query))
    ])
    let h = shared(ed)
    h.send-text('a #g')
    h.assert-contains('green')
    h.assert-contains('grey')
    h.assert-not-contains('red')
    h.down()
    h.enter()
    assert(ed.text == 'a #grey')
    h.assert-not-contains('green')
}

pub fn prompt-part() {
    let h = shared(ink.Editor(), 'TextInput::prompt \{ content: "> " \}')
    h.send-text('hi')
    h.assert-contains('│> hi')
    ink.use-looks('')
}

pub fn highlight-hook-styles-spans() {
    let h = shared(ink.Editor())
    h.send-text('x #tag y')
    let row = h.lines[1]
    assert(row.contains?('#tag'))
    assert(row.contains?(ink.fg-sgr('magenta')))
}

pub fn external-mutation-rerenders() {
    let ed = ink.Editor()
    let h = shared(ed)
    h.send-text('abc')
    ed.set-text('zz')
    h.repaint()
    h.assert-contains('zz')
    h.assert-contains('len=2')
}

class Legacy < ink.Component {
    render() {
        <ink.TextInput width=30 complete=(ctx -> ink.CycleCompletions(['foo', 'far'])) />
    }
}

pub fn legacy-complete-cycles-with-tab() {
    let h = ink.TestHarness(Legacy(), cols=40, rows=12)
    let $ti = h.find(ink.TextInput) or throw 'no TI'
    h.focus!(ti)
    h.tab()
    assert(ti.text == 'foo')
    h.tab()
    assert(ti.text == 'far')
    h.send-text('!')
    assert(ti.text == 'far!')
}

class Area < ink.Component {
    render() { <ink.TextArea width=20 height=5 /> }
}

pub fn text-area-enter-inserts-newlines() {
    let h = ink.TestHarness(Area(), cols=30, rows=8)
    let $ta = h.find(ink.TextArea) or throw 'no TA'
    h.focus!(ta)
    h.send-text('ab')
    h.enter()
    h.send-text('cd')
    assert(ta.text == "ab\ncd")
    h.up()
    assert(ta.ed.row == 0)
    h.assert-contains('ab')
    h.assert-contains('cd')
}

class Menu < ink.Component {
    picker: ink.Picker = ink.Picker([ink.Suggestion('one', detail='first'), ink.Suggestion('two', detail='second')])
    render() { <ink.SuggestionList completion=picker width=30 /> }
}

pub fn suggestion-list-renders-a-picker() {
    let app = Menu()
    let h = ink.TestHarness(app, cols=40, rows=8)
    h.assert-contains('one  first')
    app.picker.move(1)
    h.repaint()
    assert(h.lines.any?(\_.contains?(ink.fg-sgr('text'))))
    h.assert-contains('two  second')
}
