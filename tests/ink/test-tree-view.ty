import ink
import term (event)

ns test

class TreeApp < ink.Component {
    rev: Int = 1
    child-calls: Int = 0
    include-c?: Bool = false
    include-b?: Bool = true
    cursor-node: String | nil = nil

    child-nodes(node: String) -> Array[String] {
        child-calls += 1
        match node {
            'root' => [
                'a',
                'b' if include-b?,
                'c' if include-c?
            ],
            'a' => ['a1', 'a2'],
            _ => []
        }
    }

    render() {
        <ink.TreeView
            root="root"
            children=(node -> child-nodes(node))
            label=(node -> node)
            key=(node -> node)
            expandable=(node -> node == 'a')
            revision=rev
            show-root?=false
            height=8
            on-cursor=(node -> do { cursor-node = node })
        />
    }
}

class LegacyTreeApp < ink.Component {
    child-calls: Int = 0
    include-b?: Bool = false

    child-nodes(node: String) -> Array[String] {
        child-calls += 1
        (node == 'root') ? ['a', 'b' if include-b?] : []
    }

    render() {
        <ink.TreeView
            root="root"
            children=(node -> child-nodes(node))
            label=(node -> node)
            expandable=(_ -> false)
            show-root?=false
            height=4
        />
    }
}

class CursorBackgroundApp < ink.Component {
    render() {
        <ink.TreeView root="root" show-root?=false
            children=(node -> node == 'root' ? ['a','b'] : [])
            label=(node -> node) expandable=(_ -> false)
            cursor-bg="#112233" width=18 height=2 />
    }
}

class LargeTreeApp < ink.Component {
    rev: Int = 1
    child-calls: Int = 0

    child-nodes(node: String) -> Array[String] {
        child-calls += 1
        (node == 'root') ? ["item-{i}" for i in ..300] : []
    }

    render() {
        <ink.TreeView
            root="root"
            children=(node -> child-nodes(node))
            label=(node -> node)
            key=(node -> node)
            expandable=(_ -> false)
            revision=rev
            show-root?=false
            height=6
        />
    }
}

fn tree(h) -> ink.TreeView {
    let $tv = h.find(ink.TreeView) or throw 'no TreeView'
    tv
}

fn visible-count(tv) -> Int {
    #ink.TreeView.__get__(tv, '__visible')
}

fn cursor(tv) -> Int {
    ink.TreeView.__get__(tv, '__cursor')
}

pub fn revision-cache-survives-repaints() {
    let app = TreeApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let tv = tree(h)

    assert(app.child-calls == 1)
    assert(visible-count(tv) == 2)
    h.focus!(tv)
    for ..20 {
        h.down()
        h.up()
    }
    assert(app.child-calls == 1)
    assert(visible-count(tv) == 2)
}

pub fn revision-change-publishes-new-structure() {
    let app = TreeApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let tv = tree(h)

    app.include-c? = true
    h.repaint()
    assert(app.child-calls == 1)
    assert(visible-count(tv) == 2)
    h.assert-not-contains('c')

    app.rev += 1
    h.repaint()
    assert(app.child-calls == 2)
    assert(visible-count(tv) == 3)
    h.assert-contains('c')
}

pub fn expand-collapse-invalidates-cache() {
    let app = TreeApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let tv = tree(h)
    h.focus!(tv)
    let initial-calls = app.child-calls

    h.right()
    assert(visible-count(tv) == 4)
    h.assert-contains('a1')
    h.assert-contains('a2')
    assert(app.child-calls == initial-calls + 2)

    let expanded-calls = app.child-calls
    for ..10 { h.repaint() }
    assert(app.child-calls == expanded-calls)

    h.left()
    assert(visible-count(tv) == 2)
    h.assert-not-contains('a1')
    assert(app.child-calls == expanded-calls + 1)
}

pub fn cursor-follows-flattened-parent-child-order() {
    let app = TreeApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let tv = tree(h)
    h.focus!(tv)

    assert(cursor(tv) == 0)
    h.right()
    assert(cursor(tv) == 0)
    h.right()
    assert(cursor(tv) == 1)
    assert(app.cursor-node == 'a1')
    h.down()
    assert(cursor(tv) == 2)
    assert(app.cursor-node == 'a2')
    h.left()
    assert(cursor(tv) == 0)
    assert(app.cursor-node == 'a')
    h.left()
    assert(visible-count(tv) == 2)
    assert(cursor(tv) == 0)
}

pub fn cursor-clamps-when-revision-shrinks-tree() {
    let app = TreeApp()
    let h = ink.TestHarness(app, cols=40, rows=10)
    let tv = tree(h)
    h.focus!(tv)

    h.right()
    h.end()
    assert(cursor(tv) == 3)
    app.include-b? = false
    app.rev += 1
    h.repaint()
    assert(visible-count(tv) == 3)
    assert(cursor(tv) == 2)
}

pub fn nil-revision-retains-live-callback-behavior() {
    let app = LegacyTreeApp()
    let h = ink.TestHarness(app, cols=40, rows=6)
    let tv = tree(h)
    h.focus!(tv)
    let calls = app.child-calls

    app.include-b? = true
    h.down()
    assert(app.child-calls == calls + 1)
    assert(visible-count(tv) == 2)
    h.assert-contains('b')
}

pub fn cursor-background-fills-focused-row() {
    let h=ink.TestHarness(CursorBackgroundApp(),cols=18,rows=4)
    let bg="[48;2;17;34;51m"
    assert(h.painted-lines[0].contains?(bg))
    assert(!h.painted-lines[1].contains?(bg))
    assert(#h.line(0) == 18)
}

pub fn large-flattened-cache-is-reused() {
    let app = LargeTreeApp()
    let h = ink.TestHarness(app, cols=50, rows=8)
    let tv = tree(h)

    assert(visible-count(tv) == 300)
    assert(app.child-calls == 1)
    h.focus!(tv)
    for ..50 {
        h.down()
        h.up()
    }
    assert(app.child-calls == 1)

    app.rev += 1
    h.repaint()
    assert(visible-count(tv) == 300)
    assert(app.child-calls == 2)
}
