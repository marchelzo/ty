fn bits(a: Int, b: Int) -> Array[Int | nil] {
    let m = (b == 0) ? nil : a % b
    [a & b, a | b, a ^ b, a << b, a >> b, m, ~a]
}

fn mutated(a: Int, b: Int) -> Array[Int] {
    let (p, q, r, s, t) = (a, a, a, a, a)
    p &= b
    q |= b
    r ^= b
    s <<= b
    t >>= b
    [p, q, r, s, t]
}

fn sweep(f: Function) -> Array[_] {
    [f(a, b) for a in XS for b in YS]
}

pub fn bitwise-ops-match-the-interpreter() {
    for round in ..300 {
        let got = sweep(bits)
        assert(got == EXPECTED, "round {round}")
        let mut = sweep(mutated)
        assert(mut == EXPECTED.map(\_[;5]), "round {round}")
    }
}

fn sum-bytes(b: Blob) -> Int {
    let s = 0
    for i in ..#b {
        s += b[i]
    }
    s
}

fn fill(b: Blob, v: Int) {
    for i in ..#b {
        b[i] = v + i
    }
}

fn at(b: Blob, i: Int) -> Int {
    b[i]
}

fn put(b: Blob, i: Int, v: Int) {
    b[i] = v
}

fn put-any(b: Blob, i: Int, v: _) {
    b[i] = v
}

fn histogram(b: Blob, h: Array[Int]) {
    for i in ..#b {
        h[b[i]] += 1
    }
}

fn any-at(xs: _, i: Int) -> _ {
    xs[i]
}

pub fn blob-subscripts-match-the-interpreter() {
    for round in ..300 {
        let b = Blob()
        for i in ..300 {
            b.push(i % 256)
        }
        assert(sum-bytes(b) == [i % 256 for i in ..300].sum(0))
        fill(b, 250)
        assert(b[0] == 250 && b[5] == 255 && b[6] == 0 && b[-1] == (250 + 299) % 256)
        put(b, -1, -1)
        assert(at(b, -1) == 255 && at(b, 299) == 255)
        put(b, 0, 300)
        assert(at(b, 0) == 44)
        assert(at(b, -300) == 44)
        let oob = try { at(b, 300); nil } catch e: IndexError { 'index' }
        assert(oob == 'index')
        let neg = try { at(b, -301); nil } catch e: IndexError { 'index' }
        assert(neg == 'index')
        let bad = try { put-any(b, 1, nil); nil } catch e { 'bad' }
        put-any(b, 2, 513)
        assert(at(b, 2) == 1)
        assert(bad == 'bad')
        let h = [0 for ..256]
        histogram(b, h)
        assert(h.sum(0) == 300)
        assert(any-at(b, 1) == b[1])
        assert(any-at([10, 20, 30], -1) == 30)
        assert(any-at('héllo', 1) == 'é')
    }
}

fn hash(s: String) -> Int {
    let h = 5381
    for i in ..s.size() {
        h = ((h << 5) + h) ^ (s.byte(i) ?? 0)
    }
    h
}

fn byte-at(s: String, i: Int) -> Int | nil {
    s.byte(i)
}

pub fn string-bytes-match-the-interpreter() {
    let s = 'héllo, wörld ' * 20
    let want = do {
        let h = 5381
        for b in s.bytes() {
            h = ((h << 5) + h) ^ b
        }
        h
    }
    for round in ..300 {
        assert(hash(s) == want, "round {round}")
        assert(byte-at('abc', 0) == 97)
        assert(byte-at('abc', -1) == 99)
        assert(byte-at('abc', 3) == nil)
        assert(byte-at('abc', -4) == nil)
        assert(byte-at('é', 1) == 0xA9)
    }
}

fn first-or(xs: Array[Int | nil], d: Int) -> Int {
    let s = 0
    for x in xs {
        s += x ?? d
    }
    s
}

pub fn nil-coalescing-matches-the-interpreter() {
    let xs = [1, nil, 3, nil, nil, 6]
    for round in ..300 {
        assert(first-or(xs, 10) == 40, "round {round}")
        assert(first-or([], 10) == 0)
        assert(first-or([nil], -1) == -1)
    }
}

fn wide-sum(b: Blob, extra: Int) -> Int {
    let s = 0
    for i in ..#b + extra {
        s += b[i]
    }
    s
}

fn wrapped-sum(b: Blob) -> Int {
    let s = 0
    for i in ..#b {
        s += b[i - #b]
    }
    s
}

fn wrapped-fill(b: Blob) {
    for i in ..#b {
        b[i - #b] = i * 3
    }
}

pub fn held-blobs-keep-bounds-and-wrapping() {
    let b = Blob()
    for i in ..200 {
        b.push(i)
    }
    let want = [i for i in ..200].sum(0)
    for round in ..2000 {
        assert(wide-sum(b, 0) == want, "round {round}")
        assert(wrapped-sum(b) == want)
    }
    let oob = try { wide-sum(b, 1); nil } catch e: IndexError { 'index' }
    assert(oob == 'index')
    wrapped-fill(b)
    assert(b[1] == 3 && b[100] == 44 && b[199] == (597 % 256))
}

fn square-plus(x: Float) -> Float { x * x + 1.0 }
fn mix3(a: Int, b: Float, k) { a * 2 + b - k }
fn ratio(x: Float, y: Float) -> Float { x / y }
fn halve(n: Int) -> Int { n * 3 - 1 }

fn lanes(xs: Array[Float], ys: Array[Int]) -> (Float, Float, Int) {
    let s = 0.0
    let m = 0.0
    let h = 0
    for i in ..#xs {
        s += square-plus(xs[i])
        m += mix3(ys[i], xs[i], 2)
        h += halve(ys[i])
    }
    (s, m, h)
}

fn ratios(xs: Array[Float], d: Float) -> Float {
    let s = 0.0
    for i in ..#xs {
        s += ratio(xs[i], d)
    }
    s
}

pub fn small-calls-inline-into-registers() {
    let xs = [0.5, 1.5, 2.0, 3.25]
    let ys = [1, 2, 3, 4]
    let want = (
        xs.map(x -> x * x + 1.0).sum(0.0),
        [ys[i] * 2 + xs[i] - 2 for i in ..4].sum(0.0),
        ys.map(\_ * 3 - 1).sum(0)
    )
    for round in ..3000 {
        assert(lanes(xs, ys) == want, "round {round}")
        assert(ratios(xs, 2.0) == 3.625)
    }
    assert(try { ratios(xs, 0.0) } catch _: ZeroDivisionError { -1.0 } == -1.0)
    let mixed: _ = [0.5, 1, 2.0, 3.25]
    assert(lanes(mixed, ys)[0] == 0.25 + 1.0 + 1.0 + 1.0 + 4.0 + 1.0 + 3.25 * 3.25 + 1.0)
}

fn pair-sum(a: Array[Int], b: Array[Int]) -> Int {
    let s = 0
    for i in ..#a {
        s += a[i] + b[i]
    }
    s
}

fn blob-pair(a: Blob, b: Blob) -> Int {
    let s = 0
    for i in ..#a {
        s += a[i] * b[i]
    }
    s
}

fn skewed(a: Blob) -> Int {
    let s = 0
    for i in ..#a {
        s += a[i]
        i = i + 1
        s += a[i]
    }
    s
}

fn view-sum(x: Blob) -> Float {
    let s = 0.0
    for i in ..#x.f64 {
        s += x.f64[i] + x.f32[i]
    }
    s
}

pub fn proven-indices-keep-other-checks() {
    let a = [1, 2, 3, 4]
    for round in ..3000 {
        assert(pair-sum(a, [10, 20, 30, 40]) == 110, "round {round}")
    }
    assert(try { pair-sum(a, [1, 2]) } catch _: IndexError { -1 } == -1)
    let long = Blob(1, 2, 3, 4, 5, 6, 7, 8)
    for round in ..3000 {
        assert(blob-pair(long, long) == 204, "round {round}")
    }
    assert(try { blob-pair(long, Blob(1, 2)) } catch _: IndexError { -1 } == -1)
    let b = Blob(1, 2, 3)
    let e = try { for ..3000 { skewed(Blob(1, 2, 3, 4)) }; skewed(b) } catch _: IndexError { -1 }
    assert(e == -1)
    let x = Blob.zeros(16)
    x.f64[0] = 1.0
    x.f64[1] = 2.0
    for ..3000 {
        assert(view-sum(x) == 3.0 + x.f32[0] + x.f32[1])
    }
}

fn djb(s: String) -> Int {
    let h = 5381
    for i in ..s.size() + 2 {
        h = ((h << 5) + h) ^ (s.byte(i) ?? 7)
    }
    h
}

fn reference-djb(s: String) -> Int {
    let h = 5381
    for i in ..s.size() + 2 {
        let b = (i < s.size()) ? s.byte(i) : 7
        h = ((h << 5) + h) ^ b
    }
    h
}

fn maybe-sum(xs: Array[?Float]) -> Float {
    let s = 0.0
    for i in ..#xs {
        s = s * 0.5 + (xs[i] ?? 1.5)
    }
    s
}

pub fn string-bytes-and-defaults-stay-in-registers() {
    let s = 'hello, world'
    let want = reference-djb(s)
    for round in ..3000 {
        assert(djb(s) == want, "round {round}")
        assert(maybe-sum([1.0, nil, 2.0]) == (1.0 * 0.5 + 1.5) * 0.5 + 2.0)
    }
    assert(djb('') == reference-djb(''))
    assert(djb('é') == reference-djb('é'))
    let odd: _ = [1.0, nil, 2]
    assert(maybe-sum(odd) == (1.0 * 0.5 + 1.5) * 0.5 + 2)
}

fn unpack16(tmp: Blob, n: Int) -> Int {
    let s = 0
    let i = 0
    while i < n {
        s += (tmp[i] | (tmp[i + 1] << 8)) + (tmp[i + 2] | (tmp[i + 3] << 8)) - tmp[i - 1 + 1]
        i += 4
    }
    s
}

fn stamp(b: Blob, n: Int) {
    let i = 0
    while i < n {
        b[i] = 1
        b[i + 3] = 2
        i += 2
    }
}

pub fn constant-offset-checks-merge() {
    let b = Blob()
    for i in ..64 {
        b.push(i * 7 % 256)
    }
    let want = do {
        let s = 0
        for i in ..16 {
            let j = i * 4
            s += (b[j] | (b[j + 1] << 8)) + (b[j + 2] | (b[j + 3] << 8)) - b[j]
        }
        s
    }
    for round in ..3000 {
        assert(unpack16(b, 64) == want, "round {round}")
    }
    assert(try { unpack16(b, 66) } catch _: IndexError { -1 } == -1)
    for ..3000 {
        stamp(Blob.zeros(16), 12)
    }
    let c = Blob.zeros(8)
    let e = try { stamp(c, 8); 0 } catch _: IndexError { -1 }
    assert(e == -1 && c[4] == 1 && c[6] == 1 && c[7] == 2)
}
