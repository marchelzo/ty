import jit (kernel!)

kernel! fn k-pairs(b: Blob) -> Int {
    let s = 0
    for i in ..#b - 1 {
        s += b[i] * 3 + b[i + 1]
    }
    s
}

fn t-pairs(b: Blob) -> Int {
    let s = 0
    for i in ..#b - 1 {
        s += b[i] * 3 + b[i + 1]
    }
    s
}

kernel! fn k-shifted(b: Blob, off: Int) -> Int {
    let s = 0
    for i in ..#b {
        s += b[i + off] * (i + 1)
    }
    s
}

fn t-shifted(b: Blob, off: Int) -> Int {
    let s = 0
    for i in ..#b {
        s += b[i + off] * (i + 1)
    }
    s
}

kernel! fn k-strided(b: Blob, start: Int, step: Int, n: Int) -> Int {
    let s = 0
    let j = start
    for k in ..n {
        s += b[j] + 2 * b[j + 3] + k
        j += step
    }
    s + j
}

fn t-strided(b: Blob, start: Int, step: Int, n: Int) -> Int {
    let s = 0
    let j = start
    for k in ..n {
        s += b[j] + 2 * b[j + 3] + k
        j += step
    }
    s + j
}

kernel! fn k-after(b: Blob, start: Int, step: Int, n: Int) -> Int {
    let s = 0
    let j = start
    for k in ..n {
        j -= step
        s += b[j] * (k + 1)
    }
    s
}

fn t-after(b: Blob, start: Int, step: Int, n: Int) -> Int {
    let s = 0
    let j = start
    for k in ..n {
        j -= step
        s += b[j] * (k + 1)
    }
    s
}

kernel! fn k-grid(xs: Array[Int], w: Int, h: Int) -> Int {
    let s = 0
    for y in ..h {
        for x in ..w {
            s += xs[y * w + x] * (x + 1)
        }
    }
    s
}

fn t-grid(xs: Array[Int], w: Int, h: Int) -> Int {
    let s = 0
    for y in ..h {
        for x in ..w {
            s += xs[y * w + x] * (x + 1)
        }
    }
    s
}

kernel! fn k-stores(b: Blob, off: Int, n: Int) -> Int {
    for i in 1...n {
        b[2 * i + off] = i * 7
    }
    #b
}

fn t-stores(b: Blob, off: Int, n: Int) -> Int {
    for i in 1...n {
        b[2 * i + off] = i * 7
    }
    #b
}

kernel! fn k-sparse(xs: Array[Float], n: Int) -> Float {
    let s = 0.0
    for k in ..n {
        if k % 3 == 0 {
            s += xs[k * 2 - 1]
        }
    }
    s
}

fn t-sparse(xs: Array[Float], n: Int) -> Float {
    let s = 0.0
    for k in ..n {
        if k % 3 == 0 {
            s += xs[k * 2 - 1]
        }
    }
    s
}

kernel! fn k-reassigned(b: Blob) -> Int {
    let s = 0
    for i in ..#b {
        s += b[i]
        i += 1
    }
    s
}

fn t-reassigned(b: Blob) -> Int {
    let s = 0
    for i in ..#b {
        s += b[i]
        i += 1
    }
    s
}

fn clone(x: _) -> _ {
    match x {
        b: Blob => Blob(b),
        a: Array => [*a],
        _ => x,
    }
}

fn outcome(f: _, args: _) -> _ {
    let xs = [clone(a) for a in args]
    let r = try { f(*xs) } catch e: IndexError { 'IndexError' }
    (r, xs)
}

fn check(name: String, k: _, t: _, args: _, failures: Array[String]) {
    let a = outcome(k, args)
    let b = outcome(t, args)
    if a != b {
        failures.push("{name}{args}: kernel={a} ty={b}")
    }
}

fn blob(n: Int) -> Blob {
    let b = Blob()
    for i in ..n {
        b.push((i * 37 + 11) % 256)
    }
    b
}

pub fn versioned-loops-match-ty() {
    let failures = []
    for n in [0, 1, 2, 5, 17] {
        check('pairs', k-pairs, t-pairs, (blob(n),), failures)
        for off in [-20, -3, -1, 0, 1, 3] {
            check('shifted', k-shifted, t-shifted, (blob(n), off), failures)
        }
    }
    for start in [-8, -1, 0, 2, 9, 30] {
        for step in [-3, -1, 0, 1, 2, 5] {
            for n in [0, 1, 3, 7] {
                check('strided', k-strided, t-strided, (blob(32), start, step, n), failures)
                check('after', k-after, t-after, (blob(32), start, step, n), failures)
            }
        }
    }
    let xs = [i * i for i in ..24]
    for (w, h) in [(4, 6), (6, 4), (5, 5), (0, 3), (3, 0), (24, 1)] {
        check('grid', k-grid, t-grid, (xs, w, h), failures)
    }
    for off in [-30, -2, 0, 1, 4] {
        for n in [0, 1, 5, 9] {
            check('stores', k-stores, t-stores, (blob(20), off, n), failures)
        }
    }
    let fs = [float(i) * 0.5 for i in ..20]
    for n in [0, 1, 4, 10, 11, 12] {
        check('sparse', k-sparse, t-sparse, (fs, n), failures)
    }
    for n in [0, 3, 8] {
        check('reassigned', k-reassigned, t-reassigned, (blob(n),), failures)
    }
    for failures {
        print(it)
    }
    assert(#failures == 0)
}

kernel! fn clampish(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    x
}

kernel! fn bump(x: Int) -> Int {
    x += 10
    x * 2
}

kernel! fn note(b: Blob, i: Int, v: Int) {
    if v < 0 {
        return
    }
    b[i] = v
}

kernel! fn wild(b: Blob, i: Int) -> Int {
    b[i * 7 - 3]
}

kernel! fn deep3(x: Int) -> Int { bump(x) + 1 }
kernel! fn deep2(x: Int) -> Int { deep3(x) * 2 }
kernel! fn deep1(x: Int) -> Int { deep2(x) - 1 }

kernel! fn k-inlined(b: Blob, n: Int) -> Int {
    let s = 0
    let x = 5
    for i in ..#b {
        s += clampish(b[i], 10, 200) + bump(x) + wild(b, i)
        note(b, i, n - i)
    }
    s + x + deep1(n)
}

fn t-clampish(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    x
}

fn t-bump(x: Int) -> Int {
    x += 10
    x * 2
}

fn t-note(b: Blob, i: Int, v: Int) {
    if v < 0 {
        return
    }
    b[i] = v
}

fn t-wild(b: Blob, i: Int) -> Int {
    b[i * 7 - 3]
}

fn t-deep1(x: Int) -> Int { (t-bump(x) + 1) * 2 - 1 }

fn t-inlined(b: Blob, n: Int) -> Int {
    let s = 0
    let x = 5
    for i in ..#b {
        s += t-clampish(b[i], 10, 200) + t-bump(x) + t-wild(b, i)
        t-note(b, i, n - i)
    }
    s + x + t-deep1(n)
}

pub fn inlined-kernels-match-ty() {
    let failures = []
    for size in [0, 1, 2, 3, 5] {
        for n in [-1, 0, 3, 300] {
            check('inlined', k-inlined, t-inlined, (blob(size), n), failures)
        }
    }
    for failures {
        print(it)
    }
    assert(#failures == 0)
}
