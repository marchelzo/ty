fn pair(xs: Array[String]) -> String {
    let [p, ?q] = xs
    "p={p} q={q}"
}

fn pair-then-local(xs: Array[String]) -> String {
    let y = 5
    let [p, ?q] = xs
    "p={p} q={q} y={y}"
}

ns test {
    pub fn optional-capture-present() {
        for ..50 {
            assert(pair(['1', '2']) == 'p=1 q=2')
        }
    }

    pub fn optional-capture-missing() {
        for ..50 {
            assert(pair(['1']) == 'p=1 q=')
        }
    }

    pub fn optional-capture-keeps-stack-balanced() {
        for ..50 {
            assert(pair-then-local(['1', '2']) == 'p=1 q=2 y=5')
            assert(pair-then-local(['1']) == 'p=1 q= y=5')
        }
    }
}
