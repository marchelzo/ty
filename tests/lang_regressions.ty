import chalk (chalk)
import os
import ty
import ty.test (xfail)
import support.process (FIXTURES, run)

fn eval(src: String) -> Any {
    ty.eval(src)
}

@xfail('a chalk template followed by an adjacent string on the next line fails to parse')
pub fn chalk-template-then-adjacent-string() {
    let src = ['do { let a = 1; str(chalk"[bold]{a}[/] "', '"tail") }'].join('\n')
    assert(eval(src) :: String)
}

@xfail('an inner #|] directly followed by the outer #|] fails to parse')
pub fn nested-conditional-closers() {
    let src = ['do {', '#|if true', '#|if true', 'let x = 1', '#|]', '#|]', '2', '}'].join('\n')
    assert(eval(src) == 2)
}

@xfail('__defined__ only accepts a bare identifier, not module.name')
pub fn defined-accepts-qualified-names() {
    assert(eval('__defined__(os.pipe)') == true)
}

@xfail('a lambda with only a rest parameter, (*a) -> a, is not variadic')
pub fn rest-only-lambda-is-variadic() {
    assert(eval('do { let f = (*a) -> a; [f(), f(1, 2)] }') == [[], [1, 2]])
}

@xfail('?T inside a tuple type is checked as T')
pub fn optional-inside-tuple-type() {
    let src = 'do { fn f(s: String) -> (String, ?String) { (s, nil) }; f("x") }'
    assert(eval(src) == ('x', nil))
}

fn fixture-output(name: String, env: Dict[String, String] = %{}) -> [String] {
    let result = run([str(FIXTURES / 'lang' / "{name}.ty")], env=env)
    assert(result.status == 0, result.stderr)
    result.stdout.lines()
}

pub fn subtag-inherits-tag-methods() {
    assert(fixture-output('tag-super-methods') == ['shape 2', 'shape 1', '4, 0, 0'])
}

pub fn annotated-template-holes() {
    assert(fixture-output('template-annotated-hole') == [
        "Let(Id(name: 'a', module: nil, constraint: Type(<class Int>)), Int(1))",
        'z, <class Int>, Int(1)',
    ])
}

pub fn operator-directive-on-first-line() {
    assert(fixture-output('operator-directive-first-line') == ['321'])
}

pub fn top-level-nonlinear-patterns() {
    assert(fixture-output('top-level-nonlinear') == ['distinct', 'pair 1', '5'])
}

pub fn field-before-operator-method() {
    assert(fixture-output('field-then-operator-method') == ['true, false, 3'])
}

pub fn jit-nil-interpolates-as-empty() {
    let out = fixture-output('jit-nil-interpolation', env=%{'TY_JIT_EAGER': '1'})
    assert(out == ['match 3', 'bad '])
}
