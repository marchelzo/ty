import http
import os
import ssl
import _client (serve, Client, WsClient, get)

let (CERT, KEY) = ssl.self-signed()

const NATIVE = __linux__ ? 'epoll' : 'kqueue'

fn routes(srv) {
    srv.get('/', (req, rsp) -> rsp.plain('ok'))
    srv.post('/echo', (req, rsp) -> rsp.write(req.body ?? ''))
    srv.get('/big', (req, rsp) -> rsp.write('k' * 1000000))
    srv.get('/sleep', fn (req, rsp) {
        http.sleep(0.05)
        rsp.plain('slept')
    })
    srv.ws('/echo', fn (sock, req) {
        while let $m = sock.recv() {
            sock.send(m)
        }
    })
}

fn fallback(setup: _, f: _, %kwargs) {
    if __linux__ {
        setenv('TY_HTTP_EPOLL', '1')
    }
    try {
        serve(setup, f, **kwargs)
    } finally {
        if __linux__ {
            unsetenv('TY_HTTP_EPOLL')
        }
    }
}

pub fn readiness-backend-http1() {
    fallback(routes, fn (srv) {
        let c = Client(srv.port)
        assert(c.get('/').body == 'ok')
        assert(srv.backend == NATIVE)
        for i in ..10 {
            assert(c.get('/').body == 'ok')
        }
        c.request('POST', '/echo', 'e' * 200000)
        assert(#c.response().body == 200000)
        assert(#c.get('/big').body == 1000000)
        assert(c.get('/sleep').body == 'slept')
        c.close()
    }, threads: 2)
}

pub fn readiness-backend-websocket() {
    fallback(routes, fn (srv) {
        let w = WsClient(srv.port, '/echo')
        w.send('ping')
        assert(w.recv() == 'ping')
        w.close()
    })
}

pub fn readiness-backend-tls() {
    fallback(routes, fn (srv) {
        let s = ssl.connect('127.0.0.1', srv.port, ctx: ssl.Context.client(ca: CERT))
        s.write('GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n')
        assert(s.read-all().str!().ends?('ok'))
        s.close()
    }, tls: {cert: CERT, key: KEY})
}

pub fn readiness-backend-timeouts() {
    fallback(routes, fn (srv) {
        let c = Client(srv.port)
        c.send('GET / HTTP/1.1\r\n')
        assert(c.response().status == 408)
        c.close()
    }, header-timeout: 0.2)
}

pub fn default-backend() {
    serve(routes, fn (srv) {
        assert(get(srv.port, '/').body == 'ok')
        assert(srv.backend == (__linux__ ? 'io_uring' : 'kqueue') || srv.backend == 'epoll')
    })
}
