import uv
import os

fn with-echo-server(f) {
    uv.run(fn () {
        let srv = uv.server('127.0.0.1', 0)

        srv.on-connection = fn (server) {
            let client = server.accept()
            let data = client.read(5)
            client.write(data)
            client.shutdown()
            client.close()
        }

        srv.listen()

        let (_, port) = os.getnameinfo(srv.address, os.NI_NUMERICHOST | os.NI_NUMERICSERV)

        f(port)

        srv.close()
    })
}

pub fn test-race-fastest-wins() {
    uv.run(fn () {
        let result = uv.race([
            fn () { uv.sleep(200ms); 'slow' },
            fn () { uv.sleep(10ms);  'fast' },
        ])
        assert(result == 'fast')
    })
}

pub fn test-race-survivor() {
    uv.run(fn () {
        let result = uv.race([
            fn () { throw RuntimeError('boom') },
            fn () { uv.sleep(10ms); 'ok' },
        ])
        assert(result == 'ok')
    })
}

pub fn test-race-all-fail() {
    uv.run(fn () {
        let threw? = false
        try {
            uv.race([
                fn () { throw RuntimeError('a') },
                fn () { throw RuntimeError('b') },
            ])
        } catch _ {
            threw? = true
        }
        assert(threw?)
    })
}

pub fn test-staggered-fast-fallback() {
    uv.run(fn () {
        let order = []
        let result = uv.race([
            fn () { order.push('a'); throw RuntimeError('nope') },
            fn () { order.push('b'); 'ok' },
        ], stagger=5000ms)
        assert(result == 'ok')
        assert(order == ['a', 'b'])
    })
}

pub fn test-staggered-first-wins() {
    uv.run(fn () {
        let result = uv.race([
            fn () { uv.sleep(10ms); 'first' },
            fn () { uv.sleep(10ms); 'second' },
        ], stagger=5000ms)
        assert(result == 'first')
    })
}

pub fn test-race-slow-cancels() {
    uv.run(fn () {
        let ok = true
        let result = uv.race([
            fn () { uv.sleep(300ms); ok = false; 'slow' },
            fn () { uv.sleep(10ms);              'fast' },
        ], stagger=150ms)
        uv.sleep(175ms)
        assert(result == 'fast')
        assert(ok)
    })
}

pub fn test-race-slow-wins-with-head-start() {
    uv.run(fn () {
        let ok = true
        let result = uv.race([
            fn () { uv.sleep(500ms);             'slow' },
            fn () { uv.sleep(125ms); ok = false; 'fast' },
        ], stagger=475ms)
        uv.sleep(175ms)
        assert(result == 'slow')
        assert(ok)
    })
}

pub fn test-dial-echo() {
    with-echo-server(fn (port) {
        let sock = uv.dial('127.0.0.1', port)
        sock.write('hello')
        assert(sock.read(5) == 'hello')
        sock.close()
    })
}

pub fn test-happy-eyeballs() {
    with-echo-server(fn (port) {
        let sock = uv.dial('localhost', port)
        sock.write('hello')
        assert(sock.read(5) == 'hello')
        sock.close()
    })
}

pub fn test-happy-eyeballs-fast-fallback() {
    with-echo-server(fn (port) {
        let sock = uv.dial('localhost', port, stagger=5000ms)
        sock.write('hello')
        assert(sock.read(5) == 'hello')
        sock.close()
    })
}

pub fn test-connection-refused() {
    uv.run(fn () {
        let threw? = false
        try {
            uv.dial('127.0.0.1', 1)
        } catch _ {
            threw? = true
        }
        assert(threw?)
    })
}

pub fn test-timeout-interrupts-the-body() {
    uv.run(fn () {
        let start   = uv.now()
        let caught? = false
        try {
            with uv.timeout(20ms) {
                uv.sleep(1000ms)
            }
        } catch _: uv.TimeoutError {
            caught? = true
        }
        assert(caught?)
        assert(uv.now() - start < 500ms)
    })
}

pub fn test-timeout-is-disarmed-on-exit() {
    let start = nil
    uv.run(fn () {
        start = uv.now()
        with uv.timeout(30ms) {
            uv.sleep(5ms)
        }
        uv.sleep(60ms)
    })
    assert(uv.now() - start < 500ms)
}

pub fn test-timeout-cleans-up-the-interrupted-operation() {
    let start = nil
    uv.run(fn () {
        start = uv.now()
        try {
            with uv.timeout(10ms) {
                uv.sleep(5000ms)
            }
        } catch _: uv.TimeoutError {
        }
    })
    assert(uv.now() - start < 500ms)
}

pub fn test-race-losers-cannot-swallow-cancellation() {
    uv.run(fn () {
        let zombie? = false
        let cleaned? = false
        let result = uv.race([
            fn () { uv.sleep(5ms); 'fast' },
            fn () {
                for ..3 {
                    try {
                        uv.sleep(30ms)
                        zombie? = true
                        return 'slow'
                    } catch _ {
                    }
                }
            },
            fn () {
                try {
                    uv.sleep(30ms)
                } finally {
                    cleaned? = true
                }
            },
        ])
        uv.sleep(100ms)
        assert(result == 'fast')
        assert(!zombie?)
        assert(cleaned?)
    })
}

pub fn test-spawn-returns-a-cancelable-task() {
    uv.run(fn () {
        let caught? = false
        let task = uv.spawn(fn () {
            try {
                uv.sleep(5000ms)
            } catch _: uv.CanceledError {
                caught? = true
            }
        })
        uv.cancel(task)
        assert(caught?)
    })
}

pub fn test-closing-a-task-runs-its-cleanup() {
    let start = nil
    let cleaned? = false
    uv.run(fn () {
        start = uv.now()
        let task = uv.spawn(fn () {
            try {
                uv.sleep(5000ms)
            } catch _ {
                cleaned? = nil
            } finally {
                cleaned? = (cleaned? != nil)
            }
        })
        task.close()
    })
    assert(cleaned?)
    assert(uv.now() - start < 500ms)
}

pub fn test-run-closes-stranded-tasks() {
    let cleaned? = false
    uv.run(fn () {
        uv.spawn(fn () {
            try {
                uv.sleep(5000ms)
            } finally {
                cleaned? = true
            }
        })
        uv.stop()
    })
    assert(cleaned?)
}

pub fn test-timeout-closes-a-pending-race() {
    uv.run(fn () {
        let losers = []
        let caught? = false
        try {
            with uv.timeout(20ms) {
                uv.race([
                    fn () { try { uv.sleep(5000ms) } finally { losers.push('a') } },
                    fn () { try { uv.sleep(5000ms) } finally { losers.push('b') } },
                ])
            }
        } catch _: uv.TimeoutError {
            caught? = true
        }
        assert(caught?)
        assert(losers.sort() == ['a', 'b'])
    })
}

pub fn test-stop-closes-blocked-connections() {
    let closed = 0
    uv.run(fn () {
        let srv = uv.server('127.0.0.1', 0)
        srv.on-connection = fn (server) {
            let client = server.accept()
            try {
                client.read(5)
            } finally {
                closed += 1
                client.close()
            }
            nil
        }
        srv.listen()
        let (_, port) = os.getnameinfo(srv.address, os.NI_NUMERICHOST | os.NI_NUMERICSERV)
        let socks = [uv.dial('127.0.0.1', port), uv.dial('127.0.0.1', port)]
        uv.sleep(20ms)
        srv.close()
        uv.stop()
    })
    assert(closed == 2)
}

pub fn test-cancel-after-finish-is-a-noop() {
    uv.run(fn () {
        let task = uv.spawn(fn () { 'done' })
        uv.cancel(task)
    })
}

pub fn test-timeout-interrupts-a-bare-yield() {
    uv.run(fn () {
        let caught? = false
        try {
            with uv.timeout(10ms) {
                yield nil
            }
        } catch _: uv.TimeoutError {
            caught? = true
        }
        assert(caught?)
    })
}
