import xml (..)

ns test

pub fn xml-xpath() {
    let doc = parse('''
        <based>
            Here is some text.
            <keyed id="based">Raspberries</keyed>
            <keyed id="cringe">Mangoes</keyed>
        </based>
    ''')
    doc.register-func('lowkey', fn (x) {
        if x[0].props.id == 'based' {
            x[0].props.msg = 'PASS'
        }
        1
    })
    let msgs = []
    for node in doc['//keyed[lowkey(.)]'] {
        assert('id' in node.props)
        assert('absent' not in node.props)
        assert('id' in node.props)
        if let $msg = node.props.?msg {
            msgs.push(msg)
        }
    }
    assert(msgs == ['PASS'])
}

pub fn schema-validation() {
    let schema = Schema.parse('''
        <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:element name="count" type="xs:integer"/>
        </xs:schema>
    ''')

    let (errors, warnings) = schema.validate(parse('<count>7</count>'))
    assert(#errors == 0)
    assert(#warnings == 0)

    let (errors, _) = schema.validate(parse('<count>invalid</count>'))
    assert(#errors > 0)
}
