pub fn dict-loops-bind-key-and-value() {
    let d = %{'a': 1, 'b': 2, 'c': 3}
    let out = []
    for k, v in d {
        out.push("{k}{v}")
    }
    assert(out == ['a1', 'b2', 'c3'])

    let total = 0
    for _, v in d {
        total += v
    }
    assert(total == 6)

    for k, [x, y] in %{'p': [1, 2]} {
        assert(k == 'p' && x == 1 && y == 2)
    }

    for k, v in %{} {
        assert(false)
    }
}

pub fn single-binding-still-gets-the-pair() {
    let ps = [p for p in %{'a': 1}]
    assert(ps == [('a', 1)])
}

pub fn comprehensions() {
    let d = %{'a': 1, 'b': 2, 'c': 3}
    assert([k for k, v in d] == ['a', 'b', 'c'])
    assert(%{v: k for k, v in d} == %{1: 'a', 2: 'b', 3: 'c'})
    assert([v for (_, v) in d if v > 1] == [2, 3])
}

pub fn other-iterables-of-pairs() {
    let sums = []
    for a, b in [(1, 2), (3, 4)] {
        sums.push(a + b)
    }
    assert(sums == [3, 7])

    fn gen*() {
        yield (5, 6)
        yield (7, 8)
    }
    let products = [x * y for x, y in gen()]
    assert(products == [30, 56])
}

pub fn non-pairs-are-match-errors() {
    let triples: _ = [(1, 2, 3)]
    let threw = false
    try {
        for a, b in triples {
            assert(false)
        }
    } catch _: MatchError {
        threw = true
    }
    assert(threw)

    let ints: _ = [1]
    threw = false
    try {
        for a, b in ints {
            assert(false)
        }
    } catch _: MatchError {
        threw = true
    }
    assert(threw)
}

fn innermost(spans: Dict[Int, Int], b: Int) -> Int {
    let best = -1
    for o, c in spans {
        if o < b && c > b && o > best {
            best = o
        }
    }
    best
}

pub fn hot-dict-loops-agree-across-tiers() {
    let spans = %{1: 10, 3: 8, 4: 6, 12: 20}
    let want = [-1, -1, 1, 1, 3, 4, 3, 3, 1, 1, -1, -1, -1, 12, 12, 12, 12, 12, 12, 12, -1]
    for round in ..300 {
        for b; i in want {
            assert(innermost(spans, i) == b)
        }
    }
}
