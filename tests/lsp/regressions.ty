pub fn class-field-defaults-across-edits() {
    let a = 'class C {\n    x: Int = 1\n    y: Int\n}\nlet c = C(y: 2)\n'
    let b = 'class C {\n    x: Int = 1\n    y: Int\n}\nlet c = C(y: 3)\n'
    exercise('class-field-defaults-across-edits', [a, b, a])
}

pub fn empty-lambda-params-without-arrow() {
    exercise('empty-lambda-params-without-arrow', ['| |', '|\n|', 'let f = | |\nprint(1)'])
