ns test

fn tagged-array-match(x) -> Bool {
    match x {
        Ok([(fd, ev)]) => (fd, ev) == (6, 1),
        _ => false
    }
}

pub fn matchtest() {
    match [3, ('foo', 'bar'), {a: 1, b: 2, c: 3}, 9, 9, 9] {
        [a, b, {a: 2}, *_] => { assert(false) },
        [x, ('foo', _), {a, b, c, ?d}, *rest] => {
            assert(x == 3)
            assert(a == 1)
            assert(b == 2)
            assert(c == 3)
            assert(rest == [9, 9, 9])
        },
        _ => assert(false)
    }
    match Ok(10) {
        Ok(x), [x, y, z] => {
            assert((x, y, z) == (10, nil, nil))
        }
    }
    assert(tagged-array-match(Ok([(6, 1)])))
}

fn kind(x) {
    match x {
        p: String | Int => 'scalar',
        _               => 'other'
    }
}

fn head-kind(xs) {
    match xs {
        [p: String | Int, *_] => 'scalar',
        _                     => 'other'
    }
}

pub fn union-annotation-pattern() {
    assert(kind('a') == 'scalar')
    assert(kind(1) == 'scalar')
    assert(kind(2.5) == 'other')
    assert(kind([1]) == 'other')
    assert(kind(nil) == 'other')
    assert(head-kind(['a', 2.5]) == 'scalar')
    assert(head-kind([1]) == 'scalar')
    assert(head-kind([2.5, 'a']) == 'other')
    assert(head-kind([[1]]) == 'other')
    assert(head-kind([]) == 'other')
}

fn ansi-kind(x) {
    match x {
        c :: 31...39 => "fg {c}",
        c :: ...9    => "attr {c}",
        _            => 'other'
    }
}

fn clamp-fg(c: 31...39) -> Int { c }

pub fn range-constraint-pattern() {
    assert(ansi-kind(31) == 'fg 31')
    assert(ansi-kind(39) == 'fg 39')
    assert(ansi-kind(4) == 'attr 4')
    assert(ansi-kind(40) == 'other')
    assert(ansi-kind(9.5) == 'other')
    assert(ansi-kind('35') == 'other')
    assert(ansi-kind([35]) == 'other')
    assert(clamp-fg(35) == 35)
}

class Widget { }
class Gadget { }

fn widget-kind(x) {
    match x {
        _: Widget              => 'widget',
        [_: Int, _: String]    => 'pair',
        {name: _: String, *}   => 'named',
        _                      => 'other'
    }
}

pub fn constrained-wildcard-pattern() {
    assert(widget-kind(Widget()) == 'widget')
    assert(widget-kind(Gadget()) == 'other')
    assert(widget-kind(5) == 'other')
    assert(widget-kind([1, 'a']) == 'pair')
    assert(widget-kind([1, 2]) == 'other')
    assert(widget-kind({name: 'w'}) == 'named')
    assert(widget-kind({name: 7}) == 'other')
    assert(#[Widget(), Gadget(), 3, Widget()].filter(match { _: Widget => true, _ => false }) == 2)
}

fn describe(x: Int | String | Array[Int]) -> String {
    match x {
        x :: Int     => "int: {x}",
        x :: String  => "str: {x}",
        x :: #x <= 3 => "small: {#x}",
        x            => "big: {#x}"
    }
}

pub fn class-constraints-narrow-later-arms() {
    assert(describe(42) == 'int: 42')
    assert(describe('hi') == 'str: hi')
    assert(describe([1, 2]) == 'small: 2')
    assert(describe([1, 2, 3, 4]) == 'big: 4')
}
