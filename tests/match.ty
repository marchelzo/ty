ns test

fn tagged-array-match(x) -> Bool {
    match x {
        Ok([(fd, ev)]) => (fd, ev) == (6, 1),
        _ => false
    }
}

pub fn matchtest() {
    match [3, ('foo', 'bar'), {a: 1, b: 2, c: 3}, 9, 9, 9] {
        [a, b, {a: 2}, *_] => { assert(false) },
        [x, ('foo', _), {a, b, c, ?d}, *rest] => {
            assert(x == 3)
            assert(a == 1)
            assert(b == 2)
            assert(c == 3)
            assert(rest.sum() == 27)
        },
        _ => assert(false)
    }
    match Ok(10) {
        Ok(x), [x, y, z] => {
            assert((x, y, z) == (10, nil, nil))
        }
    }
    assert(tagged-array-match(Ok([(6, 1)])))
}

fn kind(x) {
    match x {
        p: String | Int => 'scalar',
        _               => 'other'
    }
}

fn head-kind(xs) {
    match xs {
        [p: String | Int, *_] => 'scalar',
        _                     => 'other'
    }
}

pub fn union-annotation-pattern() {
    assert(kind('a') == 'scalar')
    assert(kind(1) == 'scalar')
    assert(kind(2.5) == 'other')
    assert(kind([1]) == 'other')
    assert(kind(nil) == 'other')
    assert(head-kind(['a', 2.5]) == 'scalar')
    assert(head-kind([1]) == 'scalar')
    assert(head-kind([2.5, 'a']) == 'other')
    assert(head-kind([[1]]) == 'other')
    assert(head-kind([]) == 'other')
}
