fn odd?(x) { x % 2 == 1 }
fn pair(x) { x > 100 ? (x, x + 1) : nil }

fn classify(x) {
    match if {
        x == 0               => [],
        x <  0               => nil,
        let (a, b) = pair(x) => a + b,
        odd?(x)              => -x,
        _                    => x
    }
}

pub fn match-if-expression() {
    assert([0, -3, 5, 4, 200].map(classify) == [[], nil, -5, 4, 401])
}

pub fn match-if-without-wildcard-is-nil() {
    let f = x -> match if {
        x == 1                 => 'one',
        let $y = x and y > 5   => "big {y}",
        not x == 3             => 'not three'
    }
    assert([1, 3, 9, 4].map(f) == ['one', nil, 'big 9', 'not three'])
}

pub fn match-if-statement() {
    let seen = []
    for x in [1, 2, 3] {
        match if {
            x == 1 => { seen.push('one') },
            x == 2 => seen.push('two'),
            _      => { seen.push('other'); continue }
        }
        seen.push(x)
    }
    assert(seen == ['one', 1, 'two', 2, 'other'])
}

pub fn match-while-runs-until-no-arm-matches() {
    let n = 10
    let steps = 0
    match while {
        n > 3 => { n -= 2; steps += 1 },
        n > 0 => { n -= 1; steps += 1 },
    }
    assert((n, steps) == (0, 6))
}

pub fn match-while-binds-and-breaks() {
    let q = [nil, [7, 8], [1, 2], [3, 4]]
    let sums = []
    match while {
        #sums > 1                      => break,
        let [a, b] = q.pop() and a > 2 => sums.push(a + b),
        _                              => sums.push('skip')
    }
    assert(sums == [7, 'skip'])
    assert(q == [nil, [7, 8]])
}

pub fn match-while-ends-on-failed-let() {
    let q = [nil, [7, 8], [1, 2]]
    let sums = []
    match while {
        let [a, b] = q.pop() => sums.push(a + b)
    }
    assert(sums == [3, 15])
    assert(q == [])
}

pub fn match-while-wildcard-loops() {
    let xs = [5, 6, 7, 8, 9]
    let out = []
    let i = 0
    match while {
        i >= #xs    => break,
        odd?(xs[i]) => { out.push(xs[i]); i += 1 },
        xs[i] == 8  => { i += 1; continue },
        _           => { out.push(-xs[i]); i += 1 }
    }
    assert(out == [5, -6, 7, 9])
}
