fn check(name: String, got: Array[Bool], want: Bool) {
    for got {
        assert(it == want, "{name}: {got}")
    }
}

ns test

pub fn lt-ff-matches-ieee() {
    check("lt-ff(nan, nan)", lt-ff(nan, nan), false)
    check("lt-ff(nan, 1.0)", lt-ff(nan, 1.0), false)
    check("lt-ff(nan, 2.0)", lt-ff(nan, 2.0), false)
    check("lt-ff(nan, inf)", lt-ff(nan, inf), false)
    check("lt-ff(nan, -inf)", lt-ff(nan, -inf), false)
    check("lt-ff(1.0, nan)", lt-ff(1.0, nan), false)
    check("lt-ff(1.0, 1.0)", lt-ff(1.0, 1.0), false)
    check("lt-ff(1.0, 2.0)", lt-ff(1.0, 2.0), true)
    check("lt-ff(1.0, inf)", lt-ff(1.0, inf), true)
    check("lt-ff(1.0, -inf)", lt-ff(1.0, -inf), false)
    check("lt-ff(2.0, nan)", lt-ff(2.0, nan), false)
    check("lt-ff(2.0, 1.0)", lt-ff(2.0, 1.0), false)
    check("lt-ff(2.0, 2.0)", lt-ff(2.0, 2.0), false)
    check("lt-ff(2.0, inf)", lt-ff(2.0, inf), true)
    check("lt-ff(2.0, -inf)", lt-ff(2.0, -inf), false)
    check("lt-ff(inf, nan)", lt-ff(inf, nan), false)
    check("lt-ff(inf, 1.0)", lt-ff(inf, 1.0), false)
    check("lt-ff(inf, 2.0)", lt-ff(inf, 2.0), false)
    check("lt-ff(inf, inf)", lt-ff(inf, inf), false)
    check("lt-ff(inf, -inf)", lt-ff(inf, -inf), false)
    check("lt-ff(-inf, nan)", lt-ff(-inf, nan), false)
    check("lt-ff(-inf, 1.0)", lt-ff(-inf, 1.0), true)
    check("lt-ff(-inf, 2.0)", lt-ff(-inf, 2.0), true)
    check("lt-ff(-inf, inf)", lt-ff(-inf, inf), true)
    check("lt-ff(-inf, -inf)", lt-ff(-inf, -inf), false)
}

pub fn le-ff-matches-ieee() {
    check("le-ff(nan, nan)", le-ff(nan, nan), false)
    check("le-ff(nan, 1.0)", le-ff(nan, 1.0), false)
    check("le-ff(nan, 2.0)", le-ff(nan, 2.0), false)
    check("le-ff(nan, inf)", le-ff(nan, inf), false)
    check("le-ff(nan, -inf)", le-ff(nan, -inf), false)
    check("le-ff(1.0, nan)", le-ff(1.0, nan), false)
    check("le-ff(1.0, 1.0)", le-ff(1.0, 1.0), true)
    check("le-ff(1.0, 2.0)", le-ff(1.0, 2.0), true)
    check("le-ff(1.0, inf)", le-ff(1.0, inf), true)
    check("le-ff(1.0, -inf)", le-ff(1.0, -inf), false)
    check("le-ff(2.0, nan)", le-ff(2.0, nan), false)
    check("le-ff(2.0, 1.0)", le-ff(2.0, 1.0), false)
    check("le-ff(2.0, 2.0)", le-ff(2.0, 2.0), true)
    check("le-ff(2.0, inf)", le-ff(2.0, inf), true)
    check("le-ff(2.0, -inf)", le-ff(2.0, -inf), false)
    check("le-ff(inf, nan)", le-ff(inf, nan), false)
    check("le-ff(inf, 1.0)", le-ff(inf, 1.0), false)
    check("le-ff(inf, 2.0)", le-ff(inf, 2.0), false)
    check("le-ff(inf, inf)", le-ff(inf, inf), true)
    check("le-ff(inf, -inf)", le-ff(inf, -inf), false)
    check("le-ff(-inf, nan)", le-ff(-inf, nan), false)
    check("le-ff(-inf, 1.0)", le-ff(-inf, 1.0), true)
    check("le-ff(-inf, 2.0)", le-ff(-inf, 2.0), true)
    check("le-ff(-inf, inf)", le-ff(-inf, inf), true)
    check("le-ff(-inf, -inf)", le-ff(-inf, -inf), true)
}

pub fn gt-ff-matches-ieee() {
    check("gt-ff(nan, nan)", gt-ff(nan, nan), false)
    check("gt-ff(nan, 1.0)", gt-ff(nan, 1.0), false)
    check("gt-ff(nan, 2.0)", gt-ff(nan, 2.0), false)
    check("gt-ff(nan, inf)", gt-ff(nan, inf), false)
    check("gt-ff(nan, -inf)", gt-ff(nan, -inf), false)
    check("gt-ff(1.0, nan)", gt-ff(1.0, nan), false)
    check("gt-ff(1.0, 1.0)", gt-ff(1.0, 1.0), false)
    check("gt-ff(1.0, 2.0)", gt-ff(1.0, 2.0), false)
    check("gt-ff(1.0, inf)", gt-ff(1.0, inf), false)
    check("gt-ff(1.0, -inf)", gt-ff(1.0, -inf), true)
    check("gt-ff(2.0, nan)", gt-ff(2.0, nan), false)
    check("gt-ff(2.0, 1.0)", gt-ff(2.0, 1.0), true)
    check("gt-ff(2.0, 2.0)", gt-ff(2.0, 2.0), false)
    check("gt-ff(2.0, inf)", gt-ff(2.0, inf), false)
    check("gt-ff(2.0, -inf)", gt-ff(2.0, -inf), true)
    check("gt-ff(inf, nan)", gt-ff(inf, nan), false)
    check("gt-ff(inf, 1.0)", gt-ff(inf, 1.0), true)
    check("gt-ff(inf, 2.0)", gt-ff(inf, 2.0), true)
    check("gt-ff(inf, inf)", gt-ff(inf, inf), false)
    check("gt-ff(inf, -inf)", gt-ff(inf, -inf), true)
    check("gt-ff(-inf, nan)", gt-ff(-inf, nan), false)
    check("gt-ff(-inf, 1.0)", gt-ff(-inf, 1.0), false)
    check("gt-ff(-inf, 2.0)", gt-ff(-inf, 2.0), false)
    check("gt-ff(-inf, inf)", gt-ff(-inf, inf), false)
    check("gt-ff(-inf, -inf)", gt-ff(-inf, -inf), false)
}

pub fn ge-ff-matches-ieee() {
    check("ge-ff(nan, nan)", ge-ff(nan, nan), false)
    check("ge-ff(nan, 1.0)", ge-ff(nan, 1.0), false)
