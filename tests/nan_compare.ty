    check("ge-ff(1.0, 1.0)", ge-ff(1.0, 1.0), true)
    check("ge-ff(1.0, 2.0)", ge-ff(1.0, 2.0), false)
    check("ge-ff(1.0, inf)", ge-ff(1.0, inf), false)
    check("ge-ff(1.0, -inf)", ge-ff(1.0, -inf), true)
    check("ge-ff(2.0, nan)", ge-ff(2.0, nan), false)
    check("ge-ff(2.0, 1.0)", ge-ff(2.0, 1.0), true)
    check("ge-ff(2.0, 2.0)", ge-ff(2.0, 2.0), true)
    check("ge-ff(2.0, inf)", ge-ff(2.0, inf), false)
    check("ge-ff(2.0, -inf)", ge-ff(2.0, -inf), true)
    check("ge-ff(inf, nan)", ge-ff(inf, nan), false)
    check("ge-ff(inf, 1.0)", ge-ff(inf, 1.0), true)
    check("ge-ff(inf, 2.0)", ge-ff(inf, 2.0), true)
    check("ge-ff(inf, inf)", ge-ff(inf, inf), true)
