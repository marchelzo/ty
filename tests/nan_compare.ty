import math (nan, inf)

let t? = true

fn lt-ff(a: Float, b: Float) -> Array[Bool] {
    [
        a < b,
        do { if a < b { true } else { false } },
        do { if !(a < b) { false } else { true } },
        (a < b) ? true : false,
        do { let r = false; while a < b { r = true; break }; r },
        do { let r = true; while !(a < b) { r = false; break }; r },
        match 0 { _ and a < b => true, _ => false },
        do { let x = a; let y = b; if x < y { true } else { false } },
        do { let r = false; for ..2 { if a < b { r = true } }; r },
        do { if t? && a < b { true } else { false } },
    ]
}

