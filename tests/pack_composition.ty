import ty.types as types

fn compose[...Args, b, c](f: b -> c, g: Args -> b) -> (Args -> c) {
    f@(g(*, **))
}

fn forward[...Args, b](g: Args -> b, *xs: ...Args) -> b {
    g(*xs)
}

fn add(x: Int, y: Int) -> Int { x + y }

ns test

pub fn declared-pack-survives-the-body() {
    assert(str(typeof compose) == '(f: (a) -> b, g: (...c) -> a) -> (...c) -> b')
    assert(str(typeof forward) == '(g: (...a) -> b, ...xs: a) -> b')
}

pub fn fixed-arity-functions-keep-their-shape() {
    assert(str(typeof compose(str, add)) == '(x: Int, y: Int) -> String')
    assert(compose(str, add)(1, 2) == '3')
    assert(compose(str, add)(1, y: 2) == '3')
    assert(forward(add, 1, 2) == 3)

    try {
        __eval__('fn add(x: Int, y: Int) -> Int { x + y }\ncompose(str, add)(1)')
        assert(false, 'a composed function accepted too few arguments')
    } catch ex :: '[bad-call]' in ex.what {
        ;
    }
}

pub fn lambdas-infer-the-pack() {
    assert(str(typeof compose(str, x -> x + 1)) == '(x: a) -> String where a + 1 <: b')
    assert(compose(str, x -> x + 1)(4) == '5')
    assert(
        str(typeof compose(&sum, &map(str)))
     == '(a) -> b where c.sum <: () -> b, a.map <: ((?x: Any) -> String) -> c'
    )
}

pub fn variadic-functions-compose() {
    assert(str(typeof compose(&.succ, max)(3, 9, 4)) == 'Int')
    assert(compose(&.succ, max)(3, 9, 4) == 10)
}

pub fn prelude-composition-forwards-keywords() {
    const show-sum = str . add

    assert(str(typeof show-sum) == '(x: Int, y: Int) -> String')
    assert((show-sum(1, 2), show-sum(1, y: 2), show-sum(x: 1, y: 2)) == ('3', '3', '3'))
}

pub fn function-constants-generalize() {
    const max-plus-1 = &.succ . max

    assert(str(typeof max-plus-1) == '(...a) -> b where ...(a |).succ <: b, ...(a |) <=> ...(a |) <: Int')
    assert((max-plus-1(3, 9, 4), max-plus-1(1, 2)) == (10, 3))
}

pub fn stateful-constants-stay-monomorphic() {
    try {
        __eval__('const q = SharedQueue()\nq.put("hello")\nlet n: Int = q.take()')
        assert(false, 'a queue constant was generalized')
    } catch ex :: '[assignment-type]' in ex.what {
        ;
    }
}

pub fn call-shape-diagnostics() {
    const ADD = 'fn add(x: Int, y: Int) -> Int { x + y }'

    fn reason(source: String) -> String {
        try {
            __eval__("{ADD}\n{source}")
        } catch ex {
            return ex.what
        }
        ''
    }

    assert('missing argument `y`' in reason('(str . add)(1)'))
    assert('unexpected keyword argument `z`' in reason('(str . add)(1, z: 2)'))
    assert('argument `x` is given twice' in reason('(str . add)(1, x: 2)'))
    assert('too many positional arguments: 3 given, at most 2 accepted' in reason('(str . add)(1, 2, 3)'))
}

pub fn annotated-functions-publish-their-signature() {
    assert(
        str(typeof `.?`)
     == 'overload{(a) -> b where .?a <: b; ((a) -> b, (...c) -> nil | a) -> (...c) -> nil | b}'
    )
    assert(str(typeof (int .? (x -> x.strip()))) == '(x: a) -> nil | Int where a.strip <: () -> nil | b')
    assert((int .? (x -> x.strip()))(' 12 ') == 12)
    assert((int .? (x -> nil))('12') == nil)
}

class Paired[T] {
    init(x: T) {
        self.x = x
    }

    x: T

    zip-with[...U, R](f: (T, *U) -> R, *ys: ...Iterable[U]) -> Generator[R] {
        cast(nil)
    }

    zip[...U](*ys: ...Iterable[U]) -> Generator[(T, U)] {
        cast(zip-with(tuple, *ys))
    }
}

fn spread-all[...U, R](f: (Int, *U) -> R, xs: Array[_]) -> R {
    f(*xs)
}

fn counted(n: Int) -> (*Int) {
    tuple(*[1 for _ in ..n])
}

fn mapped*[U](f: Int -> U) -> Generator[U] {
    yield f(1)
}

pub fn members-publish-their-declared-signature() {
    assert(str(typeof Paired.zip) == '(...ys: ...Iterable[a]) -> Generator[(b, a), nil] yields (b, a) sends nil')
    assert(str(typeof Iter.zip) == '(...ys: ...Iterable[a], ?longest: Bool, ?fill: Any) -> Generator[(b, a), nil] yields (b, a) sends nil')

    let values: Array[Int] = [1, 2]
    let labels: Array[String] = ['a', 'b']
    assert(str(typeof values.__iter__().zip(labels)) == 'Generator[(Int, String), nil]')
    assert([*values.__iter__().zip(labels)] == [(1, 'a'), (2, 'b')])

    try {
        __eval__('class Bad \{ bad[U](x: U) -> U \{ 1 \} \}')
        assert(false, 'a member body was not checked against its signature')
    } catch ex :: '[signature-mismatch]' in ex.what {
        ;
    }
}

pub fn spreads-leave-packs-open() {
    assert(str(typeof spread-all) == '(f: (Int, ...a) -> b, xs: Array[Dynamic]) -> b')
    assert(str(typeof mapped) == '(f: (Int) -> a) -> Generator[a, nil] yields a sends nil')
}

pub fn variadic-tuples-relate-and-destructure() {
    assert(str(typeof counted) == '(n: Int) -> (...Int)')

    let (a, b, c) = counted(3)
    assert(str(typeof a) == 'Int')
    assert(a + b + c == 3)

    let (p, q) = Iter.tee([1, 2])
    assert(str(typeof p) == 'Iterable[Int]')
    assert([*p] == [*q])
}

pub fn implicit-match-parameters-stay-anonymous() {
    assert(str(typeof match { item => item.value }) == '(a) -> b where a.value <: b')
    assert(types.show(types.type(typeof match { item => item.value })) == '(a) -> b where a.value <: b')
}
