macro swap!(e) {
    match e {
        $$[ $$a + $$b $$] => $$[ $$b - $$a $$],
        _                 => e,
    }
}

macro arity!(e) {
    match e {
        $$[ $$f($$x, *$$rest) $$] => $$[ #$${rest} + 1 $$],
        $$[ $$f() $$]             => $$[ 0 $$],
        _                         => $$[ -1 $$],
    }
}

macro same!(e) {
    match e {
        $$[ $$a == $$a $$] => $$[ true $$],
        _                  => e,
    }
}

macro second!(e) {
    if let $$[ [$$_, $$x, *$$_] $$] = e {
        x
    } else {
        $$[ nil $$]
    }
}

macro compose!(e) {
    match e {
        $$[ $$f($$g($$v)) $$] => $$[ ($$f . $$g)($$v) $$],
        _                     => e,
    }
}

fn inc(n: Int) -> Int {
    n + 1
}

fn dbl(n: Int) -> Int {
    n * 2
}

fn g(*xs: Int) -> Int {
    #xs
}

ns test

pub fn binds-holes() {
    let x = 10
    let y = 3
    assert(swap!(x + y) == -7)
}

pub fn rest-captures() {
    assert(arity!(g(1, 2, 3)) == 3)
    assert(arity!(g()) == 0)
    assert(arity!(5) == -1)
}

pub fn nonlinear-holes() {
    let q = 5
    assert(same!(q == q))
    assert(!same!(q == 4))
}

pub fn if-let-and-wildcards() {
    assert(second!([1, 2, 3, 4]) == 2)
    assert(second!(5) == nil)
}

pub fn nested-templates() {
    let x = 10
    assert(compose!(inc(dbl(x))) == 21)
}
