import ty
import ty.mod

ns my-group {
    pub fn adds-up() -> Int {
        __line__ - 1
    }

    fn helper() -> Int {
        __line__ - 1
    }
}

ns a {
    pub fn f() -> String {
        'a'
    }
}

ns b {
    pub fn f() -> String {
        'b'
    }
}

ns shapes {
    fn gen*() -> Generator[Int] {
        yield 1
    }

    fn takes(t: Int, u: Int = 1, *rest: Int) -> Int {
        t + u + #rest
    }

    fn over(a: Int) -> Int {
        a
    }

    fn over(a: String) -> String {
        a
    }
}

ns locals {
    fn outer() -> Int {
        fn inner() -> Int {
            1
        }
        inner()
    }
}

use Site = {
    module:      String,
    file:        ?String,
    scopes:      Array[String],
    name:        String,
    ident:       String,
    line:        Int,
    col:         Int,
    end-line:    Int,
    doc:         ?String,
    params:      Array[String],
    required:    Int,
    generator?:  Bool,
    public?:     Bool,
    overloaded?: Bool,
    func:        Any
}

fn sites-in(scope: String) -> Array[Site] {
    ty.tests().filter(\_.scopes == [scope])
}

fn compile-doomed() -> Bool {
    try {
        ty.mod.compile('pub fn doomed() {}\nlet x: Int = nope', nil, 'doomed.ty')
    } catch _: RuntimeError {
        return false
    }
    true
}

pub fn nested-namespace-sites() {
    let [adds, helper] = sites-in('my-group')
    assert(adds.scopes == ['my-group'])
    assert(adds.name == 'adds-up')
    assert(adds.ident == 'addsUp')
    assert(adds.public?)
    assert(adds.line == adds.func())
    assert(adds.end-line == adds.line + 2)
    assert(helper.scopes == ['my-group'])
    assert(helper.name == 'helper')
    assert(!helper.public?)
    assert(helper.line == helper.func())
    assert(helper.end-line == helper.line + 2)
}

pub fn sibling-namespaces-are-distinct() {
    let fa = sites-in('a')
    let fb = sites-in('b')
    assert(fa.map(&.scopes) == [['a']])
    assert(fb.map(&.scopes) == [['b']])
    assert(fa[0].func() == 'a')
    assert(fb[0].func() == 'b')
}

pub fn top-level-sites-have-no-scopes() {
    let sites = ty.tests().filter(\_.name == 'top-level-sites-have-no-scopes')
    assert(sites.map(&.scopes) == [[]])
}

pub fn site-shapes() {
    let sites = sites-in('shapes')
    assert(sites.map(&.name) == ['gen', 'takes', 'over'])
    let [gen, takes, over] = sites
    assert(gen.generator?)
    assert(!takes.generator?)
    assert(takes.params == ['t', 'u', 'rest'])
    assert(takes.required == 1)
    assert(over.overloaded?)
    assert(!takes.overloaded?)
    assert(over.end-line > over.line)
    assert(sites.all?(\!_.public?))
}

pub fn local-functions-are-not-sites() {
    let sites = sites-in('locals')
    assert(sites.map(&.name) == ['outer'])
    assert(sites[0].func() == 1)
}

pub fn imported-modules-register-nothing() {
    assert(ty.tests().all?(\_.file == __file__))
}

pub fn runtime-compiled-code-registers-nothing() {
    let n = #ty.tests()
    ty.mod.eval(ty.mod.compile('pub fn late-arrival() {}', nil, 'late.ty'))
    __eval__('pub fn evaluated-arrival() {}')
    assert(!compile-doomed())
    assert(#ty.tests() == n)
}
