ns test

let dropped = []

class A {
    k: Int
    init(k) {
        self.k = k
    }
    __drop__() {
        dropped.push(k)
    }
}

pub fn resource-drops() {
    dropped = []
    if let Some(^a, ^_) = Some(A(2), A(2)) {
        let ^_ = A(1)
    }
    for ^a in [3, 4, 5].map(A) {
        ;
    }
    try {
        let ^_ = A(7)
        {
            let ^_ = A(6)
            throw nil
        }
    } catch _ {
    }
    assert(dropped == [1, 2, 2, 3, 4, 5, 6, 7])
}

pub fn resource-drops-filtered-loops() {
    dropped = []
    for ^a in [1, 2, 3, 4].map(A) if a.k % 2 == 0 {
        ;
    }
    for ^a in [5, 6, 7].map(A) while a.k < 6 {
        ;
    }
    assert(dropped == [1, 2, 3, 4, 5, 6])
}

pub fn resource-drops-comprehensions() {
    dropped = []
    let xs = [a.k for ^a in [1, 2, 3, 4].map(A) if a.k % 2 == 0]
    let ys = [a.k for ^a in [5, 6, 7].map(A) while a.k < 6]
    let d = %{a.k: true for ^a in [8, 9].map(A)}
    let ps = [(x, i) for x; ^i in [10, 20]]
    assert(xs == [2, 4])
    assert(ys == [5])
    assert(d.list() == [(8, true), (9, true)])
    assert(ps == [(10, 0), (20, 1)])
    assert(dropped == [1, 2, 3, 4, 5, 6, 8, 9])
}

class W {
    k: Int
    init(k) {
        self.k = k
    }
    __enter__() {
        dropped.push(-k)
    }
    __drop__() {
        dropped.push(k)
    }
}

pub fn with-drops-in-reverse() {
    dropped = []
    with a = W(1), b = W(2), c = W(3) {
        dropped.push(0)
    }
    assert(dropped == [-1, -2, -3, 0, 3, 2, 1])
}

pub fn with-drops-in-reverse-on-throw() {
    dropped = []
    try {
        with a = W(1), b = W(2) {
            throw nil
        }
    } catch _ {
    }
    assert(dropped == [-1, -2, 2, 1])
}
