import ty

class Box {
    x = 1
    get() { x }
    add(n: Int, k: Int = 0) { x + n + k }
}

macro flip(e) {
    match e {
        ty.SafeSubscript(xs, i) => ty.Subscript(xs, i),
        ty.Subscript(xs, i)     => ty.SafeSubscript(xs, i),
        _                       => e
    }
}

fn index-error?(f) {
    try {
        f()
        false
    } catch IndexError(_, _) {
        true
    }
}

pub fn arrays() {
    let xs = [1, 2, 3]

    assert(xs.?[0] == 1)
    assert(xs.?[-1] == 3)
    assert(xs.?[-3] == 1)
    assert(xs.?[3] == nil)
    assert(xs.?[-4] == nil)
    assert(xs.?[9] ?? 99 == 99)
    assert(str(typeof xs.?[0]) == 'nil | Int')

    let xss = [[1, 2], [3]]
    assert(xss.?[1].?[0] == 3)
    assert(xss.?[1].?[1] == nil)
    assert(xss.?[7].?[0] == nil)
}

pub fn heaps-and-queues() {
    let h = Heap([3, 1, 2])
    assert(h.?[0] == 1)
    assert(h.?[3] == nil)

    let q = Queue()
    q.push(5)
    assert(q.?[0] == 5)
    assert(q.?[1] == nil)
}

pub fn tuples() {
    let t = (10, 'x')
    let i = 2

    assert(t.?[0] == 10)
    assert(t.?[-1] == 'x')
    assert(t.?[2] == nil)
    assert(t.?[i] == nil)
    assert(str(typeof t.?[1]) == 'nil | String')
    assert(str(typeof t.?[2]) == 'nil')
}

pub fn strings-and-blobs() {
    let s = 'héllo'

    assert(s.?[1] == 'é')
    assert(s.?[-1] == 'o')
    assert(s.?[5] == nil)
    assert(s.?[-6] == nil)
    assert(index-error?(-> s[-6]))

    let b = Blob()
    b.push(7)
    assert(b.?[0] == 7)
    assert(b.?[-1] == 7)
    assert(b.?[1] == nil)
    assert(index-error?(-> b[1]))
    assert(index-error?(-> b[-2]))
}

pub fn nil-and-dict-containers() {
    let xs: ?[Int] = nil
    let d = %{'a': 1}

    assert(xs.?[0] == nil)
    assert(str(typeof xs.?[0]) == 'nil | Int')
    assert(d.?['a'] == 1)
    assert(d.?['b'] == nil)
}

pub fn ast() {
    let xs = [1, 2, 3]

    assert(flip(xs[7]) == nil)
    assert(index-error?(-> flip(xs.?[7])))
}

pub fn jit-safe-subscript() {
    let f = __jit__ fn (xs: [Int], i: Int) { xs.?[i] }
    let g = __jit__ fn (t: (Int, Int), i: Int) { t.?[i] }
    let h = __jit__ fn (s: String, i: Int) { s.?[i] }

    let total = __jit__ fn (xs: [Int]) {
        let n = 0
        for i in ..#xs + 3 {
            n += xs.?[i] ?? 100
        }
        n
    }

    assert(f([1, 2, 3], 1) == 2)
    assert(f([1, 2, 3], -3) == 1)
    assert(f([1, 2, 3], 3) == nil)
    assert(f([1, 2, 3], -4) == nil)
    assert(g((1, 2), 1) == 2)
    assert(g((1, 2), 2) == nil)
    assert(h('abc', 2) == 'c')
    assert(h('abc', 3) == nil)
    assert(total([1, 2, 3]) == 306)
}

pub fn jit-optional-members() {
    let members = __jit__ fn (b: ?Box) {
        (b.?x, b.?get(), b.?add(1), b.?add(1, k: 5))
    }

    let dynamic = __jit__ fn (b: ?Box, field: String, method: String) {
        (b.?{field}, b.?{method}(), b.?{'add'}(2))
    }

    assert(members(Box()) == (1, 1, 2, 7))
    assert(members(nil) == (nil, nil, nil, nil))
    assert(dynamic(Box(), 'x', 'get') == (1, 1, 3))
    assert(dynamic(Box(), 'nope', 'nada') == (nil, nil, 3))
    assert(dynamic(nil, 'x', 'get') == (nil, nil, nil))
}
