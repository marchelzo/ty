pub fn string-slice-negative-count-is-relative-to-remainder() {
    let s = 'abcdef'
    assert(s.slice(0, -1) == 'abcde')
    assert(s.slice(1, -1) == 'bcde')
    assert(s.slice(2, -2) == 'cd')
    assert(s.slice(-3, -1) == 'de')
    assert(s.slice(4, -1) == 'e')
    assert(s.slice(1, -10) == '')
    assert('[::1]'.slice(1, -1) == '::1')
    assert('é✓xy'.slice(1, -1) == '✓x')
}

pub fn string-bslice-negative-count() {
    let s = 'abcdef'
    assert(s.bslice(0, -1) == 'abcde')
    assert(s.bslice(1, -1) == 'bcde')
    assert(s.bslice(2, -2) == 'cd')
    assert(s.bslice(-3, -1) == 'de')
    assert(s.bslice(1, -10) == '')
}

pub fn blob-slice-and-splice-negative-count() {
    let b = Blob('abcdef')
    assert(b.slice(0, -1).str!() == 'abcde')
    assert(b.slice(1, -1).str!() == 'bcde')
    assert(b.slice(-3, -1).str!() == 'de')
    let c = Blob('abcdef')
    assert(c.splice(1, -1).str!() == 'bcde')
    assert(c.str!() == 'af')
    let d = Blob('abcdef')
    assert(d.splice(-2, -1).str!() == 'e')
    assert(d.str!() == 'abcdf')
}

pub fn array-slice-and-splice-negative-count() {
    let a = [1, 2, 3, 4, 5, 6]
    assert(a.slice(0, -1) == [1, 2, 3, 4, 5])
    assert(a.slice(1, -1) == [2, 3, 4, 5])
    assert(a.slice(2, -2) == [3, 4])
    assert(a.slice(-3, -1) == [4, 5])
    let b = [1, 2, 3, 4, 5, 6]
    assert(b.splice(2, -1) == [3, 4, 5])
    assert(b == [1, 2, 6])
}

pub fn non-negative-counts-unchanged() {
    assert('abcdef'.slice(1, 3) == 'bcd')
    assert('abcdef'.bslice(2, 2) == 'cd')
    assert(Blob('abcdef').slice(1, 2).str!() == 'bc')
    assert([1, 2, 3, 4].slice(1, 2) == [2, 3])
    assert('abcdef'.slice(1, 4, 1) == 'bcd')
}
