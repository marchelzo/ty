import syn
import syn.lint as lint
import syn.slop as slop

fn hits(source: String, rule: String) -> Array[Int] {
    let rules = slop.RULES.filter(\_.name == rule)
    lint.check(syn.parse(source), rules).map(&.line)
}

fn fixed(source: String, rule: String, unsafe?: Bool = false) -> String {
    lint.fix(source, slop.RULES.filter(\_.name == rule), unsafe?=unsafe?).source
}

let DENSE = '''
    fn f(x) {
        let a = 1
        let b = 2
        let c = 3
        let d = 4
        let e = 5
        let f = 6
        let g = 7
        let h = 8
        let i = 9
        let j = 10
        let k = 11
    }

    let TABLE = %{
        'a': 1,
        'b': 2,
        'c': 3,
        'd': 4,
        'e': 5,
        'f': 6,
        'g': 7,
        'h': 8,
        'i': 9,
        'j': 10,
        'k': 11
    }
    '''

pub fn dense-paragraphs-count-code-lines() {
    assert(hits(DENSE, 'dense-paragraph') == [1])
    assert(hits(DENSE.sub('    let k = 11\n', ''), 'dense-paragraph') == [])
}

let CHAINS = '''
    fn kind(x) {
        if x == 'a' {
            1
        } else if x == 'b' {
            2
        } else if x == 'c' {
            3
        }
    }

    fn coerce(t, v) {
        if t == Bool {
            return !!v
        }
        if t == Int {
            return int(v)
        }
        if t == Float {
            return float(v)
        }
        v
    }

    fn mixed(x, y) {
        if x == 1 {
            1
        } else if y == 2 {
            2
        } else if x == 3 {
            3
        }
    }
    '''

pub fn chains-on-one-subject-want-match() {
    assert(hits(CHAINS, 'if-chain') == [2, 12])
}

let CLONES = '''
    fn a(name, close) {
        if #close > 0 {
            die("Unknown option: {name} (did you mean {close.join(', ')}?)")
        } else {
            die("Unknown option: {name}")
        }
    }

    fn b(flag, near) {
        if #near > 0 {
            die("Unknown flag: {flag} (did you mean {near.join(', ')}?)")
        } else {
            die("Unknown flag: {flag}")
        }
    }
    '''

pub fn clones-match-up-to-renaming() {
    assert(hits(CLONES, 'duplicate-code') == [1, 9])
    assert(hits(CLONES.sub('#near > 0', '#near > 1 && ok'), 'duplicate-code') == [])
}

let INITS = '''
    class Point {
        x: Int
        y: Int
        label: String

        init(x: Int, y: Int, label: String = 'p') {
            self.x = x
            self.y = y
            self.label = label
        }
    }

    class Child < Point {
        z: Int

        init(z: Int) {
            self.z = z
        }
    }

    class Reordered {
        a: Int
        b: Int

        init(b: Int, a: Int) {
            self.a = a
            self.b = b
        }
    }
    '''

pub fn copying-inits-become-the-default-constructor() {
    assert(hits(INITS, 'default-init') == [6])
    let out = fixed(INITS, 'default-init')
    assert("    label: String = 'p'\n\}" in out, out)
    assert(!out.match?(/init\(x: Int/), out)
    assert('init(z: Int)' in out && 'init(b: Int, a: Int)' in out, out)
}

let NOTES = '''
    /// documented
    fn f() {
        // narration
        let x = 1 // ty: allow(unused)
        /* block */
        x
    }
    '''

pub fn only-prose-comments-are-reported() {
    assert(hits(NOTES, 'comment') == [3, 5])
}

pub fn line-widths() {
    let src = "let a = '{'x' * 85}'\nlet b = '{'x' * 95}'\nlet c = 1\n"
    assert(hits(src, 'soft-line-length') == [1])
    assert(hits(src, 'line-length') == [2])
}

let NAMES = '''
    const LIMIT = 86400

    fn f(t, mode) {
        let a = t / 3600000
        let b = t % 3600000
        let c = (t + 3600000) / LIMIT
        match mode {
            'halfExpand' => a,
            'ceil'       => b,
            _            => c,
        }
    }

    fn g(mode) {
        mode == 'halfExpand' || mode in ['halfExpand', 'floor']
    }

    fn h(mode) { mode != 'halfExpand' }
    '''

pub fn repeated-literals-want-names() {
    assert(hits(NAMES, 'magic-number') == [4])
    assert(hits(NAMES, 'stringly-typed') == [8])
}

let SCANS = '''
    fn digits(s) {
        let i = 0
        let out = ''
        while i < #s && s[i] >= '0' && s[i] <= '9' {
            out += s[i]
            i += 1
        }
        out
    }
    '''

pub fn hand-written-lexing() {
    assert(hits(SCANS, 'char-range') == [4])
    assert(hits(SCANS, 'index-scan') == [4])
    assert(hits(SCANS, 'string-accumulate') == [5])
}

pub fn nil-tests-become-coalescing-and-guards() {
    assert(fixed('let y = x != nil ? x : 3\n', 'use-coalesce') == "let y = x ?? 3\n")
    assert(fixed('let y = (a.b == nil) ? 0 : a.b\n', 'use-coalesce') == "let y = a.b ?? 0\n")
    assert(fixed('let y = f() != nil ? f() : 3\n', 'use-coalesce') == "let y = f() != nil ? f() : 3\n")

    let guard = "fn f(x) \{\n    if x == nil \{\n        return 0\n    \}\n    x + 1\n\}\n"
    assert(fixed(guard, 'nil-guard') == guard)
    assert('    let $x = x or return 0\n' in fixed(guard, 'nil-guard', unsafe?=true))

    let test = "fn f(x) \{\n    if x != nil \{\n        print(x)\n    \}\n\}\n"
    assert(hits(test, 'nil-test') == [2])
}

let LOOPS = '''
    fn f(xs) {
        let out = []
        for x in xs {
            out.push(x + 1)
        }
        let seen = %{}
        for x in xs {
            seen[x] = true
        }
        let early = []
        for x in xs {
            early.push(x ?? return nil)
        }
        let big = []
        for x in xs if x > 1 {
            big.push(x)
        }
        (out, seen, early, big)
    }
    '''

pub fn push-loops-become-comprehensions() {
    let out = fixed(LOOPS, 'push-loop')
    assert('    let out = [x + 1 for x in xs]\n' in out, out)
    assert('    let big = [x for x in xs if x > 1]\n' in out, out)
    assert('early.push(x ?? return nil)' in out, out)
    let dicts = fixed(LOOPS, 'dict-loop')
    assert('    let seen = %{x: true for x in xs}\n' in dicts, dicts)
}
