import ty

ns test

pub fn thread-return() {
    let t = Thread(${'PASS'})
    assert(t.join() == 'PASS')
}

pub fn short-lived-threads-during-gc() {
    let running = Atomic(1)

    fn collect() {
        while running.load() {
            ty.gc()
        }
    }

    fn result(i) { [i, "result {i}"] }

    let collectors = [Thread(collect) for ..2]
    defer {
        running.store(0)
        for t in collectors {
            t.join()
        }
    }

    for i in ..32 {
        let t = Thread(result, i)
        assert(t.join() == [i, "result {i}"])
    }
}
