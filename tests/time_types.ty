import json
import os
import path
import sh
import time
import ty
import ty.test.assert (assert-throws)

let UNITS = [
    (1ns,   1),
    (1us,   1_000),
    (1ms,   1_000_000),
    (1s,    1_000_000_000),
    (1m,    60_000_000_000),
    (1h,    3_600_000_000_000),
    (1d,    86_400_000_000_000),
    (2.5h,  9_000_000_000_000),
    (1.5ms, 1_500_000),
    (0.1s,  100_000_000),
    (1e3ns, 1_000),
    (0s,    0),
]

pub fn literals-count-nanoseconds() {
    for (d, n) in UNITS {
        assert(int(d) == n, "{d} is {int(d)}ns")
        assert(d :: Duration)
    }
}

pub fn shows-in-the-largest-exact-unit() {
    let cases = [
        (90s,           '1.5m'),
        (3600s,         '1h'),
        (61s,           '61s'),
        (1500ms,        '1.5s'),
        (1.234567891s,  '1.234567891s'),
        (100ns,         '100ns'),
        (50us,          '50us'),
        (36h,           '1.5d'),
        (0s,            '0s'),
        (-(3s),         '-3s'),
        (1d + 1ns,      '86400.000000001s'),
    ]
    for (d, s) in cases {
        assert(str(d) == s, "{int(d)}ns shows as {d}")
    }
}

pub fn shown-durations-round-trip-as-literals() {
    for (d, _) in UNITS {
        assert(ty.eval(str(d)) == d)
    }
}

pub fn bad-units-are-lex-errors() {
    for src in ['5sec', '1.5x', '3mss', '2hr', '0x10s', '1s5'] {
        assert-throws(ty.eval(src), CompileError)
    }
}

pub fn literals-in-every-position() {
    let pick = match 2s {
        1s => 'one',
        2s => 'two',
        _  => 'other',
    }
    assert(pick == 'two')

    fn wait(d: Duration = 250ms) -> Duration { d }
    assert(wait() == 250ms)

    let d = %{1s: 'a', 2m: 'b'}
    assert(d[1000ms] == 'a')
    assert(d[120s] == 'b')
    assert(%[1s, 1000ms, 1e9ns] == %[1s])
}

pub fn duration-algebra() {
    assert((1s + 500ms) :: Duration)
    assert(1s + 500ms == 1.5s)
    assert((2s - 500ms) :: TimeDelta)
    assert(!((2s - 500ms) :: Duration))
    assert(500ms - 2s == -(1.5s))
    assert(3 * 1s == 3s && 1s * 3 == 3s)
    assert((3 * 1s) :: TimeDelta)
    assert(1s * 1.5 == 1.5s)
    assert(1s / 4 == 250ms)
    assert(1s / 0.5 == 2s)
    assert(3s / 2s == 1.5)
    assert(7s % 2s == 1s)
    assert((7s % 2s) :: Duration)
    assert(-(1s) :: TimeDelta)
    assert(abs(-(5s)) == 5s)
    assert(abs(-(5s)) :: Duration)
    assert(abs(4s - 1s) :: Duration)
}

pub fn deltas-compare-across-both-types() {
    assert(1s == 3s - 2s)
    assert(1s < 2s && 2s > 1s && 1s <= 1s && 1s >= 1000ms)
    assert(-(1s) < 0s)
    assert((1s <=> 2s) == -1)
    assert([3s, -(1s), 2ms].sort() == [-(1s), 2ms, 3s])
    assert(max(1s, 2s) == 2s)
}

pub fn zero-is-falsy() {
    assert(!0s)
    assert(1ns)
    assert(!(1s - 1s))
    assert(time.now())
}

pub fn mixing-numbers-is-an-error() {
    for src in ['1s + 1', '1s < 1', '1s + 1.0', 'time.now() + 1'] {
        assert-throws(ty.eval(src), CompileError)
    }
}

pub fn overflow-panics() {
    let big = 100000d
    assert-throws(big * 1000000, RuntimeError)
    assert-throws(ty.eval('9223372037s'), CompileError)
}

pub fn division-by-zero-panics() {
    let zero = 0s
    assert-throws(1s / zero, ZeroDivisionError)
    assert-throws(1s % zero, ZeroDivisionError)
    assert-throws(1s / 0, ZeroDivisionError)
}

pub fn int-gives-nanoseconds() {
    assert(int(1.5us) == 1500)
    assert(int(-(2ns)) == -2)
    let t = time.now()
    assert(int(t + 1s) - int(t) == 1_000_000_000)
}

pub fn getters() {
    assert(1500ms.secs == 1.5)
    assert(2s.ms == 2000.0)
    assert(3us.ns == 3000)
    assert((-(1ms)).us == -1000.0)
}

pub fn time-arithmetic() {
    let t = time.now()
    assert((t + 1s) :: Time)
    assert(t + 1s - t == 1s)
    assert(1s + t == t + 1s)
    assert(t - 1s < t)
    assert((t - (t + 1h)) == -(1h))
    assert(t + 1s > t)
    assert(time.now() >= t)
}

pub fn since-until-and-diff() {
    let t = time.now()
    let past = t - 1h
    let future = t + 1h
    assert(time.since(past) >= 1h)
    assert(time.since(future) == 0s)
    assert(time.until(past) == 0s)
    assert(time.until(future) <= 1h && time.until(future) > 59m)
    assert(time.diff(past) < -(59m))
    assert(time.diff(future) > 59m)
    assert(time.since(t) :: Duration)
    assert(time.diff(t) :: TimeDelta)
}

pub fn clocks() {
    let mono = time.now()
    let wall = time.time()
    let cpu  = time.now(time.CLOCK_PROCESS_CPUTIME_ID)
    assert(mono.clock == time.CLOCK_MONOTONIC)
    assert(wall.clock == time.CLOCK_REALTIME)
    assert(time.clock(cpu) == time.CLOCK_PROCESS_CPUTIME_ID)
    assert(wall :: Time && mono :: Time && !(mono :: Duration))
    assert(str(wall).match?(/^Time\(CLOCK_REALTIME, \d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z\)$/), str(wall))
    assert(str(mono).match?(/^Time\(CLOCK_MONOTONIC, /), str(mono))
}

pub fn clocks-do-not-mix() {
    let mono: Any = time.now()
    let wall: Any = time.time()
    assert-throws(mono - wall, RuntimeError)
    assert-throws(mono < wall, RuntimeError)
    assert(mono != wall)
}

pub fn wall-clock-round-trips-through-tm() {
    let t = time.time(time.gmtime(time.time()), utc: true)
    assert(abs(t - time.time()) < 2s)
    assert(time.strftime('%Y', time.time({year: 124, mon: 0, mday: 2}, utc: true)) == '2024')
    let epoch = time.time({year: 70, mon: 0, mday: 1}, utc: true)
    assert(int(epoch) == 0)
    assert(time.gmtime(epoch + 1d + 2h).hour == 2)
    assert(time.gmtime(epoch - 1s).year == 69)
}

pub fn json-encodes-nanoseconds() {
    assert(json.encode([1ms, -(2ns)]) == '[1000000,-2]')
}

pub fn timeouts-and-deadlines() {
    let ch = Channel()
    let t0 = time.now()
    assert(ch.recv(20ms) == None)
    assert(time.since(t0) >= 15ms)

    let deadline = time.now() + 20ms
    assert(ch.recv(deadline) == None)
    assert(time.until(deadline) == 0s)

    assert(ch.recv(time.now() - 1s) == None)

    let q = SharedQueue()
    assert(q.try-take(time.now() + 5ms) == None)
    q.put(1)
    assert(q.try-take(1s) == Some(1))
}

pub fn sleep-rejects-signed-deltas() {
    let d: Any = 2ms - 1ms
    assert-throws(os.sleep(d), RuntimeError)
    assert(os.sleep(abs(d)) == nil)
}

pub fn poll-takes-a-timeout-or-deadline() {
    let (r, w) = os.pipe()
    let t0 = time.now()
    assert(os.poll([(r, os.POLLIN)], [], 20ms) == 0)
    assert(os.poll([(r, os.POLLIN)], [], time.now() + 20ms) == 0)
    assert(time.since(t0) >= 35ms)
    os.close(r)
    os.close(w)
}

pub fn threads-carry-durations() {
    let t = Thread(-> do {
        os.sleep(5ms)
        2s
    })
    assert(t.join() == 2s)

    let slow = Thread(-> os.sleep(200ms))
    assert(slow.join(5ms) == None)
}

pub fn hot-loops-stay-exact() {
    let acc = 0s
    for ..100000 {
        acc += 1us
    }
    assert(acc == 100ms)

    let t = time.now()
    let deadline = t + 1h
    let n = 0
    while t + abs(n * 1ms) < deadline && n < 50000 {
        n += 1
    }
    assert(n == 50000)
}

pub fn macros-see-duration-literals() {
    let ast = ty.eval('$$[ 1.5s + 1s $$]')
    assert(ast == ty.Add(ty.Value(1.5s), ty.Value(1s)))
    assert(ty.eval(ast) == 2.5s)
}

pub fn constructors-invert-int() {
    assert(Duration(1500) == 1.5us && Duration(1500) :: Duration)
    assert(TimeDelta(-3) == -(3ns) && TimeDelta(3) :: TimeDelta)
    assert-throws(Duration(-1), RuntimeError)

    let t = time.now()
    assert(Time(int(t), time.CLOCK_MONOTONIC) == t)

    let epoch = Time(0, time.CLOCK_REALTIME)
    assert(epoch == time.time({year: 70, mon: 0, mday: 1}, utc: true))
    assert(time.gmtime(Time(1_700_000_000 * int(1s), time.CLOCK_REALTIME)).year == 123)
}

pub fn folded-constants-match-the-runtime() {
    let one:   Any = 1s
    let two:   Any = 2s
    let three: Any = 3s
    let k:     Any = 3
    let x:     Any = 1.5
    let folded  = [1s + 2s, -(2s), 3 * 1s, 1s * 1.5, 1s / 3, 3s / 2s, 3s % 2s, 1s - 3s, -(-(1s)) + 2s, 2 * 3 * 1s]
    let runtime = [one + two, -two, k * one, one * x, one / k, three / two, three % two, one - three, -(-one) + two, 2 * k * one]
    assert(folded == runtime)
    assert(folded.map(type) == runtime.map(type))
    let zero: Any = 0
    assert-throws(1s / 0, ZeroDivisionError)
    assert-throws(1s / zero, ZeroDivisionError)
    assert-throws(9223372036s * 2, RuntimeError)
}

const NEGATIVE = -5s

pub fn folded-constants-seed-globals() {
    assert(NEGATIVE == -(5s) && NEGATIVE :: TimeDelta && !(NEGATIVE :: Duration))
}

fn compile(src: String) -> String {
    with tmp = path.tempdir() {
        let file = tmp / 'clocks.ty'
        file.write("import time\n{src}\n")
        sh.run([ty.executable, '-c', str(file)], timeout: 30s).stderr
    }
}

pub fn mixing-clocks-is-a-type-error() {
    for op in ['-', '<', '<=', '>', '>=', '<=>'] {
        let err = compile("time.now(time.CLOCK_REALTIME) {op} time.now(time.CLOCK_MONOTONIC)")
        assert('Time[time::CLOCK_REALTIME]' in err, err)
    }
    assert('CompileError' in compile('let a = time.time()\nlet b = time.now()\na - b'))
}

pub fn clocks-must-be-clocks() {
    for src in ["time.now('asd')", 'time.now(42)', "Time(0, 'asd')", 'Time(0, 1.5)'] {
        assert('CompileError' in compile(src), src)
    }
    assert(compile('const K = time.CLOCK_TAI\nlet t: Time[time::CLOCK_TAI] = time.now(K)') == '')
    assert(compile('fn f(c: time::ClockID) { time.now(c) }\nf(time.CLOCK_BOOTTIME)') == '')
    assert(compile('let a = time.time()\nlet b = time.time()\nb - a') == '')
}

pub fn clocks-show-in-types() {
    assert(str(typeof(time.now())) == 'Time[time::CLOCK_MONOTONIC]')
    assert(str(typeof(time.now(time.CLOCK_PROCESS_CPUTIME_ID) + 1s)) == 'Time[time::CLOCK_PROCESS_CPUTIME_ID]')
}

pub fn strings-parse-like-literals() {
    for (d, _) in UNITS {
        assert(Duration(str(d)) == d)
        assert(TimeDelta("-{d}") == -d)
    }
    let cases = [
        ('1_000ms',      1s),
        ('1e3ns',        1us),
        ('0.5s',         500ms),
        ('00s',          0s),
        ('1.234567891s', 1.234567891s),
    ]
    for (s, d) in cases {
        assert(Duration(s) == d && Duration(s) :: Duration)
        assert(TimeDelta(s) == d && TimeDelta(s) :: TimeDelta)
    }
    assert(TimeDelta('-1.5us') == -(1.5us))
    for s in ['', 's', '1', '1.5', '+1s', ' 1s', '1s ', '5sec', '1.5x', '0x10s', '010s', '1s5', '2r101s', '1.s', '--1s'] {
        assert-throws(Duration(s), ValueError)
        assert-throws(TimeDelta(s), ValueError)
    }
    assert-throws(Duration('-1s'), ValueError)
    assert-throws(Duration('9223372037s'), ValueError, /out of range/)
    assert-throws(TimeDelta('-9223372037s'), ValueError, /out of range/)
}
