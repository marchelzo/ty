static int                on;
static int                sock = -1;
static pid_t              owner;
static dev_t              sdev;
static ino_t              sino;
static pthread_mutex_t    mu = PTHREAD_MUTEX_INITIALIZER;

ssize_t read_nc(int, void *, size_t) __asm__("_read$NOCANCEL");
ssize_t write_nc(int, void const *, size_t) __asm__("_write$NOCANCEL");
ssize_t pread_nc(int, void *, size_t, off_t) __asm__("_pread$NOCANCEL");
ssize_t pwrite_nc(int, void const *, size_t, off_t) __asm__("_pwrite$NOCANCEL");
ssize_t readv_nc(int, struct iovec const *, int) __asm__("_readv$NOCANCEL");
ssize_t writev_nc(int, struct iovec const *, int) __asm__("_writev$NOCANCEL");
ssize_t preadv_nc(int, struct iovec const *, int, off_t) __asm__("_preadv$NOCANCEL");
ssize_t pwritev_nc(int, struct iovec const *, int, off_t) __asm__("_pwritev$NOCANCEL");
int     fcntl_nc(int, int, ...) __asm__("_fcntl$NOCANCEL");
int     close_nc(int) __asm__("_close$NOCANCEL");

ssize_t __read_nocancel(int, void *, size_t);
ssize_t __write_nocancel(int, void const *, size_t);
ssize_t __pread_nocancel(int, void *, size_t, off_t);
ssize_t __pwrite_nocancel(int, void const *, size_t, off_t);
ssize_t __readv_nocancel(int, struct iovec const *, int);
ssize_t __writev_nocancel(int, struct iovec const *, int);
int     __fcntl_nocancel(int, int, long);
int     __close_nocancel(int);

ssize_t preadv(int, struct iovec const *, int, off_t);
ssize_t pwritev(int, struct iovec const *, int, off_t);

static uint64_t
now(void)
{
        return clock_gettime_nsec_np(CLOCK_MONOTONIC);
}

static int
ours(int fd)
{
        struct stat st;
        return on
            && fstat(fd, &st) == 0
            && S_ISCHR(st.st_mode)
            && (st.st_rdev == tty || st.st_rdev == ctty);
}

static void
prepare(void)
{
        pthread_mutex_lock(&mu);
}

static void
release(void)
{
        pthread_mutex_unlock(&mu);
}

__attribute__((constructor)) static void
start(void)
{
        char const *path = getenv("TUICAP_SOCK");
        char const *name = getenv("TUICAP_TTY");
        struct stat st;
        if (
                path == NULL
             || name == NULL
             || strlen(path) >= sizeof addr.sun_path
             || stat(name, &st) != 0
        ) {
                return;
        }
        tty  = st.st_rdev;
        ctty = (stat("/dev/tty", &st) == 0) ? st.st_rdev : tty;
        addr.sun_family = AF_UNIX;
        strcpy(addr.sun_path, path);
        pthread_atfork(prepare, release, release);
        on = 1;
}

static int
alive(void)
{
        struct stat st;
        return sock >= 0
            && owner == getpid()
            && fstat(sock, &st) == 0
            && st.st_dev == sdev
            && st.st_ino == sino;
}

static int
dial(void)
{
        struct stat st;
        int fd;
        int hi;
        int sz = 1 << 20;
        if (
                sock >= 0
             && owner != getpid()
             && fstat(sock, &st) == 0
             && st.st_dev == sdev
             && st.st_ino == sino
        ) {
                close(sock);
        }
        sock = -1;
        fd = socket(AF_UNIX, SOCK_STREAM, 0);
        if (fd < 0) {
                return -1;
        }
        if (connect(fd, (struct sockaddr *)&addr, sizeof addr) != 0) {
                close(fd);
                return -1;
        }
        hi = fcntl(fd, F_DUPFD_CLOEXEC, HIGHFD);
        if (hi >= 0) {
                close(fd);
                fd = hi;
        } else {
                fcntl(fd, F_SETFD, FD_CLOEXEC);
        }
        setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &sz, sizeof sz);
        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &(int){1}, sizeof (int));
        fstat(fd, &st);
        sock  = fd;
        owner = getpid();
        sdev  = st.st_dev;
        sino  = st.st_ino;
        return 0;
}

static void
sendall(struct iovec *v, int n)
{
        ssize_t w;
        while (n > 0) {
                w = writev(sock, v, n > IOV_MAX ? IOV_MAX : n);
                if (w < 0 && errno == EINTR) {
                        continue;
                }
                if (w <= 0) {
                        close(sock);
                        sock = -1;
                        on   = 0;
                        return;
                }
                while (n > 0 && (size_t)w >= v->iov_len) {
                        w -= v->iov_len;
                        v += 1;
                        n -= 1;
                }
                if (n > 0) {
                        v->iov_base  = (char *)v->iov_base + w;
                        v->iov_len  -= w;
                }
        }
}

static void
report(
        int nr,
        uint64_t t0,
        int fd,
        uint64_t a1,
        uint64_t a2,
        int64_t ret,
        struct iovec const *iov,
        int n,
        int64_t limit
)
{
        int m = (limit > 0) ? n : 0;
        struct iovec v[m + 2];
        struct hdr h;
        struct rec r = {0};
        uint64_t tid;
        size_t left;
        int k = 2;
        int e = errno;
        r.ts    = now();
        r.enter = t0;
        r.nr    = nr;
        r.a[0]  = fd;
        r.a[1]  = a1;
        r.a[2]  = a2;
        r.ret   = ret;
        pthread_threadid_np(NULL, &tid);
        r.id = ((uint64_t)getpid() << 32) | (tid & 0xFFFFFFFF);
        strlcpy(r.comm, getprogname(), sizeof r.comm);
        left = (limit > MAXDATA) ? MAXDATA : limit;
        if (limit < 0) {
                left = 0;
        }
        for (int i = 0; i < m && left > 0; ++i) {
                v[k].iov_base = iov[i].iov_base;
                v[k].iov_len  = (iov[i].iov_len < left) ? iov[i].iov_len : left;
                left -= v[k].iov_len;
                r.len += v[k].iov_len;
                k += 1;
        }
        h.kind = CALL;
        h.len  = sizeof r + r.len;
        v[0]   = (struct iovec){ &h, sizeof h };
        v[1]   = (struct iovec){ &r, sizeof r };
        pthread_mutex_lock(&mu);
        if (alive() || dial() == 0) {
                sendall(v, k);
        }
        pthread_mutex_unlock(&mu);
        errno = e;
}

static int64_t
result(int64_t r)
{
        return (r < 0) ? -errno : r;
}

#define RW(hook, real, nr, Q)                                                           \
        static ssize_t                                                                  \
        hook(int fd, Q void *buf, size_t n)                                             \
        {                                                                               \
                uint64_t t0;                                                            \
                ssize_t r;                                                              \
                if (!ours(fd)) {                                                        \
                        return real(fd, buf, n);                                        \
                }                                                                       \
                t0 = now();                                                             \
                r  = real(fd, buf, n);                                                  \
                report(nr, t0, fd, (uintptr_t)buf, n, result(r),                        \
                       &(struct iovec){ (void *)buf, n }, 1, r);                        \
                return r;                                                               \
        }

#define PRW(hook, real, nr, Q)                                                          \
        static ssize_t                                                                  \
        hook(int fd, Q void *buf, size_t n, off_t off)                                  \
        {                                                                               \
                uint64_t t0;                                                            \
                ssize_t r;                                                              \
                if (!ours(fd)) {                                                        \
                        return real(fd, buf, n, off);                                   \
                }                                                                       \
                t0 = now();                                                             \
                r  = real(fd, buf, n, off);                                             \
                report(nr, t0, fd, (uintptr_t)buf, n, result(r),                        \
                       &(struct iovec){ (void *)buf, n }, 1, r);                        \
                return r;                                                               \
        }

#define VEC(hook, real, nr)                                                             \
        static ssize_t                                                                  \
        hook(int fd, struct iovec const *iov, int cnt)                                  \
        {                                                                               \
                uint64_t t0;                                                            \
                ssize_t r;                                                              \
                if (!ours(fd)) {                                                        \
                        return real(fd, iov, cnt);                                      \
                }                                                                       \
                t0 = now();                                                             \
                r  = real(fd, iov, cnt);                                                \
                report(nr, t0, fd, (uintptr_t)iov, cnt, result(r), iov, cnt, r);       \
                return r;                                                               \
        }

#define PVEC(hook, real, nr)                                                            \
        static ssize_t                                                                  \
        hook(int fd, struct iovec const *iov, int cnt, off_t off)                       \
        {                                                                               \
                uint64_t t0;                                                            \
                ssize_t r;                                                              \
                if (!ours(fd)) {                                                        \
                        return real(fd, iov, cnt, off);                                 \
                }                                                                       \
                t0 = now();                                                             \
                r  = real(fd, iov, cnt, off);                                           \
                report(nr, t0, fd, (uintptr_t)iov, cnt, result(r), iov, cnt, r);       \
                return r;                                                               \
        }

#define FCNTL(hook, real)                                                               \
        static int                                                                      \
        hook(int fd, int cmd, ...)                                                      \
        {                                                                               \
                va_list ap;                                                             \
                uint64_t t0;                                                            \
                long arg;                                                               \
                int r;                                                                  \
                va_start(ap, cmd);                                                      \
                arg = va_arg(ap, long);                                                 \
                va_end(ap);                                                             \
                if (!ours(fd)) {                                                        \
                        return real(fd, cmd, arg);                                      \
                }                                                                       \
                t0 = now();                                                             \
                r  = real(fd, cmd, arg);                                                \
                report(SYS_fcntl, t0, fd, cmd, arg, result(r), NULL, 0, 0);             \
                return r;                                                               \
        }

#define CLOSE(hook, real)                                                               \
        static int                                                                      \
        hook(int fd)                                                                    \
        {                                                                               \
                uint64_t t0;                                                            \
                int r;                                                                  \
                if (!ours(fd)) {                                                        \
                        return real(fd);                                                \
                }                                                                       \
                t0 = now();                                                             \
                r  = real(fd);                                                          \
                report(SYS_close, t0, fd, 0, 0, result(r), NULL, 0, 0);                 \
                return r;                                                               \
        }

RW(h_read,            read,              SYS_read,  )
RW(h_read_nc,         read_nc,           SYS_read,  )
RW(h_read_nocancel,   __read_nocancel,   SYS_read,  )
RW(h_write,           write,             SYS_write, const)
RW(h_write_nc,        write_nc,          SYS_write, const)
RW(h_write_nocancel,  __write_nocancel,  SYS_write, const)

PRW(h_pread,           pread,             SYS_pread,  )
PRW(h_pread_nc,        pread_nc,          SYS_pread,  )
PRW(h_pread_nocancel,  __pread_nocancel,  SYS_pread,  )
PRW(h_pwrite,          pwrite,            SYS_pwrite, const)
PRW(h_pwrite_nc,       pwrite_nc,         SYS_pwrite, const)
PRW(h_pwrite_nocancel, __pwrite_nocancel, SYS_pwrite, const)

VEC(h_readv,            readv,              SYS_readv)
VEC(h_readv_nc,         readv_nc,           SYS_readv)
VEC(h_readv_nocancel,   __readv_nocancel,   SYS_readv)
VEC(h_writev,           writev,             SYS_writev)
VEC(h_writev_nc,        writev_nc,          SYS_writev)
VEC(h_writev_nocancel,  __writev_nocancel,  SYS_writev)

PVEC(h_preadv,     preadv,     SYS_preadv)
PVEC(h_preadv_nc,  preadv_nc,  SYS_preadv)
PVEC(h_pwritev,    pwritev,    SYS_pwritev)
PVEC(h_pwritev_nc, pwritev_nc, SYS_pwritev)

FCNTL(h_fcntl,    fcntl)
FCNTL(h_fcntl_nc, fcntl_nc)

CLOSE(h_close,          close)
CLOSE(h_close_nc,       close_nc)
CLOSE(h_close_nocancel, __close_nocancel)

static int
h_fcntl_nocancel(int fd, int cmd, long arg)
{
        uint64_t t0;
        int r;
        if (!ours(fd)) {
                return __fcntl_nocancel(fd, cmd, arg);
        }
        t0 = now();
        r  = __fcntl_nocancel(fd, cmd, arg);
        report(SYS_fcntl, t0, fd, cmd, arg, result(r), NULL, 0, 0);
        return r;
}

static int
h_ioctl(int fd, unsigned long req, ...)
{
        va_list ap;
        uint64_t t0;
        void *arg;
        size_t n;
        int r;
        va_start(ap, req);
        arg = va_arg(ap, void *);
        va_end(ap);
        if (!ours(fd)) {
                return ioctl(fd, req, arg);
        }
        t0 = now();
        r  = ioctl(fd, req, arg);
        n  = 0;
        if (arg != NULL && (req & ((r < 0) ? IOC_IN : IOC_INOUT))) {
                n = IOCPARM_LEN(req);
        }
        report(
                SYS_ioctl,
                t0,
                fd,
                req,
                (uintptr_t)arg,
                result(r),
                &(struct iovec){ arg, n },
                1,
                (n > MAXIOC) ? MAXIOC : n
        );
        return r;
}

#define I(hook, real) { (void const *)hook, (void const *)real }

__attribute__((used, section("__DATA,__interpose")))
static struct { void const *hook; void const *real; } const interposers[] = {
        I(h_read,              read),
        I(h_read_nc,           read_nc),
        I(h_read_nocancel,     __read_nocancel),
        I(h_write,             write),
        I(h_write_nc,          write_nc),
        I(h_write_nocancel,    __write_nocancel),
        I(h_pread,             pread),
        I(h_pread_nc,          pread_nc),
        I(h_pread_nocancel,    __pread_nocancel),
        I(h_pwrite,            pwrite),
        I(h_pwrite_nc,         pwrite_nc),
        I(h_pwrite_nocancel,   __pwrite_nocancel),
        I(h_readv,             readv),
        I(h_readv_nc,          readv_nc),
        I(h_readv_nocancel,    __readv_nocancel),
        I(h_writev,            writev),
        I(h_writev_nc,         writev_nc),
        I(h_writev_nocancel,   __writev_nocancel),
        I(h_preadv,            preadv),
        I(h_preadv_nc,         preadv_nc),
        I(h_pwritev,           pwritev),
        I(h_pwritev_nc,        pwritev_nc),
        I(h_fcntl,             fcntl),
        I(h_fcntl_nc,          fcntl_nc),
        I(h_fcntl_nocancel,    __fcntl_nocancel),
        I(h_close,             close),
        I(h_close_nc,          close_nc),
        I(h_close_nocancel,    __close_nocancel),
        I(h_ioctl,             ioctl),
};
'''

const SHIM_FLAGS = ['-dynamiclib', '-O2', '-arch', 'x86_64', '-arch', 'arm64', '-arch', 'arm64e']

fn shim() -> String {
    let id  = hash.sha256("{SHIM_FLAGS}{SHIM}").hexdigest()[;16]
    let dir = Path.home() / 'Library' / 'Caches' / 'tuicap'
    let lib = dir / "shim-{id}.dylib"
    if lib.exists? {
        return str(lib)
    }
    dir.mkdir(parents: true, exist-ok: true)
    let src = dir / "shim-{id}.{os.getpid()}.c"
    let tmp = dir / "shim-{id}.{os.getpid()}.dylib"
    src.write(SHIM)
    let cc = try {
        sh.run(['cc', *SHIM_FLAGS, '-o', str(tmp), str(src)])
    } finally {
        src.unlink()
    }
    if !cc.ok? {
        tmp.unlink(missing-ok: true)
        let why = cc.stderr.lines().filter(\#_ > 0)[0] ?? cc.fate
        throw RuntimeError("cannot build the dyld shim: {why}")
    }
    tmp.rename(lib)
    str(lib)
}

class Tracer {
    __dir:   Path
    __sock:  Int
    __peers: Dict[Int, Frames]
    __log:   Syscalls
    __seen:  Int
    env:     Dict[String, String]
    error:   String | nil
    lost:    Int | nil

    init(tty: String) {
        let lib   = shim()
        let prior = os.getenv('DYLD_INSERT_LIBRARIES')
        __dir   = Path.tmp().mkdtemp('tuicap')
        __sock  = net.listen('unix', str(__dir / 'sock'))
        __peers = %{}
        __log   = Syscalls()
        __seen  = 0
        error   = nil
        lost    = nil
        env     = %{
            'DYLD_INSERT_LIBRARIES': (prior == nil) ? lib : "{lib}:{prior}",
            'TUICAP_SOCK':           str(__dir / 'sock'),
            'TUICAP_TTY':            tty
        }
        os.fcntl(__sock, os.F_SETFD, os.FD_CLOEXEC)
    }

    fds -> Array[Int] {
        [__sock, *__peers.keys()]
    }

    wait-ready(timeout: Float) -> Bool {
        true
    }

    pump(fd: Int) {
        if fd == __sock {
            __accept()
        } else {
            __receive(fd)
        }
    }

    __accept() {
        let (conn, _) = os.accept(__sock) ?? return
        os.fcntl(conn, os.F_SETFD, os.FD_CLOEXEC)
        __peers[conn] = Frames()
        __seen += 1
    }

    __receive(fd: Int) {
        let chunk = os.read(fd, 1 << 20)
        if chunk == nil || #chunk == 0 {
            os.close(fd)
            __peers.remove(fd)
            return
        }
        for (_, body) in __peers[fd]!.feed(chunk) {
            __log.absorb(body)
        }
    }

    finish(timeout: Float = 3.0) {
        let deadline = time.now() + timeout
        let ready    = []
        while #__peers > 0 && time.now() < deadline {
            break if os.poll([(it, os.POLLIN) for fds], ready, 0.05) == 0
            for (fd, _) in ready {
                pump(fd)
            }
        }
        for fd, _ in __peers {
            os.close(fd)
        }
        __peers = %{}
        os.close(__sock)
        __dir.rmtree(quiet: true)
        lost = 0
        if __seen == 0 {
            error = 'no traced process touched the terminal (DYLD_INSERT_LIBRARIES is dropped '
                    'for SIP-protected and hardened-runtime executables)'
        }
    }

    events(tl: Timeline) -> Array[Dict[String, _]] {
        __log.events(tl)
    }

    summary -> Dict[String, _] {
        %{'source': 'dyld', 'lost': lost, 'error': error, 'processes': __seen}
    }
}
#|else
class Tracer {
    __pid:    Int
    __in:     Int
    __out:    Int
    __err:    Int
    __frames: Frames
    __log:    Syscalls
    ready?:   Bool
    error:    String | nil
    lost:     Int | nil

    init(tty: String) {
        let $root = escalation()
            or throw RuntimeError('cannot run the eBPF tracer as root (needs passwordless sudo or setuid /usr/bin/tyxx)')
        let proc = os.spawn(
            [*root, os.realpath(__file__) ?? __file__, '--tracer', tty, str(os.getpid())],
            stdin:  os.SPAWN_PIPE,
            stdout: os.SPAWN_PIPE,
            stderr: os.SPAWN_PIPE
        )
        __pid    = proc.pid
        __in     = proc.stdin
        __out    = proc.stdout
        __err    = proc.stderr
        __frames = Frames()
        __log    = Syscalls()
        ready?   = false
        error    = nil
        lost     = nil
    }

    static escalation() -> Array[String] | nil {
        if os.geteuid() == 0 {
            return [ty.executable]
        }
        let sudo = os.spawn(['sudo', '-n', 'true'], stdin: os.SPAWN_NULL, stdout: os.SPAWN_NULL, stderr: os.SPAWN_NULL)
        if let (_, status) = os.wait(sudo.pid) and status == 0 {
            let lib = os.getenv('TY_LIBRARY_PATH') ?? "{Path(ty.executable).parent}/lib"
            return ['sudo', '-n', 'env', "TY_LIBRARY_PATH={lib}", ty.executable]
        }
        if let $st = os.stat('/usr/bin/tyxx') and st.uid == 0 && (st.mode & 0o4000) != 0 {
            return ['/usr/bin/tyxx']
        }
    }

    env -> Dict[String, String] {
        %{}
    }

    fds -> Array[Int] {
        alive? ? [__out] : []
    }

    alive? -> Bool {
        error == nil && lost == nil
    }

    wait-ready(timeout: Float) -> Bool {
        let deadline = time.now() + timeout
        while !ready? && alive? && time.now() < deadline {
            os.poll([(__out, os.POLLIN)], [], deadline - time.now())
            pump(__out)
        }
        ready?
    }

    pump(fd: Int) {
        let chunk = os.read(fd, 1 << 20)
        if chunk == nil || #chunk == 0 {
            error = error ?? "tracer exited unexpectedly: {__stderr()}"
            lost  = lost ?? 0
            return
        }
        for (kind, body) in __frames.feed(chunk) {
            match kind {
                frame.READY => ready? = true,
                frame.CALL  => __log.absorb(body),
                frame.DONE  => lost = int(body.str()),
                frame.ERROR => error = body.str(),
                _           => ()
            }
        }
    }

    __stderr() -> String {
        let ready = []
        if os.poll([(__err, os.POLLIN)], ready, 1.0) > 0 {
            (os.read(__err, 4096) ?? Blob()).str().lines().filter(\#_ > 0)[-1] ?? ''
        } else {
            ''
        }
    }

    finish(timeout: Float = 3.0) {
        os.close(__in)
        let deadline = time.now() + timeout
        while lost == nil && time.now() < deadline {
            os.poll([(__out, os.POLLIN)], [], deadline - time.now())
            pump(__out)
        }
        os.close(__out)
        os.close(__err)
        os.kill(__pid, os.SIGTERM)
        os.wait(__pid)
    }

    events(tl: Timeline) -> Array[Dict[String, _]] {
        __log.events(tl)
    }

    summary -> Dict[String, _] {
        %{'source': 'ebpf', 'lost': lost, 'error': error}
    }
}
#|]

const SETTLE    = 0.02
const SYNC_WAIT = 1.0
const SIGNALS   = [os.SIGWINCH, os.SIGCHLD, os.SIGTERM, os.SIGHUP, os.SIGINT, os.SIGQUIT]

use Options = {
    command: Array[String],
    output:  String | nil,
    size:    (Int, Int) | nil,
    trace?:  Bool,
    replay:  String | nil
}

fn dimensions(spec: String) -> (Int, Int) | nil {
    if let [_, cols, rows] = spec.match(/^(\d+)x(\d+)$/) {
        (int(cols)!, int(rows)!)
    }
}

fn program(command: Array[String]) -> Array[String] {
    match command {
        [line] => ['/bin/sh', '-c', line],
        argv   => argv
    }
}

fn signame(sig: Int) -> String {
    "SIG{(os.signame(sig) ?? str(sig)).upper()}"
}

fn stem(command: Array[String]) -> String {
    let word = command[0].words()[0] ?? 'tuicap'
    word.split('/')[-1]
}

fn raw(attrs: _) -> _ {
    let cc = Blob(attrs.cc)
    cc[termios.VTIME] = 0
    cc[termios.VMIN]  = 1
    {
        *attrs,
        iflag: attrs.iflag & ~(termios.BRKINT | termios.ICRNL | termios.INPCK | termios.ISTRIP | termios.IXON),
        oflag: attrs.oflag & ~termios.OPOST,
        cflag: attrs.cflag | termios.CS8,
        lflag: attrs.lflag & ~(termios.ECHO | termios.ICANON | termios.ISIG | termios.IEXTEN),
        cc:    cc
    }
}

fn terminal-size() -> (Int, Int) | nil {
    match os.terminal-size(0) ?? os.terminal-size(1) {
        {cols, rows, *} and cols > 0 && rows > 0 => (cols, rows),
        _                                        => nil
    }
}

#|if __apple__
class SignalQueue {
    __kq: kqueue.Kqueue

    init(sigs: Array[Int]) {
        __kq = kqueue.Kqueue()
        for sigs {
            __kq.add(it, kqueue.EVFILT_SIGNAL)
        }
    }

    fd -> Int {
        __kq.fd
    }

    take() -> Array[Int] {
        let sigs    = [it.ident for __kq.poll(0.0)]
        let pending = os.Signals.pending
        for sigs {
            if it in pending {
                os.sigwait([it])
            }
        }
        sigs
    }
}
#|else
class SignalQueue {
    __fd: Int

    init(sigs: Array[Int]) {
        __fd = os.signalfd(-1, os.sigset(sigs), os.SFD_CLOEXEC | os.SFD_NONBLOCK)
    }

    fd -> Int {
        __fd
    }

    take() -> Array[Int] {
        let sigs = []
        while let $info = os.read(__fd, 128) and #info == 128 {
            sigs.push(c.unpack('=I', info))
        }
        sigs
    }
}
#|]

fn spawn(argv: Array[String], pty: _, env: Dict[String, String]) -> Int {
    let pid = os.fork()
    if pid == 0 {
        os.sigprocmask(os.SIG_SETMASK, [])
        os.setsid()
        os.ioctl(pty.slave, TIOCSCTTY, 0)
        for fd in ..3 {
            os.dup2(pty.slave, fd)
        }
        os.close(pty.slave)
        os.close(pty.master)
        for k, v in env {
            setenv(k, v)
        }
        os.exec(argv)
        os.write(2, "tuicap: cannot execute {argv[0]}: {errno.str()}\r\n")
        os.exit(127)
    }
    pid
}

class Capture {
    __opts:     Options
    __argv:     Array[String]
    __pty:      _
    __pid:      Int
    __screen:   Screen
    __tl:       Timeline
    __tracer:   Tracer | nil
    __notes:    Array[String]
    __status:   Int | nil
    __saved:    _
    __signals:  SignalQueue
    __stdin?:   Bool
    __dirty?:   Bool
    __quiet:    Float
    __termios:  _
    __started:  String
    __script:   Array[(Int, String)]

    init(opts: Options) {
        __opts    = opts
        __argv    = program(opts.command)
        __notes   = []
        __status  = nil
        __stdin?  = true
        __dirty?  = false
        __quiet   = time.now()
        __termios = nil
        __started = time.strftime('%Y-%m-%dT%H:%M:%S%z')
        __saved   = os.isatty(0) ? termios.tcgetattr(0) : nil
        __script  = []

        let recorded = opts.replay ?> __rehearse

        let (cols, rows) = opts.size ?? recorded ?? terminal-size() ?? (80, 24)

        __pty    = os.openpty((rows, cols)) ?? throw OSError('openpty()')
        __screen = Screen(cols, rows)
        __tl     = Timeline(__screen)

        if __saved != nil {
            termios.tcsetattr(__pty.slave, termios.TCSANOW, __saved)
        }

        __tracer = nil
        if opts.trace? {
            __start-tracer()
        }
    }

    __rehearse(file: String) -> (Int, Int) {
        let doc = load(file)
        __stdin? = false
        __script = [
            (e['us'], e['text'] ?? base64.decode(e['base64']).str!())
            for e in doc['events']
            if e['type'] == 'input' && !e['eof']
        ]
        (doc['size']['cols'], doc['size']['rows'])
    }

    __start-tracer() {
        let failure = try {
            let t = Tracer(__pty.name)
            if t.wait-ready(10.0) {
                __tracer = t
                return
            }
            t.finish(0.5)
            t.error ?? 'tracer did not become ready'
        } catch e: RuntimeError | OSError {
            "{e}"
        }
        __notes.push("syscall tracing unavailable: {failure}")
    }

    run() -> Int {
        os.sigprocmask(os.SIG_BLOCK, SIGNALS)
        __signals = SignalQueue(SIGNALS)

        __tl.zero()
        __pid = spawn(__argv, __pty, __tracer.?env ?? %{})
        os.close(__pty.slave)

        if __saved != nil {
            termios.tcsetattr(0, termios.TCSANOW, raw(__saved))
        }

        try {
            __tl.frame('start')
            __watch-termios()
            __loop()
            __drain()
            __tl.frame('exit')
        } finally {
            if __saved != nil {
                termios.tcsetattr(0, termios.TCSADRAIN, __saved)
            }
            os.sigprocmask(os.SIG_UNBLOCK, SIGNALS)
        }

        if let $t = __tracer {
            t.finish()
            if let $error = t.error {
                __notes.push("syscall tracer: {error}")
            }
        }

        let file = __opts.output ?? "{stem(__opts.command)}_{__pid}.tui"
        Path(file).write(zstd.compress(json.encode(__document()), 9))

        for note in __notes {
            eprint("tuicap: {note}")
        }
        eprint("Recording written to: {file}")

        __exit-code()
    }

    __exit-code() -> Int {
        let $s = __status or return 1
        (os.WIFSIGNALED(s) != 0) ? 128 + os.WTERMSIG(s) : os.WEXITSTATUS(s)
    }

    __fds() -> Array[(Int, Int)] {
        [
            *(__stdin? ? [(0, os.POLLIN)] : []),
            (__pty.master, os.POLLIN),
            (__signals.fd, os.POLLIN),
            *[(it, os.POLLIN) for __tracer.?fds ?? []]
        ]
    }

    __loop() {
        let ready = []
        while __status == nil {
            os.poll(__fds(), ready, __timeout())
            for (fd, _) in ready {
                if !__dispatch(fd) {
                    return
                }
            }
            __replay()
            __settle()
            __watch-termios()
        }
    }

    __timeout() -> Float {
        let wait = __dirty? ? SETTLE : 0.1
        match __script {
            [(at, _), *] => max(0.0, min(wait, (at - __tl.us()) / 1.0e6)),
            _            => wait
        }
    }

    __replay() {
        while let [(at, data), *] = __script and at <= __tl.us() {
            __script.pop(0)
            __type(Blob(data))
        }
    }

    __type(data: Blob) {
        let shown = __tl.frame('input')
        __tl.event('input', %{'frame': shown} + payload(data))
        os.write(__pty.master, data, all=true)
    }

    __dispatch(fd: Int) -> Bool {
        match fd {
            0                             => __on-input(),
            m and m == __pty.master       => return __on-output(),
            s and s == __signals.fd       => __on-signal(),
            _                             => __tracer.?pump(fd)
        }
        true
    }

    __drain() {
        let ready = []
        while os.poll([(__pty.master, os.POLLIN)], ready, 0.05) > 0 {
            break if !__on-output()
        }
        __reap(0)
    }

    __on-input() {
        let data = os.read(0, 65536)
        if data == nil || #data == 0 {
            __stdin? = false
            __send-eof()
            return
        }
        __type(data)
    }

    __send-eof() {
        let $t = termios.tcgetattr(__pty.master) or return
        if (t.lflag & termios.ICANON) != 0 {
            let eof = t.cc.str(termios.VEOF, 1)
            __tl.event('input', %{'frame': #__tl.frames - 1, 'eof': true, 'text': eof})
            os.write(__pty.master, eof, all=true)
        }
    }

    __on-output() -> Bool {
        let data = os.read(__pty.master, 65536)
        if data == nil || #data == 0 {
            return false
        }
        os.write(1, data, all=true)
        __tl.event('output', payload(data))
        __screen.feed(data)
        __dirty? = true
        __quiet  = time.now()
        true
    }

    __settle() {
        let idle = time.now() - __quiet
        if __dirty? && idle >= SETTLE && (!__screen.synchronized? || idle >= SYNC_WAIT) {
            __tl.frame('idle')
            __dirty? = false
        }
    }

    __on-signal() {
        for match __signals.take() {
            os.SIGWINCH => __resize(),
            os.SIGCHLD  => __reap(os.WNOHANG),
            sig         => do {
                __tl.event('signal', %{'signal': signame(sig)})
                os.kill(-__pid, sig)
            }
        }
    }

    __reap(flags: Int) {
        if __status != nil {
            return
        }
        if let (pid, status) = os.wait(__pid, flags) and pid == __pid {
            __status = status
            __tl.event('exit', __exit-detail(status)!)
        }
    }

    static __exit-detail(status: Int | nil) -> Dict[String, _] | nil {
        let $s = status or return nil
        (os.WIFSIGNALED(s) != 0)
            ? %{'signal': signame(os.WTERMSIG(s))}
            : %{'code': os.WEXITSTATUS(s)}
    }

    __resize() {
        if __opts.size != nil {
            return
        }
        let (cols, rows) = terminal-size() ?? return
        if cols == __screen.cols && rows == __screen.rows {
            return
        }
        __tl.frame('resize')
        os.ioctl(__pty.master, TIOCSWINSZ, c.pack(Blob(), '=HHHH', rows, cols, 0, 0))
        __screen.resize(cols, rows)
        __tl.event('resize', %{'cols': cols, 'rows': rows})
    }

    __watch-termios() {
        let $t = termios.tcgetattr(__pty.master) or return
        if t != __termios {
            __termios = t
            __tl.event('termios', sys.attrs(t))
        }
    }

    __document() -> Dict[String, _] {
        let events = __tl.events
        let calls  = __tracer.?events(__tl) ?? []
        for e; i in events {
            e['_'] = i
        }
        let merged = (events + calls).sort(by=e -> (e['us'], e['_'] ?? Int.MAX))
        let index  = %{}
        for e; i in merged {
            if let $j = e['_'] {
                index[j] = i
                e.remove('_')
            }
        }
        for f in __tl.frames {
            f['event'] = index[f['event']] ?? -1
        }

        %{
            'format':      'tuicap/1',
            'command':     __opts.command,
            'argv':        __argv,
            'pid':         __pid,
            'cwd':         os.getcwd(),
            'term':        os.getenv('TERM'),
            'started':     __started,
            'duration_us': __tl.us(),
            'size':        %{'cols': __tl.frames[0]['size'][0], 'rows': __tl.frames[0]['size'][1]},
            'exit':        __exit-detail(__status),
            'trace':       __trace-summary(),
            'frames':      __tl.frames,
            'events':      merged
        }
    }

    __trace-summary() -> Dict[String, _] {
        match __tracer {
            nil => %{'source': nil, 'reason': __notes.join('; ')},
            t   => t.summary
        }
    }
}

pub fn load(file: String) -> Dict[String, _] {
    let raw = Path(file).read-bytes()
    json.parse((raw[;4] == Blob(0x28, 0xB5, 0x2F, 0xFD)) ? zstd.decompress(raw) : raw.str())
}

pub fn states*(doc: Dict[String, _]) {
    let size   = nil
    let rows   = []
    let cursor = nil
    let modes  = %{}
    for f in doc['frames'] {
        if let $s = f['size'] {
            size = s
            rows = [[]] * s[1]
        }
        for k, row in f['rows'] ?? %{} {
            let r = int(k)!
            rows[r] = row
        }
        if let $c = f['cursor'] {
            cursor = [c['row'], c['col']]
        }
        for k, v in f['modes'] ?? %{} {
            modes[k] = v
        }
        yield %{'size': size, 'rows': [*rows], 'cursor': cursor, 'modes': %{k: v for k, v in modes if v != nil}}
    }
}

fn checkpoints(doc: Dict[String, _]) -> Dict[Int, (String, Dict[String, _])] {
    let screens = [*states(doc)]
    let marks   = %{}
    let offset  = 0
    for e in doc['events'] if e['type'] == 'input' {
        let bytes = e['text'] ?? base64.decode(e['base64']).str()
        marks[offset] = (bytes, screens[e['frame']])
        offset += #Blob(bytes)
    }
    marks[Int.MAX] = ('', screens[-1])
    marks
}

fn typed(doc: Dict[String, _]) -> Blob {
    let all = Blob()
    for e in doc['events'] if e['type'] == 'input' {
        all.push(e['text'] ?? base64.decode(e['base64']))
    }
    all
}

fn text-of(row: Array[Array[String]]) -> String {
    row.map(&0).join('')
}

fn contrast-row(r: Int, x: Array[Array[String]], y: Array[Array[String]]) -> String {
    match (text-of(x), text-of(y)) {
        (s, t) and s != t => "  row {r:>2}: {json.encode(s.strip-right())}\n          {json.encode(t.strip-right())}",
        _                 => "  row {r:>2} styles: {json.encode(x)}\n                 {json.encode(y)}"
    }
}

fn contrast(a: Dict[String, _], b: Dict[String, _]) -> Array[String] {
    let lines = []
    if a['size'] != b['size'] {
        lines.push("  size:   {a['size']} | {b['size']}")
    }
    let rows = [
        r for r in ..max(#a['rows'], #b['rows'])
        if a['rows'].?[r] != b['rows'].?[r]
    ]
    for r in rows[;8] {
        lines.push(contrast-row(r, a['rows'].?[r] ?? [], b['rows'].?[r] ?? []))
    }
    if #rows > 8 {
        lines.push("  ... and {#rows - 8} more rows")
    }
    if a['cursor'] != b['cursor'] {
        lines.push("  cursor: {a['cursor']} | {b['cursor']}")
    }
    for k in (a['modes'].keys() + b['modes'].keys()).nub().sort() if a['modes'][k] != b['modes'][k] {
        lines.push("  {k}: {json.encode(a['modes'][k])} | {json.encode(b['modes'][k])}")
    }
    lines
}

fn bytes(e: Dict[String, _]) -> Blob {
    match e['text'] {
        nil => base64.decode(e['base64']),
        t   => Blob(t)
    }
}

fn refresh(input: String, output: String) -> Int {
    let doc    = load(input)
    let screen = Screen(doc['size']['cols'], doc['size']['rows'])
    let tl     = Timeline(screen)
    let idle   = [f['us'] for f in doc['frames'] if f['why'] == 'idle']
    let events = doc['events']

    fn settle(until: Int, last: Int) {
        while let [t, *] = idle and t <= until {
            tl.frame('idle', at=idle.pop(0), event=last)
        }
    }

    tl.frame('start', at=doc['frames'][0]['us'], event=-1)

    for e; i in events {
        settle(e['us'], i - 1)
        match e['type'] {
            'output' => screen.feed(bytes(e)),
            'input'  => e['frame'] = tl.frame('input', at=e['us'], event=i - 1),
            'resize' => {
                tl.frame('resize', at=e['us'], event=i - 1)
                screen.resize(e['cols'], e['rows'])
            },
            _ => ()
        }
    }

    settle(Int.MAX, #events - 1)
    tl.frame('exit', at=doc['duration_us'], event=#events - 1)

    doc['frames'] = tl.frames
    Path(output).write(zstd.compress(json.encode(doc), 9))
    0
}

fn compare(left: String, right: String) -> Int {
    let (a, b) = (load(left), load(right))
    let (ia, ib) = (typed(a), typed(b))
    print(ia == ib ? "inputs: identical ({#ia} bytes)" : "inputs: differ ({#ia} vs {#ib} bytes)")

    let (ca, cb) = (checkpoints(a), checkpoints(b))
    let shared   = ca.keys().filter(\_ in cb).sort()
    for at in shared {
        let ((key, sa), (_, sb)) = (ca[at]!, cb[at]!)
        if digest(sa) != digest(sb) {
            let label = (at == Int.MAX) ? 'at exit' : "before input byte {at} ({json.encode(key)})"
            print("screens differ {label}:")
            print(contrast(sa, sb).unlines())
            return 1
        }
    }
    print("screens: identical at {#shared} checkpoints")
    (ia == ib) ? 0 : 1
}

fn painted(row: Array[Array[String]], ansi?: Bool) -> String {
    match ansi? {
        true  => row.map(|[text, sgr]| -> sgr ? "\x1b[{sgr}m{text}\x1b[0m" : text).join(''),
        false => text-of(row)
    }
}

fn picks(doc: Dict[String, _], which: String) -> Array[Int] {
    let n = #doc['frames']
    let at = i -> (i < 0) ? n + i : i
    match which {
        'all'               => [*..n],
        'inputs'            => [e['frame'] for e in doc['events'] if e['type'] == 'input'].nub(),
        /^(-?\d*):(-?\d*)$/ => [*at(int($1) ?? 0)..at(int($2) ?? n)],
        /^-?\d+$/           => [at(int(which)!)],
        _                   => throw ValueError("bad frame selector '{which}'")
    }
}

fn show(file: String, which: String, ansi?: Bool) -> Int {
    let doc     = load(file)
    let screens = [*states(doc)]
    for i in picks(doc, which) if i >= 0 && i < #screens {
        let f     = doc['frames'][i]
        let s     = screens[i]
        let [w, _] = s['size']
        let cur   = s['cursor'] ?? ['-', '-']
        let shown = (s['modes']['cursor_visible'] ?? true) ? '' : ' hidden'
        print("── frame {i} · {f['why']} · {f['us'] / 1000}ms · cursor {cur[0]},{cur[1]}{shown} {'─' * max(0, w - 40)}")
        let rows  = s['rows']
        let used  = #rows - #rows.reverse().take-while!(\#_ == 0).list()
        for row in rows[;used] {
            print("{painted(row, ansi?)}")
        }
        if used < #rows {
            print("── {#rows - used} blank rows")
        }
    }
    0
}

#|if !__apple__
fn serve-tracer(tty: String, skip: Int) -> Int {
    try {
        tracer(tty, skip)
        0
    } catch e {
        frame.put(frame.ERROR, "{e}")
        1
    }
}
#|]

fn record(opts: _) -> Int {
    let options = {
        command: opts.command,
        output:  opts.output,
        size:    opts.size ?> dimensions,
        trace?:  opts.trace,
        replay:  opts.replay
    }
    Capture(options).run()
}

fn misuse(message: String) -> Int {
    eprint("error: {message}")
    eprint("Try '{argv[0]} --help' for more information.")
    2
}

fn main(opts: _) -> Int {
    if opts.show {
        return match opts.command {
            [file]        => show(file, '-1', opts.ansi),
            [file, which] => show(file, which, opts.ansi),
            _             => misuse('--show takes REC.tui [N | A:B | inputs | all]')
        }
    }

    match (opts.diff, opts.refresh, opts.tracer, opts.command) {
        (true, false, false, [left, right])  => compare(left, right),
        (true, _, _, _)                      => misuse('--diff takes exactly two recordings'),
        (false, true, false, [file])         => refresh(file, file),
        (false, true, false, [file, out])    => refresh(file, out),
        (_, true, _, _)                      => misuse('--refresh takes REC.tui [OUT.tui]'),
#|if !__apple__
        (false, false, true, [tty, skip])    => serve-tracer(tty, int(skip)!),
#|]
        (false, false, false, [_, *_])       => record(opts),
        _                                    => misuse('no command given')
    }
}

if __module__ == 'main' {
    let (opts, _) = Tuicap.parse()
    os.exit(main(opts))
}
