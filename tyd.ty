#!/usr/bin/env ty

import errno
import io (stdin)
import json
import sh (sh)
import os (..)
import log (..)
import path (Path)

const TYD_LOGS_DIR     = Path(getenv('TYD_STATE_DIR') ?? "{Path.home()}/.local/state/tyd")
const TYD_LOG_PATH     = TYD_LOGS_DIR / 'tyd.log'
const TYLS_ERR_PATH    = TYD_LOGS_DIR / 'tyls.err'
const FAILED_JSON_PATH = TYD_LOGS_DIR / 'failed.json'

TYD_LOGS_DIR.mkdir(parents=true, exist-ok=true)

signal(SIGPIPE, 1)

logging({
    path: str(TYD_LOG_PATH),
    level: INFO
})

tag CompilationError;

let init = {
    capabilities: {
        definitionProvider: true,
        declarationProvider: true,
        hoverProvider: true,
        completionProvider: {
            triggerCharacters: ['.']
        },
        //signatureHelpProvider: {
        //    triggerCharacters: ['(', ','],
        //    retriggerCharacters: [')']
        //},
        semanticTokensProvider: {
            legend: {
                tokenTypes: [
                    'keyword', 'type', 'function', 'property', 'variable',
                    'string', 'number', 'comment', 'operator', 'regexp',
                    'namespace', 'macro', 'parameter'
                ],
                tokenModifiers: []
            },
            full: true
        },
        textDocumentSync: {
            openClose: true,
            save: true,
            change: 1
       }
    },

    serverInfo: {
        name: 'tyd',
        version: '0.0.1'
    }
}

let err-fd = match open("{TYLS_ERR_PATH}", O_WRONLY | O_TRUNC | O_CREAT, 0644) {
    -1 => do {
        warn!("can't open {TYLS_ERR_PATH}: {errno.str()}; discarding tyls stderr")
        SPAWN_NULL
    },

    fd => fd
}

let TY_LS_CMD = getenv('TY_LS_CMD').?words() ?? ['tyls']

let TYLS_TIMEOUT = float(getenv('TYLS_TIMEOUT') ?? '0.35')

let responses: SharedQueue[(Int, String | nil)] = SharedQueue()

fn spawn-tyls() {
    let proc = os.spawn(TY_LS_CMD, stdin=SPAWN_PIPE, stdout=SPAWN_PIPE, stderr=err-fd)
    critical!(proc)

    let pid = proc.pid

    Thread(fn () {
        with stream = io.open(proc.stdout, 'r') {
            while let $line = stream.next-line() {
                responses.put((pid, line))
            }
            responses.put((pid, nil))
        }
    }).detach()

    proc
}

let tyls = spawn-tyls()

fn restart-tyls!() {
    warn!("restarting tyls")

    close(tyls.stdin)
    kill(tyls.pid, SIGKILL)
    wait(tyls.pid)

    responses.clear()

    tyls = spawn-tyls()
}

onExit(fn () {
    kill(tyls.pid, SIGTERM)
})

fn get() -> String | nil {
    while match responses.try-take(TYLS_TIMEOUT) {
        Some((tyls.pid, nil)) => {
            error!("tyls exited unexpectedly")
            restart-tyls!()
            return nil
        },

        Some((tyls.pid, line)) => {
            warn!("TYLS OUTPUT: {line}")
            return line
        },

        Some(_) => {
            warn!("Received response from old tyls process")
            continue
        },

        None => {
            error!("tyls timed out after {TYLS_TIMEOUT}s")
            restart-tyls!()
            return nil
        }
    }
}

use Request = {
    file: String,
    what: Int,
    ?line: Int,
    ?col: Int
}

fn do-req(msg: Request) -> _ {
    for ..3 {
        error!("Writing to tyls: {pretty(msg, oneline=true, width=72)}")
        let n = write(tyls.stdin, "{json.encode(msg)}\n")
        info!("write(): {n} bytes")

        if let $out = get() {
            return json.parse(out)
        }

        if it == 2 {
            FAILED_JSON_PATH.append(json.encode(msg) + '\n')
        }
    }
}

fn lsp-range(loc: _) -> _ {
    let start = loc['start']
    let end = loc['end']
    return {
        start: { line: start['line'] - 1, character: start['col'] - 1 },
        end: { line: end['line'] - 1, character: end['col'] - 1 }
    }
}

fn diagnostic-message(record: _) -> String {
    let message = record['message'].comb(/\bCompileError: |\s+\[[\w-]+\]$/)
    [message, *(record['notes'] ?? [])].join('\n')
}

fn related-locations(record: _, file: String) -> _ {
    [
        {
            location: { uri: "file://{loc['file']}", range: lsp-range(loc) },
            message: "in {loc['module'] ?? loc['file']}"
        }
        for loc in record['trace'] if loc['file'] not in [nil, file]
    ]
}

fn to-diagnostic(record: _, file: String) -> _ {
    let $loc = record['trace'].find(\_['file'] == file) or return nil
    let code = record['code']
    return {
        range: lsp-range(loc),
        message: diagnostic-message(record),
        source: 'ty',
        severity: 1,
        relatedInformation: related-locations(record, file),
        *(code == nil ? {} : {code})
    }
}

fn dedent(doc: String) -> String {
    let lines = doc.comb(/^\n+|\n+$/).lines()
    let pre = lines.filter(\_.match?(/\S/)).map(\_.search(/\S/) ?? 0).min() ?? 0
    lines.map(&[pre;]).join('\n').strip()
}

fn overload-line(name: String, sig: String) -> String {
    sig.match?(/^[(\[]/) ? "{name}{sig}" : "{name}: {sig}"
}

fn hover-signature(info: _) -> String {
    let name = info['name']
    match info['type'] {
        sigs: Array[String] => sigs.map(overload-line@(name, _)).join('\n'),
        type                => "{name}: {type}"
    }
}

fn hover-text(info: _) -> String {
    let origin = info['builtin']
               ? 'builtin'
               : "defined at {relpath(info['file'])}:{info['line'] + 1}"

    let parts = ["```ty\n{hover-signature(info)}\n```", "_{origin}_"]

    if let $doc = info['doc'] {
        parts.push(dedent(doc))
    }

    parts.join('\n\n')
}

fn check[T](msg: T, file: String) -> T {
    fn send-dx(diagnostics) {
        send({
            method: 'textDocument/publishDiagnostics',
            params: {
                uri: "file://{file}",
                diagnostics
            }
        })
    }

    match msg {
        %{'diagnostics': $records} => do {
            send-dx(records.map(to-diagnostic@(_, file)).filter(\_ != nil))
        },

        %{
            'error': json.parse $~> %{
                message,
                'trace': [%{ start, end, 'file': >file }, *]
            }
        } => do {
            let diagnostics = [{
                range: {
                    start: { line: start['line'] - 1, character: start['col'] - 1 },
                    end: { line: end['line'] - 1, character: end['col'] - 1 }
                },
                message,
                severity: 1
            }]

            send-dx(diagnostics)
        },

        _ => do {
            send-dx([])
        }
    }

    msg
}

fn run(request: Request) -> _ {
    let file = request.file

    check(do-req({
        what: 0,
        file: file,
        source: store[file]
    }), file)

    if not let $rsp = do-req(request) {
        return nil
    }

    check(rsp, file)
}


info!(pretty(init, width=72))

let store: Dict[String, String] = %{}

fn relpath(path: String) -> String {
    let cwd = "{getcwd()}/"
    path[;#cwd] == cwd ? path[#cwd;] : path
}

fn send(msg) {
    info!("SEND {pretty(msg, width=72)}")
    let encoded = json.encode(msg)
    io.stdout.write("Content-Length: {#encoded}\r\n\r\n{encoded}")
    io.stdout.flush()
}

fn check-file(path: String) {
    check(do-req({
        what: 0,
        check: true,
        file: path,
        source: store[path]
    }), path)
}

let skip = [
    /^[^A-z_]+$/,
    /^__.*(?<!__)$/
]

fn go() {
    if not let $line = stdin.nextLine() {
        exit(0)
    }

    let &words $~> &[-1] ~> int ~> $n = line

    // Skip empty line
    stdin.nextLine()

    let req = stdin.next(n).str()
    let msg: _ = json.parse(req)
    let id = msg['id']

    info!(pretty(msg, oneline=true, width=72))

    match msg['method'] {
        'initialize' => {
            send({id, result: init})
        },

        'textDocument/didOpen' => {
            if let %{
                'textDocument': %{
                    'uri': &[7;] ~> $path,
                    'text': text
                }
            } = msg['params'] {
                store[path] = text
                check-file(path)
            }
        },

        'textDocument/didChange' => {
            if let %{
                'textDocument': %{
                    'uri': &[7;] ~> $path,
                },

                'contentChanges': [
                    %{'text': text}
                ]
            } = msg['params'] {
                store[path] = text
            }
        },

        'textDocument/didSave' => {
            if let %{
                'textDocument': %{
                    'uri': &[7;] ~> $path,
                }
            } = msg['params'] {
                check-file(path)
            }
        },

        ('textDocument/definition' or 'textDocument/declaration') as method => {
            let %{
                'textDocument': %{
                    'uri': &slice(7) ~> $path,
                },

                'position': %{
                    'line': int ~> line,
                    'character': int ~> col
                }
            } = msg['params']

            let result = match run({file: path, what: 1, line, col}) {
                %{'builtin': true} => nil,

                %{file, line, col} => {
                    uri: file.match?(/^\/dev\//) ? "file://{path}" : "file://{realpath(file)}",
                    range: {
                        start: { line: line, character: col },
                        end:   { line: line, character: col }
                    }
                },

                _ => nil
            }

            let response = {id, result}
            info!(response)
            send(response)
        },

        'textDocument/hover' => {
            let %{
                'textDocument': %{
                    'uri': &[7;] ~> $path,
                },
                'position': %{
                    'line': int ~> line,
                    'character': int ~> col
                }
            } = msg['params']

            let result = match run({file: path, what: 1, line, col}) {
                $info => {
                    contents: {
                        kind: 'markdown',
                        value: hover-text(info)
                    }
                },

                _ => nil
            }

            send({id, result})
        },

        'textDocument/signatureHelp' as method => {
        },

        'textDocument/semanticTokens/full' => {
            if not let %{
                'textDocument': %{
                    'uri': &[7;] ~> $path,
                }
            } = msg['params'] {
                return
            }

            let result = {
                data: run({file: path, what: 3}) ?? []
            }

            send({id, result})
        },

        'textDocument/completion' as method => {
            if not let %{
                'textDocument': %{
                    'uri': &[7;] ~> $path,
                },

                'position': %{
                    'line': int ~> line,
                    'character': int ~> col
                }
            } = msg['params'] {
                return
            }

            let result = match run({file: path, what: 2, line, col}) {
                %{source, type, completions} => {
                    isIncomplete: true,
                    items: [
                        {
                            label:    c['name'],
                            detail:   c['type'],
                            doc:      c['doc'],
                            kind:     c['kind'],
                            sortText: "{c['depth']:04} {c['name']}"
                        }
                        for c in completions if !skip.any?(\c['name'] :: _)
                    ]
                },

                _ => nil
            }

            send({id, result})
        },

        _ => ()
    }
}

for (;;) {
    catch {
        CompilationError => continue,

        err => do {
            error!(err)
            continue
        }
    }

    go()
}

/* vim: set sts=4 sw=4 expandtab ft=ty: */
